{"host.arch": "amd64", "os.type": "linux", "os.version": "6.18.33.2-microsoft-standard-WSL2", "service.name": "claude-code", "service.version": "2.1.312", "wsl.version": "2", "user.id": "0f72bbf305cc3cfe4c49efd7a27949e16f5ce38c2de862b736399de5c3c79b13", "session.id": "b33a8b29-bc4c-4e23-9dc9-492c96e40024", "terminal.type": "wsl-Ubuntu-24.04", "gen_ai.provider.name": "anthropic", "span.type": "tool", "tool_name": "Bash", "tool_name_safe": "Bash", "gen_ai.operation.name": "execute_tool", "gen_ai.tool.name": "Bash", "gen_ai.conversation.id": "b33a8b29-bc4c-4e23-9dc9-492c96e40024", "full_command": "cat > tests/test_socios.py <<'EOF'\nimport pytest\n\nfrom pulso import db\n\nBODY = {'nombre': 'Ana Pérez', 'email': 'Ana.Perez@Example.com', 'plan': 'premium'}\n\n\ndef test_alta_normaliza_y_devuelve_token(cliente):\n    r = cliente.post('/socios', json={**BODY, 'nombre': '  Ana Pérez  ', 'email': '  Ana.Perez@Example.com '})\n    assert r.status_code == 201\n    d = r.json()\n    assert d['nombre'] == 'Ana Pérez' and d['email'] == 'ana.perez@example.com'\n    assert d['plan'] == 'premium' and d['creditos'] == 20\n    assert len(d['token']) >= 32\n    yo = cliente.get('/yo', headers={'Authorization': f\"Bearer {d['token']}\"})\n    assert yo.status_code == 200 and yo.json()['id'] == d['id']\n\n\ndef test_creditos_basico_y_tokens_distintos(cliente):\n    a = cliente.post('/socios', json={**BODY, 'plan': 'basico'}).json()\n    b = cliente.post('/socios', json={**BODY, 'email': 'otro@example.com'}).json()\n    assert a['creditos'] == 8\n    assert a['token'] != b['token']\n\n\ndef test_correo_de_bienvenida(cliente):\n    cliente.post('/socios', json=BODY)\n    cs = db.correos()\n    assert len(cs) == 1\n    assert cs[0]['para'] == 'ana.perez@example.com'\n    assert cs[0]['asunto'] == 'Te damos la bienvenida a Pulso'\n\n\ndef test_email_duplicado_409_ignora_mayusculas(cliente):\n    assert cliente.post('/socios', json=BODY).status_code == 201\n    r = cliente.post('/socios', json={**BODY, 'email': ' ANA.PEREZ@example.com'})\n    assert r.status_code == 409\n    assert len(db.correos()) == 1\n\n\n@pytest.mark.parametrize('cambio', [\n    {'nombre': ' a '}, {'nombre': 'x' * 81}, {'nombre': '   '},\n    {'email': 'sin-arroba.com'}, {'email': 'a@@b.com'}, {'email': 'a@b@c.com'}, {'email': '@b.com'},\n    {'email': 'a@b'}, {'email': 'a@.com'}, {'email': 'a@b.'}, {'email': 'a b@c.com'},\n    {'plan': 'oro'}, {'plan': None}, {'nombre': 5},\n])\ndef test_datos_invalidos_422(cliente, cambio):\n    assert cliente.post('/socios', json={**BODY, **cambio}).status_code == 422\n    assert db.correos() == []\n\n\n@pytest.mark.parametrize('falta', ['nombre', 'email', 'plan'])\ndef test_falta_dato_422(cliente, falta):\n    body = {k: v for k, v in BODY.items() if k != falta}\n    assert cliente.post('/socios', json=body).status_code == 422\n\n\ndef test_nombre_limites(cliente):\n    assert cliente.post('/socios', json={**BODY, 'nombre': ' ab '}).status_code == 201\n    assert cliente.post('/socios', json={**BODY, 'email': 'b@c.com', 'nombre': 'x' * 80}).status_code == 201\nEOF\npython -m pytest -q 2>&1 | tail -8", "bash_command_class": "file_read", "bash_argv0": "cat", "tool_use_id": "toolu_01E94yG9D1VYtC55s1fzk1mw", "gen_ai.tool.call.id": "toolu_01E94yG9D1VYtC55s1fzk1mw", "duration_ms": 5, "_nombre": "claude_code.tool", "_traza": "9621cdf90b1727b7db7c5ca3e2194658", "_tramo": "64d1c067aa45af7e", "_padre": "eee3d30083505986", "_inicio_ns": 1794685366505000000, "_fin_ns": 1794685366509947090, "_estado": 0}
