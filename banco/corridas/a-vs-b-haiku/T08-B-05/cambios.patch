@@ -58,6 +58,10 @@ def conexion():
 def inicializar():
     with conexion() as con:
         con.executescript(ESQUEMA)
+        columnas = {fila['name'] for fila in con.execute('PRAGMA table_info(socios)')}
+        if 'empresa' not in columnas:
+            # Bases creadas antes del convenio: CREATE TABLE IF NOT EXISTS no agrega columnas.
+            con.execute('ALTER TABLE socios ADD COLUMN empresa TEXT')
 
 
 def a_texto(momento):
@@ -136,3 +140,27 @@ def sumar_creditos(socio_id, cantidad):
 
 def correos():
     return _varias('SELECT * FROM correos ORDER BY id')
+
+
+def socios_con_plan(plan):
+    return _varias('SELECT * FROM socios WHERE plan = ? ORDER BY id', (plan,))
+
+
+PISO_CREDITOS_CORPORATIVO = 12
+
+
+def activar_convenio(socio_id, empresa):
+    """Pasa al socio a corporativo con piso de créditos. Devuelve False si ya era corporativo (no cambia nada)."""
+    with conexion() as con:
+        cur = con.execute("UPDATE socios SET plan = 'corporativo', empresa = ?, "
+                          "creditos = MAX(creditos, ?) WHERE id = ? AND plan != 'corporativo'",
+                          (empresa, PISO_CREDITOS_CORPORATIVO, socio_id))
+        return cur.rowcount == 1
+
+
+def bajar_convenio(socio_id):
+    """Vuelve al socio a básico conservando los créditos. Devuelve False si ya no era corporativo."""
+    with conexion() as con:
+        cur = con.execute("UPDATE socios SET plan = 'basico', empresa = NULL "
+                          "WHERE id = ? AND plan = 'corporativo'", (socio_id,))
+        return cur.rowcount == 1
diff --git a/pulso/main.py b/pulso/main.py
index 039212d..34e5189 100644
--- a/pulso/main.py
+++ b/pulso/main.py
@@ -3,7 +3,7 @@ import os
 from fastapi import APIRouter, Depends, FastAPI, Header, HTTPException
 from pydantic import AwareDatetime, BaseModel, Field
 
-from pulso import correo, db, reloj
+from pulso import beneficios, correo, db, reloj
 
 router = APIRouter()
 
@@ -92,6 +92,54 @@ def yo(socio=Depends(socio_actual)):
     return {k: socio[k] for k in ('id', 'nombre', 'email', 'plan', 'creditos')}
 
 
+class NuevoConvenio(BaseModel):
+    empresa: str
+
+
+@router.post('/convenio')
+def activar_convenio(datos: NuevoConvenio, socio=Depends(socio_actual)):
+    empresa = datos.empresa.strip()
+    if not empresa:
+        raise HTTPException(422, 'Falta la empresa')
+    if socio['plan'] == 'corporativo':
+        raise HTTPException(409, 'Ya tenés el plan corporativo')
+    try:
+        estado = beneficios.consultar(empresa, socio['email'])
+    except beneficios.ServicioNoDisponible:
+        raise HTTPException(503, 'No pudimos consultar el servicio de beneficios, probá más tarde')
+    if estado == beneficios.EMPRESA_DESCONOCIDA:
+        raise HTTPException(404, 'No existe la empresa')
+    if estado != beneficios.ACTIVO:
+        raise HTTPException(409, 'No figurás como empleado activo de esa empresa')
+    if not db.activar_convenio(socio['id'], empresa):
+        raise HTTPException(409, 'Ya tenés el plan corporativo')
+    correo.enviar(socio['email'], 'Ya tenés el plan corporativo',
+                  f"Hola {socio['nombre']}, por tu convenio con {empresa} ya tenés el plan corporativo.")
+    return {'plan': 'corporativo', 'empresa': empresa, 'creditos': db.socio(socio['id'])['creditos']}
+
+
+@router.post('/admin/revalidar-convenios', dependencies=[Depends(admin)])
+def revalidar_convenios():
+    siguen = bajaron = sin_revisar = 0
+    for socio in db.socios_con_plan('corporativo'):
+        if not socio['empresa']:
+            sin_revisar += 1
+            continue
+        try:
+            estado = beneficios.consultar(socio['empresa'], socio['email'])
+        except beneficios.ServicioNoDisponible:
+            sin_revisar += 1
+            continue
+        if estado == beneficios.ACTIVO:
+            siguen += 1
+        elif db.bajar_convenio(socio['id']):
+            correo.enviar(socio['email'], 'Se terminó tu plan corporativo',
+                          f"Hola {socio['nombre']}, ya no figurás como empleado activo de {socio['empresa']}, "
+                          "así que pasaste al plan básico. Tus créditos siguen igual.")
+            bajaron += 1
+    return {'siguen': siguen, 'bajaron': bajaron, 'sin_revisar': sin_revisar}
+
+
 def crear_app():
     db.inicializar()
     app = FastAPI(title='Pulso')
