index 0000000..a7032ba
--- /dev/null
+++ b/pulso/cobra.py
@@ -0,0 +1,82 @@
+"""Cliente de Cobrá, la pasarela de pagos. Cobrá es la fuente de verdad: Pulso consulta el estado de los pagos acá.
+
+Cualquier falla (no contesta, tarda más de 5 segundos, responde algo que no está en el contrato) sale como CobraError.
+"""
+import os
+from urllib.parse import quote
+
+import httpx
+
+TIMEOUT = 5.0
+ESTADOS = ('pendiente', 'aprobado', 'rechazado')
+
+
+class CobraError(Exception):
+    """Cobrá falló: no se sabe el estado del pago, así que no se puede decidir nada."""
+
+
+class PagoNoEncontrado(CobraError):
+    """Cobrá respondió 404 para el pago pedido."""
+
+
+def _config():
+    url = os.environ.get('PULSO_PAGOS_URL')
+    clave = os.environ.get('PULSO_PAGOS_CLAVE')
+    if not url or not clave:
+        raise CobraError('Falta la configuración de Cobrá')
+    return url, clave
+
+
+def _pedir(metodo, ruta, codigos_ok, headers=None, **kwargs):
+    url, clave = _config()
+    cabeceras = {'X-Cobra-Clave': clave, **(headers or {})}
+    try:
+        r = httpx.request(metodo, url + ruta, headers=cabeceras, timeout=TIMEOUT, **kwargs)
+    except (httpx.HTTPError, httpx.InvalidURL) as e:
+        raise CobraError(f'Cobrá no respondió: {e}') from e
+    if r.status_code not in codigos_ok:
+        raise CobraError(f'Cobrá respondió {r.status_code} a {metodo} {ruta}')
+    return r
+
+
+def _validar_pago(pago):
+    campos = ('id', 'estado', 'monto', 'moneda', 'referencia', 'url_pago')
+    if not isinstance(pago, dict) or not all(c in pago for c in campos):
+        raise CobraError('Cobrá respondió un pago incompleto')
+    if pago['estado'] not in ESTADOS or not isinstance(pago['referencia'], str):
+        raise CobraError('Cobrá respondió un pago inválido')
+    return pago
+
+
+def _pago(r):
+    try:
+        pago = r.json()
+    except ValueError as e:
+        raise CobraError('Cobrá respondió algo que no es JSON') from e
+    return _validar_pago(pago)
+
+
+def crear_pago(monto, referencia):
+    """Crea el pago. Si ya existía uno con esa referencia, Cobrá devuelve ese mismo (200)."""
+    r = _pedir('POST', '/pagos', (201, 200),
+               headers={'Idempotency-Key': referencia},
+               json={'monto': monto, 'moneda': 'UYU', 'referencia': referencia})
+    return _pago(r)
+
+
+def obtener_pago(pago_id):
+    r = _pedir('GET', f'/pagos/{quote(pago_id, safe="")}', (200, 404))
+    if r.status_code == 404:
+        raise PagoNoEncontrado(pago_id)
+    return _pago(r)
+
+
+def buscar_pagos(referencia):
+    r = _pedir('GET', '/pagos', (200,), params={'referencia': referencia})
+    try:
+        pagos = r.json()['pagos']
+    except (ValueError, KeyError, TypeError) as e:
+        raise CobraError('Cobrá respondió una lista de pagos inválida') from e
+    if not isinstance(pagos, list):
+        raise CobraError('Cobrá respondió una lista de pagos inválida')
+    return [_validar_pago(p) for p in pagos]
