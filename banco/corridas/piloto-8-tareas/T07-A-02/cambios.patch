--- /dev/null
+++ b/pulso/cobra.py
@@ -0,0 +1,63 @@
+"""Cliente de Cobrá, la pasarela de pagos. Cualquier falla se informa como CobraError."""
+import os
+from urllib.parse import quote
+
+import httpx
+
+TIMEOUT = 5
+ESTADOS = ('pendiente', 'aprobado', 'rechazado')
+
+
+class CobraError(Exception):
+    pass
+
+
+def _pedir(metodo, ruta, esperados, **kwargs):
+    try:
+        resp = httpx.request(metodo, os.environ.get('PULSO_PAGOS_URL', '') + ruta,
+                             headers=dict(kwargs.pop('headers', {}), **{'X-Cobra-Clave': os.environ.get('PULSO_PAGOS_CLAVE', '')}),
+                             timeout=TIMEOUT, **kwargs)
+    except httpx.HTTPError as e:
+        raise CobraError(str(e)) from e
+    if resp.status_code not in esperados:
+        raise CobraError(f'Cobrá respondió {resp.status_code}')
+    return resp
+
+
+def _json(resp):
+    try:
+        return resp.json()
+    except ValueError as e:
+        raise CobraError('Respuesta inválida') from e
+
+
+def _pago(datos):
+    if not isinstance(datos, dict) or datos.get('estado') not in ESTADOS or not datos.get('id'):
+        raise CobraError('Pago inválido')
+    return datos
+
+
+def crear_pago(monto, referencia):
+    resp = _pedir('POST', '/pagos', (200, 201), headers={'Idempotency-Key': referencia},
+                  json={'monto': monto, 'moneda': 'UYU', 'referencia': referencia})
+    return _pago(_json(resp))
+
+
+def obtener_pago(pago_id):
+    """Devuelve el pago, o None si Cobrá no lo conoce."""
+    resp = _pedir('GET', '/pagos/' + quote(pago_id, safe=''), (200, 404))
+    if resp.status_code == 404:
+        return None
+    return _pago(_json(resp))
+
+
+def buscar_pago(referencia):
+    """Devuelve el pago con esa referencia, o None si no hay."""
+    resp = _pedir('GET', '/pagos', (200,), params={'referencia': referencia})
+    pagos = _json(resp).get('pagos') if isinstance(_json(resp), dict) else None
+    if not isinstance(pagos, list):
+        raise CobraError('Respuesta inválida')
+    for p in pagos:
+        if isinstance(p, dict) and p.get('referencia') == referencia:
+            return _pago(p)
+    return None
