+DIAS = ['lunes', 'martes', 'miércoles', 'jueves', 'viernes', 'sábado', 'domingo']
+CIERRES = {date(2026, 12, 25), date(2027, 1, 1), date(2027, 2, 8), date(2027, 2, 9),
+           date(2027, 3, 25), date(2027, 3, 26), date(2027, 5, 1)}
+HORA_RE = r'^([01][0-9]|2[0-3]):[0-5][0-9]$'
+
+
+def _no_vacio(v):
+    if not v.strip():
+        raise ValueError('vacío')
+    return v
+
+
+class NuevaSerie(BaseModel):
+    nombre: str
+    instructor: str
+    dia: Literal['lunes', 'martes', 'miércoles', 'jueves', 'viernes', 'sábado', 'domingo']
+    hora: str = Field(pattern=HORA_RE)
+    duracion_min: StrictInt = Field(ge=1)
+    cupo: StrictInt = Field(ge=1)
+    desde: date
+    hasta: date
+
+    _v = field_validator('nombre', 'instructor')(_no_vacio)
+
+    @model_validator(mode='after')
+    def _rango(self):
+        if self.hasta < self.desde or (self.hasta - self.desde).days > 366:
+            raise ValueError('rango de fechas inválido')
+        return self
+
+
+def inicio_local(dia, hora):
+    h, m = hora.split(':')
+    return datetime(dia.year, dia.month, dia.day, int(h), int(m), tzinfo=reloj.MONTEVIDEO)
+
+
+def ver_serie(serie):
