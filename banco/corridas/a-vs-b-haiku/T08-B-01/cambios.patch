+);
 """
 
 
@@ -136,3 +140,33 @@ def sumar_creditos(socio_id, cantidad):
 
 def correos():
     return _varias('SELECT * FROM correos ORDER BY id')
+
+
+def activar_convenio(socio_id, empresa):
+    """Pasa el socio a corporativo con piso de 12 créditos y guarda la empresa.
+
+    Devuelve False si el socio ya era corporativo (no cambia nada).
+    """
+    with conexion() as con:
+        cur = con.execute("UPDATE socios SET plan = 'corporativo', creditos = MAX(creditos, 12) "
+                          "WHERE id = ? AND plan != 'corporativo'", (socio_id,))
+        if cur.rowcount == 0:
+            return False
+        con.execute('INSERT OR REPLACE INTO convenios (socio_id, empresa) VALUES (?, ?)', (socio_id, empresa))
+    return True
+
+
+def bajar_convenio(socio_id):
+    """Vuelve el socio a básico y olvida la empresa. Conserva los créditos. Devuelve False si no era corporativo."""
+    with conexion() as con:
+        cur = con.execute("UPDATE socios SET plan = 'basico' WHERE id = ? AND plan = 'corporativo'", (socio_id,))
+        if cur.rowcount == 0:
+            return False
+        con.execute('DELETE FROM convenios WHERE socio_id = ?', (socio_id,))
+    return True
+
+
+def socios_corporativos():
+    """Socios con plan corporativo y la empresa con la que lo activaron (None si no hay registro)."""
+    return _varias("SELECT s.id, s.email, s.nombre, c.empresa FROM socios s "
+                   "LEFT JOIN convenios c ON c.socio_id = s.id WHERE s.plan = 'corporativo' ORDER BY s.id")
