{"host.arch": "arm64", "os.type": "darwin", "os.version": "23.4.0", "service.name": "claude-code", "service.version": "2.1.312", "user.id": "", "session.id": "fe8b28a3-8fd6-483e-813d-18bc72af6b49", "terminal.type": "claude-desktop", "gen_ai.provider.name": "anthropic", "span.type": "tool", "tool_name": "Bash", "tool_name_safe": "Bash", "gen_ai.operation.name": "execute_tool", "gen_ai.tool.name": "Bash", "gen_ai.conversation.id": "fe8b28a3-8fd6-483e-813d-18bc72af6b49", "full_command": "cat > tests/test_recordatorios.py <<'EOF'\nfrom datetime import timedelta\n\nfrom conftest import ADMIN, AHORA\nfrom pulso import db\n\n\ndef _reservar(socio, clase, estado='confirmada'):\n    return db.crear_reserva(socio['id'], clase['id'], AHORA - timedelta(days=2), estado)\n\n\ndef test_requiere_clave(cliente):\n    assert cliente.post('/admin/recordatorios').status_code == 401\n    assert cliente.post('/admin/recordatorios', headers={'X-Admin-Key': 'x'}).status_code == 401\n\n\ndef test_manda_recordatorio_una_sola_vez(cliente, socio):\n    clase = db.crear_clase('Yoga', 'Sofía', AHORA + timedelta(hours=6, minutes=30))\n    _reservar(socio, clase)\n    r = cliente.post('/admin/recordatorios', headers=ADMIN)\n    assert r.status_code == 200 and r.json() == {'enviados': 1}\n    [c] = db.correos()\n    assert c['para'] == 'ana@example.com'\n    assert c['asunto'] == 'Recordatorio: Yoga el 10/11 a las 18:30'\n    assert 'Sofía' in c['cuerpo']\n    assert cliente.post('/admin/recordatorios', headers=ADMIN).json() == {'enviados': 0}\n    assert len(db.correos()) == 1\n\n\ndef test_ventana_de_24_horas(cliente, socio):\n    limite = db.crear_clase('Limite', 'A', AHORA + timedelta(hours=24))\n    afuera = db.crear_clase('Afuera', 'A', AHORA + timedelta(hours=24, seconds=1))\n    ahora = db.crear_clase('Ahora', 'A', AHORA)\n    pasada = db.crear_clase('Pasada', 'A', AHORA - timedelta(hours=1))\n    for c in (limite, afuera, ahora, pasada):\n        _reservar(socio, c)\n    assert cliente.post('/admin/recordatorios', headers=ADMIN).json() == {'enviados': 1}\n    assert db.correos()[0]['asunto'].startswith('Recordatorio: Limite')\n\n\ndef test_no_recuerda_canceladas(cliente, socio):\n    clase = db.crear_clase('Yoga', 'Sofía', AHORA + timedelta(hours=3))\n    _reservar(socio, clase, 'cancelada')\n    assert cliente.post('/admin/recordatorios', headers=ADMIN).json() == {'enviados': 0}\n    assert db.correos() == []\n\n\ndef test_reserva_tardia_y_clase_que_entra_despues(cliente, socio):\n    clase = db.crear_clase('Yoga', 'Sofía', AHORA + timedelta(hours=30))\n    _reservar(socio, clase)\n    assert cliente.post('/admin/recordatorios', headers=ADMIN).json() == {'enviados': 0}\n    from pulso import reloj\n    reloj.fijar(AHORA + timedelta(hours=10))\n    assert cliente.post('/admin/recordatorios', headers=ADMIN).json() == {'enviados': 1}\n    assert cliente.post('/admin/recordatorios', headers=ADMIN).json() == {'enviados': 0}\nEOF\npython -m pytest -q 2>&1 | tail -5", "bash_command_class": "file_read", "bash_argv0": "cat", "tool_use_id": "toolu_01DMxXdYeMpddKRHbGPuc5Hv", "gen_ai.tool.call.id": "toolu_01DMxXdYeMpddKRHbGPuc5Hv", "duration_ms": 7, "_nombre": "claude_code.tool", "_traza": "49843888aed9e2963f6b30ae92a7fca4", "_tramo": "d81296d71f11de37", "_padre": "bc021b671ef9444e", "_inicio_ns": 1794572805847000000, "_fin_ns": 1794572805853699750, "_estado": 0}
