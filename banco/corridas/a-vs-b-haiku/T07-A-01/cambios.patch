index 0000000..4dc66ac
--- /dev/null
+++ b/pulso/cobra.py
@@ -0,0 +1,64 @@
+"""Cliente de Cobrá, la pasarela de pagos. Cualquier falla se informa con CobraError."""
+import os
+from urllib.parse import quote
+
+import httpx
+
+TIMEOUT = 5.0
+ESTADOS = ('pendiente', 'aprobado', 'rechazado')
+
+
+class CobraError(Exception):
+    pass
+
+
+def _pedir(metodo, ruta, ok, **kwargs):
+    url = os.environ.get('PULSO_PAGOS_URL', '').rstrip('/') + ruta
+    headers = dict(kwargs.pop('headers', {}), **{'X-Cobra-Clave': os.environ.get('PULSO_PAGOS_CLAVE', '')})
+    try:
+        r = httpx.request(metodo, url, headers=headers, timeout=TIMEOUT, **kwargs)
+    except httpx.HTTPError as e:
+        raise CobraError(str(e)) from e
+    if r.status_code not in ok:
+        raise CobraError(f'Cobrá respondió {r.status_code}')
+    return r
+
+
+def _json(r):
+    try:
+        return r.json()
+    except ValueError as e:
+        raise CobraError('Respuesta inválida') from e
+
+
+def _pago(datos):
+    if not isinstance(datos, dict) or datos.get('estado') not in ESTADOS or not isinstance(datos.get('id'), str):
+        raise CobraError('Pago inválido')
+    return datos
+
+
+def crear_pago(monto, referencia):
+    r = _pedir('POST', '/pagos', (200, 201), json={'monto': monto, 'moneda': 'UYU', 'referencia': referencia},
+               headers={'Idempotency-Key': referencia})
+    return _pago(_json(r))
+
+
+def obtener_pago(pago_id):
+    """El pago, o None si Cobrá no lo conoce."""
+    r = _pedir('GET', '/pagos/' + quote(pago_id, safe=''), (200, 404))
+    if r.status_code == 404:
+        return None
+    return _pago(_json(r))
+
+
+def buscar_pago(referencia):
+    """El pago con esa referencia, o None si no hay ninguno."""
+    r = _pedir('GET', '/pagos', (200,), params={'referencia': referencia})
+    datos = _json(r)
+    pagos = datos.get('pagos') if isinstance(datos, dict) else None
+    if not isinstance(pagos, list):
+        raise CobraError('Respuesta inválida')
+    for p in pagos:
+        if isinstance(p, dict) and p.get('referencia') == referencia:
+            return _pago(p)
+    return None
