+    def cumple(clase):
+        inicio = db.a_fecha(clase['inicio'])
+        if inicio <= ahora:
+            return False
+        dia = inicio.astimezone(reloj.MONTEVIDEO).date()
+        if desde_dia and dia < desde_dia:
+            return False
+        if hasta_dia and dia > hasta_dia:
+            return False
+        if instructor is not None and clase['instructor'].casefold() != instructor.casefold():
+            return False
+        if con_lugar and clase['lugares_libres'] <= 0:
+            return False
+        return True
+
+    encontradas = [c for c in db.clases_con_lugares_libres() if cumple(c)]
