diff --git a/tests/test_base.py b/tests/test_base.py
index 5d9460b..e8d5fb4 100644
--- a/tests/test_base.py
+++ b/tests/test_base.py
@@ -1,7 +1,7 @@
 from datetime import timedelta
 
 from conftest import ADMIN, AHORA, auth
-from pulso import db
+from pulso import db, reloj
 
 
 def test_lista_solo_clases_futuras_en_orden(cliente):
@@ -79,3 +79,100 @@ def test_mis_reservas_en_orden_de_clase(cliente, socio):
         cliente.post('/reservas', json={'clase_id': clase['id']}, headers=auth(socio))
     r = cliente.get('/reservas', headers=auth(socio))
     assert [x['clase_id'] for x in r.json()] == [temprano['id'], tarde['id']]
+
+
+def reservar_para(cliente, socio, clase):
+    r = cliente.post('/reservas', json={'clase_id': clase['id']}, headers=auth(socio))
+    assert r.status_code == 201
+    return r.json()['id']
+
+
+def test_cancelar_con_anticipacion_devuelve_credito(cliente, socio):
+    clase = db.crear_clase('Yoga', 'Sofía', AHORA + timedelta(hours=3))
+    reserva_id = reservar_para(cliente, socio, clase)
+    r = cliente.post(f'/reservas/{reserva_id}/cancelar', headers=auth(socio))
+    assert r.status_code == 200
+    assert r.json() == {'id': reserva_id, 'clase_id': clase['id'], 'estado': 'cancelada',
+                        'creada': AHORA.isoformat(), 'credito_devuelto': True}
+    assert cliente.get('/yo', headers=auth(socio)).json()['creditos'] == 8
+
+
+def test_cancelar_con_menos_de_dos_horas_no_devuelve_credito(cliente, socio):
+    clase = db.crear_clase('Yoga', 'Sofía', AHORA + timedelta(hours=2) - timedelta(minutes=1))
+    reserva_id = reservar_para(cliente, socio, clase)
+    r = cliente.post(f'/reservas/{reserva_id}/cancelar', headers=auth(socio))
+    assert r.status_code == 200
+    assert r.json()['credito_devuelto'] is False
+    assert r.json()['estado'] == 'cancelada'
+    assert cliente.get('/yo', headers=auth(socio)).json()['creditos'] == 7
+
+
+def test_cancelar_exactamente_dos_horas_devuelve_credito(cliente, socio):
+    clase = db.crear_clase('Yoga', 'Sofía', AHORA + timedelta(hours=2))
+    reserva_id = reservar_para(cliente, socio, clase)
+    r = cliente.post(f'/reservas/{reserva_id}/cancelar', headers=auth(socio))
+    assert r.json()['credito_devuelto'] is True
+
+
+def test_cancelar_clase_empezada_es_409(cliente, socio):
+    clase = db.crear_clase('Yoga', 'Sofía', AHORA + timedelta(hours=1))
+    reserva_id = reservar_para(cliente, socio, clase)
+    reloj.fijar(AHORA + timedelta(hours=1))
+    r = cliente.post(f'/reservas/{reserva_id}/cancelar', headers=auth(socio))
+    assert r.status_code == 409
+    assert cliente.get('/reservas', headers=auth(socio)).json()[0]['estado'] == 'confirmada'
+
+
+def test_cancelar_dos_veces_es_409_y_no_devuelve_credito_otra_vez(cliente, socio):
+    clase = db.crear_clase('Yoga', 'Sofía', AHORA + timedelta(hours=5))
+    reserva_id = reservar_para(cliente, socio, clase)
+    assert cliente.post(f'/reservas/{reserva_id}/cancelar', headers=auth(socio)).status_code == 200
+    assert cliente.post(f'/reservas/{reserva_id}/cancelar', headers=auth(socio)).status_code == 409
+    assert cliente.get('/yo', headers=auth(socio)).json()['creditos'] == 8
+
+
+def test_cancelar_reserva_de_otro_socio_es_404(cliente, socio):
+    clase = db.crear_clase('Yoga', 'Sofía', AHORA + timedelta(hours=5))
+    reserva_id = reservar_para(cliente, socio, clase)
+    otro = db.crear_socio('Juan Gómez', 'juan@example.com')
+    r = cliente.post(f'/reservas/{reserva_id}/cancelar', headers=auth(otro))
+    assert r.status_code == 404
+    assert cliente.get('/reservas', headers=auth(socio)).json()[0]['estado'] == 'confirmada'
+    assert cliente.get('/yo', headers=auth(socio)).json()['creditos'] == 7
+
+
+def test_cancelar_reserva_inexistente_es_404(cliente, socio):
+    assert cliente.post('/reservas/999/cancelar', headers=auth(socio)).status_code == 404
+
+
+def test_cancelar_sin_token_es_401(cliente, socio):
+    clase = db.crear_clase('Yoga', 'Sofía', AHORA + timedelta(hours=5))
+    reserva_id = reservar_para(cliente, socio, clase)
+    assert cliente.post(f'/reservas/{reserva_id}/cancelar').status_code == 401
+
+
+def test_reserva_cancelada_sigue_listandose_y_libera_lugar(cliente, socio):
+    clase = db.crear_clase('Yoga', 'Sofía', AHORA + timedelta(hours=5), cupo=1)
+    reserva_id = reservar_para(cliente, socio, clase)
+    assert cliente.get(f"/clases/{clase['id']}").json()['lugares_libres'] == 0
+    cliente.post(f'/reservas/{reserva_id}/cancelar', headers=auth(socio))
+    assert cliente.get(f"/clases/{clase['id']}").json()['lugares_libres'] == 1
+    reservas = cliente.get('/reservas', headers=auth(socio)).json()
+    assert [(x['id'], x['estado']) for x in reservas] == [(reserva_id, 'cancelada')]
+
+
+def test_otro_socio_puede_reservar_el_lugar_liberado(cliente, socio):
+    clase = db.crear_clase('Yoga', 'Sofía', AHORA + timedelta(hours=5), cupo=1)
+    reserva_id = reservar_para(cliente, socio, clase)
+    cliente.post(f'/reservas/{reserva_id}/cancelar', headers=auth(socio))
+    otro = db.crear_socio('Juan Gómez', 'juan@example.com')
+    assert cliente.post('/reservas', json={'clase_id': clase['id']}, headers=auth(otro)).status_code == 201
+
+
+def test_mismo_socio_puede_volver_a_reservar_la_clase(cliente, socio):
+    clase = db.crear_clase('Yoga', 'Sofía', AHORA + timedelta(hours=5))
+    reserva_id = reservar_para(cliente, socio, clase)
+    cliente.post(f'/reservas/{reserva_id}/cancelar', headers=auth(socio))
+    nueva = reservar_para(cliente, socio, clase)
+    assert nueva != reserva_id
+    assert cliente.get('/yo', headers=auth(socio)).json()['creditos'] == 7
