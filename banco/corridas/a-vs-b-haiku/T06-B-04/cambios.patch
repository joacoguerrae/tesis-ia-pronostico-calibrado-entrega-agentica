+def _clase_o_404(con, clase_id):
+    clase = db.clase_en(con, clase_id)
+    if clase is None:
+        raise HTTPException(404, 'No existe la clase')
+    return clase
+
+
+@router.post('/clases/{clase_id}/espera', status_code=201)
+def anotarse_en_espera(clase_id: int, socio=Depends(socio_actual)):
+    ahora = reloj.ahora()
+    with db.transaccion() as con:
+        clase = _clase_o_404(con, clase_id)
+        if db.a_fecha(clase['inicio']) <= ahora:
+            raise HTTPException(409, 'La clase ya empezó')
+        if db.confirmadas_en(con, clase_id) < clase['cupo']:
+            raise HTTPException(409, 'La clase tiene lugar, reservala directo')
+        if db.tiene_confirmada_en(con, socio['id'], clase_id):
+            raise HTTPException(409, 'Ya tenés una reserva para esta clase')
+        if db.en_espera_de(con, clase_id, socio['id']):
+            raise HTTPException(409, 'Ya estás en la lista de espera de esta clase')
+        if db.socio_en(con, socio['id'])['creditos'] < 1:
+            raise HTTPException(409, 'No te quedan créditos')
+        db.anotar_en_espera(con, socio['id'], clase_id, ahora)
+        posicion = db.posicion_en_espera(con, clase_id, socio['id'])
+    return {'clase_id': clase_id, 'posicion': posicion}
+
+
+@router.get('/clases/{clase_id}/espera')
+def ver_posicion_en_espera(clase_id: int, socio=Depends(socio_actual)):
+    with db.conexion() as con:
+        _clase_o_404(con, clase_id)
+        posicion = db.posicion_en_espera(con, clase_id, socio['id'])
+    if posicion is None:
+        raise HTTPException(404, 'No estás en la lista de espera de esta clase')
+    return {'clase_id': clase_id, 'posicion': posicion}
+
+
+@router.delete('/clases/{clase_id}/espera', status_code=204)
+def bajarse_de_espera(clase_id: int, socio=Depends(socio_actual)):
+    with db.transaccion() as con:
+        _clase_o_404(con, clase_id)
+        fila = db.en_espera_de(con, clase_id, socio['id'])
+        if fila is None:
+            raise HTTPException(404, 'No estás en la lista de espera de esta clase')
+        db.quitar_de_espera(con, fila['id'])
+    return Response(status_code=204)
+
+
+@router.post('/admin/reservas/{reserva_id}/cancelar', dependencies=[Depends(admin)])
+def cancelar_reserva(reserva_id: int):
+    ahora = reloj.ahora()
+    with db.transaccion() as con:
+        reserva = db.reserva_en(con, reserva_id)
+        if reserva is None:
+            raise HTTPException(404, 'No existe la reserva')
+        if reserva['estado'] == 'cancelada':
+            raise HTTPException(409, 'La reserva ya estaba cancelada')
+        db.cambiar_estado_reserva(con, reserva_id, 'cancelada')
+        db.sumar_creditos_en(con, reserva['socio_id'], 1)
+        if reserva['estado'] == 'confirmada':
+            espera.asignar_libres(con, db.clase_en(con, reserva['clase_id']), ahora)
+    return ver_reserva(db.reserva(reserva_id))
+
+
+class NuevoCupo(BaseModel):
+    cupo: StrictInt = Field(gt=0)
+
+
+@router.patch('/admin/clases/{clase_id}', dependencies=[Depends(admin)])
+def cambiar_cupo(clase_id: int, datos: NuevoCupo):
+    ahora = reloj.ahora()
+    with db.transaccion() as con:
+        _clase_o_404(con, clase_id)
+        if db.confirmadas_en(con, clase_id) > datos.cupo:
+            raise HTTPException(409, 'El cupo no puede quedar por debajo de las reservas confirmadas')
+        db.cambiar_cupo(con, clase_id, datos.cupo)
+        espera.asignar_libres(con, db.clase_en(con, clase_id), ahora)
+    return ver_clase(db.clase(clase_id))
+
