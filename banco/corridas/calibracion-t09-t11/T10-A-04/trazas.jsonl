{"host.arch": "amd64", "os.type": "linux", "os.version": "6.18.33.2-microsoft-standard-WSL2", "service.name": "claude-code", "service.version": "2.1.312", "wsl.version": "2", "user.id": "0f72bbf305cc3cfe4c49efd7a27949e16f5ce38c2de862b736399de5c3c79b13", "session.id": "aa43a683-2b0d-4eec-b9bc-c68672fe2bd9", "terminal.type": "wsl-Ubuntu-24.04", "gen_ai.provider.name": "anthropic", "span.type": "tool", "tool_name": "Bash", "tool_name_safe": "Bash", "gen_ai.operation.name": "execute_tool", "gen_ai.tool.name": "Bash", "gen_ai.conversation.id": "aa43a683-2b0d-4eec-b9bc-c68672fe2bd9", "full_command": "python - <<'E'\nE\ncat >> pulso/db.py <<'E'\n\n\nclass ReservaRechazada(Exception):\n    \"\"\"La reserva no cumple una regla de negocio; el mensaje es el detail del 409.\"\"\"\n\n\n@contextmanager\ndef transaccion_exclusiva():\n    \"\"\"Transacción con lock de escritura tomado desde el inicio (espera su turno si la base está ocupada).\"\"\"\n    con = sqlite3.connect(ruta(), timeout=60, isolation_level=None)\n    con.row_factory = sqlite3.Row\n    con.execute('PRAGMA foreign_keys = ON')\n    try:\n        con.execute('BEGIN IMMEDIATE')\n        try:\n            yield con\n        except BaseException:\n            con.execute('ROLLBACK')\n            raise\n        con.execute('COMMIT')\n    finally:\n        con.close()\n\n\ndef reservar(socio_id, clase_id, creada, al_confirmar=None):\n    \"\"\"Valida y crea la reserva, descuenta el crédito y llama a al_confirmar(con, reserva) en una única\n    transacción atómica. Lanza ReservaRechazada si no corresponde.\"\"\"\n    with transaccion_exclusiva() as con:\n        if con.execute(\"SELECT 1 FROM reservas WHERE socio_id = ? AND clase_id = ? AND estado = 'confirmada'\",\n                       (socio_id, clase_id)).fetchone():\n            raise ReservaRechazada('Ya tenés una reserva para esta clase')\n        cupo = con.execute('SELECT cupo FROM clases WHERE id = ?', (clase_id,)).fetchone()['cupo']\n        n = con.execute(\"SELECT COUNT(*) AS n FROM reservas WHERE clase_id = ? AND estado = 'confirmada'\",\n                        (clase_id,)).fetchone()['n']\n        if n >= cupo:\n            raise ReservaRechazada('La clase no tiene lugar')\n        cur = con.execute('UPDATE socios SET creditos = creditos - 1 WHERE id = ? AND creditos >= 1', (socio_id,))\n        if cur.rowcount != 1:\n            raise ReservaRechazada('No te quedan créditos')\n        cur = con.execute(\"INSERT INTO reservas (socio_id, clase_id, estado, creada) VALUES (?, ?, 'confirmada', ?)\",\n                          (socio_id, clase_id, a_texto(creada)))\n        res = dict(con.execute('SELECT * FROM reservas WHERE id = ?', (cur.lastrowid,)).fetchone())\n        if al_confirmar:\n            al_confirmar(con, res)\n    return res\nE\npython - <<'E'\nE", "bash_command_class": "lang_runtime", "bash_argv0": "python", "tool_use_id": "toolu_01NfYjV5WJog8qf1hJRr38uN", "gen_ai.tool.call.id": "toolu_01NfYjV5WJog8qf1hJRr38uN", "duration_ms": 10, "_nombre": "claude_code.tool", "_traza": "0123e0a30e521dd610778ebc9ecfc85b", "_tramo": "e84a335a6e1aae0a", "_padre": "fa9fa69dec384c5b", "_inicio_ns": 1794696575228000000, "_fin_ns": 1794696575237863212, "_estado": 0}
