{"host.arch": "arm64", "os.type": "darwin", "os.version": "23.4.0", "service.name": "claude-code", "service.version": "2.1.312", "user.id": "", "session.id": "014c52a2-6dac-42f5-9311-ad3f735af068", "terminal.type": "claude-desktop", "gen_ai.provider.name": "anthropic", "span.type": "tool", "tool_name": "Bash", "tool_name_safe": "Bash", "gen_ai.operation.name": "execute_tool", "gen_ai.tool.name": "Bash", "gen_ai.conversation.id": "014c52a2-6dac-42f5-9311-ad3f735af068", "full_command": "cat > pulso/cobra.py <<'EOF'\n\"\"\"Cliente de Cobrá, la pasarela de pagos. Cualquier falla se informa con CobraError.\"\"\"\nimport os\n\nimport httpx\n\nTIMEOUT = 5\nESTADOS = ('pendiente', 'aprobado', 'rechazado')\n\n\nclass CobraError(Exception):\n    pass\n\n\ndef _pedir(metodo, ruta, esperados, **kwargs):\n    url = os.environ.get('PULSO_PAGOS_URL', '') + ruta\n    headers = dict(kwargs.pop('headers', {}), **{'X-Cobra-Clave': os.environ.get('PULSO_PAGOS_CLAVE', '')})\n    try:\n        r = httpx.request(metodo, url, headers=headers, timeout=TIMEOUT, **kwargs)\n    except httpx.HTTPError as e:\n        raise CobraError(str(e)) from e\n    if r.status_code not in esperados:\n        raise CobraError(f'Cobrá respondió {r.status_code}')\n    try:\n        return r.status_code, r.json()\n    except ValueError as e:\n        raise CobraError('Respuesta inválida') from e\n\n\ndef _pago(datos):\n    if (not isinstance(datos, dict) or datos.get('estado') not in ESTADOS\n            or not isinstance(datos.get('id'), str) or not isinstance(datos.get('referencia'), str)):\n        raise CobraError('Pago inválido')\n    return datos\n\n\ndef crear_pago(monto, referencia):\n    _, datos = _pedir('POST', '/pagos', (200, 201), headers={'Idempotency-Key': referencia},\n                      json={'monto': monto, 'moneda': 'UYU', 'referencia': referencia})\n    return _pago(datos)\n\n\ndef obtener_pago(pago_id):\n    \"\"\"El pago, o None si Cobrá no lo conoce.\"\"\"\n    try:\n        _, datos = _pedir('GET', f'/pagos/{pago_id}', (200,))\n    except CobraError as e:\n        if str(e) == 'Cobrá respondió 404':\n            return None\n        raise\n    return _pago(datos)\n\n\ndef buscar_por_referencia(referencia):\n    \"\"\"Lista de pagos con esa referencia (puede ser vacía).\"\"\"\n    _, datos = _pedir('GET', '/pagos', (200,), params={'referencia': referencia})\n    if not isinstance(datos, dict) or not isinstance(datos.get('pagos'), list):\n        raise CobraError('Respuesta inválida')\n    return [_pago(p) for p in datos['pagos']]\nEOF\npython - <<'EOF'\nimport re\np='pulso/db.py'\ns=open(p).read()\ns=s.replace('''CREATE TABLE IF NOT EXISTS correos''','''CREATE TABLE IF NOT EXISTS compras (\n    id INTEGER PRIMARY KEY,\n    socio_id INTEGER NOT NULL REFERENCES socios(id),\n    pack TEXT NOT NULL,\n    creditos INTEGER NOT NULL,\n    monto INTEGER NOT NULL,\n    estado TEXT NOT NULL,\n    creada TEXT NOT NULL,\n    pago_id TEXT,\n    url_pago TEXT\n);\nCREATE TABLE IF NOT EXISTS correos''',1)\ns+='''\n\ndef crear_compra(socio_id, pack, creditos, monto, creada):\n    with conexion() as con:\n        cur = con.execute(\"INSERT INTO compras (socio_id, pack, creditos, monto, estado, creada) \"\n                          \"VALUES (?, ?, ?, ?, 'pendiente', ?)\", (socio_id, pack, creditos, monto, a_texto(creada)))\n    return compra(cur.lastrowid)\n\n\ndef compra(compra_id):\n    return _una('SELECT * FROM compras WHERE id = ?', (compra_id,))\n\n\ndef compras_de(socio_id):\n    return _varias('SELECT * FROM compras WHERE socio_id = ? ORDER BY creada DESC, id DESC', (socio_id,))\n\n\ndef compras_pendientes():\n    return _varias(\"SELECT * FROM compras WHERE estado = 'pendiente' ORDER BY id\")\n\n\ndef guardar_pago_compra(compra_id, pago_id, url_pago):\n    with conexion() as con:\n        con.execute('UPDATE compras SET pago_id = ?, url_pago = ? WHERE id = ? AND pago_id IS NULL',\n                    (pago_id, url_pago, compra_id))\n\n\ndef cerrar_compra(compra_id, estado):\n    \"\"\"Pasa una compra pendiente a aprobada o rechazada, una sola vez. Si se aprueba, suma los créditos\n    en la misma transacción. Devuelve True si esta llamada hizo el cambio.\"\"\"\n    with conexion() as con:\n        cur = con.execute(\"UPDATE compras SET estado = ? WHERE id = ? AND estado = 'pendiente'\",\n                          (estado, compra_id))\n        if cur.rowcount != 1:\n            return False\n        if estado == 'aprobada':\n            con.execute('UPDATE socios SET creditos = creditos + (SELECT creditos FROM compras WHERE id = ?) '\n                        'WHERE id = (SELECT socio_id FROM compras WHERE id = ?)', (compra_id, compra_id))\n    return True\n'''\nopen(p,'w').write(s)\n\np='pulso/main.py'\ns=open(p).read()\ns=s.replace(\"import os\\n\",\"import os\\nimport re\\n\",1)\ns=s.replace(\"from pulso import correo, db, reloj\",\"from datetime import timedelta\\n\\nfrom pulso import cobra, correo, db, reloj\")\ns=s.replace('''def crear_app''','''PACKS = {'pack-4': {'creditos': 4, 'monto': 1200}, 'pack-8': {'creditos': 8, 'monto': 2200}}\nESPERA_PAGO = timedelta(minutes=30)\n\n\ndef ver_compra(compra):\n    datos = {k: compra[k] for k in ('id', 'pack', 'creditos', 'monto', 'estado', 'creada', 'url_pago')}\n    datos['creada'] = db.a_fecha(compra['creada']).isoformat()\n    return datos\n\n\ndef aplicar_estado(compra, estado_pago):\n    \"\"\"Aplica el estado de un pago (según Cobrá) a una compra. Devuelve la compra actualizada.\"\"\"\n    nuevo = {'aprobado': 'aprobada', 'rechazado': 'rechazada'}.get(estado_pago)\n    if nuevo and db.cerrar_compra(compra['id'], nuevo) and nuevo == 'aprobada':\n        socio = db.socio(compra['socio_id'])\n        correo.enviar(socio['email'], 'Compra de créditos aprobada',\n                      f\"Hola {socio['nombre']}, se acreditaron {compra['creditos']} créditos de tu compra.\")\n    return db.compra(compra['id'])\n\n\nclass NuevaCompra(BaseModel):\n    pack: str | None = None\n\n\n@router.post('/compras', status_code=201)\ndef comprar(datos: NuevaCompra, socio=Depends(socio_actual)):\n    pack = PACKS.get(datos.pack) if datos.pack else None\n    if pack is None:\n        raise HTTPException(422, 'Pack inválido')\n    compra = db.crear_compra(socio['id'], datos.pack, pack['creditos'], pack['monto'], reloj.ahora())\n    try:\n        pago = cobra.crear_pago(pack['monto'], f\"pulso-compra-{compra['id']}\")\n    except cobra.CobraError:\n        raise HTTPException(502, 'No se pudo crear el pago')\n    db.guardar_pago_compra(compra['id'], pago['id'], pago.get('url_pago'))\n    return ver_compra(db.compra(compra['id']))\n\n\n@router.get('/compras')\ndef mis_compras(socio=Depends(socio_actual)):\n    return [ver_compra(c) for c in db.compras_de(socio['id'])]\n\n\nclass AvisoPago(BaseModel):\n    pago_id: str = Field(min_length=1)\n\n\ndef compra_de_referencia(referencia):\n    m = re.fullmatch(r'pulso-compra-([1-9][0-9]{0,17})', referencia or '')\n    return db.compra(int(m.group(1))) if m else None\n\n\n@router.post('/webhooks/pagos')\ndef webhook_pagos(aviso: AvisoPago):\n    try:\n        pago = cobra.obtener_pago(aviso.pago_id)\n    except cobra.CobraError:\n        raise HTTPException(503, 'Cobrá no responde')\n    if pago is None:\n        raise HTTPException(404, 'No existe el pago')\n    compra = compra_de_referencia(pago['referencia'])\n    if compra is None or compra['pago_id'] not in (None, pago['id']):\n        raise HTTPException(404, 'El pago no es de ninguna compra')\n    if compra['pago_id'] is None:\n        db.guardar_pago_compra(compra['id'], pago['id'], pago.get('url_pago'))\n    compra = aplicar_estado(compra, pago['estado'])\n    return {'compra_id': compra['id'], 'estado': compra['estado']}\n\n\ndef conciliar(compra):\n    if compra['pago_id']:\n        pago = cobra.obtener_pago(compra['pago_id'])\n    else:\n        pagos = cobra.buscar_por_referencia(f\"pulso-compra-{compra['id']}\")\n        pago = pagos[0] if pagos else None\n        if pago is None:\n            if reloj.ahora() - db.a_fecha(compra['creada']) >= ESPERA_PAGO:\n                db.cerrar_compra(compra['id'], 'rechazada')\n            return\n        db.guardar_pago_compra(compra['id'], pago['id'], pago.get('url_pago'))\n    if pago is not None:\n        aplicar_estado(compra, pago['estado'])\n\n\n@router.post('/admin/conciliar-pagos', dependencies=[Depends(admin)])\ndef conciliar_pagos():\n    resultado = {'aprobadas': 0, 'rechazadas': 0, 'pendientes': 0}\n    clave = {'aprobada': 'aprobadas', 'rechazada': 'rechazadas', 'pendiente': 'pendientes'}\n    for compra in db.compras_pendientes():\n        try:\n            conciliar(compra)\n        except cobra.CobraError:\n            pass\n        resultado[clave[db.compra(compra['id'])['estado']]] += 1\n    return resultado\n\n\ndef crear_app''',1)\nopen(p,'w').write(s)\nEOF", "bash_command_class": "file_read", "bash_argv0": "cat", "tool_use_id": "toolu_01KigJXfWtNsMRnffRwv7pnd", "gen_ai.tool.call.id": "toolu_01KigJXfWtNsMRnffRwv7pnd", "duration_ms": 10, "_nombre": "claude_code.tool", "_traza": "6758c8f20c4ddf331baa6f612de9ec4e", "_tramo": "b64a5d8b73201ddf", "_padre": "93bce5adc7314ff0", "_inicio_ns": 1794571411558000000, "_fin_ns": 1794571411567727666, "_estado": 0}
