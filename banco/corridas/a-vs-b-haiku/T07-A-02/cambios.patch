+from datetime import timedelta
+
+import httpx
+import pytest
+
+from conftest import ADMIN, AHORA, auth
+from pulso import db, reloj
+
+
+class FakeCobra:
+    def __init__(self):
+        self.pagos = {}
+        self.llamadas = []
+        self.falla = False
+        self.falla_crear = False
+
+    def pago(self, referencia, estado='pendiente', monto=1200):
+        id_ = f'pag_{len(self.pagos) + 1}'
+        self.pagos[id_] = {'id': id_, 'estado': estado, 'monto': monto, 'moneda': 'UYU',
+                           'referencia': referencia, 'url_pago': f'https://pagar.cobra.uy/{id_}'}
+        return self.pagos[id_]
+
+    def request(self, metodo, url, headers=None, json=None, params=None, timeout=None):
+        self.llamadas.append((metodo, url, headers, json, params, timeout))
+        req = httpx.Request(metodo, url)
+        if self.falla or (self.falla_crear and metodo == 'POST'):
+            raise httpx.ConnectError('caído')
+        assert url.startswith('https://api.cobra.uy/v1/')
+        assert headers['X-Cobra-Clave'] == 'clave-cobra'
+        ruta = url.removeprefix('https://api.cobra.uy/v1')
+        if metodo == 'POST':
+            existente = [p for p in self.pagos.values() if p['referencia'] == headers['Idempotency-Key']]
+            if existente:
+                return httpx.Response(200, json=existente[0], request=req)
+            return httpx.Response(201, json=self.pago(json['referencia'], monto=json['monto']), request=req)
+        if ruta == '/pagos':
+            return httpx.Response(200, request=req, json={'pagos': [
+                p for p in self.pagos.values() if p['referencia'] == params['referencia']]})
+        p = self.pagos.get(ruta.removeprefix('/pagos/'))
+        return httpx.Response(200, json=p, request=req) if p else httpx.Response(404, json={}, request=req)
+
+
+@pytest.fixture
+def cobra(cliente, monkeypatch):
+    monkeypatch.setenv('PULSO_PAGOS_URL', 'https://api.cobra.uy/v1')
+    monkeypatch.setenv('PULSO_PAGOS_CLAVE', 'clave-cobra')
+    fake = FakeCobra()
+    monkeypatch.setattr(httpx, 'request', fake.request)
+    return fake
+
+
+def comprar(cliente, socio, pack='pack-4'):
+    return cliente.post('/compras', json={'pack': pack}, headers=auth(socio))
+
+
+def creditos(cliente, socio):
+    return cliente.get('/yo', headers=auth(socio)).json()['creditos']
+
+
+def test_compra_crea_pago(cliente, socio, cobra):
+    r = comprar(cliente, socio, 'pack-8')
+    assert r.status_code == 201
+    assert r.json() == {'id': 1, 'pack': 'pack-8', 'creditos': 8, 'monto': 2200, 'estado': 'pendiente',
+                        'creada': '2026-11-10T15:00:00+00:00', 'url_pago': 'https://pagar.cobra.uy/pag_1'}
+    metodo, url, headers, cuerpo, _, timeout = cobra.llamadas[0]
+    assert (metodo, url) == ('POST', 'https://api.cobra.uy/v1/pagos')
+    assert headers['Idempotency-Key'] == 'pulso-compra-1'
+    assert cuerpo == {'monto': 2200, 'moneda': 'UYU', 'referencia': 'pulso-compra-1'}
+    assert timeout == 5
+    assert creditos(cliente, socio) == 8
+
+
+@pytest.mark.parametrize('cuerpo', [{}, {'pack': 'pack-99'}, {'pack': None}, {'pack': 4}])
+def test_pack_invalido(cliente, socio, cobra, cuerpo):
+    assert cliente.post('/compras', json=cuerpo, headers=auth(socio)).status_code == 422
+    assert cobra.llamadas == []
+    assert cliente.get('/compras', headers=auth(socio)).json() == []
+
+
+def test_compra_sin_token(cliente, cobra):
+    assert cliente.post('/compras', json={'pack': 'pack-4'}).status_code == 401
+
+
+def test_cobra_falla_al_crear(cliente, socio, cobra):
+    cobra.falla = True
+    assert comprar(cliente, socio).status_code == 502
+    [c] = cliente.get('/compras', headers=auth(socio)).json()
+    assert c['estado'] == 'pendiente' and c['url_pago'] is None
+
+
+def test_listado_orden(cliente, socio, cobra):
+    comprar(cliente, socio)
+    reloj.fijar(AHORA + timedelta(minutes=1))
+    comprar(cliente, socio, 'pack-8')
+    assert [c['id'] for c in cliente.get('/compras', headers=auth(socio)).json()] == [2, 1]
+    otro = db.crear_socio('Juan', 'juan@example.com')
+    assert cliente.get('/compras', headers=auth(otro)).json() == []
+
+
+def test_webhook_aprueba_una_sola_vez(cliente, socio, cobra):
+    comprar(cliente, socio)
+    cobra.pagos['pag_1']['estado'] = 'aprobado'
+    for _ in range(2):
+        r = cliente.post('/webhooks/pagos', json={'pago_id': 'pag_1', 'estado': 'rechazado'})
+        assert r.json() == {'compra_id': 1, 'estado': 'aprobada'}
+    assert creditos(cliente, socio) == 12
+    [mail] = db.correos()
+    assert mail['asunto'] == 'Compra de créditos aprobada' and mail['para'] == 'ana@example.com'
+
+
+def test_webhook_rechazado_y_pendiente(cliente, socio, cobra):
+    comprar(cliente, socio)
+    comprar(cliente, socio)
+    cobra.pagos['pag_2']['estado'] = 'rechazado'
+    assert cliente.post('/webhooks/pagos', json={'pago_id': 'pag_1', 'estado': 'aprobado'}).json()['estado'] == 'pendiente'
+    assert cliente.post('/webhooks/pagos', json={'pago_id': 'pag_2'}).json()['estado'] == 'rechazada'
+    assert creditos(cliente, socio) == 8
+    assert db.correos() == []
+    # una compra final no cambia
+    cobra.pagos['pag_2']['estado'] = 'aprobado'
+    assert cliente.post('/webhooks/pagos', json={'pago_id': 'pag_2'}).json()['estado'] == 'rechazada'
+    assert creditos(cliente, socio) == 8
+
+
+def test_webhook_errores(cliente, socio, cobra):
+    assert cliente.post('/webhooks/pagos', json={}).status_code == 422
+    assert cliente.post('/webhooks/pagos', json={'pago_id': 'nada'}).status_code == 404
+    cobra.pago('otra-cosa', 'aprobado')
+    cobra.pago('pulso-compra-99', 'aprobado')
+    assert cliente.post('/webhooks/pagos', json={'pago_id': 'pag_1'}).status_code == 404
+    assert cliente.post('/webhooks/pagos', json={'pago_id': 'pag_2'}).status_code == 404
+    cobra.falla = True
+    assert cliente.post('/webhooks/pagos', json={'pago_id': 'pag_1'}).status_code == 503
+
+
+def test_webhook_guarda_pago_de_compra_sin_pago(cliente, socio, cobra):
+    cobra.falla = True
+    comprar(cliente, socio)
+    cobra.falla = False
+    cobra.pago('pulso-compra-1', 'aprobado')
+    assert cliente.post('/webhooks/pagos', json={'pago_id': 'pag_1'}).json()['estado'] == 'aprobada'
+    c = db.compra(1)
+    assert c['pago_id'] == 'pag_1' and c['url_pago'] == 'https://pagar.cobra.uy/pag_1'
+
+
+def test_conciliar_requiere_admin(cliente, cobra):
+    assert cliente.post('/admin/conciliar-pagos').status_code == 401
+    assert cliente.post('/admin/conciliar-pagos', headers={'X-Admin-Key': 'x'}).status_code == 401
+
+
+def test_conciliar(cliente, socio, cobra):
+    otro = db.crear_socio('Juan', 'juan@example.com')
+    comprar(cliente, socio)        # 1: aprobada
+    comprar(cliente, otro)         # 2: rechazada
+    comprar(cliente, socio)        # 3: sigue pendiente
+    cobra.falla = True
+    comprar(cliente, socio)        # 4: sin pago, hallado por referencia, aprobado
+    comprar(cliente, socio)        # 5: sin pago, no existe, vieja
+    cobra.falla = False
+    cobra.pagos['pag_1']['estado'] = 'aprobado'
+    cobra.pagos['pag_2']['estado'] = 'rechazado'
+    cobra.pago('pulso-compra-4', 'aprobado')
+    reloj.fijar(AHORA + timedelta(minutes=30))
+    cobra.falla_crear = True
+    comprar(cliente, socio)        # 6: sin pago por falla, nueva
+    cobra.falla_crear = False
+    r = cliente.post('/admin/conciliar-pagos', headers=ADMIN)
+    assert r.json() == {'aprobadas': 2, 'rechazadas': 2, 'pendientes': 2}
+    assert db.compra(4)['pago_id'] == 'pag_4'
+    assert creditos(cliente, socio) == 16
+    # Ya resueltas: no se cuentan
+    assert cliente.post('/admin/conciliar-pagos', headers=ADMIN).json() == {'aprobadas': 0, 'rechazadas': 0, 'pendientes': 2}
+    assert len(db.correos()) == 2
+
+
+def test_conciliar_sin_pago_reciente_y_falla_de_cobra(cliente, socio, cobra):
+    cobra.falla = True
+    comprar(cliente, socio)
+    reloj.fijar(AHORA + timedelta(minutes=29))
+    cobra.falla = False
+    assert cliente.post('/admin/conciliar-pagos', headers=ADMIN).json()['pendientes'] == 1
+    reloj.fijar(AHORA + timedelta(hours=2))
+    cobra.falla = True  # una búsqueda que falla nunca rechaza
+    assert cliente.post('/admin/conciliar-pagos', headers=ADMIN).json() == {'aprobadas': 0, 'rechazadas': 0, 'pendientes': 1}
+    assert db.compra(1)['estado'] == 'pendiente'
