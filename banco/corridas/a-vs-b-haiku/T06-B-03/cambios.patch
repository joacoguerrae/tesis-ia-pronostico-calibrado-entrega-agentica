+@contextmanager
+def transaccion():
+    """Agrupa todas las operaciones de adentro en una sola transacción: commit al salir, rollback si hay error."""
+    if getattr(_en_transaccion, 'con', None) is not None:
+        yield _en_transaccion.con
+        return
+    with conexion() as con:
+        # BEGIN IMMEDIATE toma el lock de escritura desde el principio: así las lecturas de adentro
+        # no pueden mezclarse con las de otra operación que corra al mismo tiempo.
+        con.execute('BEGIN IMMEDIATE')
