+    hora: str | None = Field(default=None, pattern=HORA)
+    instructor: Texto | None = None
+    cupo: int | None = Field(default=None, ge=1)
+
+    @model_validator(mode='after')
+    def hay_cambios(self):
+        cambios = self.model_fields_set - {'desde_clase_id'}
+        if not cambios:
+            raise ValueError('no hay ningún cambio')
+        for campo in cambios:
+            if getattr(self, campo) is None:
+                raise ValueError(f'{campo} no puede ser null')
+        return self
+
+
+@router.patch('/admin/series/{serie_id}', dependencies=[Depends(admin)])
+def cambiar_serie(serie_id: int, datos: CambioSerie):
+    serie = db.serie(serie_id)
+    if serie is None:
+        raise HTTPException(404, 'No existe la serie')
+    desde = db.clase(datos.desde_clase_id)
+    if desde is None or desde['serie_id'] != serie_id:
+        raise HTTPException(404, 'La clase no es de esta serie')
+    ahora = reloj.ahora()
+    inicio_desde = db.a_fecha(desde['inicio'])
+    if inicio_desde <= ahora:
+        raise HTTPException(409, 'La clase ya empezó')
+
+    afectadas = [c for c in db.clases_de_serie(serie_id)
+                 if c['estado'] == 'programada' and db.a_fecha(c['inicio']) >= inicio_desde]
+    nuevos = {}
+    for c in afectadas:
+        inicio = db.a_fecha(c['inicio'])
+        nuevos[c['id']] = con_hora(inicio, datos.hora) if datos.hora else inicio
+        if datos.hora and nuevos[c['id']] <= ahora:
+            raise HTTPException(409, 'Con la hora nueva, una clase empezaría antes de ahora')
+    if datos.cupo is not None and any(db.confirmadas(c['id']) > datos.cupo for c in afectadas):
+        raise HTTPException(409, 'Con el cupo nuevo, una clase quedaría con más reservas que lugares')
+
+    avisos = []
+    for c in afectadas:
+        if nuevos[c['id']] != db.a_fecha(c['inicio']):
+            for reserva in db.reservas_confirmadas(c['id']):
+                avisos.append((reserva['email'],
+                               f"Cambio de horario: {c['nombre']} el {correo.fecha_y_hora(nuevos[c['id']])}",
+                               f"Hola {reserva['nombre']}, la clase {c['nombre']} cambió de horario. "
+                               f"Ahora es el {correo.fecha_y_hora(nuevos[c['id']])}."))
+
+    with db.conexion() as con:
+        for c in afectadas:
+            db.actualizar_clase(con, c['id'], inicio=nuevos[c['id']], instructor=datos.instructor, cupo=datos.cupo)
+        db.actualizar_serie(con, serie_id, hora=datos.hora, instructor=datos.instructor, cupo=datos.cupo)
+    for para, asunto, cuerpo in avisos:
+        correo.enviar(para, asunto, cuerpo)
+    return ver_serie(db.serie(serie_id))
+
+
+@router.post('/admin/clases/{clase_id}/cancelar', dependencies=[Depends(admin)])
+def cancelar_una_clase(clase_id: int):
+    clase = db.clase(clase_id)
+    if clase is None:
+        raise HTTPException(404, 'No existe la clase')
+    if clase['estado'] == 'cancelada':
+        raise HTTPException(409, 'La clase ya está cancelada')
+    inicio = db.a_fecha(clase['inicio'])
+    if inicio <= reloj.ahora():
+        raise HTTPException(409, 'La clase ya empezó')
+    reservas = db.reservas_confirmadas(clase_id)
+    with db.conexion() as con:
+        db.cancelar_clase(con, clase_id)
+        db.cancelar_reservas(con, clase_id)
+    for reserva in reservas:
+        correo.enviar(reserva['email'], f"Clase cancelada: {clase['nombre']} el {correo.fecha_y_hora(inicio)}",
+                      f"Hola {reserva['nombre']}, se canceló {clase['nombre']} y te devolvimos el crédito.")
+    return ver_clase(db.clase(clase_id))
+
