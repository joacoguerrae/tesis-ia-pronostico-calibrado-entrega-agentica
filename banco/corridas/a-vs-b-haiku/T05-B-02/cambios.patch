diff --git a/tests/test_recordatorios.py b/tests/test_recordatorios.py
new file mode 100644
index 0000000..24e986b
--- /dev/null
+++ b/tests/test_recordatorios.py
@@ -0,0 +1,69 @@
+from datetime import timedelta
+
+from conftest import ADMIN, AHORA, auth
+from pulso import db
+
+
+def llamar(cliente, headers=ADMIN):
+    return cliente.post('/admin/recordatorios', headers=headers)
+
+
+def test_requiere_clave_de_administracion(cliente):
+    assert llamar(cliente, headers={}).status_code == 401
+    assert llamar(cliente, headers={'X-Admin-Key': 'otra'}).status_code == 401
+
+
+def test_manda_recordatorio_con_asunto_y_cuerpo(cliente, socio):
+    clase = db.crear_clase('Yoga', 'Sofía', AHORA + timedelta(hours=6, minutes=30))
+    db.crear_reserva(socio['id'], clase['id'], AHORA)
+    r = llamar(cliente)
+    assert r.status_code == 200
+    assert r.json() == {'enviados': 1}
+    [enviado] = db.correos()
+    assert enviado['para'] == 'ana@example.com'
+    assert enviado['asunto'] == 'Recordatorio: Yoga el 10/11 a las 18:30'
+    assert 'Sofía' in enviado['cuerpo']
+
+
+def test_ventana_incluye_24_horas_exactas_y_excluye_el_momento_actual(cliente, socio):
+    db.crear_reserva(socio['id'], db.crear_clase('Justo ahora', 'X', AHORA)['id'], AHORA)
+    db.crear_reserva(socio['id'], db.crear_clase('Limite', 'X', AHORA + timedelta(hours=24))['id'], AHORA)
+    db.crear_reserva(socio['id'], db.crear_clase('Pasada', 'X', AHORA - timedelta(minutes=1))['id'], AHORA)
+    db.crear_reserva(socio['id'], db.crear_clase('Lejana', 'X', AHORA + timedelta(hours=24, seconds=1))['id'], AHORA)
+    assert llamar(cliente).json() == {'enviados': 1}
+    [enviado] = db.correos()
+    assert enviado['asunto'].startswith('Recordatorio: Limite ')
+
+
+def test_no_repite_recordatorios_aunque_se_llame_varias_veces(cliente, socio):
+    clase = db.crear_clase('Yoga', 'Sofía', AHORA + timedelta(hours=3))
+    db.crear_reserva(socio['id'], clase['id'], AHORA)
+    assert llamar(cliente).json() == {'enviados': 1}
+    assert llamar(cliente).json() == {'enviados': 0}
+    assert len(db.correos()) == 1
+
+
+def test_reserva_hecha_con_menos_de_24_horas_recibe_recordatorio(cliente, socio):
+    clase = db.crear_clase('Spinning', 'Leo', AHORA + timedelta(hours=2))
+    assert cliente.post('/reservas', json={'clase_id': clase['id']}, headers=auth(socio)).status_code == 201
+    assert llamar(cliente).json() == {'enviados': 1}
+    assert llamar(cliente).json() == {'enviados': 0}
+    asuntos = [c['asunto'] for c in db.correos()]
+    assert asuntos[0].startswith('Reserva confirmada: Spinning')
+    assert asuntos[1].startswith('Recordatorio: Spinning')
+
+
+def test_no_recuerda_reservas_no_confirmadas(cliente, socio):
+    clase = db.crear_clase('Yoga', 'Sofía', AHORA + timedelta(hours=3))
+    db.crear_reserva(socio['id'], clase['id'], AHORA, estado='cancelada')
+    assert llamar(cliente).json() == {'enviados': 0}
+    assert db.correos() == []
+
+
+def test_cada_socio_recibe_su_recordatorio(cliente, socio):
+    otro = db.crear_socio('Juan Gómez', 'juan@example.com')
+    clase = db.crear_clase('Yoga', 'Sofía', AHORA + timedelta(hours=3))
+    db.crear_reserva(socio['id'], clase['id'], AHORA)
+    db.crear_reserva(otro['id'], clase['id'], AHORA)
+    assert llamar(cliente).json() == {'enviados': 2}
+    assert sorted(c['para'] for c in db.correos()) == ['ana@example.com', 'juan@example.com']
