{"host.arch": "arm64", "os.type": "darwin", "os.version": "23.4.0", "service.name": "claude-code", "service.version": "2.1.312", "user.id": "", "session.id": "61d3cbd9-69fa-4d2c-a91b-9b24e9989d2c", "terminal.type": "claude-desktop", "gen_ai.provider.name": "anthropic", "span.type": "tool", "tool_name": "Bash", "tool_name_safe": "Bash", "gen_ai.operation.name": "execute_tool", "gen_ai.tool.name": "Bash", "gen_ai.conversation.id": "61d3cbd9-69fa-4d2c-a91b-9b24e9989d2c", "full_command": "cat > tests/test_cancelar.py <<'EOF'\nfrom datetime import timedelta\n\nfrom conftest import AHORA, auth\nfrom pulso import db\n\n\ndef reservar(cliente, socio, clase):\n    return cliente.post('/reservas', json={'clase_id': clase['id']}, headers=auth(socio)).json()\n\n\ndef cancelar(cliente, socio, reserva_id):\n    return cliente.post(f'/reservas/{reserva_id}/cancelar', headers=auth(socio))\n\n\ndef test_cancela_con_anticipacion_devuelve_credito(cliente, socio):\n    clase = db.crear_clase('Yoga', 'Sofía', AHORA + timedelta(hours=2))\n    res = reservar(cliente, socio, clase)\n    r = cancelar(cliente, socio, res['id'])\n    assert r.status_code == 200\n    assert r.json() == {'id': res['id'], 'clase_id': clase['id'], 'estado': 'cancelada',\n                        'creada': res['creada'], 'credito_devuelto': True}\n    assert cliente.get('/yo', headers=auth(socio)).json()['creditos'] == 8\n    assert cliente.get(f\"/clases/{clase['id']}\").json()['lugares_libres'] == 20\n\n\ndef test_cancela_tarde_sin_credito(cliente, socio):\n    clase = db.crear_clase('Yoga', 'Sofía', AHORA + timedelta(hours=1, minutes=59))\n    res = reservar(cliente, socio, clase)\n    r = cancelar(cliente, socio, res['id'])\n    assert r.status_code == 200\n    assert r.json()['credito_devuelto'] is False\n    assert cliente.get('/yo', headers=auth(socio)).json()['creditos'] == 7\n    assert cliente.get(f\"/clases/{clase['id']}\").json()['lugares_libres'] == 20\n\n\ndef test_no_cancela_dos_veces(cliente, socio):\n    clase = db.crear_clase('Yoga', 'Sofía', AHORA + timedelta(hours=5))\n    res = reservar(cliente, socio, clase)\n    assert cancelar(cliente, socio, res['id']).status_code == 200\n    assert cancelar(cliente, socio, res['id']).status_code == 409\n    assert cliente.get('/yo', headers=auth(socio)).json()['creditos'] == 8\n\n\ndef test_no_cancela_clase_empezada(cliente, socio):\n    clase = db.crear_clase('Yoga', 'Sofía', AHORA + timedelta(hours=5))\n    res = reservar(cliente, socio, clase)\n    from pulso import reloj\n    reloj.fijar(AHORA + timedelta(hours=5))\n    assert cancelar(cliente, socio, res['id']).status_code == 409\n\n\ndef test_ajena_o_inexistente_404(cliente, socio):\n    clase = db.crear_clase('Yoga', 'Sofía', AHORA + timedelta(hours=5))\n    res = reservar(cliente, socio, clase)\n    otro = db.crear_socio('Juan Gómez', 'juan@example.com')\n    assert cancelar(cliente, otro, res['id']).status_code == 404\n    assert cancelar(cliente, socio, 999).status_code == 404\n    assert cliente.post(f\"/reservas/{res['id']}/cancelar\").status_code == 401\n\n\ndef test_sigue_en_listado_y_se_puede_reservar_de_nuevo(cliente, socio):\n    clase = db.crear_clase('Yoga', 'Sofía', AHORA + timedelta(hours=5), cupo=1)\n    res = reservar(cliente, socio, clase)\n    cancelar(cliente, socio, res['id'])\n    lista = cliente.get('/reservas', headers=auth(socio)).json()\n    assert [(x['id'], x['estado']) for x in lista] == [(res['id'], 'cancelada')]\n    assert cliente.post('/reservas', json={'clase_id': clase['id']}, headers=auth(socio)).status_code == 201\nEOF\npython -m pytest -q 2>&1 | tail -5", "bash_command_class": "file_read", "bash_argv0": "cat", "tool_use_id": "toolu_01Jpd84mbCjfjH5wXSxRNAgE", "gen_ai.tool.call.id": "toolu_01Jpd84mbCjfjH5wXSxRNAgE", "duration_ms": 8, "_nombre": "claude_code.tool", "_traza": "944d047f4bb75f210844d8253890d9b8", "_tramo": "bf8230fd4cf6dab1", "_padre": "900d5415ba0e5535", "_inicio_ns": 1794570592619000000, "_fin_ns": 1794570592626901083, "_estado": 0}
