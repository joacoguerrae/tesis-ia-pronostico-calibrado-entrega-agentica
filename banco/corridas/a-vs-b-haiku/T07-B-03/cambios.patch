+++ b/pulso/db.py
@@ -36,6 +36,17 @@ CREATE TABLE IF NOT EXISTS correos (
     cuerpo TEXT NOT NULL,
     creado TEXT NOT NULL
 );
+CREATE TABLE IF NOT EXISTS compras (
+    id INTEGER PRIMARY KEY,
+    socio_id INTEGER NOT NULL REFERENCES socios(id),
+    pack TEXT NOT NULL,
+    creditos INTEGER NOT NULL,
+    monto INTEGER NOT NULL,
+    estado TEXT NOT NULL,
+    creada TEXT NOT NULL,
+    pago_id TEXT,
+    url_pago TEXT
+);
 """
 
 
@@ -136,3 +147,56 @@ def sumar_creditos(socio_id, cantidad):
 
 def correos():
     return _varias('SELECT * FROM correos ORDER BY id')
+
+
+def crear_compra(socio_id, pack, creditos, monto, creada):
+    with conexion() as con:
+        cur = con.execute('INSERT INTO compras (socio_id, pack, creditos, monto, estado, creada) '
+                          "VALUES (?, ?, ?, ?, 'pendiente', ?)",
+                          (socio_id, pack, creditos, monto, a_texto(creada)))
+    return compra(cur.lastrowid)
+
+
+def compra(compra_id):
+    return _una('SELECT * FROM compras WHERE id = ?', (compra_id,))
+
+
+def compras_de(socio_id):
+    return _varias('SELECT * FROM compras WHERE socio_id = ? ORDER BY creada DESC, id DESC', (socio_id,))
+
+
+def compras_pendientes():
+    return _varias("SELECT * FROM compras WHERE estado = 'pendiente' ORDER BY id")
+
+
+def guardar_pago(compra_id, pago_id, url_pago):
+    """Guarda el pago de la compra. No pisa un pago que ya tenga."""
+    with conexion() as con:
+        con.execute('UPDATE compras SET pago_id = ?, url_pago = ? WHERE id = ? AND pago_id IS NULL',
+                    (pago_id, url_pago, compra_id))
+
+
+def aprobar_compra(compra_id):
+    """Pasa una compra pendiente a aprobada y suma sus créditos, en una sola transacción.
+    Devuelve False si la compra no estaba pendiente, así los créditos se suman una sola vez."""
+    with conexion() as con:
+        cur = con.execute("UPDATE compras SET estado = 'aprobada' WHERE id = ? AND estado = 'pendiente'", (compra_id,))
+        if cur.rowcount != 1:
+            return False
+        con.execute('UPDATE socios SET creditos = creditos + (SELECT creditos FROM compras WHERE id = ?) '
+                    'WHERE id = (SELECT socio_id FROM compras WHERE id = ?)', (compra_id, compra_id))
+    return True
+
+
+def rechazar_compra(compra_id):
+    with conexion() as con:
+        cur = con.execute("UPDATE compras SET estado = 'rechazada' WHERE id = ? AND estado = 'pendiente'", (compra_id,))
+    return cur.rowcount == 1
+
+
+def rechazar_compra_sin_pago(compra_id):
+    """Rechaza una compra pendiente que nunca tuvo pago."""
+    with conexion() as con:
+        cur = con.execute("UPDATE compras SET estado = 'rechazada' "
+                          "WHERE id = ? AND estado = 'pendiente' AND pago_id IS NULL", (compra_id,))
+    return cur.rowcount == 1
