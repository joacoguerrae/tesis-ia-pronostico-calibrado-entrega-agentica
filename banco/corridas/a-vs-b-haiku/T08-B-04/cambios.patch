     id INTEGER PRIMARY KEY,
@@ -58,6 +59,14 @@ def conexion():
 def inicializar():
     with conexion() as con:
         con.executescript(ESQUEMA)
+        _migrar(con)
+
+
+def _migrar(con):
+    # Bases creadas antes de existir la columna convenio.
+    columnas = {fila['name'] for fila in con.execute('PRAGMA table_info(socios)')}
+    if 'convenio' not in columnas:
+        con.execute('ALTER TABLE socios ADD COLUMN convenio TEXT')
 
 
 def a_texto(momento):
@@ -134,5 +143,25 @@ def sumar_creditos(socio_id, cantidad):
         con.execute('UPDATE socios SET creditos = creditos + ? WHERE id = ?', (cantidad, socio_id))
 
 
+def socios_corporativos():
+    return _varias("SELECT * FROM socios WHERE plan = 'corporativo' ORDER BY id")
+
+
+def activar_corporativo(socio_id, empresa):
+    """Pasa el socio a corporativo con piso de 12 créditos. Devuelve False si ya lo era."""
+    with conexion() as con:
+        cur = con.execute("UPDATE socios SET plan = 'corporativo', creditos = MAX(creditos, 12), convenio = ? "
+                          "WHERE id = ? AND plan <> 'corporativo'", (empresa, socio_id))
+    return cur.rowcount == 1
+
+
+def bajar_a_basico(socio_id):
+    """Vuelve el socio a basico conservando sus créditos. Devuelve False si ya no era corporativo."""
+    with conexion() as con:
+        cur = con.execute("UPDATE socios SET plan = 'basico', convenio = NULL "
+                          "WHERE id = ? AND plan = 'corporativo'", (socio_id,))
+    return cur.rowcount == 1
+
+
 def correos():
     return _varias('SELECT * FROM correos ORDER BY id')
