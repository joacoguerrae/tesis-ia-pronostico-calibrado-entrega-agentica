+def resolver_compra(compra_id, estado):
+    """Pasa una compra pendiente a 'aprobada' o 'rechazada', una sola vez.
+    Si se aprueba, suma los créditos en la misma transacción. Devuelve True si cambió."""
+    with conexion() as con:
+        cur = con.execute("UPDATE compras SET estado = ? WHERE id = ? AND estado = 'pendiente'",
+                          (estado, compra_id))
+        if cur.rowcount == 0:
+            return False
+        if estado == 'aprobada':
+            con.execute('UPDATE socios SET creditos = creditos + '
+                        '(SELECT creditos FROM compras WHERE id = ?) WHERE id = '
+                        '(SELECT socio_id FROM compras WHERE id = ?)', (compra_id, compra_id))
+    return True
