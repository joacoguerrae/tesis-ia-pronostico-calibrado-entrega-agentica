         con.executescript(ESQUEMA)
+        con.executescript(ESQUEMA_ESPERA)
 
 
 def a_texto(momento):
@@ -136,3 +137,124 @@ def sumar_creditos(socio_id, cantidad):
 
 def correos():
     return _varias('SELECT * FROM correos ORDER BY id')
+
+
+# --- Lista de espera y panel de recepción ---
+
+ESQUEMA_ESPERA = """
+CREATE TABLE IF NOT EXISTS espera (
+    id INTEGER PRIMARY KEY AUTOINCREMENT,
+    clase_id INTEGER NOT NULL REFERENCES clases(id),
+    socio_id INTEGER NOT NULL REFERENCES socios(id),
+    UNIQUE (clase_id, socio_id)
+);
+"""
+
+
+class Conflicto(Exception):
+    """Una regla de negocio no permite la operación."""
+
+
+class NoExiste(Exception):
+    pass
+
+
+def _posicion(con, clase_id, socio_id):
+    fila = con.execute('SELECT id FROM espera WHERE clase_id = ? AND socio_id = ?', (clase_id, socio_id)).fetchone()
+    if fila is None:
+        return None
+    return con.execute('SELECT COUNT(*) FROM espera WHERE clase_id = ? AND id <= ?',
+                       (clase_id, fila['id'])).fetchone()[0]
+
+
+def posicion_espera(clase_id, socio_id):
+    with conexion() as con:
+        return _posicion(con, clase_id, socio_id)
+
+
+def _confirmadas(con, clase_id):
+    return con.execute("SELECT COUNT(*) FROM reservas WHERE clase_id = ? AND estado = 'confirmada'",
+                       (clase_id,)).fetchone()[0]
+
+
+def anotar_en_espera(clase_id, socio_id, ahora):
+    """Anota al socio al final de la lista. Lanza Conflicto si no corresponde."""
+    with conexion() as con:
+        con.execute('BEGIN IMMEDIATE')
+        c = con.execute('SELECT * FROM clases WHERE id = ?', (clase_id,)).fetchone()
+        if c is None:
+            raise NoExiste()
+        s = con.execute('SELECT * FROM socios WHERE id = ?', (socio_id,)).fetchone()
+        if a_fecha(c['inicio']) <= ahora:
+            raise Conflicto('La clase ya empezó')
+        if _confirmadas(con, clase_id) < c['cupo']:
+            raise Conflicto('La clase tiene lugar: reservá directo')
+        if con.execute("SELECT 1 FROM reservas WHERE clase_id = ? AND socio_id = ? AND estado = 'confirmada'",
+                       (clase_id, socio_id)).fetchone():
+            raise Conflicto('Ya tenés una reserva para esta clase')
+        if _posicion(con, clase_id, socio_id) is not None:
+            raise Conflicto('Ya estás en la lista de espera')
+        if s['creditos'] < 1:
+            raise Conflicto('No te quedan créditos')
+        con.execute('INSERT INTO espera (clase_id, socio_id) VALUES (?, ?)', (clase_id, socio_id))
+        return _posicion(con, clase_id, socio_id)
+
+
+def bajar_de_espera(clase_id, socio_id):
+    with conexion() as con:
+        cur = con.execute('DELETE FROM espera WHERE clase_id = ? AND socio_id = ?', (clase_id, socio_id))
+        return cur.rowcount > 0
+
+
+def _asignar_lugares(con, c, ahora, asunto_ok, asunto_no):
+    """Pasa los lugares libres de la clase a la lista de espera. Corre dentro de la transacción."""
+    if a_fecha(c['inicio']) <= ahora:
+        return
+    while c['cupo'] - _confirmadas(con, c['id']) > 0:
+        primero = con.execute('SELECT * FROM espera WHERE clase_id = ? ORDER BY id LIMIT 1', (c['id'],)).fetchone()
+        if primero is None:
+            return
+        con.execute('DELETE FROM espera WHERE id = ?', (primero['id'],))
+        s = con.execute('SELECT * FROM socios WHERE id = ?', (primero['socio_id'],)).fetchone()
+        if con.execute("SELECT 1 FROM reservas WHERE clase_id = ? AND socio_id = ? AND estado = 'confirmada'",
+                       (c['id'], s['id'])).fetchone():
+            continue
+        if s['creditos'] < 1:
+            asunto, cuerpo = asunto_no, f"Hola {s['nombre']}, no tenés créditos para quedarte con el lugar."
+        else:
+            con.execute("INSERT INTO reservas (socio_id, clase_id, estado, creada) VALUES (?, ?, 'confirmada', ?)",
+                        (s['id'], c['id'], a_texto(ahora)))
+            con.execute('UPDATE socios SET creditos = creditos - 1 WHERE id = ?', (s['id'],))
+            asunto, cuerpo = asunto_ok, f"Hola {s['nombre']}, se liberó un lugar y ya es tuyo."
+        con.execute('INSERT INTO correos (para, asunto, cuerpo, creado) VALUES (?, ?, ?, ?)',
+                    (s['email'], asunto, cuerpo, a_texto(ahora)))
+
+
+def cancelar_reserva(reserva_id, ahora, asunto_ok, asunto_no):
+    """asunto_ok/asunto_no: funciones que reciben la clase y devuelven el asunto del correo."""
+    with conexion() as con:
+        con.execute('BEGIN IMMEDIATE')
+        r = con.execute('SELECT * FROM reservas WHERE id = ?', (reserva_id,)).fetchone()
+        if r is None:
+            raise NoExiste()
+        if r['estado'] == 'cancelada':
+            raise Conflicto('La reserva ya estaba cancelada')
+        con.execute("UPDATE reservas SET estado = 'cancelada' WHERE id = ?", (reserva_id,))
+        con.execute('UPDATE socios SET creditos = creditos + 1 WHERE id = ?', (r['socio_id'],))
+        c = dict(con.execute('SELECT * FROM clases WHERE id = ?', (r['clase_id'],)).fetchone())
+        _asignar_lugares(con, c, ahora, asunto_ok(c), asunto_no(c))
+        return dict(con.execute('SELECT * FROM reservas WHERE id = ?', (reserva_id,)).fetchone())
+
+
+def cambiar_cupo(clase_id, cupo, ahora, asunto_ok, asunto_no):
+    with conexion() as con:
+        con.execute('BEGIN IMMEDIATE')
+        fila = con.execute('SELECT * FROM clases WHERE id = ?', (clase_id,)).fetchone()
+        if fila is None:
+            raise NoExiste()
+        if cupo < _confirmadas(con, clase_id):
+            raise Conflicto('El cupo no puede quedar por debajo de las reservas confirmadas')
+        con.execute('UPDATE clases SET cupo = ? WHERE id = ?', (cupo, clase_id))
+        c = dict(fila, cupo=cupo)
+        _asignar_lugares(con, c, ahora, asunto_ok(c), asunto_no(c))
+        return c
