{"host.arch": "amd64", "os.type": "linux", "os.version": "6.18.33.2-microsoft-standard-WSL2", "service.name": "claude-code", "service.version": "2.1.312", "wsl.version": "2", "user.id": "0f72bbf305cc3cfe4c49efd7a27949e16f5ce38c2de862b736399de5c3c79b13", "session.id": "29a9bdf8-7d27-4231-a0b0-0b151b86277b", "terminal.type": "wsl-Ubuntu-24.04", "gen_ai.provider.name": "anthropic", "span.type": "tool", "tool_name": "Bash", "tool_name_safe": "Bash", "gen_ai.operation.name": "execute_tool", "gen_ai.tool.name": "Bash", "gen_ai.conversation.id": "29a9bdf8-7d27-4231-a0b0-0b151b86277b", "full_command": "cat > tests/test_socios.py <<'EOF'\nimport pytest\n\nfrom pulso import db\nfrom tests.conftest import auth\n\n\ndef alta(cliente, **kw):\n    datos = {'nombre': 'Ana Pérez', 'email': 'Ana.Perez@Example.com', 'plan': 'premium'}\n    datos.update(kw)\n    return cliente.post('/socios', json=datos)\n\n\ndef test_alta_normaliza_y_devuelve_token(cliente):\n    r = alta(cliente, nombre='  Ana Pérez  ', email='  Ana.Perez@Example.com ')\n    assert r.status_code == 201\n    j = r.json()\n    assert (j['nombre'], j['email'], j['plan'], j['creditos']) == ('Ana Pérez', 'ana.perez@example.com', 'premium', 20)\n    assert len(j['token']) >= 32\n    assert cliente.get('/yo', headers={'Authorization': f\"Bearer {j['token']}\"}).json()['id'] == j['id']\n\n\ndef test_creditos_basico(cliente):\n    assert alta(cliente, plan='basico').json()['creditos'] == 8\n\n\ndef test_tokens_distintos(cliente):\n    a = alta(cliente).json()['token']\n    b = alta(cliente, email='otra@example.com').json()['token']\n    assert a != b\n\n\ndef test_correo_bienvenida(cliente):\n    alta(cliente)\n    cs = db.correos()\n    assert len(cs) == 1\n    assert cs[0]['para'] == 'ana.perez@example.com'\n    assert cs[0]['asunto'] == 'Te damos la bienvenida a Pulso'\n\n\ndef test_duplicado_409_sin_segundo_correo(cliente):\n    alta(cliente)\n    assert alta(cliente, email='ANA.PEREZ@example.com ').status_code == 409\n    assert len(db.correos()) == 1\n\n\n@pytest.mark.parametrize('campo,valor', [\n    ('nombre', 'A'), ('nombre', '   '), ('nombre', 'x' * 81), ('nombre', 5),\n    ('email', 'sin-arroba'), ('email', 'a@@b.com'), ('email', 'a b@c.com'), ('email', '@c.com'),\n    ('email', 'a@com'), ('email', 'a@.com'), ('email', 'a@com.'), ('email', 'a@b@c.com'),\n    ('plan', 'oro'), ('plan', None),\n])\ndef test_invalidos_422(cliente, campo, valor):\n    assert alta(cliente, **{campo: valor}).status_code == 422\n    assert db.correos() == []\n\n\n@pytest.mark.parametrize('campo', ['nombre', 'email', 'plan'])\ndef test_falta_dato_422(cliente, campo):\n    datos = {'nombre': 'Ana', 'email': 'a@b.com', 'plan': 'basico'}\n    del datos[campo]\n    assert cliente.post('/socios', json=datos).status_code == 422\n\n\ndef test_limites_nombre(cliente):\n    assert alta(cliente, nombre=' ab ').status_code == 201\n    assert alta(cliente, nombre='x' * 80, email='b@b.com').status_code == 201\nEOF\npython -m pytest -q 2>&1 | tail -8", "bash_command_class": "file_read", "bash_argv0": "cat", "tool_use_id": "toolu_01JAfz69f7EjAyGDBXrPhDGW", "gen_ai.tool.call.id": "toolu_01JAfz69f7EjAyGDBXrPhDGW", "duration_ms": 5, "_nombre": "claude_code.tool", "_traza": "46699c6f13eb50225d9966882d9293e6", "_tramo": "ba70a63701390422", "_padre": "07160139a3bdfccb", "_inicio_ns": 1794687485988000000, "_fin_ns": 1794687485993187678, "_estado": 0}
