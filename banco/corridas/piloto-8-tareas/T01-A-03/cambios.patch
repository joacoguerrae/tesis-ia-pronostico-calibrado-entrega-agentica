--- a/pulso/db.py
+++ b/pulso/db.py
@@ -134,5 +134,18 @@ def sumar_creditos(socio_id, cantidad):
         con.execute('UPDATE socios SET creditos = creditos + ? WHERE id = ?', (cantidad, socio_id))
 
 
+def cancelar_reserva(reserva_id, socio_id, devolver_credito):
+    """Cancela una reserva confirmada y, si corresponde, devuelve el crédito, en una sola transacción.
+    Devuelve False si la reserva ya no estaba confirmada."""
+    with conexion() as con:
+        cur = con.execute("UPDATE reservas SET estado = 'cancelada' WHERE id = ? AND estado = 'confirmada'",
+                          (reserva_id,))
+        if cur.rowcount == 0:
+            return False
+        if devolver_credito:
+            con.execute('UPDATE socios SET creditos = creditos + 1 WHERE id = ?', (socio_id,))
+    return True
+
+
 def correos():
     return _varias('SELECT * FROM correos ORDER BY id')
