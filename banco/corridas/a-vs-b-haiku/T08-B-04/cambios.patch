+def test_revalidar_baja_a_basico_conservando_creditos(cliente, servicio):
+    inactivo = socio_corporativo('a@example.com', 'acme', creditos=20)
+    desconocido = socio_corporativo('b@example.com', 'acme', creditos=12)
+    empresa_borrada = socio_corporativo('c@example.com', 'ya-no-existe', creditos=15)
+    empleados(servicio, {('acme', 'a@example.com'): INACTIVO, ('acme', 'b@example.com'): DESCONOCIDO})
+    r = cliente.post('/admin/revalidar-convenios', headers=ADMIN)
+    assert r.json() == {'siguen': 0, 'bajaron': 3, 'sin_revisar': 0}
+    for socio_id, creditos in ((inactivo['id'], 20), (desconocido['id'], 12), (empresa_borrada['id'], 15)):
+        actual = db.socio(socio_id)
+        assert (actual['plan'], actual['creditos'], actual['convenio']) == ('basico', creditos, None)
+    assert asuntos() == ['Se terminó tu plan corporativo'] * 3
