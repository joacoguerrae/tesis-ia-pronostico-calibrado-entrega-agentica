+def test_migra_base_anterior_sin_columna_convenio(tmp_path, monkeypatch):
+    ruta = tmp_path / 'vieja.db'
+    with sqlite3.connect(ruta) as con:
+        con.execute('CREATE TABLE socios (id INTEGER PRIMARY KEY, nombre TEXT NOT NULL, email TEXT NOT NULL UNIQUE, '
+                    'plan TEXT NOT NULL, creditos INTEGER NOT NULL, token TEXT NOT NULL UNIQUE)')
+        con.execute("INSERT INTO socios (nombre, email, plan, creditos, token) VALUES ('Ana', 'ana@example.com', 'basico', 5, 't')")
+    con.close()
+    monkeypatch.setenv('PULSO_DB', str(ruta))
+    crear_app()
+    actual = db.socio_por_token('t')
+    assert (actual['creditos'], actual['convenio']) == (5, None)
+    crear_app()  # Idempotente: volver a arrancar no falla.
