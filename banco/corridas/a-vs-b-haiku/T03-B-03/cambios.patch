diff --git a/tests/test_ocupacion.py b/tests/test_ocupacion.py
new file mode 100644
index 0000000..b116e75
--- /dev/null
+++ b/tests/test_ocupacion.py
@@ -0,0 +1,139 @@
+import csv
+import io
+from datetime import datetime, timedelta, timezone
+
+from conftest import ADMIN, AHORA
+from pulso import db
+
+CABECERA = 'fecha,hora,clase,instructor,cupo,confirmadas,ocupacion_pct'
+
+
+def exportar(cliente, desde='2026-11-01', hasta='2026-11-30'):
+    return cliente.get('/admin/ocupacion.csv', params={'desde': desde, 'hasta': hasta}, headers=ADMIN)
+
+
+def filas(respuesta):
+    return list(csv.reader(io.StringIO(respuesta.text)))
+
+
+def utc(*args):
+    return datetime(*args, tzinfo=timezone.utc)
+
+
+def test_exige_clave_de_administracion(cliente):
+    params = {'desde': '2026-11-01', 'hasta': '2026-11-30'}
+    assert cliente.get('/admin/ocupacion.csv', params=params).status_code == 401
+    assert cliente.get('/admin/ocupacion.csv', params=params, headers={'X-Admin-Key': 'otra'}).status_code == 401
+
+
+def test_respuesta_es_csv_con_cabecera_y_una_fila_por_clase(cliente):
+    clase = db.crear_clase('Spinning', 'Leo', utc(2026, 11, 3, 10, 0), cupo=20)
+    for nombre in ('Ana', 'Juan', 'Marta'):
+        db.crear_reserva(db.crear_socio(nombre, f'{nombre}@example.com')['id'], clase['id'], AHORA)
+    r = exportar(cliente)
+    assert r.status_code == 200
+    assert r.headers['content-type'] == 'text/csv; charset=utf-8'
+    assert r.text.splitlines()[0] == CABECERA
+    assert filas(r) == [CABECERA.split(','), ['2026-11-03', '07:00', 'Spinning', 'Leo', '20', '3', '15']]
+
+
+def test_fecha_y_hora_son_de_montevideo(cliente):
+    db.crear_clase('Yoga', 'Sofía', utc(2026, 11, 3, 22, 30), cupo=10)
+    assert filas(exportar(cliente))[1][:2] == ['2026-11-03', '19:30']
+
+
+def test_filtra_por_dia_local_con_extremos_incluidos(cliente):
+    # 2026-10-31 23:30 en Montevideo: todavía es el 31, queda afuera.
+    db.crear_clase('Antes', 'Leo', utc(2026, 11, 1, 2, 30))
+    # 2026-11-01 00:30 en Montevideo: primer día del período.
+    db.crear_clase('Primera', 'Leo', utc(2026, 11, 1, 3, 30))
+    # 2026-11-30 23:30 en Montevideo: último día del período.
+    db.crear_clase('Ultima', 'Leo', utc(2026, 12, 1, 2, 30))
+    # 2026-12-01 00:30 en Montevideo: ya es diciembre, queda afuera.
+    db.crear_clase('Despues', 'Leo', utc(2026, 12, 1, 3, 30))
+    nombres = [f[2] for f in filas(exportar(cliente))[1:]]
+    assert nombres == ['Primera', 'Ultima']
+
+
+def test_incluye_clases_pasadas_y_futuras(cliente):
+    db.crear_clase('Pasada', 'Leo', AHORA - timedelta(days=5))
+    db.crear_clase('Futura', 'Leo', AHORA + timedelta(days=5))
+    assert [f[2] for f in filas(exportar(cliente))[1:]] == ['Pasada', 'Futura']
+
+
+def test_ordena_por_inicio_y_luego_por_id(cliente):
+    tarde = db.crear_clase('Tarde', 'Leo', utc(2026, 11, 5, 21, 0))
+    primera = db.crear_clase('Primera de empate', 'Leo', utc(2026, 11, 5, 12, 0))
+    segunda = db.crear_clase('Segunda de empate', 'Leo', utc(2026, 11, 5, 12, 0))
+    assert primera['id'] < segunda['id']  # el desempate por id tiene que ser el que decide
+    assert [f[2] for f in filas(exportar(cliente))[1:]] == [
+        'Primera de empate', 'Segunda de empate', 'Tarde']
+
+
+def test_no_cuenta_reservas_canceladas(cliente):
+    clase = db.crear_clase('Yoga', 'Sofía', utc(2026, 11, 4, 15, 0), cupo=10)
+    db.crear_reserva(db.crear_socio('Ana', 'ana@example.com')['id'], clase['id'], AHORA)
+    db.crear_reserva(db.crear_socio('Juan', 'juan@example.com')['id'], clase['id'], AHORA, estado='cancelada')
+    assert filas(exportar(cliente))[1][5] == '1'
+
+
+def test_porcentaje_redondea_mitad_hacia_arriba(cliente):
+    # 1 de 8 es 12,5 %: tiene que dar 13.
+    clase = db.crear_clase('Yoga', 'Sofía', utc(2026, 11, 4, 15, 0), cupo=8)
+    db.crear_reserva(db.crear_socio('Ana', 'ana@example.com')['id'], clase['id'], AHORA)
+    assert filas(exportar(cliente))[1][6] == '13'
+
+
+def test_porcentaje_redondea_al_entero_mas_cercano(cliente):
+    # 2 de 3 es 66,67 %: tiene que dar 67. 1 de 3 es 33,3 %: tiene que dar 33.
+    dos = db.crear_clase('Dos', 'Leo', utc(2026, 11, 4, 15, 0), cupo=3)
+    uno = db.crear_clase('Uno', 'Leo', utc(2026, 11, 4, 16, 0), cupo=3)
+    for i in range(2):
+        db.crear_reserva(db.crear_socio(f'S{i}', f's{i}@example.com')['id'], dos['id'], AHORA)
+    db.crear_reserva(db.crear_socio('T', 't@example.com')['id'], uno['id'], AHORA)
+    assert [f[6] for f in filas(exportar(cliente))[1:]] == ['67', '33']
+
+
+def test_escapa_comas_y_comillas_segun_rfc_4180(cliente):
+    db.crear_clase('Yoga, nivel "1"', 'Sofía', utc(2026, 11, 4, 15, 0), cupo=12)
+    r = exportar(cliente)
+    assert '"Yoga, nivel ""1"""' in r.text
+    assert filas(r)[1][2] == 'Yoga, nivel "1"'
+
+
+def test_sin_clases_devuelve_solo_cabecera(cliente):
+    r = exportar(cliente)
+    assert r.status_code == 200
+    assert r.text.splitlines() == [CABECERA]
+
+
+def test_acepta_periodo_de_31_dias(cliente):
+    assert exportar(cliente, '2026-10-01', '2026-10-31').status_code == 200
+
+
+def test_rechaza_periodo_de_32_dias(cliente):
+    assert exportar(cliente, '2026-10-01', '2026-11-01').status_code == 422
+
+
+def test_rechaza_desde_posterior_a_hasta(cliente):
+    assert exportar(cliente, '2026-11-10', '2026-11-09').status_code == 422
+
+
+def test_acepta_desde_igual_a_hasta(cliente):
+    assert exportar(cliente, '2026-11-10', '2026-11-10').status_code == 200
+
+
+def test_rechaza_fechas_faltantes(cliente):
+    assert cliente.get('/admin/ocupacion.csv', params={'hasta': '2026-11-30'}, headers=ADMIN).status_code == 422
+    assert cliente.get('/admin/ocupacion.csv', params={'desde': '2026-11-01'}, headers=ADMIN).status_code == 422
+    assert cliente.get('/admin/ocupacion.csv', headers=ADMIN).status_code == 422
+
+
+def test_rechaza_formato_invalido(cliente):
+    for valor in ('01/11/2026', '2026-11-1', '20261101', '2026-11-01T00:00', '2026-02-30', 'hoy'):
+        assert exportar(cliente, valor, '2026-11-30').status_code == 422, valor
+        assert exportar(cliente, '2026-11-01', valor).status_code == 422, valor
+
+
+def test_sin_clave_responde_401_aunque_falten_fechas(cliente):
+    assert cliente.get('/admin/ocupacion.csv').status_code == 401
