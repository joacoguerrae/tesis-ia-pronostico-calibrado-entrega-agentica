diff --git a/pulso/compras.py b/pulso/compras.py
new file mode 100644
index 0000000..9bd2f82
--- /dev/null
+++ b/pulso/compras.py
@@ -0,0 +1,89 @@
+"""Compra de packs de créditos, pagada online con Cobrá."""
+import re
+from datetime import timedelta
+
+from pulso import cobra, correo, db, reloj
+
+# pack: (créditos, precio en pesos uruguayos)
+PACKS = {'pack-4': (4, 1200), 'pack-8': (8, 2200)}
+
+# Si pasado este plazo Cobrá no conoce ningún pago para la compra, el pago nunca se creó.
+PLAZO_SIN_PAGO = timedelta(minutes=30)
+
+_REFERENCIA = re.compile(r'pulso-compra-(\d{1,18})')
+# Si hay más de un pago para la misma referencia, gana el más avanzado.
+_PRIORIDAD = {'aprobado': 0, 'pendiente': 1, 'rechazado': 2}
+
+
+def referencia(compra_id):
+    return f'pulso-compra-{compra_id}'
+
+
+def compra_por_referencia(ref):
+    m = _REFERENCIA.fullmatch(ref)
+    return db.compra(int(m.group(1))) if m else None
+
+
+def crear(socio, pack):
+    """Guarda la compra como pendiente y crea su pago en Cobrá. Si Cobrá falla, levanta CobraError y la compra queda sin pago."""
+    creditos, monto = PACKS[pack]
+    compra_nueva = db.crear_compra(socio['id'], pack, creditos, monto, reloj.ahora())
+    pago = cobra.crear_pago(monto, referencia(compra_nueva['id']))
+    db.guardar_pago(compra_nueva['id'], pago['id'], pago['url_pago'])
+    return db.compra(compra_nueva['id'])
+
+
+def _transicionar(compra, nuevo_estado):
+    """Pasa una compra pendiente a aprobada o rechazada. Si la compra ya no estaba pendiente, no hace nada."""
+    socio = db.socio(compra['socio_id']) if nuevo_estado == 'aprobada' else None
+    with db.conexion() as con:
+        if not db.marcar_compra(con, compra['id'], nuevo_estado):
+            return
+        if socio is not None:
+            db.ajustar_creditos(con, socio['id'], compra['creditos'])
+            correo.enviar(socio['email'], 'Compra de créditos aprobada',
+                          f"Hola {socio['nombre']}, tu compra de {compra['creditos']} créditos "
+                          f"({compra['pack']}) fue aprobada y ya los tenés disponibles.", con=con)
+
+
+def aplicar_pago(compra, pago):
+    """Aplica el estado que Cobrá informa para el pago a la compra. Devuelve la compra después de aplicarlo."""
+    if compra['estado'] == 'pendiente':
+        if compra['pago_id'] is None:
+            db.guardar_pago(compra['id'], pago['id'], pago['url_pago'])
+        nuevo_estado = {'aprobado': 'aprobada', 'rechazado': 'rechazada'}.get(pago['estado'])
+        if nuevo_estado:
+            _transicionar(compra, nuevo_estado)
+    return db.compra(compra['id'])
+
+
+def _conciliar(compra):
+    if compra['pago_id'] is not None:
+        pago = cobra.obtener_pago(compra['pago_id'])
+    else:
+        pagos = cobra.buscar_pagos(referencia(compra['id']))
+        if not pagos:
+            creada = db.a_fecha(compra['creada'])
+            if reloj.ahora() - creada >= PLAZO_SIN_PAGO:
+                _transicionar(compra, 'rechazada')
+            return
+        pago = min(pagos, key=lambda p: _PRIORIDAD[p['estado']])
+    aplicar_pago(compra, pago)
+
+
+def conciliar():
+    """Revisa las compras pendientes con Cobrá. Una falla de Cobrá deja esa compra pendiente y sigue con las demás."""
+    pendientes = db.compras_pendientes()
+    for compra in pendientes:
+        try:
+            _conciliar(compra)
+        except cobra.CobraError:
+            pass
+    estados = [db.compra(c['id'])['estado'] for c in pendientes]
+    return {'aprobadas': estados.count('aprobada'),
+            'rechazadas': estados.count('rechazada'),
+            'pendientes': estados.count('pendiente')}
+
+
+def ver(compra):
+    return {k: compra[k] for k in ('id', 'pack', 'creditos', 'monto', 'estado', 'creada', 'url_pago')}
