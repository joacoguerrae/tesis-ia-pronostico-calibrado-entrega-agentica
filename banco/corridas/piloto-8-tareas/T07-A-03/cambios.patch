+
+def guardar_pago_compra(compra_id, pago_id, url_pago):
+    with conexion() as con:
+        con.execute('UPDATE compras SET pago_id = ?, url_pago = ? WHERE id = ? AND pago_id IS NULL',
+                    (pago_id, url_pago, compra_id))
+
+
+def cerrar_compra(compra_id, estado):
+    """Pasa una compra pendiente a aprobada o rechazada, una sola vez. Si se aprueba, suma los créditos
+    en la misma transacción. Devuelve True si esta llamada hizo el cambio."""
+    with conexion() as con:
+        cur = con.execute("UPDATE compras SET estado = ? WHERE id = ? AND estado = 'pendiente'",
+                          (estado, compra_id))
+        if cur.rowcount != 1:
+            return False
+        if estado == 'aprobada':
+            con.execute('UPDATE socios SET creditos = creditos + (SELECT creditos FROM compras WHERE id = ?) '
+                        'WHERE id = (SELECT socio_id FROM compras WHERE id = ?)', (compra_id, compra_id))
+    return True
+
+
