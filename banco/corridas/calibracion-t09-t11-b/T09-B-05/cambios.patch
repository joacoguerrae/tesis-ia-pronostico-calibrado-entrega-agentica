 def inicializar():
     with conexion() as con:
         con.executescript(ESQUEMA)
+        _normalizar_inicios(con)
+
+
+def _utc(momento):
+    # Las clases de antes de setiembre se guardaron sin zona horaria, en UTC.
+    if momento.tzinfo is None:
+        momento = momento.replace(tzinfo=timezone.utc)
+    return momento.astimezone(timezone.utc)
 
 
 def a_texto(momento):
-    return momento.astimezone(timezone.utc).replace(microsecond=0).isoformat()
+    return _utc(momento).replace(microsecond=0).isoformat()
 
 
 def a_fecha(texto):
-    # Las clases de antes de setiembre se guardaron sin zona horaria, en UTC.
-    return datetime.fromisoformat(texto).replace(tzinfo=timezone.utc)
+    return _utc(datetime.fromisoformat(texto))
+
+
+def _normalizar_inicios(con):
+    """Pasa a UTC, en el mismo formato, el inicio de las clases guardadas con otro formato.
+
+    Idempotente: las filas que ya están bien no se tocan, y se actualizan en el lugar,
+    así que conservan su id.
+    """
+    for fila in con.execute('SELECT id, inicio FROM clases').fetchall():
+        normal = a_texto(a_fecha(fila['inicio']))
+        if normal != fila['inicio']:
+            con.execute('UPDATE clases SET inicio = ? WHERE id = ?', (normal, fila['id']))
 
 
 def _una(sql, parametros=()):
@@ -98,7 +117,7 @@ def socio_por_token(token):
