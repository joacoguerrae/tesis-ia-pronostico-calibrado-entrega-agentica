diff --git a/tests/test_recordatorios.py b/tests/test_recordatorios.py
new file mode 100644
index 0000000..912e064
--- /dev/null
+++ b/tests/test_recordatorios.py
@@ -0,0 +1,73 @@
+from datetime import timedelta
+
+from conftest import ADMIN, AHORA
+from pulso import db
+
+
+def test_recordatorio_para_clase_en_las_proximas_24_horas(cliente, socio):
+    clase = db.crear_clase('Yoga', 'Sofía', AHORA + timedelta(hours=23))
+    reserva = db.crear_reserva(socio['id'], clase['id'], AHORA)
+    r = cliente.post('/admin/recordatorios', headers=ADMIN)
+    assert r.status_code == 200
+    assert r.json() == {'enviados': 1}
