diff --git a/tests/test_espera.py b/tests/test_espera.py
new file mode 100644
index 0000000..ba4b4dd
--- /dev/null
+++ b/tests/test_espera.py
@@ -0,0 +1,105 @@
+from datetime import timedelta
+
+from conftest import AHORA, auth
+from pulso import db
+
+
+def llena(cupo=1, horas=3):
+    """Clase con `cupo` lugares ocupados por otros socios."""
+    clase = db.crear_clase('Spinning', 'Leo', AHORA + timedelta(hours=horas), cupo=cupo)
+    for i in range(cupo):
+        otro = db.crear_socio(f'Socio {i}', f'otro{i}@example.com')
+        db.crear_reserva(otro['id'], clase['id'], AHORA)
+    return clase
+
+
+def otros_socios(n):
+    return [db.crear_socio(f'Socio {i}', f'espera{i}@example.com') for i in range(n)]
+
+
+def test_anotarse_en_clase_llena_da_posicion_sin_descontar_creditos(cliente, socio):
+    clase = llena()
+    r = cliente.post(f"/clases/{clase['id']}/espera", headers=auth(socio))
+    assert r.status_code == 201
+    assert r.json() == {'clase_id': clase['id'], 'posicion': 1}
+    assert cliente.get('/yo', headers=auth(socio)).json()['creditos'] == 8
+    assert cliente.get('/reservas', headers=auth(socio)).json() == []
+    assert cliente.get(f"/clases/{clase['id']}").json()['lugares_libres'] == 0
+
+
+def test_la_posicion_sigue_el_orden_de_llegada(cliente):
+    clase = llena()
+    a, b, c = otros_socios(3)
+    for s, esperada in ((a, 1), (b, 2), (c, 3)):
+        assert cliente.post(f"/clases/{clase['id']}/espera", headers=auth(s)).json()['posicion'] == esperada
+    assert cliente.get(f"/clases/{clase['id']}/espera", headers=auth(c)).json()['posicion'] == 3
+
+
+def test_al_bajarse_los_de_atras_avanzan(cliente):
+    clase = llena()
+    a, b, c = otros_socios(3)
+    for s in (a, b, c):
+        cliente.post(f"/clases/{clase['id']}/espera", headers=auth(s))
+    assert cliente.delete(f"/clases/{clase['id']}/espera", headers=auth(a)).status_code == 204
+    assert cliente.get(f"/clases/{clase['id']}/espera", headers=auth(b)).json()['posicion'] == 1
+    assert cliente.get(f"/clases/{clase['id']}/espera", headers=auth(c)).json()['posicion'] == 2
+
+
+def test_quien_se_baja_y_vuelve_a_anotarse_queda_ultimo(cliente):
+    clase = llena()
+    a, b = otros_socios(2)
+    cliente.post(f"/clases/{clase['id']}/espera", headers=auth(a))
+    cliente.post(f"/clases/{clase['id']}/espera", headers=auth(b))
+    cliente.delete(f"/clases/{clase['id']}/espera", headers=auth(a))
+    assert cliente.post(f"/clases/{clase['id']}/espera", headers=auth(a)).json()['posicion'] == 2
+    assert cliente.get(f"/clases/{clase['id']}/espera", headers=auth(b)).json()['posicion'] == 1
+
+
+def test_no_anota_si_la_clase_tiene_lugar(cliente, socio):
+    libre = db.crear_clase('Yoga', 'Sofía', AHORA + timedelta(hours=2), cupo=2)
+    db.crear_reserva(db.crear_socio('Juan', 'juan@example.com')['id'], libre['id'], AHORA)
+    assert cliente.post(f"/clases/{libre['id']}/espera", headers=auth(socio)).status_code == 409
+    assert cliente.get(f"/clases/{libre['id']}/espera", headers=auth(socio)).status_code == 404
+
+
+def test_no_anota_con_reserva_confirmada_para_la_clase(cliente, socio):
+    clase = llena(cupo=2)
+    db.crear_reserva(socio['id'], clase['id'], AHORA)
+    r = cliente.post(f"/clases/{clase['id']}/espera", headers=auth(socio))
+    assert r.status_code == 409
+    assert cliente.get(f"/clases/{clase['id']}/espera", headers=auth(socio)).status_code == 404
+
+
+def test_no_anota_dos_veces(cliente, socio):
+    clase = llena()
+    assert cliente.post(f"/clases/{clase['id']}/espera", headers=auth(socio)).status_code == 201
+    assert cliente.post(f"/clases/{clase['id']}/espera", headers=auth(socio)).status_code == 409
+    assert cliente.get(f"/clases/{clase['id']}/espera", headers=auth(socio)).json()['posicion'] == 1
+
+
+def test_no_anota_en_clase_empezada(cliente, socio):
+    clase = db.crear_clase('Yoga', 'Sofía', AHORA, cupo=1)  # empieza justo ahora
+    db.crear_reserva(db.crear_socio('Juan', 'juan@example.com')['id'], clase['id'], AHORA)
+    assert cliente.post(f"/clases/{clase['id']}/espera", headers=auth(socio)).status_code == 409
+
+
+def test_no_anota_sin_creditos(cliente):
+    socio = db.crear_socio('Ana Pérez', 'ana@example.com', creditos=0)
+    clase = llena()
+    assert cliente.post(f"/clases/{clase['id']}/espera", headers=auth(socio)).status_code == 409
+
+
+def test_espera_requiere_token_y_clase_existente(cliente, socio):
+    clase = llena()
+    assert cliente.post(f"/clases/{clase['id']}/espera").status_code == 401
+    assert cliente.get(f"/clases/{clase['id']}/espera").status_code == 401
+    assert cliente.delete(f"/clases/{clase['id']}/espera").status_code == 401
+    assert cliente.post('/clases/99/espera', headers=auth(socio)).status_code == 404
+    assert cliente.get('/clases/99/espera', headers=auth(socio)).status_code == 404
+    assert cliente.delete('/clases/99/espera', headers=auth(socio)).status_code == 404
+
+
+def test_get_y_delete_404_si_no_esta_en_la_lista(cliente, socio):
+    clase = llena()
+    assert cliente.get(f"/clases/{clase['id']}/espera", headers=auth(socio)).status_code == 404
+    assert cliente.delete(f"/clases/{clase['id']}/espera", headers=auth(socio)).status_code == 404
diff --git a/tests/test_panel.py b/tests/test_panel.py
new file mode 100644
index 0000000..2aad4d8
--- /dev/null
+++ b/tests/test_panel.py
@@ -0,0 +1,243 @@
+import sqlite3
+from datetime import timedelta
+
+import pytest
+
+from conftest import ADMIN, AHORA, auth
+from pulso import db, reloj
+
+# La clase empieza 10/11 a las 18:30 en Montevideo.
+INICIO = AHORA + timedelta(hours=6, minutes=30)
+
+
+def llena(cupo=1, inicio=INICIO):
+    """Clase con `cupo` reservas confirmadas de otros socios."""
+    clase = db.crear_clase('Spinning', 'Leo', inicio, cupo=cupo)
+    reservas = []
+    for i in range(cupo):
+        otro = db.crear_socio(f'Ocupa {i}', f'ocupa{i}@example.com')
+        reservas.append(db.crear_reserva(otro['id'], clase['id'], AHORA))
+    return clase, reservas
+
+
+def socio(nombre, creditos=8):
+    return db.crear_socio(nombre, f'{nombre.lower()}@example.com', creditos=creditos)
+
+
+def anotar(cliente, clase, s):
+    r = cliente.post(f"/clases/{clase['id']}/espera", headers=auth(s))
+    assert r.status_code == 201
+    return r
+
+
+def posicion(cliente, clase, s):
+    r = cliente.get(f"/clases/{clase['id']}/espera", headers=auth(s))
+    return r.json()['posicion'] if r.status_code == 200 else None
+
+
+def en_espera(cliente, clase, s):
+    return posicion(cliente, clase, s) is not None
+
+
+def reservas_confirmadas(s, clase):
+    return [r for r in db.reservas_de(s['id']) if r['clase_id'] == clase['id'] and r['estado'] == 'confirmada']
+
+
+def asuntos(para):
+    return [c['asunto'] for c in db.correos() if c['para'] == para]
+
+
+# Cancelar reservas (recepción)
+
+def test_cancelar_requiere_clave_de_admin(cliente):
+    ana = socio('Ana')
+    clase, [reserva] = llena()
+    db.crear_reserva(ana['id'], clase['id'], AHORA)
+    assert cliente.post(f"/admin/reservas/{reserva['id']}/cancelar").status_code == 401
+    assert cliente.post(f"/admin/reservas/{reserva['id']}/cancelar", headers={'X-Admin-Key': 'otra'}).status_code == 401
+    assert db.reserva(reserva['id'])['estado'] == 'confirmada'
+
+
+def test_cancelar_reserva_inexistente(cliente):
+    assert cliente.post('/admin/reservas/99/cancelar', headers=ADMIN).status_code == 404
+
+
+def test_cancelar_devuelve_credito_y_deja_la_reserva_cancelada(cliente):
+    ana = socio('Ana', creditos=7)
+    clase = db.crear_clase('Spinning', 'Leo', INICIO)
+    reserva = db.crear_reserva(ana['id'], clase['id'], AHORA)
+    r = cliente.post(f"/admin/reservas/{reserva['id']}/cancelar", headers=ADMIN)
+    assert r.status_code == 200
+    assert r.json() == {'id': reserva['id'], 'clase_id': clase['id'], 'estado': 'cancelada',
+                        'creada': '2026-11-10T15:00:00+00:00'}
+    assert cliente.get('/yo', headers=auth(ana)).json()['creditos'] == 8
+    assert cliente.get('/reservas', headers=auth(ana)).json()[0]['estado'] == 'cancelada'
+
+
+def test_cancelar_dos_veces_da_409_sin_devolver_otro_credito(cliente):
+    ana = socio('Ana', creditos=7)
+    clase = db.crear_clase('Spinning', 'Leo', INICIO)
+    reserva = db.crear_reserva(ana['id'], clase['id'], AHORA)
+    cliente.post(f"/admin/reservas/{reserva['id']}/cancelar", headers=ADMIN)
+    r = cliente.post(f"/admin/reservas/{reserva['id']}/cancelar", headers=ADMIN)
+    assert r.status_code == 409
+    assert cliente.get('/yo', headers=auth(ana)).json()['creditos'] == 8
+
+
+def test_cancelar_con_clase_empezada_devuelve_credito_y_no_asigna(cliente):
+    ana = socio('Ana', creditos=7)
+    clase = db.crear_clase('Spinning', 'Leo', AHORA + timedelta(hours=1), cupo=1)
+    reserva = db.crear_reserva(ana['id'], clase['id'], AHORA)
+    bea = socio('Bea')
+    anotar(cliente, clase, bea)  # la clase todavía no empezó y está llena
+    reloj.fijar(AHORA + timedelta(hours=2))  # ya empezó
+
+    r = cliente.post(f"/admin/reservas/{reserva['id']}/cancelar", headers=ADMIN)
+
+    assert r.status_code == 200
+    assert cliente.get('/yo', headers=auth(ana)).json()['creditos'] == 8
+    assert reservas_confirmadas(bea, clase) == []
+    assert posicion(cliente, clase, bea) == 1
