diff --git a/tests/test_convenio.py b/tests/test_convenio.py
new file mode 100644
index 0000000..f288c3c
--- /dev/null
+++ b/tests/test_convenio.py
@@ -0,0 +1,126 @@
+import httpx
+import pytest
+
+from conftest import ADMIN, auth
+from pulso import beneficios, db
+
+
+@pytest.fixture
+def servicio(monkeypatch):
+    monkeypatch.setenv('PULSO_BENEFICIOS_URL', 'https://beneficios.test')
+    monkeypatch.setenv('PULSO_BENEFICIOS_CLAVE', 'clave-ben')
+    pedidos = []
+    respuestas = {}
+
+    def handler(request):
+        pedidos.append(request)
+        r = respuestas.get(request.url.raw_path.decode(), respuestas.get('*'))
+        if isinstance(r, Exception):
+            raise r
+        return r
+
+    monkeypatch.setattr(beneficios, 'transporte', httpx.MockTransport(handler))
+    return pedidos, respuestas
+
+
+def ok(activo=True):
+    return httpx.Response(200, json={'activo': activo})
+
+
+def err(codigo, nombre):
+    return httpx.Response(codigo, json={'error': nombre})
+
+
+def activar(cliente, socio, empresa='acme'):
+    return cliente.post('/convenio', json={'empresa': empresa}, headers=auth(socio))
+
+
+def test_activa_con_piso_y_correo(cliente, servicio):
+    pedidos, resp = servicio
+    s = db.crear_socio('Ana', 'Ana.Perez+Gym@Example.com', creditos=3)
+    resp['*'] = ok()
+    r = activar(cliente, s)
+    assert r.status_code == 200
+    assert r.json() == {'plan': 'corporativo', 'empresa': 'acme', 'creditos': 12}
+    assert pedidos[0].url.raw_path == b'/empresas/acme/empleados/ana.perez%2Bgym%40example.com'
+    assert pedidos[0].headers['x-api-key'] == 'clave-ben'
+    assert [c['asunto'] for c in db.correos()] == ['Ya tenés el plan corporativo']
+
+
+def test_creditos_altos_no_cambian(cliente, servicio):
+    servicio[1]['*'] = ok()
+    s = db.crear_socio('Ana', 'a@x.com', creditos=20)
+    assert activar(cliente, s).json()['creditos'] == 20
+
+
+def test_ya_corporativo_409(cliente, servicio):
+    servicio[1]['*'] = ok()
+    s = db.crear_socio('Ana', 'a@x.com', creditos=3)
+    activar(cliente, s)
+    assert activar(cliente, s, 'otra').status_code == 409
+    assert db.socio(s['id'])['creditos'] == 12
+    assert len(db.correos()) == 1
+
+
+@pytest.mark.parametrize('resp,codigo', [
+    (ok(False), 409), (err(404, 'empleado_desconocido'), 409), (err(404, 'empresa_desconocida'), 404),
+    (httpx.Response(500, text='boom'), 503), (err(401, 'clave_invalida'), 503),
+    (httpx.Response(200, json={'otro': 1}), 503), (httpx.TimeoutException('t'), 503),
+    (httpx.ConnectError('c'), 503),
+])
+def test_resultados_sin_cambios(cliente, servicio, resp, codigo):
+    servicio[1]['*'] = resp
+    s = db.crear_socio('Ana', 'a@x.com')
+    assert activar(cliente, s).status_code == codigo
+    assert db.socio(s['id'])['plan'] == 'basico'
+    assert db.socio(s['id'])['creditos'] == 8
+    assert db.correos() == []
+
+
+def test_validaciones(cliente, servicio, socio):
+    assert cliente.post('/convenio', json={'empresa': 'a'}).status_code == 401
+    assert cliente.post('/convenio', json={}, headers=auth(socio)).status_code == 422
+    assert cliente.post('/convenio', json={'empresa': ''}, headers=auth(socio)).status_code == 422
+
+
+def test_revalidar(cliente, servicio):
+    pedidos, resp = servicio
+    nombres = {}
+    for n in ('sigue', 'baja', 'falla', 'empresa'):
+        servicio[1][f'/empresas/{n}/empleados/{n}%40x.com'] = {
+            'sigue': ok(), 'baja': ok(False), 'falla': httpx.Response(502), 'empresa': err(404, 'empresa_desconocida'),
+        }[n]
+        nombres[n] = db.crear_socio(n, f'{n}@x.com', creditos=5)
+        resp['*'] = ok()
+    for n, s in nombres.items():
+        resp[f'/empresas/{n}/empleados/{n}%40x.com'] = servicio[1][f'/empresas/{n}/empleados/{n}%40x.com']
+        activar(cliente, s, n)
+    # activar usó respuestas por ruta; las de baja/falla/empresa no activan: forzamos el estado
+    for n, s in nombres.items():
+        db.activar_convenio(s['id'], n)
+    db.correos()
+    r = cliente.post('/admin/revalidar-convenios', headers=ADMIN)
+    assert r.json() == {'siguen': 1, 'bajaron': 2, 'sin_revisar': 1}
