index 0000000..5a6345d
--- /dev/null
+++ b/tests/test_espera.py
@@ -0,0 +1,148 @@
+from datetime import timedelta
+
+from conftest import ADMIN, AHORA, auth
+from pulso import db, reloj
+
+
+def llena(cupo=1, horas=6, pre='lleno'):
+    clase = db.crear_clase('Spinning', 'Leo', AHORA + timedelta(hours=horas), cupo=cupo)
+    reservas = []
+    for i in range(cupo):
+        s = db.crear_socio(f'L{pre}{i}', f'{pre}{i}@example.com')
+        reservas.append(db.crear_reserva(s['id'], clase['id'], AHORA))
+    return clase, reservas
+
+
+def esp(cliente, clase, socio):
+    return cliente.post(f"/clases/{clase['id']}/espera", headers=auth(socio))
+
+
+def test_espera_requiere_token_y_clase(cliente, socio):
+    assert cliente.post('/clases/1/espera').status_code == 401
+    assert cliente.get('/clases/1/espera').status_code == 401
+    assert cliente.delete('/clases/1/espera').status_code == 401
+    assert cliente.post('/clases/99/espera', headers=auth(socio)).status_code == 404
+    assert cliente.get('/clases/99/espera', headers=auth(socio)).status_code == 404
+
+
+def test_anotarse_posicion_y_bajarse(cliente, socio):
+    clase, _ = llena()
+    otro = db.crear_socio('Juan', 'juan@example.com')
+    assert esp(cliente, clase, socio).json() == {'clase_id': clase['id'], 'posicion': 1}
+    assert esp(cliente, clase, otro).json()['posicion'] == 2
+    assert esp(cliente, clase, otro).status_code == 409
+    assert cliente.delete(f"/clases/{clase['id']}/espera", headers=auth(socio)).status_code == 204
+    assert cliente.get(f"/clases/{clase['id']}/espera", headers=auth(otro)).json()['posicion'] == 1
+    assert cliente.get(f"/clases/{clase['id']}/espera", headers=auth(socio)).status_code == 404
+    assert cliente.delete(f"/clases/{clase['id']}/espera", headers=auth(socio)).status_code == 404
+    assert esp(cliente, clase, socio).json()['posicion'] == 2
+    assert cliente.get('/yo', headers=auth(socio)).json()['creditos'] == 8
+
+
+def test_rechazos_al_anotarse(cliente, socio):
+    libre = db.crear_clase('Yoga', 'Sofía', AHORA + timedelta(hours=3), cupo=5)
+    assert esp(cliente, libre, socio).status_code == 409
+    clase, _ = llena()
+    db.sumar_creditos(socio['id'], -8)
+    assert esp(cliente, clase, socio).status_code == 409
+    db.sumar_creditos(socio['id'], 8)
+    empezada, _ = llena(horas=-1, pre='viejo')
+    assert esp(cliente, empezada, socio).status_code == 409
+    reloj.fijar(AHORA + timedelta(hours=6))
+    assert esp(cliente, clase, socio).status_code == 409
+    reloj.fijar(AHORA)
+    propia = db.crear_clase('Yoga', 'Sofía', AHORA + timedelta(hours=3), cupo=1)
+    db.crear_reserva(socio['id'], propia['id'], AHORA)
+    assert esp(cliente, propia, socio).status_code == 409
+    assert cliente.get(f"/clases/{clase['id']}/espera", headers=auth(socio)).status_code == 404
+
+
+def test_cancelar_asigna_al_primero(cliente, socio):
+    clase, [res] = llena()
+    otro = db.crear_socio('Juan', 'juan@example.com')
+    esp(cliente, clase, socio)
+    esp(cliente, clase, otro)
+    r = cliente.post(f"/admin/reservas/{res['id']}/cancelar", headers=ADMIN)
+    assert r.status_code == 200 and r.json()['estado'] == 'cancelada'
+    assert cliente.get('/yo', headers=auth(socio)).json()['creditos'] == 7
+    [mia] = cliente.get('/reservas', headers=auth(socio)).json()
+    assert mia['estado'] == 'confirmada'
+    assert cliente.get(f"/clases/{clase['id']}/espera", headers=auth(socio)).status_code == 404
+    assert cliente.get(f"/clases/{clase['id']}/espera", headers=auth(otro)).json()['posicion'] == 1
+    [c] = db.correos()
+    assert c['asunto'] == 'Se liberó un lugar: Spinning el 10/11 a las 18:00'
+    assert cliente.get(f"/clases/{clase['id']}").json()['lugares_libres'] == 0
+    # el socio original recupera su crédito, y no se repite
+    assert db.socio(db.reserva(res['id'])['socio_id'])['creditos'] == 9
+    assert cliente.post(f"/admin/reservas/{res['id']}/cancelar", headers=ADMIN).status_code == 409
+    assert db.socio(db.reserva(res['id'])['socio_id'])['creditos'] == 9
+    assert cliente.get(f"/clases/{clase['id']}").json()['lugares_libres'] == 0
+
+
+def test_cancelar_admin_errores(cliente):
+    assert cliente.post('/admin/reservas/1/cancelar').status_code == 401
+    assert cliente.post('/admin/reservas/1/cancelar', headers=ADMIN).status_code == 404
+
+
+def test_sin_creditos_se_saltea(cliente, socio):
+    clase, [res] = llena()
+    sin = db.crear_socio('Sin', 'sin@example.com', creditos=1)
+    esp(cliente, clase, sin)
+    esp(cliente, clase, socio)
+    db.sumar_creditos(sin['id'], -1)
+    cliente.post(f"/admin/reservas/{res['id']}/cancelar", headers=ADMIN)
+    asuntos = [c['asunto'] for c in db.correos()]
+    assert asuntos == ['No pudimos darte el lugar: Spinning el 10/11 a las 18:00',
+                       'Se liberó un lugar: Spinning el 10/11 a las 18:00']
+    assert db.reservas_de(sin['id']) == []
+    assert len(db.reservas_de(socio['id'])) == 1
+
+
+def test_con_reserva_confirmada_se_saltea_sin_correo(cliente, socio):
+    clase, [res] = llena()
+    esp(cliente, clase, socio)
+    db.crear_reserva(socio['id'], clase['id'], AHORA)  # reserva aparecida tras anotarse
+    db.crear_reserva(db.crear_socio('X', 'x@example.com')['id'], clase['id'], AHORA, 'cancelada')
+    cliente.patch(f"/admin/clases/{clase['id']}", json={'cupo': 3}, headers=ADMIN)
+    assert db.correos() == []
+    assert len(db.reservas_de(socio['id'])) == 1
+    assert cliente.get(f"/clases/{clase['id']}/espera", headers=auth(socio)).status_code == 404
+
+
+def test_ampliar_cupo_libera_k(cliente, socio):
+    clase, _ = llena()
+    otros = [db.crear_socio(f'S{i}', f's{i}@example.com') for i in range(3)]
+    for s in [socio] + otros:
+        esp(cliente, clase, s)
+    r = cliente.patch(f"/admin/clases/{clase['id']}", json={'cupo': 3}, headers=ADMIN)
+    assert r.status_code == 200
+    assert r.json()['cupo'] == 3 and r.json()['lugares_libres'] == 0
+    assert db.confirmadas(clase['id']) == 3
+    assert cliente.get(f"/clases/{clase['id']}/espera", headers=auth(otros[1])).json()['posicion'] == 1
+    assert len(db.correos()) == 2
+
+
+def test_cupo_validaciones(cliente):
+    clase, _ = llena(cupo=2)
+    url = f"/admin/clases/{clase['id']}"
+    assert cliente.patch(url, json={'cupo': 5}).status_code == 401
+    for malo in ({}, {'cupo': 0}, {'cupo': -1}, {'cupo': 2.5}, {'cupo': '3'}, {'cupo': True}, {'cupo': None}):
+        assert cliente.patch(url, json=malo, headers=ADMIN).status_code == 422
+    assert cliente.patch(url, json={'cupo': 1}, headers=ADMIN).status_code == 409
+    assert db.clase(clase['id'])['cupo'] == 2
+    assert cliente.patch(url, json={'cupo': 2}, headers=ADMIN).status_code == 200
+    assert cliente.patch('/admin/clases/99', json={'cupo': 2}, headers=ADMIN).status_code == 404
+
+
+def test_clase_empezada_no_asigna(cliente, socio):
+    clase, [res] = llena()
+    esp(cliente, clase, socio)
+    reloj.fijar(AHORA + timedelta(hours=6))
+    r = cliente.post(f"/admin/reservas/{res['id']}/cancelar", headers=ADMIN)
+    assert r.status_code == 200
+    assert db.socio(res['socio_id'])['creditos'] == 9
+    assert cliente.get(f"/clases/{clase['id']}").json()['lugares_libres'] == 1
+    assert cliente.patch(f"/admin/clases/{clase['id']}", json={'cupo': 4}, headers=ADMIN).status_code == 200
+    assert db.confirmadas(clase['id']) == 0
+    assert db.correos() == []
+    assert cliente.get(f"/clases/{clase['id']}/espera", headers=auth(socio)).json()['posicion'] == 1
