diff --git a/tests/test_convenio.py b/tests/test_convenio.py
new file mode 100644
index 0000000..6f0c04c
--- /dev/null
+++ b/tests/test_convenio.py
@@ -0,0 +1,122 @@
+import httpx
+import pytest
+
+from conftest import ADMIN, auth
+from pulso import db
+
+
+@pytest.fixture
+def servicio(monkeypatch):
+    """Reemplaza el servicio de beneficios: `respuestas` mapea email -> (status, json) o excepción."""
+    monkeypatch.setenv('PULSO_BENEFICIOS_URL', 'https://beneficios.test')
+    monkeypatch.setenv('PULSO_BENEFICIOS_CLAVE', 'clave-benef')
+    estado = {'pedidos': [], 'respuestas': {}, 'defecto': (200, {'activo': True})}
+
+    def get(url, headers=None, timeout=None):
+        estado['pedidos'].append((url, headers, timeout))
+        r = estado['respuestas'].get(url.rsplit('/', 1)[1], estado['defecto'])
+        if isinstance(r, Exception):
+            raise r
+        status, cuerpo = r
+        if cuerpo is None:
+            return httpx.Response(status, text='boom')
+        return httpx.Response(status, json=cuerpo)
+
+    monkeypatch.setattr(httpx, 'get', get)
+    return estado
+
+
+def activar(cliente, socio, empresa='acme'):
+    return cliente.post('/convenio', json={'empresa': empresa}, headers=auth(socio))
+
+
+def test_activa_y_sube_al_piso(cliente, socio, servicio):
+    r = activar(cliente, socio)
+    assert r.status_code == 200
+    assert r.json() == {'plan': 'corporativo', 'empresa': 'acme', 'creditos': 12}
+    assert [c['asunto'] for c in db.correos()] == ['Ya tenés el plan corporativo']
+    url, headers, timeout = servicio['pedidos'][0]
+    assert url == 'https://beneficios.test/empresas/acme/empleados/ana%40example.com'
+    assert headers['X-Api-Key'] == 'clave-benef'
+    assert timeout == 3.0
+
+
+def test_email_en_minusculas_y_codificado(cliente, servicio):
+    s = db.crear_socio('Ana', 'Ana.Perez+Gym@Example.com')
+    assert activar(cliente, s).status_code == 200
+    assert servicio['pedidos'][0][0].endswith('/empleados/ana.perez%2Bgym%40example.com')
+
+
+def test_creditos_altos_no_cambian(cliente, servicio):
+    s = db.crear_socio('Ana', 'a@example.com', creditos=20)
+    assert activar(cliente, s).json()['creditos'] == 20
+
+
+def test_ya_corporativo_409_sin_cambios(cliente, socio, servicio):
+    activar(cliente, socio)
+    assert activar(cliente, socio, 'otra').status_code == 409
+    assert db.socio(socio['id'])['creditos'] == 12
+    assert len(db.correos()) == 1
+
+
+@pytest.mark.parametrize('respuesta', [(200, {'activo': False}), (404, {'error': 'empleado_desconocido'})])
+def test_no_activo_409(cliente, socio, servicio, respuesta):
+    servicio['defecto'] = respuesta
+    assert activar(cliente, socio).status_code == 409
+    assert db.socio(socio['id'])['plan'] == 'basico'
+    assert db.correos() == []
+
+
+def test_empresa_desconocida_404(cliente, socio, servicio):
+    servicio['defecto'] = (404, {'error': 'empresa_desconocida'})
+    assert activar(cliente, socio).status_code == 404
+
+
+@pytest.mark.parametrize('respuesta', [
+    (500, None), (503, {'x': 1}), (401, {'error': 'clave_invalida'}), (200, {}), (200, None),
+    httpx.ConnectError('x'), httpx.ReadTimeout('x')])
+def test_falla_503(cliente, socio, servicio, respuesta):
+    servicio['defecto'] = respuesta
+    assert activar(cliente, socio).status_code == 503
+    assert db.socio(socio['id'])['plan'] == 'basico'
+    assert db.socio(socio['id'])['creditos'] == 8
+
+
+def test_validaciones(cliente, socio, servicio):
+    assert cliente.post('/convenio', json={'empresa': 'acme'}).status_code == 401
+    assert cliente.post('/convenio', json={}, headers=auth(socio)).status_code == 422
