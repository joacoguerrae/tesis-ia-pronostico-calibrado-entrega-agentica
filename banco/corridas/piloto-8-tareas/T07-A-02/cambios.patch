+PACKS = {'pack-4': {'creditos': 4, 'monto': 1200}, 'pack-8': {'creditos': 8, 'monto': 2200}}
+ESPERA_PAGO = timedelta(minutes=30)
+
+
+def ver_compra(compra):
+    return {k: compra[k] for k in ('id', 'pack', 'creditos', 'monto', 'estado', 'creada', 'url_pago')}
+
+
+class NuevaCompra(BaseModel):
+    pack: str
+
+
+def aplicar_pago(compra, pago):
+    """Guarda el pago en la compra si no lo tiene y aplica su estado. Devuelve la compra actualizada."""
+    if compra['pago_id'] is None:
+        db.guardar_pago(compra['id'], pago['id'], pago.get('url_pago'))
+    nuevo = {'aprobado': 'aprobada', 'rechazado': 'rechazada'}.get(pago['estado'])
+    if nuevo and db.resolver_compra(compra['id'], nuevo) and nuevo == 'aprobada':
+        socio = db.socio(compra['socio_id'])
+        correo.enviar(socio['email'], 'Compra de créditos aprobada',
+                      f"Hola {socio['nombre']}, tu compra de {compra['creditos']} créditos fue aprobada.")
+    return db.compra(compra['id'])
+
+
+@router.post('/compras', status_code=201)
+def comprar(datos: dict = Body(...), socio=Depends(socio_actual)):
+    pack = datos.get('pack') if isinstance(datos, dict) else None
+    if not isinstance(pack, str) or pack not in PACKS:
+        raise HTTPException(422, 'Pack inválido')
+    info = PACKS[pack]
+    compra = db.crear_compra(socio['id'], pack, info['creditos'], info['monto'], reloj.ahora())
+    try:
+        pago = cobra.crear_pago(info['monto'], f"pulso-compra-{compra['id']}")
+    except cobra.CobraError:
+        raise HTTPException(502, 'No se pudo crear el pago')
+    db.guardar_pago(compra['id'], pago['id'], pago.get('url_pago'))
+    return ver_compra(db.compra(compra['id']))
+
+
+@router.get('/compras')
+def mis_compras(socio=Depends(socio_actual)):
+    return [ver_compra(c) for c in db.compras_de(socio['id'])]
+
+
+class AvisoPago(BaseModel):
+    pago_id: str = Field(min_length=1)
+
+
+@router.post('/webhooks/pagos')
+def webhook_pagos(datos: AvisoPago):
+    try:
+        pago = cobra.obtener_pago(datos.pago_id)
+    except cobra.CobraError:
+        raise HTTPException(503, 'Cobrá no responde')
+    if pago is None:
+        raise HTTPException(404, 'Cobrá no conoce el pago')
+    m = re.fullmatch(r'pulso-compra-(\d+)', str(pago.get('referencia')))
+    compra = db.compra(int(m.group(1))) if m else None
+    if compra is None:
+        raise HTTPException(404, 'El pago no es de ninguna compra')
+    compra = aplicar_pago(compra, pago)
+    return {'compra_id': compra['id'], 'estado': compra['estado']}
+
+
+@router.post('/admin/conciliar-pagos', dependencies=[Depends(admin)])
+def conciliar_pagos():
+    resultado = {'aprobadas': 0, 'rechazadas': 0, 'pendientes': 0}
+    for compra in db.compras_pendientes():
+        estado = compra['estado']
+        try:
+            if compra['pago_id']:
+                pago = cobra.obtener_pago(compra['pago_id'])
+            else:
+                pago = cobra.buscar_pago(f"pulso-compra-{compra['id']}")
+                if pago is None and db.a_fecha(compra['creada']) <= reloj.ahora() - ESPERA_PAGO:
+                    db.resolver_compra(compra['id'], 'rechazada')
+                    estado = db.compra(compra['id'])['estado']
+            if pago is not None:
+                estado = aplicar_pago(compra, pago)['estado']
+        except cobra.CobraError:
+            pass
+        clave = {'aprobada': 'aprobadas', 'rechazada': 'rechazadas'}.get(estado, 'pendientes')
+        resultado[clave] += 1
+    return resultado
+
