{"host.arch": "arm64", "os.type": "darwin", "os.version": "23.4.0", "service.name": "claude-code", "service.version": "2.1.312", "user.id": "", "session.id": "b425bfa0-80ba-44a5-ae76-8ec3dc332670", "terminal.type": "claude-desktop", "gen_ai.provider.name": "anthropic", "span.type": "tool", "tool_name": "Bash", "tool_name_safe": "Bash", "gen_ai.operation.name": "execute_tool", "gen_ai.tool.name": "Bash", "gen_ai.conversation.id": "b425bfa0-80ba-44a5-ae76-8ec3dc332670", "full_command": "python - <<'E'\nimport re\np='pulso/db.py'\ns=open(p).read()\ns=s.replace(\"\"\"        con.executescript(ESQUEMA)\n\"\"\",\"\"\"        con.executescript(ESQUEMA)\n        columnas = [f['name'] for f in con.execute('PRAGMA table_info(socios)')]\n        if 'empresa_convenio' not in columnas:\n            con.execute('ALTER TABLE socios ADD COLUMN empresa_convenio TEXT')\n\"\"\")\ns+='''\n\ndef activar_corporativo(socio_id, empresa, piso=12):\n    \"\"\"Pasa al plan corporativo si todavía no lo tiene. Devuelve True si cambió algo.\"\"\"\n    with conexion() as con:\n        cur = con.execute(\"UPDATE socios SET plan = 'corporativo', empresa_convenio = ?, \"\n                          \"creditos = MAX(creditos, ?) WHERE id = ? AND plan != 'corporativo'\",\n                          (empresa, piso, socio_id))\n    return cur.rowcount > 0\n\n\ndef bajar_a_basico(socio_id):\n    \"\"\"Vuelve al plan básico conservando créditos. Devuelve True si cambió algo.\"\"\"\n    with conexion() as con:\n        cur = con.execute(\"UPDATE socios SET plan = 'basico', empresa_convenio = NULL \"\n                          \"WHERE id = ? AND plan = 'corporativo'\", (socio_id,))\n    return cur.rowcount > 0\n\n\ndef socios_corporativos():\n    return _varias(\"SELECT * FROM socios WHERE plan = 'corporativo' ORDER BY id\")\n'''\nopen(p,'w').write(s)\nE\ncat > pulso/beneficios.py <<'E'\n\"\"\"Cliente del servicio de beneficios (fuente de verdad de los empleados con convenio).\"\"\"\nimport os\nfrom urllib.parse import quote\n\nimport httpx\n\nACTIVO = 'activo'\nINACTIVO = 'inactivo'\nEMPLEADO_DESCONOCIDO = 'empleado_desconocido'\nEMPRESA_DESCONOCIDA = 'empresa_desconocida'\n\n\nclass ServicioFallo(Exception):\n    pass\n\n\ndef consultar(empresa, email):\n    \"\"\"Devuelve ACTIVO, INACTIVO, EMPLEADO_DESCONOCIDO o EMPRESA_DESCONOCIDA; ServicioFallo si falla.\"\"\"\n    base = os.environ.get('PULSO_BENEFICIOS_URL', '').rstrip('/')\n    if not base:\n        raise ServicioFallo('Falta PULSO_BENEFICIOS_URL')\n    url = f\"{base}/empresas/{quote(empresa, safe='')}/empleados/{quote(email.lower(), safe='')}\"\n    headers = {'X-Api-Key': os.environ.get('PULSO_BENEFICIOS_CLAVE', '')}\n    try:\n        r = httpx.get(url, headers=headers, timeout=3.0)\n    except (httpx.HTTPError, ValueError) as e:\n        raise ServicioFallo(str(e))\n    try:\n        cuerpo = r.json()\n    except ValueError:\n        cuerpo = None\n    if not isinstance(cuerpo, dict):\n        raise ServicioFallo(f'Respuesta inesperada ({r.status_code})')\n    if r.status_code == 200 and isinstance(cuerpo.get('activo'), bool):\n        return ACTIVO if cuerpo['activo'] else INACTIVO\n    if r.status_code == 404 and cuerpo.get('error') == 'empleado_desconocido':\n        return EMPLEADO_DESCONOCIDO\n    if r.status_code == 404 and cuerpo.get('error') == 'empresa_desconocida':\n        return EMPRESA_DESCONOCIDA\n    raise ServicioFallo(f'Respuesta inesperada ({r.status_code})')\nE\npython - <<'E'\np='pulso/main.py'\ns=open(p).read()\ns=s.replace(\"from pulso import correo,\",\"from pulso import beneficios, correo,\")\ns=s.replace('''def crear_app():''','''class NuevoConvenio(BaseModel):\n    empresa: str = Field(min_length=1)\n\n\n@router.post('/convenio')\ndef activar_convenio(datos: NuevoConvenio, socio=Depends(socio_actual)):\n    empresa = datos.empresa.strip()\n    if not empresa:\n        raise HTTPException(422, 'Falta la empresa')\n    if socio['plan'] == 'corporativo':\n        raise HTTPException(409, 'Ya tenés el plan corporativo')\n    try:\n        estado = beneficios.consultar(empresa, socio['email'])\n    except beneficios.ServicioFallo:\n        raise HTTPException(503, 'El servicio de beneficios no está disponible')\n    if estado == beneficios.EMPRESA_DESCONOCIDA:\n        raise HTTPException(404, 'No existe la empresa')\n    if estado != beneficios.ACTIVO:\n        raise HTTPException(409, 'No sos empleado activo de la empresa')\n    if not db.activar_corporativo(socio['id'], empresa):\n        raise HTTPException(409, 'Ya tenés el plan corporativo')\n    correo.enviar(socio['email'], 'Ya tenés el plan corporativo',\n                  f\"Hola {socio['nombre']}, tu plan corporativo con {empresa} ya está activo.\")\n    actual = db.socio(socio['id'])\n    return {'plan': actual['plan'], 'empresa': empresa, 'creditos': actual['creditos']}\n\n\n@router.post('/admin/revalidar-convenios', dependencies=[Depends(admin)])\ndef revalidar_convenios():\n    siguen = bajaron = sin_revisar = 0\n    for s in db.socios_corporativos():\n        if not s.get('empresa_convenio'):\n            sin_revisar += 1\n            continue\n        try:\n            estado = beneficios.consultar(s['empresa_convenio'], s['email'])\n        except beneficios.ServicioFallo:\n            sin_revisar += 1\n            continue\n        if estado == beneficios.ACTIVO:\n            siguen += 1\n            continue\n        if db.bajar_a_basico(s['id']):\n            correo.enviar(s['email'], 'Se terminó tu plan corporativo',\n                          f\"Hola {s['nombre']}, tu plan corporativo terminó y volviste al plan básico. \"\n                          'Conservás tus créditos.')\n        bajaron += 1\n    return {'siguen': siguen, 'bajaron': bajaron, 'sin_revisar': sin_revisar}\n\n\ndef crear_app():''')\nopen(p,'w').write(s)\np='README.md'\ns=open(p).read()\ns+=\"\"\"| POST | `/convenio` | Activa el plan corporativo si el servicio de beneficios confirma que el socio es empleado activo de `empresa`. |\n| POST | `/admin/revalidar-convenios` | Revalida a los corporativos contra el servicio de beneficios (admin). |\n\nEl servicio de beneficios se configura con `PULSO_BENEFICIOS_URL` y `PULSO_BENEFICIOS_CLAVE` (header `X-Api-Key`), distinta de `PULSO_ADMIN_KEY`. Cliente en `pulso/beneficios.py`.\n\"\"\"\nopen(p,'w').write(s)\nE\ncat > tests/test_convenio.py <<'E'\nimport httpx\nimport pytest\n\nfrom conftest import ADMIN, auth\nfrom pulso import beneficios, db\n\nURL = 'https://beneficios.example.com'\n\n\n@pytest.fixture(autouse=True)\ndef entorno(monkeypatch):\n    monkeypatch.setenv('PULSO_BENEFICIOS_URL', URL)\n    monkeypatch.setenv('PULSO_BENEFICIOS_CLAVE', 'k')\n\n\ndef servicio(monkeypatch, respuestas):\n    \"\"\"respuestas: función (url) -> httpx.Response o excepción.\"\"\"\n    llamadas = []\n\n    def get(url, headers=None, timeout=None):\n        llamadas.append((url, headers, timeout))\n        r = respuestas(url)\n        if isinstance(r, Exception):\n            raise r\n        return r\n    monkeypatch.setattr(httpx, 'get', get)\n    return llamadas\n\n\ndef resp(status, cuerpo=None):\n    return httpx.Response(status, json=cuerpo) if cuerpo is not None else httpx.Response(status, text='boom')\n\n\ndef test_activa_y_url(cliente, monkeypatch):\n    s = db.crear_socio('Ana', 'Ana.Perez+Gym@Example.com', creditos=3)\n    ll = servicio(monkeypatch, lambda u: resp(200, {'activo': True}))\n    r = cliente.post('/convenio', json={'empresa': 'acme'}, headers=auth(s))\n    assert r.json() == {'plan': 'corporativo', 'empresa': 'acme', 'creditos': 12}\n    assert ll[0][0] == f'{URL}/empresas/acme/empleados/ana.perez%2Bgym%40example.com'\n    assert ll[0][1]['X-Api-Key'] == 'k' and ll[0][2] == 3\n    assert [c['asunto'] for c in db.correos()] == ['Ya tenés el plan corporativo']\n\n\ndef test_piso_no_suma(cliente, monkeypatch):\n    s = db.crear_socio('Ana', 'a@x.com', creditos=20)\n    servicio(monkeypatch, lambda u: resp(200, {'activo': True}))\n    assert cliente.post('/convenio', json={'empresa': 'acme'}, headers=auth(s)).json()['creditos'] == 20\n\n\ndef test_ya_corporativo_409(cliente, monkeypatch):\n    s = db.crear_socio('Ana', 'a@x.com')\n    ll = servicio(monkeypatch, lambda u: resp(200, {'activo': True}))\n    cliente.post('/convenio', json={'empresa': 'acme'}, headers=auth(s))\n    r = cliente.post('/convenio', json={'empresa': 'otra'}, headers=auth(s))\n    assert r.status_code == 409 and len(db.correos()) == 1 and len(ll) == 1\n\n\ndef test_validaciones(cliente, socio):\n    assert cliente.post('/convenio', json={'empresa': 'a'}).status_code == 401\n    assert cliente.post('/convenio', json={}, headers=auth(socio)).status_code == 422\n    assert cliente.post('/convenio', json={'empresa': ''}, headers=auth(socio)).status_code == 422\n\n\n@pytest.mark.parametrize('respuesta,codigo', [\n    (resp(200, {'activo': False}), 409),\n    (resp(404, {'error': 'empleado_desconocido'}), 409),\n    (resp(404, {'error': 'empresa_desconocida'}), 404),\n    (resp(401, {'error': 'clave_invalida'}), 503),\n    (resp(500), 503),\n    (resp(200, {'otro': 1}), 503),\n    (httpx.ConnectError('x'), 503),\n    (httpx.ReadTimeout('x'), 503),\n])\ndef test_resultados_servicio(cliente, socio, monkeypatch, respuesta, codigo):\n    servicio(monkeypatch, lambda u: respuesta)\n    r = cliente.post('/convenio', json={'empresa': 'acme'}, headers=auth(socio))\n    assert r.status_code == codigo\n    assert db.socio(socio['id'])['plan'] == 'basico' and db.correos() == []\n\n\ndef test_revalidar(cliente, monkeypatch):\n    ids = {}\n    for n in ('sigue', 'baja', 'falla', 'inactivo'):\n        ids[n] = db.crear_socio(n, f'{n}@x.com', plan='corporativo', creditos=5)\n        with db.conexion() as con:\n            con.execute(\"UPDATE socios SET empresa_convenio='acme' WHERE id=?\", (ids[n]['id'],))\n    respuestas = {'sigue': resp(200, {'activo': True}), 'baja': resp(404, {'error': 'empresa_desconocida'}),\n                  'falla': resp(500), 'inactivo': resp(200, {'activo': False})}\n    servicio(monkeypatch, lambda u: respuestas[u.rsplit('/', 1)[1].split('%40')[0]])\n    assert cliente.post('/admin/revalidar-convenios').status_code == 401\n    r = cliente.post('/admin/revalidar-convenios', headers=ADMIN)\n    assert r.status_code == 200\n    assert r.json() == {'siguen': 1, 'bajaron': 2, 'sin_revisar': 1}\n    assert db.socio(ids['baja']['id'])['plan'] == 'basico' and db.socio(ids['baja']['id'])['creditos'] == 5\n    assert db.socio(ids['sigue']['id'])['plan'] == 'corporativo'\n    assert db.socio(ids['falla']['id'])['plan'] == 'corporativo'\n    assert sorted(c['asunto'] for c in db.correos()) == ['Se terminó tu plan corporativo'] * 2\n\n\ndef test_reactivar_tras_baja(cliente, monkeypatch):\n    s = db.crear_socio('Ana', 'a@x.com', creditos=2)\n    servicio(monkeypatch, lambda u: resp(200, {'activo': True}))\n    cliente.post('/convenio', json={'empresa': 'acme'}, headers=auth(s))\n    servicio(monkeypatch, lambda u: resp(200, {'activo': False}))\n    cliente.post('/admin/revalidar-convenios', headers=ADMIN)\n    servicio(monkeypatch, lambda u: resp(200, {'activo': True}))\n    assert cliente.post('/convenio', json={'empresa': 'acme'}, headers=auth(s)).status_code == 200\nE\npython -m pytest -q 2>&1 | tail -15", "bash_command_class": "unparsed", "bash_argv0": "other", "tool_use_id": "toolu_01UxGeGzWrmeVA9JZbpEqr34", "gen_ai.tool.call.id": "toolu_01UxGeGzWrmeVA9JZbpEqr34", "duration_ms": 7, "_nombre": "claude_code.tool", "_traza": "d236ace8edfa08427c799a1dee480c76", "_tramo": "b8904efbe4002d51", "_padre": "6640b73b8a9a92a9", "_inicio_ns": 1794572744246000000, "_fin_ns": 1794572744252990375, "_estado": 0}
