{"host.arch": "arm64", "os.type": "darwin", "os.version": "23.4.0", "service.name": "claude-code", "service.version": "2.1.258", "user.id": "", "session.id": "64770e4b-f78d-4ce4-840e-7e45d5bbf8f7", "terminal.type": "claude-desktop", "span.type": "tool", "tool_name": "Bash", "full_command": "python - <<'EOF'\np='pulso/db.py'\ns=open(p).read()\ns=s.replace('''def correos():''','''def cancelar_reserva(reserva_id, devolver_credito):\n    \"\"\"Pasa la reserva a 'cancelada' y, si corresponde, devuelve el crédito, todo en una transacción.\n    Devuelve False si la reserva ya no estaba confirmada (no cambia nada).\"\"\"\n    with conexion() as con:\n        cur = con.execute(\"UPDATE reservas SET estado = 'cancelada' WHERE id = ? AND estado = 'confirmada'\",\n                          (reserva_id,))\n        if cur.rowcount == 0:\n            return False\n        if devolver_credito:\n            con.execute('UPDATE socios SET creditos = creditos + 1 '\n                        'WHERE id = (SELECT socio_id FROM reservas WHERE id = ?)', (reserva_id,))\n    return True\n\n\ndef correos():''')\nopen(p,'w').write(s)\np='pulso/main.py'\ns=open(p).read()\ns=s.replace('''@router.get('/reservas')''','''ANTICIPO_MINIMO = timedelta(hours=2)\n\n\n@router.post('/reservas/{reserva_id}/cancelar')\ndef cancelar(reserva_id: int, socio=Depends(socio_actual)):\n    reserva = db.reserva(reserva_id)\n    if reserva is None or reserva['socio_id'] != socio['id']:\n        raise HTTPException(404, 'No existe la reserva')\n    if reserva['estado'] == 'cancelada':\n        raise HTTPException(409, 'La reserva ya está cancelada')\n    inicio = db.a_fecha(db.clase(reserva['clase_id'])['inicio'])\n    ahora = reloj.ahora()\n    if ahora >= inicio:\n        raise HTTPException(409, 'La clase ya empezó')\n    devolver = inicio - ahora >= ANTICIPO_MINIMO\n    if not db.cancelar_reserva(reserva['id'], devolver):\n        raise HTTPException(409, 'La reserva ya está cancelada')\n    return dict(ver_reserva(db.reserva(reserva['id'])), credito_devuelto=devolver)\n\n\n@router.get('/reservas')''',1)\ns=s.replace(\"import os\\n\",\"import os\\nfrom datetime import timedelta\\n\",1)\nopen(p,'w').write(s)\n\np='README.md'\ns=open(p).read()\ns=s.replace(\"| GET | `/reservas` |\",\"| POST | `/reservas/{id}/cancelar` | Cancela una reserva propia. Con 2 h o más de anticipación devuelve el crédito; la reserva queda `cancelada`. |\\n| GET | `/reservas` |\")\nopen(p,'w').write(s)\nEOF\ncat > tests/test_cancelar.py <<'EOF'\nfrom datetime import timedelta\n\nfrom conftest import AHORA, auth\nfrom pulso import db\n\n\ndef reservar(cliente, socio, clase):\n    r = cliente.post('/reservas', json={'clase_id': clase['id']}, headers=auth(socio))\n    assert r.status_code == 201\n    return r.json()['id']\n\n\ndef creditos(cliente, socio):\n    return cliente.get('/yo', headers=auth(socio)).json()['creditos']\n\n\ndef test_cancela_con_anticipo_y_devuelve_credito(cliente, socio):\n    clase = db.crear_clase('Yoga', 'Sofía', AHORA + timedelta(hours=5))\n    rid = reservar(cliente, socio, clase)\n    r = cliente.post(f'/reservas/{rid}/cancelar', headers=auth(socio))\n    assert r.status_code == 200\n    assert r.json() == {'id': rid, 'clase_id': clase['id'], 'estado': 'cancelada',\n                        'creada': '2026-11-10T15:00:00+00:00', 'credito_devuelto': True}\n    assert creditos(cliente, socio) == 8\n\n\ndef test_exactamente_dos_horas_devuelve_credito(cliente, socio):\n    clase = db.crear_clase('Yoga', 'Sofía', AHORA + timedelta(hours=2))\n    rid = reservar(cliente, socio, clase)\n    assert cliente.post(f'/reservas/{rid}/cancelar', headers=auth(socio)).json()['credito_devuelto'] is True\n    assert creditos(cliente, socio) == 8\n\n\ndef test_con_menos_de_dos_horas_cancela_sin_devolver(cliente, socio):\n    clase = db.crear_clase('Yoga', 'Sofía', AHORA + timedelta(hours=1, minutes=59))\n    rid = reservar(cliente, socio, clase)\n    r = cliente.post(f'/reservas/{rid}/cancelar', headers=auth(socio))\n    assert r.status_code == 200\n    assert r.json()['estado'] == 'cancelada'\n    assert r.json()['credito_devuelto'] is False\n    assert creditos(cliente, socio) == 7\n\n\ndef test_no_cancela_dos_veces(cliente, socio):\n    clase = db.crear_clase('Yoga', 'Sofía', AHORA + timedelta(hours=5))\n    rid = reservar(cliente, socio, clase)\n    cliente.post(f'/reservas/{rid}/cancelar', headers=auth(socio))\n    assert cliente.post(f'/reservas/{rid}/cancelar', headers=auth(socio)).status_code == 409\n    assert creditos(cliente, socio) == 8\n\n\ndef test_no_cancela_clase_empezada(cliente, socio):\n    clase = db.crear_clase('Yoga', 'Sofía', AHORA + timedelta(hours=1))\n    rid = reservar(cliente, socio, clase)\n    from pulso import reloj\n    reloj.fijar(AHORA + timedelta(hours=1))\n    assert cliente.post(f'/reservas/{rid}/cancelar', headers=auth(socio)).status_code == 409\n    reloj.fijar(AHORA + timedelta(hours=2))\n    assert cliente.post(f'/reservas/{rid}/cancelar', headers=auth(socio)).status_code == 409\n    assert creditos(cliente, socio) == 7\n\n\ndef test_reserva_ajena_o_inexistente_da_404(cliente, socio):\n    otro = db.crear_socio('Juan Gómez', 'juan@example.com')\n    clase = db.crear_clase('Yoga', 'Sofía', AHORA + timedelta(hours=5))\n    rid = reservar(cliente, socio, clase)\n    assert cliente.post(f'/reservas/{rid}/cancelar', headers=auth(otro)).status_code == 404\n    assert cliente.post('/reservas/999/cancelar', headers=auth(socio)).status_code == 404\n    assert cliente.get('/reservas', headers=auth(socio)).json()[0]['estado'] == 'confirmada'\n    assert creditos(cliente, otro) == 8\n\n\ndef test_sin_token(cliente):\n    assert cliente.post('/reservas/1/cancelar').status_code == 401\n\n\ndef test_queda_en_listado_y_libera_el_lugar(cliente, socio):\n    otro = db.crear_socio('Juan Gómez', 'juan@example.com')\n    clase = db.crear_clase('Yoga', 'Sofía', AHORA + timedelta(hours=5), cupo=1)\n    rid = reservar(cliente, socio, clase)\n    assert cliente.get(f\"/clases/{clase['id']}\").json()['lugares_libres'] == 0\n    cliente.post(f'/reservas/{rid}/cancelar', headers=auth(socio))\n    assert cliente.get(f\"/clases/{clase['id']}\").json()['lugares_libres'] == 1\n    [en_lista] = cliente.get('/reservas', headers=auth(socio)).json()\n    assert en_lista['id'] == rid and en_lista['estado'] == 'cancelada'\n    reservar(cliente, otro, clase)\n\n\ndef test_mismo_socio_puede_volver_a_reservar(cliente, socio):\n    clase = db.crear_clase('Yoga', 'Sofía', AHORA + timedelta(hours=5))\n    rid = reservar(cliente, socio, clase)\n    cliente.post(f'/reservas/{rid}/cancelar', headers=auth(socio))\n    nueva = reservar(cliente, socio, clase)\n    assert nueva != rid\n    assert len(cliente.get('/reservas', headers=auth(socio)).json()) == 2\nEOF\npython -m pytest -q 2>&1 | tail -5", "tool_use_id": "toolu_01RQ2hkQ3AvRA2g5S72RiuS2", "gen_ai.tool.call.id": "toolu_01RQ2hkQ3AvRA2g5S72RiuS2", "duration_ms": 7, "_nombre": "claude_code.tool", "_traza": "8a9c86471bdcf78541cd5d641f39b13b", "_tramo": "f902a8290fb0173c", "_padre": "2498e0f6c797fb6f", "_inicio_ns": 1794521084548000000, "_fin_ns": 1794521084555438041, "_estado": 0}
