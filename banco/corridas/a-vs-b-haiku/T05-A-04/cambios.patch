@@ -1,4 +1,5 @@
 import os
+from datetime import timedelta
 
 from fastapi import APIRouter, Depends, FastAPI, Header, HTTPException
 from pydantic import AwareDatetime, BaseModel, Field
@@ -92,6 +93,27 @@ def yo(socio=Depends(socio_actual)):
     return {k: socio[k] for k in ('id', 'nombre', 'email', 'plan', 'creditos')}
 
 
+@router.post('/admin/recordatorios', dependencies=[Depends(admin)])
+def mandar_recordatorios():
+    ahora = reloj.ahora()
+    enviados = 0
+    for r in db.reservas_a_recordar(ahora, ahora + timedelta(hours=24)):
+        if not db.marcar_recordatorio(r['id'], ahora):
+            continue
+        try:
+            socio = db.socio(r['socio_id'])
+            clase = db.clase(r['clase_id'])
+            inicio = db.a_fecha(clase['inicio'])
+            correo.enviar(socio['email'], f"Recordatorio: {clase['nombre']} el {correo.fecha_y_hora(inicio)}",
+                          f"Hola {socio['nombre']}, te recordamos tu clase de {clase['nombre']} "
+                          f"con {clase['instructor']}.")
+        except Exception:
+            db.desmarcar_recordatorio(r['id'])
+            raise
+        enviados += 1
+    return {'enviados': enviados}
+
+
 def crear_app():
     db.inicializar()
     app = FastAPI(title='Pulso')
