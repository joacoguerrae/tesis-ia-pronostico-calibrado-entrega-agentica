+def crear_serie(datos, inicios):
+    """Crea la serie y sus clases (una por cada inicio) en una sola transacción."""
+    with conexion() as con:
+        cur = con.execute('INSERT INTO series (nombre, instructor, dia, hora, duracion_min, cupo, desde, hasta) '
+                          'VALUES (?, ?, ?, ?, ?, ?, ?, ?)',
+                          (datos['nombre'], datos['instructor'], datos['dia'], datos['hora'],
+                           datos['duracion_min'], datos['cupo'], datos['desde'], datos['hasta']))
+        serie_id = cur.lastrowid
+        for inicio in inicios:
+            con.execute('INSERT INTO clases (nombre, instructor, inicio, duracion_min, cupo, serie_id) '
+                        'VALUES (?, ?, ?, ?, ?, ?)',
+                        (datos['nombre'], datos['instructor'], a_texto(inicio), datos['duracion_min'],
+                         datos['cupo'], serie_id))
+    return serie_id
+
+
+def serie(serie_id):
+    return _una('SELECT * FROM series WHERE id = ?', (serie_id,))
+
+
+def clases_de_serie(serie_id):
+    return _varias('SELECT * FROM clases WHERE serie_id = ? ORDER BY inicio, id', (serie_id,))
+
+
+def socios_con_reserva_confirmada(clase_id):
+    return _varias("SELECT s.* FROM reservas r JOIN socios s ON s.id = r.socio_id "
+                   "WHERE r.clase_id = ? AND r.estado = 'confirmada' ORDER BY r.id", (clase_id,))
+
+
+def actualizar_serie(serie_id, cambios, nuevos_inicios):
+    """Aplica cambios (hora, instructor, cupo) a la serie y a las clases de nuevos_inicios {id: inicio nuevo o None}."""
+    with conexion() as con:
+        campos = ', '.join(f'{k} = ?' for k in cambios)
+        con.execute(f'UPDATE series SET {campos} WHERE id = ?', (*cambios.values(), serie_id))
+        for clase_id, inicio in nuevos_inicios.items():
+            if inicio is not None:
+                con.execute('UPDATE clases SET inicio = ? WHERE id = ?', (a_texto(inicio), clase_id))
+            for k in ('instructor', 'cupo'):
+                if k in cambios:
+                    con.execute(f'UPDATE clases SET {k} = ? WHERE id = ?', (cambios[k], clase_id))
+
+
+def cancelar_clase(clase_id):
+    """Cancela la clase y sus reservas confirmadas, devolviendo los créditos. Devuelve los socios afectados."""
+    socios = socios_con_reserva_confirmada(clase_id)
+    with conexion() as con:
+        con.execute("UPDATE clases SET estado = 'cancelada' WHERE id = ?", (clase_id,))
+        con.execute("UPDATE reservas SET estado = 'cancelada' WHERE clase_id = ? AND estado = 'confirmada'",
+                    (clase_id,))
+        for s in socios:
+            con.execute('UPDATE socios SET creditos = creditos + 1 WHERE id = ?', (s['id'],))
+    return socios
