diff --git a/pulso/beneficios.py b/pulso/beneficios.py
new file mode 100644
index 0000000..cb8b4e0
--- /dev/null
+++ b/pulso/beneficios.py
@@ -0,0 +1,32 @@
+"""Cliente del servicio de beneficios (fuente de verdad de los empleados de cada empresa)."""
+import os
+from urllib.parse import quote
+
+import httpx
+
+ACTIVO, INACTIVO = 'activo', 'inactivo'
+EMPLEADO_DESCONOCIDO, EMPRESA_DESCONOCIDA = 'empleado_desconocido', 'empresa_desconocida'
+
+
+class ServicioFalla(Exception):
+    pass
+
+
+def consultar(empresa, email):
+    base = os.environ.get('PULSO_BENEFICIOS_URL')
+    clave = os.environ.get('PULSO_BENEFICIOS_CLAVE')
+    if not base or not clave:
+        raise ServicioFalla('Servicio de beneficios sin configurar')
+    url = f"{base}/empresas/{quote(empresa, safe='')}/empleados/{quote(email.lower(), safe='')}"
+    try:
+        r = httpx.get(url, headers={'X-Api-Key': clave}, timeout=3.0)
+        cuerpo = r.json() if r.status_code in (200, 404) else None
+    except (httpx.HTTPError, ValueError) as e:
+        raise ServicioFalla(str(e))
+    if not isinstance(cuerpo, dict):
+        raise ServicioFalla(f'Respuesta inesperada ({r.status_code})')
+    if r.status_code == 200 and isinstance(cuerpo.get('activo'), bool):
+        return ACTIVO if cuerpo['activo'] else INACTIVO
+    if r.status_code == 404 and cuerpo.get('error') in (EMPLEADO_DESCONOCIDO, EMPRESA_DESCONOCIDA):
+        return cuerpo['error']
+    raise ServicioFalla(f'Respuesta inesperada ({r.status_code})')
