+@contextmanager
+def transaccion():
+    """Transacción de escritura: toma el lock de escritura de SQLite antes de leer.
+
+    Así, las lecturas y escrituras de adentro no se intercalan con las de otro pedido,
+    aunque venga de otro proceso. Si hay un error (o un HTTPException), se revierte todo.
+    Hay que hacer COMMIT explícitamente al terminar (no alcanza con salir del with).
+    """
+    con = _abrir()
+    con.isolation_level = None
+    try:
+        con.execute('BEGIN IMMEDIATE')
+        yield con
+        con.execute('COMMIT')
+    except BaseException:
+        if con.in_transaction:
+            con.execute('ROLLBACK')
+        raise
+    finally:
+        con.close()
