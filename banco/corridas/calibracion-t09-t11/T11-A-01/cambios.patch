+DIAS = ['lunes', 'martes', 'miércoles', 'jueves', 'viernes', 'sábado', 'domingo']
+CIERRES = {date(2026, 12, 25), date(2027, 1, 1), date(2027, 2, 8), date(2027, 2, 9),
+           date(2027, 3, 25), date(2027, 3, 26), date(2027, 5, 1)}
+HORA_RE = re.compile(r'^([01]\d|2[0-3]):[0-5]\d$')
+
+
+def _hora_valida(valor):
+    if not HORA_RE.match(valor):
+        raise ValueError('hora inválida')
+    return valor
+
+
+def _no_vacio(valor):
+    if not valor.strip():
+        raise ValueError('vacío')
+    return valor
+
+
+Texto = Annotated[StrictStr, AfterValidator(_no_vacio)]
+Hora = Annotated[StrictStr, AfterValidator(_hora_valida)]
+Entero = Annotated[StrictInt, Field(ge=1)]
+
+
+class NuevaSerie(BaseModel):
+    nombre: Texto
+    instructor: Texto
+    dia: Literal['lunes', 'martes', 'miércoles', 'jueves', 'viernes', 'sábado', 'domingo']
+    hora: Hora
+    duracion_min: Entero
+    cupo: Entero
+    desde: date
+    hasta: date
+
+    @model_validator(mode='after')
+    def _rango(self):
+        if self.hasta < self.desde or (self.hasta - self.desde).days > 366:
+            raise ValueError('rango de fechas inválido')
+        return self
