--- a/pulso/db.py
+++ b/pulso/db.py
@@ -90,6 +90,10 @@ def socio(socio_id):
     return _una('SELECT * FROM socios WHERE id = ?', (socio_id,))
 
 
+def socio_por_email(email):
+    return _una('SELECT * FROM socios WHERE email = ?', (email,))
