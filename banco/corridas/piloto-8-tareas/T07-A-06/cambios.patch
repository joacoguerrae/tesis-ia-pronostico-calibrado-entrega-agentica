+        except (cobra.CobraError, cobra.PagoInexistente):
+            pass
+        clave = {'aprobada': 'aprobadas', 'rechazada': 'rechazadas'}.get(final['estado'], 'pendientes')
+        resumen[clave] += 1
+    return resumen
+
+
 def crear_app():
     db.inicializar()
     app = FastAPI(title='Pulso')
