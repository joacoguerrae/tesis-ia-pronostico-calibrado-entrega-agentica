diff --git a/tests/test_ocupacion.py b/tests/test_ocupacion.py
new file mode 100644
index 0000000..e4993fa
--- /dev/null
+++ b/tests/test_ocupacion.py
@@ -0,0 +1,135 @@
+import csv
+import io
+from datetime import datetime, timedelta, timezone
+
+from conftest import ADMIN, AHORA
+from pulso import db
+
+ENCABEZADO = ['fecha', 'hora', 'clase', 'instructor', 'cupo', 'confirmadas', 'ocupacion_pct']
+
+
+def montevideo(*args):
+    """Momento en hora de Montevideo (UTC-3), convertido a UTC para guardar."""
+    return datetime(*args, tzinfo=timezone(timedelta(hours=-3))).astimezone(timezone.utc)
+
+
+def pedir(cliente, desde='2026-11-01', hasta='2026-11-30'):
+    return cliente.get('/admin/ocupacion.csv', params={'desde': desde, 'hasta': hasta}, headers=ADMIN)
+
+
+def filas(respuesta):
+    return list(csv.reader(io.StringIO(respuesta.text)))
+
+
+def test_exige_clave_de_administracion(cliente):
+    assert cliente.get('/admin/ocupacion.csv', params={'desde': '2026-11-01', 'hasta': '2026-11-02'}).status_code == 401
+    otra = {'X-Admin-Key': 'otra'}
+    assert cliente.get('/admin/ocupacion.csv', params={'desde': '2026-11-01', 'hasta': '2026-11-02'},
+                       headers=otra).status_code == 401
+
+
+def test_respuesta_es_csv_con_encabezado(cliente):
+    r = pedir(cliente)
+    assert r.status_code == 200
+    assert r.headers['content-type'] == 'text/csv; charset=utf-8'
+    assert filas(r) == [ENCABEZADO]
+
+
+def test_una_fila_por_clase_con_ocupacion(cliente):
+    clase = db.crear_clase('Spinning', 'Leo', montevideo(2026, 11, 3, 7, 0), cupo=20)
+    for i in range(15):
+        db.crear_reserva(db.crear_socio(f'Socio {i}', f's{i}@example.com')['id'], clase['id'], AHORA)
+    assert filas(pedir(cliente)) == [ENCABEZADO, ['2026-11-03', '07:00', 'Spinning', 'Leo', '20', '15', '75']]
+
+
+def test_orden_por_inicio_y_luego_id(cliente):
+    # Se crean en orden distinto al de inicio para probar que no ordena por id.
+    db.crear_clase('Funcional', 'Leo', montevideo(2026, 11, 5, 19, 0))
+    db.crear_clase('Yoga', 'Sofía', montevideo(2026, 11, 3, 9, 0))
+    db.crear_clase('Pilates', 'Marta', montevideo(2026, 11, 3, 9, 0))
+    assert [f[2] for f in filas(pedir(cliente))[1:]] == ['Yoga', 'Pilates', 'Funcional']
+
+
+def test_incluye_clases_pasadas_y_futuras(cliente):
+    db.crear_clase('Pasada', 'Leo', AHORA - timedelta(days=3))
+    db.crear_clase('Futura', 'Leo', AHORA + timedelta(days=3))
+    assert [f[2] for f in filas(pedir(cliente))[1:]] == ['Pasada', 'Futura']
+
+
+def test_extremos_del_periodo_se_incluyen(cliente):
+    db.crear_clase('Primera', 'Leo', montevideo(2026, 11, 1, 8, 0))
+    db.crear_clase('Ultima', 'Leo', montevideo(2026, 11, 30, 20, 0))
+    db.crear_clase('Antes', 'Leo', montevideo(2026, 10, 31, 23, 0))
+    db.crear_clase('Despues', 'Leo', montevideo(2026, 12, 1, 8, 0))
+    assert [f[2] for f in filas(pedir(cliente))[1:]] == ['Primera', 'Ultima']
+
+
+def test_el_dia_se_mide_en_montevideo(cliente):
+    # 2026-11-03 02:30 UTC es el 2 de noviembre a las 23:30 en Montevideo.
+    db.crear_clase('Nocturna', 'Leo', datetime(2026, 11, 3, 2, 30, tzinfo=timezone.utc))
+    # 2026-11-04 02:59 UTC es el 3 de noviembre a las 23:59 en Montevideo.
+    db.crear_clase('Tardecita', 'Leo', datetime(2026, 11, 4, 2, 59, tzinfo=timezone.utc))
+    r = pedir(cliente, desde='2026-11-03', hasta='2026-11-03')
+    assert filas(r)[1:] == [['2026-11-03', '23:59', 'Tardecita', 'Leo', '20', '0', '0']]
+    r = pedir(cliente, desde='2026-11-02', hasta='2026-11-02')
+    assert filas(r)[1:] == [['2026-11-02', '23:30', 'Nocturna', 'Leo', '20', '0', '0']]
+
+
+def test_canceladas_no_cuentan(cliente):
+    clase = db.crear_clase('Yoga', 'Sofía', montevideo(2026, 11, 3, 19, 30), cupo=12)
+    db.crear_reserva(db.crear_socio('Ana', 'ana@example.com')['id'], clase['id'], AHORA)
+    db.crear_reserva(db.crear_socio('Juan', 'juan@example.com')['id'], clase['id'], AHORA, estado='cancelada')
+    assert filas(pedir(cliente))[1] == ['2026-11-03', '19:30', 'Yoga', 'Sofía', '12', '1', '8']
+
+
+def test_porcentaje_redondea_mitad_hacia_arriba(cliente):
+    medio = db.crear_clase('Medio', 'Leo', montevideo(2026, 11, 3, 8, 0), cupo=8)
+    tercio = db.crear_clase('Tercio', 'Leo', montevideo(2026, 11, 3, 9, 0), cupo=3)
+    dos_tercios = db.crear_clase('Dos tercios', 'Leo', montevideo(2026, 11, 3, 10, 0), cupo=3)
+    lleno = db.crear_clase('Lleno', 'Leo', montevideo(2026, 11, 3, 11, 0), cupo=12)
+    db.crear_reserva(db.crear_socio('A', 'a@example.com')['id'], medio['id'], AHORA)
+    db.crear_reserva(db.crear_socio('B', 'b@example.com')['id'], tercio['id'], AHORA)
+    for i, clase in enumerate((dos_tercios, dos_tercios)):
+        db.crear_reserva(db.crear_socio(f'C{i}', f'c{i}@example.com')['id'], clase['id'], AHORA)
+    for i in range(12):
+        db.crear_reserva(db.crear_socio(f'L{i}', f'l{i}@example.com')['id'], lleno['id'], AHORA)
+    pcts = [f[6] for f in filas(pedir(cliente))[1:]]
+    assert pcts == ['13', '33', '67', '100']
+
+
+def test_texto_con_comas_y_comillas_va_escapado(cliente):
+    db.crear_clase('Yoga, nivel "1"', 'Sofía, la mejor', montevideo(2026, 11, 3, 19, 30), cupo=12)
+    r = pedir(cliente)
+    assert '"Yoga, nivel ""1"""' in r.text
+    assert filas(r)[1][2:4] == ['Yoga, nivel "1"', 'Sofía, la mejor']
+
+
+def test_periodo_sin_clases_trae_solo_encabezado(cliente):
+    db.crear_clase('Yoga', 'Sofía', montevideo(2026, 10, 15, 19, 30))
+    assert filas(pedir(cliente)) == [ENCABEZADO]
+
+
+def test_periodo_de_un_dia_se_acepta(cliente):
+    assert pedir(cliente, desde='2026-11-01', hasta='2026-11-01').status_code == 200
+
+
+def test_periodo_de_31_dias_se_acepta(cliente):
+    assert pedir(cliente, desde='2026-10-01', hasta='2026-10-31').status_code == 200
+
+
+def test_periodo_de_mas_de_31_dias_es_422(cliente):
+    assert pedir(cliente, desde='2026-10-01', hasta='2026-11-01').status_code == 422
+
+
+def test_desde_posterior_a_hasta_es_422(cliente):
+    assert pedir(cliente, desde='2026-11-10', hasta='2026-11-09').status_code == 422
+
+
+def test_fechas_faltantes_o_mal_formadas_son_422(cliente):
+    assert cliente.get('/admin/ocupacion.csv', params={'hasta': '2026-11-30'}, headers=ADMIN).status_code == 422
+    assert cliente.get('/admin/ocupacion.csv', params={'desde': '2026-11-01'}, headers=ADMIN).status_code == 422
+    assert pedir(cliente, desde='01/11/2026').status_code == 422
+    assert pedir(cliente, desde='2026-1-1').status_code == 422
+    assert pedir(cliente, desde='').status_code == 422
+    assert pedir(cliente, hasta='2026-02-30').status_code == 422
+    assert pedir(cliente, hasta='2026-11-31').status_code == 422
