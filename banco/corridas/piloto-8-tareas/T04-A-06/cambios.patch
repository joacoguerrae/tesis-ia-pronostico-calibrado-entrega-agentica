diff --git a/pulso/main.py b/pulso/main.py
index 039212d..31ccc1b 100644
--- a/pulso/main.py
+++ b/pulso/main.py
@@ -1,4 +1,5 @@
 import os
+import sqlite3
 
 from fastapi import APIRouter, Depends, FastAPI, Header, HTTPException
 from pydantic import AwareDatetime, BaseModel, Field
@@ -92,6 +93,43 @@ def yo(socio=Depends(socio_actual)):
     return {k: socio[k] for k in ('id', 'nombre', 'email', 'plan', 'creditos')}
 
 
+CREDITOS_POR_PLAN = {'basico': 8, 'premium': 20}
+
+
+class NuevoSocio(BaseModel):
+    nombre: str
+    email: str
+    plan: str
+
+
+def email_valido(email):
+    if not email or any(c.isspace() for c in email) or email.count('@') != 1:
+        return False
+    local, dominio = email.split('@')
+    return bool(local) and '.' in dominio and not dominio.startswith('.') and not dominio.endswith('.')
+
+
+@router.post('/socios', status_code=201)
+def registrar_socio(datos: NuevoSocio):
+    nombre = datos.nombre.strip()
+    email = datos.email.strip().lower()
+    if not 2 <= len(nombre) <= 80:
+        raise HTTPException(422, 'El nombre debe tener entre 2 y 80 caracteres')
+    if not email_valido(email):
+        raise HTTPException(422, 'El email no es válido')
+    if datos.plan not in CREDITOS_POR_PLAN:
+        raise HTTPException(422, 'El plan debe ser basico o premium')
+    if db.socio_por_email(email) is not None:
+        raise HTTPException(409, 'Ya existe un socio con ese email')
+    try:
+        socio = db.crear_socio(nombre, email, datos.plan, CREDITOS_POR_PLAN[datos.plan])
+    except sqlite3.IntegrityError:
+        raise HTTPException(409, 'Ya existe un socio con ese email')
+    correo.enviar(email, 'Te damos la bienvenida a Pulso',
+                  f"Hola {nombre}, ya sos socio de Pulso. Tenés {socio['creditos']} créditos para reservar clases.")
+    return {k: socio[k] for k in ('id', 'nombre', 'email', 'plan', 'creditos', 'token')}
+
+
 def crear_app():
     db.inicializar()
     app = FastAPI(title='Pulso')
