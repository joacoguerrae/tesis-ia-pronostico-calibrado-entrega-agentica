     return {k: socio[k] for k in ('id', 'nombre', 'email', 'plan', 'creditos')}
 
 
+def _asignar_lugares(con, clase):
+    """Pasa los lugares libres de la clase a la lista de espera, en la transacción de `con`."""
+    inicio = db.a_fecha(clase['inicio'])
+    if inicio <= reloj.ahora():
+        return
+    cuando = f"{clase['nombre']} el {correo.fecha_y_hora(inicio)}"
+    while True:
+        confirmadas = con.execute("SELECT COUNT(*) FROM reservas WHERE clase_id = ? AND estado = 'confirmada'",
+                                  (clase['id'],)).fetchone()[0]
+        if confirmadas >= clase['cupo']:
+            return
+        fila = con.execute('SELECT e.id AS espera_id, s.* FROM espera e JOIN socios s ON s.id = e.socio_id '
+                           'WHERE e.clase_id = ? ORDER BY e.id LIMIT 1', (clase['id'],)).fetchone()
+        if fila is None:
+            return
+        con.execute('DELETE FROM espera WHERE id = ?', (fila['espera_id'],))
+        ya = con.execute("SELECT 1 FROM reservas WHERE socio_id = ? AND clase_id = ? AND estado = 'confirmada'",
+                         (fila['id'], clase['id'])).fetchone()
+        if ya:
+            continue
+        if fila['creditos'] < 1:
+            correo.enviar(fila['email'], f'No pudimos darte el lugar: {cuando}',
+                          f"Hola {fila['nombre']}, no tenés créditos para quedarte con el lugar.", con)
+            continue
+        con.execute("INSERT INTO reservas (socio_id, clase_id, estado, creada) VALUES (?, ?, 'confirmada', ?)",
+                    (fila['id'], clase['id'], db.a_texto(reloj.ahora())))
+        con.execute('UPDATE socios SET creditos = creditos - 1 WHERE id = ?', (fila['id'],))
+        correo.enviar(fila['email'], f'Se liberó un lugar: {cuando}',
+                      f"Hola {fila['nombre']}, tenés lugar en {clase['nombre']} con {clase['instructor']}.", con)
+
+
+def _posicion(con, socio_id, clase_id):
+    fila = con.execute('SELECT id FROM espera WHERE socio_id = ? AND clase_id = ?', (socio_id, clase_id)).fetchone()
+    if fila is None:
+        raise HTTPException(404, 'No estás en la lista de espera')
+    n = con.execute('SELECT COUNT(*) FROM espera WHERE clase_id = ? AND id <= ?', (clase_id, fila['id'])).fetchone()[0]
+    return {'clase_id': clase_id, 'posicion': n}
+
+
+def _clase_o_404(con, clase_id):
+    clase = con.execute('SELECT * FROM clases WHERE id = ?', (clase_id,)).fetchone()
+    if clase is None:
+        raise HTTPException(404, 'No existe la clase')
+    return dict(clase)
+
+
+@router.post('/clases/{clase_id}/espera', status_code=201)
+def anotarse_en_espera(clase_id: int, socio=Depends(socio_actual)):
+    with db.conexion() as con:
+        con.execute('BEGIN IMMEDIATE')
+        clase = _clase_o_404(con, clase_id)
+        if db.a_fecha(clase['inicio']) <= reloj.ahora():
+            raise HTTPException(409, 'La clase ya empezó')
+        confirmadas = con.execute("SELECT COUNT(*) FROM reservas WHERE clase_id = ? AND estado = 'confirmada'",
+                                  (clase_id,)).fetchone()[0]
+        if confirmadas < clase['cupo']:
+            raise HTTPException(409, 'La clase tiene lugar: reservá directo')
+        if con.execute("SELECT 1 FROM reservas WHERE socio_id = ? AND clase_id = ? AND estado = 'confirmada'",
+                       (socio['id'], clase_id)).fetchone():
+            raise HTTPException(409, 'Ya tenés una reserva para esta clase')
+        if con.execute('SELECT 1 FROM espera WHERE socio_id = ? AND clase_id = ?', (socio['id'], clase_id)).fetchone():
+            raise HTTPException(409, 'Ya estás en la lista de espera')
+        creditos = con.execute('SELECT creditos FROM socios WHERE id = ?', (socio['id'],)).fetchone()[0]
+        if creditos < 1:
+            raise HTTPException(409, 'No te quedan créditos')
+        con.execute('INSERT INTO espera (socio_id, clase_id, creada) VALUES (?, ?, ?)',
+                    (socio['id'], clase_id, db.a_texto(reloj.ahora())))
+        return _posicion(con, socio['id'], clase_id)
+
+
+@router.get('/clases/{clase_id}/espera')
+def ver_espera(clase_id: int, socio=Depends(socio_actual)):
+    with db.conexion() as con:
+        _clase_o_404(con, clase_id)
+        return _posicion(con, socio['id'], clase_id)
+
+
+@router.delete('/clases/{clase_id}/espera', status_code=204)
+def bajarse_de_espera(clase_id: int, socio=Depends(socio_actual)):
+    with db.conexion() as con:
+        _clase_o_404(con, clase_id)
+        _posicion(con, socio['id'], clase_id)
+        con.execute('DELETE FROM espera WHERE socio_id = ? AND clase_id = ?', (socio['id'], clase_id))
+
+
+@router.post('/admin/reservas/{reserva_id}/cancelar', dependencies=[Depends(admin)])
+def cancelar_reserva(reserva_id: int):
+    with db.conexion() as con:
+        con.execute('BEGIN IMMEDIATE')
+        reserva = con.execute('SELECT * FROM reservas WHERE id = ?', (reserva_id,)).fetchone()
+        if reserva is None:
+            raise HTTPException(404, 'No existe la reserva')
+        if reserva['estado'] == 'cancelada':
+            raise HTTPException(409, 'La reserva ya estaba cancelada')
+        con.execute("UPDATE reservas SET estado = 'cancelada' WHERE id = ?", (reserva_id,))
+        con.execute('UPDATE socios SET creditos = creditos + 1 WHERE id = ?', (reserva['socio_id'],))
+        clase = _clase_o_404(con, reserva['clase_id'])
+        _asignar_lugares(con, clase)
+        return ver_reserva(con.execute('SELECT * FROM reservas WHERE id = ?', (reserva_id,)).fetchone())
+
+
+class CambioCupo(BaseModel):
+    cupo: StrictInt = Field(gt=0)
+
+
+@router.patch('/admin/clases/{clase_id}', dependencies=[Depends(admin)])
+def cambiar_cupo(clase_id: int, datos: CambioCupo):
+    with db.conexion() as con:
+        con.execute('BEGIN IMMEDIATE')
+        clase = _clase_o_404(con, clase_id)
+        confirmadas = con.execute("SELECT COUNT(*) FROM reservas WHERE clase_id = ? AND estado = 'confirmada'",
+                                  (clase_id,)).fetchone()[0]
+        if datos.cupo < confirmadas:
+            raise HTTPException(409, 'El cupo no puede ser menor a las reservas confirmadas')
+        con.execute('UPDATE clases SET cupo = ? WHERE id = ?', (datos.cupo, clase_id))
+        clase['cupo'] = datos.cupo
+        _asignar_lugares(con, clase)
+    return ver_clase(db.clase(clase_id))
