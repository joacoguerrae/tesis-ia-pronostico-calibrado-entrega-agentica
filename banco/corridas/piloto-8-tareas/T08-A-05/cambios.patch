+def activar_corporativo(socio_id, empresa, piso=12):
+    """Pasa a corporativo con un piso de créditos. False si ya era corporativo."""
+    with conexion() as con:
+        cur = con.execute("UPDATE socios SET plan = 'corporativo', empresa = ?, creditos = MAX(creditos, ?) "
+                          "WHERE id = ? AND plan != 'corporativo'", (empresa, piso, socio_id))
+    return cur.rowcount == 1
+
