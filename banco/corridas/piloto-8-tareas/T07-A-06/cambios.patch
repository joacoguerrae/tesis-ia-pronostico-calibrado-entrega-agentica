+PACKS = {'pack-4': {'creditos': 4, 'precio': 1200}, 'pack-8': {'creditos': 8, 'precio': 2200}}
+ESTADOS_PAGO = {'aprobado': 'aprobada', 'rechazado': 'rechazada'}
+PREFIJO_REFERENCIA = 'pulso-compra-'
+ESPERA_PAGO = timedelta(minutes=30)
+
+
+def ver_compra(compra):
+    datos = {k: compra[k] for k in ('id', 'pack', 'creditos', 'monto', 'estado', 'creada', 'url_pago')}
+    datos['creada'] = db.a_fecha(compra['creada']).isoformat()
