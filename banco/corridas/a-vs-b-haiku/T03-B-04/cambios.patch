diff --git a/pulso/main.py b/pulso/main.py
index 039212d..f262592 100644
--- a/pulso/main.py
+++ b/pulso/main.py
@@ -1,12 +1,20 @@
+import csv
+import io
 import os
+import re
+from datetime import date
 
-from fastapi import APIRouter, Depends, FastAPI, Header, HTTPException
+from fastapi import APIRouter, Depends, FastAPI, Header, HTTPException, Response
 from pydantic import AwareDatetime, BaseModel, Field
 
 from pulso import correo, db, reloj
 
 router = APIRouter()
 
+CABECERA_OCUPACION = ['fecha', 'hora', 'clase', 'instructor', 'cupo', 'confirmadas', 'ocupacion_pct']
+MAX_DIAS_OCUPACION = 31
+FORMATO_FECHA = re.compile(r'[0-9]{4}-[0-9]{2}-[0-9]{2}')
+
 
 def socio_actual(authorization: str | None = Header(default=None)):
     if not authorization or not authorization.startswith('Bearer '):
@@ -57,6 +65,51 @@ def crear_clase(datos: NuevaClase):
     return ver_clase(db.crear_clase(**datos.model_dump()))
 
 
+def leer_fecha(valor, nombre):
+    if not valor:
+        raise HTTPException(422, f'Falta {nombre} (formato YYYY-MM-DD)')
+    if not FORMATO_FECHA.fullmatch(valor):
+        raise HTTPException(422, f'{nombre} no tiene formato YYYY-MM-DD')
+    try:
+        return date.fromisoformat(valor)
+    except ValueError:
+        raise HTTPException(422, f'{nombre} no es una fecha válida')
+
+
+def fila_ocupacion(clase):
+    inicio = db.a_fecha(clase['inicio']).astimezone(reloj.MONTEVIDEO)
+    confirmadas = db.confirmadas(clase['id'])
+    cupo = clase['cupo']
+    # Entero redondeado hacia arriba en los ,5: floor(confirmadas * 100 / cupo + 1/2).
+    pct = (200 * confirmadas + cupo) // (2 * cupo)
+    return [inicio.date().isoformat(), f'{inicio:%H:%M}', clase['nombre'], clase['instructor'],
+            cupo, confirmadas, pct]
+
+
+@router.get('/admin/ocupacion.csv', dependencies=[Depends(admin)])
+def ocupacion_csv(desde: str | None = None, hasta: str | None = None):
+    desde_dia = leer_fecha(desde, 'desde')
+    hasta_dia = leer_fecha(hasta, 'hasta')
+    if desde_dia > hasta_dia:
+        raise HTTPException(422, 'desde es posterior a hasta')
+    if (hasta_dia - desde_dia).days + 1 > MAX_DIAS_OCUPACION:
+        raise HTTPException(422, f'El período no puede tener más de {MAX_DIAS_OCUPACION} días')
+
+    en_periodo = []
+    for clase in db.clases():
+        inicio = db.a_fecha(clase['inicio'])
+        dia = inicio.astimezone(reloj.MONTEVIDEO).date()
+        if desde_dia <= dia <= hasta_dia:
+            en_periodo.append((inicio, clase['id'], clase))
+    en_periodo.sort(key=lambda t: (t[0], t[1]))
+
+    salida = io.StringIO()
+    escritor = csv.writer(salida)
+    escritor.writerow(CABECERA_OCUPACION)
+    escritor.writerows(fila_ocupacion(clase) for _, _, clase in en_periodo)
+    return Response(salida.getvalue(), media_type='text/csv; charset=utf-8')
+
+
 class NuevaReserva(BaseModel):
     clase_id: int
 
