--- a/pulso/main.py
+++ b/pulso/main.py
@@ -1,5 +1,9 @@
 import os
+import re
+from datetime import timedelta
+from urllib.parse import quote
 
+import httpx
 from fastapi import APIRouter, Depends, FastAPI, Header, HTTPException
 from pydantic import AwareDatetime, BaseModel, Field
 
@@ -92,6 +96,183 @@ def yo(socio=Depends(socio_actual)):
     return {k: socio[k] for k in ('id', 'nombre', 'email', 'plan', 'creditos')}
 
 
+# --- Cobrá: pasarela de pagos. Es la fuente de verdad sobre el estado de un pago. ---
+# Cualquier respuesta que no esté en el contrato para esa ruta, o que no se pueda leer, es una falla.
+
+COBRA_ESTADOS = ('pendiente', 'aprobado', 'rechazado')
+# Transporte de httpx para hablar con Cobrá; None usa la red. Los tests lo reemplazan por uno falso.
+TRANSPORTE_COBRA = None
+
+
+class CobraNoDisponible(Exception):
+    pass
+
+
+def _cobra(metodo, ruta, aceptados, **kwargs):
+    url = os.environ.get('PULSO_PAGOS_URL', '').rstrip('/') + ruta
+    headers = {'X-Cobra-Clave': os.environ.get('PULSO_PAGOS_CLAVE', '')}
+    headers.update(kwargs.pop('headers', {}))
+    try:
+        with httpx.Client(timeout=5, transport=TRANSPORTE_COBRA) as cliente:
+            r = cliente.request(metodo, url, headers=headers, **kwargs)
+    except httpx.HTTPError as error:
+        raise CobraNoDisponible(str(error)) from error
+    if r.status_code not in aceptados:
+        raise CobraNoDisponible(f'Cobrá respondió {r.status_code} a {metodo} {ruta}')
+    return r
+
+
+def _leer(r):
+    try:
+        return r.json()
+    except ValueError as error:
+        raise CobraNoDisponible('Cobrá respondió algo que no es JSON') from error
+
+
+def _validar_pago(datos):
+    if not isinstance(datos, dict) or not all(isinstance(datos.get(k), str) for k in ('id', 'estado', 'referencia', 'url_pago')):
+        raise CobraNoDisponible('Cobrá respondió un pago mal formado')
+    if datos['estado'] not in COBRA_ESTADOS:
+        raise CobraNoDisponible(f"Cobrá respondió un estado desconocido: {datos['estado']}")
+    return datos
+
+
+def cobra_crear_pago(referencia, monto):
+    # Con la misma Idempotency-Key, Cobrá devuelve el pago que ya existía (200) en vez de crear otro.
+    r = _cobra('POST', '/pagos', (200, 201), headers={'Idempotency-Key': referencia},
+               json={'monto': monto, 'moneda': 'UYU', 'referencia': referencia})
+    return _validar_pago(_leer(r))
+
+
+def cobra_obtener_pago(pago_id):
+    """Devuelve el pago, o None si Cobrá no lo conoce."""
+    r = _cobra('GET', '/pagos/' + quote(pago_id, safe=''), (200, 404))
+    if r.status_code == 404:
+        return None
+    return _validar_pago(_leer(r))
+
+
+def cobra_pagos_por_referencia(referencia):
+    r = _cobra('GET', '/pagos', (200,), params={'referencia': referencia})
+    datos = _leer(r)
+    if not isinstance(datos, dict) or not isinstance(datos.get('pagos'), list):
+        raise CobraNoDisponible('Cobrá respondió una lista de pagos mal formada')
+    return [_validar_pago(p) for p in datos['pagos']]
+
+
+# --- Compras de créditos ---
+
+CATALOGO = {'pack-4': (4, 1200), 'pack-8': (8, 2200)}  # pack -> (créditos, precio en UYU)
+MINUTOS_SIN_PAGO_HASTA_RECHAZO = 30
+
+
+def referencia_de(compra_id):
+    return f'pulso-compra-{compra_id}'
+
+
+def compra_id_de(referencia):
+    m = re.fullmatch(r'pulso-compra-(\d+)', referencia)
+    return int(m[1]) if m else None
+
+
+def ver_compra(compra):
+    return {k: compra[k] for k in ('id', 'pack', 'creditos', 'monto', 'estado', 'creada', 'url_pago')}
+
+
+class NuevaCompra(BaseModel):
+    pack: str
+
+
+@router.post('/compras', status_code=201)
+def comprar(datos: NuevaCompra, socio=Depends(socio_actual)):
+    if datos.pack not in CATALOGO:
+        raise HTTPException(422, 'No existe ese pack')
+    creditos, monto = CATALOGO[datos.pack]
+    # La compra se guarda antes de llamar a Cobrá: si la llamada falla, queda pendiente y la conciliación la resuelve.
+    compra = db.crear_compra(socio['id'], datos.pack, creditos, monto, reloj.ahora())
+    try:
+        pago = cobra_crear_pago(referencia_de(compra['id']), monto)
+    except CobraNoDisponible:
+        raise HTTPException(502, 'Cobrá no respondió. La compra queda pendiente')
+    db.guardar_pago(compra['id'], pago['id'], pago['url_pago'])
+    return ver_compra(db.compra(compra['id']))
+
+
+@router.get('/compras')
+def mis_compras(socio=Depends(socio_actual)):
+    return [ver_compra(c) for c in db.compras_de(socio['id'])]
+
+
+def _aplicar_estado(compra, estado_cobra):
+    """Aplica el estado que dice Cobrá. Una compra aprobada o rechazada no cambia más."""
+    if compra['estado'] != 'pendiente' or estado_cobra == 'pendiente':
+        return
+    if estado_cobra == 'rechazado':
+        db.cambiar_estado_compra(compra['id'], 'rechazada')
+        return
+    socio = db.socio(compra['socio_id'])
+    # El paso a aprobada, los créditos y el correo van en una sola transacción: si el cambio no se hace
+    # (porque otro proceso ya lo hizo), no se suma nada ni se manda nada.
+    with db.conexion() as con:
+        if not db.cambiar_estado_compra(compra['id'], 'aprobada', con=con):
+            return
+        db.sumar_creditos(socio['id'], compra['creditos'], con=con)
+        correo.enviar(socio['email'], 'Compra de créditos aprobada',
+                      f"Hola {socio['nombre']}, se acreditaron {compra['creditos']} créditos "
+                      f"por tu compra del {compra['pack']}.", con=con)
+
+
+class AvisoPago(BaseModel):
+    # Lo único que se usa del aviso. El estado que viene en el cuerpo se ignora: se consulta a Cobrá.
+    pago_id: str = Field(min_length=1)
+
+
+@router.post('/webhooks/pagos')
+def webhook_pago(aviso: AvisoPago):
+    try:
+        pago = cobra_obtener_pago(aviso.pago_id)
+    except CobraNoDisponible:
+        raise HTTPException(503, 'Cobrá no respondió')
+    compra_id = compra_id_de(pago['referencia']) if pago else None
+    compra = db.compra(compra_id) if compra_id is not None else None
+    if compra is None:
+        raise HTTPException(404, 'No hay ninguna compra para ese pago')
+    db.guardar_pago(compra['id'], pago['id'], pago['url_pago'])
+    _aplicar_estado(compra, pago['estado'])
+    return {'compra_id': compra['id'], 'estado': db.compra(compra['id'])['estado']}
+
+
+def _conciliar_compra(compra, ahora):
+    if compra['pago_id']:
+        pago = cobra_obtener_pago(compra['pago_id'])
+        if pago is None:
+            return
+    else:
+        pagos = cobra_pagos_por_referencia(referencia_de(compra['id']))
+        if not pagos:
+            # Sin pago en Cobrá: si la compra es vieja, el pago nunca se creó. Si es reciente, puede estar creándose.
+            if ahora - db.a_fecha(compra['creada']) >= timedelta(minutes=MINUTOS_SIN_PAGO_HASTA_RECHAZO):
+                db.cambiar_estado_compra(compra['id'], 'rechazada')
+            return
+        pago = pagos[0]
+        db.guardar_pago(compra['id'], pago['id'], pago['url_pago'])
+    _aplicar_estado(compra, pago['estado'])
+
+
+@router.post('/admin/conciliar-pagos', dependencies=[Depends(admin)])
+def conciliar_pagos():
+    ahora = reloj.ahora()
+    cuentas = {'aprobadas': 0, 'rechazadas': 0, 'pendientes': 0}
+    for compra in db.compras_pendientes():  # las que estaban pendientes al empezar
+        try:
+            _conciliar_compra(compra, ahora)
+        except CobraNoDisponible:
+            pass  # Si Cobrá falla con esta compra, sigue pendiente y se pasa a la siguiente
+        estado = db.compra(compra['id'])['estado']
+        cuentas[{'aprobada': 'aprobadas', 'rechazada': 'rechazadas'}.get(estado, 'pendientes')] += 1
+    return cuentas
+
+
 def crear_app():
     db.inicializar()
     app = FastAPI(title='Pulso')
