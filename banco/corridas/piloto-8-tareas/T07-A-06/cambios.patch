+
+
+def compras_de(socio_id):
+    return _varias('SELECT * FROM compras WHERE socio_id = ? ORDER BY creada DESC, id DESC', (socio_id,))
+
+
+def compras_pendientes():
+    return _varias("SELECT * FROM compras WHERE estado = 'pendiente' ORDER BY id")
+
+
+def guardar_pago(compra_id, pago_id, url_pago):
+    """Guarda el pago solo si la compra todavía no tiene uno."""
+    with conexion() as con:
+        con.execute('UPDATE compras SET pago_id = ?, url_pago = ? WHERE id = ? AND pago_id IS NULL',
+                    (pago_id, url_pago, compra_id))
+
+
+def resolver_compra(compra_id, estado):
+    """Pasa una compra pendiente a 'aprobada' o 'rechazada' una sola vez. Si se aprueba, suma los créditos
+    y guarda el correo en la misma transacción. Devuelve True si fue esta llamada la que la resolvió."""
+    from pulso import correo
+    with conexion() as con:
+        cur = con.execute("UPDATE compras SET estado = ? WHERE id = ? AND estado = 'pendiente'", (estado, compra_id))
+        if cur.rowcount == 0:
+            return False
+        if estado == 'aprobada':
+            c = con.execute('SELECT * FROM compras WHERE id = ?', (compra_id,)).fetchone()
+            con.execute('UPDATE socios SET creditos = creditos + ? WHERE id = ?', (c['creditos'], c['socio_id']))
+            s = con.execute('SELECT * FROM socios WHERE id = ?', (c['socio_id'],)).fetchone()
+            correo.enviar(s['email'], 'Compra de créditos aprobada',
+                          f"Hola {s['nombre']}, tu compra de {c['creditos']} créditos fue aprobada.", con)
+    return True
+
+
 def correos():
     return _varias('SELECT * FROM correos ORDER BY id')
