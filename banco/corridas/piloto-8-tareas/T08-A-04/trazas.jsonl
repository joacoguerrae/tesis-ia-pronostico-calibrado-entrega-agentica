{"host.arch": "arm64", "os.type": "darwin", "os.version": "23.4.0", "service.name": "claude-code", "service.version": "2.1.312", "user.id": "", "session.id": "aa48e464-9258-4a93-8998-e093ca515d83", "terminal.type": "claude-desktop", "gen_ai.provider.name": "anthropic", "span.type": "tool", "tool_name": "Bash", "tool_name_safe": "Bash", "gen_ai.operation.name": "execute_tool", "gen_ai.tool.name": "Bash", "gen_ai.conversation.id": "aa48e464-9258-4a93-8998-e093ca515d83", "full_command": "cat > pulso/beneficios.py <<'EOF'\n\"\"\"Cliente del servicio de beneficios (fuente de verdad de los empleados de cada empresa).\"\"\"\nimport os\nfrom urllib.parse import quote\n\nimport httpx\n\nTIMEOUT = 3\n\nACTIVO = 'activo'\nINACTIVO = 'inactivo'\nEMPLEADO_DESCONOCIDO = 'empleado_desconocido'\nEMPRESA_DESCONOCIDA = 'empresa_desconocida'\n\n\nclass ServicioFalla(Exception):\n    pass\n\n\ndef consultar(empresa, email):\n    \"\"\"Devuelve ACTIVO, INACTIVO, EMPLEADO_DESCONOCIDO o EMPRESA_DESCONOCIDA; ServicioFalla si no es confiable.\"\"\"\n    base = os.environ.get('PULSO_BENEFICIOS_URL')\n    clave = os.environ.get('PULSO_BENEFICIOS_CLAVE')\n    if not base or not clave:\n        raise ServicioFalla('Servicio de beneficios sin configurar')\n    url = f\"{base}/empresas/{quote(empresa, safe='')}/empleados/{quote(email.lower(), safe='')}\"\n    try:\n        r = httpx.get(url, headers={'X-Api-Key': clave}, timeout=TIMEOUT)\n        cuerpo = r.json() if r.status_code in (200, 404) else None\n    except (httpx.HTTPError, ValueError) as e:\n        raise ServicioFalla(str(e)) from e\n    if not isinstance(cuerpo, dict):\n        raise ServicioFalla(f'Respuesta inesperada ({r.status_code})')\n    if r.status_code == 200 and isinstance(cuerpo.get('activo'), bool):\n        return ACTIVO if cuerpo['activo'] else INACTIVO\n    if r.status_code == 404 and cuerpo.get('error') in (EMPLEADO_DESCONOCIDO, EMPRESA_DESCONOCIDA):\n        return cuerpo['error']\n    raise ServicioFalla(f'Respuesta inesperada ({r.status_code})')\nEOF\npython - <<'EOF'\nEOF\n", "bash_command_class": "file_read", "bash_argv0": "cat", "tool_use_id": "toolu_01QtmEex53SFg4BqC7Hh5C3s", "gen_ai.tool.call.id": "toolu_01QtmEex53SFg4BqC7Hh5C3s", "duration_ms": 7, "_nombre": "claude_code.tool", "_traza": "cba227175bbe83c39ccbaee152eea802", "_tramo": "883df7e732a89b8d", "_padre": "2487a78f12622f9f", "_inicio_ns": 1794571757121000000, "_fin_ns": 1794571757127550875, "_estado": 0}
