diff --git a/tests/test_lista_espera.py b/tests/test_lista_espera.py
new file mode 100644
index 0000000..db741e0
--- /dev/null
+++ b/tests/test_lista_espera.py
@@ -0,0 +1,105 @@
+from datetime import timedelta
+
+from conftest import AHORA, auth
+from pulso import db
+
+
+def llena(cupo=1, inicio=AHORA + timedelta(hours=2)):
+    """Clase con su cupo ocupado por otro socio."""
+    clase = db.crear_clase('Spinning', 'Leo', inicio, cupo=cupo)
+    otro = db.crear_socio('Juan Gómez', f'juan{clase["id"]}@example.com')
+    db.crear_reserva(otro['id'], clase['id'], AHORA)
+    return clase
+
+
+def otro_socio(nombre):
+    return db.crear_socio(nombre, f"{nombre.split()[0].lower()}@example.com")
+
+
+def test_anotarse_en_clase_llena(cliente, socio):
+    clase = llena()
+    r = cliente.post(f"/clases/{clase['id']}/espera", headers=auth(socio))
+    assert r.status_code == 201
+    assert r.json() == {'clase_id': clase['id'], 'posicion': 1}
+    # Anotarse no es reservar: no descuenta créditos, no crea reserva ni manda correo.
+    assert db.socio(socio['id'])['creditos'] == 8
+    assert [r['socio_id'] for r in db.reservas_de(socio['id'])] == []
+    assert db.correos() == []
+
+
+def test_posiciones_siguen_el_orden_de_llegada(cliente):
+    clase = llena()
+    ana, beto, carla = otro_socio('Ana Pérez'), otro_socio('Beto Silva'), otro_socio('Carla Ruiz')
+    for s in (ana, beto, carla):
+        assert cliente.post(f"/clases/{clase['id']}/espera", headers=auth(s)).status_code == 201
+    for esperado, s in enumerate((ana, beto, carla), start=1):
+        r = cliente.get(f"/clases/{clase['id']}/espera", headers=auth(s))
+        assert r.status_code == 200
+        assert r.json() == {'clase_id': clase['id'], 'posicion': esperado}
+
+
+def test_sin_token_responde_401(cliente):
+    clase = llena()
+    assert cliente.post(f"/clases/{clase['id']}/espera").status_code == 401
+    assert cliente.get(f"/clases/{clase['id']}/espera").status_code == 401
+    assert cliente.delete(f"/clases/{clase['id']}/espera").status_code == 401
+    assert cliente.post(f"/clases/{clase['id']}/espera", headers={'Authorization': 'Bearer nada'}).status_code == 401
+
+
+def test_clase_inexistente_responde_404(cliente, socio):
+    assert cliente.post('/clases/99/espera', headers=auth(socio)).status_code == 404
+    assert cliente.get('/clases/99/espera', headers=auth(socio)).status_code == 404
+    assert cliente.delete('/clases/99/espera', headers=auth(socio)).status_code == 404
+
+
+def test_no_se_anota_en_clase_con_lugar(cliente, socio):
