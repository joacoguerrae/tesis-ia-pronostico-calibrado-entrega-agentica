+@contextmanager
+def transaccion():
+    """Operación atómica: toma el lock de escritura al empezar, así que todo se confirma junto o nada."""
+    con = sqlite3.connect(ruta(), isolation_level=None)
+    con.row_factory = sqlite3.Row
+    con.execute('PRAGMA foreign_keys = ON')
+    try:
+        con.execute('BEGIN IMMEDIATE')
+        yield con
+        con.execute('COMMIT')
+    except BaseException:
+        con.execute('ROLLBACK')
+        raise
+    finally:
+        con.close()
+
+
+def _una_en(con, sql, parametros=()):
+    fila = con.execute(sql, parametros).fetchone()
+    return dict(fila) if fila else None
+
+
+def _varias_en(con, sql, parametros=()):
+    return [dict(f) for f in con.execute(sql, parametros).fetchall()]
+
+
 def a_texto(momento):
     return momento.astimezone(timezone.utc).replace(microsecond=0).isoformat()
 
