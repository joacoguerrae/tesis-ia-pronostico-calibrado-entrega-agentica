 import os
+import re
+from datetime import timedelta
 
 from fastapi import APIRouter, Depends, FastAPI, Header, HTTPException
 from pydantic import AwareDatetime, BaseModel, Field
 
-from pulso import correo, db, reloj
+from pulso import cobra, correo, db, reloj
 
 router = APIRouter()
 
@@ -92,6 +94,103 @@ def yo(socio=Depends(socio_actual)):
     return {k: socio[k] for k in ('id', 'nombre', 'email', 'plan', 'creditos')}
 
 
+PACKS = {'pack-4': {'creditos': 4, 'monto': 1200}, 'pack-8': {'creditos': 8, 'monto': 2200}}
+ESPERA_PAGO = timedelta(minutes=30)
+
+
+def ver_compra(compra):
+    datos = {k: compra[k] for k in ('id', 'pack', 'creditos', 'monto', 'estado', 'creada', 'url_pago')}
+    datos['creada'] = db.a_fecha(compra['creada']).isoformat()
+    return datos
+
+
+def aplicar_estado(compra, estado_pago):
+    """Aplica el estado de un pago (según Cobrá) a una compra. Devuelve la compra actualizada."""
+    nuevo = {'aprobado': 'aprobada', 'rechazado': 'rechazada'}.get(estado_pago)
+    if nuevo and db.cerrar_compra(compra['id'], nuevo) and nuevo == 'aprobada':
+        socio = db.socio(compra['socio_id'])
+        correo.enviar(socio['email'], 'Compra de créditos aprobada',
+                      f"Hola {socio['nombre']}, se acreditaron {compra['creditos']} créditos de tu compra.")
+    return db.compra(compra['id'])
+
+
+class NuevaCompra(BaseModel):
+    pack: str | None = None
+
+
+@router.post('/compras', status_code=201)
+def comprar(datos: NuevaCompra, socio=Depends(socio_actual)):
+    pack = PACKS.get(datos.pack) if datos.pack else None
+    if pack is None:
+        raise HTTPException(422, 'Pack inválido')
+    compra = db.crear_compra(socio['id'], datos.pack, pack['creditos'], pack['monto'], reloj.ahora())
+    try:
+        pago = cobra.crear_pago(pack['monto'], f"pulso-compra-{compra['id']}")
+    except cobra.CobraError:
+        raise HTTPException(502, 'No se pudo crear el pago')
+    db.guardar_pago_compra(compra['id'], pago['id'], pago.get('url_pago'))
+    return ver_compra(db.compra(compra['id']))
+
+
+@router.get('/compras')
+def mis_compras(socio=Depends(socio_actual)):
+    return [ver_compra(c) for c in db.compras_de(socio['id'])]
+
+
+class AvisoPago(BaseModel):
+    pago_id: str = Field(min_length=1)
+
+
+def compra_de_referencia(referencia):
+    m = re.fullmatch(r'pulso-compra-([1-9][0-9]{0,17})', referencia or '')
+    return db.compra(int(m.group(1))) if m else None
+
+
+@router.post('/webhooks/pagos')
+def webhook_pagos(aviso: AvisoPago):
+    try:
+        pago = cobra.obtener_pago(aviso.pago_id)
+    except cobra.CobraError:
+        raise HTTPException(503, 'Cobrá no responde')
+    if pago is None:
+        raise HTTPException(404, 'No existe el pago')
+    compra = compra_de_referencia(pago['referencia'])
+    if compra is None or compra['pago_id'] not in (None, pago['id']):
+        raise HTTPException(404, 'El pago no es de ninguna compra')
+    if compra['pago_id'] is None:
+        db.guardar_pago_compra(compra['id'], pago['id'], pago.get('url_pago'))
+    compra = aplicar_estado(compra, pago['estado'])
+    return {'compra_id': compra['id'], 'estado': compra['estado']}
+
+
+def conciliar(compra):
+    if compra['pago_id']:
+        pago = cobra.obtener_pago(compra['pago_id'])
+    else:
+        pagos = cobra.buscar_por_referencia(f"pulso-compra-{compra['id']}")
+        pago = pagos[0] if pagos else None
+        if pago is None:
+            if reloj.ahora() - db.a_fecha(compra['creada']) >= ESPERA_PAGO:
+                db.cerrar_compra(compra['id'], 'rechazada')
+            return
+        db.guardar_pago_compra(compra['id'], pago['id'], pago.get('url_pago'))
+    if pago is not None:
+        aplicar_estado(compra, pago['estado'])
+
+
+@router.post('/admin/conciliar-pagos', dependencies=[Depends(admin)])
+def conciliar_pagos():
+    resultado = {'aprobadas': 0, 'rechazadas': 0, 'pendientes': 0}
+    clave = {'aprobada': 'aprobadas', 'rechazada': 'rechazadas', 'pendiente': 'pendientes'}
+    for compra in db.compras_pendientes():
+        try:
+            conciliar(compra)
+        except cobra.CobraError:
+            pass
+        resultado[clave[db.compra(compra['id'])['estado']]] += 1
+    return resultado
+
+
 def crear_app():
     db.inicializar()
     app = FastAPI(title='Pulso')
