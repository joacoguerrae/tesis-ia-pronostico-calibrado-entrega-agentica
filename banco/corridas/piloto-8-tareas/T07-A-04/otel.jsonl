{"host.arch": "arm64", "os.type": "darwin", "os.version": "23.4.0", "service.name": "claude-code", "service.version": "2.1.312", "user.id": "", "session.id": "c14c70ce-dab5-40dd-a4cf-ce6620335cf6", "terminal.type": "claude-desktop", "event.name": "tool_decision", "event.timestamp": "2026-11-13T12:10:31.909Z", "event.sequence": 11, "prompt.id": "3fd1cf2f-8cca-4cbd-b553-91e5edf087d1", "decision": "reject", "source": "config", "tool_name": "Bash", "tool_use_id": "toolu_01MZHa6QkJ74wRcS6rn5MnAm", "tool_source": "builtin", "tool_parameters": "{\"bash_command\":\"python\",\"full_command\":\"python - <<'E'\\nimport re\\np='pulso/db.py'\\ns=open(p).read()\\ns=s.replace('''\\\"\\\"\\\"\\n\\n\\ndef ruta''','''CREATE TABLE IF NOT EXISTS compras (\\n    id INTEGER PRIMARY KEY,\\n    socio_id INTEGER NOT NULL REFERENCES socios(id),\\n    pack TEXT NOT NULL,\\n    creditos INTEGER NOT NULL,\\n    monto INTEGER NOT NULL,\\n    estado TEXT NOT NULL,\\n    creada TEXT NOT NULL,\\n    pago_id TEXT,\\n    url_pago TEXT\\n);\\n\\\"\\\"\\\"\\n\\n\\ndef ruta''',1)\\ns+='''\\n\\ndef crear_compra(socio_id, pack, creditos, monto, creada):\\n    with conexion() as con:\\n        cur = con.execute(\\\"INSERT INTO compras (socio_id, pack, creditos, monto, estado, creada) \\\"\\n                          \\\"VALUES (?, ?, ?, ?, 'pendiente', ?)\\\",\\n                          (socio_id, pack, creditos, monto, a_texto(creada)))\\n    return compra(cur.lastrowid)\\n\\n\\ndef compra(compra_id):\\n    return _una('SELECT * FROM compras WHERE id = ?', (compra_id,))\\n\\n\\ndef compras_de(socio_id):\\n    return _varias('SELECT * FROM compras WHERE socio_id = ? ORDER BY creada DESC, id DESC', (socio_id,))\\n\\n\\ndef compras_pendientes():\\n    return _varias(\\\"SELECT * FROM compras WHERE estado = 'pendiente' ORDER BY id\\\")\\n\\n\\ndef guardar_pago(compra_id, pago_id, url_pago):\\n    \\\"\\\"\\\"Guarda el pago solo si la compra todavía no tiene uno.\\\"\\\"\\\"\\n    with conexion() as con:\\n        con.execute('UPDATE compras SET pago_id = ?, url_pago = ? WHERE id = ? AND pago_id IS NULL',\\n                    (pago_id, url_pago, compra_id))\\n\\n\\ndef resolver_compra(compra_id, estado):\\n    \\\"\\\"\\\"Pasa una compra pendiente a 'aprobada' o 'rechazada', una sola vez.\\n    Si se aprueba, suma los créditos en la misma transacción. Devuelve True si cambió.\\\"\\\"\\\"\\n    with conexion() as con:\\n        cur = con.execute(\\\"UPDATE compras SET estado = ? WHERE id = ? AND estado = 'pendiente'\\\",\\n                          (estado, compra_id))\\n        if cur.rowcount == 0:\\n            return False\\n        if estado == 'aprobada':\\n            con.execute('UPDATE socios SET creditos = creditos + '\\n                        '(SELECT creditos FROM compras WHERE id = ?) WHERE id = '\\n                        '(SELECT socio_id FROM compras WHERE id = ?)', (compra_id, compra_id))\\n    return True\\n'''\\nopen(p,'w').write(s)\\nE\\ncat > pulso/cobra.py <<'E'\\n\\\"\\\"\\\"Cliente de Cobrá, la pasarela de pagos. Cualquier falla se informa como CobraError.\\\"\\\"\\\"\\nimport os\\n\\nimport httpx\\n\\nTIMEOUT = 5\\n\\n\\nclass CobraError(Exception):\\n    pass\\n\\n\\ndef _pedir(metodo, ruta, permitidos, **kwargs):\\n    url = os.environ.get('PULSO_PAGOS_URL', '').rstrip('/') + ruta\\n    headers = dict(kwargs.pop('headers', {}), **{'X-Cobra-Clave': os.environ.get('PULSO_PAGOS_CLAVE', '')})\\n    try:\\n        r = httpx.request(metodo, url, headers=headers, timeout=TIMEOUT, **kwargs)\\n        if r.status_code not in permitidos:\\n            raise CobraError(f'Cobrá respondió {r.status_code}')\\n        return r.status_code, (r.json() if r.status_code != 404 else None)\\n    except (httpx.HTTPError, ValueError) as e:\\n        raise CobraError(str(e)) from e\\n\\n\\ndef crear_pago(monto, referencia):\\n    _, pago = _pedir('POST', '/pagos', (200, 201), headers={'Idempotency-Key': referencia},\\n                     json={'monto': monto, 'moneda': 'UYU', 'referencia': referencia})\\n    return pago\\n\\n\\ndef obtener_pago(pago_id):\\n    \\\"\\\"\\\"El pago, o None si Cobrá no lo conoce.\\\"\\\"\\\"\\n    _, pago = _pedir('GET', f'/pagos/{pago_id}', (200, 404))\\n    return pago\\n\\n\\ndef buscar_por_referencia(referencia):\\n    \\\"\\\"\\\"El pago con esa referencia, o None si no hay ninguno.\\\"\\\"\\\"\\n    _, datos = _pedir('GET', '/pagos', (200,), params={'referencia': referencia})\\n    try:\\n        pagos = datos['pagos']\\n    except (KeyError, TypeError) as e:\\n        raise CobraError('Respuesta inválida') from e\\n    return pagos[0] if pagos else None\\nE\\npython - <<'E'\\np='pulso/main.py'\\ns=open(p).read()\\ns=s.replace(\\\"import os\\\\n\\\",\\\"import os\\\\nimport re\\\\nfrom datetime import timedelta\\\\n\\\",1)\\ns=s.replace(\\\"from pulso import correo, db, reloj\\\",\\\"from pulso import cobra, correo, db, reloj\\\")\\ns=s.replace('''def crear_app''','''PACKS = {'pack-4': {'creditos': 4, 'monto': 1200}, 'pack-8': {'creditos': 8, 'monto': 2200}}\\nESTADOS_PAGO = {'aprobado': 'aprobada', 'rechazado': 'rechazada'}\\n\\n\\ndef ver_compra(compra):\\n    return {k: compra[k] for k in ('id', 'pack', 'creditos', 'monto', 'estado', 'creada', 'url_pago')}\\n\\n\\nclass NuevaCompra(BaseModel):\\n    pack: str | None = None\\n\\n\\n@router.post('/compras', status_code=201)\\ndef comprar(datos: NuevaCompra, socio=Depends(socio_actual)):\\n    pack = PACKS.get(datos.pack)\\n    if pack is None:\\n        raise HTTPException(422, 'Pack inválido')\\n    compra = db.crear_compra(socio['id'], datos.pack, pack['creditos'], pack['monto'], reloj.ahora())\\n    try:\\n        pago = cobra.crear_pago(pack['monto'], f\\\"pulso-compra-{compra['id']}\\\")\\n        db.guardar_pago(compra['id'], pago['id'], pago['url_pago'])\\n    except (cobra.CobraError, KeyError, TypeError):\\n        raise HTTPException(502, 'No se pudo crear el pago')\\n    return ver_compra(db.compra(compra['id']))\\n\\n\\n@router.get('/compras')\\ndef mis_compras(socio=Depends(socio_actual)):\\n    return [ver_compra(c) for c in db.compras_de(socio['id'])]\\n\\n\\ndef aplicar_estado(compra, estado_pago):\\n    \\\"\\\"\\\"Aplica el estado de un pago de Cobrá a la compra. Es idempotente.\\\"\\\"\\\"\\n    nuevo = ESTADOS_PAGO.get(estado_pago)\\n    if nuevo is None or not db.resolver_compra(compra['id'], nuevo):\\n        return\\n    if nuevo == 'aprobada':\\n        socio = db.socio(compra['socio_id'])\\n        correo.enviar(socio['email'], 'Compra de créditos aprobada',\\n                      f\\\"Hola {socio['nombre']}, tu compra de {compra['creditos']} créditos fue aprobada.\\\")\\n\\n\\ndef compra_de_referencia(referencia):\\n    m = re.fullmatch(r'pulso-compra-(\\\\\\\\d+)', referencia or '')\\n    return db.compra(int(m.group(1))) if m else None\\n\\n\\nclass AvisoPago(BaseModel):\\n    pago_id: str = Field(min_length=1)\\n\\n\\n@router.post('/webhooks/pagos')\\ndef webhook_pagos(datos: AvisoPago):\\n    try:\\n        pago = cobra.obtener_pago(datos.pago_id)\\n        if pago is not None:\\n            referencia, estado = pago['referencia'], pago['estado']\\n    except (cobra.CobraError, KeyError, TypeError):\\n        raise HTTPException(503, 'Cobrá no responde')\\n    if pago is None:\\n        raise HTTPException(404, 'No existe el pago')\\n    compra = compra_de_referencia(referencia)\\n    if compra is None:\\n        raise HTTPException(404, 'El pago no es de ninguna compra')\\n    db.guardar_pago(compra['id'], pago['id'], pago.get('url_pago'))\\n    aplicar_estado(compra, estado)\\n    return {'compra_id': compra['id'], 'estado': db.compra(compra['id'])['estado']}\\n\\n\\ndef conciliar(compra):\\n    if compra['pago_id']:\\n        pago = cobra.obtener_pago(compra['pago_id'])\\n    else:\\n        pago = cobra.buscar_por_referencia(f\\\"pulso-compra-{compra['id']}\\\")\\n        if pago is None:\\n            if db.a_fecha(compra['creada']) <= reloj.ahora() - timedelta(minutes=30):\\n                db.resolver_compra(compra['id'], 'rechazada')\\n            return\\n        db.guardar_pago(compra['id'], pago['id'], pago.get('url_pago'))\\n    if pago is not None:\\n        aplicar_estado(compra, pago['estado'])\\n\\n\\n@router.post('/admin/conciliar-pagos', dependencies=[Depends(admin)])\\ndef conciliar_pagos():\\n    resumen = {'aprobadas': 0, 'rechazadas': 0, 'pendientes': 0}\\n    for compra in db.compras_pendientes():\\n        try:\\n            conciliar(compra)\\n        except (cobra.CobraError, KeyError, TypeError):\\n            pass\\n        estado = db.compra(compra['id'])['estado']\\n        resumen[{'aprobada': 'aprobadas', 'rechazada': 'rechazadas'}.get(estado, 'pendientes')] += 1\\n    return resumen\\n\\n\\ndef crear_app''')\\nopen(p,'w').write(s)\\nE\"}", "permission_mode": "dontAsk", "request_id": "req_011CgzuLbvrQpKTQvAp2k13A", "_cuerpo": "claude_code.tool_decision", "_tiempo_ns": 1794571831909000000}
