+    con = sqlite3.connect(ruta(), timeout=60)
     con.row_factory = sqlite3.Row
     con.execute('PRAGMA foreign_keys = ON')
     try:
@@ -58,6 +58,26 @@ def conexion():
 def inicializar():
     with conexion() as con:
         con.executescript(ESQUEMA)
+        try:
+            con.execute("CREATE UNIQUE INDEX IF NOT EXISTS reservas_unica_confirmada "
+                        "ON reservas (socio_id, clase_id) WHERE estado = 'confirmada'")
+        except sqlite3.IntegrityError:
+            pass  # base con duplicados previos: la regla igual se verifica en transaccion_inmediata
+
+
+@contextmanager
+def transaccion_inmediata():
+    """Conexión con la escritura reservada desde el inicio: serializa entre pedidos y procesos.
+    Si adentro se lanza una excepción, se deshace todo."""
+    con = sqlite3.connect(ruta(), timeout=60)
+    con.row_factory = sqlite3.Row
+    con.execute('PRAGMA foreign_keys = ON')
+    try:
+        con.execute('BEGIN IMMEDIATE')
+        yield con
+        con.commit()
+    finally:
+        con.close()
 
 
