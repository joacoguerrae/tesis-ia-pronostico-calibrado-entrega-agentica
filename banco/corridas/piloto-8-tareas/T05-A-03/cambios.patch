--- a/pulso/db.py
+++ b/pulso/db.py
@@ -58,6 +58,9 @@ def conexion():
 def inicializar():
     with conexion() as con:
         con.executescript(ESQUEMA)
+        columnas = [f['name'] for f in con.execute('PRAGMA table_info(reservas)')]
+        if 'recordatorio' not in columnas:
+            con.execute('ALTER TABLE reservas ADD COLUMN recordatorio TEXT')
 
 
 def a_texto(momento):
@@ -136,3 +139,18 @@ def sumar_creditos(socio_id, cantidad):
 
 def correos():
     return _varias('SELECT * FROM correos ORDER BY id')
+
+
+def reservas_por_recordar(desde, hasta):
+    """Reservas confirmadas sin recordatorio cuya clase empieza en (desde, hasta]."""
+    return _varias("SELECT r.id, r.socio_id, r.clase_id FROM reservas r JOIN clases c ON c.id = r.clase_id "
+                   "WHERE r.estado = 'confirmada' AND r.recordatorio IS NULL AND c.inicio > ? AND c.inicio <= ? "
+                   "ORDER BY c.inicio, r.id", (a_texto(desde), a_texto(hasta)))
+
+
+def marcar_recordada(reserva_id, momento):
+    """Marca la reserva como recordada. Devuelve False si ya lo estaba."""
+    with conexion() as con:
+        cur = con.execute('UPDATE reservas SET recordatorio = ? WHERE id = ? AND recordatorio IS NULL',
+                          (a_texto(momento), reserva_id))
+    return cur.rowcount == 1
diff --git a/pulso/main.py b/pulso/main.py
index 039212d..4e99123 100644
--- a/pulso/main.py
+++ b/pulso/main.py
@@ -1,4 +1,5 @@
 import os
+from datetime import timedelta
 
 from fastapi import APIRouter, Depends, FastAPI, Header, HTTPException
 from pydantic import AwareDatetime, BaseModel, Field
@@ -92,6 +93,23 @@ def yo(socio=Depends(socio_actual)):
     return {k: socio[k] for k in ('id', 'nombre', 'email', 'plan', 'creditos')}
 
 
+@router.post('/admin/recordatorios', dependencies=[Depends(admin)])
+def enviar_recordatorios():
+    ahora = reloj.ahora()
+    enviados = 0
+    for r in db.reservas_por_recordar(ahora, ahora + timedelta(hours=24)):
+        if not db.marcar_recordada(r['id'], ahora):
+            continue
+        socio = db.socio(r['socio_id'])
+        clase = db.clase(r['clase_id'])
+        inicio = db.a_fecha(clase['inicio'])
+        correo.enviar(socio['email'], f"Recordatorio: {clase['nombre']} el {correo.fecha_y_hora(inicio)}",
+                      f"Hola {socio['nombre']}, te recordamos tu clase de {clase['nombre']} "
+                      f"con {clase['instructor']}. ¡Te esperamos!")
+        enviados += 1
+    return {'enviados': enviados}
+
+
 def crear_app():
     db.inicializar()
     app = FastAPI(title='Pulso')
