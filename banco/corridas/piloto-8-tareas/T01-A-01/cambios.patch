diff --git a/tests/test_cancelar.py b/tests/test_cancelar.py
new file mode 100644
index 0000000..0ec878b
--- /dev/null
+++ b/tests/test_cancelar.py
@@ -0,0 +1,66 @@
+from datetime import timedelta
+
+from conftest import AHORA, auth
+from pulso import db, reloj
+
+
+def reservar(cliente, socio, clase):
+    return cliente.post('/reservas', json={'clase_id': clase['id']}, headers=auth(socio)).json()
+
+
+def cancelar(cliente, socio, reserva_id):
+    return cliente.post(f'/reservas/{reserva_id}/cancelar', headers=auth(socio))
+
+
+def test_cancela_con_anticipacion_devuelve_credito(cliente, socio):
+    clase = db.crear_clase('Yoga', 'Sofía', AHORA + timedelta(hours=2))
+    res = reservar(cliente, socio, clase)
+    r = cancelar(cliente, socio, res['id'])
+    assert r.status_code == 200
+    assert r.json() == {'id': res['id'], 'clase_id': clase['id'], 'estado': 'cancelada',
+                        'creada': res['creada'], 'credito_devuelto': True}
+    assert cliente.get('/yo', headers=auth(socio)).json()['creditos'] == 8
+    assert cliente.get(f"/clases/{clase['id']}").json()['lugares_libres'] == 20
+
+
+def test_cancela_tarde_sin_credito(cliente, socio):
+    clase = db.crear_clase('Yoga', 'Sofía', AHORA + timedelta(hours=1, minutes=59))
+    res = reservar(cliente, socio, clase)
+    r = cancelar(cliente, socio, res['id'])
+    assert r.status_code == 200
+    assert r.json()['credito_devuelto'] is False
+    assert cliente.get('/yo', headers=auth(socio)).json()['creditos'] == 7
+    assert cliente.get(f"/clases/{clase['id']}").json()['lugares_libres'] == 20
+
+
+def test_no_cancela_dos_veces(cliente, socio):
+    clase = db.crear_clase('Yoga', 'Sofía', AHORA + timedelta(hours=5))
+    res = reservar(cliente, socio, clase)
+    assert cancelar(cliente, socio, res['id']).status_code == 200
+    assert cancelar(cliente, socio, res['id']).status_code == 409
+    assert cliente.get('/yo', headers=auth(socio)).json()['creditos'] == 8
+
+
+def test_no_cancela_clase_empezada(cliente, socio):
+    clase = db.crear_clase('Yoga', 'Sofía', AHORA + timedelta(hours=5))
+    res = reservar(cliente, socio, clase)
+    reloj.fijar(AHORA + timedelta(hours=5))
+    assert cancelar(cliente, socio, res['id']).status_code == 409
+
+
+def test_ajena_o_inexistente_404(cliente, socio):
+    clase = db.crear_clase('Yoga', 'Sofía', AHORA + timedelta(hours=5))
+    res = reservar(cliente, socio, clase)
+    otro = db.crear_socio('Juan Gómez', 'juan@example.com')
+    assert cancelar(cliente, otro, res['id']).status_code == 404
+    assert cancelar(cliente, socio, 999).status_code == 404
+    assert cliente.post(f"/reservas/{res['id']}/cancelar").status_code == 401
+
+
+def test_sigue_en_listado_y_se_puede_reservar_de_nuevo(cliente, socio):
+    clase = db.crear_clase('Yoga', 'Sofía', AHORA + timedelta(hours=5), cupo=1)
+    res = reservar(cliente, socio, clase)
+    cancelar(cliente, socio, res['id'])
+    lista = cliente.get('/reservas', headers=auth(socio)).json()
+    assert [(x['id'], x['estado']) for x in lista] == [(res['id'], 'cancelada')]
+    assert cliente.post('/reservas', json={'clase_id': clase['id']}, headers=auth(socio)).status_code == 201
