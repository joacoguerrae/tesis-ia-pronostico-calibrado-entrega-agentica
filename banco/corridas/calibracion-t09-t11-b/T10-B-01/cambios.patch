+@contextmanager
+def transaccion():
+    """Transacción de escritura: toma el lock de la base antes de leer, así que lo que se lee
+    no cambia hasta el commit (vale entre procesos). Si el bloque lanza una excepción, no queda nada."""
+    con = sqlite3.connect(ruta(), timeout=ESPERA_S, isolation_level=None)
+    con.row_factory = sqlite3.Row
+    con.execute('PRAGMA foreign_keys = ON')
+    try:
+        con.execute('BEGIN IMMEDIATE')
+        yield con
+        con.execute('COMMIT')
+    except BaseException:
+        if con.in_transaction:
+            con.execute('ROLLBACK')
+        raise
+    finally:
+        con.close()
+
+
 def inicializar():
