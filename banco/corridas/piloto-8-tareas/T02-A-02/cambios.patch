--- a/pulso/main.py
+++ b/pulso/main.py
@@ -1,6 +1,8 @@
 import os
+import re
+from datetime import date
 
-from fastapi import APIRouter, Depends, FastAPI, Header, HTTPException
+from fastapi import APIRouter, Depends, FastAPI, Header, HTTPException, Query, Response
 from pydantic import AwareDatetime, BaseModel, Field
 
 from pulso import correo, db, reloj
@@ -30,10 +32,50 @@ def ver_reserva(reserva):
     return {k: reserva[k] for k in ('id', 'clase_id', 'estado', 'creada')}
 
 
+def parsear_dia(texto, nombre):
+    if texto is None:
+        return None
+    if not re.fullmatch(r'\d{4}-\d{2}-\d{2}', texto):
+        raise HTTPException(422, f'{nombre} debe tener formato YYYY-MM-DD')
+    try:
+        return date.fromisoformat(texto)
+    except ValueError:
+        raise HTTPException(422, f'{nombre} no es una fecha válida')
+
+
 @router.get('/clases')
-def listar_clases():
+def listar_clases(response: Response,
+                  desde: str | None = None,
+                  hasta: str | None = None,
+                  instructor: str | None = None,
+                  con_lugar: bool = False,
+                  pagina: int = Query(default=1, ge=1),
+                  por_pagina: int = Query(default=20, ge=1, le=50)):
+    dia_desde = parsear_dia(desde, 'desde')
+    dia_hasta = parsear_dia(hasta, 'hasta')
+    if dia_desde and dia_hasta and dia_desde > dia_hasta:
+        raise HTTPException(422, 'desde no puede ser posterior a hasta')
     ahora = reloj.ahora()
-    return [ver_clase(c) for c in db.clases() if db.a_fecha(c['inicio']) > ahora]
+    filtradas = []
+    for c in db.clases():
+        inicio = db.a_fecha(c['inicio'])
+        if inicio <= ahora:
+            continue
+        dia = inicio.astimezone(reloj.MONTEVIDEO).date()
+        if dia_desde and dia < dia_desde:
+            continue
+        if dia_hasta and dia > dia_hasta:
+            continue
+        if instructor is not None and c['instructor'].casefold() != instructor.casefold():
+            continue
+        filtradas.append(c)
+    if con_lugar:
+        vistas = [ver_clase(c) for c in filtradas]
+        vistas = [c for c in vistas if c['lugares_libres'] > 0]
+        response.headers['X-Total'] = str(len(vistas))
+        return vistas[(pagina - 1) * por_pagina:pagina * por_pagina]
+    response.headers['X-Total'] = str(len(filtradas))
+    return [ver_clase(c) for c in filtradas[(pagina - 1) * por_pagina:pagina * por_pagina]]
 
 
 @router.get('/clases/{clase_id}')
