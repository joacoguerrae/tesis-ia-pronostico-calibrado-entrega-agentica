+from pulso import beneficios, correo, db, reloj
 
 router = APIRouter()
 
@@ -92,6 +92,50 @@ def yo(socio=Depends(socio_actual)):
     return {k: socio[k] for k in ('id', 'nombre', 'email', 'plan', 'creditos')}
 
 
+class Convenio(BaseModel):
+    empresa: str
+
+
+@router.post('/convenio')
+def activar_convenio(datos: Convenio, socio=Depends(socio_actual)):
+    empresa = datos.empresa.strip()
+    if not empresa:
+        raise HTTPException(422, 'Falta la empresa')
+    if socio['plan'] == 'corporativo':
+        raise HTTPException(409, 'Ya tenés el plan corporativo')
+    resultado = beneficios.consultar(empresa, socio['email'])
+    if resultado == beneficios.FALLA:
+        raise HTTPException(503, 'El servicio de beneficios no está disponible')
+    if resultado == beneficios.EMPRESA_DESCONOCIDA:
+        raise HTTPException(404, 'No existe la empresa')
+    if resultado != beneficios.ACTIVO:
+        raise HTTPException(409, 'No figurás como empleado activo de la empresa')
+    if not db.activar_corporativo(socio['id'], empresa, 12):
+        raise HTTPException(409, 'Ya tenés el plan corporativo')
+    correo.enviar(socio['email'], 'Ya tenés el plan corporativo',
+                  f"Hola {socio['nombre']}, tu plan corporativo con {empresa} está activo.")
+    return {'plan': 'corporativo', 'empresa': empresa, 'creditos': db.socio(socio['id'])['creditos']}
+
+
+@router.post('/admin/revalidar-convenios', dependencies=[Depends(admin)])
+def revalidar_convenios():
+    siguen = bajaron = sin_revisar = 0
+    for s in db.corporativos():
+        empresa = s['empresa_convenio']
+        resultado = beneficios.consultar(empresa, s['email']) if empresa else beneficios.FALLA
+        if resultado == beneficios.FALLA:
+            sin_revisar += 1
+        elif resultado == beneficios.ACTIVO:
+            siguen += 1
+        else:
+            if db.bajar_a_basico(s['id'], empresa):
+                correo.enviar(s['email'], 'Se terminó tu plan corporativo',
+                              f"Hola {s['nombre']}, tu plan corporativo con {empresa} terminó. "
+                              'Seguís con el plan básico y conservás tus créditos.')
+            bajaron += 1
+    return {'siguen': siguen, 'bajaron': bajaron, 'sin_revisar': sin_revisar}
+
+
