diff --git a/tests/test_base.py b/tests/test_base.py
index 5d9460b..9c39a32 100644
--- a/tests/test_base.py
+++ b/tests/test_base.py
@@ -1,8 +1,108 @@
 from datetime import timedelta
 
+import pytest
+
 from conftest import ADMIN, AHORA, auth
 from pulso import db
 
+DATOS_SOCIO = {'nombre': 'Ana Pérez', 'email': 'Ana.Perez@Example.com', 'plan': 'premium'}
+
+
+def test_registro_sin_auth_devuelve_socio_normalizado(cliente):
+    r = cliente.post('/socios', json=DATOS_SOCIO)
+    assert r.status_code == 201
+    cuerpo = r.json()
+    assert set(cuerpo) == {'id', 'nombre', 'email', 'plan', 'creditos', 'token'}
+    assert cuerpo['nombre'] == 'Ana Pérez'
+    assert cuerpo['email'] == 'ana.perez@example.com'
+    assert cuerpo['plan'] == 'premium'
+    assert cuerpo['creditos'] == 20
+    assert len(cuerpo['token']) >= 32
+
+
+def test_creditos_iniciales_segun_plan(cliente):
+    basico = cliente.post('/socios', json={**DATOS_SOCIO, 'plan': 'basico', 'email': 'b@example.com'}).json()
+    premium = cliente.post('/socios', json={**DATOS_SOCIO, 'email': 'p@example.com'}).json()
+    assert basico['creditos'] == 8
+    assert premium['creditos'] == 20
+
+
+def test_token_sirve_para_autenticarse_y_es_unico(cliente):
+    primero = cliente.post('/socios', json=DATOS_SOCIO).json()
+    segundo = cliente.post('/socios', json={**DATOS_SOCIO, 'email': 'otra@example.com'}).json()
+    assert primero['token'] != segundo['token']
+    r = cliente.get('/yo', headers={'Authorization': f"Bearer {primero['token']}"})
+    assert r.status_code == 200
+    assert r.json()['email'] == 'ana.perez@example.com'
+
+
+def test_registro_envia_correo_de_bienvenida(cliente):
+    cliente.post('/socios', json=DATOS_SOCIO)
+    [enviado] = db.correos()
+    assert enviado['para'] == 'ana.perez@example.com'
+    assert enviado['asunto'] == 'Te damos la bienvenida a Pulso'
+
+
+@pytest.mark.parametrize('nombre, esperado', [
+    ('  Al  ', 'Al'),
+    ('Ana', 'Ana'),
+    ('A' * 80, 'A' * 80),
+])
+def test_nombre_se_recorta_y_acepta_largos_validos(cliente, nombre, esperado):
+    r = cliente.post('/socios', json={**DATOS_SOCIO, 'nombre': nombre})
+    assert r.status_code == 201
+    assert r.json()['nombre'] == esperado
+
+
+@pytest.mark.parametrize('nombre', ['', ' ', 'A', '  A  ', 'A' * 81, None, 123])
+def test_nombre_invalido_da_422(cliente, nombre):
+    assert cliente.post('/socios', json={**DATOS_SOCIO, 'nombre': nombre}).status_code == 422
+
+
+@pytest.mark.parametrize('email', [
+    'ana perez@example.com',
+    'ana@@example.com',
+    'ana@exa@mple.com',
+    'ana.example.com',
+    '@example.com',
+    'ana@example',
+    'ana@.example.com',
+    'ana@example.com.',
+    'ana@',
+    '',
+    None,
+])
+def test_email_invalido_da_422(cliente, email):
+    assert cliente.post('/socios', json={**DATOS_SOCIO, 'email': email}).status_code == 422
+
+
+def test_email_con_espacios_en_los_extremos_se_acepta(cliente):
+    r = cliente.post('/socios', json={**DATOS_SOCIO, 'email': '  ANA@Example.com  '})
+    assert r.status_code == 201
+    assert r.json()['email'] == 'ana@example.com'
+
+
+@pytest.mark.parametrize('plan', ['gold', 'Premium', '', None])
+def test_plan_invalido_da_422(cliente, plan):
+    assert cliente.post('/socios', json={**DATOS_SOCIO, 'plan': plan}).status_code == 422
+
+
+@pytest.mark.parametrize('faltante', ['nombre', 'email', 'plan'])
+def test_falta_un_dato_da_422(cliente, faltante):
+    datos = {k: v for k, v in DATOS_SOCIO.items() if k != faltante}
+    assert cliente.post('/socios', json=datos).status_code == 422
