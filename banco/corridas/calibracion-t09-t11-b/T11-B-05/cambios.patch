+def inicios_de_serie(dia, hora, desde, hasta, ahora):
+    """Inicios (en Montevideo) de las clases de una serie, sin los días cerrados ni los que ya pasaron."""
+    inicios = []
+    dia_actual = desde
+    while dia_actual <= hasta:
+        if dia_actual.weekday() == DIAS.index(dia) and dia_actual not in DIAS_CERRADO:
+            inicio = datetime.combine(dia_actual, hora_de(hora), tzinfo=reloj.MONTEVIDEO)
+            if inicio > ahora:
+                inicios.append(inicio)
+        dia_actual += timedelta(days=1)
+    return inicios
+
