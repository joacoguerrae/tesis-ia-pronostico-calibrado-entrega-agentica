diff --git a/tests/test_cancelar.py b/tests/test_cancelar.py
new file mode 100644
index 0000000..25a8d76
--- /dev/null
+++ b/tests/test_cancelar.py
@@ -0,0 +1,104 @@
+import sqlite3
+from datetime import timedelta
+
+from fastapi.testclient import TestClient
+
+from conftest import ADMIN, AHORA, auth
+from pulso import db, reloj
+from pulso.main import crear_app
+
+
+def test_cancelar_clase_suelta_libera_reservas_y_avisa(cliente, socio):
+    # Mañana 11/11 a las 19:00 de Montevideo (22:00 UTC).
+    clase = db.crear_clase('Yoga', 'Sofía', AHORA + timedelta(days=1, hours=7))
+    assert cliente.post('/reservas', json={'clase_id': clase['id']}, headers=auth(socio)).status_code == 201
+    assert cliente.get('/yo', headers=auth(socio)).json()['creditos'] == 7
+
+    r = cliente.post(f"/admin/clases/{clase['id']}/cancelar", headers=ADMIN)
+    assert r.status_code == 200
+    assert r.json()['estado'] == 'cancelada'
+    assert r.json()['lugares_libres'] == 20
+    assert cliente.get('/yo', headers=auth(socio)).json()['creditos'] == 8
+    assert [x['estado'] for x in cliente.get('/reservas', headers=auth(socio)).json()] == ['cancelada']
+
+    [_confirmacion, aviso] = db.correos()
+    assert aviso['para'] == 'ana@example.com'
+    assert aviso['asunto'] == 'Clase cancelada: Yoga el 11/11 a las 19:00'
+
+
+def test_clase_cancelada_sale_de_la_lista_pero_no_del_detalle(cliente):
+    clase = db.crear_clase('Yoga', 'Sofía', AHORA + timedelta(days=1))
+    cliente.post(f"/admin/clases/{clase['id']}/cancelar", headers=ADMIN)
+    assert cliente.get('/clases').json() == []
+    r = cliente.get(f"/clases/{clase['id']}")
+    assert r.status_code == 200
+    assert r.json()['estado'] == 'cancelada'
+
+
+def test_no_se_puede_reservar_una_clase_cancelada(cliente, socio):
+    clase = db.crear_clase('Yoga', 'Sofía', AHORA + timedelta(days=1))
+    cliente.post(f"/admin/clases/{clase['id']}/cancelar", headers=ADMIN)
+    r = cliente.post('/reservas', json={'clase_id': clase['id']}, headers=auth(socio))
+    assert r.status_code == 409
+    assert r.json()['detail'] == 'La clase está cancelada'
+
+
+def test_cancelar_dos_veces_da_409(cliente):
+    clase = db.crear_clase('Yoga', 'Sofía', AHORA + timedelta(days=1))
+    cliente.post(f"/admin/clases/{clase['id']}/cancelar", headers=ADMIN)
+    r = cliente.post(f"/admin/clases/{clase['id']}/cancelar", headers=ADMIN)
+    assert r.status_code == 409
+    assert db.correos() == []
+
+
+def test_cancelar_clase_ya_empezada_da_409(cliente):
+    clase = db.crear_clase('Yoga', 'Sofía', AHORA - timedelta(minutes=1))
+    r = cliente.post(f"/admin/clases/{clase['id']}/cancelar", headers=ADMIN)
+    assert r.status_code == 409
+    assert cliente.get(f"/clases/{clase['id']}").json()['estado'] == 'programada'
+
+
+def test_cancelar_clase_inexistente_da_404(cliente):
+    assert cliente.post('/admin/clases/999/cancelar', headers=ADMIN).status_code == 404
+
+
+def test_cancelar_sin_clave_da_401(cliente):
+    clase = db.crear_clase('Yoga', 'Sofía', AHORA + timedelta(days=1))
+    assert cliente.post(f"/admin/clases/{clase['id']}/cancelar").status_code == 401
+
+
+def test_cancelar_una_clase_de_serie_no_toca_las_demas(cliente):
+    serie = cliente.post('/admin/series', headers=ADMIN, json={
+        'nombre': 'Yoga', 'instructor': 'Sofía', 'dia': 'martes', 'hora': '19:00', 'duracion_min': 60,
+        'cupo': 15, 'desde': '2026-11-10', 'hasta': '2026-11-24'}).json()
+    cliente.post(f"/admin/clases/{serie['clases'][1]['id']}/cancelar", headers=ADMIN)
+    estados = [c['estado'] for c in cliente.get(f"/admin/series/{serie['id']}", headers=ADMIN).json()['clases']]
+    assert estados == ['programada', 'cancelada', 'programada']
+    assert len(cliente.get('/clases').json()) == 2
+
+
+def test_base_vieja_se_migra_sin_perder_clases(tmp_path, monkeypatch):
+    ruta = tmp_path / 'vieja.db'
+    monkeypatch.setenv('PULSO_DB', str(ruta))
+    monkeypatch.setenv('PULSO_ADMIN_KEY', ADMIN['X-Admin-Key'])
+    # Tabla de clases con el esquema anterior: sin serie_id ni estado.
+    con = sqlite3.connect(ruta)
+    con.executescript("""
+        CREATE TABLE clases (id INTEGER PRIMARY KEY, nombre TEXT NOT NULL, instructor TEXT NOT NULL,
+            inicio TEXT NOT NULL, duracion_min INTEGER NOT NULL, cupo INTEGER NOT NULL);
+        INSERT INTO clases (nombre, instructor, inicio, duracion_min, cupo)
+            VALUES ('Yoga', 'Sofía', '2026-11-11T22:00:00+00:00', 60, 20);
+    """)
+    con.commit()
+    con.close()
+
+    reloj.fijar(AHORA)
+    try:
+        cliente = TestClient(crear_app())
+        [clase] = cliente.get('/clases').json()
+        assert clase['serie_id'] is None and clase['estado'] == 'programada'
+        assert cliente.post('/admin/series', headers=ADMIN, json={
+            'nombre': 'Yoga', 'instructor': 'Sofía', 'dia': 'martes', 'hora': '19:00', 'duracion_min': 60,
+            'cupo': 15, 'desde': '2026-11-10', 'hasta': '2026-11-10'}).status_code == 201
+    finally:
+        reloj.fijar(None)
diff --git a/tests/test_series.py b/tests/test_series.py
new file mode 100644
index 0000000..b1e5e37
--- /dev/null
+++ b/tests/test_series.py
@@ -0,0 +1,257 @@
+from datetime import datetime, timedelta, timezone
+
+from conftest import ADMIN, AHORA
+from pulso import db, reloj
+
+# AHORA es martes 10/11/2026 12:00 en Montevideo (15:00 UTC).
+SERIE_YOGA = {'nombre': 'Yoga', 'instructor': 'Sofía', 'dia': 'martes', 'hora': '19:00', 'duracion_min': 60,
+              'cupo': 15, 'desde': '2026-11-10', 'hasta': '2026-12-31'}
+
+
+def crear(cliente, **cambios):
+    datos = dict(SERIE_YOGA, **cambios)
+    return cliente.post('/admin/series', json=datos, headers=ADMIN)
+
+
+def inicios(serie):
+    return [c['inicio'] for c in serie['clases']]
+
+
+def test_crea_una_clase_por_semana_en_hora_de_montevideo(cliente):
+    r = crear(cliente)
+    assert r.status_code == 201
+    serie = r.json()
+    assert {k: serie[k] for k in ('nombre', 'instructor', 'dia', 'hora', 'duracion_min', 'cupo', 'desde', 'hasta')} == {
+        'nombre': 'Yoga', 'instructor': 'Sofía', 'dia': 'martes', 'hora': '19:00', 'duracion_min': 60,
+        'cupo': 15, 'desde': '2026-11-10', 'hasta': '2026-12-31'}
+    # Martes del 10/11 al 29/12: 8 clases. 19:00 de Montevideo son las 22:00 UTC.
+    assert len(serie['clases']) == 8
+    primera = serie['clases'][0]
+    assert {k: primera[k] for k in ('nombre', 'instructor', 'inicio', 'duracion_min', 'cupo', 'lugares_libres',
+                                    'serie_id', 'estado')} == {
+        'nombre': 'Yoga', 'instructor': 'Sofía', 'inicio': '2026-11-10T22:00:00+00:00', 'duracion_min': 60,
+        'cupo': 15, 'lugares_libres': 15, 'serie_id': serie['id'], 'estado': 'programada'}
+    assert inicios(serie) == sorted(inicios(serie))
+
+
+def test_clases_de_serie_aparecen_en_get_clases_con_serie_id(cliente):
+    serie = crear(cliente).json()
+    lista = cliente.get('/clases').json()
+    assert len(lista) == 8
+    assert all(c['serie_id'] == serie['id'] and c['estado'] == 'programada' for c in lista)
+
+
+def test_clase_suelta_tiene_serie_null_y_programada(cliente):
+    db.crear_clase('Pilates', 'Marta', AHORA + timedelta(days=1))
+    [clase] = cliente.get('/clases').json()
+    assert clase['serie_id'] is None
+    assert clase['estado'] == 'programada'
+
+
+def test_no_crea_clases_en_dias_cerrados(cliente):
+    # Viernes 18/12/2026 a viernes 08/01/2027: 25/12 y 01/01 son feriados de cierre.
+    serie = crear(cliente, dia='viernes', hora='10:00', desde='2026-12-18', hasta='2027-01-08').json()
+    assert inicios(serie) == ['2026-12-18T13:00:00+00:00', '2027-01-08T13:00:00+00:00']
+
+
+def test_no_crea_clases_que_ya_empezaron(cliente):
+    # Martes 10/11 a las 10:00 de Montevideo ya pasó (son las 12:00 de hoy).
+    serie = crear(cliente, hora='10:00', hasta='2026-11-17').json()
+    assert inicios(serie) == ['2026-11-17T13:00:00+00:00']
+
+
+def test_clase_que_empieza_justo_ahora_no_se_crea(cliente):
+    reloj_ahora = AHORA.astimezone(timezone(timedelta(hours=-3)))
+    serie = crear(cliente, hora=f'{reloj_ahora:%H:%M}', desde='2026-11-10', hasta='2026-11-10').json()
+    assert serie['clases'] == []
+
+
+def test_serie_sin_clases_es_valida(cliente):
+    r = crear(cliente, dia='domingo', desde='2026-11-10', hasta='2026-11-12')
+    assert r.status_code == 201
+    assert r.json()['clases'] == []
+
+
+def test_admin_clave_para_series(cliente):
+    assert cliente.post('/admin/series', json=SERIE_YOGA).status_code == 401
+    assert cliente.post('/admin/series', json=SERIE_YOGA, headers={'X-Admin-Key': 'otra'}).status_code == 401
+    assert cliente.get('/admin/series/1').status_code == 401
+    assert cliente.patch('/admin/series/1', json={'desde_clase_id': 1, 'cupo': 3}).status_code == 401
+    assert cliente.post('/admin/clases/1/cancelar').status_code == 401
+
+
+def test_422_sin_crear_nada(cliente):
+    malos = [
+        {'dia': 'Martes'}, {'dia': 'sabado'}, {'dia': 'lunes ', 'hora': '19:00'}, {'dia': None},
+        {'hora': '7:00'}, {'hora': '24:00'}, {'hora': '23:60'}, {'hora': '19:00\n'}, {'hora': '1900'},
+        {'nombre': ''}, {'nombre': '   '}, {'instructor': ''},
+        {'duracion_min': 0}, {'cupo': 0},
+        {'desde': '2026-12-31', 'hasta': '2026-11-10'},
+        {'desde': '2026-01-01', 'hasta': '2027-12-31'},
+        {'desde': None},
+        {'hasta': None},
+    ]
+    for cambios in malos:
+        assert crear(cliente, **cambios).status_code == 422, cambios
+    sin_campo = {k: v for k, v in SERIE_YOGA.items() if k != 'cupo'}
+    assert cliente.post('/admin/series', json=sin_campo, headers=ADMIN).status_code == 422
+    assert db.clases() == []
+
+
+def test_rango_de_366_dias_se_acepta_y_367_no(cliente):
+    assert crear(cliente, desde='2026-11-10', hasta='2027-11-11').status_code == 201
+    assert crear(cliente, desde='2026-11-10', hasta='2027-11-12').status_code == 422
+
+
+def test_get_serie_incluye_canceladas_y_404(cliente):
+    serie = crear(cliente).json()
+    cliente.post(f"/admin/clases/{serie['clases'][1]['id']}/cancelar", headers=ADMIN)
+    r = cliente.get(f"/admin/series/{serie['id']}", headers=ADMIN)
+    assert r.status_code == 200
+    assert len(r.json()['clases']) == 8
+    assert r.json()['clases'][1]['estado'] == 'cancelada'
+    assert cliente.get('/admin/series/999', headers=ADMIN).status_code == 404
+
+
+def test_patch_cambia_hora_desde_una_clase_y_avisa_a_los_socios(cliente):
+    serie = crear(cliente).json()
+    clases = serie['clases']
+    ana = db.crear_socio('Ana Pérez', 'ana@example.com')
+    juan = db.crear_socio('Juan Gómez', 'juan@example.com')
+    db.crear_reserva(ana['id'], clases[2]['id'], AHORA)
+    db.crear_reserva(juan['id'], clases[3]['id'], AHORA)
+    db.crear_reserva(juan['id'], clases[4]['id'], AHORA, estado='cancelada')
+
+    r = cliente.patch(f"/admin/series/{serie['id']}", json={'desde_clase_id': clases[2]['id'], 'hora': '20:00'},
+                      headers=ADMIN)
+    assert r.status_code == 200
+    nueva = r.json()
+    assert nueva['hora'] == '20:00'
+    antes, despues = nueva['clases'][:2], nueva['clases'][2:]
+    assert [c['inicio'] for c in antes] == [c['inicio'] for c in clases[:2]]
+    # 20:00 de Montevideo son las 23:00 UTC, mismo día.
+    assert [c['inicio'] for c in despues] == [c['inicio'][:11] + '23:00:00+00:00' for c in clases[2:]]
+    assert [c['id'] for c in nueva['clases']] == [c['id'] for c in clases]
+
+    asuntos = [(m['para'], m['asunto']) for m in db.correos()]
+    assert asuntos == [
+        ('ana@example.com', 'Cambio de horario: Yoga el 24/11 a las 20:00'),
+        ('juan@example.com', 'Cambio de horario: Yoga el 01/12 a las 20:00'),
+    ]
+    # La clase conserva sus reservas.
+    assert cliente.get(f"/clases/{clases[2]['id']}").json()['lugares_libres'] == 14
+
+
+def test_cambio_de_instructor_y_cupo_no_manda_correos(cliente):
+    serie = crear(cliente).json()
+    socio = db.crear_socio('Ana Pérez', 'ana@example.com')
+    db.crear_reserva(socio['id'], serie['clases'][0]['id'], AHORA)
+    r = cliente.patch(f"/admin/series/{serie['id']}",
+                      json={'desde_clase_id': serie['clases'][0]['id'], 'instructor': 'Leo', 'cupo': 20},
+                      headers=ADMIN)
+    assert r.status_code == 200
+    assert r.json()['instructor'] == 'Leo' and r.json()['cupo'] == 20
+    assert all(c['instructor'] == 'Leo' and c['cupo'] == 20 for c in r.json()['clases'])
+    assert db.correos() == []
+
+
+def test_patch_no_toca_clases_canceladas(cliente):
+    serie = crear(cliente).json()
+    cancelada = serie['clases'][3]
+    cliente.post(f"/admin/clases/{cancelada['id']}/cancelar", headers=ADMIN)
+    r = cliente.patch(f"/admin/series/{serie['id']}", json={'desde_clase_id': serie['clases'][1]['id'], 'hora': '21:00'},
+                      headers=ADMIN).json()
+    fila = next(c for c in r['clases'] if c['id'] == cancelada['id'])
+    assert fila['estado'] == 'cancelada'
+    assert fila['inicio'] == cancelada['inicio']
+
+
+def test_patch_desde_clase_cancelada_no_la_cambia(cliente):
+    serie = crear(cliente).json()
+    primera = serie['clases'][0]
+    cliente.post(f"/admin/clases/{primera['id']}/cancelar", headers=ADMIN)
+    r = cliente.patch(f"/admin/series/{serie['id']}", json={'desde_clase_id': primera['id'], 'cupo': 9},
+                      headers=ADMIN).json()
+    assert r['clases'][0]['cupo'] == 15 and r['clases'][0]['estado'] == 'cancelada'
+    assert r['clases'][1]['cupo'] == 9
+
+
+def test_patch_recuerda_instructor_propio_de_cada_clase(cliente):
+    serie = crear(cliente).json()
+    clases = serie['clases']
+    cliente.patch(f"/admin/series/{serie['id']}", json={'desde_clase_id': clases[4]['id'], 'instructor': 'Leo'},
+                  headers=ADMIN)
+    r = cliente.patch(f"/admin/series/{serie['id']}", json={'desde_clase_id': clases[1]['id'], 'hora': '18:00'},
+                      headers=ADMIN).json()
+    assert [c['instructor'] for c in r['clases']] == ['Sofía'] * 4 + ['Leo'] * 4
+    assert r['instructor'] == 'Leo'
+
+
+def test_patch_rechaza_si_la_clase_ya_empezo(cliente):
+    serie = crear(cliente).json()
+    # Son las 20:00 del martes 10/11: la primera clase (19:00) ya empezó.
+    reloj.fijar(datetime(2026, 11, 10, 23, 0, tzinfo=timezone.utc))
+    antes = cliente.get(f"/admin/series/{serie['id']}", headers=ADMIN).json()
+    r = cliente.patch(f"/admin/series/{serie['id']}", json={'desde_clase_id': serie['clases'][0]['id'], 'cupo': 3},
+                      headers=ADMIN)
+    assert r.status_code == 409
+    assert cliente.get(f"/admin/series/{serie['id']}", headers=ADMIN).json() == antes
+
+
+def test_patch_rechaza_hora_que_deja_una_clase_en_el_pasado(cliente):
+    serie = crear(cliente).json()
+    antes = cliente.get(f"/admin/series/{serie['id']}", headers=ADMIN).json()
+    # Hoy es martes 12:00 de Montevideo: a las 11:00 la primera clase ya habría empezado.
