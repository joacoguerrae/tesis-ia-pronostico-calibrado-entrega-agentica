+
+def aplicar_estado(compra, estado_pago):
+    """Aplica a la compra el estado de un pago de Cobrá (regla 4). Los créditos y el correo van una sola vez."""
+    if estado_pago == 'aprobado':
+        nuevo = 'aprobada'
+    elif estado_pago == 'rechazado':
+        nuevo = 'rechazada'
+    else:
+        return
+    if db.resolver_compra(compra['id'], nuevo) and nuevo == 'aprobada':
