diff --git a/pulso/main.py b/pulso/main.py
index 039212d..80eb023 100644
--- a/pulso/main.py
+++ b/pulso/main.py
@@ -1,7 +1,9 @@
 import os
+import sqlite3
+from typing import Literal
 
 from fastapi import APIRouter, Depends, FastAPI, Header, HTTPException
-from pydantic import AwareDatetime, BaseModel, Field
+from pydantic import AwareDatetime, BaseModel, Field, field_validator
 
 from pulso import correo, db, reloj
 
@@ -92,6 +94,49 @@ def yo(socio=Depends(socio_actual)):
     return {k: socio[k] for k in ('id', 'nombre', 'email', 'plan', 'creditos')}
 
 
+CREDITOS_POR_PLAN = {'basico': 8, 'premium': 20}
+
+
+def email_valido(email):
+    if any(c.isspace() for c in email) or email.count('@') != 1:
+        return False
+    local, dominio = email.split('@')
+    return bool(local) and '.' in dominio and not dominio.startswith('.') and not dominio.endswith('.')
+
+
+class NuevoSocio(BaseModel):
+    nombre: str
+    email: str
+    plan: Literal['basico', 'premium']
+
+    @field_validator('nombre')
+    @classmethod
+    def _nombre(cls, v):
+        v = v.strip()
+        if not 2 <= len(v) <= 80:
+            raise ValueError('El nombre debe tener entre 2 y 80 caracteres')
+        return v
+
+    @field_validator('email')
+    @classmethod
+    def _email(cls, v):
+        v = v.strip().lower()
+        if not email_valido(v):
+            raise ValueError('Email inválido')
+        return v
+
+
+@router.post('/socios', status_code=201)
+def registrar_socio(datos: NuevoSocio):
+    try:
+        socio = db.crear_socio(datos.nombre, datos.email, datos.plan, CREDITOS_POR_PLAN[datos.plan])
+    except sqlite3.IntegrityError:
+        raise HTTPException(409, 'Ya existe un socio con ese email')
+    correo.enviar(socio['email'], 'Te damos la bienvenida a Pulso',
+                  f"Hola {socio['nombre']}, ya sos parte de Pulso. Tenés {socio['creditos']} créditos para reservar.")
+    return {k: socio[k] for k in ('id', 'nombre', 'email', 'plan', 'creditos', 'token')}
+
+
 def crear_app():
     db.inicializar()
     app = FastAPI(title='Pulso')
