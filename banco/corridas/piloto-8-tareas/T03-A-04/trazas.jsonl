{"host.arch": "arm64", "os.type": "darwin", "os.version": "23.4.0", "service.name": "claude-code", "service.version": "2.1.312", "user.id": "", "session.id": "527746b3-8c0d-4f6f-bbb8-67097c314378", "terminal.type": "claude-desktop", "gen_ai.provider.name": "anthropic", "span.type": "tool", "tool_name": "Bash", "tool_name_safe": "Bash", "gen_ai.operation.name": "execute_tool", "gen_ai.tool.name": "Bash", "gen_ai.conversation.id": "527746b3-8c0d-4f6f-bbb8-67097c314378", "full_command": "cat > tests/test_ocupacion.py <<'EOF'\nfrom datetime import datetime, timezone\n\nfrom pulso import db\nfrom tests.conftest import ADMIN\n\nURL = '/admin/ocupacion.csv'\nENC = 'fecha,hora,clase,instructor,cupo,confirmadas,ocupacion_pct'\n\n\ndef utc(*a):\n    return datetime(*a, tzinfo=timezone.utc)\n\n\ndef pedir(cliente, desde, hasta):\n    return cliente.get(URL, params={'desde': desde, 'hasta': hasta}, headers=ADMIN)\n\n\ndef test_sin_clave_401(cliente):\n    assert cliente.get(URL, params={'desde': '2026-11-01', 'hasta': '2026-11-30'}).status_code == 401\n    assert cliente.get(URL).status_code == 401\n\n\ndef test_validaciones_422(cliente):\n    for p in [{}, {'desde': '2026-11-01'}, {'hasta': '2026-11-01'},\n              {'desde': '2026/11/01', 'hasta': '2026-11-02'},\n              {'desde': '2026-11-05', 'hasta': '2026-11-01'},\n              {'desde': '2026-10-01', 'hasta': '2026-11-01'}]:\n        assert cliente.get(URL, params=p, headers=ADMIN).status_code == 422\n    assert pedir(cliente, '2026-10-01', '2026-10-31').status_code == 200\n\n\ndef test_vacio_solo_encabezado(cliente):\n    r = pedir(cliente, '2026-11-01', '2026-11-30')\n    assert r.headers['content-type'] == 'text/csv; charset=utf-8'\n    assert r.text.splitlines() == [ENC]\n\n\ndef test_filas_orden_y_zona_horaria(cliente):\n    socios = [db.crear_socio(f's{i}', f's{i}@x.com') for i in range(3)]\n    a = db.crear_clase('Yoga, \"nivel\" 1', 'Sofía', utc(2026, 11, 4, 1, 0), cupo=8)  # 3/11 22:00 MVD\n    b = db.crear_clase('Spinning', 'Leo', utc(2026, 11, 4, 10, 0), cupo=8)\n    c = db.crear_clase('Fuera', 'Leo', utc(2026, 11, 1, 2, 59), cupo=8)  # 31/10 23:59 MVD\n    d = db.crear_clase('Empate', 'Leo', utc(2026, 11, 4, 10, 0), cupo=8)\n    db.crear_reserva(socios[0]['id'], a['id'], utc(2026, 11, 1))\n    db.crear_reserva(socios[1]['id'], a['id'], utc(2026, 11, 1), estado='cancelada')\n    for s in socios[:1]:\n        db.crear_reserva(s['id'], b['id'], utc(2026, 11, 1))\n    r = pedir(cliente, '2026-11-01', '2026-11-03')\n    assert r.text.splitlines() == [ENC, '2026-11-03,22:00,\"Yoga, \"\"nivel\"\" 1\",Sofía,8,1,13']\n    r = pedir(cliente, '2026-11-04', '2026-11-04')\n    assert r.text.splitlines() == [ENC, '2026-11-04,07:00,Spinning,Leo,8,1,13',\n                                   '2026-11-04,07:00,Empate,Leo,8,0,0']\nEOF\npython -m pytest -q 2>&1 | tail -15", "bash_command_class": "file_read", "bash_argv0": "cat", "tool_use_id": "toolu_01Rgki3yQKGLvb8UA4R7GyMB", "gen_ai.tool.call.id": "toolu_01Rgki3yQKGLvb8UA4R7GyMB", "duration_ms": 7, "_nombre": "claude_code.tool", "_traza": "fe5e591c7ef33d11eb85264ee909a6c4", "_tramo": "d919838cf59734ce", "_padre": "09e81d98b61bd205", "_inicio_ns": 1794571948932000000, "_fin_ns": 1794571948939508375, "_estado": 0}
