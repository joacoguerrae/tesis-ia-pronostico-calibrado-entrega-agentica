{"host.arch": "amd64", "os.type": "linux", "os.version": "6.18.33.2-microsoft-standard-WSL2", "service.name": "claude-code", "service.version": "2.1.312", "wsl.version": "2", "user.id": "0f72bbf305cc3cfe4c49efd7a27949e16f5ce38c2de862b736399de5c3c79b13", "session.id": "6a83eb03-13d2-4ac5-b6f9-e11f0896a65d", "terminal.type": "wsl-Ubuntu-24.04", "gen_ai.provider.name": "anthropic", "span.type": "tool", "tool_name": "Bash", "tool_name_safe": "Bash", "gen_ai.operation.name": "execute_tool", "gen_ai.tool.name": "Bash", "gen_ai.conversation.id": "6a83eb03-13d2-4ac5-b6f9-e11f0896a65d", "full_command": "cat > pulso/cobra.py <<'EOF'\n\"\"\"Cliente de Cobrá, la pasarela de pagos. Cualquier falla se levanta como CobraError.\"\"\"\nimport os\n\nimport httpx\n\nTIMEOUT = 5.0\n\n\nclass CobraError(Exception):\n    pass\n\n\ndef _pedir(metodo, ruta, ok, **kwargs):\n    url = os.environ.get('PULSO_PAGOS_URL', '').rstrip('/') + ruta\n    headers = dict(kwargs.pop('headers', {}), **{'X-Cobra-Clave': os.environ.get('PULSO_PAGOS_CLAVE', '')})\n    try:\n        r = httpx.request(metodo, url, headers=headers, timeout=TIMEOUT, **kwargs)\n    except httpx.HTTPError as e:\n        raise CobraError(str(e)) from e\n    if r.status_code not in ok:\n        raise CobraError(f'Cobrá respondió {r.status_code}')\n    try:\n        return r.status_code, r.json()\n    except ValueError as e:\n        raise CobraError('Respuesta inválida de Cobrá') from e\n\n\ndef _pago(datos):\n    if not isinstance(datos, dict) or not all(k in datos for k in ('id', 'estado', 'referencia')):\n        raise CobraError('Pago inválido')\n    return datos\n\n\ndef crear_pago(monto, referencia):\n    _, datos = _pedir('POST', '/pagos', (200, 201), headers={'Idempotency-Key': referencia},\n                      json={'monto': monto, 'moneda': 'UYU', 'referencia': referencia})\n    return _pago(datos)\n\n\ndef obtener_pago(pago_id):\n    \"\"\"El pago, o None si Cobrá no lo conoce.\"\"\"\n    try:\n        _, datos = _pedir('GET', f'/pagos/{pago_id}', (200, 404))\n    except CobraError:\n        raise\n    return _pago(datos) if datos is not None and _existe(pago_id) else None\n\n\ndef _existe(_):\n    return True\nEOF", "bash_command_class": "file_read", "bash_argv0": "cat", "tool_use_id": "toolu_01CL6jXdUGJg6TiCQBtLTpRT", "gen_ai.tool.call.id": "toolu_01CL6jXdUGJg6TiCQBtLTpRT", "duration_ms": 4, "_nombre": "claude_code.tool", "_traza": "d7dbfa011915f5d671f55f1cd3619086", "_tramo": "bfeac402e7a47d3b", "_padre": "f633a8c34083e324", "_inicio_ns": 1794688167704000000, "_fin_ns": 1794688167708398752, "_estado": 0}
