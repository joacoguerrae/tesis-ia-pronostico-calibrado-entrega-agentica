{"host.arch": "amd64", "os.type": "linux", "os.version": "6.18.33.2-microsoft-standard-WSL2", "service.name": "claude-code", "service.version": "2.1.312", "wsl.version": "2", "user.id": "0f72bbf305cc3cfe4c49efd7a27949e16f5ce38c2de862b736399de5c3c79b13", "session.id": "8ef6c150-8de6-4778-8a0d-368ff55782e0", "terminal.type": "wsl-Ubuntu-24.04", "gen_ai.provider.name": "anthropic", "span.type": "tool", "tool_name": "Bash", "tool_name_safe": "Bash", "gen_ai.operation.name": "execute_tool", "gen_ai.tool.name": "Bash", "gen_ai.conversation.id": "8ef6c150-8de6-4778-8a0d-368ff55782e0", "full_command": "cat > tests/test_recordatorios.py <<'EOF'\nfrom datetime import timedelta\n\nfrom conftest import ADMIN, AHORA\nfrom pulso import db\n\n\ndef recordatorios():\n    return [c for c in db.correos() if c['asunto'].startswith('Recordatorio')]\n\n\ndef test_requiere_clave(cliente):\n    assert cliente.post('/admin/recordatorios').status_code == 401\n    assert cliente.post('/admin/recordatorios', headers={'X-Admin-Key': 'x'}).status_code == 401\n\n\ndef test_manda_una_sola_vez(cliente, socio):\n    clase = db.crear_clase('Yoga', 'Sofía', AHORA + timedelta(hours=6, minutes=30))\n    db.crear_reserva(socio['id'], clase['id'], AHORA - timedelta(hours=1))\n    r = cliente.post('/admin/recordatorios', headers=ADMIN)\n    assert r.json() == {'enviados': 1}\n    c = recordatorios()[0]\n    assert c['para'] == 'ana@example.com'\n    assert c['asunto'] == 'Recordatorio: Yoga el 10/11 a las 18:30'\n    assert 'Sofía' in c['cuerpo']\n    assert cliente.post('/admin/recordatorios', headers=ADMIN).json() == {'enviados': 0}\n    assert len(recordatorios()) == 1\n\n\ndef test_ventana_y_estado(cliente, socio):\n    def reservar(delta, estado='confirmada'):\n        clase = db.crear_clase('Spin', 'Leo', AHORA + delta)\n        db.crear_reserva(socio['id'], clase['id'], AHORA, estado)\n    reservar(timedelta(hours=24))                 # límite inclusivo\n    reservar(timedelta(hours=24, seconds=1))      # fuera\n    reservar(timedelta(0))                        # ya empieza: fuera\n    reservar(timedelta(hours=-1))                 # pasada\n    reservar(timedelta(hours=3), 'cancelada')     # no confirmada\n    assert cliente.post('/admin/recordatorios', headers=ADMIN).json() == {'enviados': 1}\n    # más tarde entra la que estaba fuera\n    from pulso import reloj\n    reloj.fijar(AHORA + timedelta(minutes=15))\n    assert cliente.post('/admin/recordatorios', headers=ADMIN).json() == {'enviados': 1}\nEOF\npython -m pytest -q 2>&1 | tail -5", "bash_command_class": "file_read", "bash_argv0": "cat", "tool_use_id": "toolu_01Bmsprxh3EhFFHPh2zzJQ4G", "gen_ai.tool.call.id": "toolu_01Bmsprxh3EhFFHPh2zzJQ4G", "duration_ms": 8, "_nombre": "claude_code.tool", "_traza": "92a4eb7463096aa526fbf0a4cb4ca457", "_tramo": "f220434427046d6e", "_padre": "892e1549a436db64", "_inicio_ns": 1794689724679000000, "_fin_ns": 1794689724687393403, "_estado": 0}
