@@ -129,6 +129,17 @@ def reservas_de(socio_id):
                    'WHERE r.socio_id = ? ORDER BY c.inicio, r.id', (socio_id,))
 
 
+def cancelar_reserva(reserva_id, socio_id, devolver_credito):
+    """Marca la reserva como cancelada y, si corresponde, devuelve el crédito, todo en una transacción.
+    Solo cancela si la reserva sigue confirmada, así el crédito no se devuelve dos veces."""
+    with conexion() as con:
+        cur = con.execute("UPDATE reservas SET estado = 'cancelada' "
+                          "WHERE id = ? AND socio_id = ? AND estado = 'confirmada'", (reserva_id, socio_id))
+        if cur.rowcount == 1 and devolver_credito:
+            con.execute('UPDATE socios SET creditos = creditos + 1 WHERE id = ?', (socio_id,))
+    return reserva(reserva_id)
+
+
 def sumar_creditos(socio_id, cantidad):
     with conexion() as con:
         con.execute('UPDATE socios SET creditos = creditos + ? WHERE id = ?', (cantidad, socio_id))
