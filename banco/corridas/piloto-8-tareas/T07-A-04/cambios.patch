@@ -0,0 +1,44 @@
+"""Cliente de Cobrá, la pasarela de pagos. Cualquier falla se informa como CobraError."""
+import os
+
+import httpx
+
+TIMEOUT = 5
+
+
+class CobraError(Exception):
+    pass
+
+
+def _pedir(metodo, ruta, permitidos, **kwargs):
+    url = os.environ.get('PULSO_PAGOS_URL', '').rstrip('/') + ruta
+    headers = dict(kwargs.pop('headers', {}), **{'X-Cobra-Clave': os.environ.get('PULSO_PAGOS_CLAVE', '')})
+    try:
+        r = httpx.request(metodo, url, headers=headers, timeout=TIMEOUT, **kwargs)
+        if r.status_code not in permitidos:
+            raise CobraError(f'Cobrá respondió {r.status_code}')
+        return r.status_code, (r.json() if r.status_code != 404 else None)
+    except (httpx.HTTPError, ValueError) as e:
+        raise CobraError(str(e)) from e
+
+
+def crear_pago(monto, referencia):
+    _, pago = _pedir('POST', '/pagos', (200, 201), headers={'Idempotency-Key': referencia},
+                     json={'monto': monto, 'moneda': 'UYU', 'referencia': referencia})
+    return pago
+
+
+def obtener_pago(pago_id):
+    """El pago, o None si Cobrá no lo conoce."""
+    _, pago = _pedir('GET', f'/pagos/{pago_id}', (200, 404))
+    return pago
+
+
+def buscar_por_referencia(referencia):
+    """El pago con esa referencia, o None si no hay ninguno."""
+    _, datos = _pedir('GET', '/pagos', (200,), params={'referencia': referencia})
+    try:
+        pagos = datos['pagos']
+    except (KeyError, TypeError) as e:
+        raise CobraError('Respuesta inválida') from e
+    return pagos[0] if pagos else None
