diff --git a/tests/test_espera.py b/tests/test_espera.py
new file mode 100644
index 0000000..48e859a
--- /dev/null
+++ b/tests/test_espera.py
@@ -0,0 +1,127 @@
+from datetime import timedelta
+
+from conftest import ADMIN, AHORA, auth
+from pulso import db
+
+
+def clase_llena(cupo=1, **kw):
+    clase = db.crear_clase('Spinning', 'Leo', kw.get('inicio', AHORA + timedelta(hours=7)), cupo=cupo)
+    titulares = []
+    for i in range(cupo):
+        s = db.crear_socio(f'Titular {i}', f't{i}-{clase["id"]}@example.com')
+        titulares.append(db.crear_reserva(s['id'], clase['id'], AHORA))
+    return clase, titulares
+
+
+def anotar(cliente, clase, socio):
+    return cliente.post(f"/clases/{clase['id']}/espera", headers=auth(socio))
+
+
+def test_anotarse_ver_y_bajarse(cliente, socio):
+    clase, _ = clase_llena()
+    r = anotar(cliente, clase, socio)
+    assert r.status_code == 201
+    assert r.json() == {'clase_id': clase['id'], 'posicion': 1}
+    assert db.socio(socio['id'])['creditos'] == 8
+    assert cliente.get(f"/clases/{clase['id']}/espera", headers=auth(socio)).json()['posicion'] == 1
+    assert cliente.delete(f"/clases/{clase['id']}/espera", headers=auth(socio)).status_code == 204
+    assert cliente.get(f"/clases/{clase['id']}/espera", headers=auth(socio)).status_code == 404
+    assert cliente.delete(f"/clases/{clase['id']}/espera", headers=auth(socio)).status_code == 404
+
+
+def test_auth_y_404(cliente, socio):
+    assert cliente.post('/clases/1/espera').status_code == 401
+    assert cliente.get('/clases/1/espera').status_code == 401
+    assert cliente.delete('/clases/1/espera').status_code == 401
+    assert cliente.post('/clases/99/espera', headers=auth(socio)).status_code == 404
+
+
+def test_rechazos_al_anotarse(cliente, socio):
+    libre = db.crear_clase('Yoga', 'Sofía', AHORA + timedelta(hours=3))
+    assert anotar(cliente, libre, socio).status_code == 409
+    clase, titulares = clase_llena()
+    assert anotar(cliente, clase, socio).status_code == 201
+    assert anotar(cliente, clase, socio).status_code == 409
+    empezada, _ = clase_llena(inicio=AHORA)
+    assert anotar(cliente, empezada, socio).status_code == 409
+    sin = db.crear_socio('Sin', 'sin@example.com', creditos=0)
+    assert anotar(cliente, clase, sin).status_code == 409
+    titular = db.socio(titulares[0]['socio_id'])
+    assert anotar(cliente, clase, titular).status_code == 409
+
+
+def test_posiciones_avanzan_y_reanotarse_es_ultimo(cliente):
+    clase, _ = clase_llena()
+    a, b, c = (db.crear_socio(n, f'{n}@example.com') for n in 'abc')
+    for s in (a, b, c):
+        anotar(cliente, clase, s)
+    cliente.delete(f"/clases/{clase['id']}/espera", headers=auth(a))
+    assert cliente.get(f"/clases/{clase['id']}/espera", headers=auth(c)).json()['posicion'] == 2
+    assert anotar(cliente, clase, a).json()['posicion'] == 3
+
+
+def test_cancelar_asigna_al_primero(cliente, socio):
+    clase, [res] = clase_llena()
+    otro = db.crear_socio('Otro', 'otro@example.com')
+    anotar(cliente, clase, socio)
+    anotar(cliente, clase, otro)
+    r = cliente.post(f"/admin/reservas/{res['id']}/cancelar", headers=ADMIN)
+    assert r.status_code == 200 and r.json()['estado'] == 'cancelada'
+    assert db.socio(socio['id'])['creditos'] == 7
+    assert db.socio(res['socio_id'])['creditos'] == 9
+    [mia] = cliente.get('/reservas', headers=auth(socio)).json()
+    assert mia['estado'] == 'confirmada'
+    assert cliente.get(f"/clases/{clase['id']}/espera", headers=auth(otro)).json()['posicion'] == 1
+    assert [c['asunto'] for c in db.correos()] == ['Se liberó un lugar: Spinning el 10/11 a las 19:00'.replace('10/11 a las 19:00', '10/11 a las 19:00')]
+    assert db.correos()[0]['para'] == 'ana@example.com'
+    assert cliente.post(f"/admin/reservas/{res['id']}/cancelar", headers=ADMIN).status_code == 409
+    assert db.socio(res['socio_id'])['creditos'] == 9
+
+
+def test_salta_sin_creditos_y_con_reserva(cliente):
+    clase, [res] = clase_llena()
+    sin = db.crear_socio('Sin', 'sin@example.com', creditos=1)
+    anotar(cliente, clase, sin)
+    db.sumar_creditos(sin['id'], -1)
+    ya = db.crear_socio('Ya', 'ya@example.com')
+    anotar(cliente, clase, ya)
+    db.crear_reserva(ya['id'], clase['id'], AHORA)  # quedó con reserva y cupo 1: se amplía abajo
+    ultimo = db.crear_socio('Ultimo', 'ultimo@example.com')
+    anotar(cliente, clase, ultimo)
+    r = cliente.patch(f"/admin/clases/{clase['id']}", json={'cupo': 3}, headers=ADMIN)
+    assert r.status_code == 200
+    assert r.json()['lugares_libres'] == 0
+    asuntos = [c['asunto'] for c in db.correos()]
+    assert asuntos == ['No pudimos darte el lugar: Spinning el 10/11 a las 19:00',
+                       'Se liberó un lugar: Spinning el 10/11 a las 19:00']
+    assert db.confirmadas(clase['id']) == 3
+
+
+def test_clase_empezada_no_asigna_pero_cancela(cliente, socio):
+    clase, [res] = clase_llena(inicio=AHORA + timedelta(hours=1))
+    anotar(cliente, clase, socio)
+    from pulso import reloj
+    reloj.fijar(AHORA + timedelta(hours=1))
+    r = cliente.post(f"/admin/reservas/{res['id']}/cancelar", headers=ADMIN)
+    assert r.status_code == 200
+    assert db.socio(res['socio_id'])['creditos'] == 9
+    assert db.confirmadas(clase['id']) == 0
+    assert db.posicion_espera_existe(socio['id'], clase['id'])
+    assert db.correos() == []
+
+
+def test_cupo_validaciones(cliente):
+    clase, _ = clase_llena(cupo=2)
+    url = f"/admin/clases/{clase['id']}"
+    assert cliente.patch(url, json={'cupo': 5}).status_code == 401
+    for cuerpo in ({}, {'cupo': 0}, {'cupo': 'x'}, {'cupo': 2.5}, {'cupo': True}):
+        assert cliente.patch(url, json=cuerpo, headers=ADMIN).status_code == 422
+    assert cliente.patch(url, json={'cupo': 1}, headers=ADMIN).status_code == 409
+    assert db.clase(clase['id'])['cupo'] == 2
+    assert cliente.patch(url, json={'cupo': 2}, headers=ADMIN).status_code == 200
+    assert cliente.patch('/admin/clases/99', json={'cupo': 2}, headers=ADMIN).status_code == 404
+
+
+def test_cancelar_admin(cliente):
+    assert cliente.post('/admin/reservas/1/cancelar').status_code == 401
+    assert cliente.post('/admin/reservas/99/cancelar', headers=ADMIN).status_code == 404
