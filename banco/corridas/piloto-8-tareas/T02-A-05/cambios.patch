--- a/pulso/main.py
+++ b/pulso/main.py
@@ -1,6 +1,8 @@
 import os
+import re
+from datetime import date
 
-from fastapi import APIRouter, Depends, FastAPI, Header, HTTPException
+from fastapi import APIRouter, Depends, FastAPI, Header, HTTPException, Query, Response
 from pydantic import AwareDatetime, BaseModel, Field
 
 from pulso import correo, db, reloj
@@ -30,10 +32,48 @@ def ver_reserva(reserva):
     return {k: reserva[k] for k in ('id', 'clase_id', 'estado', 'creada')}
 
 
+def parsear_dia(texto, nombre):
+    if texto is None:
+        return None
+    if not re.fullmatch(r'\d{4}-\d{2}-\d{2}', texto):
+        raise HTTPException(422, f'{nombre} debe tener formato YYYY-MM-DD')
+    try:
+        return date.fromisoformat(texto)
+    except ValueError:
+        raise HTTPException(422, f'{nombre} no es una fecha válida')
+
+
 @router.get('/clases')
-def listar_clases():
+def listar_clases(response: Response, desde: str | None = None, hasta: str | None = None,
+                  instructor: str | None = None, con_lugar: bool = False,
+                  pagina: int = Query(1, ge=1), por_pagina: int = Query(20, ge=1, le=50)):
+    desde_dia = parsear_dia(desde, 'desde')
+    hasta_dia = parsear_dia(hasta, 'hasta')
+    if desde_dia and hasta_dia and desde_dia > hasta_dia:
+        raise HTTPException(422, 'desde no puede ser posterior a hasta')
     ahora = reloj.ahora()
-    return [ver_clase(c) for c in db.clases() if db.a_fecha(c['inicio']) > ahora]
+    instructor_buscado = instructor.casefold() if instructor is not None else None
+    resultado = []
+    for c in db.clases():
+        inicio = db.a_fecha(c['inicio'])
+        if inicio <= ahora:
+            continue
+        dia = inicio.astimezone(reloj.MONTEVIDEO).date()
+        if desde_dia and dia < desde_dia:
+            continue
+        if hasta_dia and dia > hasta_dia:
+            continue
+        if instructor_buscado is not None and c['instructor'].casefold() != instructor_buscado:
+            continue
+        resultado.append(c)
+    if con_lugar:
+        resultado = [ver_clase(c) for c in resultado]
+        resultado = [c for c in resultado if c['lugares_libres'] > 0]
+    response.headers['X-Total'] = str(len(resultado))
+    pagina_clases = resultado[(pagina - 1) * por_pagina:pagina * por_pagina]
+    if con_lugar:
+        return pagina_clases
+    return [ver_clase(c) for c in pagina_clases]
 
 
 @router.get('/clases/{clase_id}')
