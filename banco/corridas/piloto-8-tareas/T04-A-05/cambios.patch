diff --git a/tests/test_socios.py b/tests/test_socios.py
new file mode 100644
index 0000000..c3722c0
--- /dev/null
+++ b/tests/test_socios.py
@@ -0,0 +1,44 @@
+import pytest
+
+from pulso import db
+
+OK = {'nombre': 'Ana Pérez', 'email': 'Ana.Perez@Example.com', 'plan': 'premium'}
+
+
+def test_registro_normaliza_y_devuelve_token(cliente):
+    r = cliente.post('/socios', json=dict(OK, nombre='  Ana Pérez  ', email='  Ana.Perez@Example.com '))
+    assert r.status_code == 201
+    j = r.json()
+    assert j['nombre'] == 'Ana Pérez' and j['email'] == 'ana.perez@example.com'
+    assert j['plan'] == 'premium' and j['creditos'] == 20 and len(j['token']) >= 32
+    assert cliente.get('/yo', headers={'Authorization': f"Bearer {j['token']}"}).json()['id'] == j['id']
+    [c] = db.correos()
+    assert c['para'] == 'ana.perez@example.com' and c['asunto'] == 'Te damos la bienvenida a Pulso'
+
+
+def test_basico_8_creditos_y_tokens_distintos(cliente):
+    a = cliente.post('/socios', json=dict(OK, plan='basico')).json()
+    b = cliente.post('/socios', json=dict(OK, email='otro@example.com')).json()
+    assert a['creditos'] == 8 and a['token'] != b['token']
+
+
+def test_email_duplicado_409(cliente):
+    assert cliente.post('/socios', json=OK).status_code == 201
+    assert cliente.post('/socios', json=dict(OK, email=' ANA.PEREZ@example.com')).status_code == 409
+    assert len(db.correos()) == 1
+
+
+@pytest.mark.parametrize('cambio', [
+    {'nombre': ' a '}, {'nombre': 'x' * 81}, {'nombre': '   '},
+    {'email': 'sin-arroba.com'}, {'email': 'a@@b.com'}, {'email': 'a@b@c.com'}, {'email': '@b.com'},
+    {'email': 'a@b'}, {'email': 'a@.b.com'}, {'email': 'a@b.com.'}, {'email': 'a b@c.com'},
+    {'plan': 'oro'}, {'plan': 'Premium'}, {'nombre': 5},
+])
+def test_datos_invalidos_422(cliente, cambio):
+    assert cliente.post('/socios', json=dict(OK, **cambio)).status_code == 422
+
+
+@pytest.mark.parametrize('falta', ['nombre', 'email', 'plan'])
+def test_falta_dato_422(cliente, falta):
+    datos = {k: v for k, v in OK.items() if k != falta}
+    assert cliente.post('/socios', json=datos).status_code == 422
