+# --- Lista de espera y operaciones atómicas ---------------------------------
+
+ESQUEMA_ESPERA = """
+CREATE TABLE IF NOT EXISTS espera (
+    id INTEGER PRIMARY KEY AUTOINCREMENT,
+    socio_id INTEGER NOT NULL REFERENCES socios(id),
+    clase_id INTEGER NOT NULL REFERENCES clases(id),
+    UNIQUE (socio_id, clase_id)
+);
+"""
+
+
+@contextmanager
+def transaccion():
+    """Conexión con la escritura tomada desde el principio: lo que se lee dentro no cambia hasta el commit."""
+    con = sqlite3.connect(ruta(), timeout=30, isolation_level=None)
+    con.row_factory = sqlite3.Row
+    con.execute('PRAGMA foreign_keys = ON')
+    try:
+        con.execute('BEGIN IMMEDIATE')
+        yield con
+        con.execute('COMMIT')
+    finally:
+        con.close()
+
+
+def q_una(con, sql, parametros=()):
+    fila = con.execute(sql, parametros).fetchone()
+    return dict(fila) if fila else None
+
+
+def q_confirmadas(con, clase_id):
+    return q_una(con, "SELECT COUNT(*) AS n FROM reservas WHERE clase_id = ? AND estado = 'confirmada'",
+                 (clase_id,))['n']
+
+
+def q_tiene_confirmada(con, socio_id, clase_id):
+    return q_una(con, "SELECT 1 AS x FROM reservas WHERE socio_id = ? AND clase_id = ? AND estado = 'confirmada'",
+                 (socio_id, clase_id)) is not None
+
+
+def q_crear_reserva(con, socio_id, clase_id, creada):
+    cur = con.execute("INSERT INTO reservas (socio_id, clase_id, estado, creada) VALUES (?, ?, 'confirmada', ?)",
+                      (socio_id, clase_id, a_texto(creada)))
+    return q_una(con, 'SELECT * FROM reservas WHERE id = ?', (cur.lastrowid,))
+
+
+def q_correo(con, para, asunto, cuerpo, creado):
+    con.execute('INSERT INTO correos (para, asunto, cuerpo, creado) VALUES (?, ?, ?, ?)',
+                (para, asunto, cuerpo, a_texto(creado)))
+
+
+def q_posicion(con, socio_id, clase_id):
+    fila = q_una(con, 'SELECT id FROM espera WHERE socio_id = ? AND clase_id = ?', (socio_id, clase_id))
+    if fila is None:
+        return None
+    return q_una(con, 'SELECT COUNT(*) AS n FROM espera WHERE clase_id = ? AND id <= ?',
+                 (clase_id, fila['id']))['n']
