diff --git a/pulso/cobra.py b/pulso/cobra.py
new file mode 100644
index 0000000..d0a1a2f
--- /dev/null
+++ b/pulso/cobra.py
@@ -0,0 +1,79 @@
+"""Cliente de Cobrá, la pasarela de pagos. Cobrá es la fuente de verdad: el estado de un pago se pide siempre a Cobrá.
+
+Cualquier falla (no responde, o responde un código que no está en el contrato para esa ruta) se informa como CobraError.
+"""
+import os
+from urllib.parse import quote
+
+import httpx
+
+ESTADOS = ('pendiente', 'aprobado', 'rechazado')
+SEGUNDOS_DE_ESPERA = 5
+
+
+class CobraError(Exception):
+    pass
+
+
+def _cliente():
+    return httpx.Client(timeout=SEGUNDOS_DE_ESPERA)
+
+
+def _pedir(metodo, ruta, esperados, headers=None, **kwargs):
+    base = os.environ.get('PULSO_PAGOS_URL')
+    if not base:
+        raise CobraError('Falta PULSO_PAGOS_URL')
+    cabeceras = {'X-Cobra-Clave': os.environ.get('PULSO_PAGOS_CLAVE', ''), **(headers or {})}
+    try:
+        with _cliente() as cliente:
+            respuesta = cliente.request(metodo, base + ruta, headers=cabeceras, **kwargs)
+    except httpx.HTTPError as error:
+        raise CobraError(f'Cobrá no respondió: {error}') from error
+    if respuesta.status_code not in esperados:
+        raise CobraError(f'Cobrá respondió {respuesta.status_code} a {metodo} {ruta}')
+    return respuesta
+
+
+def _validar(datos):
+    try:
+        pago = {k: datos[k] for k in ('id', 'estado', 'monto', 'moneda', 'referencia', 'url_pago')}
+    except (KeyError, TypeError) as error:
+        raise CobraError('Respuesta de Cobrá sin los datos del pago') from error
+    if pago['estado'] not in ESTADOS or not isinstance(pago['referencia'], str):
+        raise CobraError('Respuesta de Cobrá con un pago inválido')
+    return pago
+
+
+def _leer(respuesta):
+    try:
+        datos = respuesta.json()
+    except ValueError as error:
+        raise CobraError('Respuesta de Cobrá que no es JSON') from error
+    return _validar(datos)
+
+
+def crear_pago(referencia, monto):
+    """Crea el pago en UYU. La referencia también es la Idempotency-Key, así que no se crean pagos duplicados."""
+    respuesta = _pedir('POST', '/pagos', {200, 201}, headers={'Idempotency-Key': referencia},
+                       json={'monto': monto, 'moneda': 'UYU', 'referencia': referencia})
+    return _leer(respuesta)
+
+
+def consultar_pago(pago_id):
+    """Devuelve el pago, o None si Cobrá no lo conoce."""
+    # El id llega del webhook sin autenticar: se escapa para que no pueda cambiar la ruta.
+    ruta = f"/pagos/{quote(pago_id, safe='')}"
+    respuesta = _pedir('GET', ruta, {200, 404})
+    if respuesta.status_code == 404:
+        return None
+    return _leer(respuesta)
+
+
+def buscar_pago_por_referencia(referencia):
+    """Devuelve el pago con esa referencia, o None si no hay ninguno."""
+    respuesta = _pedir('GET', '/pagos', {200}, params={'referencia': referencia})
+    try:
+        pagos = [_validar(p) for p in respuesta.json()['pagos']]
+    except (ValueError, KeyError, TypeError) as error:
+        raise CobraError('Respuesta de Cobrá con una lista de pagos inválida') from error
+    return pagos[0] if pagos else None
diff --git a/pulso/compras.py b/pulso/compras.py
new file mode 100644
index 0000000..b9f33f5
--- /dev/null
+++ b/pulso/compras.py
@@ -0,0 +1,81 @@
+"""Compra de packs de créditos. El socio paga en Cobrá y los créditos se suman cuando el pago queda aprobado."""
+import re
+from datetime import timedelta
+
+from pulso import cobra, correo, db, reloj
+
+# pack: (créditos, precio en pesos uruguayos)
+CATALOGO = {'pack-4': (4, 1200), 'pack-8': (8, 2200)}
+MINUTOS_PARA_RECHAZAR_SIN_PAGO = 30
+_REFERENCIA = re.compile(r'pulso-compra-([1-9][0-9]*)')
+
+
+def referencia(compra_id):
+    return f'pulso-compra-{compra_id}'
+
+
+def compra_id_de(referencia_pago):
+    coincide = _REFERENCIA.fullmatch(referencia_pago)
+    return int(coincide[1]) if coincide else None
+
+
+def comprar(socio, pack):
+    """Guarda la compra como pendiente y después crea el pago en Cobrá. Si Cobrá falla, la compra queda pendiente sin pago."""
+    creditos, monto = CATALOGO[pack]
+    compra = db.crear_compra(socio['id'], pack, creditos, monto, reloj.ahora())
+    pago = cobra.crear_pago(referencia(compra['id']), monto)
+    db.guardar_pago(compra['id'], pago['id'], pago['url_pago'])
+    return db.compra(compra['id'])
+
+
+def aplicar_estado(compra_id, estado):
+    """Aplica el estado de Cobrá a la compra. Solo una compra pendiente cambia, así que créditos y correo van una vez.
+    Devuelve el estado de la compra después de aplicarlo."""
+    if estado == 'aprobado' and db.aprobar_compra(compra_id):
+        compra = db.compra(compra_id)
+        socio = db.socio(compra['socio_id'])
+        correo.enviar(socio['email'], 'Compra de créditos aprobada',
+                      f"Hola {socio['nombre']}, ya sumamos {compra['creditos']} créditos a tu cuenta.")
+    elif estado == 'rechazado':
+        db.rechazar_compra(compra_id)
+    return db.compra(compra_id)['estado']
+
+
+def procesar_aviso(pago_id):
+    """Procesa un webhook de Cobrá. Devuelve (compra_id, estado), o None si el pago no es de ninguna compra.
+    Lanza CobraError si Cobrá falla."""
+    pago = cobra.consultar_pago(pago_id)
+    if pago is None:
+        return None
+    compra_id = compra_id_de(pago['referencia'])
+    if compra_id is None or db.compra(compra_id) is None:
+        return None
+    db.guardar_pago(compra_id, pago['id'], pago['url_pago'])
+    return compra_id, aplicar_estado(compra_id, pago['estado'])
+
+
+def _conciliar_una(compra):
+    if compra['pago_id'] is not None:
+        pago = cobra.consultar_pago(compra['pago_id'])
+    else:
+        pago = cobra.buscar_pago_por_referencia(referencia(compra['id']))
+        if pago is not None:
+            db.guardar_pago(compra['id'], pago['id'], pago['url_pago'])
+        elif reloj.ahora() - db.a_fecha(compra['creada']) >= timedelta(minutes=MINUTOS_PARA_RECHAZAR_SIN_PAGO):
+            # Cobrá no tiene ningún pago con la referencia y ya pasó tiempo de sobra para que se hubiera creado.
+            db.rechazar_compra_sin_pago(compra['id'])
+    if pago is None:
+        return db.compra(compra['id'])['estado']
+    return aplicar_estado(compra['id'], pago['estado'])
+
+
+def conciliar():
+    """Revisa las compras pendientes que había al empezar. Si Cobrá falla con una, esa queda pendiente."""
+    resultado = {'aprobadas': 0, 'rechazadas': 0, 'pendientes': 0}
+    for compra in db.compras_pendientes():
+        try:
+            estado = _conciliar_una(compra)
+        except cobra.CobraError:
+            estado = db.compra(compra['id'])['estado']
+        resultado[{'aprobada': 'aprobadas', 'rechazada': 'rechazadas', 'pendiente': 'pendientes'}[estado]] += 1
+    return resultado
