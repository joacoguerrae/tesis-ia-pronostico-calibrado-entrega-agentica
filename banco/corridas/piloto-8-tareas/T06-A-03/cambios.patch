+def test_ampliar_cupo(cliente):
+    clase, _ = clase_llena(cliente, cupo=2)
+    a, _ = anotar(cliente, clase, 'a')
+    b, _ = anotar(cliente, clase, 'b')
+    c, _ = anotar(cliente, clase, 'c')
+    url = f"/admin/clases/{clase['id']}"
+    assert cliente.patch(url, json={'cupo': 4}).status_code == 401
+    r = cliente.patch(url, json={'cupo': 4}, headers=ADMIN)
+    assert r.status_code == 200
+    assert r.json()['cupo'] == 4 and r.json()['lugares_libres'] == 0
+    assert db.confirmadas(clase['id']) == 4
+    assert cliente.get(f"/clases/{clase['id']}/espera", headers=auth(c)).json()['posicion'] == 1
+    assert cliente.patch(url, json={'cupo': 3}, headers=ADMIN).status_code == 409
+    assert db.clase(clase['id'])['cupo'] == 4
+    assert cliente.patch(url, json={'cupo': 4}, headers=ADMIN).status_code == 200
+    for cuerpo in ({}, {'cupo': 0}, {'cupo': -1}, {'cupo': 'x'}, {'cupo': 2.5}, {'cupo': None}):
+        assert cliente.patch(url, json=cuerpo, headers=ADMIN).status_code == 422
+    assert cliente.patch('/admin/clases/99', json={'cupo': 3}, headers=ADMIN).status_code == 404
