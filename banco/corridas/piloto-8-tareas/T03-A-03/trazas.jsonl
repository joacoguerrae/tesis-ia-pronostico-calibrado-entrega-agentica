{"host.arch": "arm64", "os.type": "darwin", "os.version": "23.4.0", "service.name": "claude-code", "service.version": "2.1.312", "user.id": "", "session.id": "0fe026e5-6069-4719-a8fc-5062b64e2f63", "terminal.type": "claude-desktop", "gen_ai.provider.name": "anthropic", "span.type": "tool", "tool_name": "Bash", "tool_name_safe": "Bash", "gen_ai.operation.name": "execute_tool", "gen_ai.tool.name": "Bash", "gen_ai.conversation.id": "0fe026e5-6069-4719-a8fc-5062b64e2f63", "full_command": "cat > tests/test_ocupacion.py <<'EOF'\nfrom datetime import datetime, timezone\n\nfrom pulso import db\nfrom tests.conftest import ADMIN\n\nURL = '/admin/ocupacion.csv'\nCAB = 'fecha,hora,clase,instructor,cupo,confirmadas,ocupacion_pct'\n\n\ndef pedir(cliente, desde='2026-11-01', hasta='2026-11-30'):\n    return cliente.get(URL, params={'desde': desde, 'hasta': hasta}, headers=ADMIN)\n\n\ndef clase(nombre, inicio, cupo=20, instructor='Leo'):\n    return db.crear_clase(nombre, instructor, inicio, 60, cupo)\n\n\ndef reservar(c, n, estado='confirmada'):\n    for i in range(n):\n        s = db.crear_socio('S', f\"{c['id']}-{estado}-{i}@x.com\")\n        db.crear_reserva(s['id'], c['id'], datetime(2026, 11, 1, tzinfo=timezone.utc), estado)\n\n\ndef utc(d, h, m=0):\n    return datetime(2026, 11, d, h, m, tzinfo=timezone.utc)\n\n\ndef test_sin_clave_401(cliente):\n    assert cliente.get(URL, params={'desde': '2026-11-01', 'hasta': '2026-11-30'}).status_code == 401\n    assert cliente.get(URL, headers={'X-Admin-Key': 'mala'}).status_code == 401\n\n\ndef test_vacio_solo_encabezado(cliente):\n    r = pedir(cliente)\n    assert r.status_code == 200\n    assert r.headers['content-type'] == 'text/csv; charset=utf-8'\n    assert r.text.splitlines() == [CAB]\n\n\ndef test_filas_conteo_y_formato(cliente):\n    a = clase('Spinning', utc(3, 10), 20)\n    b = clase('Yoga, \"nivel\" 1', utc(3, 22, 30), 12, 'Sofía')\n    reservar(a, 15)\n    reservar(a, 3, 'cancelada')\n    reservar(b, 12)\n    assert pedir(cliente).text.splitlines() == [\n        CAB,\n        '2026-11-03,07:00,Spinning,Leo,20,15,75',\n        '2026-11-03,19:30,\"Yoga, \"\"nivel\"\" 1\",Sofía,12,12,100',\n    ]\n\n\ndef test_redondeo_medio_hacia_arriba(cliente):\n    c = clase('A', utc(3, 10), 8)\n    reservar(c, 1)  # 12,5\n    assert pedir(cliente).text.splitlines()[1].endswith(',8,1,13')\n\n\ndef test_dia_en_montevideo_y_extremos(cliente):\n    clase('Tarde', utc(1, 2, 59))   # 31/10 23:59 en Montevideo: fuera\n    clase('Primera', utc(1, 3, 0))  # 01/11 00:00: dentro\n    clase('Ultima', datetime(2026, 12, 1, 2, 59, tzinfo=timezone.utc))  # 30/11 23:59: dentro\n    clase('Fuera', datetime(2026, 12, 1, 3, 0, tzinfo=timezone.utc))\n    filas = pedir(cliente).text.splitlines()[1:]\n    assert [f.split(',')[2] for f in filas] == ['Primera', 'Ultima']\n\n\ndef test_orden_por_inicio_e_id(cliente):\n    clase('B', utc(5, 12))\n    clase('C', utc(5, 12))\n    clase('A', utc(4, 12))\n    filas = pedir(cliente).text.splitlines()[1:]\n    assert [f.split(',')[2] for f in filas] == ['A', 'B', 'C']\n\n\ndef test_validaciones_422(cliente):\n    assert cliente.get(URL, headers=ADMIN).status_code == 422\n    assert cliente.get(URL, params={'desde': '2026-11-01'}, headers=ADMIN).status_code == 422\n    assert pedir(cliente, '01/11/2026', '2026-11-30').status_code == 422\n    assert pedir(cliente, '20261101', '2026-11-30').status_code == 422\n    assert pedir(cliente, '2026-11-30', '2026-11-01').status_code == 422\n    assert pedir(cliente, '2026-10-01', '2026-11-01').status_code == 422\n\n\ndef test_31_dias_ok_y_un_dia(cliente):\n    assert pedir(cliente, '2026-10-01', '2026-10-31').status_code == 200\n    assert pedir(cliente, '2026-11-01', '2026-11-01').status_code == 200\nEOF\npython -m pytest -q 2>&1 | tail -15", "bash_command_class": "file_read", "bash_argv0": "cat", "tool_use_id": "toolu_0122en3KGT5R5ZCei2vNAG8m", "gen_ai.tool.call.id": "toolu_0122en3KGT5R5ZCei2vNAG8m", "duration_ms": 9, "_nombre": "claude_code.tool", "_traza": "351661dbbb774962980734fa0f2a9c33", "_tramo": "105dffc065bb5149", "_padre": "6159c8ef727e9f1f", "_inicio_ns": 1794571645225000000, "_fin_ns": 1794571645234067792, "_estado": 0}
