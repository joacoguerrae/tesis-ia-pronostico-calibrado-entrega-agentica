+from datetime import timedelta
+
+import httpx
+import pytest
+
+from pulso import cobra, db, reloj
+from tests.conftest import ADMIN, AHORA, auth
+
+
+class FakeCobra:
+    def __init__(self):
+        self.pagos = {}
+        self.por_clave = {}
+        self.caido = False
+        self.caer_busqueda = set()
+        self.llamadas = []
+
+    def request(self, metodo, url, headers=None, timeout=None, json=None, params=None):
+        assert headers['X-Cobra-Clave'] == 'clave-cobra'
+        assert timeout == 5
+        ruta = url.removeprefix('https://api.cobra.uy/v1')
+        self.llamadas.append((metodo, ruta))
+        if self.caido:
+            raise httpx.ConnectError('caído')
+        if metodo == 'POST' and ruta == '/pagos':
+            clave = headers['Idempotency-Key']
+            if clave in self.por_clave:
+                return httpx.Response(200, json=self.por_clave[clave])
+            pago = dict(json, id=f'pag_{len(self.pagos) + 1}', estado='pendiente',
+                        url_pago=f'https://pagar.cobra.uy/pag_{len(self.pagos) + 1}')
+            self.pagos[pago['id']] = pago
+            self.por_clave[clave] = pago
+            return httpx.Response(201, json=pago)
+        if metodo == 'GET' and ruta == '/pagos':
+            if params['referencia'] in self.caer_busqueda:
+                return httpx.Response(500)
+            return httpx.Response(200, json={'pagos': [p for p in self.pagos.values()
+                                                       if p['referencia'] == params['referencia']]})
+        if metodo == 'GET' and ruta.startswith('/pagos/'):
+            pago = self.pagos.get(ruta.removeprefix('/pagos/'))
+            return httpx.Response(200, json=pago) if pago else httpx.Response(404)
+        raise AssertionError(ruta)
+
+
+@pytest.fixture
+def fake(monkeypatch):
+    monkeypatch.setenv('PULSO_PAGOS_URL', 'https://api.cobra.uy/v1')
+    monkeypatch.setenv('PULSO_PAGOS_CLAVE', 'clave-cobra')
+    f = FakeCobra()
+    monkeypatch.setattr(cobra.httpx, 'request', f.request)
+    return f
+
+
+def comprar(cliente, socio, pack='pack-4'):
+    return cliente.post('/compras', json={'pack': pack}, headers=auth(socio))
+
+
+def test_compra_crea_pago(cliente, socio, fake):
+    r = comprar(cliente, socio)
+    assert r.status_code == 201
+    assert r.json() == {'id': 1, 'pack': 'pack-4', 'creditos': 4, 'monto': 1200, 'estado': 'pendiente',
+                        'creada': '2026-11-10T15:00:00+00:00', 'url_pago': 'https://pagar.cobra.uy/pag_1'}
+    assert fake.pagos['pag_1']['referencia'] == 'pulso-compra-1'
+    assert fake.pagos['pag_1']['monto'] == 1200 and fake.pagos['pag_1']['moneda'] == 'UYU'
+    assert db.socio(socio['id'])['creditos'] == 8
+
+
+@pytest.mark.parametrize('cuerpo', [{}, {'pack': 'pack-99'}, {'pack': None}])
+def test_pack_invalido(cliente, socio, fake, cuerpo):
+    assert cliente.post('/compras', json=cuerpo, headers=auth(socio)).status_code == 422
+    assert fake.llamadas == []
+    assert cliente.get('/compras', headers=auth(socio)).json() == []
+
+
+def test_compra_sin_token(cliente, fake):
+    assert cliente.post('/compras', json={'pack': 'pack-4'}).status_code == 401
+
+
+def test_cobra_falla_al_crear(cliente, socio, fake):
+    fake.caido = True
+    assert comprar(cliente, socio).status_code == 502
+    lista = cliente.get('/compras', headers=auth(socio)).json()
+    assert len(lista) == 1 and lista[0]['estado'] == 'pendiente' and lista[0]['url_pago'] is None
+
+
+def test_listado_mas_nueva_primero(cliente, socio, fake):
+    comprar(cliente, socio)
+    comprar(cliente, socio, 'pack-8')
+    otro = db.crear_socio('Otro', 'otro@example.com')
+    comprar(cliente, otro)
+    lista = cliente.get('/compras', headers=auth(socio)).json()
+    assert [c['id'] for c in lista] == [2, 1]
+    assert fake.llamadas.count(('GET', '/pagos/pag_1')) == 0
+
+
+def test_webhook_aprueba_una_sola_vez(cliente, socio, fake):
+    comprar(cliente, socio)
+    fake.pagos['pag_1']['estado'] = 'aprobado'
+    for _ in range(2):
+        r = cliente.post('/webhooks/pagos', json={'pago_id': 'pag_1', 'estado': 'rechazado'})
+        assert r.status_code == 200 and r.json() == {'compra_id': 1, 'estado': 'aprobada'}
+    assert db.socio(socio['id'])['creditos'] == 12
+    correos = db.correos()
+    assert len(correos) == 1 and correos[0]['asunto'] == 'Compra de créditos aprobada'
+    assert correos[0]['para'] == 'ana@example.com'
+
+
+def test_webhook_rechazado_y_final(cliente, socio, fake):
+    comprar(cliente, socio)
+    fake.pagos['pag_1']['estado'] = 'rechazado'
+    assert cliente.post('/webhooks/pagos', json={'pago_id': 'pag_1'}).json()['estado'] == 'rechazada'
+    fake.pagos['pag_1']['estado'] = 'aprobado'
+    assert cliente.post('/webhooks/pagos', json={'pago_id': 'pag_1'}).json()['estado'] == 'rechazada'
+    assert db.socio(socio['id'])['creditos'] == 8 and db.correos() == []
+
+
+def test_webhook_pendiente_no_cambia(cliente, socio, fake):
+    comprar(cliente, socio)
+    r = cliente.post('/webhooks/pagos', json={'pago_id': 'pag_1', 'estado': 'aprobado'})
+    assert r.json()['estado'] == 'pendiente'
+    assert db.socio(socio['id'])['creditos'] == 8
+
+
+def test_webhook_errores(cliente, socio, fake):
+    assert cliente.post('/webhooks/pagos', json={}).status_code == 422
+    assert cliente.post('/webhooks/pagos', json={'pago_id': 'nada'}).status_code == 404
+    fake.pagos['pag_9'] = {'id': 'pag_9', 'estado': 'aprobado', 'referencia': 'otra-cosa', 'url_pago': 'x'}
+    assert cliente.post('/webhooks/pagos', json={'pago_id': 'pag_9'}).status_code == 404
+    fake.pagos['pag_8'] = {'id': 'pag_8', 'estado': 'aprobado', 'referencia': 'pulso-compra-55', 'url_pago': 'x'}
+    assert cliente.post('/webhooks/pagos', json={'pago_id': 'pag_8'}).status_code == 404
+    fake.caido = True
+    assert cliente.post('/webhooks/pagos', json={'pago_id': 'pag_1'}).status_code == 503
+
+
+def test_webhook_guarda_pago_de_compra_sin_pago(cliente, socio, fake):
+    compra = db.crear_compra(socio['id'], 'pack-4', 4, 1200, AHORA)
+    fake.pagos['pag_7'] = {'id': 'pag_7', 'estado': 'aprobado', 'monto': 1200, 'moneda': 'UYU',
+                           'referencia': f"pulso-compra-{compra['id']}", 'url_pago': 'https://pagar.cobra.uy/pag_7'}
+    r = cliente.post('/webhooks/pagos', json={'pago_id': 'pag_7'})
+    assert r.json() == {'compra_id': compra['id'], 'estado': 'aprobada'}
+    c = db.compra(compra['id'])
+    assert c['pago_id'] == 'pag_7' and c['url_pago'] == 'https://pagar.cobra.uy/pag_7'
+
+
+def test_conciliar_requiere_admin(cliente, fake):
+    assert cliente.post('/admin/conciliar-pagos').status_code == 401
+    assert cliente.post('/admin/conciliar-pagos', headers={'X-Admin-Key': 'mala'}).status_code == 401
+
+
+def test_conciliar(cliente, socio, fake):
+    otro = db.crear_socio('Otro', 'otro@example.com')
+    comprar(cliente, socio)  # 1 aprobada
+    comprar(cliente, otro)  # 2 rechazada
+    comprar(cliente, socio)  # 3 pendiente
+    fake.pagos['pag_1']['estado'] = 'aprobado'
+    fake.pagos['pag_2']['estado'] = 'rechazado'
+    viejo = reloj.ahora() - timedelta(minutes=30)
+    sin_pago_viejo = db.crear_compra(socio['id'], 'pack-4', 4, 1200, viejo)  # 4 rechazada
+    sin_pago_nuevo = db.crear_compra(socio['id'], 'pack-4', 4, 1200, reloj.ahora() - timedelta(minutes=29))  # 5
+    sin_pago_cae = db.crear_compra(socio['id'], 'pack-4', 4, 1200, viejo)  # 6 falla la búsqueda
+    fake.caer_busqueda.add(f"pulso-compra-{sin_pago_cae['id']}")
+    con_pago_oculto = db.crear_compra(socio['id'], 'pack-8', 8, 2200, viejo)  # 7 existe en Cobrá
+    fake.pagos['pag_70'] = {'id': 'pag_70', 'estado': 'aprobado', 'referencia': f"pulso-compra-{con_pago_oculto['id']}",
+                            'url_pago': 'https://pagar.cobra.uy/pag_70'}
+    r = cliente.post('/admin/conciliar-pagos', headers=ADMIN)
+    assert r.json() == {'aprobadas': 2, 'rechazadas': 2, 'pendientes': 3}
+    assert db.compra(sin_pago_viejo['id'])['estado'] == 'rechazada'
+    assert db.compra(sin_pago_nuevo['id'])['estado'] == 'pendiente'
+    assert db.compra(sin_pago_cae['id'])['estado'] == 'pendiente'
+    assert db.compra(con_pago_oculto['id'])['pago_id'] == 'pag_70'
+    assert db.socio(socio['id'])['creditos'] == 8 + 4 + 8
+    # Segunda pasada: las ya resueltas no cuentan ni repiten créditos.
+    r = cliente.post('/admin/conciliar-pagos', headers=ADMIN)
+    assert r.json() == {'aprobadas': 0, 'rechazadas': 0, 'pendientes': 3}
+    assert db.socio(socio['id'])['creditos'] == 20
+    assert len(db.correos()) == 2
+
+
+def test_conciliar_cobra_caido(cliente, socio, fake):
+    comprar(cliente, socio)
+    fake.caido = True
+    r = cliente.post('/admin/conciliar-pagos', headers=ADMIN)
+    assert r.json() == {'aprobadas': 0, 'rechazadas': 0, 'pendientes': 1}
