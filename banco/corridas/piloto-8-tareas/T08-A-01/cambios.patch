+def test_revalidacion(cliente, servicio):
+    for nombre in ('a', 'b', 'c', 'd'):
+        s = db.crear_socio(nombre, f'{nombre}@example.com')
+        servicio[url('acme', f'{nombre}%40example.com')] = None
+        db.activar_corporativo(s['id'], 'acme')
+    db.crear_socio('basico', 'x@example.com')
+    servicio[url('acme', 'a%40example.com')] = httpx.Response(200, json={'activo': True})
+    servicio[url('acme', 'b%40example.com')] = httpx.Response(200, json={'activo': False})
+    servicio[url('acme', 'c%40example.com')] = httpx.Response(404, json={'error': 'empleado_desconocido'})
+    servicio[url('acme', 'd%40example.com')] = httpx.Response(503)
+    r = cliente.post('/admin/revalidar-convenios', headers=ADMIN)
+    assert r.status_code == 200
+    assert r.json() == {'siguen': 1, 'bajaron': 2, 'sin_revisar': 1}
+    planes = {s: db.socio(i)['plan'] for i, s in enumerate('abcd', 1)}
+    assert planes == {'a': 'corporativo', 'b': 'basico', 'c': 'basico', 'd': 'corporativo'}
+    assert db.socio(2)['creditos'] == 12
+    assert asuntos().count('Se terminó tu plan corporativo') == 2
+    # Puede volver a activarlo.
+    servicio[url('acme', 'b%40example.com')] = httpx.Response(200, json={'activo': True})
+    assert cliente.post('/convenio', json={'empresa': 'acme'}, headers=auth(db.socio(2))).status_code == 200
