+import httpx
+import pytest
+
+from conftest import ADMIN, auth
+from pulso import db
+
+
+@pytest.fixture(autouse=True)
+def entorno(monkeypatch):
+    monkeypatch.setenv('PULSO_BENEFICIOS_URL', 'https://beneficios.test')
+    monkeypatch.setenv('PULSO_BENEFICIOS_CLAVE', 'clave-ben')
+
+
+@pytest.fixture
+def servicio(monkeypatch):
+    """Respuestas por email (en minúsculas decodificado); registra los pedidos."""
+    class S:
+        respuestas = {}
+        pedidos = []
+    s = S()
+    s.respuestas = {}
+    s.pedidos = []
+
+    def falso(url, headers=None, timeout=None):
+        s.pedidos.append((url, headers, timeout))
+        r = s.respuestas.get(url.rsplit('/', 1)[1], s.respuestas.get('*'))
+        if isinstance(r, Exception):
+            raise r
+        return r
+    monkeypatch.setattr(httpx, 'get', falso)
+    return s
+
+
+def resp(status, cuerpo=None):
+    return httpx.Response(status, json=cuerpo) if cuerpo is not None else httpx.Response(status, text='boom')
+
+
+ACTIVO = resp(200, {'activo': True})
+
+
+def activar(cliente, socio, empresa='acme'):
+    return cliente.post('/convenio', json={'empresa': empresa}, headers=auth(socio))
+
+
+def test_activa_y_sube_a_piso(cliente, socio, servicio):
+    servicio.respuestas['*'] = ACTIVO
+    r = activar(cliente, socio)
+    assert r.status_code == 200
+    assert r.json() == {'plan': 'corporativo', 'empresa': 'acme', 'creditos': 12}
+    assert [c['asunto'] for c in db.correos()] == ['Ya tenés el plan corporativo']
+    assert cliente.get('/yo', headers=auth(socio)).json()['plan'] == 'corporativo'
+
+
+def test_no_baja_ni_suma_creditos(cliente, servicio):
+    servicio.respuestas['*'] = ACTIVO
+    s = db.crear_socio('Bea', 'bea@example.com', creditos=20)
+    assert activar(cliente, s).json()['creditos'] == 20
+
+
+def test_email_en_minusculas_y_codificado(cliente, servicio):
+    servicio.respuestas['*'] = ACTIVO
+    s = db.crear_socio('Ana', 'Ana.Perez+Gym@Example.com')
+    activar(cliente, s)
+    url, headers, timeout = servicio.pedidos[0]
+    assert url == 'https://beneficios.test/empresas/acme/empleados/ana.perez%2Bgym%40example.com'
+    assert headers['X-Api-Key'] == 'clave-ben'
+    assert timeout == 3.0
+
+
+def test_validaciones(cliente, socio, servicio):
+    assert cliente.post('/convenio', json={'empresa': 'acme'}).status_code == 401
+    for cuerpo in ({}, {'empresa': ''}, {'empresa': '  '}):
+        assert cliente.post('/convenio', json=cuerpo, headers=auth(socio)).status_code == 422
+    assert servicio.pedidos == []
+
+
+@pytest.mark.parametrize('respuesta,codigo', [
+    (resp(200, {'activo': False}), 409),
+    (resp(404, {'error': 'empleado_desconocido'}), 409),
+    (resp(404, {'error': 'empresa_desconocida'}), 404),
+    (resp(401, {'error': 'clave_invalida'}), 503),
+    (resp(500), 503),
+    (resp(404), 503),
+    (resp(200, {'otro': 1}), 503),
+    (httpx.ConnectError('x'), 503),
+    (httpx.ReadTimeout('x'), 503),
+])
+def test_sin_activar(cliente, socio, servicio, respuesta, codigo):
+    servicio.respuestas['*'] = respuesta
+    assert activar(cliente, socio).status_code == codigo
+    assert db.socio(socio['id'])['plan'] == 'basico'
+    assert db.socio(socio['id'])['creditos'] == 8
+    assert db.correos() == []
+
+
+def test_ya_corporativo_409(cliente, socio, servicio):
+    servicio.respuestas['*'] = ACTIVO
+    activar(cliente, socio)
+    assert activar(cliente, socio, 'otra').status_code == 409
+    s = db.socio(socio['id'])
+    assert (s['empresa'], s['creditos']) == ('acme', 12)
+    assert len(db.correos()) == 1
+
+
+def test_revalidacion(cliente, servicio):
+    servicio.respuestas.update({
+        'a%40x.com': ACTIVO,
+        'b%40x.com': resp(200, {'activo': False}),
+        'c%40x.com': resp(404, {'error': 'empresa_desconocida'}),
+        'd%40x.com': resp(503),
+        'e%40x.com': resp(404, {'error': 'empleado_desconocido'}),
+    })
+    for n in 'abcde':
+        s = db.crear_socio(n, f'{n}@x.com', creditos=15)
+        assert db.activar_corporativo(s['id'], 'acme')
+    basico = db.crear_socio('f', 'f@x.com')
+    assert cliente.post('/admin/revalidar-convenios').status_code == 401
+    r = cliente.post('/admin/revalidar-convenios', headers=ADMIN)
+    assert r.status_code == 200
+    assert r.json() == {'siguen': 1, 'bajaron': 3, 'sin_revisar': 1}
+    planes = {s['nombre']: s['plan'] for s in db.corporativos()}
+    assert planes == {'a': 'corporativo', 'd': 'corporativo'}
+    assert db.socio(2)['plan'] == 'basico' and db.socio(2)['creditos'] == 15
+    assert sorted(c['para'] for c in db.correos()) == ['b@x.com', 'c@x.com', 'e@x.com']
+    assert {c['asunto'] for c in db.correos()} == {'Se terminó tu plan corporativo'}
+    assert len(servicio.pedidos) == 5 and basico['plan'] == 'basico'
+
+
+def test_reactivar_tras_baja(cliente, socio, servicio):
+    servicio.respuestas['*'] = ACTIVO
+    activar(cliente, socio)
+    servicio.respuestas['*'] = resp(200, {'activo': False})
+    cliente.post('/admin/revalidar-convenios', headers=ADMIN)
+    servicio.respuestas['*'] = ACTIVO
+    assert activar(cliente, socio, 'beta').json()['empresa'] == 'beta'
+
+
+def test_revalidacion_todo_falla(cliente, socio, servicio):
+    db.activar_corporativo(socio['id'], 'acme')
+    servicio.respuestas['*'] = httpx.ConnectError('x')
+    r = cliente.post('/admin/revalidar-convenios', headers=ADMIN)
+    assert r.status_code == 200 and r.json() == {'siguen': 0, 'bajaron': 0, 'sin_revisar': 1}
