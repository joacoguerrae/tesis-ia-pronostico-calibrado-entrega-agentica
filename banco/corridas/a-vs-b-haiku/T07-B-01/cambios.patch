+# --- Compras de créditos con Cobrá ---
+
+def comprar(cliente, socio, pack='pack-4'):
+    r = cliente.post('/compras', json={'pack': pack}, headers=auth(socio))
+    assert r.status_code == 201, r.text
+    return r.json()
+
+
+def creditos(cliente, socio):
+    return cliente.get('/yo', headers=auth(socio)).json()['creditos']
+
+
+def conciliar(cliente):
+    r = cliente.post('/admin/conciliar-pagos', headers=ADMIN)
+    assert r.status_code == 200
+    return r.json()
+
+
+def test_compra_crea_pago_en_cobra_y_devuelve_url(cliente, socio, cobra):
+    r = cliente.post('/compras', json={'pack': 'pack-8'}, headers=auth(socio))
+    assert r.status_code == 201
+    assert r.json() == {'id': 1, 'pack': 'pack-8', 'creditos': 8, 'monto': 2200, 'estado': 'pendiente',
+                        'creada': '2026-11-10T15:00:00+00:00', 'url_pago': 'https://pagar.cobra.test/pag_1'}
+    assert cobra.creaciones == [('pulso-compra-1', {'monto': 2200, 'moneda': 'UYU', 'referencia': 'pulso-compra-1'})]
+    assert creditos(cliente, socio) == 8  # los créditos recién se suman cuando el pago se aprueba
+
+
+def test_pack_invalido_no_crea_nada(cliente, socio, cobra):
+    for cuerpo in ({'pack': 'pack-99'}, {}):
+        assert cliente.post('/compras', json=cuerpo, headers=auth(socio)).status_code == 422
+    assert cobra.creaciones == []
+    assert cliente.get('/compras', headers=auth(socio)).json() == []
+
+
+def test_compra_sin_token(cliente, cobra):
+    assert cliente.post('/compras', json={'pack': 'pack-4'}).status_code == 401
+
+
+def test_cobra_caido_al_crear_deja_compra_pendiente_sin_pago(cliente, socio, cobra):
+    cobra.caido = True
+    assert cliente.post('/compras', json={'pack': 'pack-4'}, headers=auth(socio)).status_code == 502
+    [compra] = cliente.get('/compras', headers=auth(socio)).json()
+    assert compra['estado'] == 'pendiente'
+    assert compra['url_pago'] is None
