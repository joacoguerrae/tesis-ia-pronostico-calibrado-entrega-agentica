diff --git a/pulso/db.py b/pulso/db.py
index 59841ac..aa33e77 100644
--- a/pulso/db.py
+++ b/pulso/db.py
@@ -29,6 +29,10 @@ CREATE TABLE IF NOT EXISTS reservas (
     estado TEXT NOT NULL,
     creada TEXT NOT NULL
 );
+CREATE TABLE IF NOT EXISTS recordatorios (
+    reserva_id INTEGER PRIMARY KEY REFERENCES reservas(id),
+    enviado TEXT NOT NULL
+);
 CREATE TABLE IF NOT EXISTS correos (
     id INTEGER PRIMARY KEY,
     para TEXT NOT NULL,
@@ -136,3 +140,21 @@ def sumar_creditos(socio_id, cantidad):
 
 def correos():
     return _varias('SELECT * FROM correos ORDER BY id')
+
+
+def reservas_a_recordar(desde, hasta):
+    """Reservas confirmadas sin recordatorio cuya clase empieza en (desde, hasta]."""
+    filas = _varias(
+        "SELECT r.id AS reserva_id, r.socio_id, c.nombre, c.instructor, c.inicio FROM reservas r "
+        "JOIN clases c ON c.id = r.clase_id "
+        "WHERE r.estado = 'confirmada' AND r.id NOT IN (SELECT reserva_id FROM recordatorios) "
+        "ORDER BY c.inicio, r.id")
+    return [f for f in filas if desde < a_fecha(f['inicio']) <= hasta]
+
+
+def marcar_recordatorio(reserva_id, momento):
+    """Registra el recordatorio; devuelve False si la reserva ya tenía uno."""
+    with conexion() as con:
+        cur = con.execute('INSERT OR IGNORE INTO recordatorios (reserva_id, enviado) VALUES (?, ?)',
+                          (reserva_id, a_texto(momento)))
+    return cur.rowcount == 1
diff --git a/pulso/main.py b/pulso/main.py
index 039212d..81a0f4e 100644
--- a/pulso/main.py
+++ b/pulso/main.py
@@ -1,4 +1,5 @@
 import os
+from datetime import timedelta
 
 from fastapi import APIRouter, Depends, FastAPI, Header, HTTPException
 from pydantic import AwareDatetime, BaseModel, Field
@@ -92,6 +93,21 @@ def yo(socio=Depends(socio_actual)):
     return {k: socio[k] for k in ('id', 'nombre', 'email', 'plan', 'creditos')}
 
 
+@router.post('/admin/recordatorios', dependencies=[Depends(admin)])
+def enviar_recordatorios():
+    ahora = reloj.ahora()
+    enviados = 0
+    for r in db.reservas_a_recordar(ahora, ahora + timedelta(hours=24)):
+        if not db.marcar_recordatorio(r['reserva_id'], ahora):
+            continue
+        socio = db.socio(r['socio_id'])
+        correo.enviar(socio['email'],
+                      f"Recordatorio: {r['nombre']} el {correo.fecha_y_hora(db.a_fecha(r['inicio']))}",
+                      f"Hola {socio['nombre']}, mañana te esperamos en {r['nombre']} con {r['instructor']}.")
+        enviados += 1
+    return {'enviados': enviados}
+
+
 def crear_app():
     db.inicializar()
     app = FastAPI(title='Pulso')
