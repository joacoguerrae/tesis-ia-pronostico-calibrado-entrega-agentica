+import json
+from datetime import timedelta
+
+import httpx
+import pytest
+
+from conftest import ADMIN, AHORA, auth
+from pulso import cobra, db, reloj
+
+URL = 'https://api.cobra.test/v1'
+CLAVE = 'clave-cobra'
+
+
+class CobraFalso:
+    """Imita la API de Cobrá.
+
+    `falla`: 'red' o 'error' (500) hace fallar todos los pedidos.
+    `falla_en`: ids de pago cuya consulta por id devuelve 500.
+    """
+
+    def __init__(self):
+        self.pagos = {}
+        self.por_clave = {}
+        self.falla = None
+        self.falla_en = set()
+        self.creados = 0
+        self.pedidos = []  # (método, ruta, Idempotency-Key)
+
+    def handler(self, request):
+        if self.falla == 'red':
+            raise httpx.ConnectError('conexión rechazada', request=request)
+        if self.falla == 'error':
+            return httpx.Response(500, request=request)
+        if request.headers.get('X-Cobra-Clave') != CLAVE:
+            return httpx.Response(401, request=request)
+        ruta = request.url.path.removeprefix('/v1')
+        self.pedidos.append((request.method, request.url.path, request.headers.get('Idempotency-Key')))
+        if request.method == 'POST' and ruta == '/pagos':
+            clave = request.headers.get('Idempotency-Key')
+            if not clave:
+                return httpx.Response(422, request=request)
+            codigo, pago = self.crear(clave, json.loads(request.read()))
+            return httpx.Response(codigo, json=pago)
+        if request.method == 'GET' and ruta == '/pagos':
+            ref = request.url.params.get('referencia')
+            return httpx.Response(200, json={'pagos': [p for p in self.pagos.values() if p['referencia'] == ref]})
+        if request.method == 'GET' and ruta.startswith('/pagos/'):
+            pago_id = ruta.removeprefix('/pagos/')
+            if pago_id in self.falla_en:
+                return httpx.Response(500, request=request)
+            pago = self.pagos.get(pago_id)
+            return httpx.Response(200, json=pago) if pago else httpx.Response(404, request=request)
+        return httpx.Response(404, request=request)
+
+    def crear(self, clave, datos):
+        """Crea un pago. Con una clave ya usada devuelve el pago existente (200), como Cobrá."""
+        if clave in self.por_clave:
+            return 200, self.pagos[self.por_clave[clave]]
+        self.creados += 1
+        pago_id = f'pag_{self.creados}'
+        pago = {'id': pago_id, 'estado': 'pendiente', 'monto': datos['monto'], 'moneda': datos['moneda'],
+                'referencia': datos['referencia'], 'url_pago': f'https://pagar.cobra.uy/{pago_id}'}
+        self.pagos[pago_id] = pago
+        self.por_clave[clave] = pago_id
+        return 201, pago
+
+    def pagar(self, pago_id, estado):
+        self.pagos[pago_id]['estado'] = estado
+
+    def crear_sin_avisar(self, referencia, monto=1200):
+        """Cobrá creó el pago pero la respuesta a Pulso se perdió."""
+        self.crear(referencia, {'monto': monto, 'moneda': 'UYU', 'referencia': referencia})
+
+
+@pytest.fixture
+def cobra_falsa(cliente, monkeypatch):
+    monkeypatch.setenv('PULSO_PAGOS_URL', URL)
+    monkeypatch.setenv('PULSO_PAGOS_CLAVE', CLAVE)
+    falsa = CobraFalso()
+    monkeypatch.setattr(cobra, '_cliente',
+                        lambda: httpx.Client(transport=httpx.MockTransport(falsa.handler)))
+    return falsa
+
+
+def comprar(cliente, socio, pack='pack-4'):
+    return cliente.post('/compras', json={'pack': pack}, headers=auth(socio))
+
+
+def pagar_en_cobra(cliente, socio, cobra_falsa, estado, pack='pack-4'):
+    """Compra y deja el pago en el estado dado en Cobrá. Devuelve el id de la compra."""
+    compra = comprar(cliente, socio, pack).json()
+    cobra_falsa.pagar(f"pag_{compra['id']}", estado)
+    return compra['id']
+
+
+# --- Compra ---
+
+def test_compra_crea_pago_en_cobra(cliente, socio, cobra_falsa):
+    r = comprar(cliente, socio)
+    assert r.status_code == 201
+    datos = r.json()
+    assert datos == {'id': 1, 'pack': 'pack-4', 'creditos': 4, 'monto': 1200, 'estado': 'pendiente',
+                     'creada': '2026-11-10T15:00:00+00:00', 'url_pago': 'https://pagar.cobra.uy/pag_1'}
+    [pago] = cobra_falsa.pagos.values()
+    assert pago['monto'] == 1200 and pago['moneda'] == 'UYU' and pago['referencia'] == 'pulso-compra-1'
+    assert cobra_falsa.pedidos == [('POST', '/v1/pagos', 'pulso-compra-1')]
+
+
+def test_pack_8_cuesta_2200(cliente, socio, cobra_falsa):
+    r = comprar(cliente, socio, 'pack-8')
+    assert r.json()['creditos'] == 8 and r.json()['monto'] == 2200
+    assert list(cobra_falsa.pagos.values())[0]['monto'] == 2200
+
+
+@pytest.mark.parametrize('cuerpo', [{'pack': 'pack-99'}, {'pack': None}, {}])
+def test_pack_invalido_no_crea_nada(cliente, socio, cobra_falsa, cuerpo):
+    r = cliente.post('/compras', json=cuerpo, headers=auth(socio))
+    assert r.status_code == 422
+    assert db.compras_de(socio['id']) == []
+    assert cobra_falsa.pagos == {}
+
+
+def test_compra_sin_token(cliente, cobra_falsa):
+    assert cliente.post('/compras', json={'pack': 'pack-4'}).status_code == 401
+
+
+@pytest.mark.parametrize('falla', ['red', 'error'])
+def test_cobra_caido_al_crear_deja_compra_pendiente_sin_pago(cliente, socio, cobra_falsa, falla):
+    cobra_falsa.falla = falla
+    assert comprar(cliente, socio).status_code == 502
+    [compra] = cliente.get('/compras', headers=auth(socio)).json()
+    assert compra['estado'] == 'pendiente' and compra['url_pago'] is None
+
+
+def test_cobra_con_clave_mala_es_falla(cliente, socio, monkeypatch, cobra_falsa):
+    monkeypatch.setenv('PULSO_PAGOS_CLAVE', 'otra')
+    assert comprar(cliente, socio).status_code == 502
+
+
+def test_mis_compras_mas_nueva_primero_y_solo_las_mias(cliente, socio, cobra_falsa):
+    otro = db.crear_socio('Juan Gómez', 'juan@example.com')
+    comprar(cliente, socio, 'pack-4')
+    reloj.fijar(AHORA + timedelta(minutes=5))
+    comprar(cliente, socio, 'pack-8')
+    comprar(cliente, otro, 'pack-4')
+    r = cliente.get('/compras', headers=auth(socio))
+    assert r.status_code == 200
+    assert [c['pack'] for c in r.json()] == ['pack-8', 'pack-4']
+    assert cliente.get('/compras').status_code == 401
+
+
+# --- Webhook ---
+
+def webhook(cliente, pago_id, **extra):
+    return cliente.post('/webhooks/pagos', json={'pago_id': pago_id, **extra})
+
+
+def test_webhook_aprobado_suma_creditos_y_manda_correo(cliente, socio, cobra_falsa):
+    compra_id = pagar_en_cobra(cliente, socio, cobra_falsa, 'aprobado')
+    r = webhook(cliente, f'pag_{compra_id}', estado='aprobado')
+    assert r.status_code == 200
+    assert r.json() == {'compra_id': compra_id, 'estado': 'aprobada'}
+    assert cliente.get('/yo', headers=auth(socio)).json()['creditos'] == 8 + 4
+    [correo] = db.correos()
+    assert correo['para'] == 'ana@example.com'
+    assert correo['asunto'] == 'Compra de créditos aprobada'
+
+
+def test_webhook_rechazado_no_suma_ni_manda_correo(cliente, socio, cobra_falsa):
+    compra_id = pagar_en_cobra(cliente, socio, cobra_falsa, 'rechazado')
+    r = webhook(cliente, f'pag_{compra_id}')
+    assert r.json() == {'compra_id': compra_id, 'estado': 'rechazada'}
+    assert cliente.get('/yo', headers=auth(socio)).json()['creditos'] == 8
+    assert db.correos() == []
+
+
+def test_webhook_pendiente_no_cambia_nada(cliente, socio, cobra_falsa):
+    compra_id = pagar_en_cobra(cliente, socio, cobra_falsa, 'pendiente')
+    assert webhook(cliente, f'pag_{compra_id}').json() == {'compra_id': compra_id, 'estado': 'pendiente'}
+    assert db.correos() == []
+
+
+def test_webhook_repetido_suma_una_sola_vez(cliente, socio, cobra_falsa):
+    compra_id = pagar_en_cobra(cliente, socio, cobra_falsa, 'aprobado')
+    for _ in range(3):
+        assert webhook(cliente, f'pag_{compra_id}').status_code == 200
+    assert cliente.get('/yo', headers=auth(socio)).json()['creditos'] == 12
+    assert len(db.correos()) == 1
+
+
+def test_webhook_ignora_el_estado_del_cuerpo(cliente, socio, cobra_falsa):
+    compra_id = pagar_en_cobra(cliente, socio, cobra_falsa, 'pendiente')
+    r = webhook(cliente, f'pag_{compra_id}', estado='aprobado')
+    assert r.json()['estado'] == 'pendiente'
+    assert cliente.get('/yo', headers=auth(socio)).json()['creditos'] == 8
+
+
+def test_webhook_no_cambia_compra_ya_rechazada(cliente, socio, cobra_falsa):
+    compra_id = pagar_en_cobra(cliente, socio, cobra_falsa, 'rechazado')
+    webhook(cliente, f'pag_{compra_id}')
+    cobra_falsa.pagar(f'pag_{compra_id}', 'aprobado')
+    assert webhook(cliente, f'pag_{compra_id}').json()['estado'] == 'rechazada'
+    assert cliente.get('/yo', headers=auth(socio)).json()['creditos'] == 8
+
+
+def test_webhook_guarda_pago_a_compra_sin_pago(cliente, socio, cobra_falsa):
+    cobra_falsa.falla = 'error'
+    comprar(cliente, socio)
+    cobra_falsa.falla = None
+    cobra_falsa.crear_sin_avisar('pulso-compra-1')
+    cobra_falsa.pagar('pag_1', 'aprobado')
+    r = webhook(cliente, 'pag_1')
+    assert r.json() == {'compra_id': 1, 'estado': 'aprobada'}
+    [compra] = cliente.get('/compras', headers=auth(socio)).json()
+    assert compra['url_pago'] == 'https://pagar.cobra.uy/pag_1'
+
+
+def test_webhook_pago_desconocido_es_404(cliente, cobra_falsa):
+    assert webhook(cliente, 'pag_nada').status_code == 404
+
+
+def test_webhook_pago_de_otra_referencia_es_404(cliente, cobra_falsa):
+    cobra_falsa.pagos['pag_x'] = {'id': 'pag_x', 'estado': 'aprobado', 'monto': 1, 'moneda': 'UYU',
+                                  'referencia': 'otra-cosa', 'url_pago': 'u'}
+    assert webhook(cliente, 'pag_x').status_code == 404
+
+
+def test_webhook_compra_inexistente_es_404(cliente, cobra_falsa):
+    cobra_falsa.pagos['pag_x'] = {'id': 'pag_x', 'estado': 'aprobado', 'monto': 1, 'moneda': 'UYU',
+                                  'referencia': 'pulso-compra-999', 'url_pago': 'u'}
+    assert webhook(cliente, 'pag_x').status_code == 404
+
+
+@pytest.mark.parametrize('falla', ['red', 'error'])
+def test_webhook_cobra_caido_es_503_y_no_cambia_nada(cliente, socio, cobra_falsa, falla):
+    compra_id = pagar_en_cobra(cliente, socio, cobra_falsa, 'aprobado')
+    cobra_falsa.falla = falla
+    assert webhook(cliente, f'pag_{compra_id}').status_code == 503
+    cobra_falsa.falla = None
+    assert cliente.get('/compras', headers=auth(socio)).json()[0]['estado'] == 'pendiente'
+    assert cliente.get('/yo', headers=auth(socio)).json()['creditos'] == 8
+
+
+def test_webhook_sin_pago_id_es_422(cliente, cobra_falsa):
+    assert cliente.post('/webhooks/pagos', json={'estado': 'aprobado'}).status_code == 422
+
+
+# --- Conciliación ---
+
+def conciliar(cliente, clave=ADMIN):
+    return cliente.post('/admin/conciliar-pagos', headers=clave)
+
+
+def test_conciliar_requiere_clave_de_admin(cliente, cobra_falsa):
+    assert cliente.post('/admin/conciliar-pagos').status_code == 401
+    assert cliente.post('/admin/conciliar-pagos', headers={'X-Admin-Key': 'mala'}).status_code == 401
+
+
+def test_conciliar_aplica_estados_de_todos_los_socios(cliente, socio, cobra_falsa):
+    otro = db.crear_socio('Juan Gómez', 'juan@example.com')
+    pagar_en_cobra(cliente, socio, cobra_falsa, 'aprobado')
+    pagar_en_cobra(cliente, otro, cobra_falsa, 'rechazado')
+    pagar_en_cobra(cliente, socio, cobra_falsa, 'pendiente')
+    r = conciliar(cliente)
+    assert r.status_code == 200
+    assert r.json() == {'aprobadas': 1, 'rechazadas': 1, 'pendientes': 1}
+    assert cliente.get('/yo', headers=auth(socio)).json()['creditos'] == 12
+    assert len(db.correos()) == 1
+
+
+def test_conciliar_no_cuenta_ni_repite_las_ya_resueltas(cliente, socio, cobra_falsa):
+    pagar_en_cobra(cliente, socio, cobra_falsa, 'aprobado')
+    assert conciliar(cliente).json() == {'aprobadas': 1, 'rechazadas': 0, 'pendientes': 0}
+    assert conciliar(cliente).json() == {'aprobadas': 0, 'rechazadas': 0, 'pendientes': 0}
+    assert cliente.get('/yo', headers=auth(socio)).json()['creditos'] == 12
+    assert len(db.correos()) == 1
