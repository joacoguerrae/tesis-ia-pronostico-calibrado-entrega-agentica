@@ -27,3 +33,54 @@ def socio(cliente):
 
 def auth(socio):
     return {'Authorization': f"Bearer {socio['token']}"}
+
+
+class FakeBeneficios:
+    """Servicio de beneficios falso, con HTTP real en localhost. `responder(empresa, email)` devuelve (status, cuerpo)."""
+
+    def __init__(self):
+        self.responder = lambda empresa, email: (200, {'activo': True})
+        self.pedidos = []    # path tal como llega
+        self.recibidos = []  # (empresa, email) decodificados como los decodifica el servicio real
+
+
+@pytest.fixture
+def beneficios(monkeypatch):
+    fake = FakeBeneficios()
+
+    class Handler(BaseHTTPRequestHandler):
+        def do_GET(self):
+            fake.pedidos.append(self.path)
+            if self.headers.get('X-Api-Key') != CLAVE_BENEFICIOS:
+                return self._responder(401, {'error': 'clave_invalida'})
+            _, _, empresa, _, email = self.path.split('/')
+            # El servicio decodifica el path como formulario: un + sin codificar llega como espacio.
+            empresa, email = unquote(empresa), unquote_plus(email)
+            fake.recibidos.append((empresa, email))
+            self._responder(*fake.responder(empresa, email))
+
+        def _responder(self, status, cuerpo):
+            datos = cuerpo.encode() if isinstance(cuerpo, str) else json.dumps(cuerpo).encode()
+            self.send_response(status)
+            self.send_header('Content-Type', 'application/json')
+            self.send_header('Content-Length', str(len(datos)))
+            self.end_headers()
+            self.wfile.write(datos)
+
+        def log_message(self, *args):
+            pass
+
+    servidor = ThreadingHTTPServer(('127.0.0.1', 0), Handler)
+    servidor.daemon_threads = True
+    threading.Thread(target=servidor.serve_forever, kwargs={'poll_interval': 0.01}, daemon=True).start()
+    monkeypatch.setenv('PULSO_BENEFICIOS_URL', f'http://127.0.0.1:{servidor.server_address[1]}')
+    monkeypatch.setenv('PULSO_BENEFICIOS_CLAVE', CLAVE_BENEFICIOS)
+    yield fake
+    servidor.shutdown()
+    servidor.server_close()
+
+
+def puerto_cerrado():
+    with socket.socket() as s:
+        s.bind(('127.0.0.1', 0))
+        return s.getsockname()[1]
