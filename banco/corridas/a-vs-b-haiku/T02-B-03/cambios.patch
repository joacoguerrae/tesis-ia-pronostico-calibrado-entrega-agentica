+def inicio_del_dia(dia: date):
+    """Medianoche de `dia` en hora de Montevideo."""
+    return datetime.combine(dia, time(0), tzinfo=MONTEVIDEO)
+
+
 def fijar(momento):
     global _fija
     _fija = momento
