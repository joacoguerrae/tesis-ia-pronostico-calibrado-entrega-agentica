+from datetime import datetime, timezone
+
+import pytest
+
+from conftest import ADMIN, AHORA, auth
+from pulso import db, reloj
+
+# Martes 10/11/2026 en Montevideo: 19:00 de Montevideo son las 22:00 UTC.
+SERIE = {'nombre': 'Yoga', 'instructor': 'Sofía', 'dia': 'martes', 'hora': '19:00', 'duracion_min': 60,
+         'cupo': 15, 'desde': '2026-11-10', 'hasta': '2026-11-24'}
+
+
+def crear_serie(cliente, **cambios):
+    r = cliente.post('/admin/series', json=dict(SERIE, **cambios), headers=ADMIN)
+    assert r.status_code == 201, r.text
+    return r.json()
+
+
+def cambiar_serie(cliente, serie_id, **datos):
+    return cliente.patch(f'/admin/series/{serie_id}', json=datos, headers=ADMIN)
+
+
+def inicios(serie):
+    return [c['inicio'] for c in serie['clases']]
+
+
+def test_crea_una_clase_por_semana_en_el_dia_y_hora_de_la_serie(cliente):
+    serie = crear_serie(cliente)
+    assert serie['desde'] == '2026-11-10' and serie['hasta'] == '2026-11-24'
+    assert inicios(serie) == ['2026-11-10T22:00:00+00:00', '2026-11-17T22:00:00+00:00',
+                              '2026-11-24T22:00:00+00:00']
+    for clase in serie['clases']:
+        assert clase['serie_id'] == serie['id']
+        assert clase['estado'] == 'programada'
+        assert clase['lugares_libres'] == 15
+        assert clase['nombre'] == 'Yoga' and clase['instructor'] == 'Sofía'
+    assert len(db.clases()) == 3
+
+
+def test_no_crea_clases_en_dias_de_cierre(cliente):
+    # Viernes 25/12/2026 y viernes 1/1/2027 son días de cierre: la serie de viernes no tiene clase esas semanas.
+    serie = crear_serie(cliente, dia='viernes', hora='10:00', desde='2026-12-18', hasta='2027-01-08')
+    assert inicios(serie) == ['2026-12-18T13:00:00+00:00', '2027-01-08T13:00:00+00:00']
+
+
+def test_serie_solo_en_dias_de_cierre_no_tiene_clases(cliente):
+    serie = crear_serie(cliente, dia='viernes', hora='10:00', desde='2026-12-25', hasta='2027-01-01')
+    assert serie['clases'] == []
+
+
+def test_no_crea_clase_el_8_de_febrero(cliente):
+    serie = crear_serie(cliente, dia='lunes', desde='2027-02-01', hasta='2027-02-15')
+    assert inicios(serie) == ['2027-02-01T22:00:00+00:00', '2027-02-15T22:00:00+00:00']
+
+
+def test_no_crea_clases_que_ya_empezaron(cliente):
+    # AHORA es martes 10/11 a las 12:00 de Montevideo: la clase de las 12:00 de hoy ya empieza "en este momento".
+    serie = crear_serie(cliente, hora='12:00', desde='2026-11-10', hasta='2026-11-17')
+    assert inicios(serie) == ['2026-11-17T15:00:00+00:00']
+
+
+def test_serie_sin_clases_es_valida(cliente):
