+from datetime import datetime, timedelta, timezone
+
+from fastapi.testclient import TestClient
+
+from conftest import ADMIN, AHORA, auth
+from pulso import db, reloj
+
+INICIO = datetime(2026, 11, 12, 22, 0, tzinfo=timezone.utc)  # 12/11 a las 19:00 en Montevideo
+
+
+def reservada(cliente, socio, clase):
+    r = cliente.post('/reservas', json={'clase_id': clase['id']}, headers=auth(socio))
+    assert r.status_code == 201
+    return r.json()
+
+
+def en_lista(cliente, socio, clase):
+    r = cliente.post(f"/clases/{clase['id']}/espera", headers=auth(socio))
+    assert r.status_code == 201
+    return r.json()
+
+
+def correos_a(email):
+    return [c for c in db.correos() if c['para'] == email]
+
+
+def test_cancelar_requiere_clave_de_admin(cliente, socio):
+    clase = db.crear_clase('Spinning', 'Leo', INICIO)
+    reserva = reservada(cliente, socio, clase)
+    assert cliente.post(f"/admin/reservas/{reserva['id']}/cancelar").status_code == 401
+    assert cliente.post(f"/admin/reservas/{reserva['id']}/cancelar", headers={'X-Admin-Key': 'otra'}).status_code == 401
+    assert cliente.get('/reservas', headers=auth(socio)).json()[0]['estado'] == 'confirmada'
+
+
+def test_cancelar_reserva_inexistente(cliente):
+    assert cliente.post('/admin/reservas/99/cancelar', headers=ADMIN).status_code == 404
+
+
+def test_cancelar_marca_la_reserva_y_devuelve_el_credito(cliente, socio):
+    clase = db.crear_clase('Spinning', 'Leo', INICIO)
+    reserva = reservada(cliente, socio, clase)
+    r = cliente.post(f"/admin/reservas/{reserva['id']}/cancelar", headers=ADMIN)
+    assert r.status_code == 200
+    assert r.json() == {'id': reserva['id'], 'clase_id': clase['id'], 'estado': 'cancelada',
+                        'creada': reserva['creada']}
+    assert cliente.get('/reservas', headers=auth(socio)).json()[0]['estado'] == 'cancelada'
+    assert cliente.get('/yo', headers=auth(socio)).json()['creditos'] == 8
+
+    # Ya cancelada: 409, sin otro crédito.
+    assert cliente.post(f"/admin/reservas/{reserva['id']}/cancelar", headers=ADMIN).status_code == 409
+    assert cliente.get('/yo', headers=auth(socio)).json()['creditos'] == 8
+
+
+def test_cancelar_clase_empezada_devuelve_credito_sin_asignar(cliente, socio):
+    clase = db.crear_clase('Spinning', 'Leo', AHORA + timedelta(hours=2), cupo=1)
+    reserva = reservada(cliente, socio, clase)
+    beto = db.crear_socio('Beto Silva', 'beto@example.com')
+    en_lista(cliente, beto, clase)
+
+    reloj.fijar(AHORA + timedelta(hours=3))
+    assert cliente.post(f"/admin/reservas/{reserva['id']}/cancelar", headers=ADMIN).status_code == 200
+    assert cliente.get('/yo', headers=auth(socio)).json()['creditos'] == 8
+    assert cliente.get(f"/clases/{clase['id']}").json()['lugares_libres'] == 1
+    assert cliente.get(f"/clases/{clase['id']}/espera", headers=auth(beto)).json()['posicion'] == 1
+    assert db.tiene_reserva_confirmada(beto['id'], clase['id']) is False
+    assert correos_a('beto@example.com') == []
+
+
+def test_cancelar_libera_el_lugar_al_primero_de_la_lista(cliente, socio):
+    clase = db.crear_clase('Spinning', 'Leo', INICIO, cupo=1)
+    reserva = reservada(cliente, socio, clase)
+    beto = db.crear_socio('Beto Silva', 'beto@example.com')
+    carla = db.crear_socio('Carla Ruiz', 'carla@example.com')
+    en_lista(cliente, beto, clase)
+    en_lista(cliente, carla, clase)
+
+    assert cliente.post(f"/admin/reservas/{reserva['id']}/cancelar", headers=ADMIN).status_code == 200
+
+    # El lugar ya es de Beto cuando vuelve la respuesta.
+    mis = cliente.get('/reservas', headers=auth(beto)).json()
+    assert [(x['clase_id'], x['estado']) for x in mis] == [(clase['id'], 'confirmada')]
+    assert cliente.get('/yo', headers=auth(beto)).json()['creditos'] == 7
+    assert cliente.get(f"/clases/{clase['id']}/espera", headers=auth(beto)).status_code == 404
+    assert cliente.get(f"/clases/{clase['id']}/espera", headers=auth(carla)).json()['posicion'] == 1
+    assert cliente.get(f"/clases/{clase['id']}").json()['lugares_libres'] == 0
+
+    # Beto recibe el correo de lugar liberado, no el de reserva confirmada.
+    [correo_beto] = correos_a('beto@example.com')
+    assert correo_beto['asunto'] == 'Se liberó un lugar: Spinning el 12/11 a las 19:00'
+    assert correos_a('carla@example.com') == []
+
+
+def test_si_falla_a_mitad_de_la_cancelacion_no_queda_nada_a_medias(cliente, socio, monkeypatch):
+    clase = db.crear_clase('Spinning', 'Leo', INICIO, cupo=1)
+    reserva = reservada(cliente, socio, clase)
+    beto = db.crear_socio('Beto Silva', 'beto@example.com')
+    en_lista(cliente, beto, clase)
+
+    def correo_roto(*args, **kwargs):
+        raise RuntimeError('falló la base')
+    monkeypatch.setattr('pulso.correo.enviar', correo_roto)
+    cliente_sin_errores = TestClient(cliente.app, raise_server_exceptions=False)
+    assert cliente_sin_errores.post(f"/admin/reservas/{reserva['id']}/cancelar", headers=ADMIN).status_code == 500
+
+    assert cliente.get('/reservas', headers=auth(socio)).json()[0]['estado'] == 'confirmada'
+    assert cliente.get('/yo', headers=auth(socio)).json()['creditos'] == 7
+    assert cliente.get(f"/clases/{clase['id']}/espera", headers=auth(beto)).json()['posicion'] == 1
+    assert db.reservas_de(beto['id']) == []
+
+
+def test_socio_sin_creditos_se_saltea_y_recibe_aviso(cliente, socio):
+    clase = db.crear_clase('Spinning', 'Leo', INICIO, cupo=1)
+    reserva = reservada(cliente, socio, clase)
+    beto = db.crear_socio('Beto Silva', 'beto@example.com')
+    carla = db.crear_socio('Carla Ruiz', 'carla@example.com')
+    en_lista(cliente, beto, clase)
+    en_lista(cliente, carla, clase)
+    db.sumar_creditos(beto['id'], -8)
+
+    assert cliente.post(f"/admin/reservas/{reserva['id']}/cancelar", headers=ADMIN).status_code == 200
+
+    assert cliente.get('/reservas', headers=auth(beto)).json() == []
+    assert cliente.get(f"/clases/{clase['id']}/espera", headers=auth(beto)).status_code == 404
+    [aviso] = correos_a('beto@example.com')
+    assert aviso['asunto'] == 'No pudimos darte el lugar: Spinning el 12/11 a las 19:00'
+    assert [x['clase_id'] for x in cliente.get('/reservas', headers=auth(carla)).json()] == [clase['id']]
+    assert db.socio(carla['id'])['creditos'] == 7
+
+
+def test_socio_ya_confirmado_se_saca_sin_reserva_ni_correo(cliente, socio):
+    clase = db.crear_clase('Spinning', 'Leo', INICIO, cupo=2)
+    reserva = reservada(cliente, socio, clase)
+    juan_reserva = db.crear_reserva(db.crear_socio('Juan Gómez', 'juan@example.com')['id'], clase['id'], AHORA)
+    beto = db.crear_socio('Beto Silva', 'beto@example.com')
+    carla = db.crear_socio('Carla Ruiz', 'carla@example.com')
+    en_lista(cliente, beto, clase)
+    en_lista(cliente, carla, clase)
+    # Sistemas corrige la base a mano: libera el lugar de Juan y le confirma a Beto, que sigue en la lista.
+    db.cancelar_reserva(juan_reserva['id'])
+    db.crear_reserva(beto['id'], clase['id'], AHORA)
+
+    assert cliente.post(f"/admin/reservas/{reserva['id']}/cancelar", headers=ADMIN).status_code == 200
+
+    assert len(db.reservas_de(beto['id'])) == 1
+    assert db.socio(beto['id'])['creditos'] == 8
+    assert correos_a('beto@example.com') == []
+    assert cliente.get(f"/clases/{clase['id']}/espera", headers=auth(beto)).status_code == 404
+    assert cliente.get(f"/clases/{clase['id']}/espera", headers=auth(carla)).status_code == 404
+    assert len(db.reservas_de(carla['id'])) == 1
+    assert db.socio(carla['id'])['creditos'] == 7
+
