{"host.arch": "arm64", "os.type": "darwin", "os.version": "23.4.0", "service.name": "claude-code", "service.version": "2.1.312", "user.id": "", "session.id": "d167766c-15ae-4157-ad34-23adb6be1ed9", "terminal.type": "claude-desktop", "gen_ai.provider.name": "anthropic", "span.type": "tool", "tool_name": "Bash", "tool_name_safe": "Bash", "gen_ai.operation.name": "execute_tool", "gen_ai.tool.name": "Bash", "gen_ai.conversation.id": "d167766c-15ae-4157-ad34-23adb6be1ed9", "full_command": "cat > pulso/cobra.py <<'EOF'\n\"\"\"Cliente de Cobrá, la pasarela de pagos. Cobrá es la fuente de verdad del estado de un pago.\"\"\"\nimport os\n\nimport httpx\n\nTIMEOUT = 5.0\n\n\nclass CobraError(Exception):\n    \"\"\"Cobrá no contestó o contestó algo fuera del contrato.\"\"\"\n\n\nclass PagoInexistente(Exception):\n    \"\"\"Cobrá respondió 404: no conoce el pago.\"\"\"\n\n\ndef _pedir(metodo, ruta, **kwargs):\n    url = os.environ.get('PULSO_PAGOS_URL', '').rstrip('/') + ruta\n    headers = dict(kwargs.pop('headers', {}), **{'X-Cobra-Clave': os.environ.get('PULSO_PAGOS_CLAVE', '')})\n    try:\n        return httpx.request(metodo, url, headers=headers, timeout=TIMEOUT, **kwargs)\n    except (httpx.HTTPError, httpx.InvalidURL) as e:\n        raise CobraError(str(e)) from e\n\n\ndef _pago(dato):\n    if (not isinstance(dato, dict) or not isinstance(dato.get('id'), str)\n            or dato.get('estado') not in ('pendiente', 'aprobado', 'rechazado')):\n        raise CobraError('Pago con formato inválido')\n    return dato\n\n\ndef _json(r):\n    try:\n        return r.json()\n    except ValueError as e:\n        raise CobraError('Respuesta inválida') from e\n\n\ndef crear_pago(monto, referencia):\n    r = _pedir('POST', '/pagos', json={'monto': monto, 'moneda': 'UYU', 'referencia': referencia},\n               headers={'Idempotency-Key': referencia})\n    if r.status_code not in (200, 201):\n        raise CobraError(f'Cobrá respondió {r.status_code}')\n    return _pago(_json(r))\n\n\ndef obtener_pago(pago_id):\n    r = _pedir('GET', '/pagos/' + httpx.URL('/').join(pago_id).path.lstrip('/') if False else f'/pagos/{pago_id}')\n    if r.status_code == 404:\n        raise PagoInexistente(pago_id)\n    if r.status_code != 200:\n        raise CobraError(f'Cobrá respondió {r.status_code}')\n    return _pago(_json(r))\n\n\ndef buscar_por_referencia(referencia):\n    \"\"\"Devuelve el pago con esa referencia, o None si no hay.\"\"\"\n    r = _pedir('GET', '/pagos', params={'referencia': referencia})\n    if r.status_code != 200:\n        raise CobraError(f'Cobrá respondió {r.status_code}')\n    datos = _json(r)\n    if not isinstance(datos, dict) or not isinstance(datos.get('pagos'), list):\n        raise CobraError('Respuesta inválida')\n    pagos = [_pago(p) for p in datos['pagos'] if isinstance(p, dict) and p.get('referencia') == referencia]\n    return pagos[0] if pagos else None\nEOF\npython - <<'EOF'\nimport re\np='pulso/cobra.py'\ns=open(p).read()\ns=s.replace(\"'/pagos/' + httpx.URL('/').join(pago_id).path.lstrip('/') if False else f'/pagos/{pago_id}'\",\"f'/pagos/{quote(pago_id, safe=\\\"\\\")}'\")\ns=s.replace(\"import os\\n\",\"import os\\nfrom urllib.parse import quote\\n\",1)\nopen(p,'w').write(s)\nEOF", "bash_command_class": "file_read", "bash_argv0": "cat", "tool_use_id": "toolu_018GDxhj1NcDeBAUhBSAEfgf", "gen_ai.tool.call.id": "toolu_018GDxhj1NcDeBAUhBSAEfgf", "duration_ms": 8, "_nombre": "claude_code.tool", "_traza": "d5c8415fea70924ec87ccdca09969715", "_tramo": "e39ba9e7ce5831c2", "_padre": "fec18b6b1d17d0cd", "_inicio_ns": 1794572853467000000, "_fin_ns": 1794572853474951625, "_estado": 0}
