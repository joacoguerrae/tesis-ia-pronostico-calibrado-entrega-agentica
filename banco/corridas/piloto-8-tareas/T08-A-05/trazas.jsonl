{"host.arch": "arm64", "os.type": "darwin", "os.version": "23.4.0", "service.name": "claude-code", "service.version": "2.1.312", "user.id": "", "session.id": "f5ffe5b8-0dbb-4a4b-8900-c3e7a4d4f1ff", "terminal.type": "claude-desktop", "gen_ai.provider.name": "anthropic", "span.type": "tool", "tool_name": "Bash", "tool_name_safe": "Bash", "gen_ai.operation.name": "execute_tool", "gen_ai.tool.name": "Bash", "gen_ai.conversation.id": "f5ffe5b8-0dbb-4a4b-8900-c3e7a4d4f1ff", "full_command": "cat >> pulso/db.py <<'EOF'\n\n\ndef _migrar(con):\n    columnas = [f['name'] for f in con.execute('PRAGMA table_info(socios)')]\n    if 'empresa' not in columnas:\n        con.execute('ALTER TABLE socios ADD COLUMN empresa TEXT')\n\n\ndef activar_corporativo(socio_id, empresa, piso=12):\n    \"\"\"Pasa a corporativo con un piso de créditos. False si ya era corporativo.\"\"\"\n    with conexion() as con:\n        cur = con.execute(\"UPDATE socios SET plan = 'corporativo', empresa = ?, creditos = MAX(creditos, ?) \"\n                          \"WHERE id = ? AND plan != 'corporativo'\", (empresa, piso, socio_id))\n    return cur.rowcount == 1\n\n\ndef bajar_a_basico(socio_id):\n    \"\"\"Vuelve a basico conservando créditos. False si ya no era corporativo.\"\"\"\n    with conexion() as con:\n        cur = con.execute(\"UPDATE socios SET plan = 'basico' WHERE id = ? AND plan = 'corporativo'\", (socio_id,))\n    return cur.rowcount == 1\n\n\ndef corporativos():\n    return _varias(\"SELECT * FROM socios WHERE plan = 'corporativo' ORDER BY id\")\nEOF\ncat > pulso/beneficios.py <<'EOF'\n\"\"\"Cliente del servicio de beneficios (fuente de verdad de los empleados de cada empresa).\"\"\"\nimport os\nfrom urllib.parse import quote\n\nimport httpx\n\nACTIVO, INACTIVO, EMPLEADO_DESCONOCIDO, EMPRESA_DESCONOCIDA = 'activo', 'inactivo', 'empleado_desconocido', 'empresa_desconocida'\n\n\nclass ServicioFalla(Exception):\n    pass\n\n\ndef consultar(empresa, email):\n    base = os.environ.get('PULSO_BENEFICIOS_URL')\n    clave = os.environ.get('PULSO_BENEFICIOS_CLAVE')\n    if not base or not clave:\n        raise ServicioFalla('Servicio de beneficios sin configurar')\n    url = f\"{base.rstrip('/')}/empresas/{quote(empresa, safe='')}/empleados/{quote(email.lower(), safe='')}\"\n    try:\n        r = httpx.get(url, headers={'X-Api-Key': clave}, timeout=3.0)\n        cuerpo = r.json() if r.status_code in (200, 404) else None\n    except (httpx.HTTPError, ValueError) as e:\n        raise ServicioFalla(str(e))\n    if not isinstance(cuerpo, dict):\n        raise ServicioFalla(f'Respuesta inesperada ({r.status_code})')\n    if r.status_code == 200 and isinstance(cuerpo.get('activo'), bool):\n        return ACTIVO if cuerpo['activo'] else INACTIVO\n    if r.status_code == 404 and cuerpo.get('error') in (EMPLEADO_DESCONOCIDO, EMPRESA_DESCONOCIDA):\n        return cuerpo['error']\n    raise ServicioFalla(f'Respuesta inesperada ({r.status_code})')\nEOF", "bash_command_class": "file_read", "bash_argv0": "cat", "tool_use_id": "toolu_01JafDqzUp99YXrFMnVXokDt", "gen_ai.tool.call.id": "toolu_01JafDqzUp99YXrFMnVXokDt", "duration_ms": 6, "_nombre": "claude_code.tool", "_traza": "6822af8224b7a7f0fb307bca6e405ef5", "_tramo": "c5cf14989c3cb6f5", "_padre": "215af98906c029cc", "_inicio_ns": 1794572238474000000, "_fin_ns": 1794572238480426542, "_estado": 0}
