+def test_revalidar_cuenta_siguen_bajaron_y_sin_revisar(cliente, servicio):
+    activo = socio_con_convenio('activo@example.com', empresa='acme', creditos=12)
+    baja = socio_con_convenio('baja@example.com', empresa='otra', creditos=15)
