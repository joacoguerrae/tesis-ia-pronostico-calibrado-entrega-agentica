+def test_ampliar_cupo_asigna_k_lugares_en_orden(cliente, socio):
+    clase = db.crear_clase('Yoga', 'Sofía', INICIO, cupo=1)
+    llenar(clase)
+    bruno = db.crear_socio('Bruno', 'bruno@example.com')
+    carla = db.crear_socio('Carla', 'carla@example.com')
+    diego = db.crear_socio('Diego', 'diego@example.com')
+    for s in (socio, bruno, carla, diego):
+        anotar(cliente, s, clase)
+
+    r = cliente.patch(f"/admin/clases/{clase['id']}", json={'cupo': 3}, headers=ADMIN)
+    assert r.status_code == 200
+    assert r.json()['cupo'] == 3
+    assert r.json()['lugares_libres'] == 0
+    assert cliente.get(f"/clases/{clase['id']}/espera", headers=auth(diego)).json()['posicion'] == 1
+    assert cliente.get(f"/clases/{clase['id']}/espera", headers=auth(socio)).status_code == 404
+    assert cliente.get(f"/clases/{clase['id']}/espera", headers=auth(bruno)).status_code == 404
+    assert [x['estado'] for x in cliente.get('/reservas', headers=auth(socio)).json()] == ['confirmada']
+    assert [x['estado'] for x in cliente.get('/reservas', headers=auth(bruno)).json()] == ['confirmada']
+    assert cliente.get('/reservas', headers=auth(diego)).json() == []
+    assert correos_para('bruno@example.com') == [f'Se liberó un lugar: {ASUNTO}']
+    assert correos_para('diego@example.com') == []
+
