 @pytest.fixture
@@ -25,5 +28,69 @@ def socio(cliente):
     return db.crear_socio('Ana Pérez', 'ana@example.com')
 
 
+@pytest.fixture
+def cobra(monkeypatch):
+    """Cobrá falso en memoria. Se conecta a la app con httpx.MockTransport."""
+    monkeypatch.setenv('PULSO_PAGOS_URL', 'https://cobra.test/v1')
+    monkeypatch.setenv('PULSO_PAGOS_CLAVE', CLAVE_COBRA)
+    fake = FakeCobra()
+    monkeypatch.setattr(main, 'TRANSPORTE_COBRA', httpx.MockTransport(fake.responder))
+    return fake
+
+
+class FakeCobra:
+    def __init__(self):
+        self.pagos = {}
+        self.por_clave = {}
+        self.creaciones = []          # (Idempotency-Key, cuerpo) de cada POST /pagos recibido
+        self.caido = False            # no contesta a ninguna ruta
+        self.crear_pero_500 = False   # crea el pago pero responde 500
+        self.fallas_obtener = set()   # ids de pago cuya consulta falla
+        self.fallas_buscar = set()    # referencias cuya búsqueda falla
+
+    def agregar(self, referencia, estado='pendiente', monto=1200):
+        pago_id = f'pag_{len(self.pagos) + 1}'
+        self.pagos[pago_id] = {'id': pago_id, 'estado': estado, 'monto': monto, 'moneda': 'UYU',
+                               'referencia': referencia, 'url_pago': f'https://pagar.cobra.test/{pago_id}'}
+        return self.pagos[pago_id]
+
+    def pagar(self, pago_id, estado):
+        self.pagos[pago_id]['estado'] = estado
+
+    def responder(self, request):
+        if self.caido:
+            raise httpx.ConnectError('conexión rechazada', request=request)
+        if request.headers.get('X-Cobra-Clave') != CLAVE_COBRA:
+            return httpx.Response(401)
+        ruta = request.url.path
+        if request.method == 'POST' and ruta == '/v1/pagos':
+            return self._crear(request)
+        if request.method == 'GET' and ruta == '/v1/pagos':
+            ref = request.url.params.get('referencia')
+            if ref in self.fallas_buscar:
+                return httpx.Response(500)
+            return httpx.Response(200, json={'pagos': [p for p in self.pagos.values() if p['referencia'] == ref]})
+        if request.method == 'GET' and ruta.startswith('/v1/pagos/'):
+            pago_id = ruta.removeprefix('/v1/pagos/')
+            if pago_id in self.fallas_obtener:
+                return httpx.Response(500)
+            if pago_id not in self.pagos:
+                return httpx.Response(404)
+            return httpx.Response(200, json=self.pagos[pago_id])
+        return httpx.Response(404)
+
+    def _crear(self, request):
+        clave = request.headers.get('Idempotency-Key')
+        datos = json.loads(request.content)
+        if not clave or not all(k in datos for k in ('monto', 'moneda', 'referencia')):
+            return httpx.Response(422)
+        self.creaciones.append((clave, datos))
+        if clave in self.por_clave:
+            return httpx.Response(200, json=self.por_clave[clave])
+        pago = self.agregar(datos['referencia'], monto=datos['monto'])
+        self.por_clave[clave] = pago
+        return httpx.Response(500) if self.crear_pero_500 else httpx.Response(201, json=pago)
+
+
 def auth(socio):
     return {'Authorization': f"Bearer {socio['token']}"}
