@@ -1,9 +1,9 @@
 import os
 
 from fastapi import APIRouter, Depends, FastAPI, Header, HTTPException
-from pydantic import AwareDatetime, BaseModel, Field
+from pydantic import AwareDatetime, BaseModel, Field, StrictInt
 
-from pulso import correo, db, reloj
+from pulso import correo, db, espera, reloj
 
 router = APIRouter()
 
@@ -92,6 +92,97 @@ def yo(socio=Depends(socio_actual)):
     return {k: socio[k] for k in ('id', 'nombre', 'email', 'plan', 'creditos')}
 
 
+def _posicion(con, clase_id, socio_id):
+    fila = con.execute('SELECT id FROM espera WHERE clase_id = ? AND socio_id = ?', (clase_id, socio_id)).fetchone()
+    if fila is None:
+        raise HTTPException(404, 'No estás en la lista de espera')
+    n = con.execute('SELECT COUNT(*) FROM espera WHERE clase_id = ? AND id <= ?', (clase_id, fila['id'])).fetchone()[0]
+    return {'clase_id': clase_id, 'posicion': n}
+
+
+def _clase_en(con, clase_id):
+    clase = con.execute('SELECT * FROM clases WHERE id = ?', (clase_id,)).fetchone()
+    if clase is None:
+        raise HTTPException(404, 'No existe la clase')
+    return dict(clase)
+
+
+@router.post('/clases/{clase_id}/espera', status_code=201)
+def anotarse_en_espera(clase_id: int, socio=Depends(socio_actual)):
+    with db.conexion() as con:
+        espera.iniciar(con)
+        clase = _clase_en(con, clase_id)
+        if db.a_fecha(clase['inicio']) <= reloj.ahora():
+            raise HTTPException(409, 'La clase ya empezó')
+        n = con.execute("SELECT COUNT(*) FROM reservas WHERE clase_id = ? AND estado = 'confirmada'",
+                        (clase_id,)).fetchone()[0]
+        if n < clase['cupo']:
+            raise HTTPException(409, 'La clase tiene lugar: reservá directo')
+        if con.execute("SELECT 1 FROM reservas WHERE clase_id = ? AND socio_id = ? AND estado = 'confirmada'",
+                       (clase_id, socio['id'])).fetchone():
+            raise HTTPException(409, 'Ya tenés una reserva para esta clase')
+        if con.execute('SELECT 1 FROM espera WHERE clase_id = ? AND socio_id = ?', (clase_id, socio['id'])).fetchone():
+            raise HTTPException(409, 'Ya estás en la lista de espera')
+        creditos = con.execute('SELECT creditos FROM socios WHERE id = ?', (socio['id'],)).fetchone()[0]
+        if creditos < 1:
+            raise HTTPException(409, 'No te quedan créditos')
+        con.execute('INSERT INTO espera (clase_id, socio_id, creada) VALUES (?, ?, ?)',
+                    (clase_id, socio['id'], db.a_texto(reloj.ahora())))
+        return _posicion(con, clase_id, socio['id'])
+
+
+@router.get('/clases/{clase_id}/espera')
+def ver_espera(clase_id: int, socio=Depends(socio_actual)):
+    with db.conexion() as con:
+        _clase_en(con, clase_id)
+        return _posicion(con, clase_id, socio['id'])
+
+
+@router.delete('/clases/{clase_id}/espera', status_code=204)
+def bajarse_de_espera(clase_id: int, socio=Depends(socio_actual)):
+    with db.conexion() as con:
+        espera.iniciar(con)
+        _clase_en(con, clase_id)
+        _posicion(con, clase_id, socio['id'])
+        con.execute('DELETE FROM espera WHERE clase_id = ? AND socio_id = ?', (clase_id, socio['id']))
+
+
+@router.post('/admin/reservas/{reserva_id}/cancelar', dependencies=[Depends(admin)])
+def cancelar_reserva(reserva_id: int):
+    with db.conexion() as con:
+        espera.iniciar(con)
+        reserva = con.execute('SELECT * FROM reservas WHERE id = ?', (reserva_id,)).fetchone()
+        if reserva is None:
+            raise HTTPException(404, 'No existe la reserva')
+        if reserva['estado'] == 'cancelada':
+            raise HTTPException(409, 'La reserva ya estaba cancelada')
+        con.execute("UPDATE reservas SET estado = 'cancelada' WHERE id = ?", (reserva_id,))
+        con.execute('UPDATE socios SET creditos = creditos + 1 WHERE id = ?', (reserva['socio_id'],))
+        espera.asignar_lugares(con, reserva['clase_id'])
+        return ver_reserva(con.execute('SELECT * FROM reservas WHERE id = ?', (reserva_id,)).fetchone())
+
+
+class CambioClase(BaseModel):
+    cupo: StrictInt = Field(gt=0)
+
+
+@router.patch('/admin/clases/{clase_id}', dependencies=[Depends(admin)])
+def cambiar_clase(clase_id: int, datos: CambioClase):
+    with db.conexion() as con:
+        espera.iniciar(con)
+        clase = _clase_en(con, clase_id)
+        n = con.execute("SELECT COUNT(*) FROM reservas WHERE clase_id = ? AND estado = 'confirmada'",
+                        (clase_id,)).fetchone()[0]
+        if datos.cupo < n:
+            raise HTTPException(409, 'El cupo no puede ser menor a las reservas confirmadas')
+        con.execute('UPDATE clases SET cupo = ? WHERE id = ?', (datos.cupo, clase_id))
+        espera.asignar_lugares(con, clase_id)
+        clase = dict(con.execute('SELECT * FROM clases WHERE id = ?', (clase_id,)).fetchone())
+        n = con.execute("SELECT COUNT(*) FROM reservas WHERE clase_id = ? AND estado = 'confirmada'",
+                        (clase_id,)).fetchone()[0]
+        return dict(clase, lugares_libres=clase['cupo'] - n)
+
+
 def crear_app():
     db.inicializar()
     app = FastAPI(title='Pulso')
