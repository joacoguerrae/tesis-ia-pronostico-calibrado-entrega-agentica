 from datetime import datetime, timezone
+from urllib.parse import unquote
 
+import httpx
 import pytest
 from fastapi.testclient import TestClient
 
@@ -9,6 +11,67 @@ from pulso.main import crear_app
 # Martes 10/11/2026, 12:00 en Montevideo.
 AHORA = datetime(2026, 11, 10, 15, 0, tzinfo=timezone.utc)
 ADMIN = {'X-Admin-Key': 'clave-admin'}
+COBRA_URL = 'https://cobra.test/v1'
+COBRA_CLAVE = 'clave-cobra'
+
+
+class FakeCobra:
+    """Cobrá en memoria, según el contrato. `fallar` hace fallar los pedidos cuya URL o query contenga la clave:
+    el valor es un código HTTP o 'conexion' / 'timeout'."""
+
+    def __init__(self):
+        self.pagos = {}
+        self.idempotencia = {}
+        self.llamadas = []
+        self.fallar = {}
+
+    def crear_pago_externo(self, referencia, estado='pendiente', monto=1200):
+        """Simula un pago que Cobrá creó (por ejemplo, cuando la respuesta a Pulso se perdió)."""
+        pago_id = f'pag_{len(self.pagos) + 1}'
+        self.pagos[pago_id] = {'id': pago_id, 'estado': estado, 'monto': monto, 'moneda': 'UYU',
+                               'referencia': referencia, 'url_pago': f'https://pagar.cobra.test/{pago_id}'}
+        return dict(self.pagos[pago_id])
+
+    def cambiar_estado(self, pago_id, estado):
+        self.pagos[pago_id]['estado'] = estado
+
+    def pedidos(self, metodo, ruta_prefijo):
+        return [x for x in self.llamadas if x['metodo'] == metodo and x['ruta'].startswith(ruta_prefijo)]
+
+    def request(self, metodo, url, headers=None, timeout=None, json=None, params=None):
+        headers = dict(headers or {})
+        ruta = url.removeprefix(COBRA_URL)
+        self.llamadas.append({'metodo': metodo, 'ruta': ruta, 'headers': headers, 'json': json,
+                              'params': params, 'timeout': timeout})
+        if headers.get('X-Cobra-Clave') != COBRA_CLAVE:
+            return httpx.Response(401, json={'error': 'clave inválida'})
+        for pedazo, falla in self.fallar.items():
+            if pedazo in url or pedazo in (params or {}).values():
+                if falla == 'conexion':
+                    raise httpx.ConnectError('conexión rechazada')
+                if falla == 'timeout':
+                    raise httpx.ReadTimeout('sin respuesta')
+                return httpx.Response(falla, json={'error': 'falla'})
+        if metodo == 'POST' and ruta == '/pagos':
+            return self._crear(headers, json)
+        if metodo == 'GET' and ruta.startswith('/pagos/'):
+            pago = self.pagos.get(unquote(ruta.removeprefix('/pagos/')))
+            return httpx.Response(200, json=dict(pago)) if pago else httpx.Response(404, json={'error': 'no existe'})
+        if metodo == 'GET' and ruta == '/pagos':
+            ref = (params or {}).get('referencia')
+            return httpx.Response(200, json={'pagos': [dict(p) for p in self.pagos.values() if p['referencia'] == ref]})
+        return httpx.Response(404, json={'error': 'ruta desconocida'})
+
+    def _crear(self, headers, datos):
+        clave = headers.get('Idempotency-Key')
+        if not clave or not isinstance(datos, dict) or not isinstance(datos.get('monto'), int) \
+                or datos.get('moneda') != 'UYU' or not isinstance(datos.get('referencia'), str):
+            return httpx.Response(422, json={'error': 'datos inválidos'})
+        if clave in self.idempotencia:
+            return httpx.Response(200, json=dict(self.pagos[self.idempotencia[clave]]))
+        pago = self.crear_pago_externo(datos['referencia'], monto=datos['monto'])
+        self.idempotencia[clave] = pago['id']
+        return httpx.Response(201, json=pago)
 
 
 @pytest.fixture
@@ -25,5 +88,14 @@ def socio(cliente):
     return db.crear_socio('Ana Pérez', 'ana@example.com')
 
 
+@pytest.fixture
+def cobra(monkeypatch):
+    monkeypatch.setenv('PULSO_PAGOS_URL', COBRA_URL)
+    monkeypatch.setenv('PULSO_PAGOS_CLAVE', COBRA_CLAVE)
+    fake = FakeCobra()
+    monkeypatch.setattr(httpx, 'request', fake.request)
+    return fake
+
+
 def auth(socio):
     return {'Authorization': f"Bearer {socio['token']}"}
