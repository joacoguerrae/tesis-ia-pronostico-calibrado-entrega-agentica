 import os
+from datetime import date
 
-from fastapi import APIRouter, Depends, FastAPI, Header, HTTPException
+from fastapi import APIRouter, Depends, FastAPI, Header, HTTPException, Query, Response
 from pydantic import AwareDatetime, BaseModel, Field
 
 from pulso import correo, db, reloj
 
 router = APIRouter()
 
+FORMATO_FECHA = r'^[0-9]{4}-[0-9]{2}-[0-9]{2}$'
+
 
 def socio_actual(authorization: str | None = Header(default=None)):
     if not authorization or not authorization.startswith('Bearer '):
@@ -30,10 +33,29 @@ def ver_reserva(reserva):
     return {k: reserva[k] for k in ('id', 'clase_id', 'estado', 'creada')}
 
 
+def _fecha(texto):
+    if texto is None:
+        return None
+    try:
+        return date.fromisoformat(texto)
+    except ValueError:
+        raise HTTPException(422, 'La fecha tiene que ser YYYY-MM-DD')
+
+
 @router.get('/clases')
-def listar_clases():
-    ahora = reloj.ahora()
-    return [ver_clase(c) for c in db.clases() if db.a_fecha(c['inicio']) > ahora]
+def listar_clases(response: Response,
+                  desde: str | None = Query(default=None, pattern=FORMATO_FECHA),
+                  hasta: str | None = Query(default=None, pattern=FORMATO_FECHA),
+                  instructor: str | None = None,
+                  con_lugar: bool = False,
+                  pagina: int = Query(default=1, ge=1),
+                  por_pagina: int = Query(default=20, ge=1, le=50)):
+    desde, hasta = _fecha(desde), _fecha(hasta)
+    if desde is not None and hasta is not None and desde > hasta:
+        raise HTTPException(422, 'desde no puede ser posterior a hasta')
+    clases, total = db.clases_filtradas(reloj.ahora(), desde, hasta, instructor, con_lugar, pagina, por_pagina)
+    response.headers['X-Total'] = str(total)
+    return [ver_clase(c) for c in clases]
 
 
 @router.get('/clases/{clase_id}')
