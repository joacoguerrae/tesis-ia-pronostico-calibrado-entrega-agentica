diff --git a/tests/test_cambio_serie.py b/tests/test_cambio_serie.py
new file mode 100644
index 0000000..9961d85
--- /dev/null
+++ b/tests/test_cambio_serie.py
@@ -0,0 +1,165 @@
+from datetime import datetime, timedelta, timezone
+
+import pytest
+
+from conftest import ADMIN
+from pulso import db, reloj
+
+BASE = {'nombre': 'Yoga', 'instructor': 'Sofía', 'dia': 'martes', 'hora': '19:00', 'duracion_min': 60,
+        'cupo': 15, 'desde': '2026-11-10', 'hasta': '2026-12-31'}
+# Clases de la serie, en orden: 11/10 (id 1), 11/17 (2), 11/24 (3), 12/1 (4), ...
+
+
+@pytest.fixture
+def serie(cliente):
+    return cliente.post('/admin/series', json=BASE, headers=ADMIN).json()
+
+
+def parchear(cliente, serie_id=1, **cambios):
+    return cliente.patch(f'/admin/series/{serie_id}', json=cambios, headers=ADMIN)
+
+
+def asuntos():
+    return [c['asunto'] for c in db.correos()]
+
+
+def test_cambia_hora_desde_la_clase_en_adelante(cliente, serie, socio):
+    otro = db.crear_socio('Juan Gómez', 'juan@example.com')
+    db.crear_reserva(socio['id'], 2, reloj.ahora())  # 17/11, se mueve
+    db.crear_reserva(otro['id'], 3, reloj.ahora())   # 24/11, se mueve
+    db.crear_reserva(otro['id'], 1, reloj.ahora())   # 10/11, no se mueve
+
+    r = parchear(cliente, desde_clase_id=2, hora='20:00')
+    assert r.status_code == 200
+    cambiada = r.json()
+    assert cambiada['hora'] == '20:00'
+    assert [c['id'] for c in cambiada['clases']] == [1, 2, 3, 4, 5, 6, 7, 8]
+    inicios = {c['id']: c['inicio'] for c in cambiada['clases']}
+    assert inicios[1] == '2026-11-10T22:00:00+00:00'
+    assert inicios[2] == '2026-11-17T23:00:00+00:00'
+    assert inicios[3] == '2026-11-24T23:00:00+00:00'
+    assert inicios[8] == '2026-12-29T23:00:00+00:00'
+
+    # Las reservas siguen confirmadas en la clase movida.
+    assert db.confirmadas(2) == 1 and db.confirmadas(3) == 1 and db.confirmadas(1) == 1
+    assert len(db.clases_de_serie(1)) == 8
+
+
+def test_avisa_a_los_socios_con_reserva_de_las_clases_movidas(cliente, serie, socio):
+    db.crear_reserva(socio['id'], 2, reloj.ahora())
+    db.crear_reserva(socio['id'], 1, reloj.ahora())
+    parchear(cliente, desde_clase_id=2, hora='20:00')
+    avisos = [c for c in db.correos() if c['asunto'].startswith('Cambio de horario')]
+    assert [(c['para'], c['asunto']) for c in avisos] == [
+        ('ana@example.com', 'Cambio de horario: Yoga el 17/11 a las 20:00')]
+
+
+def test_reserva_cancelada_no_recibe_aviso(cliente, serie, socio):
+    db.crear_reserva(socio['id'], 2, reloj.ahora(), estado='cancelada')
+    db.crear_reserva(socio['id'], 3, reloj.ahora())
+    parchear(cliente, desde_clase_id=2, hora='20:00')
+    assert len(db.correos()) == 1
+
+
+def test_mismo_horario_no_avisa(cliente, serie, socio):
+    db.crear_reserva(socio['id'], 2, reloj.ahora())
+    r = parchear(cliente, desde_clase_id=2, hora='19:00')
+    assert r.status_code == 200
+    assert db.correos() == []
+
+
+def test_instructor_y_cupo_no_mandan_correos(cliente, serie, socio):
+    db.crear_reserva(socio['id'], 2, reloj.ahora())
+    r = parchear(cliente, desde_clase_id=2, instructor='Leo', cupo=10)
+    assert r.status_code == 200
+    assert r.json()['instructor'] == 'Leo' and r.json()['cupo'] == 10
+    assert db.correos() == []
+
+
+def test_cambia_instructor_y_cupo_solo_desde_la_clase(cliente, serie):
+    r = parchear(cliente, desde_clase_id=2, instructor='Leo', cupo=10)
+    clases = r.json()['clases']
+    assert [(c['instructor'], c['cupo']) for c in clases[:2]] == [('Sofía', 15), ('Leo', 10)]
+    assert all(c['instructor'] == 'Leo' and c['cupo'] == 10 for c in clases[1:])
+    assert clases[0]['instructor'] == 'Sofía'
+
+
+def test_no_toca_las_canceladas(cliente, serie):
+    cliente.post('/admin/clases/4/cancelar', headers=ADMIN)
+    r = parchear(cliente, desde_clase_id=2, instructor='Leo', hora='20:00')
+    cancelada = next(c for c in r.json()['clases'] if c['id'] == 4)
+    assert cancelada['estado'] == 'cancelada'
+    assert cancelada['instructor'] == 'Sofía'
+    assert cancelada['inicio'] == '2026-12-01T22:00:00+00:00'
+    assert db.correos() == []
+
+
+def test_desde_clase_que_ya_empezo_es_409(cliente, serie):
+    reloj.fijar(datetime(2026, 11, 17, 23, 30, tzinfo=timezone.utc))
+    r = parchear(cliente, desde_clase_id=1, hora='20:00')
+    assert r.status_code == 409
+    assert db.clase(1)['inicio'] == '2026-11-10T22:00:00+00:00'
+    assert db.serie(1)['hora'] == '19:00'
+
+
+def test_hora_nueva_que_deja_clase_en_el_pasado_es_409_y_no_cambia_nada(cliente, serie):
+    # Ahora es martes 12:00: el 10/11 a las 11:00 ya pasó.
+    r = parchear(cliente, desde_clase_id=1, hora='11:00', instructor='Leo')
+    assert r.status_code == 409
+    assert db.serie(1)['instructor'] == 'Sofía'
+    assert all(c['instructor'] == 'Sofía' and c['inicio'].endswith('T22:00:00+00:00')
+               for c in db.clases_de_serie(1))
+
+
+def test_hora_que_empieza_justo_ahora_es_409(cliente, serie):
+    r = parchear(cliente, desde_clase_id=1, hora='12:00')
+    assert r.status_code == 409
+
+
+def test_cupo_menor_que_reservas_confirmadas_es_409(cliente, serie):
+    for nombre in ('Juan', 'Lucía'):
+        otro = db.crear_socio(nombre, f'{nombre.lower()}@example.com')
+        db.crear_reserva(otro['id'], 3, reloj.ahora())
+    r = parchear(cliente, desde_clase_id=2, cupo=1, instructor='Leo')
+    assert r.status_code == 409
+    assert db.serie(1)['cupo'] == 15
+    assert db.clase(2)['instructor'] == 'Sofía'
+
+
+def test_cupo_igual_a_reservas_confirmadas_se_acepta(cliente, serie):
+    for nombre in ('Juan', 'Lucía'):
+        otro = db.crear_socio(nombre, f'{nombre.lower()}@example.com')
+        db.crear_reserva(otro['id'], 3, reloj.ahora())
+    assert parchear(cliente, desde_clase_id=2, cupo=2).status_code == 200
+
+
+def test_serie_o_clase_inexistente_es_404(cliente, serie):
+    assert parchear(cliente, serie_id=99, desde_clase_id=2, hora='20:00').status_code == 404
+    assert parchear(cliente, desde_clase_id=99, hora='20:00').status_code == 404
+
+
+def test_clase_de_otra_serie_es_404(cliente, serie):
+    otra = cliente.post('/admin/series', json={**BASE, 'dia': 'jueves'}, headers=ADMIN).json()
+    clase_ajena = otra['clases'][0]['id']
+    assert parchear(cliente, desde_clase_id=clase_ajena, hora='20:00').status_code == 404
+
+
+@pytest.mark.parametrize('cambios', [
+    {},
+    {'hora': None},
+    {'hora': '25:00'},
+    {'hora': '7:00'},
+    {'instructor': ''},
+    {'cupo': 0},
+    {'cupo': None},
+])
+def test_cambios_invalidos_son_422(cliente, serie, cambios):
+    assert cliente.patch('/admin/series/1', json={'desde_clase_id': 2, **cambios}, headers=ADMIN).status_code == 422
+
+
+def test_sin_clase_base_es_422(cliente, serie):
+    assert cliente.patch('/admin/series/1', json={'hora': '20:00'}, headers=ADMIN).status_code == 422
+
+
+def test_cambiar_serie_requiere_clave(cliente, serie):
+    assert cliente.patch('/admin/series/1', json={'desde_clase_id': 2, 'hora': '20:00'}).status_code == 401
diff --git a/tests/test_cancelar.py b/tests/test_cancelar.py
new file mode 100644
index 0000000..9840377
--- /dev/null
+++ b/tests/test_cancelar.py
@@ -0,0 +1,76 @@
+from datetime import timedelta
+
+from conftest import ADMIN, auth
+from pulso import db, reloj
+
+BASE = {'nombre': 'Yoga', 'instructor': 'Sofía', 'dia': 'martes', 'hora': '19:00', 'duracion_min': 60,
+        'cupo': 15, 'desde': '2026-11-10', 'hasta': '2026-11-24'}
+
+
+def test_cancela_clase_de_serie_y_sus_reservas(cliente, socio):
+    cliente.post('/admin/series', json=BASE, headers=ADMIN)
+    assert cliente.post('/reservas', json={'clase_id': 2}, headers=auth(socio)).status_code == 201
+    assert cliente.get('/yo', headers=auth(socio)).json()['creditos'] == 7
+
+    r = cliente.post('/admin/clases/2/cancelar', headers=ADMIN)
+    assert r.status_code == 200
+    assert r.json()['estado'] == 'cancelada'
+    assert r.json()['serie_id'] == 1
+    assert r.json() == cliente.get('/clases/2').json()
+
+    assert cliente.get('/yo', headers=auth(socio)).json()['creditos'] == 8
+    assert [x['estado'] for x in cliente.get('/reservas', headers=auth(socio)).json()] == ['cancelada']
+    assert [c['id'] for c in cliente.get('/clases').json()] == [1, 3]
+    assert cliente.get('/clases/2').json()['estado'] == 'cancelada'
+
+    [aviso] = [c for c in db.correos() if c['asunto'].startswith('Clase cancelada')]
+    assert aviso['para'] == 'ana@example.com'
+    assert aviso['asunto'] == 'Clase cancelada: Yoga el 17/11 a las 19:00'
+
+
+def test_reservar_clase_cancelada_es_409(cliente, socio):
+    cliente.post('/admin/series', json=BASE, headers=ADMIN)
+    cliente.post('/admin/clases/2/cancelar', headers=ADMIN)
+    r = cliente.post('/reservas', json={'clase_id': 2}, headers=auth(socio))
+    assert r.status_code == 409
+    assert r.json()['detail'] == 'La clase está cancelada'
+
+
+def test_cancela_clase_suelta(cliente, socio):
+    clase = db.crear_clase('Pilates', 'Marta', reloj.ahora() + timedelta(days=2))
+    db.crear_reserva(socio['id'], clase['id'], reloj.ahora())
+    db.sumar_creditos(socio['id'], -1)
+    r = cliente.post(f"/admin/clases/{clase['id']}/cancelar", headers=ADMIN)
+    assert r.status_code == 200
+    assert r.json()['serie_id'] is None
+    assert cliente.get('/yo', headers=auth(socio)).json()['creditos'] == 8
+    assert db.correos()[0]['asunto'].startswith('Clase cancelada: Pilates el ')
+
+
+def test_cancelar_sin_reservas_no_manda_correos(cliente):
+    clase = db.crear_clase('Pilates', 'Marta', reloj.ahora() + timedelta(days=2))
+    assert cliente.post(f"/admin/clases/{clase['id']}/cancelar", headers=ADMIN).status_code == 200
+    assert db.correos() == []
+
+
+def test_cancelar_dos_veces_es_409(cliente):
+    clase = db.crear_clase('Pilates', 'Marta', reloj.ahora() + timedelta(days=2))
+    cliente.post(f"/admin/clases/{clase['id']}/cancelar", headers=ADMIN)
+    r = cliente.post(f"/admin/clases/{clase['id']}/cancelar", headers=ADMIN)
+    assert r.status_code == 409
+    assert db.correos() == []
+
+
+def test_cancelar_clase_ya_empezada_es_409(cliente):
+    clase = db.crear_clase('Pilates', 'Marta', reloj.ahora() - timedelta(minutes=1))
+    assert cliente.post(f"/admin/clases/{clase['id']}/cancelar", headers=ADMIN).status_code == 409
+    assert cliente.get(f"/clases/{clase['id']}").json()['estado'] == 'programada'
+
+
+def test_cancelar_clase_inexistente_es_404(cliente):
+    assert cliente.post('/admin/clases/99/cancelar', headers=ADMIN).status_code == 404
+
+
+def test_cancelar_requiere_clave(cliente):
+    clase = db.crear_clase('Pilates', 'Marta', reloj.ahora() + timedelta(days=2))
+    assert cliente.post(f"/admin/clases/{clase['id']}/cancelar").status_code == 401
diff --git a/tests/test_migracion.py b/tests/test_migracion.py
new file mode 100644
index 0000000..4918956
--- /dev/null
+++ b/tests/test_migracion.py
@@ -0,0 +1,26 @@
+import sqlite3
+
+from fastapi.testclient import TestClient
+
+from pulso.main import crear_app
+
+
+def test_base_anterior_se_migra_sin_perder_clases(tmp_path, monkeypatch):
+    ruta = tmp_path / 'vieja.db'
+    monkeypatch.setenv('PULSO_DB', str(ruta))
+    # Esquema previo a las series: la tabla clases no tiene serie_id ni estado.
+    con = sqlite3.connect(ruta)
+    con.executescript("""
+        CREATE TABLE clases (id INTEGER PRIMARY KEY, nombre TEXT NOT NULL, instructor TEXT NOT NULL,
+            inicio TEXT NOT NULL, duracion_min INTEGER NOT NULL, cupo INTEGER NOT NULL);
+        INSERT INTO clases (nombre, instructor, inicio, duracion_min, cupo)
+            VALUES ('Yoga', 'Sofía', '2026-11-12T21:00:00+00:00', 60, 20);
+    """)
+    con.close()
+
+    cliente = TestClient(crear_app())
+    crear_app()  # inicializar es idempotente
+    r = cliente.get('/clases/1')
+    assert r.status_code == 200
+    assert r.json()['serie_id'] is None
+    assert r.json()['estado'] == 'programada'
diff --git a/tests/test_series.py b/tests/test_series.py
new file mode 100644
index 0000000..d55892f
--- /dev/null
+++ b/tests/test_series.py
@@ -0,0 +1,126 @@
+from datetime import date, timedelta
+
+import pytest
+
+from conftest import ADMIN, AHORA, auth
+from pulso import db
+
+BASE = {'nombre': 'Yoga', 'instructor': 'Sofía', 'dia': 'martes', 'hora': '19:00', 'duracion_min': 60,
+        'cupo': 15, 'desde': '2026-11-10', 'hasta': '2026-12-31'}
+DIAS = ('lunes', 'martes', 'miércoles', 'jueves', 'viernes', 'sábado', 'domingo')
+CERRADOS = [date(2026, 12, 25), date(2027, 1, 1), date(2027, 2, 8), date(2027, 2, 9),
+            date(2027, 3, 25), date(2027, 3, 26), date(2027, 5, 1)]
+
+
+def crear(cliente, **cambios):
+    return cliente.post('/admin/series', json={**BASE, **cambios}, headers=ADMIN)
+
+
+def inicios(serie):
+    return [c['inicio'] for c in serie['clases']]
+
+
+def test_crea_una_clase_por_semana_en_el_dia_y_hora(cliente):
+    r = crear(cliente)
+    assert r.status_code == 201
+    serie = r.json()
+    assert serie['id'] == 1
+    assert {k: serie[k] for k in BASE} == BASE
+    assert len(serie['clases']) == 8
+    assert inicios(serie) == sorted(inicios(serie))
+    assert serie['clases'][0] == {
+        'id': 1, 'nombre': 'Yoga', 'instructor': 'Sofía', 'inicio': '2026-11-10T22:00:00+00:00',
+        'duracion_min': 60, 'cupo': 15, 'lugares_libres': 15, 'serie_id': 1, 'estado': 'programada'}
+    assert inicios(serie)[-1] == '2026-12-29T22:00:00+00:00'
+
+
+def test_clases_de_serie_aparecen_en_listado_publico(cliente):
+    crear(cliente, hasta='2026-11-17')
+    assert [c['inicio'] for c in cliente.get('/clases').json()] == [
+        '2026-11-10T22:00:00+00:00', '2026-11-17T22:00:00+00:00']
+
+
+def test_clases_sueltas_tienen_serie_null_y_programada(cliente):
+    db.crear_clase('Pilates', 'Marta', AHORA + timedelta(days=1))
+    clase = cliente.get('/clases/1').json()
+    assert clase['serie_id'] is None
+    assert clase['estado'] == 'programada'
+
+
+@pytest.mark.parametrize('fecha', CERRADOS)
+def test_dia_de_cierre_no_tiene_clase(cliente, fecha):
+    r = crear(cliente, dia=DIAS[fecha.weekday()], desde=fecha.isoformat(), hasta=fecha.isoformat())
+    assert r.status_code == 201
+    assert r.json()['clases'] == []
+
+
+def test_semanas_de_cierre_se_saltean(cliente):
+    serie = crear(cliente, dia='lunes', desde='2027-02-01', hasta='2027-02-15').json()
+    assert inicios(serie) == ['2027-02-01T22:00:00+00:00', '2027-02-15T22:00:00+00:00']
+
+
+def test_no_crea_clases_que_ya_empezaron(cliente):
+    # Ahora es martes 12:00 en Montevideo: a las 11:00 ya pasó, a las 12:00 empieza justo ahora.
+    # Solo sobrevive el martes 17/11, a las 11:00 o a las 12:00 (17/11 14:00 UTC).
+    assert inicios(crear(cliente, hora='11:00', hasta='2026-11-17').json()) == ['2026-11-17T14:00:00+00:00']
+    assert inicios(crear(cliente, hora='12:00', hasta='2026-11-17').json()) == ['2026-11-17T15:00:00+00:00']
+
+
+def test_serie_sin_clases_es_valida(cliente):
+    r = crear(cliente, dia='lunes', desde='2027-02-08', hasta='2027-02-08')
+    assert r.status_code == 201
+    assert r.json()['clases'] == []
+
+
+def test_rango_de_366_dias_se_acepta(cliente):
+    assert crear(cliente, desde='2026-11-10', hasta='2027-11-11').status_code == 201
+
+
+def test_rango_mayor_a_366_dias_se_rechaza(cliente):
+    assert crear(cliente, desde='2026-11-10', hasta='2027-11-12').status_code == 422
+
+
+@pytest.mark.parametrize('cambios', [
+    {'nombre': ''},
+    {'nombre': '   '},
+    {'instructor': ''},
+    {'dia': 'Martes'},
+    {'dia': 'miercoles'},
+    {'dia': 'domingo_'},
+    {'hora': '7:00'},
+    {'hora': '24:00'},
+    {'hora': '19:60'},
+    {'hora': '19h'},
+    {'duracion_min': 0},
+    {'cupo': 0},
+    {'hasta': '2026-11-01'},
+    {'desde': 'no es fecha'},
+])
+def test_datos_invalidos_no_crean_nada(cliente, cambios):
+    assert crear(cliente, **cambios).status_code == 422
+    assert cliente.get('/clases').json() == []
+    assert cliente.get('/admin/series/1', headers=ADMIN).status_code == 404
+
+
+def test_falta_un_dato(cliente):
+    datos = {k: v for k, v in BASE.items() if k != 'cupo'}
+    assert cliente.post('/admin/series', json=datos, headers=ADMIN).status_code == 422
+
+
+def test_crear_serie_requiere_clave(cliente):
+    assert cliente.post('/admin/series', json=BASE).status_code == 401
+    assert cliente.post('/admin/series', json=BASE, headers={'X-Admin-Key': 'otra'}).status_code == 401
+
+
+def test_obtener_serie_incluye_canceladas(cliente):
+    crear(cliente, hasta='2026-11-24')
+    cliente.post('/admin/clases/2/cancelar', headers=ADMIN)
+    r = cliente.get('/admin/series/1', headers=ADMIN)
+    assert r.status_code == 200
+    assert [c['estado'] for c in r.json()['clases']] == ['programada', 'cancelada', 'programada']
+    assert r.json()['clases'][1]['serie_id'] == 1
+
+
+def test_obtener_serie_inexistente(cliente):
+    assert cliente.get('/admin/series/99', headers=ADMIN).status_code == 404
+    assert cliente.get('/admin/series/1').status_code == 401
