+from datetime import timedelta
+
+import httpx
+import pytest
+
+from conftest import ADMIN, AHORA, auth
+from pulso import db, reloj
+
+
+class FakeCobra:
+    """Cobrá simulado: reemplaza httpx.request."""
+
+    def __init__(self):
+        self.pagos = {}
+        self.falla = False
+        self.llamadas = []
+
+    def pago(self, id, referencia, estado='pendiente', monto=1200):
+        self.pagos[id] = {'id': id, 'estado': estado, 'monto': monto, 'moneda': 'UYU', 'referencia': referencia,
+                          'url_pago': f'https://pagar.cobra.uy/{id}'}
+
+    def __call__(self, metodo, url, headers=None, json=None, params=None, timeout=None):
+        self.llamadas.append((metodo, url, headers, json))
+        if self.falla:
+            raise httpx.ConnectError('rechazada')
+        ruta = url.removeprefix('https://api.cobra.uy/v1')
+        if headers.get('X-Cobra-Clave') != 'clave-cobra':
+            return httpx.Response(401)
+        if metodo == 'POST' and ruta == '/pagos':
+            ref = json['referencia']
+            existente = [p for p in self.pagos.values() if p['referencia'] == headers['Idempotency-Key']]
+            if existente:
+                return httpx.Response(200, json=existente[0])
+            self.pago(f'pag_{len(self.pagos) + 1}', ref, monto=json['monto'])
+            return httpx.Response(201, json=self.pagos[f'pag_{len(self.pagos)}'])
+        if metodo == 'GET' and ruta == '/pagos':
+            return httpx.Response(200, json={'pagos': [p for p in self.pagos.values()
+                                                       if p['referencia'] == params['referencia']]})
+        if metodo == 'GET' and ruta.startswith('/pagos/'):
+            p = self.pagos.get(ruta.removeprefix('/pagos/'))
+            return httpx.Response(200, json=p) if p else httpx.Response(404)
+        return httpx.Response(500)
+
+
+@pytest.fixture
+def cobra(monkeypatch, cliente):
+    monkeypatch.setenv('PULSO_PAGOS_URL', 'https://api.cobra.uy/v1')
+    monkeypatch.setenv('PULSO_PAGOS_CLAVE', 'clave-cobra')
+    fake = FakeCobra()
+    monkeypatch.setattr(httpx, 'request', fake)
+    return fake
+
+
+def comprar(cliente, socio, pack='pack-4'):
+    return cliente.post('/compras', json={'pack': pack}, headers=auth(socio))
+
+
+def creditos(cliente, socio):
+    return cliente.get('/yo', headers=auth(socio)).json()['creditos']
+
+
+def test_compra_crea_pago(cliente, socio, cobra):
+    r = comprar(cliente, socio)
+    assert r.status_code == 201
+    assert r.json() == {'id': 1, 'pack': 'pack-4', 'creditos': 4, 'monto': 1200, 'estado': 'pendiente',
+                        'creada': '2026-11-10T15:00:00+00:00', 'url_pago': 'https://pagar.cobra.uy/pag_1'}
+    _, _, headers, cuerpo = cobra.llamadas[0]
+    assert headers['Idempotency-Key'] == 'pulso-compra-1'
+    assert cuerpo == {'monto': 1200, 'moneda': 'UYU', 'referencia': 'pulso-compra-1'}
+    assert creditos(cliente, socio) == 8
+
+
+@pytest.mark.parametrize('cuerpo', [{}, {'pack': 'pack-9'}, {'pack': None}])
+def test_pack_invalido(cliente, socio, cobra, cuerpo):
+    assert cliente.post('/compras', json=cuerpo, headers=auth(socio)).status_code == 422
+    assert db.compras_de(socio['id']) == [] and cobra.llamadas == []
+
+
+def test_compra_sin_token(cliente, cobra):
+    assert cliente.post('/compras', json={'pack': 'pack-4'}).status_code == 401
+
+
+def test_cobra_falla_al_crear(cliente, socio, cobra):
+    cobra.falla = True
+    assert comprar(cliente, socio).status_code == 502
+    lista = cliente.get('/compras', headers=auth(socio)).json()
+    assert [(c['estado'], c['url_pago']) for c in lista] == [('pendiente', None)]
+
+
+def test_listado_mas_nueva_primero(cliente, socio, cobra):
+    comprar(cliente, socio)
+    reloj.fijar(AHORA + timedelta(minutes=1))
+    comprar(cliente, socio, 'pack-8')
+    assert [c['id'] for c in cliente.get('/compras', headers=auth(socio)).json()] == [2, 1]
+    otro = db.crear_socio('Beto', 'beto@example.com')
+    assert cliente.get('/compras', headers=auth(otro)).json() == []
+
+
+def test_webhook_aprueba_una_sola_vez(cliente, socio, cobra):
+    comprar(cliente, socio)
+    cobra.pagos['pag_1']['estado'] = 'aprobado'
+    for _ in range(2):
+        r = cliente.post('/webhooks/pagos', json={'pago_id': 'pag_1', 'estado': 'rechazado'})
+        assert r.status_code == 200 and r.json() == {'compra_id': 1, 'estado': 'aprobada'}
+    assert creditos(cliente, socio) == 12
+    assert [c['asunto'] for c in db.correos()] == ['Compra de créditos aprobada']
+
+
+def test_webhook_rechazado_y_pendiente(cliente, socio, cobra):
+    comprar(cliente, socio)
+    comprar(cliente, socio)
+    cobra.pagos['pag_2']['estado'] = 'rechazado'
+    assert cliente.post('/webhooks/pagos', json={'pago_id': 'pag_1'}).json()['estado'] == 'pendiente'
+    assert cliente.post('/webhooks/pagos', json={'pago_id': 'pag_2'}).json()['estado'] == 'rechazada'
+    assert creditos(cliente, socio) == 8 and db.correos() == []
+
+
+def test_webhook_errores(cliente, socio, cobra):
+    assert cliente.post('/webhooks/pagos', json={}).status_code == 422
+    assert cliente.post('/webhooks/pagos', json={'pago_id': 'nada'}).status_code == 404
+    cobra.pago('pag_x', 'otra-cosa', 'aprobado')
+    assert cliente.post('/webhooks/pagos', json={'pago_id': 'pag_x'}).status_code == 404
+    cobra.pago('pag_y', 'pulso-compra-99', 'aprobado')
+    assert cliente.post('/webhooks/pagos', json={'pago_id': 'pag_y'}).status_code == 404
+    cobra.falla = True
+    assert cliente.post('/webhooks/pagos', json={'pago_id': 'pag_1'}).status_code == 503
+
+
+def test_webhook_guarda_pago_de_compra_sin_pago(cliente, socio, cobra):
+    cobra.falla = True
+    comprar(cliente, socio)
+    cobra.falla = False
+    cobra.pago('pag_7', 'pulso-compra-1', 'aprobado')
+    r = cliente.post('/webhooks/pagos', json={'pago_id': 'pag_7'})
+    assert r.json() == {'compra_id': 1, 'estado': 'aprobada'}
+    assert cliente.get('/compras', headers=auth(socio)).json()[0]['url_pago'] == 'https://pagar.cobra.uy/pag_7'
+
+
+def test_conciliar_requiere_admin(cliente, cobra):
+    assert cliente.post('/admin/conciliar-pagos').status_code == 401
+
+
+def test_conciliar(cliente, socio, cobra):
+    otro = db.crear_socio('Beto', 'beto@example.com')
+    comprar(cliente, socio)  # 1: aprobada
+    comprar(cliente, otro)  # 2: rechazada
+    comprar(cliente, socio)  # 3: sigue pendiente
+    cobra.pagos['pag_1']['estado'] = 'aprobado'
+    cobra.pagos['pag_2']['estado'] = 'rechazado'
+    cobra.falla = True
+    for _ in range(3):  # 4, 5, 6: sin pago
+        comprar(cliente, socio)
+    cobra.falla = False
+    db.crear_compra(socio['id'], 'pack-4', 4, 1200, AHORA - timedelta(minutes=30))  # 7: sin pago, vieja
+    cobra.pago('pag_9', 'pulso-compra-4', 'aprobado')  # 4: pago hallado por referencia
+    r = cliente.post('/admin/conciliar-pagos', headers=ADMIN)
+    assert r.json() == {'aprobadas': 2, 'rechazadas': 2, 'pendientes': 3}
+    assert db.compra(4)['pago_id'] == 'pag_9'
+    assert db.compra(7)['estado'] == 'rechazada'
+    assert creditos(cliente, socio) == 8 + 8
+    again = cliente.post('/admin/conciliar-pagos', headers=ADMIN).json()
+    assert again == {'aprobadas': 0, 'rechazadas': 0, 'pendientes': 3}
+    assert len(db.correos()) == 2
+
+
+def test_conciliar_con_cobra_caido_no_rechaza(cliente, socio, cobra):
+    db.crear_compra(socio['id'], 'pack-4', 4, 1200, AHORA - timedelta(hours=2))
+    comprar(cliente, socio)
+    cobra.falla = True
+    r = cliente.post('/admin/conciliar-pagos', headers=ADMIN)
+    assert r.json() == {'aprobadas': 0, 'rechazadas': 0, 'pendientes': 2}
+
+
+def test_conciliar_compra_reciente_sin_pago_sigue_pendiente(cliente, socio, cobra):
+    db.crear_compra(socio['id'], 'pack-4', 4, 1200, AHORA - timedelta(minutes=29))
+    r = cliente.post('/admin/conciliar-pagos', headers=ADMIN)
+    assert r.json() == {'aprobadas': 0, 'rechazadas': 0, 'pendientes': 1}
