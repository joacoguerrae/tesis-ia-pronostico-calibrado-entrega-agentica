+    juan = socio_corporativo('juan@example.com', 'otra', creditos=12)
+    empleados(servicio, {('acme', 'ana.perez@example.com'): ACTIVO, ('otra', 'juan@example.com'): ACTIVO})
+    r = cliente.post('/admin/revalidar-convenios', headers=ADMIN)
+    assert r.json() == {'siguen': 2, 'bajaron': 0, 'sin_revisar': 0}
