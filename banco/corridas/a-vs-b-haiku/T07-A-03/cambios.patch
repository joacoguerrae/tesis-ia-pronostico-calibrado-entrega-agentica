+
+
+def compras_pendientes():
+    return _varias("SELECT * FROM compras WHERE estado = 'pendiente' ORDER BY id")
+
+
+def guardar_pago(compra_id, pago_id, url_pago):
+    """Guarda el pago en una compra que todavía no tiene."""
+    with conexion() as con:
+        con.execute('UPDATE compras SET pago_id = ?, url_pago = ? WHERE id = ? AND pago_id IS NULL',
+                    (pago_id, url_pago, compra_id))
+
+
+def cerrar_compra(compra_id, estado, sin_pago=False):
+    """Pasa una compra pendiente a aprobada o rechazada, una sola vez. Si es aprobada suma los
+    créditos en la misma transacción. Devuelve True solo si esta llamada hizo el cambio."""
+    sql = "UPDATE compras SET estado = ? WHERE id = ? AND estado = 'pendiente'"
+    if sin_pago:
+        sql += ' AND pago_id IS NULL'
+    with conexion() as con:
+        con.execute('BEGIN IMMEDIATE')
+        cambio = con.execute(sql, (estado, compra_id)).rowcount == 1
+        if cambio and estado == 'aprobada':
+            con.execute('UPDATE socios SET creditos = creditos + (SELECT creditos FROM compras WHERE id = ?) '
+                        'WHERE id = (SELECT socio_id FROM compras WHERE id = ?)', (compra_id, compra_id))
+    return cambio
+
+
 def correos():
