diff --git a/tests/test_admin.py b/tests/test_admin.py
new file mode 100644
index 0000000..728a123
--- /dev/null
+++ b/tests/test_admin.py
@@ -0,0 +1,222 @@
+from datetime import timedelta
+
+from conftest import ADMIN, AHORA, INICIO, auth, correos_a, ocupar, socio_nuevo
+from pulso import db, reloj
+
+LIBERADO = 'Se liberó un lugar: Spinning el 12/11 a las 19:00'
+NO_PUDIMOS = 'No pudimos darte el lugar: Spinning el 12/11 a las 19:00'
+
+
+def anotar(cliente, socio, clase):
+    assert cliente.post(f"/clases/{clase['id']}/espera", headers=auth(socio)).status_code == 201
+
+
+def posicion(cliente, socio, clase):
+    r = cliente.get(f"/clases/{clase['id']}/espera", headers=auth(socio))
+    return r.json()['posicion'] if r.status_code == 200 else None
+
+
+def en_lista(cliente, socio, clase):
+    return posicion(cliente, socio, clase) is not None
+
+
+def reservas_de(cliente, socio):
+    return {r['clase_id']: r['estado'] for r in cliente.get('/reservas', headers=auth(socio)).json()}
+
+
+def creditos(cliente, socio):
+    return cliente.get('/yo', headers=auth(socio)).json()['creditos']
+
+
+# Cancelar reservas
+
+def test_cancelar_requiere_clave_de_admin(cliente):
+    ana = socio_nuevo('Ana')
+    clase = db.crear_clase('Spinning', 'Leo', INICIO, cupo=1)
+    reserva = db.crear_reserva(ana['id'], clase['id'], AHORA)
