diff --git a/pulso/main.py b/pulso/main.py
index 039212d..47c023d 100644
--- a/pulso/main.py
+++ b/pulso/main.py
@@ -1,12 +1,21 @@
+import csv
+import io
 import os
+import re
+from datetime import date
 
 from fastapi import APIRouter, Depends, FastAPI, Header, HTTPException
+from fastapi.responses import Response
 from pydantic import AwareDatetime, BaseModel, Field
 
 from pulso import correo, db, reloj
 
 router = APIRouter()
 
+OCUPACION_ENCABEZADO = ['fecha', 'hora', 'clase', 'instructor', 'cupo', 'confirmadas', 'ocupacion_pct']
+OCUPACION_MAX_DIAS = 31
+FORMATO_FECHA = re.compile(r'\d{4}-\d{2}-\d{2}')
+
 
 def socio_actual(authorization: str | None = Header(default=None)):
     if not authorization or not authorization.startswith('Bearer '):
@@ -44,6 +53,45 @@ def obtener_clase(clase_id: int):
     return ver_clase(clase)
 
 
+def fecha_del_filtro(nombre, valor):
+    if valor is None or not FORMATO_FECHA.fullmatch(valor):
+        raise HTTPException(422, f'{nombre} es obligatorio y tiene que tener formato YYYY-MM-DD')
+    try:
+        return date.fromisoformat(valor)
+    except ValueError:
+        raise HTTPException(422, f'{nombre} no es una fecha válida')
+
+
+def porcentaje_ocupacion(confirmadas, cupo):
+    # Entero redondeado con los ,5 para arriba, sin errores de punto flotante.
+    return (200 * confirmadas + cupo) // (2 * cupo)
+
+
+@router.get('/admin/ocupacion.csv', dependencies=[Depends(admin)])
+def ocupacion_csv(desde: str | None = None, hasta: str | None = None):
+    desde_dia = fecha_del_filtro('desde', desde)
+    hasta_dia = fecha_del_filtro('hasta', hasta)
+    if desde_dia > hasta_dia:
+        raise HTTPException(422, "'desde' no puede ser posterior a 'hasta'")
+    if (hasta_dia - desde_dia).days + 1 > OCUPACION_MAX_DIAS:
+        raise HTTPException(422, f'El período no puede tener más de {OCUPACION_MAX_DIAS} días')
+
+    filas = []
+    for clase in sorted(db.clases(), key=lambda c: (db.a_fecha(c['inicio']), c['id'])):
+        inicio = db.a_fecha(clase['inicio']).astimezone(reloj.MONTEVIDEO)
+        if not desde_dia <= inicio.date() <= hasta_dia:
+            continue
+        confirmadas = db.confirmadas(clase['id'])
+        filas.append([f'{inicio:%Y-%m-%d}', f'{inicio:%H:%M}', clase['nombre'], clase['instructor'],
+                      clase['cupo'], confirmadas, porcentaje_ocupacion(confirmadas, clase['cupo'])])
+
+    salida = io.StringIO()
+    escritor = csv.writer(salida)
+    escritor.writerow(OCUPACION_ENCABEZADO)
+    escritor.writerows(filas)
+    return Response(salida.getvalue(), media_type='text/csv; charset=utf-8')
+
+
 class NuevaClase(BaseModel):
     nombre: str = Field(min_length=1)
     instructor: str = Field(min_length=1)
