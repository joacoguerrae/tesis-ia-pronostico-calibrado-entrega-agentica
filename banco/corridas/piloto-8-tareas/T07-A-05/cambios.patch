+from datetime import timedelta
+
+import httpx
+import pytest
+
+from conftest import ADMIN, AHORA, auth
+from pulso import db, reloj
+
+BASE = 'https://api.cobra.uy/v1'
+
+
+class FakeCobra:
+    def __init__(self):
+        self.pagos = {}
+        self.llamadas = []
+        self.caido = False
+        self.falla_crear = False
+
+    def pago(self, ref, estado='pendiente', monto=1200):
+        p = {'id': f'pag_{len(self.pagos) + 1}', 'estado': estado, 'monto': monto, 'moneda': 'UYU',
+             'referencia': ref, 'url_pago': f'https://pagar.cobra.uy/pag_{len(self.pagos) + 1}'}
+        self.pagos[p['id']] = p
+        return p
+
+    def request(self, metodo, url, headers=None, timeout=None, json=None, params=None):
+        self.llamadas.append((metodo, url, headers, json))
+        assert headers['X-Cobra-Clave'] == 'clave-cobra'
+        assert timeout == 5
+        if self.caido:
+            raise httpx.ConnectError('caído')
+        ruta = url.removeprefix(BASE)
+        req = httpx.Request(metodo, url)
+        if metodo == 'POST' and ruta == '/pagos':
+            if self.falla_crear:
+                return httpx.Response(500, request=req)
+            ref = headers['Idempotency-Key']
+            for p in self.pagos.values():
+                if p['referencia'] == ref:
+                    return httpx.Response(200, json=p, request=req)
+            return httpx.Response(201, json=self.pago(ref, monto=json['monto']), request=req)
+        if metodo == 'GET' and ruta == '/pagos':
+            return httpx.Response(200, json={'pagos': [p for p in self.pagos.values()
+                                                       if p['referencia'] == params['referencia']]}, request=req)
+        if metodo == 'GET' and ruta.startswith('/pagos/'):
+            p = self.pagos.get(ruta.removeprefix('/pagos/'))
+            return httpx.Response(200, json=p, request=req) if p else httpx.Response(404, request=req)
+        raise AssertionError(ruta)
+
+
+@pytest.fixture
+def cobra(monkeypatch):
+    monkeypatch.setenv('PULSO_PAGOS_URL', BASE)
+    monkeypatch.setenv('PULSO_PAGOS_CLAVE', 'clave-cobra')
+    fake = FakeCobra()
+    monkeypatch.setattr(httpx, 'request', fake.request)
+    return fake
+
+
+def creditos(cliente, socio):
+    return cliente.get('/yo', headers=auth(socio)).json()['creditos']
+
+
+def comprar(cliente, socio, pack='pack-4'):
+    return cliente.post('/compras', json={'pack': pack}, headers=auth(socio))
+
+
+def comprar_sin_pago(cliente, socio):
+    assert comprar(cliente, socio).status_code == 502
+    return {'id': db.compras_de(socio['id'])[0]['id']}
+
+
+def test_compra_crea_pago(cliente, socio, cobra):
+    r = comprar(cliente, socio, 'pack-8')
+    assert r.status_code == 201
+    c = r.json()
+    assert (c['creditos'], c['monto'], c['estado']) == (8, 2200, 'pendiente')
+    assert c['url_pago'] == 'https://pagar.cobra.uy/pag_1'
+    _, _, headers, body = cobra.llamadas[0]
+    assert headers['Idempotency-Key'] == f"pulso-compra-{c['id']}"
+    assert body == {'monto': 2200, 'moneda': 'UYU', 'referencia': f"pulso-compra-{c['id']}"}
+    assert creditos(cliente, socio) == 8
+
+
+@pytest.mark.parametrize('cuerpo', [{}, {'pack': 'pack-9'}, {'pack': None}])
+def test_pack_invalido(cliente, socio, cobra, cuerpo):
+    assert cliente.post('/compras', json=cuerpo, headers=auth(socio)).status_code == 422
+    assert cobra.llamadas == []
+    assert cliente.get('/compras', headers=auth(socio)).json() == []
+
+
+def test_compras_requiere_token(cliente, cobra):
+    assert cliente.post('/compras', json={'pack': 'pack-4'}).status_code == 401
+    assert cliente.get('/compras').status_code == 401
+
+
+def test_cobra_falla_deja_compra_pendiente(cliente, socio, cobra):
+    cobra.falla_crear = True
+    assert comprar(cliente, socio).status_code == 502
+    lista = cliente.get('/compras', headers=auth(socio)).json()
+    assert len(lista) == 1 and lista[0]['estado'] == 'pendiente' and lista[0]['url_pago'] is None
+
+
+def test_listado_mas_nueva_primero(cliente, socio, cobra):
+    a = comprar(cliente, socio).json()['id']
+    reloj.fijar(AHORA + timedelta(minutes=1))
+    b = comprar(cliente, socio).json()['id']
+    assert [c['id'] for c in cliente.get('/compras', headers=auth(socio)).json()] == [b, a]
+
+
+def test_webhook_aprueba_una_sola_vez(cliente, socio, cobra):
+    c = comprar(cliente, socio).json()
+    cobra.pagos['pag_1']['estado'] = 'aprobado'
+    for _ in range(2):
+        r = cliente.post('/webhooks/pagos', json={'pago_id': 'pag_1', 'estado': 'rechazado'})
+        assert r.json() == {'compra_id': c['id'], 'estado': 'aprobada'}
+    assert creditos(cliente, socio) == 12
+    correos = [m for m in db.correos() if m['asunto'] == 'Compra de créditos aprobada']
+    assert len(correos) == 1 and correos[0]['para'] == 'ana@example.com'
+
+
+def test_webhook_rechazado_y_final(cliente, socio, cobra):
+    c = comprar(cliente, socio).json()
+    cobra.pagos['pag_1']['estado'] = 'rechazado'
+    assert cliente.post('/webhooks/pagos', json={'pago_id': 'pag_1'}).json()['estado'] == 'rechazada'
+    cobra.pagos['pag_1']['estado'] = 'aprobado'
+    assert cliente.post('/webhooks/pagos', json={'pago_id': 'pag_1'}).json()['estado'] == 'rechazada'
+    assert creditos(cliente, socio) == 8 and db.correos() == []
+    assert c['id']
+
+
+def test_webhook_pendiente_no_cambia(cliente, socio, cobra):
+    comprar(cliente, socio)
+    r = cliente.post('/webhooks/pagos', json={'pago_id': 'pag_1', 'estado': 'aprobado'})
+    assert r.json()['estado'] == 'pendiente' and creditos(cliente, socio) == 8
+
+
+def test_webhook_errores(cliente, socio, cobra):
+    assert cliente.post('/webhooks/pagos', json={}).status_code == 422
+    assert cliente.post('/webhooks/pagos', json={'pago_id': 'nada'}).status_code == 404
+    cobra.pago('otra-cosa', 'aprobado')
+    assert cliente.post('/webhooks/pagos', json={'pago_id': 'pag_1'}).status_code == 404
+    cobra.pago('pulso-compra-999', 'aprobado')
+    assert cliente.post('/webhooks/pagos', json={'pago_id': 'pag_2'}).status_code == 404
+    cobra.caido = True
+    assert cliente.post('/webhooks/pagos', json={'pago_id': 'pag_2'}).status_code == 503
+
+
+def test_webhook_guarda_pago_de_compra_sin_pago(cliente, socio, cobra):
+    cobra.falla_crear = True
+    c = comprar_sin_pago(cliente, socio)
+    cobra.falla_crear = False
+    cobra.pago(f"pulso-compra-{c['id']}", 'aprobado')
+    r = cliente.post('/webhooks/pagos', json={'pago_id': 'pag_1'})
+    assert r.json() == {'compra_id': c['id'], 'estado': 'aprobada'}
+    assert cliente.get('/compras', headers=auth(socio)).json()[0]['url_pago'] == 'https://pagar.cobra.uy/pag_1'
+
+
+def test_conciliar_requiere_clave(cliente, cobra):
+    assert cliente.post('/admin/conciliar-pagos').status_code == 401
+
+
+def test_conciliar(cliente, socio, cobra):
+    otro = db.crear_socio('Beto', 'beto@example.com')
+    a = comprar(cliente, socio).json()['id']      # aprobada
+    b = comprar(cliente, otro).json()['id']       # rechazada
+    comprar(cliente, socio)                       # pendiente
+    cobra.pagos['pag_1']['estado'] = 'aprobado'
+    cobra.pagos['pag_2']['estado'] = 'rechazado'
+    cobra.falla_crear = True
+    sin_pago_vieja = comprar_sin_pago(cliente, socio)['id']
+    reloj.fijar(AHORA + timedelta(minutes=30))
+    sin_pago_nueva = comprar_sin_pago(cliente, otro)['id']
+    r = cliente.post('/admin/conciliar-pagos', headers=ADMIN)
+    assert r.json() == {'aprobadas': 1, 'rechazadas': 2, 'pendientes': 2}
+    estados = {c['id']: c['estado'] for c in cliente.get('/compras', headers=auth(socio)).json()}
+    assert estados[a] == 'aprobada' and estados[sin_pago_vieja] == 'rechazada'
+    assert db.compra(b)['estado'] == 'rechazada' and db.compra(sin_pago_nueva)['estado'] == 'pendiente'
+    assert creditos(cliente, socio) == 12
+    # segunda pasada: lo ya resuelto no se cuenta ni repite
+    assert cliente.post('/admin/conciliar-pagos', headers=ADMIN).json() == {'aprobadas': 0, 'rechazadas': 0, 'pendientes': 2}
+    assert len(db.correos()) == 1
+
+
+def test_conciliar_encuentra_pago_por_referencia(cliente, socio, cobra):
+    cobra.falla_crear = True
+    c = comprar_sin_pago(cliente, socio)
+    cobra.pago(f"pulso-compra-{c['id']}", 'aprobado')
+    r = cliente.post('/admin/conciliar-pagos', headers=ADMIN)
+    assert r.json() == {'aprobadas': 1, 'rechazadas': 0, 'pendientes': 0}
+    assert db.compra(c['id'])['pago_id'] == 'pag_1'
+
+
+def test_conciliar_con_cobra_caido_no_rechaza(cliente, socio, cobra):
+    cobra.falla_crear = True
+    comprar(cliente, socio)
+    reloj.fijar(AHORA + timedelta(hours=2))
+    cobra.caido = True
+    assert cliente.post('/admin/conciliar-pagos', headers=ADMIN).json() == {'aprobadas': 0, 'rechazadas': 0, 'pendientes': 1}
