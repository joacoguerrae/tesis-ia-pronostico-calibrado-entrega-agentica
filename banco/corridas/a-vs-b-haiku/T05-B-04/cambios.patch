diff --git a/tests/test_base.py b/tests/test_base.py
index 5d9460b..0532426 100644
--- a/tests/test_base.py
+++ b/tests/test_base.py
@@ -1,7 +1,7 @@
 from datetime import timedelta
 
 from conftest import ADMIN, AHORA, auth
-from pulso import db
+from pulso import db, reloj
 
 
 def test_lista_solo_clases_futuras_en_orden(cliente):
@@ -79,3 +79,66 @@ def test_mis_reservas_en_orden_de_clase(cliente, socio):
         cliente.post('/reservas', json={'clase_id': clase['id']}, headers=auth(socio))
     r = cliente.get('/reservas', headers=auth(socio))
     assert [x['clase_id'] for x in r.json()] == [temprano['id'], tarde['id']]
+
+
+def test_recordatorios_requiere_clave_admin(cliente):
+    assert cliente.post('/admin/recordatorios').status_code == 401
+    assert cliente.post('/admin/recordatorios', headers={'X-Admin-Key': 'otra'}).status_code == 401
+
+
+def test_recordatorio_para_clases_de_las_proximas_24_horas(cliente, socio):
+    en_ventana = db.crear_clase('Yoga', 'Sofía', AHORA + timedelta(hours=3))
+    justo_24h = db.crear_clase('Spinning', 'Leo', AHORA + timedelta(hours=24))
+    despues = db.crear_clase('Funcional', 'Leo', AHORA + timedelta(hours=24, seconds=1))
+    empezo = db.crear_clase('Pilates', 'Marta', AHORA)
+    for clase in (en_ventana, justo_24h, despues, empezo):
+        db.crear_reserva(socio['id'], clase['id'], AHORA)
+    r = cliente.post('/admin/recordatorios', headers=ADMIN)
+    assert r.status_code == 200
+    assert r.json() == {'enviados': 2}
+    asuntos = sorted(c['asunto'] for c in db.correos())
+    assert asuntos == [
+        'Recordatorio: Spinning el 11/11 a las 12:00',
+        'Recordatorio: Yoga el 10/11 a las 15:00',
+    ]
+
+
+def test_recordatorio_es_a_socio_y_nombra_instructor(cliente, socio):
+    clase = db.crear_clase('Yoga', 'Sofía', AHORA + timedelta(hours=6, minutes=30))
+    db.crear_reserva(socio['id'], clase['id'], AHORA)
+    cliente.post('/admin/recordatorios', headers=ADMIN)
+    [enviado] = db.correos()
+    assert enviado['para'] == 'ana@example.com'
+    assert enviado['asunto'] == 'Recordatorio: Yoga el 10/11 a las 18:30'
+    assert 'Sofía' in enviado['cuerpo']
+
+
+def test_recordatorio_se_manda_una_sola_vez(cliente, socio):
+    clase = db.crear_clase('Yoga', 'Sofía', AHORA + timedelta(hours=5))
+    db.crear_reserva(socio['id'], clase['id'], AHORA)
+    assert cliente.post('/admin/recordatorios', headers=ADMIN).json() == {'enviados': 1}
+    assert cliente.post('/admin/recordatorios', headers=ADMIN).json() == {'enviados': 0}
+    assert len(db.correos()) == 1
+
+
+def test_reserva_hecha_con_menos_de_24_horas_recibe_recordatorio(cliente, socio):
+    clase = db.crear_clase('Yoga', 'Sofía', AHORA + timedelta(hours=2))
+    assert cliente.post('/reservas', json={'clase_id': clase['id']}, headers=auth(socio)).status_code == 201
+    assert cliente.post('/admin/recordatorios', headers=ADMIN).json() == {'enviados': 1}
+    assert len(db.correos()) == 2  # confirmación + recordatorio
+
+
+def test_reservas_no_confirmadas_no_reciben_recordatorio(cliente, socio):
+    clase = db.crear_clase('Yoga', 'Sofía', AHORA + timedelta(hours=3))
+    db.crear_reserva(socio['id'], clase['id'], AHORA, estado='cancelada')
+    assert cliente.post('/admin/recordatorios', headers=ADMIN).json() == {'enviados': 0}
+    assert db.correos() == []
+
+
+def test_recordatorio_no_se_repite_en_llamadas_posteriores(cliente, socio):
+    clase = db.crear_clase('Yoga', 'Sofía', AHORA + timedelta(hours=3))
+    db.crear_reserva(socio['id'], clase['id'], AHORA)
+    cliente.post('/admin/recordatorios', headers=ADMIN)
+    reloj.fijar(AHORA + timedelta(minutes=15))
+    assert cliente.post('/admin/recordatorios', headers=ADMIN).json() == {'enviados': 0}
+    assert len(db.correos()) == 1
