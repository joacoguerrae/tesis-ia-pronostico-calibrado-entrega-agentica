 from fastapi import APIRouter, Depends, FastAPI, Header, HTTPException
+from fastapi.responses import Response
 from pydantic import AwareDatetime, BaseModel, Field
 
 from pulso import correo, db, reloj
 
 router = APIRouter()
 
+DIAS_MAXIMOS_EXPORTACION = 31
+CABECERA_OCUPACION = ['fecha', 'hora', 'clase', 'instructor', 'cupo', 'confirmadas', 'ocupacion_pct']
+
 
 def socio_actual(authorization: str | None = Header(default=None)):
     if not authorization or not authorization.startswith('Bearer '):
@@ -57,6 +65,52 @@ def crear_clase(datos: NuevaClase):
     return ver_clase(db.crear_clase(**datos.model_dump()))
 
 
+def fecha_de_periodo(texto, nombre):
+    if not texto or not re.fullmatch(r'[0-9]{4}-[0-9]{2}-[0-9]{2}', texto):
+        raise HTTPException(422, f'{nombre} es obligatorio, formato YYYY-MM-DD')
+    try:
+        return date.fromisoformat(texto)
+    except ValueError:
+        raise HTTPException(422, f'{nombre} no es una fecha válida')
+
+
+def porcentaje_ocupacion(confirmadas, cupo):
+    # confirmadas / cupo * 100 redondeado al entero más cercano, con los ,5 para arriba.
+    return (2 * confirmadas * 100 + cupo) // (2 * cupo)
+
+
+@router.get('/admin/ocupacion.csv', dependencies=[Depends(admin)])
+def exportar_ocupacion(desde: str | None = None, hasta: str | None = None):
+    inicio_periodo = fecha_de_periodo(desde, 'desde')
+    fin_periodo = fecha_de_periodo(hasta, 'hasta')
+    if inicio_periodo > fin_periodo:
+        raise HTTPException(422, 'desde es posterior a hasta')
+    if (fin_periodo - inicio_periodo).days + 1 > DIAS_MAXIMOS_EXPORTACION:
+        raise HTTPException(422, f'El período no puede tener más de {DIAS_MAXIMOS_EXPORTACION} días')
+
+    filas = []
+    for clase in db.clases():
+        local = db.a_fecha(clase['inicio']).astimezone(reloj.MONTEVIDEO)
+        if not inicio_periodo <= local.date() <= fin_periodo:
+            continue
+        confirmadas = db.confirmadas(clase['id'])
+        filas.append([
+            local.strftime('%Y-%m-%d'),
+            local.strftime('%H:%M'),
+            clase['nombre'],
+            clase['instructor'],
+            clase['cupo'],
+            confirmadas,
+            porcentaje_ocupacion(confirmadas, clase['cupo']),
+        ])
+
+    salida = io.StringIO()
+    escritor = csv.writer(salida)  # RFC 4180: separador coma, comillas dobles, CRLF.
+    escritor.writerow(CABECERA_OCUPACION)
+    escritor.writerows(filas)
+    return Response(salida.getvalue(), media_type='text/csv; charset=utf-8')
+
+
 class NuevaReserva(BaseModel):
     clase_id: int
 
