{"host.arch": "amd64", "os.type": "linux", "os.version": "6.18.33.2-microsoft-standard-WSL2", "service.name": "claude-code", "service.version": "2.1.312", "wsl.version": "2", "user.id": "0f72bbf305cc3cfe4c49efd7a27949e16f5ce38c2de862b736399de5c3c79b13", "session.id": "a60cc823-9263-48c3-a8db-23eace8eb813", "terminal.type": "wsl-Ubuntu-24.04", "gen_ai.provider.name": "anthropic", "span.type": "tool", "tool_name": "Bash", "tool_name_safe": "Bash", "gen_ai.operation.name": "execute_tool", "gen_ai.tool.name": "Bash", "gen_ai.conversation.id": "a60cc823-9263-48c3-a8db-23eace8eb813", "full_command": "cat > tests/test_filtros.py <<'EOF'\nfrom datetime import datetime, timezone\n\nfrom pulso import db\nfrom tests.conftest import auth\n\n\ndef clase(dia, hora, instructor='Leo', cupo=5, h=0):\n    # hora en UTC\n    return db.crear_clase('Yoga', instructor, datetime(2026, 11, dia, hora, tzinfo=timezone.utc), 60, cupo)\n\n\ndef ids(r):\n    return [c['id'] for c in r.json()]\n\n\ndef test_sin_parametros_y_total(cliente):\n    a = clase(9, 10)  # ya empezó\n    b = clase(11, 10)\n    c = clase(11, 10)\n    r = cliente.get('/clases')\n    assert r.status_code == 200\n    assert ids(r) == [b['id'], c['id']]\n    assert r.headers['X-Total'] == '2'\n\n\ndef test_dia_en_montevideo(cliente):\n    tarde = clase(12, 2)    # 11/11 23:00 en Montevideo\n    temprano = clase(12, 4)  # 12/11 01:00\n    assert ids(cliente.get('/clases?desde=2026-11-12')) == [temprano['id']]\n    assert ids(cliente.get('/clases?hasta=2026-11-11')) == [tarde['id']]\n    assert ids(cliente.get('/clases?desde=2026-11-11&hasta=2026-11-12')) == [tarde['id'], temprano['id']]\n\n\ndef test_instructor_sin_mayusculas(cliente):\n    a = clase(11, 10, 'Leo')\n    clase(11, 11, 'Leonel')\n    assert ids(cliente.get('/clases?instructor=LEO')) == [a['id']]\n\n\ndef test_con_lugar(cliente, socio):\n    llena = clase(11, 10, cupo=1)\n    libre = clase(11, 11)\n    cliente.post('/reservas', json={'clase_id': llena['id']}, headers=auth(socio))\n    assert ids(cliente.get('/clases?con_lugar=true')) == [libre['id']]\n    assert len(ids(cliente.get('/clases?con_lugar=false'))) == 2\n\n\ndef test_paginacion(cliente):\n    cs = [clase(11, 10) for _ in range(5)]\n    r = cliente.get('/clases?pagina=2&por_pagina=2')\n    assert ids(r) == [cs[2]['id'], cs[3]['id']]\n    assert r.headers['X-Total'] == '5'\n    r = cliente.get('/clases?pagina=9&por_pagina=2')\n    assert r.json() == [] and r.headers['X-Total'] == '5'\n    assert len(cliente.get('/clases').json()) == 5\n\n\ndef test_invalidos(cliente):\n    for q in ['pagina=0', 'por_pagina=0', 'por_pagina=51', 'desde=12-11-2026', 'hasta=2026-13-01',\n              'desde=20261112', 'desde=2026-11-14&hasta=2026-11-12', 'con_lugar=quizas']:\n        assert cliente.get('/clases?' + q).status_code == 422, q\nEOF\npython -m pytest -q 2>&1 | tail -8", "bash_command_class": "file_read", "bash_argv0": "cat", "tool_use_id": "toolu_019YZ4NKZkKFRmWsS3xHExqi", "gen_ai.tool.call.id": "toolu_019YZ4NKZkKFRmWsS3xHExqi", "duration_ms": 5, "_nombre": "claude_code.tool", "_traza": "a2400827ec5fc451b7dd93645d427f60", "_tramo": "513a0a08ce209c39", "_padre": "00af8f6264c1c16a", "_inicio_ns": 1794685074696000000, "_fin_ns": 1794685074701108755, "_estado": 0}
