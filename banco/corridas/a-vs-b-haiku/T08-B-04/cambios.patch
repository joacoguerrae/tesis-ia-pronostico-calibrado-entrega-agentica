+def test_servicio_inalcanzable_es_503(cliente, socio, monkeypatch):
+    with socket.socket() as s:
+        s.bind(('127.0.0.1', 0))
+        puerto = s.getsockname()[1]
+    monkeypatch.setenv('PULSO_BENEFICIOS_URL', f'http://127.0.0.1:{puerto}')
+    r = cliente.post('/convenio', json={'empresa': 'acme'}, headers=auth(socio))
+    assert r.status_code == 503
+    assert db.socio(socio['id'])['plan'] == 'basico'
+
