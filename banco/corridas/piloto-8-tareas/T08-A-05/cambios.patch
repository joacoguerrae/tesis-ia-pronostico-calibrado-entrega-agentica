+class NuevoConvenio(BaseModel):
+    empresa: str = Field(min_length=1, pattern=r'\S')
+
+
+@router.post('/convenio')
+def activar_convenio(datos: NuevoConvenio, socio=Depends(socio_actual)):
+    if socio['plan'] == 'corporativo':
+        raise HTTPException(409, 'Ya tenés el plan corporativo')
+    try:
+        estado = beneficios.consultar(datos.empresa, socio['email'])
+    except beneficios.ServicioFalla:
+        raise HTTPException(503, 'Servicio de beneficios no disponible')
+    if estado == beneficios.EMPRESA_DESCONOCIDA:
+        raise HTTPException(404, 'No existe la empresa')
+    if estado != beneficios.ACTIVO:
+        raise HTTPException(409, 'No sos empleado activo de la empresa')
+    if not db.activar_corporativo(socio['id'], datos.empresa):
+        raise HTTPException(409, 'Ya tenés el plan corporativo')
+    correo.enviar(socio['email'], 'Ya tenés el plan corporativo',
+                  f"Hola {socio['nombre']}, tu plan corporativo está activo.")
+    actual = db.socio(socio['id'])
+    return {'plan': actual['plan'], 'empresa': actual['empresa'], 'creditos': actual['creditos']}
+
+
+@router.post('/admin/revalidar-convenios', dependencies=[Depends(admin)])
+def revalidar_convenios():
+    siguen = bajaron = sin_revisar = 0
+    for s in db.corporativos():
+        if not s.get('empresa'):
+            sin_revisar += 1
+            continue
+        try:
+            estado = beneficios.consultar(s['empresa'], s['email'])
+        except beneficios.ServicioFalla:
+            sin_revisar += 1
+            continue
+        if estado == beneficios.ACTIVO:
+            siguen += 1
+        else:
+            if db.bajar_a_basico(s['id']):
+                correo.enviar(s['email'], 'Se terminó tu plan corporativo',
+                              f"Hola {s['nombre']}, tu plan corporativo terminó y volviste al plan básico.")
+            bajaron += 1
+    return {'siguen': siguen, 'bajaron': bajaron, 'sin_revisar': sin_revisar}
+
+
