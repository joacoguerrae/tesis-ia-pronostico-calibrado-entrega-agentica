@@ -0,0 +1,256 @@
+from urllib.parse import unquote_plus
+
+import httpx
+import pytest
+
+from conftest import ADMIN, auth
+from pulso import beneficios, db
+
+URL = 'https://beneficios.example.com'
+CLAVE = 'clave-beneficios'
+
+
+class Servicio:
+    """Imita el servicio de beneficios. Decodifica el path como formulario, igual que el real."""
+
+    def __init__(self):
+        self.empresas = {'acme', 'otra'}
+        self.activos = {}  # email en minúsculas -> activo
+        self.fallas = {}  # email en minúsculas -> excepción o httpx.Response
+        self.caida = None  # excepción o httpx.Response para todas las consultas
+        self.pedidos = []
+
+    def atender(self, request):
+        self.pedidos.append(request)
+        if request.headers.get('X-Api-Key') != CLAVE:
+            return httpx.Response(401, json={'error': 'clave_invalida'})
+        partes = request.url.raw_path.decode().split('/')
+        empresa, email = unquote_plus(partes[2]), unquote_plus(partes[4])
+        if self.caida is not None:
+            return self._fallo(self.caida, request)
+        if email in self.fallas:
+            return self._fallo(self.fallas[email], request)
+        if empresa not in self.empresas:
+            return httpx.Response(404, json={'error': 'empresa_desconocida'})
+        if email not in self.activos:
+            return httpx.Response(404, json={'error': 'empleado_desconocido'})
+        return httpx.Response(200, json={'activo': self.activos[email]})
+
+    @staticmethod
+    def _fallo(falla, request):
+        if isinstance(falla, Exception):
+            raise falla
+        return falla
+
+
+@pytest.fixture(autouse=True)
+def servicio(monkeypatch):
+    monkeypatch.setenv('PULSO_BENEFICIOS_URL', URL)
+    monkeypatch.setenv('PULSO_BENEFICIOS_CLAVE', CLAVE)
+    s = Servicio()
+    monkeypatch.setattr(beneficios, 'transporte', httpx.MockTransport(s.atender))
+    return s
+
+
+def activar(cliente, socio, empresa='acme'):
+    return cliente.post('/convenio', json={'empresa': empresa}, headers=auth(socio))
+
+
+def socio_con_convenio(email, empresa='acme', creditos=12):
+    socio = db.crear_socio('Ana Pérez', email, creditos=creditos)
+    assert db.activar_convenio(socio['id'], empresa)
+    return db.socio(socio['id'])
+
+
+def asuntos():
+    return [c['asunto'] for c in db.correos()]
+
+
+# Activación
+
+def test_convenio_sin_token(cliente):
+    assert cliente.post('/convenio', json={'empresa': 'acme'}).status_code == 401
+
+
+@pytest.mark.parametrize('cuerpo', [{}, {'empresa': ''}, {'empresa': '   '}])
+def test_convenio_sin_empresa_valida(cliente, socio, cuerpo):
+    assert cliente.post('/convenio', json=cuerpo, headers=auth(socio)).status_code == 422
+
+
+def test_activa_plan_y_manda_correo(cliente, socio, servicio):
+    servicio.activos['ana@example.com'] = True
+    r = activar(cliente, socio)
+    assert r.status_code == 200
+    assert r.json() == {'plan': 'corporativo', 'empresa': 'acme', 'creditos': 12}
+    assert cliente.get('/yo', headers=auth(socio)).json()['plan'] == 'corporativo'
+    [correo] = db.correos()
+    assert correo['para'] == 'ana@example.com'
+    assert correo['asunto'] == 'Ya tenés el plan corporativo'
+
+
+@pytest.mark.parametrize('antes, despues', [(0, 12), (8, 12), (11, 12), (12, 12), (15, 15)])
+def test_piso_de_doce_creditos(cliente, servicio, antes, despues):
+    socio = db.crear_socio('Ana Pérez', 'ana@example.com', creditos=antes)
+    servicio.activos['ana@example.com'] = True
+    r = activar(cliente, socio)
+    assert r.status_code == 200
+    assert r.json()['creditos'] == despues
+    assert db.socio(socio['id'])['creditos'] == despues
+
+
+def test_consulta_con_email_en_minusculas_y_codificado(cliente, servicio):
+    socio = db.crear_socio('Ana Pérez', 'Ana.Perez+Gym@Example.com')
+    servicio.activos['ana.perez+gym@example.com'] = True
+    assert activar(cliente, socio).status_code == 200
+    [pedido] = servicio.pedidos
+    assert pedido.url.raw_path.decode() == '/empresas/acme/empleados/ana.perez%2Bgym%40example.com'
+    assert pedido.headers['X-Api-Key'] == CLAVE
+
+
+def test_consulta_con_timeout_de_tres_segundos(cliente, socio, servicio):
+    servicio.activos['ana@example.com'] = True
+    activar(cliente, socio)
+    [pedido] = servicio.pedidos
+    assert set(pedido.extensions['timeout'].values()) == {3.0}
+
+
+def test_clave_y_url_se_leen_en_cada_consulta(cliente, socio, servicio, monkeypatch):
+    servicio.activos['ana@example.com'] = True
+    monkeypatch.setenv('PULSO_BENEFICIOS_CLAVE', 'vencida')
+    assert activar(cliente, socio).status_code == 503
+    monkeypatch.setenv('PULSO_BENEFICIOS_CLAVE', CLAVE)
+    assert activar(cliente, socio).status_code == 200
