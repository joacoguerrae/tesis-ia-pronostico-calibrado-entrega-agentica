--- a/pulso/main.py
+++ b/pulso/main.py
@@ -1,11 +1,12 @@
 import os
 
 from fastapi import APIRouter, Depends, FastAPI, Header, HTTPException
-from pydantic import AwareDatetime, BaseModel, Field
+from pydantic import AwareDatetime, BaseModel, Field, field_validator
 
-from pulso import correo, db, reloj
+from pulso import beneficios, correo, db, reloj
 
 router = APIRouter()
+CREDITOS_PISO_CORPORATIVO = 12
 
 
 def socio_actual(authorization: str | None = Header(default=None)):
@@ -92,6 +93,65 @@ def yo(socio=Depends(socio_actual)):
     return {k: socio[k] for k in ('id', 'nombre', 'email', 'plan', 'creditos')}
 
 
+class NuevoConvenio(BaseModel):
+    empresa: str
+
+    @field_validator('empresa')
+    @classmethod
+    def empresa_no_vacia(cls, valor):
+        valor = valor.strip()
+        if not valor:
+            raise ValueError('Falta la empresa')
+        return valor
+
+
+@router.post('/convenio')
+def activar_convenio(datos: NuevoConvenio, socio=Depends(socio_actual)):
+    if socio['plan'] == 'corporativo':
+        raise HTTPException(409, 'Ya tenés el plan corporativo')
+    try:
+        activo = beneficios.consultar_activo(datos.empresa, socio['email'])
+    except beneficios.EmpresaInexistente:
+        raise HTTPException(404, 'No existe la empresa')
+    except beneficios.EmpleadoDesconocido:
+        raise HTTPException(409, 'No figurás como empleado de la empresa')
+    except beneficios.ServicioNoDisponible:
+        raise HTTPException(503, 'No se pudo consultar el servicio de beneficios, probá más tarde')
+    if not activo:
+        raise HTTPException(409, 'No figurás como empleado activo de la empresa')
+    if not db.activar_convenio(socio['id'], datos.empresa, CREDITOS_PISO_CORPORATIVO):
+        raise HTTPException(409, 'Ya tenés el plan corporativo')
+    correo.enviar(socio['email'], 'Ya tenés el plan corporativo',
+                  f"Hola {socio['nombre']}, activamos tu plan corporativo con {datos.empresa}.")
+    activado = db.socio(socio['id'])
+    return {'plan': activado['plan'], 'empresa': datos.empresa, 'creditos': activado['creditos']}
+
+
+@router.post('/admin/revalidar-convenios', dependencies=[Depends(admin)])
+def revalidar_convenios():
+    siguen = bajaron = sin_revisar = 0
+    for socio in db.corporativos():
+        if socio['empresa'] is None:
+            sin_revisar += 1
+            continue
+        try:
+            activo = beneficios.consultar_activo(socio['empresa'], socio['email'])
+        except (beneficios.EmpresaInexistente, beneficios.EmpleadoDesconocido):
+            activo = False
+        except beneficios.ServicioNoDisponible:
+            sin_revisar += 1
+            continue
+        if activo:
+            siguen += 1
+            continue
+        db.bajar_convenio(socio['id'])
+        correo.enviar(socio['email'], 'Se terminó tu plan corporativo',
+                      f"Hola {socio['nombre']}, tu plan corporativo con {socio['empresa']} ya no está vigente. "
+                      'Tus créditos se mantienen.')
+        bajaron += 1
+    return {'siguen': siguen, 'bajaron': bajaron, 'sin_revisar': sin_revisar}
+
+
 def crear_app():
     db.inicializar()
     app = FastAPI(title='Pulso')
