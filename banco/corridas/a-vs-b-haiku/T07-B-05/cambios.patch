+
+def test_compra_crea_pago_en_cobra_y_devuelve_url(cliente, socio, cobra):
+    r = cliente.post('/compras', json={'pack': 'pack-4'}, headers=auth(socio))
+    assert r.status_code == 201
+    assert r.json() == {'id': 1, 'pack': 'pack-4', 'creditos': 4, 'monto': 1200, 'estado': 'pendiente',
+                        'creada': '2026-11-10T15:00:00+00:00', 'url_pago': 'https://pagar.cobra.test/pag_1'}
+    [pedido] = cobra.pedidos('POST', '/pagos')
+    assert pedido['json'] == {'monto': 1200, 'moneda': 'UYU', 'referencia': 'pulso-compra-1'}
+    assert pedido['headers']['Idempotency-Key'] == 'pulso-compra-1'
+    assert pedido['headers']['X-Cobra-Clave'] == 'clave-cobra'
+    assert pedido['timeout'] == 5.0
+    assert pedido['ruta'] == '/pagos'
+
+
+def test_pack_8_cuesta_2200(cliente, socio, cobra):
+    r = cliente.post('/compras', json={'pack': 'pack-8'}, headers=auth(socio))
+    assert r.status_code == 201
+    assert (r.json()['creditos'], r.json()['monto']) == (8, 2200)
+    assert cobra.llamadas[0]['json']['monto'] == 2200
+
+
+def test_compra_no_suma_creditos_al_crearse(cliente, socio, cobra):
+    cliente.post('/compras', json={'pack': 'pack-4'}, headers=auth(socio))
+    assert cliente.get('/yo', headers=auth(socio)).json()['creditos'] == 8
+    assert db.correos() == []
+
+
+def test_pack_invalido_no_crea_nada(cliente, socio, cobra):
+    for cuerpo in ({'pack': 'pack-99'}, {}, {'pack': None}, {'pack': 4}):
+        assert cliente.post('/compras', json=cuerpo, headers=auth(socio)).status_code == 422
+    assert cobra.llamadas == []
+    assert cliente.get('/compras', headers=auth(socio)).json() == []
+
+
+def test_compra_sin_token(cliente, cobra):
+    assert cliente.post('/compras', json={'pack': 'pack-4'}).status_code == 401
+    assert cliente.post('/compras', json={'pack': 'pack-4'}, headers={'Authorization': 'Bearer nope'}).status_code == 401
+    assert cobra.llamadas == []
+
+
+def test_cobra_falla_con_500_la_compra_queda_pendiente_sin_pago(cliente, socio, cobra):
+    cobra.fallar['/pagos'] = 500
+    r = cliente.post('/compras', json={'pack': 'pack-4'}, headers=auth(socio))
+    assert r.status_code == 502
+    [compra] = cliente.get('/compras', headers=auth(socio)).json()
+    assert compra['estado'] == 'pendiente'
+    assert compra['url_pago'] is None
+
+
+def test_cobra_no_responde_da_502(cliente, socio, cobra):
+    cobra.fallar['/pagos'] = 'timeout'
+    assert cliente.post('/compras', json={'pack': 'pack-4'}, headers=auth(socio)).status_code == 502
+    cobra.fallar['/pagos'] = 'conexion'
+    assert cliente.post('/compras', json={'pack': 'pack-4'}, headers=auth(socio)).status_code == 502
+
+
+def test_cobra_con_clave_mala_da_502(cliente, socio, cobra, monkeypatch):
+    monkeypatch.setenv('PULSO_PAGOS_CLAVE', 'otra')
+    assert cliente.post('/compras', json={'pack': 'pack-4'}, headers=auth(socio)).status_code == 502
+
+
+def test_cobra_sin_configurar_da_502(cliente, socio, cobra, monkeypatch):
+    monkeypatch.delenv('PULSO_PAGOS_URL')
+    assert cliente.post('/compras', json={'pack': 'pack-4'}, headers=auth(socio)).status_code == 502
+    assert cobra.llamadas == []
+
+
+def test_listado_del_socio_mas_nueva_primero_sin_consultar_cobra(cliente, socio, cobra):
+    otro = db.crear_socio('Juan Gómez', 'juan@example.com')
+    cliente.post('/compras', json={'pack': 'pack-4'}, headers=auth(socio))
+    cliente.post('/compras', json={'pack': 'pack-8'}, headers=auth(otro))
+    reloj.fijar(AHORA + timedelta(hours=1))
+    cliente.post('/compras', json={'pack': 'pack-8'}, headers=auth(socio))
+    llamadas_antes = len(cobra.llamadas)
