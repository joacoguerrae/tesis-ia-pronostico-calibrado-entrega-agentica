+class Convenio(BaseModel):
+    empresa: str = Field(min_length=1)
+
+
+@router.post('/convenio')
+def activar_convenio(datos: Convenio, socio=Depends(socio_actual)):
+    empresa = datos.empresa.strip()
+    if not empresa:
+        raise HTTPException(422, 'Falta la empresa')
+    if socio['plan'] == 'corporativo':
+        raise HTTPException(409, 'Ya tenés el plan corporativo')
+    try:
+        estado = beneficios.consultar(empresa, socio['email'])
+    except beneficios.ServicioFalla:
+        raise HTTPException(503, 'No se pudo consultar el servicio de beneficios')
+    if estado == beneficios.EMPRESA_DESCONOCIDA:
+        raise HTTPException(404, 'No existe la empresa')
+    if estado != beneficios.ACTIVO:
+        raise HTTPException(409, 'No sos empleado activo de la empresa')
+    if not db.activar_corporativo(socio['id'], empresa):
+        raise HTTPException(409, 'Ya tenés el plan corporativo')
+    correo.enviar(socio['email'], 'Ya tenés el plan corporativo',
+                  f"Hola {socio['nombre']}, ya tenés el plan corporativo de {empresa}.")
+    return {'plan': 'corporativo', 'empresa': empresa, 'creditos': db.socio(socio['id'])['creditos']}
+
+
+@router.post('/admin/revalidar-convenios', dependencies=[Depends(admin)])
+def revalidar_convenios():
+    siguen = bajaron = sin_revisar = 0
+    for s in db.socios_corporativos():
+        if not s.get('empresa_convenio'):
+            sin_revisar += 1
+            continue
+        try:
+            estado = beneficios.consultar(s['empresa_convenio'], s['email'])
+        except beneficios.ServicioFalla:
+            sin_revisar += 1
+            continue
+        if estado == beneficios.ACTIVO:
+            siguen += 1
+        elif db.bajar_a_basico(s['id']):
+            bajaron += 1
+            correo.enviar(s['email'], 'Se terminó tu plan corporativo',
+                          f"Hola {s['nombre']}, tu plan corporativo terminó y volviste al plan básico.")
+    return {'siguen': siguen, 'bajaron': bajaron, 'sin_revisar': sin_revisar}
+
+
