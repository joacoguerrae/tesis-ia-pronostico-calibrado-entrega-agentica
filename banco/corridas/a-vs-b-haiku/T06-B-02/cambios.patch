+from datetime import timedelta
+
+import pytest
+
+from conftest import ADMIN, AHORA, auth
+from pulso import db
+
+# 10/11 a las 18:30 en Montevideo.
+INICIO = AHORA + timedelta(hours=6, minutes=30)
+ASUNTO = 'Yoga el 10/11 a las 18:30'
+
+
+def llenar(clase):
+    """Reservas confirmadas de otros socios hasta llenar la clase."""
+    reservas = []
+    for i in range(clase['cupo']):
+        otro = db.crear_socio(f'Otro {i}', f'otro{i}@example.com')
+        reservas.append(db.crear_reserva(otro['id'], clase['id'], AHORA))
+    return reservas
+
+
+def anotar(cliente, socio, clase):
+    return cliente.post(f"/clases/{clase['id']}/espera", headers=auth(socio))
+
+
+def correos_para(email):
+    return [c['asunto'] for c in db.correos() if c['para'] == email]
+
+
+# Socio: lista de espera
+
+def test_anotarse_en_clase_llena_da_posicion(cliente, socio):
+    clase = db.crear_clase('Yoga', 'Sofía', INICIO, cupo=1)
+    llenar(clase)
+    r = anotar(cliente, socio, clase)
+    assert r.status_code == 201
+    assert r.json() == {'clase_id': clase['id'], 'posicion': 1}
+
+
+def test_anotarse_no_descuenta_creditos_ni_reserva(cliente, socio):
+    clase = db.crear_clase('Yoga', 'Sofía', INICIO, cupo=1)
+    llenar(clase)
+    assert anotar(cliente, socio, clase).status_code == 201
+    assert cliente.get('/yo', headers=auth(socio)).json()['creditos'] == 8
+    assert cliente.get('/reservas', headers=auth(socio)).json() == []
+
+
+def test_espera_requiere_token(cliente):
