diff --git a/tests/test_filtros_clases.py b/tests/test_filtros_clases.py
new file mode 100644
index 0000000..cc9953c
--- /dev/null
+++ b/tests/test_filtros_clases.py
@@ -0,0 +1,125 @@
+from datetime import datetime, timedelta, timezone
+
+from conftest import AHORA, auth
+from pulso import db
+
+
+def nombres(r):
+    return [c['nombre'] for c in r.json()]
+
+
+def test_filtra_por_dia_en_hora_de_montevideo(cliente):
+    # 01:00 UTC del 11 es las 22:00 del 10 en Montevideo: día 10, queda fuera de desde=11.
+    db.crear_clase('Noche del 10', 'Leo', datetime(2026, 11, 11, 1, 0, tzinfo=timezone.utc))
+    # 02:00 UTC del 13 es las 23:00 del 12 en Montevideo: día 12, entra.
+    db.crear_clase('Noche del 12', 'Leo', datetime(2026, 11, 13, 2, 0, tzinfo=timezone.utc))
+    # 03:00 UTC del 14 es las 00:00 del 14 en Montevideo: día 14, queda fuera de hasta=13.
+    db.crear_clase('Madrugada del 14', 'Leo', datetime(2026, 11, 14, 3, 0, tzinfo=timezone.utc))
+    db.crear_clase('Sábado', 'Leo', datetime(2026, 11, 15, 15, 0, tzinfo=timezone.utc))
+
+    r = cliente.get('/clases', params={'desde': '2026-11-11', 'hasta': '2026-11-13'})
+    assert r.status_code == 200
+    assert nombres(r) == ['Noche del 12']
+    assert r.headers['X-Total'] == '1'
+
+
+def test_desde_y_hasta_son_inclusivos_y_pueden_ir_solos(cliente):
+    db.crear_clase('A', 'Leo', datetime(2026, 11, 12, 15, 0, tzinfo=timezone.utc))
+    db.crear_clase('B', 'Leo', datetime(2026, 11, 14, 15, 0, tzinfo=timezone.utc))
+    db.crear_clase('C', 'Leo', datetime(2026, 11, 16, 15, 0, tzinfo=timezone.utc))
+
+    assert nombres(cliente.get('/clases', params={'desde': '2026-11-14'})) == ['B', 'C']
+    assert nombres(cliente.get('/clases', params={'hasta': '2026-11-14'})) == ['A', 'B']
+    assert nombres(cliente.get('/clases', params={'desde': '2026-11-12', 'hasta': '2026-11-12'})) == ['A']
+
+
+def test_filtra_por_instructor_sin_distinguir_mayusculas(cliente):
+    db.crear_clase('Spinning', 'Leo Pérez', AHORA + timedelta(hours=2))
+    db.crear_clase('Yoga', 'Sofía', AHORA + timedelta(hours=3))
+    db.crear_clase('Funcional', 'Leo', AHORA + timedelta(hours=4))
+
+    assert nombres(cliente.get('/clases', params={'instructor': 'leo pérez'})) == ['Spinning']
+    assert nombres(cliente.get('/clases', params={'instructor': 'LEO'})) == ['Funcional']
+    # Exacto: no es un prefijo ni una parte del nombre.
+    assert nombres(cliente.get('/clases', params={'instructor': 'Leo P'})) == []
+
+
+def test_con_lugar_deja_solo_clases_con_lugares_libres(cliente):
+    llena = db.crear_clase('Llena', 'Leo', AHORA + timedelta(hours=2), cupo=1)
+    db.crear_reserva(db.crear_socio('Juan', 'juan@example.com')['id'], llena['id'], AHORA)
+    db.crear_clase('Libre', 'Leo', AHORA + timedelta(hours=3), cupo=1)
+
+    assert nombres(cliente.get('/clases', params={'con_lugar': 'true'})) == ['Libre']
+    assert nombres(cliente.get('/clases', params={'con_lugar': 'false'})) == ['Llena', 'Libre']
+    assert nombres(cliente.get('/clases')) == ['Llena', 'Libre']
+
+
+def test_no_lista_clases_empezadas_aunque_pidan_fecha(cliente):
+    db.crear_clase('Empezada', 'Leo', AHORA - timedelta(minutes=1))
+    db.crear_clase('Futura', 'Leo', AHORA + timedelta(minutes=1))
+    r = cliente.get('/clases', params={'desde': '2026-11-10', 'hasta': '2026-11-10'})
+    assert nombres(r) == ['Futura']
+    assert r.headers['X-Total'] == '1'
+
+
+def test_pagina_y_por_pagina_y_total(cliente):
+    for i in range(5):
+        db.crear_clase(f'Clase {i}', 'Leo', AHORA + timedelta(hours=i + 1))
+
+    r = cliente.get('/clases', params={'pagina': 2, 'por_pagina': 2})
+    assert r.status_code == 200
+    assert nombres(r) == ['Clase 2', 'Clase 3']
+    assert r.headers['X-Total'] == '5'
+
+    assert nombres(cliente.get('/clases', params={'pagina': 3, 'por_pagina': 2})) == ['Clase 4']
+    assert nombres(cliente.get('/clases', params={'pagina': 9, 'por_pagina': 2})) == []
+    assert cliente.get('/clases', params={'pagina': 9, 'por_pagina': 2}).headers['X-Total'] == '5'
+
+
+def test_por_pagina_por_defecto_es_20(cliente):
+    for i in range(25):
+        db.crear_clase(f'Clase {i:02}', 'Leo', AHORA + timedelta(hours=i + 1))
+    r = cliente.get('/clases')
+    assert len(r.json()) == 20
+    assert r.headers['X-Total'] == '25'
+
+
+def test_orden_por_inicio_y_luego_id_con_filtros(cliente):
+    tarde = db.crear_clase('Tarde', 'Leo', AHORA + timedelta(hours=5))
+    primera = db.crear_clase('Empate 1', 'Leo', AHORA + timedelta(hours=2))
+    segunda = db.crear_clase('Empate 2', 'Leo', AHORA + timedelta(hours=2))
+    r = cliente.get('/clases', params={'instructor': 'leo', 'con_lugar': 'true'})
+    assert [c['id'] for c in r.json()] == [primera['id'], segunda['id'], tarde['id']]
+
+
+def test_rangos_invalidos_dan_422(cliente):
+    assert cliente.get('/clases', params={'pagina': 0}).status_code == 422
+    assert cliente.get('/clases', params={'por_pagina': 0}).status_code == 422
+    assert cliente.get('/clases', params={'por_pagina': 51}).status_code == 422
+    assert cliente.get('/clases', params={'por_pagina': 50}).status_code == 200
+
+
+def test_fechas_invalidas_dan_422(cliente):
+    for params in (
+        {'desde': '12/11/2026'},
+        {'hasta': '2026-11-1'},
+        {'desde': '20261112'},
+        {'hasta': '2026-13-01'},
+        {'desde': '2026-11-12T10:00'},
+        {'desde': '2026-11-14', 'hasta': '2026-11-12'},
+    ):
+        assert cliente.get('/clases', params=params).status_code == 422, params
+
+
+def test_respuesta_mantiene_formato_de_clase(cliente):
+    db.crear_clase('Yoga', 'Sofía', AHORA + timedelta(hours=2))
+    [clase] = cliente.get('/clases', params={'instructor': 'sofía'}).json()
+    assert set(clase) == {'id', 'nombre', 'instructor', 'inicio', 'duracion_min', 'cupo', 'lugares_libres'}
+    assert clase['lugares_libres'] == 20
+
+
+def test_filtros_no_cambian_reservas(cliente, socio):
+    clase = db.crear_clase('Yoga', 'Sofía', AHORA + timedelta(hours=2))
+    cliente.post('/reservas', json={'clase_id': clase['id']}, headers=auth(socio))
+    r = cliente.get('/clases', params={'con_lugar': 'true'})
+    assert r.json()[0]['lugares_libres'] == 19
