+def test_pedido_rechazado_no_deja_rastro(cliente):
+    socio = db.crear_socio('Ana Pérez', 'ana@example.com', creditos=0)
+    clase = db.crear_clase('Yoga', 'Sofía', AHORA + timedelta(hours=2))
+    assert cliente.post('/reservas', json={'clase_id': clase['id']}, headers=auth(socio)).status_code == 409
+    assert db.reservas_de(socio['id']) == []
+    assert db.socio(socio['id'])['creditos'] == 0
+    assert db.correos() == []
+
+
+def test_cupo_nunca_se_excede_con_pedidos_simultaneos(cliente):
+    clase = db.crear_clase('Yoga', 'Sofía', AHORA + timedelta(hours=2), cupo=5)
+    socios = [db.crear_socio(f'Socio {i}', f'socio{i}@example.com') for i in range(20)]
+
+    resultados = _simultaneos([(s['token'], clase['id']) for s in socios])
+
+    assert [c for c, _ in resultados].count(201) == 5
+    assert all(detalle == {'detail': 'La clase no tiene lugar'} for c, detalle in resultados if c == 409)
+    assert db.confirmadas(clase['id']) == 5
+    assert len(db.correos()) == 5
+    creditos = [db.socio(s['id'])['creditos'] for s in socios]
+    assert creditos.count(7) == 5 and creditos.count(8) == 15
+
+
+def test_doble_click_confirma_una_sola_reserva(cliente, socio):
+    clase = db.crear_clase('Yoga', 'Sofía', AHORA + timedelta(hours=2))
+
+    resultados = _simultaneos([(socio['token'], clase['id'])] * 8)
+
+    assert [c for c, _ in resultados].count(201) == 1
+    assert all(detalle == {'detail': 'Ya tenés una reserva para esta clase'}
+               for c, detalle in resultados if c == 409)
+    assert db.confirmadas(clase['id']) == 1
+    assert db.socio(socio['id'])['creditos'] == 7
+    assert len(db.correos()) == 1
+
+
+def test_creditos_nunca_quedan_negativos(cliente):
+    socio = db.crear_socio('Ana Pérez', 'ana@example.com', creditos=3)
+    clases = [db.crear_clase(f'Clase {i}', 'Sofía', AHORA + timedelta(hours=i + 1)) for i in range(10)]
+
+    resultados = _simultaneos([(socio['token'], c['id']) for c in clases])
+
+    assert [c for c, _ in resultados].count(201) == 3
+    assert all(detalle == {'detail': 'No te quedan créditos'} for c, detalle in resultados if c == 409)
+    assert db.socio(socio['id'])['creditos'] == 0
+    assert len(db.reservas_de(socio['id'])) == 3
+    assert len(db.correos()) == 3
+
+
+def test_pedido_que_espera_a_la_base_recibe_201(cliente, socio):
+    clase = db.crear_clase('Yoga', 'Sofía', AHORA + timedelta(hours=2))
+    respuestas = []
+
+    def reservar():
+        respuestas.append(cliente.post('/reservas', json={'clase_id': clase['id']}, headers=auth(socio)))
+
+    # Otra conexión tiene la base tomada para escribir: el pedido tiene que esperar su turno.
+    with db.transaccion():
+        hilo = threading.Thread(target=reservar)
+        hilo.start()
+        hilo.join(timeout=1)
+        assert hilo.is_alive()
+    hilo.join(timeout=60)
+
+    assert [r.status_code for r in respuestas] == [201]
+    assert db.confirmadas(clase['id']) == 1
