{"host.arch": "amd64", "os.type": "linux", "os.version": "6.18.33.2-microsoft-standard-WSL2", "service.name": "claude-code", "service.version": "2.1.312", "wsl.version": "2", "user.id": "0f72bbf305cc3cfe4c49efd7a27949e16f5ce38c2de862b736399de5c3c79b13", "session.id": "7b876ef6-1405-4d9c-ba9e-a653b1baf0a0", "terminal.type": "wsl-Ubuntu-24.04", "gen_ai.provider.name": "anthropic", "span.type": "tool", "tool_name": "Bash", "tool_name_safe": "Bash", "gen_ai.operation.name": "execute_tool", "gen_ai.tool.name": "Bash", "gen_ai.conversation.id": "7b876ef6-1405-4d9c-ba9e-a653b1baf0a0", "full_command": "cat > /tmp/banco-T02-B-04-39e94eq1/repo/tests/test_filtros_clases.py <<'EOF'\nfrom datetime import datetime, timedelta, timezone\n\nfrom conftest import AHORA\nfrom pulso import db, reloj\n\nMVD = reloj.MONTEVIDEO\n\n\ndef nombres(r):\n    return [c['nombre'] for c in r.json()]\n\n\ndef mvd(*args):\n    return datetime(*args, tzinfo=MVD)\n\n\ndef test_filtra_por_rango_de_dias_inclusive(cliente):\n    db.crear_clase('Antes', 'Leo', mvd(2026, 11, 11, 23, 59))\n    db.crear_clase('Desde', 'Leo', mvd(2026, 11, 12, 0, 0))\n    db.crear_clase('Hasta', 'Leo', mvd(2026, 11, 14, 23, 59))\n    db.crear_clase('Despues', 'Leo', mvd(2026, 11, 15, 0, 0))\n    r = cliente.get('/clases', params={'desde': '2026-11-12', 'hasta': '2026-11-14'})\n    assert r.status_code == 200\n    assert nombres(r) == ['Desde', 'Hasta']\n    assert r.headers['X-Total'] == '2'\n\n\ndef test_dia_se_calcula_en_montevideo_y_no_en_utc(cliente):\n    # 2026-11-13 02:30 UTC es el 12/11 a las 23:30 en Montevideo.\n    db.crear_clase('Noche', 'Leo', datetime(2026, 11, 13, 2, 30, tzinfo=timezone.utc))\n    assert nombres(cliente.get('/clases', params={'desde': '2026-11-12', 'hasta': '2026-11-12'})) == ['Noche']\n    assert nombres(cliente.get('/clases', params={'desde': '2026-11-13'})) == []\n\n\ndef test_desde_y_hasta_por_separado(cliente):\n    db.crear_clase('Uno', 'Leo', mvd(2026, 11, 12, 10))\n    db.crear_clase('Dos', 'Leo', mvd(2026, 11, 20, 10))\n    assert nombres(cliente.get('/clases', params={'desde': '2026-11-15'})) == ['Dos']\n    assert nombres(cliente.get('/clases', params={'hasta': '2026-11-15'})) == ['Uno']\n\n\ndef test_filtra_por_instructor_sin_distinguir_mayusculas(cliente):\n    db.crear_clase('Spinning', 'Leo Pérez', AHORA + timedelta(hours=2))\n    db.crear_clase('Yoga', 'Sofía', AHORA + timedelta(hours=3))\n    assert nombres(cliente.get('/clases', params={'instructor': 'leo pérez'})) == ['Spinning']\n    assert nombres(cliente.get('/clases', params={'instructor': 'LEO PÉREZ'})) == ['Spinning']\n    # Nombre exacto: no hay coincidencia parcial.\n    assert nombres(cliente.get('/clases', params={'instructor': 'Leo'})) == []\n\n\ndef test_con_lugar_deja_solo_clases_con_lugares_libres(cliente):\n    llena = db.crear_clase('Llena', 'Leo', AHORA + timedelta(hours=2), cupo=1)\n    db.crear_reserva(db.crear_socio('Juan', 'juan@example.com')['id'], llena['id'], AHORA)\n    db.crear_clase('Libre', 'Leo', AHORA + timedelta(hours=3), cupo=1)\n    assert nombres(cliente.get('/clases', params={'con_lugar': 'true'})) == ['Libre']\n    assert nombres(cliente.get('/clases', params={'con_lugar': 'false'})) == ['Llena', 'Libre']\n    assert nombres(cliente.get('/clases')) == ['Llena', 'Libre']\n\n\ndef test_combina_filtros(cliente):\n    db.crear_clase('Buscada', 'Leo', mvd(2026, 11, 12, 10))\n    db.crear_clase('Otro instructor', 'Sofía', mvd(2026, 11, 12, 11))\n    db.crear_clase('Otro dia', 'Leo', mvd(2026, 11, 20, 10))\n    r = cliente.get('/clases', params={'desde': '2026-11-12', 'hasta': '2026-11-14',\n                                       'instructor': 'leo', 'con_lugar': 'true'})\n    assert nombres(r) == ['Buscada']\n    assert r.headers['X-Total'] == '1'\n\n\ndef test_no_lista_clases_empezadas_aunque_esten_en_el_rango(cliente):\n    db.crear_clase('Empezada', 'Leo', AHORA - timedelta(minutes=1))\n    r = cliente.get('/clases', params={'desde': '2026-11-10', 'hasta': '2026-11-10'})\n    assert nombres(r) == []\n    assert r.headers['X-Total'] == '0'\n\n\ndef test_pagina_y_por_pagina(cliente):\n    for i in range(5):\n        db.crear_clase(f'Clase {i}', 'Leo', AHORA + timedelta(hours=i + 1))\n    r = cliente.get('/clases', params={'pagina': 2, 'por_pagina': 2})\n    assert r.status_code == 200\n    assert nombres(r) == ['Clase 2', 'Clase 3']\n    assert r.headers['X-Total'] == '5'\n    assert nombres(cliente.get('/clases', params={'pagina': 3, 'por_pagina': 2})) == ['Clase 4']\n    ultima_pasada = cliente.get('/clases', params={'pagina': 9, 'por_pagina': 2})\n    assert ultima_pasada.status_code == 200\n    assert ultima_pasada.json() == []\n    assert ultima_pasada.headers['X-Total'] == '5'\n\n\ndef test_valores_por_defecto(cliente):\n    for i in range(25):\n        db.crear_clase(f'Clase {i:02}', 'Leo', AHORA + timedelta(hours=i + 1))\n    r = cliente.get('/clases')\n    assert len(r.json()) == 20\n    assert r.headers['X-Total'] == '25'\n    assert len(cliente.get('/clases', params={'por_pagina': 50}).json()) == 25\n\n\ndef test_orden_por_inicio_y_luego_id(cliente):\n    misma_hora = AHORA + timedelta(hours=2)\n    primera = db.crear_clase('Primera', 'Leo', misma_hora)\n    segunda = db.crear_clase('Segunda', 'Leo', misma_hora)\n    db.crear_clase('Temprana', 'Leo', AHORA + timedelta(hours=1))\n    ids = [c['id'] for c in cliente.get('/clases').json()]\n    assert ids[1:] == [primera['id'], segunda['id']]\n\n\ndef test_rangos_de_paginado_invalidos(cliente):\n    for params in ({'pagina': 0}, {'por_pagina': 0}, {'por_pagina': 51}, {'pagina': 'uno'}):\n        assert cliente.get('/clases', params=params).status_code == 422, params\n\n\ndef test_fechas_invalidas(cliente):\n    for params in ({'desde': '12/11/2026'}, {'hasta': '2026-11-1'}, {'desde': '2026-13-01'},\n                   {'desde': '2026-11-12T00:00:00'}, {'desde': '2026-11-14', 'hasta': '2026-11-12'}):\n        assert cliente.get('/clases', params=params).status_code == 422, params\nEOF\ncd /tmp/banco-T02-B-04-39e94eq1/repo && python -m pytest -q 2>&1 | tail -30", "bash_command_class": "file_read", "bash_argv0": "cat", "tool_use_id": "toolu_01W2NhHEENsTbzaSQnPB2HvC", "gen_ai.tool.call.id": "toolu_01W2NhHEENsTbzaSQnPB2HvC", "duration_ms": 9, "_nombre": "claude_code.tool", "_traza": "964291b7deb536898455e8e7f33419be", "_tramo": "58d2ea0e4d175d80", "_padre": "f62db140c84550c0", "_inicio_ns": 1794689479320000000, "_fin_ns": 1794689479329006500, "_estado": 0}
