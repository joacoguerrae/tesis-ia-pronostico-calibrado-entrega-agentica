min, cupo))\\\",\\\"a_texto(inicio), duracion_min, cupo))\\\")\\nopen(p,'w').write(s)\\nE\\ncat >> tests/test_base.py <<'E'\\n\\n\\ndef _con_clases_viejas(tmp_path, monkeypatch):\\n    import sqlite3\\n    from pulso.main import crear_app\\n    monkeypatch.setenv('PULSO_DB', str(tmp_path / 'v.db'))\\n    db.inicializar()\\n    con = sqlite3.connect(str(tmp_path / 'v.db'))\\n    for n, i in [('A', '2026-08-20T22:00:00'), ('B', '2026-10-15T22:00:00+00:00'),\\n                 ('C', '2026-11-12T19:00:00-03:00')]:\\n        con.execute(\\\"INSERT INTO clases (nombre, instructor, inicio, duracion_min, cupo) VALUES (?, 'x', ?, 60, 5)\\\", (n, i))\\n    con.commit()\\n    con.close()\\n    return crear_app\\n\\n\\ndef test_migracion_normaliza_e_idempotente(tmp_path, monkeypatch):\\n    crear_app = _con_clases_viejas(tmp_path, monkeypatch)\\n    crear_app()\\n    crear_app()\\n    assert [c['inicio'] for c in db.clases()] == ['2026-08-20T22:00:00+00:00', '2026-10-15T22:00:00+00:00',\\n                                                  '2026-11-12T22:00:00+00:00']\\n\\n\\ndef test_admin_acepta_desfase_y_guarda_utc(cliente):\\n    datos = {'nombre': 'Funcional', 'instructor': 'Leo', 'inicio': '2026-11-12T19:00:00-03:00', 'duracion_min': 45, 'cupo': 10}\\n    r = cliente.post('/admin/clases', json=datos, headers=ADMIN)\\n    assert r.json()['inicio'] == '2026-11-12T22:00:00+00:00'\\n    assert db.clase(r.json()['id'])['inicio'] == '2026-11-12T22:00:00+00:00'\\n\\n\\ndef test_reservar_correo_hora_montevideo(cliente, socio):\\n    c = db.crear_clase('Funcional', 'Leo', datetime(2026, 11, 12, 19, tzinfo=reloj.MONTEVIDEO))\\n    assert cliente.post('/reservas', json={'clase_id': c['id']}, headers=auth(socio)).status_code == 201\\n    assert '12/11 a las 19:00' in db.correos()[0]['asunto']\\nE\\nsed -i 's/^from datetime import timedelta/from datetime import datetime, timedelta/;s/^from pulso import db$/from pulso import db, reloj/' tests/test_base.py\\npython -m pytest -q 2>&1 | tail -8\"}", "permission_mode": "dontAsk", "request_id": "req_011Ch3doZg5ArHai9StkCjX5", "_cuerpo": "claude_code.tool_decision", "_tiempo_ns": 1794696499569000000}
