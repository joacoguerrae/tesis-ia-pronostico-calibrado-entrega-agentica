+def test_puede_activar_de_nuevo_despues_de_bajar_a_basico(cliente, socio, servicio):
+    empleados(servicio, {('acme', 'ana@example.com'): ACTIVO})
+    assert cliente.post('/convenio', json={'empresa': 'acme'}, headers=auth(socio)).status_code == 200
+    empleados(servicio, {('acme', 'ana@example.com'): INACTIVO})
+    assert cliente.post('/admin/revalidar-convenios', headers=ADMIN).json()['bajaron'] == 1
+    empleados(servicio, {('acme', 'ana@example.com'): ACTIVO})
+    r = cliente.post('/convenio', json={'empresa': 'acme'}, headers=auth(socio))
+    assert r.json() == {'plan': 'corporativo', 'empresa': 'acme', 'creditos': 12}
+    assert asuntos() == ['Ya tenés el plan corporativo', 'Se terminó tu plan corporativo',
+                         'Ya tenés el plan corporativo']
