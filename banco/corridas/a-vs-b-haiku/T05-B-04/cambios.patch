diff --git a/pulso/db.py b/pulso/db.py
index 59841ac..0f3971a 100644
--- a/pulso/db.py
+++ b/pulso/db.py
@@ -36,6 +36,10 @@ CREATE TABLE IF NOT EXISTS correos (
     cuerpo TEXT NOT NULL,
     creado TEXT NOT NULL
 );
+CREATE TABLE IF NOT EXISTS recordatorios (
+    reserva_id INTEGER PRIMARY KEY REFERENCES reservas(id),
+    enviado TEXT NOT NULL
+);
 """
 
 
@@ -134,5 +138,23 @@ def sumar_creditos(socio_id, cantidad):
         con.execute('UPDATE socios SET creditos = creditos + ? WHERE id = ?', (cantidad, socio_id))
 
 
+def reservas_a_recordar(desde, hasta):
+    """Reservas confirmadas sin recordatorio cuya clase empieza en (desde, hasta]."""
+    filas = _varias('SELECT r.id AS reserva_id, c.nombre AS clase, c.instructor, c.inicio, '
+                    's.nombre AS socio, s.email FROM reservas r '
+                    'JOIN clases c ON c.id = r.clase_id JOIN socios s ON s.id = r.socio_id '
+                    'LEFT JOIN recordatorios rec ON rec.reserva_id = r.id '
+                    "WHERE r.estado = 'confirmada' AND rec.reserva_id IS NULL ORDER BY c.inicio, r.id")
+    return [f for f in filas if desde < a_fecha(f['inicio']) <= hasta]
+
+
+def marcar_recordatorio(reserva_id, enviado):
+    """Registra que la reserva ya tiene recordatorio. Devuelve False si ya lo tenía."""
+    with conexion() as con:
+        cur = con.execute('INSERT OR IGNORE INTO recordatorios (reserva_id, enviado) VALUES (?, ?)',
+                          (reserva_id, a_texto(enviado)))
+    return cur.rowcount == 1
+
+
 def correos():
     return _varias('SELECT * FROM correos ORDER BY id')
diff --git a/pulso/main.py b/pulso/main.py
index 039212d..63065f1 100644
--- a/pulso/main.py
+++ b/pulso/main.py
@@ -1,4 +1,5 @@
 import os
+from datetime import timedelta
 
 from fastapi import APIRouter, Depends, FastAPI, Header, HTTPException
 from pydantic import AwareDatetime, BaseModel, Field
@@ -82,6 +83,22 @@ def reservar(datos: NuevaReserva, socio=Depends(socio_actual)):
     return ver_reserva(reserva)
 
 
+@router.post('/admin/recordatorios', dependencies=[Depends(admin)])
+def enviar_recordatorios():
+    ahora = reloj.ahora()
+    enviados = 0
+    for r in db.reservas_a_recordar(ahora, ahora + timedelta(hours=24)):
+        # Se marca antes de mandar: así una reserva nunca recibe dos recordatorios aunque las llamadas se pisen.
+        if not db.marcar_recordatorio(r['reserva_id'], ahora):
+            continue
+        inicio = db.a_fecha(r['inicio'])
+        correo.enviar(r['email'], f"Recordatorio: {r['clase']} el {correo.fecha_y_hora(inicio)}",
+                      f"Hola {r['socio']}, te recordamos tu clase de {r['clase']} con {r['instructor']} "
+                      f"el {correo.fecha_y_hora(inicio)}. ¡Te esperamos!")
+        enviados += 1
+    return {'enviados': enviados}
+
+
 @router.get('/reservas')
 def mis_reservas(socio=Depends(socio_actual)):
     return [ver_reserva(r) for r in db.reservas_de(socio['id'])]
