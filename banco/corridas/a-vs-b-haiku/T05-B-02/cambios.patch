diff --git a/pulso/db.py b/pulso/db.py
index 59841ac..f26fb5d 100644
--- a/pulso/db.py
+++ b/pulso/db.py
@@ -36,6 +36,10 @@ CREATE TABLE IF NOT EXISTS correos (
     cuerpo TEXT NOT NULL,
     creado TEXT NOT NULL
 );
+CREATE TABLE IF NOT EXISTS recordatorios (
+    reserva_id INTEGER PRIMARY KEY REFERENCES reservas(id),
+    enviado TEXT NOT NULL
+);
 """
 
 
@@ -129,6 +133,23 @@ def reservas_de(socio_id):
                    'WHERE r.socio_id = ? ORDER BY c.inicio, r.id', (socio_id,))
 
 
+def reservas_con_clase_entre(desde, hasta):
+    """Reservas confirmadas cuya clase empieza en (desde, hasta], sin recordatorio ya enviado."""
+    filas = _varias("SELECT r.id AS reserva_id, r.socio_id, c.* FROM reservas r JOIN clases c ON c.id = r.clase_id "
+                    "WHERE r.estado = 'confirmada' "
+                    "AND NOT EXISTS (SELECT 1 FROM recordatorios rec WHERE rec.reserva_id = r.id) "
+                    "ORDER BY c.inicio, r.id")
+    return [f for f in filas if desde < a_fecha(f['inicio']) <= hasta]
+
+
+def reclamar_recordatorio(reserva_id, enviado):
+    """Marca la reserva como recordada. Devuelve False si ya estaba marcada."""
+    with conexion() as con:
+        cur = con.execute('INSERT OR IGNORE INTO recordatorios (reserva_id, enviado) VALUES (?, ?)',
+                          (reserva_id, a_texto(enviado)))
+    return cur.rowcount == 1
+
+
 def sumar_creditos(socio_id, cantidad):
     with conexion() as con:
         con.execute('UPDATE socios SET creditos = creditos + ? WHERE id = ?', (cantidad, socio_id))
diff --git a/pulso/main.py b/pulso/main.py
index 039212d..61875bc 100644
--- a/pulso/main.py
+++ b/pulso/main.py
@@ -1,4 +1,5 @@
 import os
+from datetime import timedelta
 
 from fastapi import APIRouter, Depends, FastAPI, Header, HTTPException
 from pydantic import AwareDatetime, BaseModel, Field
@@ -82,6 +83,23 @@ def reservar(datos: NuevaReserva, socio=Depends(socio_actual)):
     return ver_reserva(reserva)
 
 
+@router.post('/admin/recordatorios', dependencies=[Depends(admin)])
+def enviar_recordatorios():
+    ahora = reloj.ahora()
+    enviados = 0
+    for r in db.reservas_con_clase_entre(ahora, ahora + timedelta(hours=24)):
+        # Se reclama antes de mandar: si dos llamadas corren a la vez, solo una manda el correo.
+        if not db.reclamar_recordatorio(r['reserva_id'], ahora):
+            continue
+        socio = db.socio(r['socio_id'])
+        inicio = db.a_fecha(r['inicio'])
+        correo.enviar(socio['email'], f"Recordatorio: {r['nombre']} el {correo.fecha_y_hora(inicio)}",
+                      f"Hola {socio['nombre']}, te recordamos tu reserva en {r['nombre']} con {r['instructor']}, "
+                      f"el {correo.fecha_y_hora(inicio)}. ¡Te esperamos!")
+        enviados += 1
+    return {'enviados': enviados}
+
+
 @router.get('/reservas')
 def mis_reservas(socio=Depends(socio_actual)):
     return [ver_reserva(r) for r in db.reservas_de(socio['id'])]
