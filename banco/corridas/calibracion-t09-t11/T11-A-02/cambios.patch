+def aplicar_cambio_serie(serie_id, cambios, clases_cambios):
+    """Actualiza la serie (cambios: campo -> valor) y las clases (id -> dict campo -> valor), en una transacción."""
+    campos = {'hora', 'instructor', 'cupo', 'inicio'}
+    with conexion() as con:
+        for campo, valor in cambios.items():
+            assert campo in campos
+            con.execute(f'UPDATE series SET {campo} = ? WHERE id = ?', (valor, serie_id))
+        for clase_id, valores in clases_cambios.items():
+            for campo, valor in valores.items():
+                assert campo in campos
+                con.execute(f'UPDATE clases SET {campo} = ? WHERE id = ?', (valor, clase_id))
+
+
+def cancelar_clase(clase_id):
+    """Cancela la clase y sus reservas confirmadas, devolviendo los créditos. Devuelve los socios afectados."""
+    with conexion() as con:
+        filas = con.execute("SELECT r.id AS rid, s.* FROM reservas r JOIN socios s ON s.id = r.socio_id "
+                            "WHERE r.clase_id = ? AND r.estado = 'confirmada' ORDER BY r.id", (clase_id,)).fetchall()
+        con.execute("UPDATE clases SET estado = 'cancelada' WHERE id = ?", (clase_id,))
+        for f in filas:
+            con.execute("UPDATE reservas SET estado = 'cancelada' WHERE id = ?", (f['rid'],))
+            con.execute('UPDATE socios SET creditos = creditos + 1 WHERE id = ?', (f['id'],))
+    return [dict(f) for f in filas]
+
