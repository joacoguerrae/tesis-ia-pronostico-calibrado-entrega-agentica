-from pydantic import AwareDatetime, BaseModel, Field
+from pydantic import AwareDatetime, BaseModel, Field, StringConstraints
 
 from pulso import correo, db, reloj
 
 router = APIRouter()
 
+# Cliente del servicio de beneficios (fuente de verdad de los empleados de cada empresa).
+# La URL y la clave se leen del entorno en cada consulta.
+BENEFICIOS_TIMEOUT_S = 3.0
+EMPLEADO_ACTIVO = 'activo'
+EMPLEADO_INACTIVO = 'inactivo'
+EMPLEADO_DESCONOCIDO = 'empleado_desconocido'
+EMPRESA_DESCONOCIDA = 'empresa_desconocida'
+
+
+class ServicioBeneficiosNoDisponible(Exception):
+    pass
+
+
+def consultar_empleado(empresa, email):
+    """Devuelve EMPLEADO_ACTIVO, EMPLEADO_INACTIVO, EMPLEADO_DESCONOCIDO o EMPRESA_DESCONOCIDA.
+    Cualquier respuesta fuera del contrato (o ninguna respuesta) levanta ServicioBeneficiosNoDisponible."""
+    base = os.environ.get('PULSO_BENEFICIOS_URL', '')
+    clave = os.environ.get('PULSO_BENEFICIOS_CLAVE', '')
+    # El email va en minúsculas y codificado entero: el servicio decodifica el path como formulario.
+    url = f"{base}/empresas/{quote(empresa, safe='')}/empleados/{quote(email.lower(), safe='')}"
+    try:
+        respuesta = httpx.get(url, headers={'X-Api-Key': clave}, timeout=BENEFICIOS_TIMEOUT_S)
+        datos = respuesta.json()
+    except (httpx.HTTPError, httpx.InvalidURL, ValueError) as error:
+        raise ServicioBeneficiosNoDisponible(str(error)) from error
+    if not isinstance(datos, dict):
+        raise ServicioBeneficiosNoDisponible('respuesta fuera de contrato')
+    if respuesta.status_code == 200 and isinstance(datos.get('activo'), bool):
+        return EMPLEADO_ACTIVO if datos['activo'] else EMPLEADO_INACTIVO
+    if respuesta.status_code == 404 and datos.get('error') in (EMPLEADO_DESCONOCIDO, EMPRESA_DESCONOCIDA):
+        return datos['error']
+    raise ServicioBeneficiosNoDisponible(f'respuesta fuera de contrato: {respuesta.status_code}')
+
 
 def socio_actual(authorization: str | None = Header(default=None)):
     if not authorization or not authorization.startswith('Bearer '):
@@ -92,6 +128,51 @@ def yo(socio=Depends(socio_actual)):
     return {k: socio[k] for k in ('id', 'nombre', 'email', 'plan', 'creditos')}
 
 
+class NuevoConvenio(BaseModel):
+    empresa: Annotated[str, StringConstraints(strip_whitespace=True, min_length=1)]
+
+
+@router.post('/convenio')
+def activar_convenio(datos: NuevoConvenio, socio=Depends(socio_actual)):
+    if socio['plan'] == 'corporativo':
+        raise HTTPException(409, 'Ya tenés el plan corporativo')
+    try:
+        estado = consultar_empleado(datos.empresa, socio['email'])
+    except ServicioBeneficiosNoDisponible:
+        raise HTTPException(503, 'No pudimos verificar el convenio, probá más tarde')
+    if estado == EMPRESA_DESCONOCIDA:
+        raise HTTPException(404, 'No existe la empresa')
+    if estado != EMPLEADO_ACTIVO:
+        raise HTTPException(409, 'No figurás como empleado activo de la empresa')
+    if not db.activar_convenio(socio['id'], datos.empresa):
+        raise HTTPException(409, 'Ya tenés el plan corporativo')
+    correo.enviar(socio['email'], 'Ya tenés el plan corporativo',
+                  f"Hola {socio['nombre']}, activamos tu plan corporativo por tu convenio con {datos.empresa}.")
+    return {'plan': 'corporativo', 'empresa': datos.empresa, 'creditos': db.socio(socio['id'])['creditos']}
+
+
+@router.post('/admin/revalidar-convenios', dependencies=[Depends(admin)])
+def revalidar_convenios():
+    siguen = bajaron = sin_revisar = 0
+    for socio in db.socios_corporativos():
+        if not socio['empresa']:
+            sin_revisar += 1
+            continue
+        try:
+            estado = consultar_empleado(socio['empresa'], socio['email'])
+        except ServicioBeneficiosNoDisponible:
+            sin_revisar += 1
+            continue
+        if estado == EMPLEADO_ACTIVO:
+            siguen += 1
+        elif db.bajar_convenio(socio['id']):
+            bajaron += 1
+            correo.enviar(socio['email'], 'Se terminó tu plan corporativo',
+                          f"Hola {socio['nombre']}, ya no figurás como empleado activo de {socio['empresa']}, "
+                          'así que volviste al plan básico. Tus créditos se mantienen.')
+    return {'siguen': siguen, 'bajaron': bajaron, 'sin_revisar': sin_revisar}
+
+
 def crear_app():
     db.inicializar()
     app = FastAPI(title='Pulso')
