{"host.arch": "amd64", "os.type": "linux", "os.version": "6.18.33.2-microsoft-standard-WSL2", "service.name": "claude-code", "service.version": "2.1.312", "wsl.version": "2", "user.id": "0f72bbf305cc3cfe4c49efd7a27949e16f5ce38c2de862b736399de5c3c79b13", "session.id": "a3cd5e85-08ff-462e-8d6c-ada100c4d723", "terminal.type": "wsl-Ubuntu-24.04", "gen_ai.provider.name": "anthropic", "span.type": "tool", "tool_name": "Bash", "tool_name_safe": "Bash", "gen_ai.operation.name": "execute_tool", "gen_ai.tool.name": "Bash", "gen_ai.conversation.id": "a3cd5e85-08ff-462e-8d6c-ada100c4d723", "full_command": "cat >> pulso/db.py <<'EOF'\n\n\nclass ReservaRechazada(Exception):\n    def __init__(self, detalle):\n        super().__init__(detalle)\n        self.detalle = detalle\n\n\ndef reservar(socio_id, clase_id, creada, redactar_correo):\n    \"\"\"Reserva de forma atómica: valida, crea la reserva, descuenta el crédito y deja el correo.\n\n    BEGIN IMMEDIATE toma el lock de escritura antes de leer, así que entre procesos\n    y threads las validaciones y las escrituras se serializan. Si la base está ocupada\n    espera (timeout). `redactar_correo(socio, clase)` devuelve (para, asunto, cuerpo).\n    \"\"\"\n    con = sqlite3.connect(ruta(), timeout=60, isolation_level=None)\n    con.row_factory = sqlite3.Row\n    try:\n        con.execute('BEGIN IMMEDIATE')\n        try:\n            s = con.execute('SELECT * FROM socios WHERE id = ?', (socio_id,)).fetchone()\n            c = con.execute('SELECT * FROM clases WHERE id = ?', (clase_id,)).fetchone()\n            if con.execute(\"SELECT 1 FROM reservas WHERE socio_id = ? AND clase_id = ? AND estado = 'confirmada'\",\n                           (socio_id, clase_id)).fetchone():\n                raise ReservaRechazada('Ya tenés una reserva para esta clase')\n            n = con.execute(\"SELECT COUNT(*) FROM reservas WHERE clase_id = ? AND estado = 'confirmada'\",\n                            (clase_id,)).fetchone()[0]\n            if n >= c['cupo']:\n                raise ReservaRechazada('La clase no tiene lugar')\n            if s['creditos'] < 1:\n                raise ReservaRechazada('No te quedan créditos')\n            cur = con.execute(\"INSERT INTO reservas (socio_id, clase_id, estado, creada) VALUES (?, ?, 'confirmada', ?)\",\n                              (socio_id, clase_id, a_texto(creada)))\n            con.execute('UPDATE socios SET creditos = creditos - 1 WHERE id = ?', (socio_id,))\n            para, asunto, cuerpo = redactar_correo(dict(s), dict(c))\n            con.execute('INSERT INTO correos (para, asunto, cuerpo, creado) VALUES (?, ?, ?, ?)',\n                        (para, asunto, cuerpo, a_texto(creada)))\n            fila = con.execute('SELECT * FROM reservas WHERE id = ?', (cur.lastrowid,)).fetchone()\n            con.execute('COMMIT')\n            return dict(fila)\n        except BaseException:\n            con.execute('ROLLBACK')\n            raise\n    finally:\n        con.close()\nEOF\npython - <<'EOF'\nimport re\np='pulso/db.py'\ns=open(p).read()\ns=s.replace(\"sqlite3.connect(ruta())\\n    con.row_factory = sqlite3.Row\\n    con.execute('PRAGMA foreign_keys\",\"sqlite3.connect(ruta(), timeout=60)\\n    con.row_factory = sqlite3.Row\\n    con.execute('PRAGMA foreign_keys\",1)\nopen(p,'w').write(s)\nEOF", "bash_command_class": "file_read", "bash_argv0": "cat", "tool_use_id": "toolu_01CZmNoSmQRSAtrYYNbQaozm", "gen_ai.tool.call.id": "toolu_01CZmNoSmQRSAtrYYNbQaozm", "duration_ms": 9, "_nombre": "claude_code.tool", "_traza": "eca7b5a4fafabb6a443ebbed3f4c3354", "_tramo": "9193682388c705af", "_padre": "3cd43ff346b1972a", "_inicio_ns": 1794696728066000000, "_fin_ns": 1794696728075064808, "_estado": 0}
