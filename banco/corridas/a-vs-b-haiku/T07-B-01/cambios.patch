+def compras_de(socio_id):
+    return _varias('SELECT * FROM compras WHERE socio_id = ? ORDER BY creada DESC, id DESC', (socio_id,))
+
+
+def compras_pendientes():
+    return _varias("SELECT * FROM compras WHERE estado = 'pendiente' ORDER BY id")
+
+
+def guardar_pago(compra_id, pago_id, url_pago):
+    """Guarda el pago de una compra que todavía no tenía uno. Nunca reemplaza un pago ya guardado."""
+    ejecutar('UPDATE compras SET pago_id = ?, url_pago = ? WHERE id = ? AND pago_id IS NULL',
+             (pago_id, url_pago, compra_id))
+
+
+def cambiar_estado_compra(compra_id, estado, desde='pendiente', con=None):
+    """Cambia el estado solo si la compra todavía está en `desde`. Devuelve True si la compra cambió."""
+    cur = ejecutar('UPDATE compras SET estado = ? WHERE id = ? AND estado = ?', (estado, compra_id, desde), con)
+    return cur.rowcount == 1
