+# Funciones para usar dentro de `transaccion()`: reciben la conexión.
+
+def _una_en(con, sql, parametros=()):
+    fila = con.execute(sql, parametros).fetchone()
+    return dict(fila) if fila else None
+
+
+def clase_en(con, clase_id):
+    return _una_en(con, 'SELECT * FROM clases WHERE id = ?', (clase_id,))
+
+
+def socio_en(con, socio_id):
+    return _una_en(con, 'SELECT * FROM socios WHERE id = ?', (socio_id,))
+
+
+def reserva_en(con, reserva_id):
+    return _una_en(con, 'SELECT * FROM reservas WHERE id = ?', (reserva_id,))
+
+
+def confirmadas_en(con, clase_id):
+    return _una_en(con, "SELECT COUNT(*) AS n FROM reservas WHERE clase_id = ? AND estado = 'confirmada'",
+                   (clase_id,))['n']
+
+
+def tiene_confirmada_en(con, socio_id, clase_id):
+    return _una_en(con, "SELECT 1 AS x FROM reservas WHERE socio_id = ? AND clase_id = ? AND estado = 'confirmada'",
+                   (socio_id, clase_id)) is not None
+
+
+def insertar_reserva_en(con, socio_id, clase_id, creada):
+    cur = con.execute("INSERT INTO reservas (socio_id, clase_id, estado, creada) VALUES (?, ?, 'confirmada', ?)",
+                      (socio_id, clase_id, a_texto(creada)))
+    return reserva_en(con, cur.lastrowid)
+
+
+def cambiar_estado_reserva_en(con, reserva_id, estado):
+    con.execute('UPDATE reservas SET estado = ? WHERE id = ?', (estado, reserva_id))
+
+
+def sumar_creditos_en(con, socio_id, cantidad):
+    con.execute('UPDATE socios SET creditos = creditos + ? WHERE id = ?', (cantidad, socio_id))
+
+
+def cambiar_cupo_en(con, clase_id, cupo):
+    con.execute('UPDATE clases SET cupo = ? WHERE id = ?', (cupo, clase_id))
+
+
+def espera_de_en(con, socio_id, clase_id):
+    return _una_en(con, 'SELECT * FROM espera WHERE socio_id = ? AND clase_id = ?', (socio_id, clase_id))
+
+
+def anotar_en_espera_en(con, socio_id, clase_id, creada):
+    cur = con.execute('INSERT INTO espera (socio_id, clase_id, creada) VALUES (?, ?, ?)',
+                      (socio_id, clase_id, a_texto(creada)))
+    return _una_en(con, 'SELECT * FROM espera WHERE id = ?', (cur.lastrowid,))
+
+
+def primero_en_espera_en(con, clase_id):
+    return _una_en(con, 'SELECT * FROM espera WHERE clase_id = ? ORDER BY id LIMIT 1', (clase_id,))
+
+
+def posicion_en_espera_en(con, espera):
+    """Lugar de la persona en la lista, contando solo a los que siguen anotados."""
+    return _una_en(con, 'SELECT COUNT(*) AS n FROM espera WHERE clase_id = ? AND id <= ?',
+                   (espera['clase_id'], espera['id']))['n']
+
+
+def quitar_de_espera_en(con, espera_id):
+    con.execute('DELETE FROM espera WHERE id = ?', (espera_id,))
