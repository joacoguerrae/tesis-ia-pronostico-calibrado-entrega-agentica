+from pulso import beneficios, correo, db, reloj
 
 router = APIRouter()
 
@@ -92,6 +92,61 @@ def yo(socio=Depends(socio_actual)):
     return {k: socio[k] for k in ('id', 'nombre', 'email', 'plan', 'creditos')}
 
 
+class NuevoConvenio(BaseModel):
+    empresa: str = Field(min_length=1)
+
+    @field_validator('empresa')
+    @classmethod
+    def sin_espacios(cls, valor):
+        valor = valor.strip()
+        if not valor:
+            raise ValueError('La empresa no puede estar vacía')
+        return valor
+
+
+@router.post('/convenio')
+def activar_convenio(datos: NuevoConvenio, socio=Depends(socio_actual)):
+    if socio['plan'] == 'corporativo':
+        raise HTTPException(409, 'Ya tenés el plan corporativo')
+    try:
+        estado = beneficios.consultar(datos.empresa, socio['email'])
+    except beneficios.ServicioNoDisponible:
+        raise HTTPException(503, 'El servicio de beneficios no está disponible, probá más tarde')
+    if estado == beneficios.EMPRESA_DESCONOCIDA:
+        raise HTTPException(404, 'No existe la empresa')
+    if estado != beneficios.ACTIVO:
+        raise HTTPException(409, 'No figurás como empleado activo de esa empresa')
+    if not db.activar_corporativo(socio['id'], datos.empresa):
+        raise HTTPException(409, 'Ya tenés el plan corporativo')
+    correo.enviar(socio['email'], 'Ya tenés el plan corporativo',
+                  f"Hola {socio['nombre']}, activamos tu plan corporativo por convenio con {datos.empresa}.")
+    activado = db.socio(socio['id'])
+    return {'plan': 'corporativo', 'empresa': datos.empresa, 'creditos': activado['creditos']}
+
+
+@router.post('/admin/revalidar-convenios', dependencies=[Depends(admin)])
+def revalidar_convenios():
+    siguen = bajaron = sin_revisar = 0
+    for socio in db.socios_corporativos():
+        if not socio['convenio']:
+            # Sin empresa registrada no hay contra qué consultar: no se toca.
+            sin_revisar += 1
+            continue
+        try:
+            estado = beneficios.consultar(socio['convenio'], socio['email'])
+        except beneficios.ServicioNoDisponible:
+            sin_revisar += 1
+            continue
+        if estado == beneficios.ACTIVO:
+            siguen += 1
+        elif db.bajar_a_basico(socio['id']):
+            correo.enviar(socio['email'], 'Se terminó tu plan corporativo',
+                          f"Hola {socio['nombre']}, tu plan corporativo por convenio con {socio['convenio']} "
+                          'ya no está vigente. Tus créditos siguen disponibles.')
+            bajaron += 1
+    return {'siguen': siguen, 'bajaron': bajaron, 'sin_revisar': sin_revisar}
+
+
 def crear_app():
     db.inicializar()
     app = FastAPI(title='Pulso')
