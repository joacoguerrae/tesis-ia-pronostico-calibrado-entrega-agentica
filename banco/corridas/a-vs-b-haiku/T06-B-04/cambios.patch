+
+
+def sumar_creditos_en(con, socio_id, cantidad):
+    con.execute('UPDATE socios SET creditos = creditos + ? WHERE id = ?', (cantidad, socio_id))
+
+
+def anotar_en_espera(con, socio_id, clase_id, creada):
+    con.execute('INSERT INTO espera (socio_id, clase_id, creada) VALUES (?, ?, ?)',
+                (socio_id, clase_id, a_texto(creada)))
+
+
+def en_espera_de(con, clase_id, socio_id):
+    return _una_en(con, 'SELECT * FROM espera WHERE clase_id = ? AND socio_id = ?', (clase_id, socio_id))
+
+
+def posicion_en_espera(con, clase_id, socio_id):
+    """Posición del socio en la lista (1 = primero), o None si no está anotado.
+    Como los ids crecen con cada anotación, el orden por id es el orden de llegada."""
+    fila = en_espera_de(con, clase_id, socio_id)
+    if fila is None:
+        return None
+    return _una_en(con, 'SELECT COUNT(*) AS n FROM espera WHERE clase_id = ? AND id <= ?',
+                   (clase_id, fila['id']))['n']
+
+
+def primero_en_espera(con, clase_id):
+    return _una_en(con, 'SELECT * FROM espera WHERE clase_id = ? ORDER BY id LIMIT 1', (clase_id,))
+
+
+def quitar_de_espera(con, espera_id):
+    con.execute('DELETE FROM espera WHERE id = ?', (espera_id,))
