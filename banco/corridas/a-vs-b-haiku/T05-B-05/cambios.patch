index 59841ac..7c0f9df 100644
--- a/pulso/db.py
+++ b/pulso/db.py
@@ -36,6 +36,10 @@ CREATE TABLE IF NOT EXISTS correos (
     cuerpo TEXT NOT NULL,
     creado TEXT NOT NULL
 );
+CREATE TABLE IF NOT EXISTS recordatorios (
+    reserva_id INTEGER PRIMARY KEY REFERENCES reservas(id),
+    enviado TEXT NOT NULL
+);
 """
 
 
@@ -129,6 +133,24 @@ def reservas_de(socio_id):
                    'WHERE r.socio_id = ? ORDER BY c.inicio, r.id', (socio_id,))
 
 
+def reservas_por_recordar(desde, hasta):
+    """Reservas confirmadas sin recordatorio cuya clase empieza en (desde, hasta]."""
+    filas = _varias('SELECT r.id AS reserva_id, s.nombre AS socio, s.email, c.nombre AS clase, '
+                    'c.instructor, c.inicio '
+                    'FROM reservas r JOIN socios s ON s.id = r.socio_id JOIN clases c ON c.id = r.clase_id '
+                    'LEFT JOIN recordatorios rec ON rec.reserva_id = r.id '
+                    "WHERE r.estado = 'confirmada' AND rec.reserva_id IS NULL ORDER BY c.inicio, r.id")
+    return [f for f in filas if desde < a_fecha(f['inicio']) <= hasta]
+
+
+def reclamar_recordatorio(reserva_id, momento):
+    """Marca la reserva como recordada. Devuelve False si ya estaba marcada (llamadas concurrentes)."""
+    with conexion() as con:
+        cur = con.execute('INSERT OR IGNORE INTO recordatorios (reserva_id, enviado) VALUES (?, ?)',
+                          (reserva_id, a_texto(momento)))
+    return cur.rowcount == 1
+
+
 def sumar_creditos(socio_id, cantidad):
     with conexion() as con:
         con.execute('UPDATE socios SET creditos = creditos + ? WHERE id = ?', (cantidad, socio_id))
