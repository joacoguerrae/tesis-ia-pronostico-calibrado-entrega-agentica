+    """Mismo día (en Montevideo) que `inicio`, a la hora `hora`."""
+    dia_local = inicio.astimezone(reloj.MONTEVIDEO).date()
+    return datetime.combine(dia_local, hora_de(hora), tzinfo=reloj.MONTEVIDEO)
