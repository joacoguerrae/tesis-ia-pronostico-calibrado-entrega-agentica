diff --git a/tests/test_recordatorios.py b/tests/test_recordatorios.py
new file mode 100644
index 0000000..d5d13ba
--- /dev/null
+++ b/tests/test_recordatorios.py
@@ -0,0 +1,68 @@
+from datetime import timedelta
+
+from conftest import ADMIN, AHORA, auth
+from pulso import db, reloj
+
+
+def llamar(cliente):
+    return cliente.post('/admin/recordatorios', headers=ADMIN)
+
+
+def test_requiere_clave_de_administracion(cliente):
+    assert cliente.post('/admin/recordatorios').status_code == 401
+    assert cliente.post('/admin/recordatorios', headers={'X-Admin-Key': 'otra'}).status_code == 401
+
+
+def test_manda_recordatorio_a_reserva_dentro_de_24_horas(cliente, socio):
+    clase = db.crear_clase('Yoga', 'Sofía', AHORA + timedelta(hours=23, minutes=30))
+    db.crear_reserva(socio['id'], clase['id'], AHORA)
+    r = llamar(cliente)
+    assert r.status_code == 200
+    assert r.json() == {'enviados': 1}
+    [correo] = db.correos()
+    assert correo['para'] == 'ana@example.com'
+    assert correo['asunto'] == 'Recordatorio: Yoga el 11/11 a las 11:30'
+    assert 'Sofía' in correo['cuerpo']
+
+
+def test_ventana_es_despues_de_ahora_y_hasta_24_horas_inclusive(cliente, socio):
+    for nombre, inicio in [('Justo ahora', AHORA), ('Pasada', AHORA - timedelta(hours=1)),
+                           ('Exacta', AHORA + timedelta(hours=24)),
+                           ('Lejana', AHORA + timedelta(hours=24, seconds=1))]:
+        clase = db.crear_clase(nombre, 'Leo', inicio)
+        db.crear_reserva(socio['id'], clase['id'], AHORA)
+    r = llamar(cliente)
+    assert r.json() == {'enviados': 1}
+    [correo] = db.correos()
+    assert correo['asunto'].startswith('Recordatorio: Exacta el ')
+
+
+def test_no_manda_a_reservas_canceladas(cliente, socio):
+    clase = db.crear_clase('Yoga', 'Sofía', AHORA + timedelta(hours=3))
+    db.crear_reserva(socio['id'], clase['id'], AHORA, estado='cancelada')
+    assert llamar(cliente).json() == {'enviados': 0}
+    assert db.correos() == []
+
+
+def test_cada_reserva_recibe_un_solo_recordatorio(cliente, socio):
+    clase = db.crear_clase('Yoga', 'Sofía', AHORA + timedelta(hours=3))
+    db.crear_reserva(socio['id'], clase['id'], AHORA)
+    assert llamar(cliente).json() == {'enviados': 1}
+    reloj.fijar(AHORA + timedelta(minutes=15))
+    assert llamar(cliente).json() == {'enviados': 0}
+    assert len(db.correos()) == 1
+
+
+def test_reserva_hecha_con_menos_de_24_horas_recibe_recordatorio(cliente, socio):
+    clase = db.crear_clase('Yoga', 'Sofía', AHORA + timedelta(hours=2))
+    assert cliente.post('/reservas', json={'clase_id': clase['id']}, headers=auth(socio)).status_code == 201
+    assert llamar(cliente).json() == {'enviados': 1}
+    assert len(db.correos()) == 2  # confirmación + recordatorio
+
+
+def test_clase_que_ya_no_esta_en_ventana_no_se_recuerda_despues(cliente, socio):
+    clase = db.crear_clase('Yoga', 'Sofía', AHORA + timedelta(hours=30))
+    db.crear_reserva(socio['id'], clase['id'], AHORA)
+    assert llamar(cliente).json() == {'enviados': 0}
+    reloj.fijar(AHORA + timedelta(hours=7))
+    assert llamar(cliente).json() == {'enviados': 1}
