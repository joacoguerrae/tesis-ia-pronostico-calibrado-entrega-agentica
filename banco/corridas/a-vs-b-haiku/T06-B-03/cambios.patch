+        (clase['id'], 'confirmada')]
+    assert creditos(cliente, beto) == 7
+    assert posicion(cliente, beto, clase).status_code == 404
+    assert posicion(cliente, carla, clase).json()['posicion'] == 1
+    assert cliente.get(f"/clases/{clase['id']}").json()['lugares_libres'] == 0
