+def test_ya_corporativo_es_409_sin_consultar(cliente, servicio):
+    socio = socio_corporativo('ana@example.com', 'otra', creditos=20)
+    r = cliente.post('/convenio', json={'empresa': 'acme'}, headers=auth(socio))
+    assert r.status_code == 409
+    assert servicio.pedidos == []
+    actual = db.socio(socio['id'])
+    assert (actual['plan'], actual['creditos'], actual['convenio']) == ('corporativo', 20, 'otra')
+    assert db.correos() == []
