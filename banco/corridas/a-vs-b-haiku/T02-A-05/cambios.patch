@@ -0,0 +1,53 @@
+from datetime import datetime, timedelta, timezone
+
+from conftest import AHORA, auth
+from pulso import db
+
+
+def _crear_varias():
+    # AHORA = 10/11 12:00 Montevideo. 13/11 01:00 UTC = 12/11 22:00 Montevideo.
+    db.crear_clase('A', 'Leo', datetime(2026, 11, 13, 1, 0, tzinfo=timezone.utc))
+    db.crear_clase('B', 'Sofía', datetime(2026, 11, 13, 3, 0, tzinfo=timezone.utc))  # 13/11 00:00 MVD
+    db.crear_clase('C', 'LEO', AHORA + timedelta(days=5))
+    db.crear_clase('D', 'Leo', AHORA - timedelta(hours=1))
+
+
+def _nombres(cliente, **params):
+    return [c['nombre'] for c in cliente.get('/clases', params=params).json()]
+
+
+def test_filtra_por_dia_montevideo(cliente):
+    _crear_varias()
+    assert _nombres(cliente, desde='2026-11-12', hasta='2026-11-12') == ['A']
+    assert _nombres(cliente, desde='2026-11-13', hasta='2026-11-13') == ['B']
+    assert _nombres(cliente, hasta='2026-11-12') == ['A']
+    assert _nombres(cliente, desde='2026-11-13') == ['B', 'C']
+
+
+def test_filtra_por_instructor_y_lugar(cliente, socio):
+    _crear_varias()
+    r = cliente.get('/clases', params={'instructor': 'leo'})
+    assert [c['nombre'] for c in r.json()] == ['A', 'C']
+    assert r.headers['X-Total'] == '2'
+    llena = db.crear_clase('E', 'Ana', AHORA + timedelta(days=1), cupo=1)
+    cliente.post('/reservas', json={'clase_id': llena['id']}, headers=auth(socio))
+    assert 'E' not in _nombres(cliente, con_lugar='true')
+    assert 'E' in _nombres(cliente, con_lugar='false')
+    assert 'E' in _nombres(cliente)
+
+
+def test_paginacion(cliente):
+    for i in range(5):
+        db.crear_clase(f'C{i}', 'Leo', AHORA + timedelta(hours=i + 1))
+    r = cliente.get('/clases', params={'pagina': 2, 'por_pagina': 2})
+    assert [c['nombre'] for c in r.json()] == ['C2', 'C3']
+    assert r.headers['X-Total'] == '5'
+    r = cliente.get('/clases', params={'pagina': 9})
+    assert r.json() == [] and r.headers['X-Total'] == '5'
+    assert len(cliente.get('/clases').json()) == 5
+
+
+def test_parametros_invalidos(cliente):
+    for p in ({'pagina': 0}, {'por_pagina': 0}, {'por_pagina': 51}, {'desde': '12/11/2026'},
+              {'hasta': '2026-13-01'}, {'desde': '2026-11-14', 'hasta': '2026-11-13'}):
+        assert cliente.get('/clases', params=p).status_code == 422, p
