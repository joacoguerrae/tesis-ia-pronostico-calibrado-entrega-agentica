+"""Lista de espera: pasa los lugares que se liberan al primero de la lista."""
+from pulso import correo, db, reloj
+
+
+def asignar_lugares(clase):
+    """Da cada lugar libre de la clase al primero de la lista. Tiene que llamarse dentro de db.transaccion()."""
+    inicio = db.a_fecha(clase['inicio'])
+    if inicio <= reloj.ahora():
+        return
+    cuando = correo.fecha_y_hora(inicio)
+    while db.confirmadas(clase['id']) < clase['cupo']:
+        primero = db.primero_en_espera(clase['id'])
+        if primero is None:
+            return
+        db.quitar_espera(primero['id'])
+        socio = db.socio(primero['socio_id'])
+        if db.tiene_reserva_confirmada(socio['id'], clase['id']):
+            continue
+        if socio['creditos'] < 1:
+            correo.enviar(socio['email'], f"No pudimos darte el lugar: {clase['nombre']} el {cuando}",
+                          f"Hola {socio['nombre']}, se liberó un lugar en {clase['nombre']} pero no te quedan "
+                          'créditos, así que pasamos al siguiente de la lista.')
+            continue
+        db.crear_reserva(socio['id'], clase['id'], reloj.ahora())
+        db.sumar_creditos(socio['id'], -1)
+        correo.enviar(socio['email'], f"Se liberó un lugar: {clase['nombre']} el {cuando}",
+                      f"Hola {socio['nombre']}, se liberó un lugar en {clase['nombre']} con {clase['instructor']} "
+                      'y te lo asignamos. Se descontó un crédito.')
