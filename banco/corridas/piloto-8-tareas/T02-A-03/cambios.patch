diff --git a/tests/test_filtros.py b/tests/test_filtros.py
new file mode 100644
index 0000000..f850a6a
--- /dev/null
+++ b/tests/test_filtros.py
@@ -0,0 +1,60 @@
+from datetime import datetime, timedelta, timezone
+
+import pytest
+
+from conftest import AHORA, auth
+from pulso import db
+
+
+def nombres(r):
+    return [c['nombre'] for c in r.json()]
+
+
+def test_filtra_por_dia_en_montevideo(cliente):
+    # 02:30 UTC del 12/11 es 23:30 del 11/11 en Montevideo.
+    db.crear_clase('A', 'Leo', datetime(2026, 11, 12, 2, 30, tzinfo=timezone.utc))
+    db.crear_clase('B', 'Leo', datetime(2026, 11, 12, 3, 0, tzinfo=timezone.utc))
+    db.crear_clase('C', 'Leo', datetime(2026, 11, 15, 2, 59, tzinfo=timezone.utc))
+    db.crear_clase('D', 'Leo', datetime(2026, 11, 15, 3, 0, tzinfo=timezone.utc))
+    assert nombres(cliente.get('/clases?desde=2026-11-12&hasta=2026-11-14')) == ['B', 'C']
+    assert nombres(cliente.get('/clases?desde=2026-11-14')) == ['C', 'D']
+    assert nombres(cliente.get('/clases?hasta=2026-11-11')) == ['A']
+
+
+def test_instructor_exacto_sin_mayusculas(cliente):
+    db.crear_clase('A', 'Leo', AHORA + timedelta(hours=1))
+    db.crear_clase('B', 'Leonor', AHORA + timedelta(hours=2))
+    assert nombres(cliente.get('/clases?instructor=LEO')) == ['A']
+
+
+def test_con_lugar(cliente, socio):
+    llena = db.crear_clase('Llena', 'Leo', AHORA + timedelta(hours=1), cupo=1)
+    db.crear_clase('Libre', 'Leo', AHORA + timedelta(hours=2))
+    assert cliente.post('/reservas', json={'clase_id': llena['id']}, headers=auth(socio)).status_code == 201
+    assert nombres(cliente.get('/clases?con_lugar=true')) == ['Libre']
+    assert nombres(cliente.get('/clases?con_lugar=false')) == ['Llena', 'Libre']
+    assert cliente.get('/clases?con_lugar=true').headers['X-Total'] == '1'
+
+
+def test_paginacion_y_total(cliente):
+    for i in range(5):
+        db.crear_clase(f'C{i}', 'Leo', AHORA + timedelta(hours=1))  # empatan: orden por id
+    db.crear_clase('Pasada', 'Leo', AHORA - timedelta(hours=1))
+    r = cliente.get('/clases?pagina=2&por_pagina=2')
+    assert nombres(r) == ['C2', 'C3']
+    assert r.headers['X-Total'] == '5'
+    r = cliente.get('/clases?pagina=9&por_pagina=2')
+    assert r.json() == [] and r.headers['X-Total'] == '5'
+    assert len(cliente.get('/clases').json()) == 5
+
+
+@pytest.mark.parametrize('query', [
+    'pagina=0', 'por_pagina=0', 'por_pagina=51', 'pagina=x', 'desde=12-11-2026', 'hasta=20261112',
+    'desde=2026-13-01', 'desde=2026-11-14&hasta=2026-11-12',
+])
+def test_parametros_invalidos(cliente, query):
+    assert cliente.get(f'/clases?{query}').status_code == 422
+
+
+def test_mismo_dia_valido(cliente):
+    assert cliente.get('/clases?desde=2026-11-12&hasta=2026-11-12').status_code == 200
