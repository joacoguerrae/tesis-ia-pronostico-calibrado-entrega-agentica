index 0000000..9745ffc
--- /dev/null
+++ b/pulso/cobra.py
@@ -0,0 +1,50 @@
+"""Cliente de Cobrá, la pasarela de pagos."""
+import os
+from urllib.parse import quote
+
+import httpx
+
+
+class CobraError(Exception):
+    """Cobrá no contestó o contestó algo fuera del contrato."""
+
+
+def _pedir(metodo, ruta, codigos, **kwargs):
+    url = os.environ.get('PULSO_PAGOS_URL', '').rstrip('/') + ruta
+    headers = dict(kwargs.pop('headers', {}), **{'X-Cobra-Clave': os.environ.get('PULSO_PAGOS_CLAVE', '')})
+    try:
+        r = httpx.request(metodo, url, headers=headers, timeout=5, **kwargs)
+        if r.status_code not in codigos:
+            raise CobraError(f'Cobrá respondió {r.status_code}')
+        return r.status_code, r.json()
+    except CobraError:
+        raise
+    except (httpx.HTTPError, ValueError) as e:
+        raise CobraError(str(e)) from e
+
+
+def _pago(datos):
+    if not isinstance(datos, dict) or not all(k in datos for k in ('id', 'estado', 'referencia')):
+        raise CobraError('Pago con formato inválido')
+    return datos
+
+
+def crear_pago(monto, referencia):
+    _, datos = _pedir('POST', '/pagos', (200, 201), headers={'Idempotency-Key': referencia},
+                      json={'monto': monto, 'moneda': 'UYU', 'referencia': referencia})
+    return _pago(datos)
+
+
+def obtener_pago(pago_id):
+    """El pago, o None si Cobrá no lo conoce."""
+    codigo, datos = _pedir('GET', f"/pagos/{quote(pago_id, safe='')}", (200, 404))
+    return None if codigo == 404 else _pago(datos)
+
+
+def buscar_pago(referencia):
+    """El pago con esa referencia, o None si no hay."""
+    _, datos = _pedir('GET', '/pagos', (200,), params={'referencia': referencia})
+    pagos = datos.get('pagos') if isinstance(datos, dict) else None
+    if not isinstance(pagos, list):
+        raise CobraError('Respuesta inválida')
+    return _pago(pagos[0]) if pagos else None
