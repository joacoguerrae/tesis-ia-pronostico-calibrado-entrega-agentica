diff --git a/tests/test_espera.py b/tests/test_espera.py
new file mode 100644
index 0000000..9bdad3d
--- /dev/null
+++ b/tests/test_espera.py
@@ -0,0 +1,133 @@
+from datetime import timedelta
+
+from pulso import db, reloj
+from tests.conftest import ADMIN, AHORA, auth
+
+
+def clase_llena(cliente, cupo=1, inicio=None):
+    clase = db.crear_clase('Spinning', 'Leo', inicio or AHORA + timedelta(hours=7), 45, cupo)
+    duenos = []
+    for i in range(cupo):
+        s = db.crear_socio(f'Dueño {i}', f'dueno{i}@example.com')
+        r = cliente.post('/reservas', json={'clase_id': clase['id']}, headers=auth(s))
+        assert r.status_code == 201
+        duenos.append((s, r.json()))
+    return clase, duenos
+
+
+def anotar(cliente, clase, nombre, creditos=8):
+    s = db.crear_socio(nombre, f'{nombre}@example.com', creditos=creditos)
+    r = cliente.post(f"/clases/{clase['id']}/espera", headers=auth(s))
+    assert r.status_code == 201, r.text
+    return s, r.json()
+
+
+def test_espera_requiere_token_y_clase(cliente, socio):
+    assert cliente.post('/clases/1/espera').status_code == 401
+    assert cliente.get('/clases/1/espera').status_code == 401
+    assert cliente.delete('/clases/1/espera').status_code == 401
+    assert cliente.post('/clases/99/espera', headers=auth(socio)).status_code == 404
+    assert cliente.get('/clases/99/espera', headers=auth(socio)).status_code == 404
+
+
+def test_anotarse_posicion_y_bajarse(cliente):
+    clase, _ = clase_llena(cliente)
+    a, ra = anotar(cliente, clase, 'a')
+    b, rb = anotar(cliente, clase, 'b')
+    assert ra == {'clase_id': clase['id'], 'posicion': 1}
+    assert rb['posicion'] == 2
+    assert db.socio(a['id'])['creditos'] == 8
+    assert cliente.delete(f"/clases/{clase['id']}/espera", headers=auth(a)).status_code == 204
+    assert cliente.get(f"/clases/{clase['id']}/espera", headers=auth(b)).json()['posicion'] == 1
+    assert cliente.get(f"/clases/{clase['id']}/espera", headers=auth(a)).status_code == 404
+    assert cliente.delete(f"/clases/{clase['id']}/espera", headers=auth(a)).status_code == 404
+    r = cliente.post(f"/clases/{clase['id']}/espera", headers=auth(a))
+    assert r.json()['posicion'] == 2
+
+
+def test_anotarse_rechazos(cliente):
+    clase, duenos = clase_llena(cliente)
+    url = f"/clases/{clase['id']}/espera"
+    assert cliente.post(url, headers=auth(duenos[0][0])).status_code == 409
+    s, _ = anotar(cliente, clase, 'a')
+    assert cliente.post(url, headers=auth(s)).status_code == 409
+    sin = db.crear_socio('sin', 'sin@example.com', creditos=0)
+    assert cliente.post(url, headers=auth(sin)).status_code == 409
+    assert cliente.get(url, headers=auth(sin)).status_code == 404
+    libre = db.crear_clase('Yoga', 'Ana', AHORA + timedelta(hours=3), 60, 5)
+    assert cliente.post(f"/clases/{libre['id']}/espera", headers=auth(s)).status_code == 409
+    reloj.fijar(clase['inicio'] and db.a_fecha(clase['inicio']))
+    otro = db.crear_socio('otro', 'otro@example.com')
+    assert cliente.post(url, headers=auth(otro)).status_code == 409
+
+
+def test_cancelar_asigna_al_primero(cliente):
+    clase, duenos = clase_llena(cliente)
+    a, _ = anotar(cliente, clase, 'a')
+    b, _ = anotar(cliente, clase, 'b')
+    r = cliente.post(f"/admin/reservas/{duenos[0][1]['id']}/cancelar", headers=ADMIN)
+    assert r.status_code == 200 and r.json()['estado'] == 'cancelada'
+    assert db.socio(duenos[0][0]['id'])['creditos'] == 8
+    assert db.socio(a['id'])['creditos'] == 7
+    assert [x['estado'] for x in cliente.get('/reservas', headers=auth(a)).json()] == ['confirmada']
+    assert db.confirmadas(clase['id']) == 1
+    assert cliente.get(f"/clases/{clase['id']}/espera", headers=auth(a)).status_code == 404
+    assert cliente.get(f"/clases/{clase['id']}/espera", headers=auth(b)).json()['posicion'] == 1
+    asuntos = [c['asunto'] for c in db.correos() if c['para'] == a['email']]
+    assert asuntos == ['Se liberó un lugar: Spinning el 10/11 a las 19:00']
+    # segunda cancelación: 409 sin otro crédito
+    r = cliente.post(f"/admin/reservas/{duenos[0][1]['id']}/cancelar", headers=ADMIN)
+    assert r.status_code == 409
+    assert db.socio(duenos[0][0]['id'])['creditos'] == 8
+    assert cliente.post('/admin/reservas/999/cancelar', headers=ADMIN).status_code == 404
+    assert cliente.post(f"/admin/reservas/{duenos[0][1]['id']}/cancelar").status_code == 401
+
+
+def test_salto_por_creditos_y_reserva_existente(cliente):
+    clase, duenos = clase_llena(cliente)
+    a, _ = anotar(cliente, clase, 'a', creditos=1)
+    db.sumar_creditos(a['id'], -1)
+    b, _ = anotar(cliente, clase, 'b')
+    c, _ = anotar(cliente, clase, 'c')
+    db.crear_reserva(c['id'], clase['id'], AHORA, estado='cancelada')
+    cliente.post(f"/admin/reservas/{duenos[0][1]['id']}/cancelar", headers=ADMIN)
+    assert [x['asunto'] for x in db.correos() if x['para'] == a['email']] == [
+        'No pudimos darte el lugar: Spinning el 10/11 a las 19:00']
+    assert db.socio(b['id'])['creditos'] == 7
+    assert cliente.get(f"/clases/{clase['id']}/espera", headers=auth(c)).json()['posicion'] == 1
+    assert cliente.get(f"/clases/{clase['id']}/espera", headers=auth(a)).status_code == 404
