@@ -3,7 +3,7 @@ import os
 from fastapi import APIRouter, Depends, FastAPI, Header, HTTPException
 from pydantic import AwareDatetime, BaseModel, Field
 
-from pulso import correo, db, reloj
+from pulso import cobra, compras, correo, db, reloj
 
 router = APIRouter()
 
@@ -92,6 +92,52 @@ def yo(socio=Depends(socio_actual)):
     return {k: socio[k] for k in ('id', 'nombre', 'email', 'plan', 'creditos')}
 
 
+def ver_compra(compra):
+    return {k: compra[k] for k in ('id', 'pack', 'creditos', 'monto', 'estado', 'creada', 'url_pago')}
+
+
+class NuevaCompra(BaseModel):
+    pack: str
+
+
+@router.post('/compras', status_code=201)
+def comprar(datos: NuevaCompra, socio=Depends(socio_actual)):
+    if datos.pack not in compras.CATALOGO:
+        raise HTTPException(422, 'No existe el pack')
+    try:
+        compra = compras.comprar(socio, datos.pack)
+    except cobra.CobraError:
+        raise HTTPException(502, 'No se pudo crear el pago en Cobrá')
+    return ver_compra(compra)
+
+
+@router.get('/compras')
+def mis_compras(socio=Depends(socio_actual)):
+    return [ver_compra(c) for c in db.compras_de(socio['id'])]
+
+
+class AvisoPago(BaseModel):
+    pago_id: str = Field(min_length=1)
+
+
+@router.post('/webhooks/pagos')
+def webhook_pagos(aviso: AvisoPago):
+    # No hay autenticación: solo se usa pago_id y el estado se pide a Cobrá.
+    try:
+        resultado = compras.procesar_aviso(aviso.pago_id)
+    except cobra.CobraError:
+        raise HTTPException(503, 'No se pudo consultar el pago en Cobrá')
+    if resultado is None:
+        raise HTTPException(404, 'No existe el pago o no es de ninguna compra')
+    compra_id, estado = resultado
+    return {'compra_id': compra_id, 'estado': estado}
+
+
+@router.post('/admin/conciliar-pagos', dependencies=[Depends(admin)])
+def conciliar_pagos():
+    return compras.conciliar()
+
+
 def crear_app():
     db.inicializar()
     app = FastAPI(title='Pulso')
