+import json
+import socket
+import sqlite3
+import threading
+import time
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+from urllib.parse import unquote_plus
+
+import pytest
+
+from conftest import ADMIN, auth
+from pulso import beneficios, db
+from pulso.main import crear_app
+
+ACTIVO = (200, {'activo': True})
+INACTIVO = (200, {'activo': False})
+DESCONOCIDO = (404, {'error': 'empleado_desconocido'})
+EMPRESA_DESCONOCIDA = (404, {'error': 'empresa_desconocida'})
+
+
+class _Servicio(BaseHTTPRequestHandler):
+    """Simula el servicio de beneficios. Decodifica el path como formulario, igual que el real."""
+
+    def do_GET(self):
+        srv = self.server
+        srv.pedidos.append({'path': self.path, 'clave': self.headers.get('X-Api-Key')})
+        partes = self.path.split('/')
+        if len(partes) != 5 or partes[1] != 'empresas' or partes[3] != 'empleados':
+            return self._responder(400, {'error': 'ruta_invalida'})
+        estado, cuerpo = srv.responder(unquote_plus(partes[2]), unquote_plus(partes[4]))
+        self._responder(estado, cuerpo)
+
+    def _responder(self, estado, cuerpo):
+        if isinstance(cuerpo, (dict, list)):
+            datos, tipo = json.dumps(cuerpo).encode(), 'application/json'
+        else:
+            datos, tipo = cuerpo.encode(), 'text/plain'
+        self.send_response(estado)
+        self.send_header('Content-Type', tipo)
+        self.send_header('Content-Length', str(len(datos)))
+        self.end_headers()
+        self.wfile.write(datos)
+
+    def log_message(self, *args):
+        pass
+
+
+@pytest.fixture
+def servicio(monkeypatch):
+    srv = ThreadingHTTPServer(('127.0.0.1', 0), _Servicio)
+    srv.pedidos = []
+    srv.responder = lambda empresa, email: EMPRESA_DESCONOCIDA
+    threading.Thread(target=srv.serve_forever, kwargs={'poll_interval': 0.05}, daemon=True).start()
+    monkeypatch.setenv('PULSO_BENEFICIOS_URL', f'http://127.0.0.1:{srv.server_port}')
+    monkeypatch.setenv('PULSO_BENEFICIOS_CLAVE', 'clave-beneficios')
+    yield srv
+    srv.shutdown()
+    srv.server_close()
+
+
+def empleados(srv, registro):
+    """registro: {(empresa, email en minúsculas): (estado, cuerpo)}. Lo que no esté, es empresa desconocida."""
+    srv.responder = lambda empresa, email: registro.get((empresa, email), EMPRESA_DESCONOCIDA)
+
+
+def socio_corporativo(email, empresa, creditos=12):
+    socio = db.crear_socio('Ana Pérez', email, creditos=creditos)
+    assert db.activar_corporativo(socio['id'], empresa)
+    return db.socio(socio['id'])
+
+
+def asuntos():
+    return [c['asunto'] for c in db.correos()]
+
+
+# Activación: POST /convenio
+
+def test_sin_token_es_401(cliente, servicio):
+    assert cliente.post('/convenio', json={'empresa': 'acme'}).status_code == 401
+    assert servicio.pedidos == []
+
+
+@pytest.mark.parametrize('cuerpo', [{}, {'empresa': ''}, {'empresa': '   '}, {'empresa': None}])
+def test_empresa_faltante_o_vacia_es_422(cliente, socio, servicio, cuerpo):
+    r = cliente.post('/convenio', json=cuerpo, headers=auth(socio))
+    assert r.status_code == 422
+    assert servicio.pedidos == []
+
+
+@pytest.mark.parametrize('creditos_previos, creditos_final', [(0, 12), (3, 12), (11, 12), (12, 12), (15, 15)])
+def test_activa_con_piso_de_12_creditos(cliente, socio, servicio, creditos_previos, creditos_final):
+    db.sumar_creditos(socio['id'], creditos_previos - socio['creditos'])
+    empleados(servicio, {('acme', 'ana@example.com'): ACTIVO})
+    r = cliente.post('/convenio', json={'empresa': 'acme'}, headers=auth(socio))
+    assert r.status_code == 200
+    assert r.json() == {'plan': 'corporativo', 'empresa': 'acme', 'creditos': creditos_final}
+    actual = db.socio(socio['id'])
+    assert (actual['plan'], actual['creditos'], actual['convenio']) == ('corporativo', creditos_final, 'acme')
+
+
+def test_activa_manda_un_solo_correo(cliente, socio, servicio):
+    empleados(servicio, {('acme', 'ana@example.com'): ACTIVO})
+    cliente.post('/convenio', json={'empresa': 'acme'}, headers=auth(socio))
+    [correo] = db.correos()
+    assert correo['para'] == 'ana@example.com'
+    assert correo['asunto'] == 'Ya tenés el plan corporativo'
+
+
+def test_consulta_con_email_en_minusculas_y_codificado(cliente, servicio):
+    socio = db.crear_socio('Ana Pérez', 'Ana.Perez+Gym@Example.com')
+    empleados(servicio, {('acme', 'ana.perez+gym@example.com'): ACTIVO})
+    r = cliente.post('/convenio', json={'empresa': 'acme'}, headers=auth(socio))
+    assert r.status_code == 200
+    [pedido] = servicio.pedidos
+    assert pedido['path'] == '/empresas/acme/empleados/ana.perez%2Bgym%40example.com'
+    assert pedido['clave'] == 'clave-beneficios'
+
+
+@pytest.mark.parametrize('respuesta, codigo', [(INACTIVO, 409), (DESCONOCIDO, 409), (EMPRESA_DESCONOCIDA, 404)])
+def test_no_empleado_activo_no_cambia_nada(cliente, socio, servicio, respuesta, codigo):
+    empleados(servicio, {('acme', 'ana@example.com'): respuesta})
+    r = cliente.post('/convenio', json={'empresa': 'acme'}, headers=auth(socio))
+    assert r.status_code == codigo
+    actual = db.socio(socio['id'])
+    assert (actual['plan'], actual['creditos'], actual['convenio']) == ('basico', 8, None)
+    assert db.correos() == []
+
+
+@pytest.mark.parametrize('respuesta', [
+    (500, {'error': 'interno'}),
+    (502, 'bad gateway'),
+    (401, {'error': 'clave_invalida'}),
+    (200, 'no es json'),
+    (200, {}),
+    (200, {'activo': 'si'}),
+    (404, {'error': 'otra_cosa'}),
+])
+def test_falla_del_servicio_es_503_y_no_cambia_nada(cliente, socio, servicio, respuesta):
+    empleados(servicio, {('acme', 'ana@example.com'): respuesta})
+    r = cliente.post('/convenio', json={'empresa': 'acme'}, headers=auth(socio))
+    assert r.status_code == 503
+    actual = db.socio(socio['id'])
+    assert (actual['plan'], actual['creditos'], actual['convenio']) == ('basico', 8, None)
+    assert db.correos() == []
