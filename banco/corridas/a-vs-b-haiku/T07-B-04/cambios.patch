diff --git a/pulso/cobra.py b/pulso/cobra.py
new file mode 100644
index 0000000..2b69ee5
--- /dev/null
+++ b/pulso/cobra.py
@@ -0,0 +1,71 @@
+"""Cliente de Cobrá, la pasarela de pagos. Cobrá es la fuente de verdad del estado de un pago."""
+import os
+from urllib.parse import quote
+
+import httpx
+
+PLAZO_SEGUNDOS = 5
+ESTADOS = ('pendiente', 'aprobado', 'rechazado')
+CAMPOS = ('id', 'estado', 'monto', 'moneda', 'referencia', 'url_pago')
+
+
+class CobraError(Exception):
+    """Cobrá no respondió, o respondió algo que no está en el contrato para esa ruta."""
+
+
+def _cliente():
+    return httpx.Client(timeout=PLAZO_SEGUNDOS)
+
+
+def _pedir(metodo, ruta, codigos, **kwargs):
+    url = os.environ.get('PULSO_PAGOS_URL', '') + ruta
+    headers = {'X-Cobra-Clave': os.environ.get('PULSO_PAGOS_CLAVE', ''), **kwargs.pop('headers', {})}
+    try:
+        with _cliente() as cliente:
+            r = cliente.request(metodo, url, headers=headers, **kwargs)
+    except httpx.HTTPError as e:
+        raise CobraError(f'Cobrá no respondió: {e}') from e
+    if r.status_code not in codigos:
+        raise CobraError(f'Cobrá respondió {r.status_code} a {metodo} {ruta}')
+    return r
+
+
+def _json(r):
+    try:
+        return r.json()
+    except ValueError as e:
+        raise CobraError('Cobrá devolvió una respuesta que no es JSON') from e
+
+
+def _pago(datos):
+    try:
+        pago = {k: datos[k] for k in CAMPOS}
+    except (KeyError, TypeError) as e:
+        raise CobraError('Cobrá devolvió un pago incompleto') from e
+    if pago['estado'] not in ESTADOS:
+        raise CobraError(f"Cobrá devolvió un estado desconocido: {pago['estado']!r}")
+    return pago
+
+
+def crear_pago(referencia, monto):
+    """Crea el pago. Con la misma referencia como Idempotency-Key, Cobrá devuelve el que ya existía (200)."""
+    r = _pedir('POST', '/pagos', (200, 201),
+               headers={'Idempotency-Key': referencia},
+               json={'monto': monto, 'moneda': 'UYU', 'referencia': referencia})
+    return _pago(_json(r))
+
+
+def consultar_pago(pago_id):
+    """Devuelve el pago, o None si Cobrá no lo conoce."""
+    r = _pedir('GET', f'/pagos/{quote(pago_id, safe="")}', (200, 404))
+    if r.status_code == 404:
+        return None
+    return _pago(_json(r))
+
+
+def buscar_pagos(referencia):
+    r = _pedir('GET', '/pagos', (200,), params={'referencia': referencia})
+    try:
+        return [_pago(p) for p in _json(r)['pagos']]
+    except (KeyError, TypeError) as e:
+        raise CobraError('Cobrá devolvió una lista de pagos inválida') from e
diff --git a/pulso/compras.py b/pulso/compras.py
new file mode 100644
index 0000000..65a0688
--- /dev/null
+++ b/pulso/compras.py
@@ -0,0 +1,106 @@
+"""Compra de packs de créditos, pagada online con Cobrá.
+
+Cobrá es la fuente de verdad: un pago solo se da por aprobado o rechazado si Cobrá lo dice.
+"""
+import re
+from datetime import timedelta
+
+from pulso import cobra, correo, db, reloj
+
+CATALOGO = {
+    'pack-4': {'creditos': 4, 'precio': 1200},
+    'pack-8': {'creditos': 8, 'precio': 2200},
+}
+# Pasado este plazo sin que exista ningún pago en Cobrá, el pago nunca se creó.
+PLAZO_SIN_PAGO = timedelta(minutes=30)
+_REFERENCIA = re.compile(r'pulso-compra-(\d+)')
+
+
+class NoEncontrado(Exception):
+    """El pago no existe en Cobrá, o no es de ninguna compra de Pulso."""
+
+
+def referencia(compra_id):
+    return f'pulso-compra-{compra_id}'
+
+
+def _compra_de_referencia(ref):
+    m = _REFERENCIA.fullmatch(ref) if isinstance(ref, str) else None
+    return db.compra(int(m[1])) if m else None
+
+
+def _estado_final(pago):
+    """Estado de la compra que corresponde al pago, o None si todavía no hay resultado."""
+    return {'aprobado': 'aprobada', 'rechazado': 'rechazada'}.get(pago['estado'])
+
+
+def _finalizar(compra, estado):
+    """Aplica el estado a la compra. Devuelve True solo si esta llamada lo cambió.
+    Los créditos y el correo van una sola vez por compra."""
+    if not db.finalizar_compra(compra['id'], estado):
+        return False
+    if estado == 'aprobada':
+        socio = db.socio(compra['socio_id'])
+        correo.enviar(socio['email'], 'Compra de créditos aprobada',
+                      f"Hola {socio['nombre']}, sumamos {compra['creditos']} créditos a tu cuenta "
+                      f"por el {compra['pack']}.")
+    return True
+
+
+def crear(socio, pack):
+    """Guarda la compra como pendiente y crea el pago en Cobrá. Si Cobrá falla, levanta CobraError
+    y la compra queda pendiente y sin pago."""
+    datos = CATALOGO[pack]
+    compra = db.crear_compra(socio['id'], pack, datos['creditos'], datos['precio'], reloj.ahora())
+    pago = cobra.crear_pago(referencia(compra['id']), compra['monto'])
+    db.guardar_pago(compra['id'], pago['id'], pago['url_pago'])
+    return db.compra(compra['id'])
+
+
+def procesar_aviso(pago_id):
+    """Procesa el webhook: consulta el pago en Cobrá y aplica su estado a la compra."""
+    pago = cobra.consultar_pago(pago_id)
+    if pago is None:
+        raise NoEncontrado()
+    compra = _compra_de_referencia(pago['referencia'])
+    if compra is None:
+        raise NoEncontrado()
+    db.guardar_pago(compra['id'], pago['id'], pago['url_pago'])
+    estado = _estado_final(pago)
+    if estado:
+        _finalizar(compra, estado)
+    return db.compra(compra['id'])
+
+
+def _resolver(compra):
+    """Pregunta a Cobrá por el estado de una compra pendiente. Devuelve 'aprobada', 'rechazada'
+    o None si todavía no se sabe. Levanta CobraError si la búsqueda falla."""
+    if compra['pago_id']:
+        pago = cobra.consultar_pago(compra['pago_id'])
+        if pago is None:
+            return None
+    else:
+        pagos = cobra.buscar_pagos(referencia(compra['id']))
+        if not pagos:
+            creada = db.a_fecha(compra['creada'])
+            return 'rechazada' if reloj.ahora() - creada >= PLAZO_SIN_PAGO else None
+        # La referencia es la Idempotency-Key, así que hay un pago como mucho. Si hubiera más,
+        # manda el aprobado.
+        pago = next((p for p in pagos if p['estado'] == 'aprobado'), pagos[0])
+        db.guardar_pago(compra['id'], pago['id'], pago['url_pago'])
+    return _estado_final(pago)
+
+
+def conciliar():
+    """Revisa las compras pendientes al empezar la llamada. Una búsqueda que falla deja la compra pendiente."""
+    resumen = {'aprobadas': 0, 'rechazadas': 0, 'pendientes': 0}
+    for compra in db.compras_pendientes():
+        try:
+            estado = _resolver(compra)
+        except cobra.CobraError:
+            estado = None
+        if estado is None:
+            resumen['pendientes'] += 1
+        elif _finalizar(compra, estado):
+            resumen['aprobadas' if estado == 'aprobada' else 'rechazadas'] += 1
+    return resumen
