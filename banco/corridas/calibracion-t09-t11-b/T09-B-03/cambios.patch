diff --git a/pulso/db.py b/pulso/db.py
index a859654..dfb79d8 100644
--- a/pulso/db.py
+++ b/pulso/db.py
@@ -60,13 +60,29 @@ def inicializar():
         con.executescript(ESQUEMA)
 
 
+def normalizar_inicios():
+    """Pasa el inicio de cada clase al formato canónico (UTC, ISO 8601 con +00:00).
+
+    Idempotente: las filas que ya están en formato canónico no se tocan.
+    """
+    with conexion() as con:
+        filas = con.execute('SELECT id, inicio FROM clases').fetchall()
+        for fila in filas:
+            canonico = a_texto(a_fecha(fila['inicio']))
+            if canonico != fila['inicio']:
+                con.execute('UPDATE clases SET inicio = ? WHERE id = ?', (canonico, fila['id']))
+
+
 def a_texto(momento):
     return momento.astimezone(timezone.utc).replace(microsecond=0).isoformat()
 
 
 def a_fecha(texto):
+    momento = datetime.fromisoformat(texto)
     # Las clases de antes de setiembre se guardaron sin zona horaria, en UTC.
-    return datetime.fromisoformat(texto).replace(tzinfo=timezone.utc)
+    if momento.tzinfo is None:
+        return momento.replace(tzinfo=timezone.utc)
+    return momento.astimezone(timezone.utc)
 
 
 def _una(sql, parametros=()):
@@ -98,7 +114,7 @@ def socio_por_token(token):
 def crear_clase(nombre, instructor, inicio, duracion_min=60, cupo=20):
     with conexion() as con:
         cur = con.execute('INSERT INTO clases (nombre, instructor, inicio, duracion_min, cupo) VALUES (?, ?, ?, ?, ?)',
-                          (nombre, instructor, inicio.isoformat(timespec='seconds'), duracion_min, cupo))
+                          (nombre, instructor, a_texto(inicio), duracion_min, cupo))
     return clase(cur.lastrowid)
 
 
