{"host.arch": "amd64", "os.type": "linux", "os.version": "6.18.33.2-microsoft-standard-WSL2", "service.name": "claude-code", "service.version": "2.1.312", "wsl.version": "2", "user.id": "0f72bbf305cc3cfe4c49efd7a27949e16f5ce38c2de862b736399de5c3c79b13", "session.id": "6a83eb03-13d2-4ac5-b6f9-e11f0896a65d", "terminal.type": "wsl-Ubuntu-24.04", "event.name": "tool_decision", "event.timestamp": "2026-11-14T20:29:27.709Z", "event.sequence": 11, "prompt.id": "afd5a7e3-4419-41b7-9a49-4e2ceb02e338", "decision": "reject", "source": "config", "tool_name": "Bash", "tool_use_id": "toolu_01CL6jXdUGJg6TiCQBtLTpRT", "tool_source": "builtin", "tool_parameters": "{\"bash_command\":\"cat\",\"full_command\":\"cat > pulso/cobra.py <<'EOF'\\n\\\"\\\"\\\"Cliente de Cobrá, la pasarela de pagos. Cualquier falla se levanta como CobraError.\\\"\\\"\\\"\\nimport os\\n\\nimport httpx\\n\\nTIMEOUT = 5.0\\n\\n\\nclass CobraError(Exception):\\n    pass\\n\\n\\ndef _pedir(metodo, ruta, ok, **kwargs):\\n    url = os.environ.get('PULSO_PAGOS_URL', '').rstrip('/') + ruta\\n    headers = dict(kwargs.pop('headers', {}), **{'X-Cobra-Clave': os.environ.get('PULSO_PAGOS_CLAVE', '')})\\n    try:\\n        r = httpx.request(metodo, url, headers=headers, timeout=TIMEOUT, **kwargs)\\n    except httpx.HTTPError as e:\\n        raise CobraError(str(e)) from e\\n    if r.status_code not in ok:\\n        raise CobraError(f'Cobrá respondió {r.status_code}')\\n    try:\\n        return r.status_code, r.json()\\n    except ValueError as e:\\n        raise CobraError('Respuesta inválida de Cobrá') from e\\n\\n\\ndef _pago(datos):\\n    if not isinstance(datos, dict) or not all(k in datos for k in ('id', 'estado', 'referencia')):\\n        raise CobraError('Pago inválido')\\n    return datos\\n\\n\\ndef crear_pago(monto, referencia):\\n    _, datos = _pedir('POST', '/pagos', (200, 201), headers={'Idempotency-Key': referencia},\\n                      json={'monto': monto, 'moneda': 'UYU', 'referencia': referencia})\\n    return _pago(datos)\\n\\n\\ndef obtener_pago(pago_id):\\n    \\\"\\\"\\\"El pago, o None si Cobrá no lo conoce.\\\"\\\"\\\"\\n    try:\\n        _, datos = _pedir('GET', f'/pagos/{pago_id}', (200, 404))\\n    except CobraError:\\n        raise\\n    return _pago(datos) if datos is not None and _existe(pago_id) else None\\n\\n\\ndef _existe(_):\\n    return True\\nEOF\"}", "permission_mode": "dontAsk", "request_id": "req_011Ch3TD6hEwPHT5YaDhrxcV", "_cuerpo": "claude_code.tool_decision", "_tiempo_ns": 1794688167709000000}
