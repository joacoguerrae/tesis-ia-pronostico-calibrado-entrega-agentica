+
+def _migrar(con):
+    columnas = [f['name'] for f in con.execute('PRAGMA table_info(socios)')]
+    if 'empresa_convenio' not in columnas:
+        con.execute('ALTER TABLE socios ADD COLUMN empresa_convenio TEXT')
+
+
+def activar_corporativo(socio_id, empresa, piso=12):
+    """Pasa al socio a corporativo si no lo era. Devuelve False si ya lo era (no cambia nada)."""
+    with conexion() as con:
+        cur = con.execute("UPDATE socios SET plan = 'corporativo', empresa_convenio = ?, "
+                          "creditos = MAX(creditos, ?) WHERE id = ? AND plan != 'corporativo'",
+                          (empresa, piso, socio_id))
+        return cur.rowcount > 0
+
+
+def bajar_a_basico(socio_id):
+    """Vuelve a basico a un socio corporativo, conservando créditos. False si ya no era corporativo."""
+    with conexion() as con:
+        cur = con.execute("UPDATE socios SET plan = 'basico', empresa_convenio = NULL "
+                          "WHERE id = ? AND plan = 'corporativo'", (socio_id,))
+        return cur.rowcount > 0
+
+
+def socios_corporativos():
+    return _varias("SELECT * FROM socios WHERE plan = 'corporativo' ORDER BY id")
