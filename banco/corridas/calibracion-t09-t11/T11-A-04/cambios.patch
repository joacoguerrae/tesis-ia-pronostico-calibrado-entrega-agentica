+    cambios = {}
+    nuevos_inicios = {}
+    for c in afectadas:
+        cambio = {}
+        if datos.hora is not None:
+            actual = db.a_fecha(c['inicio']).astimezone(reloj.MONTEVIDEO)
+            nuevo = inicio_local(actual.date(), datos.hora)
