new file mode 100644
index 0000000..74141d7
--- /dev/null
+++ b/pulso/beneficios.py
@@ -0,0 +1,54 @@
+"""Cliente del servicio de beneficios de los convenios.
+
+Es la fuente de verdad sobre quién es empleado activo de cada empresa: Pulso le pregunta en cada
+consulta y no guarda una copia. La URL y la clave se leen del entorno en cada llamada.
+"""
+import os
+from urllib.parse import quote
+
+import httpx
+
+TIMEOUT_SEG = 3.0
+
+ACTIVO = 'activo'
+INACTIVO = 'inactivo'
+DESCONOCIDO = 'desconocido'
+EMPRESA_DESCONOCIDA = 'empresa_desconocida'
+
+
+class ServicioNoDisponible(Exception):
+    """El servicio falló o respondió algo que no está en el contrato: no se sabe el estado del empleado."""
+
+
+def consultar(empresa, email):
+    """Devuelve ACTIVO, INACTIVO, DESCONOCIDO o EMPRESA_DESCONOCIDA. Lanza ServicioNoDisponible si falla."""
+    base = os.environ.get('PULSO_BENEFICIOS_URL')
+    if not base:
+        raise ServicioNoDisponible('Falta PULSO_BENEFICIOS_URL')
+    # El servicio decodifica el path como formulario: el '+' tiene que ir codificado como %2B.
+    url = f"{base}/empresas/{quote(empresa, safe='')}/empleados/{quote(email.lower(), safe='')}"
+    try:
+        respuesta = httpx.get(url, headers={'X-Api-Key': os.environ.get('PULSO_BENEFICIOS_CLAVE', '')},
+                              timeout=TIMEOUT_SEG)
+    except (httpx.HTTPError, httpx.InvalidURL) as error:
+        raise ServicioNoDisponible(str(error)) from error
+    return _interpretar(respuesta)
+
+
+def _interpretar(respuesta):
+    datos = _json(respuesta)
+    if respuesta.status_code == 200 and isinstance(datos, dict) and isinstance(datos.get('activo'), bool):
+        return ACTIVO if datos['activo'] else INACTIVO
+    if respuesta.status_code == 404 and isinstance(datos, dict):
+        if datos.get('error') == 'empleado_desconocido':
+            return DESCONOCIDO
+        if datos.get('error') == 'empresa_desconocida':
+            return EMPRESA_DESCONOCIDA
+    raise ServicioNoDisponible(f'Respuesta fuera de contrato: {respuesta.status_code}')
+
+
+def _json(respuesta):
+    try:
+        return respuesta.json()
+    except ValueError:
+        return None
