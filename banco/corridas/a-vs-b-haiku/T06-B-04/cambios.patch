+from datetime import timedelta
+
+from conftest import AHORA, INICIO, auth, ocupar, socio_nuevo
+from pulso import db
+
+
+def clase_llena(cupo=1, inicio=INICIO):
+    clase = db.crear_clase('Spinning', 'Leo', inicio, cupo=cupo)
+    ocupar(clase, cupo)
+    return clase
+
+
+def anotar(cliente, socio, clase):
+    return cliente.post(f"/clases/{clase['id']}/espera", headers=auth(socio))
+
+
+def test_anotarse_en_clase_llena_da_posicion_sin_cobrar(cliente):
+    clase = clase_llena()
+    ana = socio_nuevo('Ana')
+    r = anotar(cliente, ana, clase)
+    assert r.status_code == 201
+    assert r.json() == {'clase_id': clase['id'], 'posicion': 1}
+    assert cliente.get(f"/clases/{clase['id']}/espera", headers=auth(ana)).json() == {'clase_id': clase['id'], 'posicion': 1}
+    assert cliente.get('/yo', headers=auth(ana)).json()['creditos'] == 8
+    assert cliente.get('/reservas', headers=auth(ana)).json() == []
+    assert db.correos() == []
+
+
+def test_posicion_avanza_cuando_alguien_de_adelante_se_baja(cliente):
+    clase = clase_llena()
+    ana, beto, carla = socio_nuevo('Ana'), socio_nuevo('Beto'), socio_nuevo('Carla')
+    assert [anotar(cliente, s, clase).json()['posicion'] for s in (ana, beto, carla)] == [1, 2, 3]
+    assert cliente.delete(f"/clases/{clase['id']}/espera", headers=auth(ana)).status_code == 204
+    r = cliente.get(f"/clases/{clase['id']}/espera", headers=auth(carla))
+    assert r.json()['posicion'] == 2
+
+
+def test_volver_a_anotarse_queda_ultimo(cliente):
+    clase = clase_llena()
+    ana, beto = socio_nuevo('Ana'), socio_nuevo('Beto')
+    anotar(cliente, ana, clase)
+    anotar(cliente, beto, clase)
+    cliente.delete(f"/clases/{clase['id']}/espera", headers=auth(ana))
+    assert anotar(cliente, ana, clase).json()['posicion'] == 2
+
+
+def test_sin_token_responde_401(cliente):
+    clase = clase_llena()
+    assert cliente.post(f"/clases/{clase['id']}/espera").status_code == 401
+    assert cliente.get(f"/clases/{clase['id']}/espera").status_code == 401
+    assert cliente.delete(f"/clases/{clase['id']}/espera").status_code == 401
+
+
+def test_clase_inexistente_responde_404(cliente, socio):
+    assert cliente.post('/clases/99/espera', headers=auth(socio)).status_code == 404
+    assert cliente.get('/clases/99/espera', headers=auth(socio)).status_code == 404
+    assert cliente.delete('/clases/99/espera', headers=auth(socio)).status_code == 404
+
+
+def test_no_se_anota_en_clase_con_lugar(cliente, socio):
+    clase = db.crear_clase('Spinning', 'Leo', INICIO, cupo=2)
+    ocupar(clase, 1)
+    assert anotar(cliente, socio, clase).status_code == 409
+    assert cliente.get(f"/clases/{clase['id']}/espera", headers=auth(socio)).status_code == 404
+
+
+def test_no_se_anota_si_ya_tiene_reserva(cliente, socio):
+    clase = db.crear_clase('Spinning', 'Leo', INICIO, cupo=1)
+    db.crear_reserva(socio['id'], clase['id'], AHORA)
+    assert anotar(cliente, socio, clase).status_code == 409
+    assert cliente.get(f"/clases/{clase['id']}/espera", headers=auth(socio)).status_code == 404
+
+
+def test_no_se_anota_dos_veces(cliente):
+    clase = clase_llena()
+    ana = socio_nuevo('Ana')
+    assert anotar(cliente, ana, clase).status_code == 201
+    assert anotar(cliente, ana, clase).status_code == 409
+    assert cliente.get(f"/clases/{clase['id']}/espera", headers=auth(ana)).json()['posicion'] == 1
+
+
+def test_no_se_anota_en_clase_empezada(cliente):
+    clase = clase_llena(inicio=AHORA - timedelta(minutes=1))
+    assert anotar(cliente, socio_nuevo('Ana'), clase).status_code == 409
+
+
+def test_no_se_anota_sin_creditos(cliente):
+    clase = clase_llena()
+    assert anotar(cliente, socio_nuevo('Ana', creditos=0), clase).status_code == 409
+
+
+def test_bajarse_sin_estar_anotado_responde_404(cliente):
+    clase = clase_llena()
+    ana = socio_nuevo('Ana')
+    assert cliente.get(f"/clases/{clase['id']}/espera", headers=auth(ana)).status_code == 404
+    assert cliente.delete(f"/clases/{clase['id']}/espera", headers=auth(ana)).status_code == 404
+
+
+def test_bajarse_saca_de_la_lista(cliente):
+    clase = clase_llena()
+    ana = socio_nuevo('Ana')
+    anotar(cliente, ana, clase)
+    r = cliente.delete(f"/clases/{clase['id']}/espera", headers=auth(ana))
+    assert r.status_code == 204
+    assert r.content == b''
+    assert cliente.get(f"/clases/{clase['id']}/espera", headers=auth(ana)).status_code == 404
+
+
+def test_ver_lista_no_muestra_a_otros_socios(cliente):
+    clase = clase_llena()
+    anotar(cliente, socio_nuevo('Ana'), clase)
+    beto = socio_nuevo('Beto')
+    assert cliente.get(f"/clases/{clase['id']}/espera", headers=auth(beto)).status_code == 404
