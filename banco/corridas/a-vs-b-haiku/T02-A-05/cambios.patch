--- a/pulso/main.py
+++ b/pulso/main.py
@@ -1,6 +1,8 @@
 import os
+import re
+from datetime import date
 
-from fastapi import APIRouter, Depends, FastAPI, Header, HTTPException
+from fastapi import APIRouter, Depends, FastAPI, Header, HTTPException, Query, Response
 from pydantic import AwareDatetime, BaseModel, Field
 
 from pulso import correo, db, reloj
@@ -30,10 +32,43 @@ def ver_reserva(reserva):
     return {k: reserva[k] for k in ('id', 'clase_id', 'estado', 'creada')}
 
 
+def _fecha_param(valor, nombre):
+    if valor is None:
+        return None
+    if not re.fullmatch(r'\d{4}-\d{2}-\d{2}', valor):
+        raise HTTPException(422, f'{nombre} debe tener formato YYYY-MM-DD')
+    try:
+        return date.fromisoformat(valor)
+    except ValueError:
+        raise HTTPException(422, f'{nombre} no es una fecha válida')
+
+
 @router.get('/clases')
-def listar_clases():
+def listar_clases(response: Response, desde: str | None = None, hasta: str | None = None,
+                  instructor: str | None = None, con_lugar: bool = False,
+                  pagina: int = Query(1, ge=1), por_pagina: int = Query(20, ge=1, le=50)):
+    f_desde = _fecha_param(desde, 'desde')
+    f_hasta = _fecha_param(hasta, 'hasta')
+    if f_desde and f_hasta and f_desde > f_hasta:
+        raise HTTPException(422, 'desde no puede ser posterior a hasta')
     ahora = reloj.ahora()
-    return [ver_clase(c) for c in db.clases() if db.a_fecha(c['inicio']) > ahora]
+    resultado = []
+    for c in db.clases():
+        inicio = db.a_fecha(c['inicio'])
+        if inicio <= ahora:
+            continue
+        dia = inicio.astimezone(reloj.MONTEVIDEO).date()
+        if (f_desde and dia < f_desde) or (f_hasta and dia > f_hasta):
+            continue
+        if instructor is not None and c['instructor'].casefold() != instructor.casefold():
+            continue
+        c = ver_clase(c)
+        if con_lugar and c['lugares_libres'] <= 0:
+            continue
+        resultado.append(c)
+    response.headers['X-Total'] = str(len(resultado))
+    ini = (pagina - 1) * por_pagina
+    return resultado[ini:ini + por_pagina]
 
 
 @router.get('/clases/{clase_id}')
