+++ b/tests/test_compras.py
@@ -0,0 +1,187 @@
+from datetime import timedelta
+
+import httpx
+import pytest
+
+from conftest import ADMIN, AHORA, auth
+from pulso import db, reloj
+
+
+class FalsoCobra:
+    """Cobrá en memoria; reemplaza a httpx.request."""
+
+    def __init__(self):
+        self.pagos = {}
+        self.caido = False
+        self.pedidos = []
+
+    def __call__(self, metodo, url, headers=None, json=None, params=None, timeout=None):
+        self.pedidos.append((metodo, url, headers, json))
+        assert headers['X-Cobra-Clave'] == 'clave-cobra'
+        assert timeout == 5.0
+        if self.caido:
+            raise httpx.ConnectError('caído')
+        base = 'https://cobra.test/v1'
+        ruta = url.removeprefix(base)
+        if metodo == 'POST' and ruta == '/pagos':
+            ref = headers['Idempotency-Key']
+            assert json['moneda'] == 'UYU' and json['referencia'] == ref
+            for p in self.pagos.values():
+                if p['referencia'] == ref:
+                    return httpx.Response(200, json=p)
+            return httpx.Response(201, json=self.agregar(json['monto'], ref))
+        if metodo == 'GET' and ruta == '/pagos':
+            return httpx.Response(200, json={'pagos': [p for p in self.pagos.values()
+                                                       if p['referencia'] == params['referencia']]})
+        if metodo == 'GET' and ruta.startswith('/pagos/'):
+            p = self.pagos.get(ruta.removeprefix('/pagos/'))
+            return httpx.Response(200, json=p) if p else httpx.Response(404)
+        return httpx.Response(500)
+
+    def agregar(self, monto, ref, estado='pendiente'):
+        pid = f'pag_{len(self.pagos) + 1}'
+        self.pagos[pid] = {'id': pid, 'estado': estado, 'monto': monto, 'moneda': 'UYU', 'referencia': ref,
+                           'url_pago': f'https://pagar.cobra.uy/{pid}'}
+        return self.pagos[pid]
+
+
+@pytest.fixture
+def cobra(monkeypatch):
+    monkeypatch.setenv('PULSO_PAGOS_URL', 'https://cobra.test/v1')
+    monkeypatch.setenv('PULSO_PAGOS_CLAVE', 'clave-cobra')
+    falso = FalsoCobra()
+    monkeypatch.setattr(httpx, 'request', falso)
+    return falso
+
+
+def comprar(cliente, socio, pack='pack-4'):
+    return cliente.post('/compras', json={'pack': pack}, headers=auth(socio))
+
+
+def creditos(socio):
+    return db.socio(socio['id'])['creditos']
+
+
+def test_compra_crea_pago(cliente, socio, cobra):
+    r = comprar(cliente, socio)
+    assert r.status_code == 201
+    assert r.json() == {'id': 1, 'pack': 'pack-4', 'creditos': 4, 'monto': 1200, 'estado': 'pendiente',
+                        'creada': '2026-11-10T15:00:00+00:00', 'url_pago': 'https://pagar.cobra.uy/pag_1'}
+    assert cobra.pagos['pag_1']['referencia'] == 'pulso-compra-1'
+    assert creditos(socio) == 8
+
+
+@pytest.mark.parametrize('cuerpo', [{}, {'pack': 'pack-9'}, {'pack': None}, {'pack': 4}])
+def test_pack_invalido(cliente, socio, cobra, cuerpo):
+    assert cliente.post('/compras', json=cuerpo, headers=auth(socio)).status_code == 422
+    assert db.compras_de(socio['id']) == [] and cobra.pedidos == []
+
+
+def test_compra_sin_token(cliente, cobra):
+    assert cliente.post('/compras', json={'pack': 'pack-4'}).status_code == 401
+
+
+def test_cobra_falla_deja_compra_pendiente_sin_pago(cliente, socio, cobra):
+    cobra.caido = True
+    assert comprar(cliente, socio).status_code == 502
+    c = cliente.get('/compras', headers=auth(socio)).json()
+    assert len(c) == 1 and c[0]['estado'] == 'pendiente' and c[0]['url_pago'] is None
+
+
+def test_webhook_aprueba_una_sola_vez(cliente, socio, cobra):
+    comprar(cliente, socio, 'pack-8')
+    cobra.pagos['pag_1']['estado'] = 'aprobado'
+    for _ in range(3):
+        r = cliente.post('/webhooks/pagos', json={'pago_id': 'pag_1', 'estado': 'rechazado'})
+        assert r.json() == {'compra_id': 1, 'estado': 'aprobada'}
+    assert creditos(socio) == 16
+    assert [c['asunto'] for c in db.correos()] == ['Compra de créditos aprobada']
+
+
+def test_webhook_rechazado_y_pendiente(cliente, socio, cobra):
+    comprar(cliente, socio)
+    comprar(cliente, socio)
+    cobra.pagos['pag_1']['estado'] = 'rechazado'
+    assert cliente.post('/webhooks/pagos', json={'pago_id': 'pag_1', 'estado': 'aprobado'}).json()['estado'] == 'rechazada'
+    assert cliente.post('/webhooks/pagos', json={'pago_id': 'pag_2'}).json()['estado'] == 'pendiente'
+    assert creditos(socio) == 8 and db.correos() == []
+    # una compra rechazada ya no cambia
+    cobra.pagos['pag_1']['estado'] = 'aprobado'
+    assert cliente.post('/webhooks/pagos', json={'pago_id': 'pag_1'}).json()['estado'] == 'rechazada'
+    assert creditos(socio) == 8
+
+
+def test_webhook_errores(cliente, socio, cobra):
+    assert cliente.post('/webhooks/pagos', json={}).status_code == 422
+    assert cliente.post('/webhooks/pagos', json={'pago_id': 'nada'}).status_code == 404
+    cobra.agregar(100, 'otra-cosa')
+    cobra.agregar(100, 'pulso-compra-99')
+    assert cliente.post('/webhooks/pagos', json={'pago_id': 'pag_1'}).status_code == 404
+    assert cliente.post('/webhooks/pagos', json={'pago_id': 'pag_2'}).status_code == 404
+    cobra.caido = True
+    assert cliente.post('/webhooks/pagos', json={'pago_id': 'pag_1'}).status_code == 503
+
+
+def test_webhook_guarda_pago_de_compra_sin_pago(cliente, socio, cobra):
+    cobra.caido = True
+    comprar(cliente, socio)
+    cobra.caido = False
+    cobra.agregar(1200, 'pulso-compra-1', 'aprobado')
+    r = cliente.post('/webhooks/pagos', json={'pago_id': 'pag_1'})
+    assert r.json() == {'compra_id': 1, 'estado': 'aprobada'}
+    assert db.compra(1)['pago_id'] == 'pag_1' and creditos(socio) == 12
+
+
+def test_conciliar_requiere_admin(cliente, cobra):
+    assert cliente.post('/admin/conciliar-pagos').status_code == 401
+
+
+def test_conciliar(cliente, socio, cobra):
+    otro = db.crear_socio('Beto', 'beto@example.com')
+    comprar(cliente, socio)               # 1: con pago, aprobado
+    comprar(cliente, otro)                # 2: con pago, rechazado
+    comprar(cliente, socio)               # 3: con pago, pendiente
+    cobra.caido = True
+    comprar(cliente, socio)               # 4: sin pago, Cobrá tiene el pago aprobado
+    comprar(cliente, otro)                # 5: sin pago, nunca creado
+    reloj.fijar(AHORA + timedelta(minutes=29))
+    comprar(cliente, otro)                # 6: sin pago, reciente
+    comprar(cliente, otro)                # 7: se resuelve antes de conciliar
+    cobra.caido = False
+    cobra.pagos['pag_1']['estado'] = 'aprobado'
+    cobra.pagos['pag_2']['estado'] = 'rechazado'
+    cobra.agregar(1200, 'pulso-compra-4', 'aprobado')
+    db.resolver_compra(7, 'rechazada')    # ya resuelta: no se cuenta
+    reloj.fijar(AHORA + timedelta(minutes=30))
+    r = cliente.post('/admin/conciliar-pagos', headers=ADMIN)
+    assert r.json() == {'aprobadas': 2, 'rechazadas': 2, 'pendientes': 2}
+    assert [db.compra(i)['estado'] for i in range(1, 8)] == [
+        'aprobada', 'rechazada', 'pendiente', 'aprobada', 'rechazada', 'pendiente', 'rechazada']
+    assert creditos(socio) == 8 + 4 + 4 and creditos(otro) == 8
+    assert db.compra(4)['pago_id'] == 'pag_4'
+    assert len(db.correos()) == 2
+    assert cliente.post('/admin/conciliar-pagos', headers=ADMIN).json() == {'aprobadas': 0, 'rechazadas': 0, 'pendientes': 2}
+    assert creditos(socio) == 16
+
+
+def test_conciliar_con_cobra_caido_no_rechaza(cliente, socio, cobra):
+    cobra.caido = True
+    comprar(cliente, socio)
+    reloj.fijar(AHORA + timedelta(hours=2))
+    r = cliente.post('/admin/conciliar-pagos', headers=ADMIN)
+    assert r.json() == {'aprobadas': 0, 'rechazadas': 0, 'pendientes': 1}
+
+
+def test_conciliar_rechaza_a_los_30_minutos(cliente, socio, cobra):
+    cobra.caido = True
+    comprar(cliente, socio)
+    cobra.caido = False
+    reloj.fijar(AHORA + timedelta(minutes=30))
+    assert cliente.post('/admin/conciliar-pagos', headers=ADMIN).json()['rechazadas'] == 1
+
+
+def test_listado_mas_nueva_primero(cliente, socio, cobra):
+    comprar(cliente, socio)
+    reloj.fijar(AHORA + timedelta(minutes=1))
+    comprar(cliente, socio, 'pack-8')
+    assert [c['id'] for c in cliente.get('/compras', headers=auth(socio)).json()] == [2, 1]
