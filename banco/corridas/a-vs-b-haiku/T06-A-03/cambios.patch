 def correos():
     return _varias('SELECT * FROM correos ORDER BY id')
+
+
+# --- Lista de espera y panel de recepción ---------------------------------
+# Estas operaciones corren enteras en una sola transacción con escritura
+# reservada (BEGIN IMMEDIATE), para que no se pisen entre procesos.
+
+ESQUEMA_ESPERA = """
+CREATE TABLE IF NOT EXISTS espera (
+    id INTEGER PRIMARY KEY AUTOINCREMENT,
+    clase_id INTEGER NOT NULL REFERENCES clases(id),
+    socio_id INTEGER NOT NULL REFERENCES socios(id),
+    UNIQUE (clase_id, socio_id)
+);
+CREATE UNIQUE INDEX IF NOT EXISTS una_confirmada_por_socio
+    ON reservas (socio_id, clase_id) WHERE estado = 'confirmada';
+"""
+
+
+class Conflicto(Exception):
+    """Una regla de negocio no permite la operación."""
+
+
+class NoExiste(Exception):
+    pass
+
+
+@contextmanager
+def transaccion():
+    con = sqlite3.connect(ruta(), timeout=30, isolation_level=None)
+    con.row_factory = sqlite3.Row
+    con.execute('PRAGMA foreign_keys = ON')
+    con.execute('BEGIN IMMEDIATE')
+    try:
+        yield con
+        con.execute('COMMIT')
+    except BaseException:
+        con.execute('ROLLBACK')
+        raise
+    finally:
+        con.close()
+
+
+def _fila(con, sql, parametros=()):
+    f = con.execute(sql, parametros).fetchone()
+    return dict(f) if f else None
+
+
+def _confirmadas(con, clase_id):
+    return con.execute("SELECT COUNT(*) FROM reservas WHERE clase_id = ? AND estado = 'confirmada'",
+                       (clase_id,)).fetchone()[0]
+
+
+def _correo(con, para, asunto, cuerpo, ahora):
+    con.execute('INSERT INTO correos (para, asunto, cuerpo, creado) VALUES (?, ?, ?, ?)',
+                (para, asunto, cuerpo, a_texto(ahora)))
+
+
+def _asignar_lugares(con, clase, ahora):
+    """Pasa los lugares libres de la clase a la lista de espera, en orden."""
+    from pulso import correo
+    inicio = a_fecha(clase['inicio'])
+    if inicio <= ahora:
+        return
+    cuando = correo.fecha_y_hora(inicio)
+    while _confirmadas(con, clase['id']) < clase['cupo']:
+        primero = _fila(con, 'SELECT * FROM espera WHERE clase_id = ? ORDER BY id LIMIT 1', (clase['id'],))
+        if primero is None:
+            return
+        con.execute('DELETE FROM espera WHERE id = ?', (primero['id'],))
+        s = _fila(con, 'SELECT * FROM socios WHERE id = ?', (primero['socio_id'],))
+        if _fila(con, "SELECT id FROM reservas WHERE socio_id = ? AND clase_id = ? AND estado = 'confirmada'",
+                 (s['id'], clase['id'])):
+            continue
+        if s['creditos'] < 1:
+            _correo(con, s['email'], f"No pudimos darte el lugar: {clase['nombre']} el {cuando}",
+                    f"Hola {s['nombre']}, se liberó un lugar en {clase['nombre']} pero no te quedan créditos.", ahora)
+            continue
+        con.execute("INSERT INTO reservas (socio_id, clase_id, estado, creada) VALUES (?, ?, 'confirmada', ?)",
+                    (s['id'], clase['id'], a_texto(ahora)))
+        con.execute('UPDATE socios SET creditos = creditos - 1 WHERE id = ?', (s['id'],))
+        _correo(con, s['email'], f"Se liberó un lugar: {clase['nombre']} el {cuando}",
+                f"Hola {s['nombre']}, tenés lugar en {clase['nombre']} con {clase['instructor']}.", ahora)
+
+
+def reservar(socio_id, clase_id, ahora):
+    """Reserva atómica. Devuelve (reserva, socio, clase)."""
+    with transaccion() as con:
+        c = _fila(con, 'SELECT * FROM clases WHERE id = ?', (clase_id,))
+        if c is None:
+            raise NoExiste('No existe la clase')
+        s = _fila(con, 'SELECT * FROM socios WHERE id = ?', (socio_id,))
+        if a_fecha(c['inicio']) <= ahora:
+            raise Conflicto('La clase ya empezó')
+        if _fila(con, "SELECT id FROM reservas WHERE socio_id = ? AND clase_id = ? AND estado = 'confirmada'",
+                 (socio_id, clase_id)):
+            raise Conflicto('Ya tenés una reserva para esta clase')
+        if _confirmadas(con, clase_id) >= c['cupo']:
+            raise Conflicto('La clase no tiene lugar')
+        if s['creditos'] < 1:
+            raise Conflicto('No te quedan créditos')
+        cur = con.execute("INSERT INTO reservas (socio_id, clase_id, estado, creada) VALUES (?, ?, 'confirmada', ?)",
+                          (socio_id, clase_id, a_texto(ahora)))
+        con.execute('UPDATE socios SET creditos = creditos - 1 WHERE id = ?', (socio_id,))
+        r = _fila(con, 'SELECT * FROM reservas WHERE id = ?', (cur.lastrowid,))
+    return r, s, c
+
+
+def _posicion(con, clase_id, socio_id):
+    e = _fila(con, 'SELECT id FROM espera WHERE clase_id = ? AND socio_id = ?', (clase_id, socio_id))
+    if e is None:
+        raise NoExiste('No estás en la lista de espera')
+    n = con.execute('SELECT COUNT(*) FROM espera WHERE clase_id = ? AND id <= ?', (clase_id, e['id'])).fetchone()[0]
+    return {'clase_id': clase_id, 'posicion': n}
+
+
+def anotar_en_espera(socio_id, clase_id, ahora):
+    with transaccion() as con:
+        c = _fila(con, 'SELECT * FROM clases WHERE id = ?', (clase_id,))
+        if c is None:
+            raise NoExiste('No existe la clase')
+        s = _fila(con, 'SELECT * FROM socios WHERE id = ?', (socio_id,))
+        if a_fecha(c['inicio']) <= ahora:
+            raise Conflicto('La clase ya empezó')
+        if _confirmadas(con, clase_id) < c['cupo']:
+            raise Conflicto('La clase tiene lugar: reservá directo')
+        if _fila(con, "SELECT id FROM reservas WHERE socio_id = ? AND clase_id = ? AND estado = 'confirmada'",
+                 (socio_id, clase_id)):
+            raise Conflicto('Ya tenés una reserva para esta clase')
+        if _fila(con, 'SELECT id FROM espera WHERE clase_id = ? AND socio_id = ?', (clase_id, socio_id)):
+            raise Conflicto('Ya estás en la lista de espera')
+        if s['creditos'] < 1:
+            raise Conflicto('No te quedan créditos')
+        con.execute('INSERT INTO espera (clase_id, socio_id) VALUES (?, ?)', (clase_id, socio_id))
+        return _posicion(con, clase_id, socio_id)
+
+
+def posicion_en_espera(socio_id, clase_id):
+    with transaccion() as con:
+        if _fila(con, 'SELECT id FROM clases WHERE id = ?', (clase_id,)) is None:
+            raise NoExiste('No existe la clase')
+        return _posicion(con, clase_id, socio_id)
+
+
+def bajar_de_espera(socio_id, clase_id):
+    with transaccion() as con:
+        if _fila(con, 'SELECT id FROM clases WHERE id = ?', (clase_id,)) is None:
+            raise NoExiste('No existe la clase')
+        _posicion(con, clase_id, socio_id)
+        con.execute('DELETE FROM espera WHERE clase_id = ? AND socio_id = ?', (clase_id, socio_id))
+
+
+def cancelar_reserva(reserva_id, ahora):
+    with transaccion() as con:
+        r = _fila(con, 'SELECT * FROM reservas WHERE id = ?', (reserva_id,))
+        if r is None:
+            raise NoExiste('No existe la reserva')
+        if r['estado'] == 'cancelada':
+            raise Conflicto('La reserva ya estaba cancelada')
+        con.execute("UPDATE reservas SET estado = 'cancelada' WHERE id = ?", (reserva_id,))
+        con.execute('UPDATE socios SET creditos = creditos + 1 WHERE id = ?', (r['socio_id'],))
+        c = _fila(con, 'SELECT * FROM clases WHERE id = ?', (r['clase_id'],))
+        _asignar_lugares(con, c, ahora)
+        return _fila(con, 'SELECT * FROM reservas WHERE id = ?', (reserva_id,))
+
+
+def cambiar_cupo(clase_id, cupo, ahora):
+    with transaccion() as con:
+        c = _fila(con, 'SELECT * FROM clases WHERE id = ?', (clase_id,))
+        if c is None:
+            raise NoExiste('No existe la clase')
+        if cupo < _confirmadas(con, clase_id):
+            raise Conflicto('El cupo no puede quedar por debajo de las reservas confirmadas')
+        con.execute('UPDATE clases SET cupo = ? WHERE id = ?', (cupo, clase_id))
+        c['cupo'] = cupo
+        _asignar_lugares(con, c, ahora)
+        c['lugares_libres'] = cupo - _confirmadas(con, clase_id)
+        return c
