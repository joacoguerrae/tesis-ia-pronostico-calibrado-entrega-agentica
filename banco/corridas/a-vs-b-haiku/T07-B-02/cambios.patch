+    if datos.pack not in compras.PACKS:
+        raise HTTPException(422, 'El pack no existe')
+    creditos, monto = compras.PACKS[datos.pack]
+    compra = db.crear_compra(socio['id'], datos.pack, creditos, monto, reloj.ahora())
+    try:
+        pago = cobra.crear_pago(compras.referencia(compra['id']), monto)
+    except cobra.CobraError:
+        # La compra queda pendiente y sin pago: Cobrá pudo haberlo creado igual. La conciliación lo busca.
+        raise HTTPException(502, 'No se pudo crear el pago en Cobrá')
+    db.guardar_pago(compra['id'], pago['id'], pago['url_pago'])
+    return ver_compra(db.compra(compra['id']))
+
