+PACKS = {'pack-4': {'creditos': 4, 'precio': 1200}, 'pack-8': {'creditos': 8, 'precio': 2200}}
+ESPERA_SIN_PAGO = timedelta(minutes=30)
+
+
+def referencia_de(compra_id):
+    return f'pulso-compra-{compra_id}'
+
+
+def ver_compra(compra):
+    datos = {k: compra[k] for k in ('id', 'pack', 'creditos', 'monto', 'estado', 'creada', 'url_pago')}
+    return datos
+
+
+def aplicar_pago(compra, pago):
+    """Aplica el estado del pago a la compra; créditos y correo van solo una vez."""
+    nuevo = {'aprobado': 'aprobada', 'rechazado': 'rechazada'}.get(pago['estado'])
+    if nuevo is None or not db.resolver_compra(compra['id'], nuevo):
+        return
+    if nuevo == 'aprobada':
+        db.sumar_creditos(compra['socio_id'], compra['creditos'])
+        socio = db.socio(compra['socio_id'])
+        correo.enviar(socio['email'], 'Compra de créditos aprobada',
+                      f"Hola {socio['nombre']}, se acreditaron {compra['creditos']} créditos de tu compra {compra['pack']}.")
+
+
+class NuevaCompra(BaseModel):
+    pack: str | None = None
+
+
+@router.post('/compras', status_code=201)
+def comprar(datos: NuevaCompra, socio=Depends(socio_actual)):
+    pack = PACKS.get(datos.pack)
+    if pack is None:
+        raise HTTPException(422, 'Pack inválido')
+    compra = db.crear_compra(socio['id'], datos.pack, pack['creditos'], pack['precio'], reloj.ahora())
+    try:
+        pago = cobra.crear_pago(pack['precio'], referencia_de(compra['id']))
+    except cobra.CobraFalla:
+        raise HTTPException(502, 'No se pudo crear el pago')
+    db.guardar_pago_de_compra(compra['id'], pago['id'], pago.get('url_pago'))
+    return ver_compra(db.compra(compra['id']))
+
+
+@router.get('/compras')
+def mis_compras(socio=Depends(socio_actual)):
+    return [ver_compra(c) for c in db.compras_de(socio['id'])]
+
+
+class AvisoPago(BaseModel):
+    pago_id: str = Field(min_length=1)
+
+
+@router.post('/webhooks/pagos')
+def webhook_pagos(datos: AvisoPago):
+    try:
+        pago = cobra.obtener_pago(datos.pago_id)
+    except cobra.CobraFalla:
+        raise HTTPException(503, 'Cobrá no responde')
+    if pago is None:
+        raise HTTPException(404, 'Pago desconocido')
+    compra = None
+    prefijo = 'pulso-compra-'
+    ref = pago['referencia']
+    if ref.startswith(prefijo) and ref[len(prefijo):].isascii() and ref[len(prefijo):].isdigit():
+        compra = db.compra(int(ref[len(prefijo):]))
+        if compra is not None and referencia_de(compra['id']) != ref:
+            compra = None
+    if compra is None:
+        raise HTTPException(404, 'El pago no es de ninguna compra')
+    if compra['pago_id'] is None:
+        db.guardar_pago_de_compra(compra['id'], pago['id'], pago.get('url_pago'))
+    aplicar_pago(compra, pago)
+    return {'compra_id': compra['id'], 'estado': db.compra(compra['id'])['estado']}
+
+
+@router.post('/admin/conciliar-pagos', dependencies=[Depends(admin)])
+def conciliar_pagos():
+    ids = [c['id'] for c in db.compras_pendientes()]
+    for compra_id in ids:
+        compra = db.compra(compra_id)
+        if compra['estado'] != 'pendiente':
+            continue
+        try:
+            if compra['pago_id']:
+                pago = cobra.obtener_pago(compra['pago_id'])
+            else:
+                pago = cobra.buscar_por_referencia(referencia_de(compra_id))
+                if pago is not None:
+                    db.guardar_pago_de_compra(compra_id, pago['id'], pago.get('url_pago'))
+                elif reloj.ahora() - db.a_fecha(compra['creada']) >= ESPERA_SIN_PAGO:
+                    db.resolver_compra(compra_id, 'rechazada')
+            if pago is not None:
+                aplicar_pago(compra, pago)
+        except cobra.CobraFalla:
+            continue
+    resultado = {'aprobadas': 0, 'rechazadas': 0, 'pendientes': 0}
+    clave = {'aprobada': 'aprobadas', 'rechazada': 'rechazadas', 'pendiente': 'pendientes'}
+    for compra_id in ids:
+        resultado[clave[db.compra(compra_id)['estado']]] += 1
+    return resultado
