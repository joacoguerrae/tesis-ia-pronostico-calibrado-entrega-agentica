diff --git a/tests/test_recordatorios.py b/tests/test_recordatorios.py
new file mode 100644
index 0000000..0b7ffe3
--- /dev/null
+++ b/tests/test_recordatorios.py
@@ -0,0 +1,44 @@
+from datetime import timedelta
+
+from conftest import ADMIN, AHORA
+from pulso import db, reloj
+
+
+def recordatorios():
+    return [c for c in db.correos() if c['asunto'].startswith('Recordatorio')]
+
+
+def test_requiere_clave(cliente):
+    assert cliente.post('/admin/recordatorios').status_code == 401
+    assert cliente.post('/admin/recordatorios', headers={'X-Admin-Key': 'x'}).status_code == 401
+
+
+def test_envia_una_sola_vez(cliente, socio):
+    clase = db.crear_clase('Yoga', 'Sofía', AHORA + timedelta(hours=6, minutes=30))
+    db.crear_reserva(socio['id'], clase['id'], AHORA)
+    r = cliente.post('/admin/recordatorios', headers=ADMIN)
+    assert r.json() == {'enviados': 1}
+    assert cliente.post('/admin/recordatorios', headers=ADMIN).json() == {'enviados': 0}
+    (c,) = recordatorios()
+    assert c['para'] == 'ana@example.com'
+    assert c['asunto'] == 'Recordatorio: Yoga el 10/11 a las 18:30'
+    assert 'Sofía' in c['cuerpo']
+
+
+def test_ventana_y_estado(cliente, socio):
+    for nombre, delta in [('Borde', timedelta(hours=24)), ('Lejos', timedelta(hours=24, seconds=1)),
+                          ('Ahora', timedelta(0)), ('Pasada', -timedelta(hours=1))]:
+        db.crear_reserva(socio['id'], db.crear_clase(nombre, 'L', AHORA + delta)['id'], AHORA)
+    cancelada = db.crear_clase('Cancelada', 'L', AHORA + timedelta(hours=3))
+    db.crear_reserva(socio['id'], cancelada['id'], AHORA, estado='cancelada')
+    assert cliente.post('/admin/recordatorios', headers=ADMIN).json() == {'enviados': 1}
+    assert 'Borde' in recordatorios()[0]['asunto']
+
+
+def test_reserva_tardia_y_clase_que_entra_luego(cliente, socio):
+    clase = db.crear_clase('Spinning', 'Leo', AHORA + timedelta(hours=30))
+    db.crear_reserva(socio['id'], clase['id'], AHORA)
+    assert cliente.post('/admin/recordatorios', headers=ADMIN).json() == {'enviados': 0}
+    reloj.fijar(AHORA + timedelta(hours=10))
+    assert cliente.post('/admin/recordatorios', headers=ADMIN).json() == {'enviados': 1}
+    assert cliente.post('/admin/recordatorios', headers=ADMIN).json() == {'enviados': 0}
