--- a/pulso/db.py
+++ b/pulso/db.py
@@ -136,3 +136,104 @@ def sumar_creditos(socio_id, cantidad):
 
 def correos():
     return _varias('SELECT * FROM correos ORDER BY id')
+
+
+# --- Lista de espera y asignación de lugares liberados ---
+
+ESQUEMA_ESPERA = """
+CREATE TABLE IF NOT EXISTS espera (
+    id INTEGER PRIMARY KEY AUTOINCREMENT,
+    socio_id INTEGER NOT NULL REFERENCES socios(id),
+    clase_id INTEGER NOT NULL REFERENCES clases(id),
+    UNIQUE (socio_id, clase_id)
+);
+"""
+
+
+def inicializar_espera():
+    with conexion() as con:
+        con.executescript(ESQUEMA_ESPERA)
+
+
+@contextmanager
+def transaccion():
+    """Conexión con la escritura tomada de entrada: la operación es atómica y serializada."""
+    with conexion() as con:
+        con.execute('BEGIN IMMEDIATE')
+        yield con
+
+
+def _fila(con, sql, parametros=()):
+    f = con.execute(sql, parametros).fetchone()
+    return dict(f) if f else None
+
+
+def clase_en(con, clase_id):
+    return _fila(con, 'SELECT * FROM clases WHERE id = ?', (clase_id,))
+
+
+def confirmadas_en(con, clase_id):
+    return con.execute("SELECT COUNT(*) FROM reservas WHERE clase_id = ? AND estado = 'confirmada'",
+                       (clase_id,)).fetchone()[0]
+
+
+def posicion_espera(clase_id, socio_id):
+    """Posición (desde 1) del socio en la lista, o None si no está."""
+    with conexion() as con:
+        mia = _fila(con, 'SELECT id FROM espera WHERE clase_id = ? AND socio_id = ?', (clase_id, socio_id))
+        if mia is None:
+            return None
+        return con.execute('SELECT COUNT(*) FROM espera WHERE clase_id = ? AND id <= ?',
+                           (clase_id, mia['id'])).fetchone()[0]
+
+
+def anotar_espera(socio_id, clase_id, ahora):
+    """Anota al socio al final de la lista si corresponde. Devuelve None o el motivo del rechazo."""
+    with transaccion() as con:
+        c = clase_en(con, clase_id)
+        s = _fila(con, 'SELECT * FROM socios WHERE id = ?', (socio_id,))
+        if datetime.fromisoformat(c['inicio']) <= ahora:
+            return 'La clase ya empezó'
+        if confirmadas_en(con, clase_id) < c['cupo']:
+            return 'La clase tiene lugar: reservá directo'
+        if _fila(con, "SELECT 1 FROM reservas WHERE socio_id = ? AND clase_id = ? AND estado = 'confirmada'",
+                 (socio_id, clase_id)):
+            return 'Ya tenés una reserva para esta clase'
+        if _fila(con, 'SELECT 1 FROM espera WHERE socio_id = ? AND clase_id = ?', (socio_id, clase_id)):
+            return 'Ya estás en la lista de espera'
+        if s['creditos'] < 1:
+            return 'No te quedan créditos'
+        con.execute('INSERT INTO espera (socio_id, clase_id) VALUES (?, ?)', (socio_id, clase_id))
+    return None
+
+
+def bajar_espera(socio_id, clase_id):
+    with conexion() as con:
+        return con.execute('DELETE FROM espera WHERE socio_id = ? AND clase_id = ?',
+                           (socio_id, clase_id)).rowcount > 0
+
+
+def asignar_lugares(con, clase_id, ahora, avisar):
+    """Pasa los lugares libres de la clase a la lista de espera. `avisar(tipo, socio, clase)` con
+    tipo 'lugar' o 'sin_creditos'. Usar dentro de una transacción."""
+    c = clase_en(con, clase_id)
+    if datetime.fromisoformat(c['inicio']) <= ahora:
+        return
+    libres = c['cupo'] - confirmadas_en(con, clase_id)
+    while libres > 0:
+        e = _fila(con, 'SELECT * FROM espera WHERE clase_id = ? ORDER BY id LIMIT 1', (clase_id,))
+        if e is None:
+            return
+        con.execute('DELETE FROM espera WHERE id = ?', (e['id'],))
+        s = _fila(con, 'SELECT * FROM socios WHERE id = ?', (e['socio_id'],))
+        if _fila(con, "SELECT 1 FROM reservas WHERE socio_id = ? AND clase_id = ? AND estado = 'confirmada'",
+                 (s['id'], clase_id)):
+            continue
+        if s['creditos'] < 1:
+            avisar('sin_creditos', s, c)
+            continue
+        con.execute("INSERT INTO reservas (socio_id, clase_id, estado, creada) VALUES (?, ?, 'confirmada', ?)",
+                    (s['id'], clase_id, a_texto(ahora)))
+        con.execute('UPDATE socios SET creditos = creditos - 1 WHERE id = ?', (s['id'],))
+        libres -= 1
+        avisar('lugar', s, c)
