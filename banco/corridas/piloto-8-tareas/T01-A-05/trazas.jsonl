{"host.arch": "arm64", "os.type": "darwin", "os.version": "23.4.0", "service.name": "claude-code", "service.version": "2.1.312", "user.id": "", "session.id": "020770ca-135b-4375-b9bc-36df8c62eeb1", "terminal.type": "claude-desktop", "gen_ai.provider.name": "anthropic", "span.type": "tool", "tool_name": "Bash", "tool_name_safe": "Bash", "gen_ai.operation.name": "execute_tool", "gen_ai.tool.name": "Bash", "gen_ai.conversation.id": "020770ca-135b-4375-b9bc-36df8c62eeb1", "full_command": "cat > tests/test_cancelar.py <<'EOF'\nfrom datetime import timedelta\n\nfrom pulso import db\nfrom tests.conftest import ADMIN, AHORA, auth\n\n\ndef reservar(cliente, socio, horas):\n    clase = db.crear_clase('Yoga', 'Lu', AHORA + timedelta(hours=horas))\n    r = cliente.post('/reservas', json={'clase_id': clase['id']}, headers=auth(socio))\n    assert r.status_code == 201\n    return clase, r.json()\n\n\ndef creditos(socio):\n    return db.socio(socio['id'])['creditos']\n\n\ndef test_cancela_con_anticipacion_devuelve_credito(cliente, socio):\n    clase, res = reservar(cliente, socio, 2)\n    r = cliente.post(f\"/reservas/{res['id']}/cancelar\", headers=auth(socio))\n    assert r.status_code == 200\n    assert r.json() == {**res, 'estado': 'cancelada', 'credito_devuelto': True}\n    assert creditos(socio) == 8\n    assert cliente.get(f\"/clases/{clase['id']}\").json()['lugares_libres'] == clase['cupo']\n    lista = cliente.get('/reservas', headers=auth(socio)).json()\n    assert lista[0]['estado'] == 'cancelada'\n\n\ndef test_cancela_tarde_no_devuelve_credito(cliente, socio):\n    _, res = reservar(cliente, socio, 1.9)\n    r = cliente.post(f\"/reservas/{res['id']}/cancelar\", headers=auth(socio))\n    assert r.status_code == 200\n    assert r.json()['credito_devuelto'] is False\n    assert creditos(socio) == 7\n\n\ndef test_no_se_cancela_dos_veces(cliente, socio):\n    _, res = reservar(cliente, socio, 5)\n    cliente.post(f\"/reservas/{res['id']}/cancelar\", headers=auth(socio))\n    r = cliente.post(f\"/reservas/{res['id']}/cancelar\", headers=auth(socio))\n    assert r.status_code == 409\n    assert creditos(socio) == 8\n\n\ndef test_clase_empezada(cliente, socio):\n    from pulso import reloj\n    _, res = reservar(cliente, socio, 5)\n    reloj.fijar(AHORA + timedelta(hours=5))\n    r = cliente.post(f\"/reservas/{res['id']}/cancelar\", headers=auth(socio))\n    assert r.status_code == 409\n    assert creditos(socio) == 7\n\n\ndef test_ajena_o_inexistente_404(cliente, socio):\n    otro = db.crear_socio('Beto', 'beto@example.com')\n    _, res = reservar(cliente, socio, 5)\n    assert cliente.post(f\"/reservas/{res['id']}/cancelar\", headers=auth(otro)).status_code == 404\n    assert cliente.post('/reservas/999/cancelar', headers=auth(socio)).status_code == 404\n    assert db.reserva(res['id'])['estado'] == 'confirmada'\n\n\ndef test_sin_token_401(cliente):\n    assert cliente.post('/reservas/1/cancelar').status_code == 401\n\n\ndef test_puede_volver_a_reservar(cliente, socio):\n    clase, res = reservar(cliente, socio, 5)\n    cliente.post(f\"/reservas/{res['id']}/cancelar\", headers=auth(socio))\n    r = cliente.post('/reservas', json={'clase_id': clase['id']}, headers=auth(socio))\n    assert r.status_code == 201\n\n\ndef test_libera_lugar_para_otro(cliente, socio):\n    otro = db.crear_socio('Beto', 'beto@example.com')\n    clase = db.crear_clase('Yoga', 'Lu', AHORA + timedelta(hours=5), cupo=1)\n    res = cliente.post('/reservas', json={'clase_id': clase['id']}, headers=auth(socio)).json()\n    assert cliente.post('/reservas', json={'clase_id': clase['id']}, headers=auth(otro)).status_code == 409\n    cliente.post(f\"/reservas/{res['id']}/cancelar\", headers=auth(socio))\n    assert cliente.post('/reservas', json={'clase_id': clase['id']}, headers=auth(otro)).status_code == 201\nEOF\npython -m pytest -q 2>&1 | tail -15", "bash_command_class": "file_read", "bash_argv0": "cat", "tool_use_id": "toolu_018F5HqwN7NngQxJ45BhhRu2", "gen_ai.tool.call.id": "toolu_018F5HqwN7NngQxJ45BhhRu2", "duration_ms": 5, "_nombre": "claude_code.tool", "_traza": "a1122659e36c13ad94cf6b43467c94cc", "_tramo": "6cde6ee6cf102a56", "_padre": "b5723ffaa5d7fded", "_inicio_ns": 1794572401009000000, "_fin_ns": 1794572401014164708, "_estado": 0}
