or, KeyError, TypeError) as e:\\n        raise ServicioCaido(str(e)) from e\\n    raise ServicioCaido(f'Respuesta inesperada ({r.status_code})')\\nEOF\\npython - <<'EOF'\\nEOF\"}", "permission_mode": "dontAsk", "request_id": "req_011Ch3TKVg1xHZTsv6s5mLe8", "_cuerpo": "claude_code.tool_decision", "_tiempo_ns": 1794688251534000000}
