--- a/pulso/db.py
+++ b/pulso/db.py
@@ -82,7 +82,7 @@ def _varias(sql, parametros=()):
 def crear_socio(nombre, email, plan='basico', creditos=8):
     with conexion() as con:
         cur = con.execute('INSERT INTO socios (nombre, email, plan, creditos, token) VALUES (?, ?, ?, ?, ?)',
-                          (nombre, email, plan, creditos, secrets.token_hex(16)))
+                          (nombre, email, plan, creditos, secrets.token_hex(32)))
     return socio(cur.lastrowid)
 
 
@@ -90,6 +90,10 @@ def socio(socio_id):
     return _una('SELECT * FROM socios WHERE id = ?', (socio_id,))
 
 
+def socio_por_email(email):
+    return _una('SELECT * FROM socios WHERE email = ?', (email,))
+
+
 def socio_por_token(token):
     return _una('SELECT * FROM socios WHERE token = ?', (token,))
 
diff --git a/pulso/main.py b/pulso/main.py
index 039212d..d6dfbd0 100644
--- a/pulso/main.py
+++ b/pulso/main.py
@@ -1,12 +1,24 @@
 import os
+import sqlite3
+from typing import Literal
 
 from fastapi import APIRouter, Depends, FastAPI, Header, HTTPException
-from pydantic import AwareDatetime, BaseModel, Field
+from pydantic import AwareDatetime, BaseModel, Field, field_validator
 
 from pulso import correo, db, reloj
 
 router = APIRouter()
 
+CREDITOS_POR_PLAN = {'basico': 8, 'premium': 20}
+
+
+def email_valido(email):
+    """Sin espacios, una sola @, algo antes de la @ y un dominio con un punto que no está en los extremos."""
+    if any(c.isspace() for c in email) or email.count('@') != 1:
+        return False
+    local, dominio = email.split('@')
+    return bool(local) and '.' in dominio and not dominio.startswith('.') and not dominio.endswith('.')
+
 
 def socio_actual(authorization: str | None = Header(default=None)):
     if not authorization or not authorization.startswith('Bearer '):
@@ -92,6 +104,43 @@ def yo(socio=Depends(socio_actual)):
     return {k: socio[k] for k in ('id', 'nombre', 'email', 'plan', 'creditos')}
 
 
+class NuevoSocio(BaseModel):
+    nombre: str = Field(min_length=2, max_length=80)
+    email: str
+    plan: Literal['basico', 'premium']
+
+    @field_validator('nombre', mode='before')
+    @classmethod
+    def limpiar_nombre(cls, valor):
+        return valor.strip() if isinstance(valor, str) else valor
+
+    @field_validator('email', mode='before')
+    @classmethod
+    def limpiar_email(cls, valor):
+        return valor.strip().lower() if isinstance(valor, str) else valor
+
+    @field_validator('email')
+    @classmethod
+    def validar_email(cls, valor):
+        if not email_valido(valor):
+            raise ValueError('El email no es válido')
+        return valor
+
+
+@router.post('/socios', status_code=201)
+def registrar(datos: NuevoSocio):
+    if db.socio_por_email(datos.email) is not None:
+        raise HTTPException(409, 'Ya existe un socio con ese email')
+    try:
+        socio = db.crear_socio(datos.nombre, datos.email, datos.plan, CREDITOS_POR_PLAN[datos.plan])
+    except sqlite3.IntegrityError:
+        # Otro registro con el mismo email llegó entre la búsqueda y el insert.
+        raise HTTPException(409, 'Ya existe un socio con ese email')
+    correo.enviar(socio['email'], 'Te damos la bienvenida a Pulso',
+                  f"Hola {socio['nombre']}, ya podés reservar clases con tus {socio['creditos']} créditos.")
+    return {k: socio[k] for k in ('id', 'nombre', 'email', 'plan', 'creditos', 'token')}
+
+
 def crear_app():
     db.inicializar()
     app = FastAPI(title='Pulso')
