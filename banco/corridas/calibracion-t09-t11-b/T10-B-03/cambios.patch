+@contextmanager
+def transaccion():
+    """Transacción que toma el lock de escritura de SQLite antes de leer.
+
+    Con BEGIN IMMEDIATE, las validaciones y las escrituras de un pedido no se intercalan con
+    las de otro proceso: el segundo espera su turno y ve los cambios del primero.
+    """
+    con = sqlite3.connect(ruta(), timeout=ESPERA_BASE, isolation_level=None)
+    con.row_factory = sqlite3.Row
+    con.execute('PRAGMA foreign_keys = ON')
+    try:
+        con.execute('BEGIN IMMEDIATE')
+        yield con
+        con.execute('COMMIT')
+    except BaseException:
+        if con.in_transaction:
+            con.execute('ROLLBACK')
+        raise
+    finally:
+        con.close()
+
+
 def inicializar():
     with conexion() as con:
         con.executescript(ESQUEMA)
