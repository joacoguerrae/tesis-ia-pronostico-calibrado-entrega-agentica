+    r = cliente.post('/admin/revalidar-convenios', headers=ADMIN)
+    assert r.status_code == 200
+    assert r.json() == {'siguen': 1, 'bajaron': 2, 'sin_revisar': 1}
+    assert db.socio(ok['id'])['creditos'] == 12
+    assert db.socio(baja['id'])['plan'] == 'basico'
+    assert db.socio(baja['id'])['creditos'] == 12
+    assert db.socio(falla['id'])['plan'] == 'corporativo'
+    asuntos = [c['asunto'] for c in db.correos() if c['asunto'].startswith('Se terminó')]
+    assert len(asuntos) == 2
+    # Puede volver a activarlo.
+    servicio['respuestas']['baja%40example.com'] = (200, {'activo': True})
