+@contextmanager
+def transaccion():
+    """Una transacción que toma el lock de escritura desde el principio.
+
+    Dentro hay que usar las funciones `*_en(con, ...)` con el `con` que devuelve esto:
+    las otras conexiones no ven lo que todavía no se confirmó.
+    """
+    with conexion() as con:
+        con.execute('BEGIN IMMEDIATE')
+        yield con
