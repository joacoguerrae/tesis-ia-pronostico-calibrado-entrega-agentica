diff --git a/pulso/main.py b/pulso/main.py
index 039212d..d617733 100644
--- a/pulso/main.py
+++ b/pulso/main.py
@@ -1,12 +1,21 @@
+import csv
+import io
 import os
+import re
+from datetime import date
 
 from fastapi import APIRouter, Depends, FastAPI, Header, HTTPException
+from fastapi.responses import Response
 from pydantic import AwareDatetime, BaseModel, Field
 
 from pulso import correo, db, reloj
 
 router = APIRouter()
 
+FECHA_RE = re.compile(r'\d{4}-\d{2}-\d{2}')
+DIAS_MAXIMOS_EXPORTACION = 31
+CABECERA_OCUPACION = ['fecha', 'hora', 'clase', 'instructor', 'cupo', 'confirmadas', 'ocupacion_pct']
+
 
 def socio_actual(authorization: str | None = Header(default=None)):
     if not authorization or not authorization.startswith('Bearer '):
@@ -92,6 +101,43 @@ def yo(socio=Depends(socio_actual)):
     return {k: socio[k] for k in ('id', 'nombre', 'email', 'plan', 'creditos')}
 
 
+def fecha_de_consulta(valor, nombre):
+    if not valor or not FECHA_RE.fullmatch(valor):
+        raise HTTPException(422, f'{nombre} tiene que tener formato YYYY-MM-DD')
+    try:
+        return date.fromisoformat(valor)
+    except ValueError:
+        raise HTTPException(422, f'{nombre} no es una fecha válida')
+
+
+def porcentaje_ocupacion(confirmadas, cupo):
+    # Entero más cercano, con los ,5 hacia arriba. Con enteros evitamos errores de punto flotante.
+    return (200 * confirmadas + cupo) // (2 * cupo)
+
+
+@router.get('/admin/ocupacion.csv', dependencies=[Depends(admin)])
+def exportar_ocupacion(desde: str | None = None, hasta: str | None = None):
+    desde_dia = fecha_de_consulta(desde, 'desde')
+    hasta_dia = fecha_de_consulta(hasta, 'hasta')
+    if desde_dia > hasta_dia:
+        raise HTTPException(422, 'desde no puede ser posterior a hasta')
+    if (hasta_dia - desde_dia).days + 1 > DIAS_MAXIMOS_EXPORTACION:
+        raise HTTPException(422, f'El período no puede tener más de {DIAS_MAXIMOS_EXPORTACION} días')
+
+    filas = [CABECERA_OCUPACION]
+    for clase in db.clases():
+        local = db.a_fecha(clase['inicio']).astimezone(reloj.MONTEVIDEO)
+        if not desde_dia <= local.date() <= hasta_dia:
+            continue
+        confirmadas = db.confirmadas(clase['id'])
+        filas.append([f'{local:%Y-%m-%d}', f'{local:%H:%M}', clase['nombre'], clase['instructor'],
+                      clase['cupo'], confirmadas, porcentaje_ocupacion(confirmadas, clase['cupo'])])
+
+    salida = io.StringIO()
+    csv.writer(salida).writerows(filas)
+    return Response(salida.getvalue(), media_type='text/csv; charset=utf-8')
+
+
 def crear_app():
     db.inicializar()
     app = FastAPI(title='Pulso')
