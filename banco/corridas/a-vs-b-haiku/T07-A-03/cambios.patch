+from datetime import timedelta
+
+import httpx
+import pytest
+
+from conftest import ADMIN, AHORA, auth
+from pulso import cobra, db, reloj
+
+
+class FalsaCobra:
+    """Simula Cobrá reemplazando httpx.request."""
+
+    def __init__(self):
+        self.pagos = {}
+        self.pedidos = []
+        self.falla = False
+        self.falla_creacion_pero_crea = False
+
+    def __call__(self, metodo, url, headers=None, json=None, params=None, timeout=None):
+        self.pedidos.append((metodo, url, headers, json))
+        assert url.startswith('https://api.cobra.uy/v1')
+        assert headers['X-Cobra-Clave'] == 'clave-cobra'
+        assert timeout == 5.0
+        ruta = url.removeprefix('https://api.cobra.uy/v1')
+        if self.falla:
+            raise httpx.ConnectError('caído')
+        if metodo == 'POST' and ruta == '/pagos':
+            ref = headers['Idempotency-Key']
+            existente = next((p for p in self.pagos.values() if p['referencia'] == ref), None)
+            codigo = 200
+            if existente is None:
+                codigo = 201
+                existente = {'id': f'pag_{len(self.pagos) + 1}', 'estado': 'pendiente', 'monto': json['monto'],
+                             'moneda': json['moneda'], 'referencia': ref,
+                             'url_pago': f'https://pagar.cobra.uy/pag_{len(self.pagos) + 1}'}
+                self.pagos[existente['id']] = existente
+            if self.falla_creacion_pero_crea:
+                return httpx.Response(500)
+            return httpx.Response(codigo, json=existente)
+        if metodo == 'GET' and ruta == '/pagos':
+            return httpx.Response(200, json={'pagos': [p for p in self.pagos.values()
+                                                       if p['referencia'] == params['referencia']]})
+        if metodo == 'GET' and ruta.startswith('/pagos/'):
+            p = self.pagos.get(ruta.removeprefix('/pagos/'))
+            return httpx.Response(200, json=p) if p else httpx.Response(404)
+        return httpx.Response(500)
+
+
+@pytest.fixture
+def falsa(monkeypatch):
+    f = FalsaCobra()
+    monkeypatch.setenv('PULSO_PAGOS_URL', 'https://api.cobra.uy/v1')
+    monkeypatch.setenv('PULSO_PAGOS_CLAVE', 'clave-cobra')
+    monkeypatch.setattr(cobra.httpx, 'request', f)
+    return f
+
+
+def comprar(cliente, socio, pack='pack-4'):
+    return cliente.post('/compras', json={'pack': pack}, headers=auth(socio))
+
+
+def creditos(cliente, socio):
+    return cliente.get('/yo', headers=auth(socio)).json()['creditos']
+
+
+def test_compra_crea_pago(cliente, socio, falsa):
+    r = comprar(cliente, socio)
+    assert r.status_code == 201
+    assert r.json() == {'id': 1, 'pack': 'pack-4', 'creditos': 4, 'monto': 1200, 'estado': 'pendiente',
+                        'creada': '2026-11-10T15:00:00+00:00', 'url_pago': 'https://pagar.cobra.uy/pag_1'}
+    _, _, headers, cuerpo = falsa.pedidos[0]
+    assert headers['Idempotency-Key'] == 'pulso-compra-1'
+    assert cuerpo == {'monto': 1200, 'moneda': 'UYU', 'referencia': 'pulso-compra-1'}
+    assert creditos(cliente, socio) == 8
+
+
+@pytest.mark.parametrize('cuerpo', [{}, {'pack': 'pack-99'}, {'pack': None}, {'pack': 4}])
+def test_pack_invalido(cliente, socio, falsa, cuerpo):
+    assert cliente.post('/compras', json=cuerpo, headers=auth(socio)).status_code == 422
+    assert db.compras_pendientes() == [] and falsa.pedidos == []
+
+
+def test_compra_requiere_token(cliente, falsa):
+    assert cliente.post('/compras', json={'pack': 'pack-4'}).status_code == 401
+
+
+def test_falla_cobra_deja_compra_pendiente_sin_pago(cliente, socio, falsa):
+    falsa.falla = True
+    assert comprar(cliente, socio).status_code == 502
+    lista = cliente.get('/compras', headers=auth(socio)).json()
+    assert len(lista) == 1 and lista[0]['estado'] == 'pendiente' and lista[0]['url_pago'] is None
+
+
+def test_webhook_aprueba_una_sola_vez(cliente, socio, falsa):
+    comprar(cliente, socio, 'pack-8')
+    falsa.pagos['pag_1']['estado'] = 'aprobado'
+    for _ in range(3):
+        r = cliente.post('/webhooks/pagos', json={'pago_id': 'pag_1', 'estado': 'rechazado'})
+        assert r.json() == {'compra_id': 1, 'estado': 'aprobada'}
+    assert creditos(cliente, socio) == 16
+    correos = [c for c in db.correos() if c['asunto'] == 'Compra de créditos aprobada']
+    assert len(correos) == 1 and correos[0]['para'] == 'ana@example.com'
+
+
+def test_webhook_rechazado_y_pendiente(cliente, socio, falsa):
+    comprar(cliente, socio)
+    comprar(cliente, socio)
+    assert cliente.post('/webhooks/pagos', json={'pago_id': 'pag_1'}).json()['estado'] == 'pendiente'
+    falsa.pagos['pag_1']['estado'] = 'rechazado'
+    assert cliente.post('/webhooks/pagos', json={'pago_id': 'pag_1'}).json()['estado'] == 'rechazada'
+    falsa.pagos['pag_1']['estado'] = 'aprobado'
+    assert cliente.post('/webhooks/pagos', json={'pago_id': 'pag_1'}).json()['estado'] == 'rechazada'
+    assert creditos(cliente, socio) == 8 and db.correos() == []
+
+
+def test_webhook_errores(cliente, socio, falsa):
+    assert cliente.post('/webhooks/pagos', json={}).status_code == 422
+    assert cliente.post('/webhooks/pagos', json={'pago_id': 'nada'}).status_code == 404
+    falsa.pagos['x'] = {'id': 'x', 'estado': 'aprobado', 'referencia': 'otra-cosa'}
+    assert cliente.post('/webhooks/pagos', json={'pago_id': 'x'}).status_code == 404
+    falsa.pagos['y'] = {'id': 'y', 'estado': 'aprobado', 'referencia': 'pulso-compra-99'}
+    assert cliente.post('/webhooks/pagos', json={'pago_id': 'y'}).status_code == 404
+    falsa.falla = True
+    assert cliente.post('/webhooks/pagos', json={'pago_id': 'x'}).status_code == 503
+
+
+def test_webhook_guarda_pago_en_compra_sin_pago(cliente, socio, falsa):
+    falsa.falla_creacion_pero_crea = True
+    assert comprar(cliente, socio).status_code == 502
+    falsa.falla_creacion_pero_crea = False
+    falsa.pagos['pag_1']['estado'] = 'aprobado'
+    r = cliente.post('/webhooks/pagos', json={'pago_id': 'pag_1'})
+    assert r.json() == {'compra_id': 1, 'estado': 'aprobada'}
+    assert db.compra(1)['pago_id'] == 'pag_1'
+    assert db.compra(1)['url_pago'] == 'https://pagar.cobra.uy/pag_1'
+    assert len(falsa.pagos) == 1
+
+
+def test_conciliar_requiere_admin(cliente, falsa):
+    assert cliente.post('/admin/conciliar-pagos').status_code == 401
+    assert cliente.post('/admin/conciliar-pagos', headers={'X-Admin-Key': 'x'}).status_code == 401
+
+
+def test_conciliar_resume(cliente, socio, falsa):
+    otro = db.crear_socio('Beto', 'beto@example.com')
+    comprar(cliente, socio)            # 1: aprobada
+    comprar(cliente, otro)             # 2: rechazada
+    comprar(cliente, socio)            # 3: pendiente
+    falsa.pagos['pag_1']['estado'] = 'aprobado'
+    falsa.pagos['pag_2']['estado'] = 'rechazado'
+    ya = db.crear_compra(socio['id'], 'pack-4', 4, 1200, AHORA)
+    db.cerrar_compra(ya['id'], 'aprobada')
+    r = cliente.post('/admin/conciliar-pagos', headers=ADMIN)
+    assert r.json() == {'aprobadas': 1, 'rechazadas': 1, 'pendientes': 1}
+    assert db.compra(1)['estado'] == 'aprobada' and db.compra(2)['estado'] == 'rechazada'
+    again = cliente.post('/admin/conciliar-pagos', headers=ADMIN).json()
+    assert again['aprobadas'] == 0 and again['rechazadas'] == 0
+    assert creditos(cliente, socio) == 8 + 4 + 4  # compra 1 (conciliada) y 'ya' (cerrada a mano)
+
+
+def test_conciliar_sin_pago(cliente, socio, falsa):
+    falsa.falla_creacion_pero_crea = True
+    comprar(cliente, socio)                 # 1: el pago existe en Cobrá
+    falsa.pagos.clear()
+    comprar(cliente, socio)                 # 2: el pago nunca se creó
+    falsa.falla_creacion_pero_crea = False
+    falsa.pagos.clear()
+    falsa.pagos['pag_9'] = {'id': 'pag_9', 'estado': 'aprobado', 'monto': 1200, 'moneda': 'UYU',
+                            'referencia': 'pulso-compra-1', 'url_pago': 'u'}
+    reloj.fijar(AHORA + timedelta(minutes=29))
+    r = cliente.post('/admin/conciliar-pagos', headers=ADMIN).json()
+    assert r == {'aprobadas': 1, 'rechazadas': 0, 'pendientes': 1}
+    assert db.compra(1)['pago_id'] == 'pag_9'
+    reloj.fijar(AHORA + timedelta(minutes=30))
+    r = cliente.post('/admin/conciliar-pagos', headers=ADMIN).json()
+    assert r == {'aprobadas': 0, 'rechazadas': 1, 'pendientes': 0}
+
+
+def test_conciliar_con_falla_no_rechaza(cliente, socio, falsa):
+    falsa.falla_creacion_pero_crea = True
+    comprar(cliente, socio)
+    falsa.falla_creacion_pero_crea = False
+    falsa.falla = True
+    reloj.fijar(AHORA + timedelta(hours=2))
+    r = cliente.post('/admin/conciliar-pagos', headers=ADMIN).json()
+    assert r == {'aprobadas': 0, 'rechazadas': 0, 'pendientes': 1}
+    assert db.compra(1)['estado'] == 'pendiente'
+
+
+def test_listado_orden_y_aislamiento(cliente, socio, falsa):
+    otro = db.crear_socio('Beto', 'beto@example.com')
+    comprar(cliente, socio)
+    reloj.fijar(AHORA + timedelta(minutes=1))
+    comprar(cliente, otro)
+    comprar(cliente, socio, 'pack-8')
+    assert [c['id'] for c in cliente.get('/compras', headers=auth(socio)).json()] == [3, 1]
+    n = len(falsa.pedidos)
+    cliente.get('/compras', headers=auth(socio))
+    assert len(falsa.pedidos) == n
