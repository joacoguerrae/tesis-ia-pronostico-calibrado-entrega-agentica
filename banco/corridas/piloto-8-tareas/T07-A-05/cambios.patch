     return {k: socio[k] for k in ('id', 'nombre', 'email', 'plan', 'creditos')}
 
 
+PACKS = {'pack-4': (4, 1200), 'pack-8': (8, 2200)}
+ESTADOS_PAGO = {'aprobado': 'aprobada', 'rechazado': 'rechazada'}
+
+
+def ver_compra(c):
+    return {k: c[k] for k in ('id', 'pack', 'creditos', 'monto', 'estado', 'creada', 'url_pago')}
+
+
+class NuevaCompra(BaseModel):
+    pack: str
+
+
+@router.post('/compras', status_code=201)
+def comprar(datos: NuevaCompra, socio=Depends(socio_actual)):
+    if datos.pack not in PACKS:
+        raise HTTPException(422, 'Pack inválido')
+    creditos, monto = PACKS[datos.pack]
+    c = db.crear_compra(socio['id'], datos.pack, creditos, monto, reloj.ahora())
+    try:
+        pago = cobra.crear_pago(monto, f"pulso-compra-{c['id']}")
+    except cobra.CobraError:
+        raise HTTPException(502, 'No se pudo crear el pago')
+    db.guardar_pago(c['id'], pago['id'], pago.get('url_pago'))
+    return ver_compra(db.compra(c['id']))
+
+
+@router.get('/compras')
+def mis_compras(socio=Depends(socio_actual)):
+    return [ver_compra(c) for c in db.compras_de(socio['id'])]
+
+
+def aplicar_pago(compra, pago):
+    """Aplica el estado de un pago de Cobrá a la compra. Devuelve la compra actualizada."""
+    db.guardar_pago(compra['id'], pago['id'], pago.get('url_pago'))
+    nuevo = ESTADOS_PAGO.get(pago['estado'])
+    if nuevo and db.resolver_compra(compra['id'], nuevo) and nuevo == 'aprobada':
+        socio = db.socio(compra['socio_id'])
+        correo.enviar(socio['email'], 'Compra de créditos aprobada',
+                      f"Hola {socio['nombre']}, se acreditaron {compra['creditos']} créditos de tu compra.")
+    return db.compra(compra['id'])
+
+
+def compra_de_referencia(referencia):
+    m = re.fullmatch(r'pulso-compra-([1-9][0-9]{0,17})', referencia)
+    return db.compra(int(m.group(1))) if m else None
+
+
+class AvisoPago(BaseModel):
+    pago_id: str = Field(min_length=1)
+
+
+@router.post('/webhooks/pagos')
+def webhook_pagos(datos: AvisoPago):
+    try:
+        pago = cobra.obtener_pago(datos.pago_id)
+    except cobra.CobraError:
+        raise HTTPException(503, 'Cobrá no responde')
+    if pago is None:
+        raise HTTPException(404, 'Pago desconocido')
+    compra = compra_de_referencia(pago['referencia'])
+    if compra is None:
+        raise HTTPException(404, 'El pago no es de ninguna compra')
+    compra = aplicar_pago(compra, pago)
+    return {'compra_id': compra['id'], 'estado': compra['estado']}
+
+
+@router.post('/admin/conciliar-pagos', dependencies=[Depends(admin)])
+def conciliar_pagos():
+    pendientes = db.compras_pendientes()
+    for c in pendientes:
+        try:
+            if c['pago_id']:
+                pago = cobra.obtener_pago(c['pago_id'])
+            else:
+                pago = cobra.buscar_pago(f"pulso-compra-{c['id']}")
+                if pago is None:
+                    if reloj.ahora() - db.a_fecha(c['creada']) >= timedelta(minutes=30):
+                        db.resolver_compra(c['id'], 'rechazada')
+                    continue
+        except cobra.CobraError:
+            continue
+        if pago is not None:
+            aplicar_pago(c, pago)
+    cuenta = {'aprobada': 0, 'rechazada': 0, 'pendiente': 0}
+    for c in pendientes:
+        cuenta[db.compra(c['id'])['estado']] += 1
+    return {'aprobadas': cuenta['aprobada'], 'rechazadas': cuenta['rechazada'], 'pendientes': cuenta['pendiente']}
+
