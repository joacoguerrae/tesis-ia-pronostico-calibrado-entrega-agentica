+    instructor: str = Field(min_length=1)
+    dia: Literal['lunes', 'martes', 'miércoles', 'jueves', 'viernes', 'sábado', 'domingo']
+    hora: str = Field(pattern=HORA_RE)
+    duracion_min: int = Field(ge=1)
