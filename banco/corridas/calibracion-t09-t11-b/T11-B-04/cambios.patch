+        cambios.append({'id': clase['id'], 'inicio': nuevo_inicio,
+                        'instructor': datos.instructor, 'cupo': datos.cupo})
+
+    db.cambiar_serie(serie_id, datos.hora, datos.instructor, datos.cupo, cambios)
+    for clase, nuevo_inicio in movidas:
+        cuando = correo.fecha_y_hora(nuevo_inicio)
+        for socio in db.socios_confirmados(clase['id']):
+            correo.enviar(socio['email'], f"Cambio de horario: {clase['nombre']} el {cuando}",
+                          f"Hola {socio['nombre']}, {clase['nombre']} cambió de horario: ahora es el {cuando}.")
+    return ver_serie(db.serie(serie_id), db.clases_de_serie(serie_id))
+
