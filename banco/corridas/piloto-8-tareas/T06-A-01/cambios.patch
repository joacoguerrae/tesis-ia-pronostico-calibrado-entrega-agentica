 def enviar(para, asunto, cuerpo):
     with db.conexion() as con:
+        enviar_en(con, para, asunto, cuerpo)
+
+
+def enviar_en(con, para, asunto, cuerpo):
+    """Guarda el correo dentro de una transacción ya abierta."""
+    if True:
         con.execute('INSERT INTO correos (para, asunto, cuerpo, creado) VALUES (?, ?, ?, ?)',
                     (para, asunto, cuerpo, db.a_texto(reloj.ahora())))
 
diff --git a/pulso/db.py b/pulso/db.py
index 59841ac..0b0fe0b 100644
--- a/pulso/db.py
+++ b/pulso/db.py
@@ -29,6 +29,12 @@ CREATE TABLE IF NOT EXISTS reservas (
     estado TEXT NOT NULL,
     creada TEXT NOT NULL
 );
+CREATE TABLE IF NOT EXISTS espera (
+    id INTEGER PRIMARY KEY AUTOINCREMENT,
+    socio_id INTEGER NOT NULL REFERENCES socios(id),
+    clase_id INTEGER NOT NULL REFERENCES clases(id),
+    UNIQUE (socio_id, clase_id)
+);
 CREATE TABLE IF NOT EXISTS correos (
     id INTEGER PRIMARY KEY,
     para TEXT NOT NULL,
@@ -136,3 +142,35 @@ def sumar_creditos(socio_id, cantidad):
 
 def correos():
     return _varias('SELECT * FROM correos ORDER BY id')
+
+
+@contextmanager
+def transaccion():
+    """Conexión con una transacción de escritura exclusiva: todo o nada."""
+    con = sqlite3.connect(ruta(), isolation_level=None, timeout=30)
+    con.row_factory = sqlite3.Row
+    con.execute('PRAGMA foreign_keys = ON')
+    con.execute('BEGIN IMMEDIATE')
+    try:
+        yield con
+        con.execute('COMMIT')
+    except BaseException:
+        con.execute('ROLLBACK')
+        raise
+    finally:
+        con.close()
+
+
+def uno(con, sql, parametros=()):
+    fila = con.execute(sql, parametros).fetchone()
+    return dict(fila) if fila else None
+
+
+def posicion_espera_existe(socio_id, clase_id):
+    return _una('SELECT id FROM espera WHERE socio_id = ? AND clase_id = ?', (socio_id, clase_id)) is not None
+
+
+def posicion_espera(socio_id, clase_id):
+    return _una('SELECT COUNT(*) AS n FROM espera WHERE clase_id = ? AND id <= '
+                '(SELECT id FROM espera WHERE socio_id = ? AND clase_id = ?)',
+                (clase_id, socio_id, clase_id))['n']
diff --git a/pulso/main.py b/pulso/main.py
index 039212d..f0a0848 100644
--- a/pulso/main.py
+++ b/pulso/main.py
@@ -1,7 +1,7 @@
 import os
 
 from fastapi import APIRouter, Depends, FastAPI, Header, HTTPException
-from pydantic import AwareDatetime, BaseModel, Field
+from pydantic import AwareDatetime, BaseModel, Field, StrictInt
 
 from pulso import correo, db, reloj
 
@@ -87,6 +87,111 @@ def mis_reservas(socio=Depends(socio_actual)):
     return [ver_reserva(r) for r in db.reservas_de(socio['id'])]
 
 
+def asignar_lugares(con, clase_id):
+    """Pasa los lugares libres de la clase a la lista de espera. Corre dentro de una transacción."""
+    clase = db.uno(con, 'SELECT * FROM clases WHERE id = ?', (clase_id,))
+    inicio = db.a_fecha(clase['inicio'])
+    if reloj.ahora() >= inicio:
+        return
+    cuando = correo.fecha_y_hora(inicio)
+    while True:
+        confirmadas = db.uno(con, "SELECT COUNT(*) AS n FROM reservas WHERE clase_id = ? AND estado = 'confirmada'",
+                             (clase_id,))['n']
+        if confirmadas >= clase['cupo']:
+            return
+        primero = db.uno(con, 'SELECT * FROM espera WHERE clase_id = ? ORDER BY id LIMIT 1', (clase_id,))
+        if primero is None:
+            return
+        con.execute('DELETE FROM espera WHERE id = ?', (primero['id'],))
+        socio = db.uno(con, 'SELECT * FROM socios WHERE id = ?', (primero['socio_id'],))
+        if db.uno(con, "SELECT id FROM reservas WHERE socio_id = ? AND clase_id = ? AND estado = 'confirmada'",
+                  (socio['id'], clase_id)):
+            continue
+        if socio['creditos'] < 1:
+            correo.enviar_en(con, socio['email'], f"No pudimos darte el lugar: {clase['nombre']} el {cuando}",
+                             f"Hola {socio['nombre']}, no tenías créditos cuando se liberó un lugar en {clase['nombre']}.")
+            continue
+        con.execute("INSERT INTO reservas (socio_id, clase_id, estado, creada) VALUES (?, ?, 'confirmada', ?)",
+                    (socio['id'], clase_id, db.a_texto(reloj.ahora())))
+        con.execute('UPDATE socios SET creditos = creditos - 1 WHERE id = ?', (socio['id'],))
+        correo.enviar_en(con, socio['email'], f"Se liberó un lugar: {clase['nombre']} el {cuando}",
+                         f"Hola {socio['nombre']}, se liberó un lugar en {clase['nombre']} y es tuyo.")
+
+
+@router.post('/admin/reservas/{reserva_id}/cancelar', dependencies=[Depends(admin)])
+def cancelar_reserva(reserva_id: int):
+    with db.transaccion() as con:
+        reserva = db.uno(con, 'SELECT * FROM reservas WHERE id = ?', (reserva_id,))
+        if reserva is None:
+            raise HTTPException(404, 'No existe la reserva')
+        if reserva['estado'] == 'cancelada':
+            raise HTTPException(409, 'La reserva ya estaba cancelada')
+        con.execute("UPDATE reservas SET estado = 'cancelada' WHERE id = ?", (reserva_id,))
+        con.execute('UPDATE socios SET creditos = creditos + 1 WHERE id = ?', (reserva['socio_id'],))
+        asignar_lugares(con, reserva['clase_id'])
+    return ver_reserva(db.reserva(reserva_id))
+
+
+class CambioClase(BaseModel):
+    cupo: StrictInt = Field(gt=0)
+
+
+@router.patch('/admin/clases/{clase_id}', dependencies=[Depends(admin)])
+def cambiar_clase(clase_id: int, datos: CambioClase):
+    with db.transaccion() as con:
+        clase = db.uno(con, 'SELECT * FROM clases WHERE id = ?', (clase_id,))
+        if clase is None:
+            raise HTTPException(404, 'No existe la clase')
+        confirmadas = db.uno(con, "SELECT COUNT(*) AS n FROM reservas WHERE clase_id = ? AND estado = 'confirmada'",
+                             (clase_id,))['n']
+        if datos.cupo < confirmadas:
+            raise HTTPException(409, 'El cupo no puede ser menor a las reservas confirmadas')
+        con.execute('UPDATE clases SET cupo = ? WHERE id = ?', (datos.cupo, clase_id))
+        asignar_lugares(con, clase_id)
+    return ver_clase(db.clase(clase_id))
+
+
+@router.post('/clases/{clase_id}/espera', status_code=201)
+def anotarse_espera(clase_id: int, socio=Depends(socio_actual)):
+    with db.transaccion() as con:
+        clase = db.uno(con, 'SELECT * FROM clases WHERE id = ?', (clase_id,))
+        if clase is None:
+            raise HTTPException(404, 'No existe la clase')
+        if db.a_fecha(clase['inicio']) <= reloj.ahora():
+            raise HTTPException(409, 'La clase ya empezó')
+        confirmadas = db.uno(con, "SELECT COUNT(*) AS n FROM reservas WHERE clase_id = ? AND estado = 'confirmada'",
+                             (clase_id,))['n']
+        if confirmadas < clase['cupo']:
+            raise HTTPException(409, 'La clase tiene lugar, reservá directo')
+        if db.uno(con, "SELECT id FROM reservas WHERE socio_id = ? AND clase_id = ? AND estado = 'confirmada'",
+                  (socio['id'], clase_id)):
+            raise HTTPException(409, 'Ya tenés una reserva para esta clase')
+        if db.uno(con, 'SELECT id FROM espera WHERE socio_id = ? AND clase_id = ?', (socio['id'], clase_id)):
+            raise HTTPException(409, 'Ya estás en la lista de espera')
+        if db.uno(con, 'SELECT creditos FROM socios WHERE id = ?', (socio['id'],))['creditos'] < 1:
+            raise HTTPException(409, 'No te quedan créditos')
+        con.execute('INSERT INTO espera (socio_id, clase_id) VALUES (?, ?)', (socio['id'], clase_id))
+    return {'clase_id': clase_id, 'posicion': db.posicion_espera(socio['id'], clase_id)}
+
+
+@router.get('/clases/{clase_id}/espera')
+def ver_espera(clase_id: int, socio=Depends(socio_actual)):
+    if db.clase(clase_id) is None:
+        raise HTTPException(404, 'No existe la clase')
+    if not db.posicion_espera_existe(socio['id'], clase_id):
+        raise HTTPException(404, 'No estás en la lista de espera')
+    return {'clase_id': clase_id, 'posicion': db.posicion_espera(socio['id'], clase_id)}
+
+
+@router.delete('/clases/{clase_id}/espera', status_code=204)
+def bajarse_espera(clase_id: int, socio=Depends(socio_actual)):
+    if db.clase(clase_id) is None:
+        raise HTTPException(404, 'No existe la clase')
+    with db.transaccion() as con:
+        if con.execute('DELETE FROM espera WHERE socio_id = ? AND clase_id = ?', (socio['id'], clase_id)).rowcount == 0:
+            raise HTTPException(404, 'No estás en la lista de espera')
+
+
 @router.get('/yo')
 def yo(socio=Depends(socio_actual)):
     return {k: socio[k] for k in ('id', 'nombre', 'email', 'plan', 'creditos')}
