--- a/pulso/main.py
+++ b/pulso/main.py
@@ -1,6 +1,8 @@
 import os
+import re
+from datetime import date
 
-from fastapi import APIRouter, Depends, FastAPI, Header, HTTPException
+from fastapi import APIRouter, Depends, FastAPI, Header, HTTPException, Query, Response
 from pydantic import AwareDatetime, BaseModel, Field
 
 from pulso import correo, db, reloj
@@ -30,10 +32,53 @@ def ver_reserva(reserva):
     return {k: reserva[k] for k in ('id', 'clase_id', 'estado', 'creada')}
 
 
+def fecha_de_filtro(valor, nombre):
+    if valor is None:
+        return None
+    try:
+        if not re.fullmatch(r'\d{4}-\d{2}-\d{2}', valor):
+            raise ValueError
+        return date.fromisoformat(valor)
+    except ValueError:
+        raise HTTPException(422, f'{nombre} debe tener formato YYYY-MM-DD')
+
+
 @router.get('/clases')
-def listar_clases():
+def listar_clases(
+    response: Response,
+    desde: str | None = None,
+    hasta: str | None = None,
+    instructor: str | None = None,
+    con_lugar: bool = False,
+    pagina: int = Query(default=1, ge=1),
+    por_pagina: int = Query(default=20, ge=1, le=50),
+):
+    desde_dia = fecha_de_filtro(desde, 'desde')
+    hasta_dia = fecha_de_filtro(hasta, 'hasta')
+    if desde_dia and hasta_dia and desde_dia > hasta_dia:
+        raise HTTPException(422, 'desde no puede ser posterior a hasta')
     ahora = reloj.ahora()
-    return [ver_clase(c) for c in db.clases() if db.a_fecha(c['inicio']) > ahora]
+    nombre = instructor.casefold() if instructor is not None else None
+
+    encontradas = []
+    for clase in db.clases():
+        inicio = db.a_fecha(clase['inicio'])
+        if inicio <= ahora:
+            continue
+        dia = inicio.astimezone(reloj.MONTEVIDEO).date()
+        if desde_dia and dia < desde_dia:
+            continue
+        if hasta_dia and dia > hasta_dia:
+            continue
+        if nombre is not None and clase['instructor'].casefold() != nombre:
+            continue
+        if con_lugar and db.confirmadas(clase['id']) >= clase['cupo']:
+            continue
+        encontradas.append(clase)
+
+    response.headers['X-Total'] = str(len(encontradas))
+    desde_pos = (pagina - 1) * por_pagina
+    return [ver_clase(c) for c in encontradas[desde_pos:desde_pos + por_pagina]]
 
 
 @router.get('/clases/{clase_id}')
