diff --git a/tests/test_recordatorios.py b/tests/test_recordatorios.py
new file mode 100644
index 0000000..b14a557
--- /dev/null
+++ b/tests/test_recordatorios.py
@@ -0,0 +1,76 @@
+from datetime import timedelta
+
+from conftest import ADMIN, AHORA, auth
+from pulso import db, reloj
+
+
+def recordatorios(cliente, headers=ADMIN):
+    return cliente.post('/admin/recordatorios', headers=headers)
+
+
+def de_recordatorio():
+    return [c for c in db.correos() if c['asunto'].startswith('Recordatorio: ')]
+
+
+def test_requiere_clave_de_administracion(cliente):
+    assert cliente.post('/admin/recordatorios').status_code == 401
+    assert cliente.post('/admin/recordatorios', headers={'X-Admin-Key': 'otra'}).status_code == 401
+
+
+def test_manda_recordatorio_a_reserva_confirmada_en_las_proximas_24h(cliente, socio):
+    clase = db.crear_clase('Yoga', 'Sofía', AHORA + timedelta(hours=23, minutes=30))
+    db.crear_reserva(socio['id'], clase['id'], AHORA)
+    r = recordatorios(cliente)
+    assert r.status_code == 200
+    assert r.json() == {'enviados': 1}
+    [correo] = de_recordatorio()
+    assert correo['para'] == 'ana@example.com'
+    assert correo['asunto'] == 'Recordatorio: Yoga el 11/11 a las 11:30'
+    assert 'Sofía' in correo['cuerpo']
+
+
+def test_incluye_clase_justo_a_las_24h_y_excluye_la_que_empieza_despues(cliente, socio):
+    en_24h = db.crear_clase('Yoga', 'Sofía', AHORA + timedelta(hours=24))
+    despues = db.crear_clase('Spinning', 'Leo', AHORA + timedelta(hours=24, seconds=1))
+    db.crear_reserva(socio['id'], en_24h['id'], AHORA)
+    db.crear_reserva(socio['id'], despues['id'], AHORA)
+    assert recordatorios(cliente).json() == {'enviados': 1}
+    assert [c['asunto'].split(' el ')[0] for c in de_recordatorio()] == ['Recordatorio: Yoga']
+
+
+def test_no_manda_a_clases_que_ya_empezaron(cliente, socio):
+    clase = db.crear_clase('Yoga', 'Sofía', AHORA)
+    db.crear_reserva(socio['id'], clase['id'], AHORA - timedelta(hours=2))
+    assert recordatorios(cliente).json() == {'enviados': 0}
+
+
+def test_no_manda_a_reservas_no_confirmadas(cliente, socio):
+    clase = db.crear_clase('Yoga', 'Sofía', AHORA + timedelta(hours=3))
+    db.crear_reserva(socio['id'], clase['id'], AHORA, estado='cancelada')
+    assert recordatorios(cliente).json() == {'enviados': 0}
+    assert de_recordatorio() == []
+
+
+def test_cada_reserva_recibe_un_solo_recordatorio(cliente, socio):
+    clase = db.crear_clase('Yoga', 'Sofía', AHORA + timedelta(hours=5))
+    db.crear_reserva(socio['id'], clase['id'], AHORA)
+    assert recordatorios(cliente).json() == {'enviados': 1}
+    assert recordatorios(cliente).json() == {'enviados': 0}
+    assert recordatorios(cliente).json() == {'enviados': 0}
+    assert len(de_recordatorio()) == 1
+
+
+def test_reserva_hecha_con_menos_de_24h_recibe_un_recordatorio(cliente, socio):
+    clase = db.crear_clase('Yoga', 'Sofía', AHORA + timedelta(hours=2))
+    assert cliente.post('/reservas', json={'clase_id': clase['id']}, headers=auth(socio)).status_code == 201
+    assert recordatorios(cliente).json() == {'enviados': 1}
+    assert recordatorios(cliente).json() == {'enviados': 0}
+    assert len(de_recordatorio()) == 1
+
+
+def test_reserva_lejana_recibe_recordatorio_cuando_entra_en_la_ventana(cliente, socio):
+    clase = db.crear_clase('Yoga', 'Sofía', AHORA + timedelta(hours=30))
+    db.crear_reserva(socio['id'], clase['id'], AHORA)
+    assert recordatorios(cliente).json() == {'enviados': 0}
+    reloj.fijar(AHORA + timedelta(hours=6, minutes=15))
+    assert recordatorios(cliente).json() == {'enviados': 1}
