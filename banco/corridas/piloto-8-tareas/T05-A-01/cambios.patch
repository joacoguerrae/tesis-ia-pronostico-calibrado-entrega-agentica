diff --git a/pulso/db.py b/pulso/db.py
index 59841ac..42ace1c 100644
--- a/pulso/db.py
+++ b/pulso/db.py
@@ -58,6 +58,9 @@ def conexion():
 def inicializar():
     with conexion() as con:
         con.executescript(ESQUEMA)
+        columnas = [f['name'] for f in con.execute('PRAGMA table_info(reservas)')]
+        if 'recordatorio' not in columnas:
+            con.execute('ALTER TABLE reservas ADD COLUMN recordatorio TEXT')
 
 
 def a_texto(momento):
@@ -134,5 +137,22 @@ def sumar_creditos(socio_id, cantidad):
         con.execute('UPDATE socios SET creditos = creditos + ? WHERE id = ?', (cantidad, socio_id))
 
 
+def reservas_a_recordar(desde, hasta):
+    """Reservas confirmadas sin recordatorio cuya clase empieza en (desde, hasta]."""
+    return _varias("SELECT r.id, s.email, s.nombre AS socio, c.nombre AS clase, c.instructor, c.inicio "
+                   "FROM reservas r JOIN clases c ON c.id = r.clase_id JOIN socios s ON s.id = r.socio_id "
+                   "WHERE r.estado = 'confirmada' AND r.recordatorio IS NULL "
+                   "AND c.inicio > ? AND c.inicio <= ? ORDER BY c.inicio, r.id",
+                   (a_texto(desde), a_texto(hasta)))
+
+
+def marcar_recordatorio(reserva_id, momento):
+    """Marca el recordatorio como enviado. Devuelve False si ya estaba marcado."""
+    with conexion() as con:
+        cur = con.execute('UPDATE reservas SET recordatorio = ? WHERE id = ? AND recordatorio IS NULL',
+                          (a_texto(momento), reserva_id))
+    return cur.rowcount == 1
+
+
 def correos():
     return _varias('SELECT * FROM correos ORDER BY id')
diff --git a/pulso/main.py b/pulso/main.py
index 039212d..8ed20c2 100644
--- a/pulso/main.py
+++ b/pulso/main.py
@@ -1,4 +1,5 @@
 import os
+from datetime import timedelta
 
 from fastapi import APIRouter, Depends, FastAPI, Header, HTTPException
 from pydantic import AwareDatetime, BaseModel, Field
@@ -82,6 +83,19 @@ def reservar(datos: NuevaReserva, socio=Depends(socio_actual)):
     return ver_reserva(reserva)
 
 
+@router.post('/admin/recordatorios', dependencies=[Depends(admin)])
+def enviar_recordatorios():
+    ahora = reloj.ahora()
+    enviados = 0
+    for r in db.reservas_a_recordar(ahora, ahora + timedelta(hours=24)):
+        if not db.marcar_recordatorio(r['id'], ahora):
+            continue
+        correo.enviar(r['email'], f"Recordatorio: {r['clase']} el {correo.fecha_y_hora(db.a_fecha(r['inicio']))}",
+                      f"Hola {r['socio']}, te recordamos tu clase de {r['clase']} con {r['instructor']}.")
+        enviados += 1
+    return {'enviados': enviados}
+
+
 @router.get('/reservas')
 def mis_reservas(socio=Depends(socio_actual)):
     return [ver_reserva(r) for r in db.reservas_de(socio['id'])]
