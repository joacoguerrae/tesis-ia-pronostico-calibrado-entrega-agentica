+def ver_posicion_en_espera(clase_id: int, socio=Depends(socio_actual)):
+    with db.transaccion() as con:
+        if db.clase_en(con, clase_id) is None:
+            raise HTTPException(404, 'No existe la clase')
+        posicion = espera.posicion(con, clase_id, socio['id'])
+        if posicion is None:
+            raise HTTPException(404, 'No estás en la lista de espera')
+        return {'clase_id': clase_id, 'posicion': posicion}
+
+
+@router.delete('/clases/{clase_id}/espera', status_code=204)
+def bajarse_de_espera(clase_id: int, socio=Depends(socio_actual)):
+    with db.transaccion() as con:
+        if db.clase_en(con, clase_id) is None:
+            raise HTTPException(404, 'No existe la clase')
+        if db.en_espera_en(con, socio['id'], clase_id) is None:
+            raise HTTPException(404, 'No estás en la lista de espera')
+        db.quitar_de_espera_en(con, socio['id'], clase_id)
+
+
+class CambioCupo(BaseModel):
+    cupo: StrictInt = Field(gt=0)
+
+
+@router.post('/admin/reservas/{reserva_id}/cancelar', dependencies=[Depends(admin)])
+def cancelar_reserva(reserva_id: int):
+    with db.transaccion() as con:
+        reserva = db.reserva_en(con, reserva_id)
+        if reserva is None:
+            raise HTTPException(404, 'No existe la reserva')
+        if reserva['estado'] == 'cancelada':
+            raise HTTPException(409, 'La reserva ya está cancelada')
+        db.cambiar_estado_reserva_en(con, reserva_id, 'cancelada')
+        db.ajustar_creditos_en(con, reserva['socio_id'], 1)
+        pendientes = espera.asignar_lugares(con, reserva['clase_id'])
+    espera.enviar(pendientes)
+    return ver_reserva(db.reserva(reserva_id))
+
+
+@router.patch('/admin/clases/{clase_id}', dependencies=[Depends(admin)])
+def cambiar_cupo(clase_id: int, datos: CambioCupo):
+    with db.transaccion() as con:
+        if db.clase_en(con, clase_id) is None:
+            raise HTTPException(404, 'No existe la clase')
+        if datos.cupo < db.confirmadas_en(con, clase_id):
+            raise HTTPException(409, 'El cupo no puede ser menor que las reservas confirmadas')
+        db.cambiar_cupo_en(con, clase_id, datos.cupo)
+        pendientes = espera.asignar_lugares(con, clase_id)
+    espera.enviar(pendientes)
+    return ver_clase(db.clase(clase_id))
+
