+@contextmanager
+def transaccion():
+    """Transacción que toma el lock de escritura antes de leer.
+
+    Todo lo que se haga con la conexión que se recibe queda atómico frente a otros
+    procesos: o se confirma completo o no queda nada. Las funciones de este módulo
+    aceptan `con=` para participar de la misma transacción.
+    """
+    con = _conectar(autocommit=True)
+    try:
+        con.execute('BEGIN IMMEDIATE')
+        yield con
+        con.execute('COMMIT')
+    except BaseException:
+        if con.in_transaction:
+            con.execute('ROLLBACK')
+        raise
+    finally:
+        con.close()
+
+
+@contextmanager
+def usar(con):
+    """Usa la conexión recibida (si viene) o abre una nueva que se confirma al salir."""
+    if con is not None:
+        yield con
+    else:
+        with conexion() as nueva:
+            yield nueva
+
