index 59841ac..5404276 100644
--- a/pulso/db.py
+++ b/pulso/db.py
@@ -124,6 +124,19 @@ def reserva(reserva_id):
     return _una('SELECT * FROM reservas WHERE id = ?', (reserva_id,))
 
 
+def cancelar_reserva(reserva_id, socio_id, devolver_credito):
+    """Pasa la reserva a 'cancelada' y, si corresponde, devuelve el crédito, todo en una transacción.
+    Devuelve False si la reserva ya no estaba confirmada (no cambia nada en ese caso)."""
+    with conexion() as con:
+        cur = con.execute("UPDATE reservas SET estado = 'cancelada' WHERE id = ? AND estado = 'confirmada'",
+                          (reserva_id,))
+        if cur.rowcount == 0:
+            return False
+        if devolver_credito:
+            con.execute('UPDATE socios SET creditos = creditos + 1 WHERE id = ?', (socio_id,))
+    return True
+
+
 def reservas_de(socio_id):
     return _varias('SELECT r.* FROM reservas r JOIN clases c ON c.id = r.clase_id '
                    'WHERE r.socio_id = ? ORDER BY c.inicio, r.id', (socio_id,))
