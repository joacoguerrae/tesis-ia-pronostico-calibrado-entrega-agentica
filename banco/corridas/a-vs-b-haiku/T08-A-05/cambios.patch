diff --git a/pulso/beneficios.py b/pulso/beneficios.py
new file mode 100644
index 0000000..08928c6
--- /dev/null
+++ b/pulso/beneficios.py
@@ -0,0 +1,38 @@
+"""Cliente del servicio de beneficios (externo): fuente de verdad de los empleados activos."""
+import os
+from urllib.parse import quote
+
+import httpx
+
+TIMEOUT = 3.0
+transporte = None  # los tests lo reemplazan
+
+
+class ServicioFallo(Exception):
+    pass
+
+
+def consultar(empresa, email):
+    """Devuelve 'activo', 'inactivo', 'empleado_desconocido' o 'empresa_desconocida'.
+    Lanza ServicioFallo ante cualquier otra cosa."""
+    base = os.environ.get('PULSO_BENEFICIOS_URL')
+    clave = os.environ.get('PULSO_BENEFICIOS_CLAVE')
+    if not base or not clave:
+        raise ServicioFallo('Servicio de beneficios sin configurar')
+    url = f"{base}/empresas/{quote(empresa, safe='')}/empleados/{quote(email.lower(), safe='')}"
+    try:
+        with httpx.Client(timeout=TIMEOUT, transport=transporte) as cliente:
+            r = cliente.get(url, headers={'X-Api-Key': clave})
+    except httpx.HTTPError as e:
+        raise ServicioFallo(str(e)) from e
+    try:
+        cuerpo = r.json()
+    except ValueError:
+        raise ServicioFallo('Respuesta inválida')
+    if not isinstance(cuerpo, dict):
+        raise ServicioFallo('Respuesta inválida')
+    if r.status_code == 200 and isinstance(cuerpo.get('activo'), bool):
+        return 'activo' if cuerpo['activo'] else 'inactivo'
+    if r.status_code == 404 and cuerpo.get('error') in ('empleado_desconocido', 'empresa_desconocida'):
+        return cuerpo['error']
+    raise ServicioFallo(f'Respuesta inesperada {r.status_code}')
