@@ -0,0 +1,182 @@
+import json
+from datetime import timedelta
+
+import httpx
+import pytest
+
+from conftest import ADMIN, AHORA, auth
+from pulso import db
+
+
+class FakeCobra:
+    def __init__(self):
+        self.pagos = {}
+        self.caido = False
+        self.llamadas = []
+
+    def request(self, metodo, url, headers=None, json=None, params=None, timeout=None):
+        self.llamadas.append((metodo, url, headers, json))
+        assert headers['X-Cobra-Clave'] == 'clave-cobra'
+        if self.caido:
+            raise httpx.ConnectError('caído')
+        base = 'https://api.cobra.uy/v1'
+        ruta = url.removeprefix(base)
+        if metodo == 'POST' and ruta == '/pagos':
+            ref = headers['Idempotency-Key']
+            existente = next((p for p in self.pagos.values() if p['referencia'] == ref), None)
+            if existente:
+                return httpx.Response(200, json=existente)
+            pago = dict(json, id=f'pag_{len(self.pagos) + 1}', estado='pendiente',
+                        url_pago=f'https://pagar.cobra.uy/pag_{len(self.pagos) + 1}')
+            self.pagos[pago['id']] = pago
+            return httpx.Response(201, json=pago)
+        if metodo == 'GET' and ruta == '/pagos':
+            return httpx.Response(200, json={'pagos': [p for p in self.pagos.values()
+                                                       if p['referencia'] == params['referencia']]})
+        if metodo == 'GET' and ruta.startswith('/pagos/'):
+            p = self.pagos.get(ruta.removeprefix('/pagos/'))
+            return httpx.Response(200, json=p) if p else httpx.Response(404)
+        return httpx.Response(500)
+
+
+@pytest.fixture
+def cobra(monkeypatch):
+    monkeypatch.setenv('PULSO_PAGOS_URL', 'https://api.cobra.uy/v1')
+    monkeypatch.setenv('PULSO_PAGOS_CLAVE', 'clave-cobra')
+    fake = FakeCobra()
+    monkeypatch.setattr(httpx, 'request', fake.request)
+    return fake
+
+
+def comprar(cliente, socio, pack='pack-4'):
+    return cliente.post('/compras', json={'pack': pack}, headers=auth(socio))
+
+
+def creditos(cliente, socio):
+    return cliente.get('/yo', headers=auth(socio)).json()['creditos']
+
+
+def test_compra_crea_pago(cliente, socio, cobra):
+    r = comprar(cliente, socio)
+    assert r.status_code == 201
+    assert r.json() == {'id': 1, 'pack': 'pack-4', 'creditos': 4, 'monto': 1200, 'estado': 'pendiente',
+                        'creada': '2026-11-10T15:00:00+00:00', 'url_pago': 'https://pagar.cobra.uy/pag_1'}
+    _, _, headers, cuerpo = cobra.llamadas[0]
+    assert headers['Idempotency-Key'] == 'pulso-compra-1'
+    assert cuerpo == {'monto': 1200, 'moneda': 'UYU', 'referencia': 'pulso-compra-1'}
+    assert creditos(cliente, socio) == 8
+
+
+@pytest.mark.parametrize('cuerpo', [{}, {'pack': 'pack-99'}, {'pack': None}])
+def test_pack_invalido(cliente, socio, cobra, cuerpo):
+    assert cliente.post('/compras', json=cuerpo, headers=auth(socio)).status_code == 422
+    assert db.compras_pendientes() == [] and cobra.llamadas == []
+
+
+def test_compra_requiere_token(cliente, cobra):
+    assert cliente.post('/compras', json={'pack': 'pack-4'}).status_code == 401
+
+
+def test_cobra_falla_deja_compra_pendiente_sin_pago(cliente, socio, cobra):
+    cobra.caido = True
+    assert comprar(cliente, socio).status_code == 502
+    lista = cliente.get('/compras', headers=auth(socio)).json()
+    assert len(lista) == 1 and lista[0]['estado'] == 'pendiente' and lista[0]['url_pago'] is None
+
+
+def test_listado_mas_nueva_primero(cliente, socio, cobra):
+    comprar(cliente, socio)
+    from pulso import reloj
+    reloj.fijar(AHORA + timedelta(minutes=1))
+    comprar(cliente, socio, 'pack-8')
+    assert [c['id'] for c in cliente.get('/compras', headers=auth(socio)).json()] == [2, 1]
+
+
+def test_webhook_aprueba_una_sola_vez(cliente, socio, cobra):
+    comprar(cliente, socio)
+    cobra.pagos['pag_1']['estado'] = 'aprobado'
+    for _ in range(2):
+        r = cliente.post('/webhooks/pagos', json={'pago_id': 'pag_1', 'estado': 'rechazado'})
+        assert r.json() == {'compra_id': 1, 'estado': 'aprobada'}
+    assert creditos(cliente, socio) == 12
+    correos = db.correos()
+    assert [c['asunto'] for c in correos] == ['Compra de créditos aprobada']
+
+
+def test_webhook_rechazado_y_pendiente(cliente, socio, cobra):
+    comprar(cliente, socio)
+    r = cliente.post('/webhooks/pagos', json={'pago_id': 'pag_1', 'estado': 'aprobado'})
+    assert r.json()['estado'] == 'pendiente'
+    cobra.pagos['pag_1']['estado'] = 'rechazado'
+    assert cliente.post('/webhooks/pagos', json={'pago_id': 'pag_1'}).json()['estado'] == 'rechazada'
+    cobra.pagos['pag_1']['estado'] = 'aprobado'
+    assert cliente.post('/webhooks/pagos', json={'pago_id': 'pag_1'}).json()['estado'] == 'rechazada'
+    assert creditos(cliente, socio) == 8 and db.correos() == []
+
+
+def test_webhook_errores(cliente, socio, cobra):
+    assert cliente.post('/webhooks/pagos', json={}).status_code == 422
+    assert cliente.post('/webhooks/pagos', json={'pago_id': 'nada'}).status_code == 404
+    cobra.pagos['pag_x'] = {'id': 'pag_x', 'estado': 'aprobado', 'referencia': 'otra', 'url_pago': 'u'}
+    assert cliente.post('/webhooks/pagos', json={'pago_id': 'pag_x'}).status_code == 404
+    cobra.pagos['pag_y'] = {'id': 'pag_y', 'estado': 'aprobado', 'referencia': 'pulso-compra-99', 'url_pago': 'u'}
+    assert cliente.post('/webhooks/pagos', json={'pago_id': 'pag_y'}).status_code == 404
+    cobra.caido = True
+    assert cliente.post('/webhooks/pagos', json={'pago_id': 'pag_1'}).status_code == 503
+
+
+def test_webhook_guarda_pago_en_compra_sin_pago(cliente, socio, cobra):
+    cobra.caido = True
+    comprar(cliente, socio)
+    cobra.caido = False
+    cobra.pagos['pag_7'] = {'id': 'pag_7', 'estado': 'aprobado', 'referencia': 'pulso-compra-1',
+                            'url_pago': 'https://pagar.cobra.uy/pag_7'}
+    r = cliente.post('/webhooks/pagos', json={'pago_id': 'pag_7'})
+    assert r.json() == {'compra_id': 1, 'estado': 'aprobada'}
+    c = db.compra(1)
+    assert c['pago_id'] == 'pag_7' and c['url_pago'] == 'https://pagar.cobra.uy/pag_7'
+    assert creditos(cliente, socio) == 12
+
+
+def test_conciliar_requiere_admin(cliente, cobra):
+    assert cliente.post('/admin/conciliar-pagos').status_code == 401
+
+
+def test_conciliar(cliente, socio, cobra):
+    otro = db.crear_socio('Beto', 'beto@example.com')
+    comprar(cliente, socio)           # 1: aprobado
+    comprar(cliente, socio)           # 2: rechazado
+    comprar(cliente, otro, 'pack-8')  # 3: sigue pendiente
+    cobra.pagos['pag_1']['estado'] = 'aprobado'
+    cobra.pagos['pag_2']['estado'] = 'rechazado'
+    r = cliente.post('/admin/conciliar-pagos', headers=ADMIN)
+    assert r.json() == {'aprobadas': 1, 'rechazadas': 1, 'pendientes': 1}
+    assert creditos(cliente, socio) == 12
+    # Segunda vez: solo cuenta lo que seguía pendiente.
+    assert cliente.post('/admin/conciliar-pagos', headers=ADMIN).json() == {'aprobadas': 0, 'rechazadas': 0, 'pendientes': 1}
+    assert len(db.correos()) == 1
+
+
+def test_conciliar_compra_sin_pago(cliente, socio, cobra):
+    from pulso import reloj
+    cobra.caido = True
+    comprar(cliente, socio)
+    # Cobrá caído: no rechaza aunque sea vieja.
+    reloj.fijar(AHORA + timedelta(minutes=40))
+    assert cliente.post('/admin/conciliar-pagos', headers=ADMIN).json() == {'aprobadas': 0, 'rechazadas': 0, 'pendientes': 1}
+    cobra.caido = False
+    # Reciente: queda pendiente; a los 30 minutos: rechazada.
+    reloj.fijar(AHORA + timedelta(minutes=29))
+    assert cliente.post('/admin/conciliar-pagos', headers=ADMIN).json()['pendientes'] == 1
+    reloj.fijar(AHORA + timedelta(minutes=30))
+    assert cliente.post('/admin/conciliar-pagos', headers=ADMIN).json() == {'aprobadas': 0, 'rechazadas': 1, 'pendientes': 0}
+
+
+def test_conciliar_encuentra_pago_por_referencia(cliente, socio, cobra):
+    cobra.caido = True
+    comprar(cliente, socio)
+    cobra.caido = False
+    cobra.pagos['pag_5'] = {'id': 'pag_5', 'estado': 'aprobado', 'referencia': 'pulso-compra-1', 'url_pago': 'u5'}
+    r = cliente.post('/admin/conciliar-pagos', headers=ADMIN)
+    assert r.json() == {'aprobadas': 1, 'rechazadas': 0, 'pendientes': 0}
+    assert db.compra(1)['pago_id'] == 'pag_5'
