+def test_servicio_que_no_contesta_a_tiempo_es_503(cliente, socio, servicio, monkeypatch):
+    monkeypatch.setattr(beneficios, 'TIMEOUT_SEG', 0.3)
+
+    def lento(empresa, email):
+        time.sleep(1.5)
+        return ACTIVO
+
+    servicio.responder = lento
+    r = cliente.post('/convenio', json={'empresa': 'acme'}, headers=auth(socio))
+    assert r.status_code == 503
+    assert db.socio(socio['id'])['plan'] == 'basico'
+    assert db.correos() == []
