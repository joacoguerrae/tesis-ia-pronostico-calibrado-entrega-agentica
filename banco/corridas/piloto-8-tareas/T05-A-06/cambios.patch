--- a/pulso/db.py
+++ b/pulso/db.py
@@ -58,6 +58,9 @@ def conexion():
 def inicializar():
     with conexion() as con:
         con.executescript(ESQUEMA)
+        columnas = [f['name'] for f in con.execute('PRAGMA table_info(reservas)')]
+        if 'recordatorio' not in columnas:
+            con.execute('ALTER TABLE reservas ADD COLUMN recordatorio TEXT')
 
 
 def a_texto(momento):
@@ -136,3 +139,19 @@ def sumar_creditos(socio_id, cantidad):
 
 def correos():
     return _varias('SELECT * FROM correos ORDER BY id')
+
+
+def reservas_a_recordar(desde, hasta):
+    """Reservas confirmadas sin recordatorio cuya clase empieza en (desde, hasta]."""
+    filas = _varias("SELECT r.id AS reserva_id, r.socio_id, c.nombre, c.instructor, c.inicio "
+                    "FROM reservas r JOIN clases c ON c.id = r.clase_id "
+                    "WHERE r.estado = 'confirmada' AND r.recordatorio IS NULL ORDER BY c.inicio, r.id")
+    return [f for f in filas if desde < a_fecha(f['inicio']) <= hasta]
+
+
+def marcar_recordada(reserva_id, momento):
+    """Marca la reserva como recordada. True solo para quien la marcó primero."""
+    with conexion() as con:
+        cur = con.execute('UPDATE reservas SET recordatorio = ? WHERE id = ? AND recordatorio IS NULL',
+                          (a_texto(momento), reserva_id))
+        return cur.rowcount == 1
