diff --git a/tests/test_filtros.py b/tests/test_filtros.py
new file mode 100644
index 0000000..2c34a69
--- /dev/null
+++ b/tests/test_filtros.py
@@ -0,0 +1,51 @@
+from datetime import datetime, timedelta, timezone
+
+from conftest import AHORA
+from pulso import db
+
+
+def test_filtro_por_dia_montevideo(cliente):
+    # 02:30 UTC del 12 = 23:30 del 11 en Montevideo
+    db.crear_clase('A', 'Leo', datetime(2026, 11, 12, 2, 30, tzinfo=timezone.utc))
+    db.crear_clase('B', 'Leo', datetime(2026, 11, 12, 15, 0, tzinfo=timezone.utc))
+    db.crear_clase('C', 'Leo', datetime(2026, 11, 13, 3, 0, tzinfo=timezone.utc))  # 00:00 del 13 UY
+    r = cliente.get('/clases?desde=2026-11-12&hasta=2026-11-12')
+    assert [c['nombre'] for c in r.json()] == ['B']
+    r = cliente.get('/clases?hasta=2026-11-11')
+    assert [c['nombre'] for c in r.json()] == ['A']
+    r = cliente.get('/clases?desde=2026-11-12')
+    assert [c['nombre'] for c in r.json()] == ['B', 'C']
+
+
+def test_instructor_y_con_lugar(cliente, socio):
+    llena = db.crear_clase('A', 'Leo', AHORA + timedelta(hours=1), cupo=1)
+    db.crear_clase('B', 'Sofía', AHORA + timedelta(hours=2))
+    db.crear_clase('C', 'Leo', AHORA + timedelta(hours=3))
+    db.crear_reserva(socio['id'], llena['id'], AHORA)
+    r = cliente.get('/clases?instructor=LEO')
+    assert [c['nombre'] for c in r.json()] == ['A', 'C']
+    assert r.headers['X-Total'] == '2'
+    r = cliente.get('/clases?instructor=leo&con_lugar=true')
+    assert [c['nombre'] for c in r.json()] == ['C']
+    assert r.headers['X-Total'] == '1'
+    assert len(cliente.get('/clases?con_lugar=false').json()) == 3
+    assert cliente.get('/clases?instructor=le').json() == []
+
+
+def test_paginacion(cliente):
+    for i in range(5):
+        db.crear_clase(f'C{i}', 'Leo', AHORA + timedelta(hours=1))
+    db.crear_clase('pasada', 'Leo', AHORA - timedelta(hours=1))
+    r = cliente.get('/clases?por_pagina=2&pagina=3')
+    assert [c['nombre'] for c in r.json()] == ['C4']
+    assert r.headers['X-Total'] == '5'
+    r = cliente.get('/clases?por_pagina=2&pagina=9')
+    assert r.json() == [] and r.headers['X-Total'] == '5'
+    assert len(cliente.get('/clases').json()) == 5
+
+
+def test_parametros_invalidos(cliente):
+    for q in ('pagina=0', 'por_pagina=0', 'por_pagina=51', 'desde=12-11-2026', 'hasta=20261112',
+              'desde=2026-13-01', 'desde=2026-11-14&hasta=2026-11-13', 'con_lugar=quizas'):
+        assert cliente.get('/clases?' + q).status_code == 422, q
+    assert cliente.get('/clases?por_pagina=50').status_code == 200
