index 59841ac..a1234ce 100644
--- a/pulso/db.py
+++ b/pulso/db.py
@@ -29,6 +29,10 @@ CREATE TABLE IF NOT EXISTS reservas (
     estado TEXT NOT NULL,
     creada TEXT NOT NULL
 );
+CREATE TABLE IF NOT EXISTS convenios (
+    socio_id INTEGER PRIMARY KEY REFERENCES socios(id),
+    empresa TEXT NOT NULL
+);
 CREATE TABLE IF NOT EXISTS correos (
     id INTEGER PRIMARY KEY,
     para TEXT NOT NULL,
@@ -136,3 +140,31 @@ def sumar_creditos(socio_id, cantidad):
 
 def correos():
     return _varias('SELECT * FROM correos ORDER BY id')
+
+
+def socios_corporativos():
+    """Socios con plan corporativo, con la empresa con la que activaron el convenio (None si no hay)."""
+    return _varias("SELECT s.*, c.empresa AS empresa FROM socios s "
+                   "LEFT JOIN convenios c ON c.socio_id = s.id "
+                   "WHERE s.plan = 'corporativo' ORDER BY s.id")
+
+
+def activar_convenio(socio_id, empresa):
+    """Pasa el socio a corporativo con piso de 12 créditos. Devuelve False si ya lo tenía (no cambia nada)."""
+    with conexion() as con:
+        cur = con.execute("UPDATE socios SET plan = 'corporativo', creditos = MAX(creditos, 12) "
+                          "WHERE id = ? AND plan <> 'corporativo'", (socio_id,))
+        if cur.rowcount == 0:
+            return False
+        con.execute('INSERT OR REPLACE INTO convenios (socio_id, empresa) VALUES (?, ?)', (socio_id, empresa))
+    return True
+
+
+def bajar_convenio(socio_id):
+    """Vuelve el socio a básico y conserva sus créditos. Devuelve False si no era corporativo."""
+    with conexion() as con:
+        cur = con.execute("UPDATE socios SET plan = 'basico' WHERE id = ? AND plan = 'corporativo'", (socio_id,))
+        if cur.rowcount == 0:
+            return False
+        con.execute('DELETE FROM convenios WHERE socio_id = ?', (socio_id,))
+    return True
