{"host.arch": "amd64", "os.type": "linux", "os.version": "6.18.33.2-microsoft-standard-WSL2", "service.name": "claude-code", "service.version": "2.1.312", "wsl.version": "2", "user.id": "0f72bbf305cc3cfe4c49efd7a27949e16f5ce38c2de862b736399de5c3c79b13", "session.id": "57a6454a-4230-46eb-9c46-a0cfc02ca228", "terminal.type": "wsl-Ubuntu-24.04", "gen_ai.provider.name": "anthropic", "span.type": "tool.blocked_on_user", "gen_ai.conversation.id": "57a6454a-4230-46eb-9c46-a0cfc02ca228", "duration_ms": 6, "decision": "reject", "source": "config", "_nombre": "claude_code.tool.blocked_on_user", "_traza": "c5d94a7295a6cc0e459438b608da5e69", "_tramo": "abce366b02b3043e", "_padre": "27bcc72a27553500", "_inicio_ns": 1794703081349000000, "_fin_ns": 1794703081355148287, "_estado": 0}
{"host.arch": "amd64", "os.type": "linux", "os.version": "6.18.33.2-microsoft-standard-WSL2", "service.name": "claude-code", "service.version": "2.1.312", "wsl.version": "2", "user.id": "0f72bbf305cc3cfe4c49efd7a27949e16f5ce38c2de862b736399de5c3c79b13", "session.id": "57a6454a-4230-46eb-9c46-a0cfc02ca228", "terminal.type": "wsl-Ubuntu-24.04", "gen_ai.provider.name": "anthropic", "span.type": "tool", "tool_name": "Bash", "tool_name_safe": "Bash", "gen_ai.operation.name": "execute_tool", "gen_ai.tool.name": "Bash", "gen_ai.conversation.id": "57a6454a-4230-46eb-9c46-a0cfc02ca228", "full_command": "cat > tests/test_horarios.py <<'EOF'\nimport sqlite3\nfrom datetime import datetime, timedelta, timezone\n\nfrom conftest import ADMIN, AHORA, auth\nfrom pulso import db, reloj\nfrom pulso.main import crear_app\n\n# Jueves 12/11/2026 19:00 en Montevideo = 22:00 UTC.\nFUNCIONAL = datetime(2026, 11, 12, 22, 0, tzinfo=timezone.utc)\n\n\ndef _insertar_crudo(nombre, inicio):\n    \"\"\"Inserta una clase con el texto de inicio tal como quedó guardado en la base.\"\"\"\n    with sqlite3.connect(db.ruta()) as con:\n        cur = con.execute('INSERT INTO clases (nombre, instructor, inicio, duracion_min, cupo) '\n                          'VALUES (?, ?, ?, 60, 20)', (nombre, 'Leo', inicio))\n        return cur.lastrowid\n\n\ndef _inicios_crudos():\n    with sqlite3.connect(db.ruta()) as con:\n        return dict(con.execute('SELECT id, inicio FROM clases').fetchall())\n\n\ndef test_panel_con_desfase_de_montevideo_guarda_utc(cliente):\n    datos = {'nombre': 'Funcional', 'instructor': 'Leo', 'inicio': '2026-11-12T19:00:00-03:00',\n             'duracion_min': 60, 'cupo': 10}\n    r = cliente.post('/admin/clases', json=datos, headers=ADMIN)\n    assert r.status_code == 201\n    assert r.json()['inicio'] == '2026-11-12T22:00:00+00:00'\n    assert _inicios_crudos()[r.json()['id']] == '2026-11-12T22:00:00+00:00'\n\n\ndef test_cualquier_desfase_se_normaliza(cliente):\n    for inicio in ('2026-11-12T22:00:00Z', '2026-11-12T22:00:00+00:00', '2026-11-12T19:00:00-03:00',\n                   '2026-11-12T23:00:00+01:00'):\n        datos = {'nombre': 'Yoga', 'instructor': 'Sofía', 'inicio': inicio, 'duracion_min': 60, 'cupo': 10}\n        r = cliente.post('/admin/clases', json=datos, headers=ADMIN)\n        assert r.json()['inicio'] == '2026-11-12T22:00:00+00:00', inicio\n\n\ndef test_clase_del_panel_se_ve_se_ordena_y_se_reserva_a_su_hora(cliente, socio):\n    funcional = db.crear_clase('Funcional', 'Leo', FUNCIONAL.replace(tzinfo=timezone(timedelta(hours=-3))))\n    yoga = db.crear_clase('Yoga', 'Sofía', datetime(2026, 11, 12, 23, 0, tzinfo=timezone.utc))\n    spinning = db.crear_clase('Spinning', 'Leo', datetime(2026, 11, 13, 0, 0, tzinfo=timezone.utc))\n    assert [c['nombre'] for c in cliente.get('/clases').json()] == ['Funcional', 'Yoga', 'Spinning']\n\n    # A las 16:00 de Montevideo (19:00 UTC) el Funcional todavía no empezó.\n    reloj.fijar(datetime(2026, 11, 12, 19, 0, tzinfo=timezone.utc))\n    assert cliente.get(f\"/clases/{funcional['id']}\").status_code == 200\n    r = cliente.post('/reservas', json={'clase_id': funcional['id']}, headers=auth(socio))\n    assert r.status_code == 201\n    [enviado] = db.correos()\n    assert enviado['asunto'] == 'Reserva confirmada: Funcional el 12/11 a las 19:00'\n\n    # Después de las 19:00 ya no se reserva.\n    reloj.fijar(FUNCIONAL + timedelta(minutes=1))\n    assert cliente.post('/reservas', json={'clase_id': yoga['id']}, headers=auth(socio)).status_code == 409\n\n\ndef test_reservas_ordenadas_con_clases_de_formatos_mixtos(cliente, socio):\n    tarde = db.crear_clase('Spinning', 'Leo', datetime(2026, 11, 13, 0, 0, tzinfo=timezone.utc))\n    temprano = db.crear_clase('Funcional', 'Leo', datetime(2026, 11, 12, 22, 0, tzinfo=timezone.utc))\n    for clase in (tarde, temprano):\n        assert cliente.post('/reservas', json={'clase_id': clase['id']}, headers=auth(socio)).status_code == 201\n    r = cliente.get('/reservas', headers=auth(socio))\n    assert [x['clase_id'] for x in r.json()] == [temprano['id'], tarde['id']]\n\n\ndef test_arranque_normaliza_clases_ya_guardadas_sin_mover_ids(tmp_path, monkeypatch):\n    monkeypatch.setenv('PULSO_DB', str(tmp_path / 'vieja.db'))\n    reloj.fijar(AHORA)\n    db.inicializar()\n    sin_zona = _insertar_crudo('Yoga antigua', '2026-08-20T22:00:00')\n    con_zona = _insertar_crudo('Yoga setiembre', '2026-10-15T22:00:00+00:00')\n    del_panel = _insertar_crudo('Funcional', '2026-11-12T19:00:00-03:00')\n\n    crear_app()\n    esperado = {\n        sin_zona: '2026-08-20T22:00:00+00:00',\n        con_zona: '2026-10-15T22:00:00+00:00',\n        del_panel: '2026-11-12T22:00:00+00:00',\n    }\n    assert {k: v for k, v in _inicios_crudos().items() if k in esperado} == esperado\n    assert db.clase(del_panel)['nombre'] == 'Funcional'\n    assert [c['id'] for c in db.clases()] == [sin_zona, con_zona, del_panel]\n    reloj.fijar(None)\n\n\ndef test_arrancar_de_nuevo_no_mueve_clases(tmp_path, monkeypatch):\n    monkeypatch.setenv('PULSO_DB', str(tmp_path / 'vieja.db'))\n    reloj.fijar(AHORA)\n    db.inicializar()\n    _insertar_crudo('Funcional', '2026-11-12T19:00:00-03:00')\n    crear_app()\n    primera = _inicios_crudos()\n    crear_app()\n    crear_app()\n    assert _inicios_crudos() == primera\n    reloj.fijar(None)\n\n\ndef test_a_fecha_con_desfase_no_se_reinterpreta():\n    assert db.a_fecha('2026-11-12T19:00:00-03:00') == FUNCIONAL\n    assert db.a_fecha('2026-08-20T22:00:00') == datetime(2026, 8, 20, 22, 0, tzinfo=timezone.utc)\nEOF\npython -m pytest -q 2>&1 | tail -15", "bash_command_class": "file_read", "bash_argv0": "cat", "tool_use_id": "toolu_01LMoeLaSHFUxWkbp7RtUH6f", "gen_ai.tool.call.id": "toolu_01LMoeLaSHFUxWkbp7RtUH6f", "duration_ms": 6, "_nombre": "claude_code.tool", "_traza": "c5d94a7295a6cc0e459438b608da5e69", "_tramo": "27bcc72a27553500", "_padre": "deb835566f0d1a40", "_inicio_ns": 1794703081349000000, "_fin_ns": 1794703081355304176, "_estado": 0}
