+    beneficios.responder = respuesta
+
+    r = cliente.post('/admin/revalidar-convenios', headers=ADMIN)
+    assert r.status_code == 200
+    assert r.json() == {'siguen': 1, 'bajaron': 1, 'sin_revisar': 1}
+    assert cliente.get('/yo', headers=auth(ana)).json()['plan'] == 'corporativo'
+    assert cliente.get('/yo', headers=auth(juan)).json()['plan'] == 'basico'
+    assert cliente.get('/yo', headers=auth(pedro)).json()['plan'] == 'corporativo'
