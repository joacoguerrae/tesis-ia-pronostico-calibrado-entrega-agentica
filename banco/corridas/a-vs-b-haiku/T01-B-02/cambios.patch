diff --git a/tests/test_base.py b/tests/test_base.py
index 5d9460b..6d02bd0 100644
--- a/tests/test_base.py
+++ b/tests/test_base.py
@@ -1,7 +1,7 @@
 from datetime import timedelta
 
 from conftest import ADMIN, AHORA, auth
-from pulso import db
+from pulso import db, reloj
 
 
 def test_lista_solo_clases_futuras_en_orden(cliente):
@@ -79,3 +79,104 @@ def test_mis_reservas_en_orden_de_clase(cliente, socio):
         cliente.post('/reservas', json={'clase_id': clase['id']}, headers=auth(socio))
     r = cliente.get('/reservas', headers=auth(socio))
     assert [x['clase_id'] for x in r.json()] == [temprano['id'], tarde['id']]
+
+
+def reservar(cliente, socio, clase):
+    r = cliente.post('/reservas', json={'clase_id': clase['id']}, headers=auth(socio))
+    assert r.status_code == 201
+    return r.json()
+
+
+def test_cancela_con_mas_de_dos_horas_y_devuelve_credito(cliente, socio):
+    clase = db.crear_clase('Yoga', 'Sofía', AHORA + timedelta(hours=5))
+    reserva = reservar(cliente, socio, clase)
+    r = cliente.post(f"/reservas/{reserva['id']}/cancelar", headers=auth(socio))
+    assert r.status_code == 200
+    assert r.json() == {'id': reserva['id'], 'clase_id': clase['id'], 'estado': 'cancelada',
+                        'creada': reserva['creada'], 'credito_devuelto': True}
+    assert cliente.get('/yo', headers=auth(socio)).json()['creditos'] == 8
+    assert cliente.get(f"/clases/{clase['id']}").json()['lugares_libres'] == 20
+
+
+def test_exactamente_dos_horas_devuelve_credito(cliente, socio):
+    clase = db.crear_clase('Yoga', 'Sofía', AHORA + timedelta(hours=2))
+    reserva = reservar(cliente, socio, clase)
+    r = cliente.post(f"/reservas/{reserva['id']}/cancelar", headers=auth(socio))
+    assert r.status_code == 200
+    assert r.json()['credito_devuelto'] is True
+
+
+def test_con_menos_de_dos_horas_cancela_sin_devolver_credito(cliente, socio):
+    clase = db.crear_clase('Yoga', 'Sofía', AHORA + timedelta(hours=1, minutes=59))
+    reserva = reservar(cliente, socio, clase)
+    r = cliente.post(f"/reservas/{reserva['id']}/cancelar", headers=auth(socio))
+    assert r.status_code == 200
+    assert r.json()['estado'] == 'cancelada'
+    assert r.json()['credito_devuelto'] is False
+    assert cliente.get('/yo', headers=auth(socio)).json()['creditos'] == 7
+
+
+def test_reserva_cancelada_sigue_en_mis_reservas(cliente, socio):
+    clase = db.crear_clase('Yoga', 'Sofía', AHORA + timedelta(days=1))
+    reserva = reservar(cliente, socio, clase)
+    cliente.post(f"/reservas/{reserva['id']}/cancelar", headers=auth(socio))
+    r = cliente.get('/reservas', headers=auth(socio))
+    assert [(x['id'], x['estado']) for x in r.json()] == [(reserva['id'], 'cancelada')]
+
+
+def test_no_se_puede_cancelar_dos_veces_ni_devuelve_credito_otra_vez(cliente, socio):
+    clase = db.crear_clase('Yoga', 'Sofía', AHORA + timedelta(days=1))
+    reserva = reservar(cliente, socio, clase)
+    assert cliente.post(f"/reservas/{reserva['id']}/cancelar", headers=auth(socio)).status_code == 200
+    assert cliente.post(f"/reservas/{reserva['id']}/cancelar", headers=auth(socio)).status_code == 409
+    assert cliente.get('/yo', headers=auth(socio)).json()['creditos'] == 8
+
+
+def test_no_se_puede_cancelar_clase_empezada(cliente, socio):
+    clase = db.crear_clase('Yoga', 'Sofía', AHORA + timedelta(hours=1))
+    reserva = reservar(cliente, socio, clase)
+    reloj.fijar(AHORA + timedelta(hours=1))
+    r = cliente.post(f"/reservas/{reserva['id']}/cancelar", headers=auth(socio))
+    assert r.status_code == 409
+    assert [x['estado'] for x in cliente.get('/reservas', headers=auth(socio)).json()] == ['confirmada']
+    assert cliente.get('/yo', headers=auth(socio)).json()['creditos'] == 7
+
+
+def test_reserva_inexistente_da_404(cliente, socio):
+    assert cliente.post('/reservas/999/cancelar', headers=auth(socio)).status_code == 404
+
+
+def test_reserva_de_otro_socio_da_404_y_no_se_toca(cliente, socio):
+    otro = db.crear_socio('Juan Gómez', 'juan@example.com')
+    clase = db.crear_clase('Yoga', 'Sofía', AHORA + timedelta(days=1))
+    reserva = reservar(cliente, otro, clase)
+    r = cliente.post(f"/reservas/{reserva['id']}/cancelar", headers=auth(socio))
+    assert r.status_code == 404
+    assert db.reserva(reserva['id'])['estado'] == 'confirmada'
+    assert cliente.get('/yo', headers=auth(otro)).json()['creditos'] == 7
+
+
+def test_cancelar_sin_token(cliente, socio):
+    clase = db.crear_clase('Yoga', 'Sofía', AHORA + timedelta(days=1))
+    reserva = reservar(cliente, socio, clase)
+    assert cliente.post(f"/reservas/{reserva['id']}/cancelar").status_code == 401
+
+
+def test_lugar_liberado_lo_puede_reservar_otro_socio(cliente, socio):
+    clase = db.crear_clase('Yoga', 'Sofía', AHORA + timedelta(days=1), cupo=1)
+    otro = db.crear_socio('Juan Gómez', 'juan@example.com')
+    reserva = reservar(cliente, socio, clase)
+    assert cliente.post('/reservas', json={'clase_id': clase['id']}, headers=auth(otro)).status_code == 409
+    cliente.post(f"/reservas/{reserva['id']}/cancelar", headers=auth(socio))
+    assert cliente.get(f"/clases/{clase['id']}").json()['lugares_libres'] == 1
+    assert cliente.post('/reservas', json={'clase_id': clase['id']}, headers=auth(otro)).status_code == 201
+
+
+def test_mismo_socio_puede_volver_a_reservar_la_clase(cliente, socio):
+    clase = db.crear_clase('Yoga', 'Sofía', AHORA + timedelta(days=1))
+    reserva = reservar(cliente, socio, clase)
+    cliente.post(f"/reservas/{reserva['id']}/cancelar", headers=auth(socio))
+    nueva = reservar(cliente, socio, clase)
+    assert nueva['id'] != reserva['id']
+    assert nueva['estado'] == 'confirmada'
+    assert cliente.get(f"/clases/{clase['id']}").json()['lugares_libres'] == 19
