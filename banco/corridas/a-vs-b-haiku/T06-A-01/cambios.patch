 def correos():
     return _varias('SELECT * FROM correos ORDER BY id')
+
+
+# --- Lista de espera y panel de recepción -------------------------------
+# Todo lo que cambia lugares corre en una sola transacción (BEGIN IMMEDIATE),
+# así no hay estados intermedios ni dos operaciones pisándose.
+
+class ReglaNegocio(Exception):
+    """Una regla de negocio impide la operación (409)."""
+
+
+class NoExiste(Exception):
+    """El recurso no existe (404)."""
+
+
+@contextmanager
+def transaccion():
+    with conexion() as con:
+        con.execute('BEGIN IMMEDIATE')
+        try:
+            yield con
+        except BaseException:
+            con.rollback()
+            raise
+
+
+def _fila(con, sql, parametros=()):
+    fila = con.execute(sql, parametros).fetchone()
+    return dict(fila) if fila else None
+
+
+def _confirmadas(con, clase_id):
+    return _fila(con, "SELECT COUNT(*) AS n FROM reservas WHERE clase_id = ? AND estado = 'confirmada'",
+                 (clase_id,))['n']
+
+
+def _tiene_confirmada(con, socio_id, clase_id):
+    return _fila(con, "SELECT 1 AS x FROM reservas WHERE socio_id = ? AND clase_id = ? AND estado = 'confirmada'",
+                 (socio_id, clase_id)) is not None
+
+
+def posicion_espera(socio_id, clase_id):
+    """Posición (desde 1) del socio en la lista, o None si no está."""
+    fila = _una('SELECT (SELECT COUNT(*) FROM espera e2 WHERE e2.clase_id = e.clase_id AND e2.id <= e.id) AS pos '
+                'FROM espera e WHERE socio_id = ? AND clase_id = ?', (socio_id, clase_id))
+    return fila['pos'] if fila else None
+
+
+def anotar_en_espera(socio_id, clase_id, ahora):
+    """Anota al socio al final de la lista. Devuelve la posición."""
+    with transaccion() as con:
+        c = _fila(con, 'SELECT * FROM clases WHERE id = ?', (clase_id,))
+        if c is None:
+            raise NoExiste('No existe la clase')
+        if a_fecha(c['inicio']) <= ahora:
+            raise ReglaNegocio('La clase ya empezó')
+        if _tiene_confirmada(con, socio_id, clase_id):
+            raise ReglaNegocio('Ya tenés una reserva para esta clase')
+        if _fila(con, 'SELECT 1 AS x FROM espera WHERE socio_id = ? AND clase_id = ?', (socio_id, clase_id)):
+            raise ReglaNegocio('Ya estás en la lista de espera')
+        if _confirmadas(con, clase_id) < c['cupo']:
+            raise ReglaNegocio('La clase tiene lugar: reservá directo')
+        if _fila(con, 'SELECT creditos FROM socios WHERE id = ?', (socio_id,))['creditos'] < 1:
+            raise ReglaNegocio('No te quedan créditos')
+        con.execute('INSERT INTO espera (socio_id, clase_id, creada) VALUES (?, ?, ?)',
+                    (socio_id, clase_id, a_texto(ahora)))
+    return posicion_espera(socio_id, clase_id)
+
+
+def bajar_de_espera(socio_id, clase_id):
+    with conexion() as con:
+        cur = con.execute('DELETE FROM espera WHERE socio_id = ? AND clase_id = ?', (socio_id, clase_id))
+        return cur.rowcount > 0
+
+
+def _asignar_lugares(con, c, ahora):
+    """Pasa los lugares libres de la clase a la lista de espera, en orden."""
+    from pulso import correo
+    inicio = a_fecha(c['inicio'])
+    if inicio <= ahora:
+        return
+    cuando = correo.fecha_y_hora(inicio)
+    while _confirmadas(con, c['id']) < c['cupo']:
+        primero = _fila(con, 'SELECT * FROM espera WHERE clase_id = ? ORDER BY id LIMIT 1', (c['id'],))
+        if primero is None:
+            return
+        con.execute('DELETE FROM espera WHERE id = ?', (primero['id'],))
+        s = _fila(con, 'SELECT * FROM socios WHERE id = ?', (primero['socio_id'],))
+        if _tiene_confirmada(con, s['id'], c['id']):
+            continue
+        if s['creditos'] < 1:
+            correo.enviar(s['email'], f"No pudimos darte el lugar: {c['nombre']} el {cuando}",
+                          f"Hola {s['nombre']}, no tenías créditos para quedarte con el lugar.", con)
+            continue
+        con.execute("INSERT INTO reservas (socio_id, clase_id, estado, creada) VALUES (?, ?, 'confirmada', ?)",
+                    (s['id'], c['id'], a_texto(ahora)))
+        con.execute('UPDATE socios SET creditos = creditos - 1 WHERE id = ?', (s['id'],))
+        correo.enviar(s['email'], f"Se liberó un lugar: {c['nombre']} el {cuando}",
+                      f"Hola {s['nombre']}, te asignamos un lugar en {c['nombre']} con {c['instructor']}.", con)
+
+
+def cancelar_reserva(reserva_id, ahora):
+    """Cancela, devuelve el crédito y asigna el lugar liberado. Devuelve la reserva."""
+    with transaccion() as con:
+        r = _fila(con, 'SELECT * FROM reservas WHERE id = ?', (reserva_id,))
+        if r is None:
+            raise NoExiste('No existe la reserva')
+        if r['estado'] == 'cancelada':
+            raise ReglaNegocio('La reserva ya estaba cancelada')
+        con.execute("UPDATE reservas SET estado = 'cancelada' WHERE id = ?", (reserva_id,))
+        con.execute('UPDATE socios SET creditos = creditos + 1 WHERE id = ?', (r['socio_id'],))
+        _asignar_lugares(con, _fila(con, 'SELECT * FROM clases WHERE id = ?', (r['clase_id'],)), ahora)
+    return reserva(reserva_id)
+
+
+def cambiar_cupo(clase_id, cupo, ahora):
+    with transaccion() as con:
+        c = _fila(con, 'SELECT * FROM clases WHERE id = ?', (clase_id,))
+        if c is None:
+            raise NoExiste('No existe la clase')
+        if cupo < _confirmadas(con, clase_id):
+            raise ReglaNegocio('El cupo no puede ser menor que las reservas confirmadas')
+        con.execute('UPDATE clases SET cupo = ? WHERE id = ?', (cupo, clase_id))
+        c['cupo'] = cupo
+        _asignar_lugares(con, c, ahora)
+    return clase(clase_id)
