+++ b/tests/test_horarios.py
@@ -0,0 +1,144 @@
+import sqlite3
+from datetime import datetime, timezone
+
+from fastapi.testclient import TestClient
+
+from conftest import ADMIN, auth
+from pulso import correo, db, reloj
+from pulso.main import crear_app
+
+# Jueves 12/11/2026 a las 10:00 en Montevideo (13:00 UTC).
+JUEVES_MANANA = datetime(2026, 11, 12, 13, 0, tzinfo=timezone.utc)
+AHORA_RESERVA = datetime(2026, 11, 10, 15, 0, tzinfo=timezone.utc)
+
+
+def crudo(sql, parametros=()):
+    con = sqlite3.connect(db.ruta())
+    try:
+        return con.execute(sql, parametros).fetchall()
+    finally:
+        con.close()
+
+
+def insertar_clase_cruda(nombre, inicio):
+    """Inserta una clase con el texto de inicio tal cual, como quedó en la base vieja."""
+    con = sqlite3.connect(db.ruta())
+    try:
+        cur = con.execute('INSERT INTO clases (nombre, instructor, inicio, duracion_min, cupo) '
+                          'VALUES (?, ?, ?, 60, 20)', (nombre, 'Leo', inicio))
+        con.commit()
+        return cur.lastrowid
+    finally:
+        con.close()
+
+
+# --- Conversión de fechas -------------------------------------------------
+
+def test_a_fecha_convierte_el_desfase_en_vez_de_reinterpretarlo():
+    assert db.a_fecha('2026-11-12T19:00:00-03:00') == datetime(2026, 11, 12, 22, 0, tzinfo=timezone.utc)
+
+
+def test_a_fecha_trata_sin_zona_como_utc():
+    assert db.a_fecha('2026-08-20T22:00:00') == datetime(2026, 8, 20, 22, 0, tzinfo=timezone.utc)
+
+
+def test_a_fecha_acepta_z_y_otros_desfases():
+    esperado = datetime(2026, 11, 12, 22, 0, tzinfo=timezone.utc)
+    assert db.a_fecha('2026-11-12T22:00:00Z') == esperado
+    assert db.a_fecha('2026-11-12T22:00:00+00:00') == esperado
+    assert db.a_fecha('2026-11-12T23:30:00+01:30') == esperado
+
+
+# --- Alta de clases por el panel -----------------------------------------
+
+def test_admin_normaliza_cualquier_desfase_a_utc(cliente):
+    base = {'nombre': 'Funcional', 'instructor': 'Leo', 'duracion_min': 60, 'cupo': 10}
+    entradas = ['2026-11-12T22:00:00Z', '2026-11-12T22:00:00+00:00',
+                '2026-11-12T19:00:00-03:00', '2026-11-13T03:30:00+05:30']
+    for inicio in entradas:
+        r = cliente.post('/admin/clases', json=dict(base, inicio=inicio), headers=ADMIN)
+        assert r.status_code == 201
+        assert r.json()['inicio'] == '2026-11-12T22:00:00+00:00'
+    guardados = {fila[0] for fila in crudo('SELECT inicio FROM clases')}
+    assert guardados == {'2026-11-12T22:00:00+00:00'}
+
+
+def test_funcional_del_panel_se_ve_con_su_horario_real(cliente, socio):
+    reloj.fijar(JUEVES_MANANA)
+    datos = {'nombre': 'Funcional', 'instructor': 'Leo', 'inicio': '2026-11-12T19:00:00-03:00',
+             'duracion_min': 60, 'cupo': 10}
+    funcional = cliente.post('/admin/clases', json=datos, headers=ADMIN).json()
+    assert funcional['inicio'] == '2026-11-12T22:00:00+00:00'
+
+    assert cliente.get(f"/clases/{funcional['id']}").status_code == 200
+    assert funcional['id'] in [c['id'] for c in cliente.get('/clases').json()]
+
+    r = cliente.post('/reservas', json={'clase_id': funcional['id']}, headers=auth(socio))
+    assert r.status_code == 201
+    [enviado] = db.correos()
+    assert enviado['asunto'] == 'Reserva confirmada: Funcional el 12/11 a las 19:00'
+
+
+def test_no_se_reserva_funcional_despues_de_las_19(cliente, socio):
+    datos = {'nombre': 'Funcional', 'instructor': 'Leo', 'inicio': '2026-11-12T19:00:00-03:00',
+             'duracion_min': 60, 'cupo': 10}
+    funcional = cliente.post('/admin/clases', json=datos, headers=ADMIN).json()
+    reloj.fijar(datetime(2026, 11, 12, 22, 1, tzinfo=timezone.utc))  # 19:01 en Montevideo
+    assert cliente.post('/reservas', json={'clase_id': funcional['id']}, headers=auth(socio)).status_code == 409
+    reloj.fijar(datetime(2026, 11, 12, 21, 59, tzinfo=timezone.utc))  # 18:59 en Montevideo
+    assert cliente.post('/reservas', json={'clase_id': funcional['id']}, headers=auth(socio)).status_code == 201
+
+
+def test_lista_ordena_cronologicamente_con_clases_de_distintos_panel(cliente):
+    reloj.fijar(JUEVES_MANANA)
+    panel = {'instructor': 'Leo', 'duracion_min': 60, 'cupo': 10, 'nombre': 'Spinning',
+             'inicio': '2026-11-12T21:00:00-03:00'}
+    cliente.post('/admin/clases', json=panel, headers=ADMIN)
+    db.crear_clase('Yoga', 'Sofía', datetime(2026, 11, 12, 23, 0, tzinfo=timezone.utc))
+    cliente.post('/admin/clases', json=dict(panel, nombre='Funcional', inicio='2026-11-12T19:00:00-03:00'),
+                 headers=ADMIN)
+    nombres = [c['nombre'] for c in cliente.get('/clases').json()]
+    assert nombres == ['Funcional', 'Yoga', 'Spinning']
+
+
+# --- Migración de las clases ya cargadas ---------------------------------
+
+def test_crear_app_migra_las_clases_viejas_y_conserva_ids(cliente, socio):
+    sin_zona = insertar_clase_cruda('Pilates', '2026-08-20T22:00:00')
+    canonica = insertar_clase_cruda('Yoga', '2026-10-15T22:00:00+00:00')
+    panel = insertar_clase_cruda('Funcional', '2026-11-12T19:00:00-03:00')
+    reserva = db.crear_reserva(socio['id'], panel, AHORA_RESERVA)
+
+    crear_app()
+
+    guardados = dict(crudo('SELECT id, inicio FROM clases'))
+    assert guardados[sin_zona] == '2026-08-20T22:00:00+00:00'
+    assert guardados[canonica] == '2026-10-15T22:00:00+00:00'
+    assert guardados[panel] == '2026-11-12T22:00:00+00:00'
+    assert db.reserva(reserva['id'])['clase_id'] == panel
+    assert db.clase(panel)['inicio'] == '2026-11-12T22:00:00+00:00'
+
+
+def test_migracion_no_mueve_clases_al_reiniciar(cliente):
+    insertar_clase_cruda('Funcional', '2026-11-12T19:00:00-03:00')
+    insertar_clase_cruda('Pilates', '2026-08-20T22:00:00')
+    crear_app()
+    primera = crudo('SELECT id, inicio FROM clases ORDER BY id')
+    crear_app()
+    crear_app()
+    assert crudo('SELECT id, inicio FROM clases ORDER BY id') == primera
+
+
+def test_clases_migradas_se_listan_en_orden_real(cliente):
+    reloj.fijar(JUEVES_MANANA)
+    insertar_clase_cruda('Spinning', '2026-11-13T00:00:00+00:00')  # 21:00 del jueves, Montevideo
+    insertar_clase_cruda('Yoga', '2026-11-12T23:00:00')            # 20:00 del jueves, sin zona (UTC)
+    insertar_clase_cruda('Funcional', '2026-11-12T19:00:00-03:00')  # 19:00 del jueves
+    nombres = [c['nombre'] for c in TestClient(crear_app()).get('/clases').json()]
+    assert nombres == ['Funcional', 'Yoga', 'Spinning']
+
+
+# --- Correos ---------------------------------------------------------------
+
+def test_fecha_del_correo_en_hora_de_montevideo():
+    assert correo.fecha_y_hora(db.a_fecha('2026-11-12T19:00:00-03:00')) == '12/11 a las 19:00'
