+            if nuevo != db.a_fecha(c['inicio']):
+                cambio['inicio'] = db.a_texto(nuevo)
+                nuevos_inicios[c['id']] = nuevo
+        if datos.instructor is not None:
+            cambio['instructor'] = datos.instructor
+        if datos.cupo is not None:
+            if db.confirmadas(c['id']) > datos.cupo:
