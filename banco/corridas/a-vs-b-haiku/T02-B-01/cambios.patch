diff --git a/tests/test_filtros_clases.py b/tests/test_filtros_clases.py
new file mode 100644
index 0000000..c6f3698
--- /dev/null
+++ b/tests/test_filtros_clases.py
@@ -0,0 +1,135 @@
+from datetime import datetime, timedelta
+
+from conftest import AHORA, auth
+from pulso import db, reloj
+
+
+def en_montevideo(*args):
+    """Momento en hora de Montevideo (UTC-3)."""
+    return datetime(*args, tzinfo=reloj.MONTEVIDEO)
+
+
+def nombres(r):
+    return [c['nombre'] for c in r.json()]
+
+
+def test_desde_y_hasta_incluyen_los_extremos_por_dia_de_montevideo(cliente):
+    db.crear_clase('Antes', 'Leo', en_montevideo(2026, 11, 11, 23, 59))
+    db.crear_clase('Primera', 'Leo', en_montevideo(2026, 11, 12, 0, 0))
+    db.crear_clase('Ultima', 'Leo', en_montevideo(2026, 11, 14, 23, 59))
+    db.crear_clase('Despues', 'Leo', en_montevideo(2026, 11, 15, 0, 0))
+    r = cliente.get('/clases', params={'desde': '2026-11-12', 'hasta': '2026-11-14'})
+    assert r.status_code == 200
+    assert nombres(r) == ['Primera', 'Ultima']
+    assert r.headers['X-Total'] == '2'
+
+
+def test_dia_en_montevideo_aunque_en_utc_sea_otro_dia(cliente):
+    # 23:30 del 11/11 en Montevideo son las 02:30 UTC del 12/11.
+    db.crear_clase('Noche', 'Leo', en_montevideo(2026, 11, 11, 23, 30))
+    assert nombres(cliente.get('/clases', params={'desde': '2026-11-11', 'hasta': '2026-11-11'})) == ['Noche']
+    assert nombres(cliente.get('/clases', params={'desde': '2026-11-12'})) == []
+
+
+def test_desde_y_hasta_por_separado(cliente):
+    db.crear_clase('Lunes', 'Leo', en_montevideo(2026, 11, 16, 10, 0))
+    db.crear_clase('Jueves', 'Leo', en_montevideo(2026, 11, 19, 10, 0))
+    assert nombres(cliente.get('/clases', params={'desde': '2026-11-17'})) == ['Jueves']
+    assert nombres(cliente.get('/clases', params={'hasta': '2026-11-16'})) == ['Lunes']
+
+
+def test_filtro_por_instructor_exacto_sin_distinguir_mayusculas(cliente):
+    db.crear_clase('Yoga', 'Sofía', AHORA + timedelta(hours=2))
+    db.crear_clase('Spinning', 'Leo', AHORA + timedelta(hours=3))
+    assert nombres(cliente.get('/clases', params={'instructor': 'SOFÍA'})) == ['Yoga']
+    assert nombres(cliente.get('/clases', params={'instructor': 'leo'})) == ['Spinning']
+    assert nombres(cliente.get('/clases', params={'instructor': 'Sof'})) == []
+    assert nombres(cliente.get('/clases', params={'instructor': 'Sofia'})) == []
+
+
+def test_con_lugar_deja_solo_clases_con_lugares_libres(cliente):
+    llena = db.crear_clase('Llena', 'Leo', AHORA + timedelta(hours=2), cupo=1)
+    db.crear_reserva(db.crear_socio('Juan', 'juan@example.com')['id'], llena['id'], AHORA)
+    db.crear_clase('Libre', 'Leo', AHORA + timedelta(hours=3), cupo=2)
+    assert nombres(cliente.get('/clases', params={'con_lugar': 'true'})) == ['Libre']
+    assert nombres(cliente.get('/clases', params={'con_lugar': 'false'})) == ['Llena', 'Libre']
+    assert nombres(cliente.get('/clases')) == ['Llena', 'Libre']
+
+
+def test_reservas_canceladas_no_ocupan_lugar(cliente):
+    clase = db.crear_clase('Yoga', 'Leo', AHORA + timedelta(hours=2), cupo=1)
+    db.crear_reserva(db.crear_socio('Juan', 'juan@example.com')['id'], clase['id'], AHORA, estado='cancelada')
+    assert nombres(cliente.get('/clases', params={'con_lugar': 'true'})) == ['Yoga']
+
+
+def test_clases_ya_empezadas_nunca_se_listan_con_filtros(cliente):
+    db.crear_clase('Empezada', 'Leo', AHORA - timedelta(minutes=1))
+    db.crear_clase('Futura', 'Leo', AHORA + timedelta(minutes=1))
+    r = cliente.get('/clases', params={'desde': '2026-11-10', 'hasta': '2026-11-10'})
+    assert nombres(r) == ['Futura']
+    assert r.headers['X-Total'] == '1'
+
+
+def test_paginado_mantiene_orden_e_indica_total(cliente):
+    for i in range(5):
+        db.crear_clase(f'C{i}', 'Leo', AHORA + timedelta(hours=i + 1))
+    r = cliente.get('/clases', params={'por_pagina': 2, 'pagina': 2})
+    assert nombres(r) == ['C2', 'C3']
+    assert r.headers['X-Total'] == '5'
+    assert nombres(cliente.get('/clases', params={'por_pagina': 2, 'pagina': 3})) == ['C4']
+
+
+def test_pagina_mas_alla_del_final_devuelve_lista_vacia(cliente):
+    db.crear_clase('Yoga', 'Leo', AHORA + timedelta(hours=2))
+    r = cliente.get('/clases', params={'pagina': 9})
+    assert r.status_code == 200
+    assert r.json() == []
+    assert r.headers['X-Total'] == '1'
+
+
+def test_valores_por_defecto(cliente):
+    for i in range(25):
+        db.crear_clase(f'C{i:02d}', 'Leo', AHORA + timedelta(hours=i + 1))
+    r = cliente.get('/clases')
+    assert len(r.json()) == 20
+    assert r.headers['X-Total'] == '25'
+    assert nombres(cliente.get('/clases', params={'pagina': 1, 'por_pagina': 50})) == [f'C{i:02d}' for i in range(25)]
+
+
+def test_combina_todos_los_filtros(cliente):
+    db.crear_clase('Yoga', 'Sofía', en_montevideo(2026, 11, 12, 9, 0), cupo=3)
+    db.crear_clase('Spinning', 'Sofía', en_montevideo(2026, 11, 13, 9, 0), cupo=1)
+    llena = db.crear_clase('Pilates', 'Sofía', en_montevideo(2026, 11, 13, 10, 0), cupo=1)
+    db.crear_reserva(db.crear_socio('Juan', 'juan@example.com')['id'], llena['id'], AHORA)
+    db.crear_clase('Funcional', 'Leo', en_montevideo(2026, 11, 13, 11, 0), cupo=3)
+    r = cliente.get('/clases', params={'desde': '2026-11-12', 'hasta': '2026-11-14',
+                                       'instructor': 'sofía', 'con_lugar': 'true'})
+    assert nombres(r) == ['Yoga', 'Spinning']
+    assert r.headers['X-Total'] == '2'
+
+
+def test_respuesta_mantiene_formato_de_clase(cliente):
+    db.crear_clase('Yoga', 'Sofía', AHORA + timedelta(hours=2))
+    [clase] = cliente.get('/clases').json()
+    assert set(clase) == {'id', 'nombre', 'instructor', 'inicio', 'duracion_min', 'cupo', 'lugares_libres'}
+
+
+def test_fechas_invalidas_dan_422(cliente):
+    for params in ({'desde': '2026-11-1'}, {'hasta': '2026/11/12'}, {'desde': '2026-02-30'},
+                   {'desde': '20261112'}, {'desde': '2026-11-12T10:00'}, {'hasta': 'mañana'}):
+        assert cliente.get('/clases', params=params).status_code == 422, params
+
+
+def test_desde_posterior_a_hasta_da_422(cliente):
+    r = cliente.get('/clases', params={'desde': '2026-11-14', 'hasta': '2026-11-12'})
+    assert r.status_code == 422
+
+
+def test_desde_igual_a_hasta_es_valido(cliente):
+    assert cliente.get('/clases', params={'desde': '2026-11-12', 'hasta': '2026-11-12'}).status_code == 200
+
+
+def test_pagina_y_por_pagina_fuera_de_rango_dan_422(cliente):
+    for params in ({'pagina': 0}, {'pagina': -1}, {'por_pagina': 0}, {'por_pagina': 51}, {'pagina': 'x'}):
+        assert cliente.get('/clases', params=params).status_code == 422, params
+    assert cliente.get('/clases', params={'por_pagina': 50}).status_code == 200
