+@router.patch('/admin/series/{serie_id}', dependencies=[Depends(admin)])
+def cambiar_serie(serie_id: int, datos: CambioSerie):
+    serie = db.serie(serie_id)
+    if serie is None:
+        raise HTTPException(404, 'No existe la serie')
+    todas = db.clases_de_serie(serie_id)
+    base = next((c for c in todas if c['id'] == datos.desde_clase_id), None)
+    if base is None:
+        raise HTTPException(404, 'La clase no es de la serie')
+    if datos.hora is None and datos.instructor is None and datos.cupo is None:
+        raise HTTPException(422, 'No hay cambios')
