+from urllib.parse import unquote_plus
+
+import httpx
+import pytest
+
+from conftest import ADMIN, auth
+from pulso import beneficios, db
+
+CLAVE = 'clave-beneficios'
+URL = 'https://beneficios.test'
+
+
+class FakeBeneficios:
+    """Servicio de beneficios falso. Decodifica el path como formulario, igual que el real."""
+
+    def __init__(self):
+        self.empresas = set()
+        self.empleados = {}  # (empresa, email en minúsculas) -> activo
+        self.fallas = {}     # email -> función que devuelve una respuesta o lanza una excepción
+        self.pedidos = []
+
+    def responder(self, request):
+        self.pedidos.append(request)
+        if request.headers.get('X-Api-Key') != CLAVE:
+            return httpx.Response(401, json={'error': 'clave_invalida'})
+        partes = request.url.raw_path.decode().split('/')
+        i = partes.index('empresas')
+        empresa, email = unquote_plus(partes[i + 1]), unquote_plus(partes[i + 3])
+        if email in self.fallas:
+            return self.fallas[email](request)
+        if empresa not in self.empresas:
+            return httpx.Response(404, json={'error': 'empresa_desconocida'})
+        if (empresa, email) not in self.empleados:
+            return httpx.Response(404, json={'error': 'empleado_desconocido'})
+        return httpx.Response(200, json={'activo': self.empleados[(empresa, email)]})
+
+    def empleado(self, empresa, email, activo=True):
+        self.empresas.add(empresa)
+        self.empleados[(empresa, email)] = activo
+
+
+@pytest.fixture
+def servicio(monkeypatch):
+    monkeypatch.setenv('PULSO_BENEFICIOS_URL', URL)
+    monkeypatch.setenv('PULSO_BENEFICIOS_CLAVE', CLAVE)
+    fake = FakeBeneficios()
+    monkeypatch.setattr(beneficios, '_transporte', httpx.MockTransport(fake.responder))
+    return fake
+
+
+def sin_conexion(request):
+    raise httpx.ConnectError('sin conexión', request=request)
+
+
+def sin_respuesta(request):
+    raise httpx.ReadTimeout('tardó más de 3 segundos', request=request)
+
+
+def asuntos():
+    return [c['asunto'] for c in db.correos()]
+
+
+def activar(cliente, socio, empresa='acme'):
+    return cliente.post('/convenio', json={'empresa': empresa}, headers=auth(socio))
+
+
+def revalidar(cliente):
+    return cliente.post('/admin/revalidar-convenios', headers=ADMIN)
+
+
+# Activación
+
+def test_activa_plan_corporativo_con_piso_de_12(cliente, servicio, socio):
+    servicio.empleado('acme', 'ana@example.com')
+    r = activar(cliente, socio)
+    assert r.status_code == 200
+    assert r.json() == {'plan': 'corporativo', 'empresa': 'acme', 'creditos': 12}
+    assert cliente.get('/yo', headers=auth(socio)).json()['plan'] == 'corporativo'
+    assert asuntos() == ['Ya tenés el plan corporativo']
+    assert db.correos()[0]['para'] == 'ana@example.com'
+
+
+def test_piso_de_creditos_no_suma(cliente, servicio):
+    servicio.empleado('acme', 'ana@example.com')
+    pocos = db.crear_socio('Ana', 'ana@example.com', creditos=3)
+    assert activar(cliente, pocos).json()['creditos'] == 12
+    muchos = db.crear_socio('Juan', 'juan@example.com', creditos=20)
+    servicio.empleado('acme', 'juan@example.com')
+    assert activar(cliente, muchos).json()['creditos'] == 20
+    assert cliente.get('/yo', headers=auth(muchos)).json()['creditos'] == 20
+
+
+def test_email_va_en_minusculas_y_codificado_entero(cliente, servicio):
+    socio = db.crear_socio('Ana', 'Ana.Perez+Gym@Example.com')
+    servicio.empleado('acme', 'ana.perez+gym@example.com')
+    r = activar(cliente, socio)
+    assert r.status_code == 200
+    pedido = servicio.pedidos[-1]
+    assert pedido.url.raw_path == b'/empresas/acme/empleados/ana.perez%2Bgym%40example.com'
+    assert pedido.headers['X-Api-Key'] == CLAVE
+
+
+def test_usa_la_clave_y_url_del_entorno_en_cada_consulta(cliente, servicio, socio, monkeypatch):
+    servicio.empleado('acme', 'ana@example.com')
+    monkeypatch.setenv('PULSO_BENEFICIOS_URL', URL + '/otro')
+    assert activar(cliente, socio).status_code == 200
+    assert servicio.pedidos[-1].url.raw_path.startswith(b'/otro/empresas/acme/')
+
+
+def test_consulta_con_timeout_de_3_segundos(cliente, servicio, socio):
+    servicio.empleado('acme', 'ana@example.com')
+    activar(cliente, socio)
+    assert servicio.pedidos[-1].extensions['timeout']['read'] == 3.0
+
+
+def test_sin_token_401_sin_consultar(cliente, servicio):
+    r = cliente.post('/convenio', json={'empresa': 'acme'})
+    assert r.status_code == 401
+    assert servicio.pedidos == []
+
+
+@pytest.mark.parametrize('cuerpo', [{}, {'empresa': ''}, {'empresa': '   '}, {'empresa': None}])
+def test_empresa_faltante_o_vacia_422(cliente, servicio, socio, cuerpo):
+    assert cliente.post('/convenio', json=cuerpo, headers=auth(socio)).status_code == 422
+    assert servicio.pedidos == []
+
+
+def test_no_activa_si_no_es_empleado_activo(cliente, servicio, socio):
+    servicio.empleado('acme', 'ana@example.com', activo=False)
+    assert activar(cliente, socio).status_code == 409
+    assert cliente.get('/yo', headers=auth(socio)).json()['plan'] == 'basico'
+    assert cliente.get('/yo', headers=auth(socio)).json()['creditos'] == 8
+    assert asuntos() == []
+
+
+def test_no_activa_si_el_servicio_no_conoce_al_empleado(cliente, servicio, socio):
+    servicio.empresas.add('acme')
+    assert activar(cliente, socio).status_code == 409
+    assert cliente.get('/yo', headers=auth(socio)).json()['plan'] == 'basico'
+    assert asuntos() == []
+
+
+def test_empresa_inexistente_404(cliente, servicio, socio):
+    assert activar(cliente, socio, empresa='nadie').status_code == 404
+    assert cliente.get('/yo', headers=auth(socio)).json()['plan'] == 'basico'
+    assert asuntos() == []
+
+
+@pytest.mark.parametrize('falla', [
+    lambda r: httpx.Response(500, text='<html>error</html>'),
+    lambda r: httpx.Response(503, json={'error': 'mantenimiento'}),
+    lambda r: httpx.Response(401, json={'error': 'clave_invalida'}),
+    lambda r: httpx.Response(200, text='no es json'),
+    lambda r: httpx.Response(200, json={'activo': 'si'}),
+    lambda r: httpx.Response(200, json=['activo']),
+    lambda r: httpx.Response(404, text='no encontrado'),
+    lambda r: httpx.Response(404, json={'error': 'otra_cosa'}),
+    sin_conexion,
+    sin_respuesta,
+])
+def test_falla_del_servicio_503_sin_cambios(cliente, servicio, socio, falla):
+    servicio.empleado('acme', 'ana@example.com')
+    servicio.fallas['ana@example.com'] = falla
+    assert activar(cliente, socio).status_code == 503
+    assert cliente.get('/yo', headers=auth(socio)).json()['plan'] == 'basico'
+    assert cliente.get('/yo', headers=auth(socio)).json()['creditos'] == 8
+    assert asuntos() == []
+
+
+def test_clave_mal_configurada_503(cliente, servicio, socio, monkeypatch):
+    servicio.empleado('acme', 'ana@example.com')
+    monkeypatch.setenv('PULSO_BENEFICIOS_CLAVE', 'vencida')
+    assert activar(cliente, socio).status_code == 503
+
+
+def test_ya_corporativo_409_sin_cambios_ni_correo(cliente, servicio, socio):
+    servicio.empleado('acme', 'ana@example.com')
+    assert activar(cliente, socio).status_code == 200
+    pedidos = len(servicio.pedidos)
+    assert activar(cliente, socio).status_code == 409
+    assert activar(cliente, socio, empresa='otra').status_code == 409
+    assert len(servicio.pedidos) == pedidos
+    assert cliente.get('/yo', headers=auth(socio)).json()['creditos'] == 12
+    assert asuntos() == ['Ya tenés el plan corporativo']
+
+
+def test_ya_corporativo_con_otra_empresa_409(cliente, servicio, socio):
+    servicio.empleado('acme', 'ana@example.com')
+    servicio.empleado('otra', 'ana@example.com')
+    activar(cliente, socio, empresa='acme')
+    r = activar(cliente, socio, empresa='otra')
+    assert r.status_code == 409
+    assert db.corporativos()[0]['empresa'] == 'acme'
+
+
+# Revalidación
+
+def test_revalidar_exige_clave_de_administracion(cliente, servicio):
+    assert cliente.post('/admin/revalidar-convenios').status_code == 401
+    assert cliente.post('/admin/revalidar-convenios', headers={'X-Admin-Key': 'otra'}).status_code == 401
+
+
+def test_revalidar_sigue_sin_cambios_si_sigue_activo(cliente, servicio, socio):
+    servicio.empleado('acme', 'ana@example.com')
+    activar(cliente, socio)
+    n_correos = len(db.correos())
+    assert revalidar(cliente).json() == {'siguen': 1, 'bajaron': 0, 'sin_revisar': 0}
+    assert cliente.get('/yo', headers=auth(socio)).json()['plan'] == 'corporativo'
+    assert cliente.get('/yo', headers=auth(socio)).json()['creditos'] == 12
+    assert len(db.correos()) == n_correos
+
+
+@pytest.mark.parametrize('cambio', ['inactivo', 'desconocido', 'empresa_borrada'])
+def test_revalidar_baja_a_basico_conservando_creditos(cliente, servicio, socio, cambio):
+    servicio.empleado('acme', 'ana@example.com')
+    activar(cliente, socio)
+    if cambio == 'inactivo':
+        servicio.empleados[('acme', 'ana@example.com')] = False
+    elif cambio == 'desconocido':
+        del servicio.empleados[('acme', 'ana@example.com')]
+    else:
+        servicio.empresas.discard('acme')
+    assert revalidar(cliente).json() == {'siguen': 0, 'bajaron': 1, 'sin_revisar': 0}
+    yo = cliente.get('/yo', headers=auth(socio)).json()
+    assert yo['plan'] == 'basico'
+    assert yo['creditos'] == 12
+    assert asuntos()[-1] == 'Se terminó tu plan corporativo'
+    assert db.correos()[-1]['para'] == 'ana@example.com'
+
+
+def test_socio_dado_de_baja_puede_volver_a_activar(cliente, servicio, socio):
+    servicio.empleado('acme', 'ana@example.com')
+    activar(cliente, socio)
+    db.sumar_creditos(socio['id'], 10)  # queda con 22
+    servicio.empleados[('acme', 'ana@example.com')] = False
+    revalidar(cliente)
+    servicio.empleados[('acme', 'ana@example.com')] = True
+    r = activar(cliente, socio, empresa='acme')
+    assert r.status_code == 200
+    assert r.json() == {'plan': 'corporativo', 'empresa': 'acme', 'creditos': 22}
+    assert asuntos() == ['Ya tenés el plan corporativo', 'Se terminó tu plan corporativo',
+                         'Ya tenés el plan corporativo']
+
+
+def test_revalidar_usa_la_empresa_con_la_que_activo(cliente, servicio):
+    ana = db.crear_socio('Ana', 'ana@example.com')
+    juan = db.crear_socio('Juan', 'juan@example.com')
+    servicio.empleado('acme', 'ana@example.com')
+    servicio.empleado('otra', 'juan@example.com')
+    activar(cliente, ana, empresa='acme')
+    activar(cliente, juan, empresa='otra')
+    servicio.pedidos.clear()
+    assert revalidar(cliente).json() == {'siguen': 2, 'bajaron': 0, 'sin_revisar': 0}
+    rutas = sorted(p.url.raw_path for p in servicio.pedidos)
+    assert rutas == [b'/empresas/acme/empleados/ana%40example.com',
+                     b'/empresas/otra/empleados/juan%40example.com']
+
+
+def test_revalidar_falla_para_un_socio_no_cambia_ese_y_sigue_con_los_demas(cliente, servicio):
+    ana = db.crear_socio('Ana', 'ana@example.com')
+    juan = db.crear_socio('Juan', 'juan@example.com')
+    servicio.empleado('acme', 'ana@example.com')
+    servicio.empleado('acme', 'juan@example.com')
+    activar(cliente, ana)
+    activar(cliente, juan)
+    servicio.empleados[('acme', 'juan@example.com')] = False
+    servicio.fallas['ana@example.com'] = lambda r: httpx.Response(500, text='caído')
+    assert revalidar(cliente).json() == {'siguen': 0, 'bajaron': 1, 'sin_revisar': 1}
+    assert cliente.get('/yo', headers=auth(ana)).json()['plan'] == 'corporativo'
+    assert cliente.get('/yo', headers=auth(juan)).json()['plan'] == 'basico'
+
+
+def test_revalidar_con_servicio_caido_responde_200(cliente, servicio):
+    socios = [db.crear_socio(f'Socio {i}', f'socio{i}@example.com') for i in range(3)]
+    for s in socios:
+        servicio.empleado('acme', s['email'])
+        activar(cliente, s)
+    servicio.fallas = {s['email']: sin_conexion for s in socios}
+    assert revalidar(cliente).json() == {'siguen': 0, 'bajaron': 0, 'sin_revisar': 3}
+    assert all(cliente.get('/yo', headers=auth(s)).json()['plan'] == 'corporativo' for s in socios)
+
+
+def test_revalidar_sin_socios_corporativos(cliente, servicio):
+    assert revalidar(cliente).json() == {'siguen': 0, 'bajaron': 0, 'sin_revisar': 0}
