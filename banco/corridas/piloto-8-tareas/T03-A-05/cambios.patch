diff --git a/pulso/main.py b/pulso/main.py
index 039212d..3f557d3 100644
--- a/pulso/main.py
+++ b/pulso/main.py
@@ -1,6 +1,10 @@
+import csv
+import io
 import os
+import re
+from datetime import date
 
-from fastapi import APIRouter, Depends, FastAPI, Header, HTTPException
+from fastapi import APIRouter, Depends, FastAPI, Header, HTTPException, Response
 from pydantic import AwareDatetime, BaseModel, Field
 
 from pulso import correo, db, reloj
@@ -57,6 +61,41 @@ def crear_clase(datos: NuevaClase):
     return ver_clase(db.crear_clase(**datos.model_dump()))
 
 
+def _parsear_dia(texto, nombre):
+    if not texto or not re.fullmatch(r'\d{4}-\d{2}-\d{2}', texto):
+        raise HTTPException(422, f'"{nombre}" es obligatorio con formato YYYY-MM-DD')
+    try:
+        return date.fromisoformat(texto)
+    except ValueError:
+        raise HTTPException(422, f'"{nombre}" no es una fecha válida')
+
+
+@router.get('/admin/ocupacion.csv', dependencies=[Depends(admin)])
+def ocupacion_csv(desde: str | None = None, hasta: str | None = None):
+    d = _parsear_dia(desde, 'desde')
+    h = _parsear_dia(hasta, 'hasta')
+    if d > h:
+        raise HTTPException(422, '"desde" es posterior a "hasta"')
+    if (h - d).days + 1 > 31:
+        raise HTTPException(422, 'El período no puede superar los 31 días')
+    salida = io.StringIO()
+    escritor = csv.writer(salida, lineterminator='\r\n')
+    escritor.writerow(['fecha', 'hora', 'clase', 'instructor', 'cupo', 'confirmadas', 'ocupacion_pct'])
+    filas = []
+    for c in db.clases():
+        inicio = db.a_fecha(c['inicio']).astimezone(reloj.MONTEVIDEO)
+        if d <= inicio.date() <= h:
+            filas.append((inicio, c))
+    filas.sort(key=lambda f: (f[0], f[1]['id']))
+    for inicio, c in filas:
+        conf = db.confirmadas(c['id'])
+        # Entero con ,5 hacia arriba (sin errores de coma flotante).
+        pct = (conf * 200 + c['cupo']) // (2 * c['cupo']) if c['cupo'] > 0 else 0
+        escritor.writerow([inicio.strftime('%Y-%m-%d'), inicio.strftime('%H:%M'), c['nombre'],
+                           c['instructor'], c['cupo'], conf, pct])
+    return Response(salida.getvalue(), media_type='text/csv; charset=utf-8')
+
+
 class NuevaReserva(BaseModel):
     clase_id: int
 
