diff --git a/tests/test_series.py b/tests/test_series.py
new file mode 100644
index 0000000..f45ff5d
--- /dev/null
+++ b/tests/test_series.py
@@ -0,0 +1,133 @@
+from datetime import timedelta
+
+from conftest import ADMIN, AHORA, auth
+from pulso import db
+
+SERIE = {'nombre': 'Yoga', 'instructor': 'Sofía', 'dia': 'martes', 'hora': '19:00', 'duracion_min': 60,
+         'cupo': 15, 'desde': '2026-11-10', 'hasta': '2026-12-01'}
+
+
+def crear(cliente, **cambios):
+    return cliente.post('/admin/series', json={**SERIE, **cambios}, headers=ADMIN)
+
+
+def test_crea_serie_semanal(cliente):
+    r = crear(cliente)
+    assert r.status_code == 201
+    clases = r.json()['clases']
+    assert [c['inicio'] for c in clases] == ['2026-11-10T22:00:00+00:00', '2026-11-17T22:00:00+00:00',
+                                             '2026-11-24T22:00:00+00:00', '2026-12-01T22:00:00+00:00']
+    assert clases[0]['serie_id'] == r.json()['id'] and clases[0]['estado'] == 'programada'
+    assert cliente.get(f"/admin/series/{r.json()['id']}", headers=ADMIN).json() == r.json()
+
+
+def test_serie_omite_cierres_y_pasadas(cliente):
+    r = crear(cliente, dia='viernes', hora='12:00', desde='2026-11-10', hasta='2027-01-02')
+    fechas = [c['inicio'][:10] for c in r.json()['clases']]
+    assert '2026-12-25' not in fechas and '2027-01-01' not in fechas
+    r = crear(cliente, hora='12:00')  # martes 10/11 12:00 es ahora: no se crea
+    assert r.json()['clases'][0]['inicio'].startswith('2026-11-17')
+
+
+def test_serie_sin_clases_es_valida(cliente):
+    assert crear(cliente, desde='2026-11-11', hasta='2026-11-12').json()['clases'] == []
+
+
+def test_serie_invalida(cliente):
+    for cambio in ({'dia': 'martes '}, {'dia': 'miercoles'}, {'hora': '24:00'}, {'hora': '9:00'}, {'nombre': ''},
+                   {'instructor': ''}, {'cupo': 0}, {'duracion_min': 0}, {'hasta': '2026-11-09'},
+                   {'hasta': '2027-11-12'}):
+        assert crear(cliente, **cambio).status_code == 422, cambio
+    assert cliente.post('/admin/series', json={'nombre': 'x'}, headers=ADMIN).status_code == 422
+    assert crear(cliente, hasta='2027-11-11').status_code == 201  # 366 días
+    assert cliente.post('/admin/series', json=SERIE).status_code == 401
+
+
+def test_cambia_desde_una_clase(cliente, socio):
+    s = crear(cliente).json()
+    c = s['clases']
+    db.crear_reserva(socio['id'], c[2]['id'], AHORA)
+    r = cliente.patch(f"/admin/series/{s['id']}", json={'desde_clase_id': c[1]['id'], 'hora': '20:00',
+                                                         'instructor': 'Leo'}, headers=ADMIN)
+    assert r.status_code == 200
+    out = r.json()
+    assert out['hora'] == '20:00' and out['instructor'] == 'Leo'
+    assert [x['inicio'][11:16] for x in out['clases']] == ['22:00', '23:00', '23:00', '23:00']
+    assert [x['instructor'] for x in out['clases']] == ['Sofía', 'Leo', 'Leo', 'Leo']
+    assert out['clases'][2]['id'] == c[2]['id']
+    correos = db.correos()
+    assert [x['asunto'] for x in correos] == ['Cambio de horario: Yoga el 24/11 a las 20:00']
+
+
+def test_cambio_de_cupo_no_manda_correo_y_respeta_canceladas(cliente, socio):
+    s = crear(cliente).json()
+    c = s['clases']
+    db.crear_reserva(socio['id'], c[1]['id'], AHORA)
+    assert cliente.post(f"/admin/clases/{c[2]['id']}/cancelar", headers=ADMIN).status_code == 200
+    antes = len(db.correos())
+    r = cliente.patch(f"/admin/series/{s['id']}", json={'desde_clase_id': c[0]['id'], 'cupo': 5},
+                      headers=ADMIN)
+    assert r.status_code == 200
+    assert len(db.correos()) == antes
+    clases = r.json()['clases']
+    assert clases[2]['cupo'] == 15 and clases[2]['estado'] == 'cancelada'
+    assert clases[3]['cupo'] == 5 and clases[0]['cupo'] == 5
+
+
+def test_cambio_rechazado_con_409_no_cambia_nada(cliente, socio, tmp_path):
+    s = crear(cliente).json()
+    c = s['clases']
+    db.crear_reserva(socio['id'], c[1]['id'], AHORA)
+    url = f"/admin/series/{s['id']}"
+    # cupo menor que reservas
+    db.crear_reserva(db.crear_socio('B', 'b@x.com')['id'], c[1]['id'], AHORA)
+    assert cliente.patch(url, json={'desde_clase_id': c[0]['id'], 'cupo': 1, 'instructor': 'Z'},
+                         headers=ADMIN).status_code == 409
+    # hora que deja la primera clase (hoy) en el pasado
+    assert cliente.patch(url, json={'desde_clase_id': c[0]['id'], 'hora': '11:00'}, headers=ADMIN).status_code == 409
+    # clase base ya empezada
+    from pulso import reloj
+    reloj.fijar(AHORA + timedelta(hours=8))
+    assert cliente.patch(url, json={'desde_clase_id': c[0]['id'], 'cupo': 20}, headers=ADMIN).status_code == 409
+    campos = ('id', 'inicio', 'cupo', 'instructor')
+    despues = cliente.get(url, headers=ADMIN).json()['clases']
+    assert [{k: x[k] for k in campos} for x in despues] == [{k: x[k] for k in campos} for x in s['clases']]
+
+
+def test_cambio_404_y_422(cliente):
+    s = crear(cliente).json()
+    otra = db.crear_clase('X', 'Y', AHORA + timedelta(days=1))
+    url = f"/admin/series/{s['id']}"
+    assert cliente.patch('/admin/series/99', json={'desde_clase_id': 1, 'cupo': 3}, headers=ADMIN).status_code == 404
+    assert cliente.patch(url, json={'desde_clase_id': otra['id'], 'cupo': 3}, headers=ADMIN).status_code == 404
+    assert cliente.patch(url, json={'desde_clase_id': s['clases'][0]['id']}, headers=ADMIN).status_code == 422
+    assert cliente.patch(url, json={'desde_clase_id': s['clases'][0]['id'], 'cupo': 0}, headers=ADMIN).status_code == 422
+    assert cliente.patch(url, json={'desde_clase_id': s['clases'][0]['id'], 'hora': '7'}, headers=ADMIN).status_code == 422
+    assert cliente.patch(url, json={'cupo': 3}, headers=ADMIN).status_code == 422
+    assert cliente.patch(url, json={'desde_clase_id': 1, 'cupo': 3}).status_code == 401
+
+
+def test_cancelar_clase(cliente, socio):
+    s = crear(cliente).json()
+    c = s['clases'][1]
+    assert cliente.post('/reservas', json={'clase_id': c['id']}, headers=auth(socio)).status_code == 201
+    r = cliente.post(f"/admin/clases/{c['id']}/cancelar", headers=ADMIN)
+    assert r.status_code == 200 and r.json()['estado'] == 'cancelada' and r.json()['lugares_libres'] == 15
+    assert cliente.get('/yo', headers=auth(socio)).json()['creditos'] == 8
+    assert db.correos()[-1]['asunto'] == 'Clase cancelada: Yoga el 17/11 a las 19:00'
+    assert db.reservas_de(socio['id'])[0]['estado'] == 'cancelada'
+    assert c['id'] not in [x['id'] for x in cliente.get('/clases').json()]
+    assert cliente.get(f"/clases/{c['id']}").json()['estado'] == 'cancelada'
+    r = cliente.post('/reservas', json={'clase_id': c['id']}, headers=auth(socio))
+    assert r.status_code == 409 and r.json()['detail'] == 'La clase está cancelada'
+    assert cliente.post(f"/admin/clases/{c['id']}/cancelar", headers=ADMIN).status_code == 409
+    assert cliente.post('/admin/clases/999/cancelar', headers=ADMIN).status_code == 404
+    assert cliente.post(f"/admin/clases/{c['id']}/cancelar").status_code == 401
+
+
+def test_cancelar_clase_empezada_y_suelta(cliente):
+    vieja = db.crear_clase('A', 'B', AHORA - timedelta(hours=1))
+    assert cliente.post(f"/admin/clases/{vieja['id']}/cancelar", headers=ADMIN).status_code == 409
+    suelta = db.crear_clase('A', 'B', AHORA + timedelta(hours=1))
+    assert suelta['serie_id'] is None and suelta['estado'] == 'programada'
+    assert cliente.post(f"/admin/clases/{suelta['id']}/cancelar", headers=ADMIN).status_code == 200
