+
+def referencia(compra_id):
+    return f'{PREFIJO_REFERENCIA}{compra_id}'
+
+
+def compra_de_referencia(ref):
+    if not isinstance(ref, str) or not ref.startswith(PREFIJO_REFERENCIA):
+        return None
+    texto = ref.removeprefix(PREFIJO_REFERENCIA)
+    if not (texto.isascii() and texto.isdigit()) or texto != str(int(texto)):
+        return None
+    return db.compra(int(texto))
+
+
+def aplicar_pago(compra, pago):
+    """Aplica el estado de un pago de Cobrá a la compra. Devuelve la compra como quedó."""
+    if compra['pago_id'] is None:
+        db.guardar_pago(compra['id'], pago['id'], pago.get('url_pago'))
+    nuevo = ESTADOS_PAGO.get(pago['estado'])
+    if nuevo:
