diff --git a/tests/test_ocupacion.py b/tests/test_ocupacion.py
new file mode 100644
index 0000000..577b81b
--- /dev/null
+++ b/tests/test_ocupacion.py
@@ -0,0 +1,53 @@
+from datetime import datetime, timezone
+
+from conftest import ADMIN
+from pulso import db
+
+URL = '/admin/ocupacion.csv'
+ENC = 'fecha,hora,clase,instructor,cupo,confirmadas,ocupacion_pct'
+
+
+def utc(*a):
+    return datetime(*a, tzinfo=timezone.utc)
+
+
+def pedir(cliente, desde='2026-11-01', hasta='2026-11-30'):
+    return cliente.get(URL, params={'desde': desde, 'hasta': hasta}, headers=ADMIN)
+
+
+def test_requiere_admin(cliente):
+    assert cliente.get(URL, params={'desde': '2026-11-01', 'hasta': '2026-11-02'}).status_code == 401
+    assert cliente.get(URL, headers={'X-Admin-Key': 'x'}).status_code == 401
+
+
+def test_validaciones(cliente):
+    for d, h in [('2026-11-01', None), (None, '2026-11-01'), ('1/11/2026', '2026-11-05'),
+                 ('2026-11-05', '2026-11-01'), ('2026-10-01', '2026-11-01'), ('2026-02-30', '2026-03-01')]:
+        params = {k: v for k, v in (('desde', d), ('hasta', h)) if v}
+        assert cliente.get(URL, params=params, headers=ADMIN).status_code == 422
+    assert pedir(cliente, '2026-10-01', '2026-10-31').status_code == 200
+
+
+def test_vacio_solo_encabezado(cliente):
+    r = pedir(cliente)
+    assert r.headers['content-type'] == 'text/csv; charset=utf-8'
+    assert r.text.splitlines() == [ENC]
+
+
+def test_filas_orden_zona_y_conteo(cliente, socio):
+    a = db.crear_clase('Yoga, "nivel" 1', 'Sofía', utc(2026, 11, 4, 22, 30), cupo=8)
+    b = db.crear_clase('Spinning', 'Leo', utc(2026, 11, 4, 10, 0), cupo=16)
+    db.crear_clase('Fuera', 'X', utc(2026, 11, 1, 2, 59))  # 31/10 23:59 en Montevideo
+    c = db.crear_clase('Noche', 'Y', utc(2026, 12, 1, 2, 0), cupo=3)  # 30/11 23:00
+    db.crear_clase('Fuera 2', 'X', utc(2026, 12, 1, 3, 0))  # 1/12 00:00
+    db.crear_reserva(socio['id'], a['id'], utc(2026, 11, 1))
+    db.crear_reserva(socio['id'], a['id'], utc(2026, 11, 1), estado='cancelada')
+    for _ in range(2):
+        db.crear_reserva(socio['id'], b['id'], utc(2026, 11, 1))
+    db.crear_reserva(socio['id'], c['id'], utc(2026, 11, 1))
+    assert pedir(cliente).text.splitlines() == [
+        ENC,
+        '2026-11-04,07:00,Spinning,Leo,16,2,13',
+        '2026-11-04,19:30,"Yoga, ""nivel"" 1",Sofía,8,1,13',
+        '2026-11-30,23:00,Noche,Y,3,1,33',
+    ]
