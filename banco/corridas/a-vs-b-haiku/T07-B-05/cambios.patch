+    compra = compras.compra_por_referencia(pago['referencia'])
+    if compra is None:
+        raise HTTPException(404, 'El pago no es de ninguna compra')
+    compra = compras.aplicar_pago(compra, pago)
+    return {'compra_id': compra['id'], 'estado': compra['estado']}
