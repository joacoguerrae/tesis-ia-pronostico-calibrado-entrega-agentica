diff --git a/tests/test_recordatorios.py b/tests/test_recordatorios.py
new file mode 100644
index 0000000..063b631
--- /dev/null
+++ b/tests/test_recordatorios.py
@@ -0,0 +1,57 @@
+from datetime import timedelta
+
+from pulso import db, reloj
+from tests.conftest import ADMIN, AHORA
+
+
+def _reserva(socio, horas, estado='confirmada', nombre='Yoga'):
+    clase = db.crear_clase(nombre, 'Laura Gómez', AHORA + timedelta(hours=horas))
+    return db.crear_reserva(socio['id'], clase['id'], AHORA, estado)
+
+
+def _llamar(cliente):
+    return cliente.post('/admin/recordatorios', headers=ADMIN)
+
+
+def test_requiere_clave(cliente):
+    assert cliente.post('/admin/recordatorios').status_code == 401
+    assert cliente.post('/admin/recordatorios', headers={'X-Admin-Key': 'mala'}).status_code == 401
+
+
+def test_manda_recordatorio_con_asunto_e_instructor(cliente, socio):
+    _reserva(socio, 3)  # 18:00 Montevideo
+    assert _llamar(cliente).json() == {'enviados': 1}
+    [c] = db.correos()
+    assert c['para'] == 'ana@example.com'
+    assert c['asunto'] == 'Recordatorio: Yoga el 10/11 a las 15:00'
+    assert 'Laura Gómez' in c['cuerpo']
+
+
+def test_ventana_de_24_horas(cliente, socio):
+    _reserva(socio, 24)  # inclusive
+    _reserva(socio, 24.01)
+    _reserva(socio, 0)  # ya empezó
+    _reserva(socio, -2)
+    assert _llamar(cliente).json() == {'enviados': 1}
+
+
+def test_una_sola_vez(cliente, socio):
+    _reserva(socio, 5)
+    assert _llamar(cliente).json() == {'enviados': 1}
+    assert _llamar(cliente).json() == {'enviados': 0}
+    reloj.fijar(AHORA + timedelta(hours=1))
+    assert _llamar(cliente).json() == {'enviados': 0}
+    assert len(db.correos()) == 1
+
+
+def test_reserva_que_entra_en_ventana_despues(cliente, socio):
+    _reserva(socio, 30)
+    assert _llamar(cliente).json() == {'enviados': 0}
+    reloj.fijar(AHORA + timedelta(hours=10))
+    assert _llamar(cliente).json() == {'enviados': 1}
+
+
+def test_ignora_no_confirmadas(cliente, socio):
+    _reserva(socio, 5, estado='cancelada')
+    assert _llamar(cliente).json() == {'enviados': 0}
+    assert db.correos() == []
