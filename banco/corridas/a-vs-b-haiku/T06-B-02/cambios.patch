+    clase = db.crear_clase('Yoga', 'Sofía', INICIO, cupo=1)
+    [reserva] = llenar(clase)
+    sin_creditos = db.crear_socio('Sin créditos', 'sin@example.com', creditos=0)
+    anotar(cliente, sin_creditos, clase)
+    anotar(cliente, socio, clase)
+
+    cliente.post(f"/admin/reservas/{reserva['id']}/cancelar", headers=ADMIN)
+
+    assert correos_para('sin@example.com') == [f'No pudimos darte el lugar: {ASUNTO}']
+    assert cliente.get('/yo', headers=auth(sin_creditos)).json()['creditos'] == 0
+    assert cliente.get(f"/clases/{clase['id']}/espera", headers=auth(sin_creditos)).status_code == 404
+    assert correos_para('ana@example.com') == [f'Se liberó un lugar: {ASUNTO}']
+    assert cliente.get('/yo', headers=auth(socio)).json()['creditos'] == 7
