diff --git a/pulso/db.py b/pulso/db.py
index 59841ac..d7d9f42 100644
--- a/pulso/db.py
+++ b/pulso/db.py
@@ -29,6 +29,10 @@ CREATE TABLE IF NOT EXISTS reservas (
     estado TEXT NOT NULL,
     creada TEXT NOT NULL
 );
+CREATE TABLE IF NOT EXISTS recordatorios (
+    reserva_id INTEGER PRIMARY KEY REFERENCES reservas(id),
+    enviado TEXT NOT NULL
+);
 CREATE TABLE IF NOT EXISTS correos (
     id INTEGER PRIMARY KEY,
     para TEXT NOT NULL,
@@ -134,5 +138,23 @@ def sumar_creditos(socio_id, cantidad):
         con.execute('UPDATE socios SET creditos = creditos + ? WHERE id = ?', (cantidad, socio_id))
 
 
+def reservas_sin_recordatorio():
+    """Reservas confirmadas sin recordatorio, con los datos de clase y socio."""
+    return _varias(
+        'SELECT r.id AS reserva_id, c.nombre AS clase, c.instructor, c.inicio, '
+        's.nombre AS socio, s.email FROM reservas r '
+        'JOIN clases c ON c.id = r.clase_id JOIN socios s ON s.id = r.socio_id '
+        "WHERE r.estado = 'confirmada' "
+        'AND r.id NOT IN (SELECT reserva_id FROM recordatorios) ORDER BY c.inicio, r.id')
+
+
+def marcar_recordatorio(reserva_id, enviado):
+    """Marca la reserva; devuelve False si ya estaba marcada."""
+    with conexion() as con:
+        cur = con.execute('INSERT OR IGNORE INTO recordatorios (reserva_id, enviado) VALUES (?, ?)',
+                          (reserva_id, a_texto(enviado)))
+    return cur.rowcount == 1
+
+
 def correos():
     return _varias('SELECT * FROM correos ORDER BY id')
diff --git a/pulso/main.py b/pulso/main.py
index 039212d..ab9b1c8 100644
--- a/pulso/main.py
+++ b/pulso/main.py
@@ -1,4 +1,5 @@
 import os
+from datetime import timedelta
 
 from fastapi import APIRouter, Depends, FastAPI, Header, HTTPException
 from pydantic import AwareDatetime, BaseModel, Field
@@ -92,6 +93,24 @@ def yo(socio=Depends(socio_actual)):
     return {k: socio[k] for k in ('id', 'nombre', 'email', 'plan', 'creditos')}
 
 
+@router.post('/admin/recordatorios', dependencies=[Depends(admin)])
+def enviar_recordatorios():
+    ahora = reloj.ahora()
+    limite = ahora + timedelta(hours=24)
+    enviados = 0
+    for r in db.reservas_sin_recordatorio():
+        inicio = db.a_fecha(r['inicio'])
+        if not ahora < inicio <= limite:
+            continue
+        if not db.marcar_recordatorio(r['reserva_id'], ahora):
+            continue
+        correo.enviar(r['email'], f"Recordatorio: {r['clase']} el {correo.fecha_y_hora(inicio)}",
+                      f"Hola {r['socio']}, te recordamos tu clase de {r['clase']} "
+                      f"con {r['instructor']}.")
+        enviados += 1
+    return {'enviados': enviados}
+
+
 def crear_app():
     db.inicializar()
     app = FastAPI(title='Pulso')
