+def crear_serie(datos, inicios):
+    """Crea la serie y una clase por cada inicio (datetimes), todo en una transacción."""
+    with conexion() as con:
+        cur = con.execute('INSERT INTO series (nombre, instructor, dia, hora, duracion_min, cupo, desde, hasta) '
+                          'VALUES (?, ?, ?, ?, ?, ?, ?, ?)',
+                          (datos['nombre'], datos['instructor'], datos['dia'], datos['hora'],
+                           datos['duracion_min'], datos['cupo'], datos['desde'], datos['hasta']))
+        serie_id = cur.lastrowid
+        for inicio in inicios:
+            con.execute('INSERT INTO clases (nombre, instructor, inicio, duracion_min, cupo, serie_id) '
+                        'VALUES (?, ?, ?, ?, ?, ?)',
+                        (datos['nombre'], datos['instructor'], a_texto(inicio), datos['duracion_min'],
+                         datos['cupo'], serie_id))
+    return serie_id
