index 0000000..f4499d5
--- /dev/null
+++ b/pulso/beneficios.py
@@ -0,0 +1,59 @@
+"""Cliente del servicio de beneficios de las empresas con convenio.
+
+Es la fuente de verdad sobre quién es empleado activo: Pulso le pregunta en cada consulta.
+La URL y la clave se leen del entorno en cada llamada.
+"""
+import os
+from urllib.parse import quote
+
+import httpx
+
+TIMEOUT_SEG = 3.0
+
+# Solo para tests: permite reemplazar el transporte HTTP.
+_transporte = None
+
+
+class EmpresaInexistente(Exception):
+    pass
+
+
+class EmpleadoDesconocido(Exception):
+    pass
+
+
+class ServicioNoDisponible(Exception):
+    pass
+
+
+def _json_objeto(respuesta):
+    try:
+        datos = respuesta.json()
+    except ValueError:
+        return None
+    return datos if isinstance(datos, dict) else None
+
+
+def consultar_activo(empresa, email):
+    """Devuelve True si el empleado está activo, False si no. Lanza una excepción si el servicio
+    dice que la empresa o el empleado no existen, o si falla de cualquier otra forma."""
+    base = os.environ.get('PULSO_BENEFICIOS_URL', '').rstrip('/')
+    clave = os.environ.get('PULSO_BENEFICIOS_CLAVE', '')
+    # El servicio decodifica el path como formulario: el email va entero codificado (+ → %2B).
+    url = f"{base}/empresas/{quote(empresa, safe='')}/empleados/{quote(email.lower(), safe='')}"
+    try:
+        with httpx.Client(transport=_transporte, timeout=TIMEOUT_SEG) as cliente:
+            respuesta = cliente.get(url, headers={'X-Api-Key': clave})
+    except (httpx.HTTPError, httpx.InvalidURL):
+        raise ServicioNoDisponible()
+
+    datos = _json_objeto(respuesta)
+    if respuesta.status_code == 200 and datos is not None and isinstance(datos.get('activo'), bool):
+        return datos['activo']
+    if respuesta.status_code == 404 and datos is not None:
+        if datos.get('error') == 'empresa_desconocida':
+            raise EmpresaInexistente()
+        if datos.get('error') == 'empleado_desconocido':
+            raise EmpleadoDesconocido()
+    # 5xx, 401 (clave inválida), respuestas fuera de contrato, etc.
+    raise ServicioNoDisponible()
diff --git a/pulso/db.py b/pulso/db.py
index 59841ac..c83b124 100644
--- a/pulso/db.py
+++ b/pulso/db.py
@@ -29,6 +29,10 @@ CREATE TABLE IF NOT EXISTS reservas (
     estado TEXT NOT NULL,
     creada TEXT NOT NULL
 );
+CREATE TABLE IF NOT EXISTS convenios (
+    socio_id INTEGER PRIMARY KEY REFERENCES socios(id),
+    empresa TEXT NOT NULL
+);
 CREATE TABLE IF NOT EXISTS correos (
     id INTEGER PRIMARY KEY,
     para TEXT NOT NULL,
@@ -134,5 +138,29 @@ def sumar_creditos(socio_id, cantidad):
         con.execute('UPDATE socios SET creditos = creditos + ? WHERE id = ?', (cantidad, socio_id))
 
 
+def activar_convenio(socio_id, empresa, piso_creditos):
+    """Pasa el socio a plan corporativo con la empresa, y sube sus créditos al piso si tiene menos.
+    Devuelve False, sin cambiar nada, si el socio ya tenía el plan corporativo."""
+    with conexion() as con:
+        cur = con.execute("UPDATE socios SET plan = 'corporativo', creditos = MAX(creditos, ?) "
+                          "WHERE id = ? AND plan <> 'corporativo'", (piso_creditos, socio_id))
+        activado = cur.rowcount == 1
+        if activado:
+            con.execute('INSERT OR REPLACE INTO convenios (socio_id, empresa) VALUES (?, ?)', (socio_id, empresa))
+    return activado
+
+
+def bajar_convenio(socio_id):
+    with conexion() as con:
+        con.execute("UPDATE socios SET plan = 'basico' WHERE id = ?", (socio_id,))
+        con.execute('DELETE FROM convenios WHERE socio_id = ?', (socio_id,))
+
+
+def corporativos():
+    """Socios con plan corporativo, con la empresa con la que lo activaron (None si no hay registro)."""
+    return _varias("SELECT s.*, c.empresa FROM socios s LEFT JOIN convenios c ON c.socio_id = s.id "
+                   "WHERE s.plan = 'corporativo' ORDER BY s.id")
+
+
 def correos():
     return _varias('SELECT * FROM correos ORDER BY id')
