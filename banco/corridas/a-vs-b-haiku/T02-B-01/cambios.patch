+from fastapi import APIRouter, Depends, FastAPI, Header, HTTPException, Query, Response
 from pydantic import AwareDatetime, BaseModel, Field
 
 from pulso import correo, db, reloj
 
 router = APIRouter()
 
+FECHA_PATRON = r'^\d{4}-\d{2}-\d{2}$'
+
 
 def socio_actual(authorization: str | None = Header(default=None)):
     if not authorization or not authorization.startswith('Bearer '):
@@ -30,10 +33,52 @@ def ver_reserva(reserva):
     return {k: reserva[k] for k in ('id', 'clase_id', 'estado', 'creada')}
 
 
+def _dia(texto, nombre):
+    if texto is None:
+        return None
+    try:
+        return date.fromisoformat(texto)
+    except ValueError:
+        raise HTTPException(422, f'{nombre} tiene que ser una fecha YYYY-MM-DD')
+
+
 @router.get('/clases')
-def listar_clases():
+def listar_clases(response: Response,
+                  desde: str | None = Query(default=None, pattern=FECHA_PATRON),
+                  hasta: str | None = Query(default=None, pattern=FECHA_PATRON),
+                  instructor: str | None = None,
+                  con_lugar: bool = False,
+                  pagina: int = Query(default=1, ge=1),
+                  por_pagina: int = Query(default=20, ge=1, le=50)):
+    dia_desde = _dia(desde, 'desde')
+    dia_hasta = _dia(hasta, 'hasta')
+    if dia_desde and dia_hasta and dia_desde > dia_hasta:
+        raise HTTPException(422, 'desde no puede ser posterior a hasta')
+    # Los días se cuentan en hora de Montevideo; el límite superior es excluyente (inicio del día siguiente).
+    desde_momento = datetime.combine(dia_desde, time.min, reloj.MONTEVIDEO) if dia_desde else None
+    hasta_momento = datetime.combine(dia_hasta + timedelta(days=1), time.min, reloj.MONTEVIDEO) if dia_hasta else None
+
     ahora = reloj.ahora()
-    return [ver_clase(c) for c in db.clases() if db.a_fecha(c['inicio']) > ahora]
+    ocupadas = db.confirmadas_por_clase()
+    encontradas = []
+    for clase in db.clases():
+        inicio = db.a_fecha(clase['inicio'])
+        if inicio <= ahora:
+            continue
+        if desde_momento and inicio < desde_momento:
+            continue
+        if hasta_momento and inicio >= hasta_momento:
+            continue
+        if instructor is not None and clase['instructor'].casefold() != instructor.casefold():
+            continue
+        libres = clase['cupo'] - ocupadas.get(clase['id'], 0)
+        if con_lugar and libres <= 0:
+            continue
+        encontradas.append(dict(clase, lugares_libres=libres))
+
+    response.headers['X-Total'] = str(len(encontradas))
+    desde_indice = (pagina - 1) * por_pagina
+    return encontradas[desde_indice:desde_indice + por_pagina]
 
 
 @router.get('/clases/{clase_id}')
