diff --git a/tests/test_base.py b/tests/test_base.py
index 5d9460b..c3406fb 100644
--- a/tests/test_base.py
+++ b/tests/test_base.py
@@ -3,6 +3,48 @@ from datetime import timedelta
 from conftest import ADMIN, AHORA, auth
 from pulso import db
 
+ENCABEZADO = 'fecha,hora,clase,instructor,cupo,confirmadas,ocupacion_pct'
+
+
+def _csv(cliente, desde='2026-11-01', hasta='2026-11-30'):
+    return cliente.get(f'/admin/ocupacion.csv?desde={desde}&hasta={hasta}', headers=ADMIN)
+
+
+def test_csv_requiere_admin(cliente):
+    assert cliente.get('/admin/ocupacion.csv?desde=2026-11-01&hasta=2026-11-30').status_code == 401
+
+
+def test_csv_validaciones(cliente):
+    for q in ('', '?desde=2026-11-01', '?hasta=2026-11-01', '?desde=01/11/2026&hasta=2026-11-30',
+              '?desde=2026-11-05&hasta=2026-11-01', '?desde=2026-10-01&hasta=2026-11-01',
+              '?desde=2026-02-30&hasta=2026-03-01'):
+        assert cliente.get('/admin/ocupacion.csv' + q, headers=ADMIN).status_code == 422, q
+    assert _csv(cliente, '2026-10-01', '2026-10-31').status_code == 200
+
+
+def test_csv_vacio(cliente):
+    r = _csv(cliente)
+    assert r.headers['content-type'] == 'text/csv; charset=utf-8'
+    assert r.text.strip() == ENCABEZADO
+
+
+def test_csv_filas(cliente, socio):
+    from datetime import datetime, timezone
+    u = lambda *a: datetime(*a, tzinfo=timezone.utc)
+    # 01/12 01:00 UTC = 30/11 22:00 en Montevideo (entra); 01/11 02:00 UTC = 31/10 23:00 (no entra).
+    db.crear_clase('Tarde', 'Ana', u(2026, 12, 1, 1, 0), cupo=8)
+    db.crear_clase('Fuera', 'Ana', u(2026, 11, 1, 2, 0))
+    y = db.crear_clase('Yoga, "nivel" 1', 'Sofía', u(2026, 11, 3, 22, 30), cupo=8)
+    db.crear_clase('Spinning', 'Leo', u(2026, 11, 3, 10, 0), cupo=8)
+    db.crear_reserva(socio['id'], y['id'], AHORA, 'confirmada')
+    db.crear_reserva(socio['id'], y['id'], AHORA, 'cancelada')
+    assert _csv(cliente).text.splitlines() == [
+        ENCABEZADO,
+        '2026-11-03,07:00,Spinning,Leo,8,0,0',
+        '2026-11-03,19:30,"Yoga, ""nivel"" 1",Sofía,8,1,13',
+        '2026-11-30,22:00,Tarde,Ana,8,0,0',
+    ]
+
 
 def test_lista_solo_clases_futuras_en_orden(cliente):
     db.crear_clase('Spinning', 'Leo', AHORA + timedelta(hours=5))
