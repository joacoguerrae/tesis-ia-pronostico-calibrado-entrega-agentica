+def clases_con_lugares_libres():
+    """Todas las clases con `lugares_libres` calculado en la misma consulta."""
+    return _varias('SELECT c.*, c.cupo - (SELECT COUNT(*) FROM reservas r '
+                   "WHERE r.clase_id = c.id AND r.estado = 'confirmada') AS lugares_libres "
+                   'FROM clases c ORDER BY c.inicio, c.id')
+
+
 def confirmadas(clase_id):
     return _una("SELECT COUNT(*) AS n FROM reservas WHERE clase_id = ? AND estado = 'confirmada'", (clase_id,))['n']
 
