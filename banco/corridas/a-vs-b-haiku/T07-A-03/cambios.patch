index 0000000..9b5558e
--- /dev/null
+++ b/pulso/cobra.py
@@ -0,0 +1,55 @@
+"""Cliente de Cobrá, la pasarela de pagos. Cualquier falla se levanta como CobraError."""
+import os
+
+import httpx
+
+TIMEOUT = 5.0
+
+
+class CobraError(Exception):
+    pass
+
+
+def _pedir(metodo, ruta, ok, headers=None, **kwargs):
+    url = os.environ.get('PULSO_PAGOS_URL', '').rstrip('/') + ruta
+    cabeceras = dict(headers or {}, **{'X-Cobra-Clave': os.environ.get('PULSO_PAGOS_CLAVE', '')})
+    try:
+        r = httpx.request(metodo, url, headers=cabeceras, timeout=TIMEOUT, **kwargs)
+    except httpx.HTTPError as e:
+        raise CobraError(str(e)) from e
+    if r.status_code not in ok:
+        raise CobraError(f'Cobrá respondió {r.status_code}')
+    if r.status_code == 404:
+        return r.status_code, None
+    try:
+        return r.status_code, r.json()
+    except ValueError as e:
+        raise CobraError('Respuesta inválida de Cobrá') from e
+
+
+def _pago(datos):
+    if not isinstance(datos, dict) or not all(k in datos for k in ('id', 'estado', 'referencia')):
+        raise CobraError('Pago inválido')
+    return datos
+
+
+def crear_pago(monto, referencia):
+    _, datos = _pedir('POST', '/pagos', (200, 201), headers={'Idempotency-Key': referencia},
+                      json={'monto': monto, 'moneda': 'UYU', 'referencia': referencia})
+    return _pago(datos)
+
+
+def obtener_pago(pago_id):
+    """El pago, o None si Cobrá no lo conoce."""
+    codigo, datos = _pedir('GET', f'/pagos/{pago_id}', (200, 404))
+    return None if codigo == 404 else _pago(datos)
+
+
+def buscar_por_referencia(referencia):
+    """El pago con esa referencia, o None si no hay ninguno."""
+    _, datos = _pedir('GET', '/pagos', (200,), params={'referencia': referencia})
+    pagos = datos.get('pagos') if isinstance(datos, dict) else None
+    if not isinstance(pagos, list):
+        raise CobraError('Respuesta inválida de Cobrá')
+    pagos = [p for p in pagos if _pago(p)['referencia'] == referencia]
+    return pagos[0] if pagos else None
