+class CambioSerie(BaseModel):
+    desde_clase_id: StrictInt
+    hora: str | None = Field(default=None, pattern=HORA_RE)
+    instructor: str | None = None
+    cupo: StrictInt | None = Field(default=None, ge=1)
+
+    @field_validator('instructor')
+    @classmethod
+    def _instructor(cls, v):
+        return v if v is None else _no_vacio(v)
