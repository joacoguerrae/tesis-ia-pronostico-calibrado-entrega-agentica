-from pulso import correo, db, reloj
+from pulso import cobra, correo, db, reloj
 
 router = APIRouter()
 
@@ -92,6 +94,110 @@ def yo(socio=Depends(socio_actual)):
     return {k: socio[k] for k in ('id', 'nombre', 'email', 'plan', 'creditos')}
 
 
+PACKS = {'pack-4': {'creditos': 4, 'precio': 1200}, 'pack-8': {'creditos': 8, 'precio': 2200}}
+ESPERA_PAGO = timedelta(minutes=30)
+
+
+def ver_compra(c):
+    return {'id': c['id'], 'pack': c['pack'], 'creditos': c['creditos'], 'monto': c['monto'],
+            'estado': c['estado'], 'creada': c['creada'], 'url_pago': c['url_pago']}
+
+
+class NuevaCompra(BaseModel):
+    pack: str
+
+
+@router.post('/compras', status_code=201)
+def comprar(datos: NuevaCompra, socio=Depends(socio_actual)):
+    pack = PACKS.get(datos.pack)
+    if pack is None:
+        raise HTTPException(422, 'Pack inválido')
+    compra = db.crear_compra(socio['id'], datos.pack, pack['creditos'], pack['precio'], reloj.ahora())
+    try:
+        pago = cobra.crear_pago(pack['precio'], f"pulso-compra-{compra['id']}")
+        url = pago.get('url_pago')
+        if not isinstance(url, str):
+            raise cobra.CobraFalla('Pago sin url_pago')
+    except cobra.CobraFalla:
+        raise HTTPException(502, 'No se pudo crear el pago')
+    db.guardar_pago(compra['id'], pago['id'], url)
+    return ver_compra(db.compra(compra['id']))
+
+
+@router.get('/compras')
+def mis_compras(socio=Depends(socio_actual)):
+    return [ver_compra(c) for c in db.compras_de(socio['id'])]
+
+
+def aplicar_pago(compra, pago):
+    """Aplica el estado de un pago de Cobrá a la compra. Devuelve el estado final de la compra."""
+    if pago['estado'] == 'pendiente':
+        return db.compra(compra['id'])['estado']
+    if db.resolver_compra(compra['id'], 'aprobada' if pago['estado'] == 'aprobado' else 'rechazada'):
+        if pago['estado'] == 'aprobado':
+            socio = db.socio(compra['socio_id'])
+            correo.enviar(socio['email'], 'Compra de créditos aprobada',
+                          f"Hola {socio['nombre']}, se acreditaron {compra['creditos']} créditos de tu compra.")
+    return db.compra(compra['id'])['estado']
+
+
+def compra_de_referencia(referencia):
+    m = re.fullmatch(r'pulso-compra-([0-9]+)', referencia) if isinstance(referencia, str) else None
+    return db.compra(int(m.group(1))) if m else None
+
+
+class AvisoPago(BaseModel):
+    pago_id: str
+
+
+@router.post('/webhooks/pagos')
+def webhook_pagos(datos: AvisoPago):
+    try:
+        pago = cobra.obtener_pago(datos.pago_id)
+    except cobra.CobraFalla:
+        raise HTTPException(503, 'Cobrá no responde')
+    if pago is None:
+        raise HTTPException(404, 'Pago desconocido')
+    compra = compra_de_referencia(pago.get('referencia'))
+    if compra is None:
+        raise HTTPException(404, 'El pago no es de ninguna compra')
+    db.guardar_pago(compra['id'], pago['id'], pago.get('url_pago'))
+    compra = db.compra(compra['id'])
+    if compra['pago_id'] != pago['id']:
+        return {'compra_id': compra['id'], 'estado': compra['estado']}
+    return {'compra_id': compra['id'], 'estado': aplicar_pago(compra, pago)}
+
+
+def conciliar(compra):
+    """Estado en que queda una compra pendiente tras consultar a Cobrá."""
+    try:
+        if compra['pago_id']:
+            pago = cobra.obtener_pago(compra['pago_id'])
+        else:
+            pago = cobra.buscar_por_referencia(f"pulso-compra-{compra['id']}")
+            if pago is None:
+                if reloj.ahora() - db.a_fecha(compra['creada']) >= ESPERA_PAGO:
+                    db.resolver_compra(compra['id'], 'rechazada', solo_sin_pago=True)
+                return db.compra(compra['id'])['estado']
+            db.guardar_pago(compra['id'], pago['id'], pago.get('url_pago'))
+        if pago is None:
+            return db.compra(compra['id'])['estado']
+        if db.compra(compra['id'])['pago_id'] != pago['id']:
+            return db.compra(compra['id'])['estado']
+        return aplicar_pago(compra, pago)
+    except cobra.CobraFalla:
+        return db.compra(compra['id'])['estado']
+
+
+@router.post('/admin/conciliar-pagos', dependencies=[Depends(admin)])
+def conciliar_pagos():
+    resumen = {'aprobadas': 0, 'rechazadas': 0, 'pendientes': 0}
+    clave = {'aprobada': 'aprobadas', 'rechazada': 'rechazadas', 'pendiente': 'pendientes'}
+    for compra in db.compras_pendientes():
+        resumen[clave[conciliar(compra)]] += 1
+    return resumen
+
