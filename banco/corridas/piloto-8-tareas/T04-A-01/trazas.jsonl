{"host.arch": "arm64", "os.type": "darwin", "os.version": "23.4.0", "service.name": "claude-code", "service.version": "2.1.312", "user.id": "", "session.id": "c6165bfe-bdd7-499f-b32f-140dfcc46282", "terminal.type": "claude-desktop", "gen_ai.provider.name": "anthropic", "span.type": "tool", "tool_name": "Bash", "tool_name_safe": "Bash", "gen_ai.operation.name": "execute_tool", "gen_ai.tool.name": "Bash", "gen_ai.conversation.id": "c6165bfe-bdd7-499f-b32f-140dfcc46282", "full_command": "cat > tests/test_socios.py <<'EOF'\nimport pytest\n\nfrom pulso import db\nfrom tests.conftest import auth\n\nBASE = {'nombre': 'Ana Pérez', 'email': 'Ana.Perez@Example.com', 'plan': 'premium'}\n\n\ndef test_alta_normaliza_y_devuelve_token(cliente):\n    r = cliente.post('/socios', json={**BASE, 'nombre': '  Ana Pérez  ', 'email': '  Ana.Perez@Example.com '})\n    assert r.status_code == 201\n    d = r.json()\n    assert d['nombre'] == 'Ana Pérez' and d['email'] == 'ana.perez@example.com'\n    assert d['plan'] == 'premium' and d['creditos'] == 20\n    assert len(d['token']) >= 32\n    assert cliente.get('/yo', headers={'Authorization': f\"Bearer {d['token']}\"}).json()['id'] == d['id']\n\n\ndef test_creditos_basico(cliente):\n    assert cliente.post('/socios', json={**BASE, 'plan': 'basico'}).json()['creditos'] == 8\n\n\ndef test_tokens_distintos(cliente):\n    a = cliente.post('/socios', json=BASE).json()['token']\n    b = cliente.post('/socios', json={**BASE, 'email': 'otro@example.com'}).json()['token']\n    assert a != b\n\n\ndef test_correo_bienvenida(cliente):\n    cliente.post('/socios', json=BASE)\n    c = db.correos()\n    assert len(c) == 1 and c[0]['para'] == 'ana.perez@example.com'\n    assert c[0]['asunto'] == 'Te damos la bienvenida a Pulso'\n\n\ndef test_email_duplicado_409(cliente):\n    assert cliente.post('/socios', json=BASE).status_code == 201\n    r = cliente.post('/socios', json={**BASE, 'email': ' ANA.PEREZ@example.com'})\n    assert r.status_code == 409\n    assert len(db.correos()) == 1\n\n\n@pytest.mark.parametrize('campo,valor', [\n    ('nombre', ' a '), ('nombre', 'x' * 81), ('nombre', '   '), ('nombre', 5),\n    ('email', 'sin-arroba'), ('email', 'a@@b.com'), ('email', 'a@b@c.com'), ('email', '@b.com'),\n    ('email', 'a@sinpunto'), ('email', 'a@.com'), ('email', 'a@b.'), ('email', 'a b@c.com'),\n    ('email', ''), ('plan', 'oro'), ('plan', 'Premium'), ('plan', None),\n])\ndef test_datos_invalidos_422(cliente, campo, valor):\n    assert cliente.post('/socios', json={**BASE, campo: valor}).status_code == 422\n    assert db.correos() == []\n\n\n@pytest.mark.parametrize('campo', ['nombre', 'email', 'plan'])\ndef test_falta_dato_422(cliente, campo):\n    d = {k: v for k, v in BASE.items() if k != campo}\n    assert cliente.post('/socios', json=d).status_code == 422\n\n\ndef test_nombre_limites(cliente):\n    assert cliente.post('/socios', json={**BASE, 'nombre': 'Al'}).status_code == 201\n    assert cliente.post('/socios', json={**BASE, 'email': 'b@b.com', 'nombre': 'x' * 80}).status_code == 201\nEOF\npython -m pytest -q 2>&1 | tail -15", "bash_command_class": "file_read", "bash_argv0": "cat", "tool_use_id": "toolu_01PnZAq53CgUskfnaVjnHFQt", "gen_ai.tool.call.id": "toolu_01PnZAq53CgUskfnaVjnHFQt", "duration_ms": 6, "_nombre": "claude_code.tool", "_traza": "a88961fae3dc09e3eff4bc65fb6c3fd1", "_tramo": "c44657a0f64f512e", "_padre": "ec4f5a0d6ab43389", "_inicio_ns": 1794570557182000000, "_fin_ns": 1794570557188176583, "_estado": 0}
