diff --git a/tests/test_socios.py b/tests/test_socios.py
new file mode 100644
index 0000000..da60188
--- /dev/null
+++ b/tests/test_socios.py
@@ -0,0 +1,65 @@
+import pytest
+
+from conftest import auth
+from pulso import db
+
+
+def alta(cliente, **kw):
+    datos = {'nombre': 'Ana Pérez', 'email': 'Ana.Perez@Example.com', 'plan': 'premium'}
+    datos.update(kw)
+    return cliente.post('/socios', json=datos)
+
+
+def test_alta_normaliza_y_devuelve_token(cliente):
+    r = alta(cliente, nombre='  Ana Pérez  ', email='  Ana.Perez@Example.com ')
+    assert r.status_code == 201
+    j = r.json()
+    assert j['nombre'] == 'Ana Pérez' and j['email'] == 'ana.perez@example.com'
+    assert j['plan'] == 'premium' and j['creditos'] == 20
+    assert len(j['token']) >= 32
+    assert cliente.get('/yo', headers={'Authorization': f"Bearer {j['token']}"}).json()['id'] == j['id']
+
+
+def test_creditos_basico_y_tokens_distintos(cliente):
+    a = alta(cliente, email='a@x.com', plan='basico').json()
+    b = alta(cliente, email='b@x.com', plan='basico').json()
+    assert a['creditos'] == 8
+    assert a['token'] != b['token']
+
+
+def test_manda_correo_de_bienvenida(cliente):
+    alta(cliente)
+    c = db.correos()
+    assert len(c) == 1
+    assert c[0]['para'] == 'ana.perez@example.com'
+    assert c[0]['asunto'] == 'Te damos la bienvenida a Pulso'
+
+
+def test_email_duplicado_409(cliente):
+    assert alta(cliente).status_code == 201
+    assert alta(cliente, email=' ANA.PEREZ@example.com').status_code == 409
+    assert len(db.correos()) == 1
+
+
+@pytest.mark.parametrize('cambio', [
+    {'nombre': ' a '}, {'nombre': 'a' * 81}, {'nombre': '   '}, {'nombre': 5},
+    {'plan': 'oro'}, {'plan': 'Basico'},
+    {'email': 'sin-arroba.com'}, {'email': 'a@@x.com'}, {'email': 'a@b@x.com'},
+    {'email': '@x.com'}, {'email': 'a@x'}, {'email': 'a@.x.com'}, {'email': 'a@x.com.'},
+    {'email': 'a b@x.com'}, {'email': 'a@x .com'}, {'email': ''},
+])
+def test_datos_invalidos_422(cliente, cambio):
+    assert alta(cliente, **cambio).status_code == 422
+    assert db.correos() == []
+
+
+@pytest.mark.parametrize('falta', ['nombre', 'email', 'plan'])
+def test_falta_dato_422(cliente, falta):
+    datos = {'nombre': 'Ana', 'email': 'a@x.com', 'plan': 'basico'}
+    del datos[falta]
+    assert cliente.post('/socios', json=datos).status_code == 422
+
+
+def test_nombre_de_80_y_2_validos(cliente):
+    assert alta(cliente, nombre='a' * 80, email='a@x.com').status_code == 201
+    assert alta(cliente, nombre=' ab ', email='b@x.com').status_code == 201
