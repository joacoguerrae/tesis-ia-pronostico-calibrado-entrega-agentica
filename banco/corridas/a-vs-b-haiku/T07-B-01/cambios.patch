+def ejecutar(sql, parametros=(), con=None):
+    """Escribe en la base. Si se pasa `con`, el cambio forma parte de esa transacción y no se confirma acá."""
+    if con is not None:
+        return con.execute(sql, parametros)
+    with conexion() as nueva:
+        return nueva.execute(sql, parametros)
+
