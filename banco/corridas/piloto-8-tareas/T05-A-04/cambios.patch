diff --git a/tests/test_recordatorios.py b/tests/test_recordatorios.py
new file mode 100644
index 0000000..f1fbef6
--- /dev/null
+++ b/tests/test_recordatorios.py
@@ -0,0 +1,45 @@
+from datetime import timedelta
+
+from conftest import ADMIN, AHORA
+from pulso import db, reloj
+
+
+def reservar(socio, clase, estado='confirmada'):
+    return db.crear_reserva(socio['id'], clase['id'], AHORA, estado)
+
+
+def test_requiere_clave(cliente):
+    assert cliente.post('/admin/recordatorios').status_code == 401
+    assert cliente.post('/admin/recordatorios', headers={'X-Admin-Key': 'x'}).status_code == 401
+
+
+def test_manda_recordatorio_una_sola_vez(cliente, socio):
+    clase = db.crear_clase('Yoga', 'Sofía', AHORA + timedelta(hours=3, minutes=30))
+    reservar(socio, clase)
+    r = cliente.post('/admin/recordatorios', headers=ADMIN)
+    assert r.json() == {'enviados': 1}
+    (c,) = db.correos()
+    assert c['para'] == 'ana@example.com'
+    assert c['asunto'] == 'Recordatorio: Yoga el 10/11 a las 15:30'
+    assert 'Sofía' in c['cuerpo']
+    assert cliente.post('/admin/recordatorios', headers=ADMIN).json() == {'enviados': 0}
+    assert len(db.correos()) == 1
+
+
+def test_ventana_de_24_horas(cliente, socio):
+    for h in (-1, 0, 24, 25):
+        reservar(socio, db.crear_clase(f'C{h}', 'Leo', AHORA + timedelta(hours=h)))
+    assert cliente.post('/admin/recordatorios', headers=ADMIN).json() == {'enviados': 1}
+    assert db.correos()[0]['asunto'].startswith('Recordatorio: C24 ')
+
+
+def test_no_manda_a_no_confirmadas(cliente, socio):
+    reservar(socio, db.crear_clase('Yoga', 'Sofía', AHORA + timedelta(hours=5)), 'cancelada')
+    assert cliente.post('/admin/recordatorios', headers=ADMIN).json() == {'enviados': 0}
+
+
+def test_clase_lejana_entra_despues_en_ventana(cliente, socio):
+    reservar(socio, db.crear_clase('Yoga', 'Sofía', AHORA + timedelta(hours=30)))
+    assert cliente.post('/admin/recordatorios', headers=ADMIN).json() == {'enviados': 0}
+    reloj.fijar(AHORA + timedelta(hours=10))
+    assert cliente.post('/admin/recordatorios', headers=ADMIN).json() == {'enviados': 1}
