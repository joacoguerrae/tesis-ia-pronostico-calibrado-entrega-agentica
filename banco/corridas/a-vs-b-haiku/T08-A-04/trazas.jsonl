{"host.arch": "amd64", "os.type": "linux", "os.version": "6.18.33.2-microsoft-standard-WSL2", "service.name": "claude-code", "service.version": "2.1.312", "wsl.version": "2", "user.id": "0f72bbf305cc3cfe4c49efd7a27949e16f5ce38c2de862b736399de5c3c79b13", "session.id": "3f09ccdb-9498-4a2a-a1bf-f70d22c0c2e7", "terminal.type": "wsl-Ubuntu-24.04", "gen_ai.provider.name": "anthropic", "span.type": "tool", "tool_name": "Bash", "tool_name_safe": "Bash", "gen_ai.operation.name": "execute_tool", "gen_ai.tool.name": "Bash", "gen_ai.conversation.id": "3f09ccdb-9498-4a2a-a1bf-f70d22c0c2e7", "full_command": "cat >> pulso/db.py <<'EOF'\n\n\ndef _migrar(con):\n    columnas = [f['name'] for f in con.execute('PRAGMA table_info(socios)').fetchall()]\n    if 'empresa_convenio' not in columnas:\n        con.execute('ALTER TABLE socios ADD COLUMN empresa_convenio TEXT')\n\n\ndef activar_corporativo(socio_id, empresa, piso):\n    \"\"\"Pasa a corporativo si todavía no lo es. Devuelve False si ya lo era.\"\"\"\n    with conexion() as con:\n        cur = con.execute(\"UPDATE socios SET plan = 'corporativo', empresa_convenio = ?, \"\n                          \"creditos = MAX(creditos, ?) WHERE id = ? AND plan != 'corporativo'\",\n                          (empresa, piso, socio_id))\n        return cur.rowcount == 1\n\n\ndef bajar_a_basico(socio_id, empresa):\n    \"\"\"Vuelve a básico si sigue corporativo con esa empresa. Devuelve False si no cambió.\"\"\"\n    with conexion() as con:\n        cur = con.execute(\"UPDATE socios SET plan = 'basico', empresa_convenio = NULL \"\n                          \"WHERE id = ? AND plan = 'corporativo' AND empresa_convenio IS ?\",\n                          (socio_id, empresa))\n        return cur.rowcount == 1\n\n\ndef corporativos():\n    return _varias(\"SELECT * FROM socios WHERE plan = 'corporativo' ORDER BY id\")\nEOF\ncat > pulso/beneficios.py <<'EOF'\n\"\"\"Cliente del servicio de beneficios (fuente de verdad de los empleados con convenio).\"\"\"\nimport os\nfrom urllib.parse import quote\n\nimport httpx\n\nACTIVO, INACTIVO, DESCONOCIDO, EMPRESA_DESCONOCIDA, FALLA = 'activo', 'inactivo', 'desconocido', 'empresa', 'falla'\n\n\ndef consultar(empresa, email):\n    base = os.environ.get('PULSO_BENEFICIOS_URL', '').rstrip('/')\n    clave = os.environ.get('PULSO_BENEFICIOS_CLAVE', '')\n    url = f\"{base}/empresas/{quote(empresa, safe='')}/empleados/{quote(email.lower(), safe='')}\"\n    try:\n        r = httpx.get(url, headers={'X-Api-Key': clave}, timeout=3.0)\n        datos = r.json()\n        if r.status_code == 200 and isinstance(datos, dict) and isinstance(datos.get('activo'), bool):\n            return ACTIVO if datos['activo'] else INACTIVO\n        if r.status_code == 404 and isinstance(datos, dict):\n            if datos.get('error') == 'empleado_desconocido':\n                return DESCONOCIDO\n            if datos.get('error') == 'empresa_desconocida':\n                return EMPRESA_DESCONOCIDA\n    except (httpx.HTTPError, ValueError):\n        pass\n    return FALLA\nEOF\npython - <<'EOF'\nEOF", "bash_command_class": "file_read", "bash_argv0": "cat", "tool_use_id": "toolu_011oEjXSaFsnRLBAxAu1YLaJ", "gen_ai.tool.call.id": "toolu_011oEjXSaFsnRLBAxAu1YLaJ", "duration_ms": 6, "_nombre": "claude_code.tool", "_traza": "9d704e80444e2cc4a50355362c53e5f2", "_tramo": "4080bd2d34e6a2d0", "_padre": "f5b0f7fda13273b9", "_inicio_ns": 1794689999613000000, "_fin_ns": 1794689999618652085, "_estado": 0}
