+def compra_por_referencia(referencia):
+    sufijo = referencia.removeprefix(REFERENCIA) if isinstance(referencia, str) else ''
+    if not sufijo.isascii() or not sufijo.isdigit() or sufijo != str(int(sufijo)):
+        return None
+    return db.compra(int(sufijo))
