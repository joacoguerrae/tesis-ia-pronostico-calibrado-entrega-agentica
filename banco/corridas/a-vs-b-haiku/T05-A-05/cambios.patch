diff --git a/pulso/db.py b/pulso/db.py
index 59841ac..052c181 100644
--- a/pulso/db.py
+++ b/pulso/db.py
@@ -58,6 +58,9 @@ def conexion():
 def inicializar():
     with conexion() as con:
         con.executescript(ESQUEMA)
+        columnas = [f['name'] for f in con.execute('PRAGMA table_info(reservas)')]
+        if 'recordatorio' not in columnas:
+            con.execute('ALTER TABLE reservas ADD COLUMN recordatorio TEXT')
 
 
 def a_texto(momento):
@@ -134,5 +137,21 @@ def sumar_creditos(socio_id, cantidad):
         con.execute('UPDATE socios SET creditos = creditos + ? WHERE id = ?', (cantidad, socio_id))
 
 
+def reservas_a_recordar():
+    """Reservas confirmadas sin recordatorio, con los datos de clase y socio."""
+    return _varias("SELECT r.id AS reserva_id, c.nombre AS clase, c.instructor, c.inicio, "
+                   "s.email, s.nombre AS socio FROM reservas r "
+                   "JOIN clases c ON c.id = r.clase_id JOIN socios s ON s.id = r.socio_id "
+                   "WHERE r.estado = 'confirmada' AND r.recordatorio IS NULL ORDER BY c.inicio, r.id")
+
+
+def marcar_recordatorio(reserva_id, momento):
+    """Reclama el recordatorio de la reserva; False si ya estaba reclamado."""
+    with conexion() as con:
+        cur = con.execute('UPDATE reservas SET recordatorio = ? WHERE id = ? AND recordatorio IS NULL',
+                          (a_texto(momento), reserva_id))
+    return cur.rowcount == 1
+
+
 def correos():
     return _varias('SELECT * FROM correos ORDER BY id')
diff --git a/pulso/main.py b/pulso/main.py
index 039212d..37cb299 100644
--- a/pulso/main.py
+++ b/pulso/main.py
@@ -1,4 +1,5 @@
 import os
+from datetime import timedelta
 
 from fastapi import APIRouter, Depends, FastAPI, Header, HTTPException
 from pydantic import AwareDatetime, BaseModel, Field
@@ -82,6 +83,23 @@ def reservar(datos: NuevaReserva, socio=Depends(socio_actual)):
     return ver_reserva(reserva)
 
 
+@router.post('/admin/recordatorios', dependencies=[Depends(admin)])
+def mandar_recordatorios():
+    ahora = reloj.ahora()
+    limite = ahora + timedelta(hours=24)
+    enviados = 0
+    for r in db.reservas_a_recordar():
+        inicio = db.a_fecha(r['inicio'])
+        if not ahora < inicio <= limite:
+            continue
+        if not db.marcar_recordatorio(r['reserva_id'], ahora):
+            continue
+        correo.enviar(r['email'], f"Recordatorio: {r['clase']} el {correo.fecha_y_hora(inicio)}",
+                      f"Hola {r['socio']}, te recordamos tu clase de {r['clase']} con {r['instructor']}.")
+        enviados += 1
+    return {'enviados': enviados}
+
+
 @router.get('/reservas')
 def mis_reservas(socio=Depends(socio_actual)):
     return [ver_reserva(r) for r in db.reservas_de(socio['id'])]
