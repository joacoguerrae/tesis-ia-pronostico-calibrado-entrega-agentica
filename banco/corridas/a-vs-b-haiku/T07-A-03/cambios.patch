+    nuevo = {'aprobado': 'aprobada', 'rechazado': 'rechazada'}.get(estado_pago)
+    if nuevo is None or compra['estado'] != 'pendiente':
+        return
+    if db.cerrar_compra(compra['id'], nuevo) and nuevo == 'aprobada':
+        socio = db.socio(compra['socio_id'])
+        correo.enviar(socio['email'], 'Compra de créditos aprobada',
+                      f"Hola {socio['nombre']}, se aprobó tu compra de {compra['creditos']} créditos.")
