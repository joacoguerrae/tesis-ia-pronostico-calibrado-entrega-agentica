+# Versiones que usan la conexión de una transaccion() abierta.
+
+def socio_en(con, socio_id):
+    fila = con.execute('SELECT * FROM socios WHERE id = ?', (socio_id,)).fetchone()
+    return dict(fila) if fila else None
+
+
+def clase_en(con, clase_id):
+    fila = con.execute('SELECT * FROM clases WHERE id = ?', (clase_id,)).fetchone()
+    return dict(fila) if fila else None
+
+
+def confirmadas_en(con, clase_id):
+    fila = con.execute("SELECT COUNT(*) AS n FROM reservas WHERE clase_id = ? AND estado = 'confirmada'",
+                       (clase_id,)).fetchone()
+    return fila['n']
+
+
+def tiene_reserva_confirmada_en(con, socio_id, clase_id):
+    fila = con.execute("SELECT 1 FROM reservas WHERE socio_id = ? AND clase_id = ? AND estado = 'confirmada'",
+                       (socio_id, clase_id)).fetchone()
+    return fila is not None
+
+
+def crear_reserva_en(con, socio_id, clase_id, creada, estado='confirmada'):
+    cur = con.execute('INSERT INTO reservas (socio_id, clase_id, estado, creada) VALUES (?, ?, ?, ?)',
+                      (socio_id, clase_id, estado, a_texto(creada)))
+    fila = con.execute('SELECT * FROM reservas WHERE id = ?', (cur.lastrowid,)).fetchone()
+    return dict(fila)
+
+
+def sumar_creditos_en(con, socio_id, cantidad):
+    con.execute('UPDATE socios SET creditos = creditos + ? WHERE id = ?', (cantidad, socio_id))
