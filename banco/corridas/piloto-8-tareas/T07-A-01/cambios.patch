+from datetime import timedelta
+
+import httpx
+import pytest
+
+from conftest import ADMIN, AHORA, auth
+from pulso import db, reloj
+
+
+class FakeCobra:
+    def __init__(self):
+        self.pagos = {}
+        self.caido = False
+        self.llamadas = []
+
+    def __call__(self, metodo, url, headers=None, json=None, params=None, timeout=None):
+        self.llamadas.append((metodo, url, headers, json, params))
+        if self.caido:
+            raise httpx.ConnectError('caído')
+        ruta = url.removeprefix('https://cobra.test/v1')
+        if headers.get('X-Cobra-Clave') != 'clave-cobra':
+            return httpx.Response(401)
+        if metodo == 'POST' and ruta == '/pagos':
+            ref = headers['Idempotency-Key']
+            for p in self.pagos.values():
+                if p['referencia'] == ref:
+                    return httpx.Response(200, json=p)
+            return httpx.Response(201, json=self.agregar(json['monto'], ref))
+        if metodo == 'GET' and ruta == '/pagos':
+            return httpx.Response(200, json={'pagos': [p for p in self.pagos.values()
+                                                       if p['referencia'] == params['referencia']]})
+        if metodo == 'GET':
+            p = self.pagos.get(ruta.removeprefix('/pagos/'))
+            return httpx.Response(200, json=p) if p else httpx.Response(404)
+        return httpx.Response(500)
+
+    def agregar(self, monto, ref, estado='pendiente'):
+        pid = f'pag_{len(self.pagos) + 1}'
+        p = {'id': pid, 'estado': estado, 'monto': monto, 'moneda': 'UYU', 'referencia': ref,
+             'url_pago': f'https://pagar.cobra.uy/{pid}'}
+        self.pagos[pid] = p
+        return p
+
+
+@pytest.fixture
+def cobra(monkeypatch):
+    monkeypatch.setenv('PULSO_PAGOS_URL', 'https://cobra.test/v1')
+    monkeypatch.setenv('PULSO_PAGOS_CLAVE', 'clave-cobra')
+    fake = FakeCobra()
+    monkeypatch.setattr(httpx, 'request', fake)
+    return fake
+
+
+def comprar(cliente, socio, pack='pack-4'):
+    return cliente.post('/compras', json={'pack': pack}, headers=auth(socio))
+
+
+def creditos(socio):
+    return db.socio(socio['id'])['creditos']
+
+
+def test_compra_crea_pago(cliente, socio, cobra):
+    r = comprar(cliente, socio, 'pack-8')
+    assert r.status_code == 201
+    c = r.json()
+    assert (c['pack'], c['creditos'], c['monto'], c['estado']) == ('pack-8', 8, 2200, 'pendiente')
+    assert c['url_pago'] == 'https://pagar.cobra.uy/pag_1'
+    metodo, url, headers, cuerpo, _ = cobra.llamadas[0]
+    assert url == 'https://cobra.test/v1/pagos'
+    assert headers['Idempotency-Key'] == f"pulso-compra-{c['id']}"
+    assert cuerpo == {'monto': 2200, 'moneda': 'UYU', 'referencia': f"pulso-compra-{c['id']}"}
+    assert creditos(socio) == 8
+
+
+@pytest.mark.parametrize('cuerpo', [{}, {'pack': 'pack-99'}, {'pack': None}])
+def test_pack_invalido(cliente, socio, cobra, cuerpo):
+    assert cliente.post('/compras', json=cuerpo, headers=auth(socio)).status_code == 422
+    assert db.compras_pendientes() == [] and cobra.llamadas == []
+
+
+def test_compra_requiere_token(cliente, cobra):
+    assert cliente.post('/compras', json={'pack': 'pack-4'}).status_code == 401
+
+
+def test_cobra_falla_deja_compra_pendiente_sin_pago(cliente, socio, cobra):
+    cobra.caido = True
+    assert comprar(cliente, socio).status_code == 502
+    [c] = cliente.get('/compras', headers=auth(socio)).json()
+    assert c['estado'] == 'pendiente' and c['url_pago'] is None
+
+
+def test_listado_mas_nueva_primero(cliente, socio, cobra):
+    a = comprar(cliente, socio).json()['id']
+    reloj.fijar(AHORA + timedelta(minutes=1))
+    b = comprar(cliente, socio).json()['id']
+    otro = db.crear_socio('Otro', 'o@example.com')
+    comprar(cliente, otro)
+    ids = [c['id'] for c in cliente.get('/compras', headers=auth(socio)).json()]
+    assert ids == [b, a]
+
+
+def test_webhook_aprueba_una_sola_vez(cliente, socio, cobra):
+    c = comprar(cliente, socio).json()
+    cobra.pagos['pag_1']['estado'] = 'aprobado'
+    for _ in range(2):
+        r = cliente.post('/webhooks/pagos', json={'pago_id': 'pag_1', 'estado': 'rechazado'})
+        assert r.status_code == 200
+        assert r.json() == {'compra_id': c['id'], 'estado': 'aprobada'}
+    assert creditos(socio) == 12
+    assert [m['asunto'] for m in db.correos()] == ['Compra de créditos aprobada']
+
+
+def test_webhook_rechazado_y_pendiente(cliente, socio, cobra):
+    comprar(cliente, socio)
+    r = cliente.post('/webhooks/pagos', json={'pago_id': 'pag_1', 'estado': 'aprobado'})
+    assert r.json()['estado'] == 'pendiente' and creditos(socio) == 8
+    cobra.pagos['pag_1']['estado'] = 'rechazado'
+    r = cliente.post('/webhooks/pagos', json={'pago_id': 'pag_1'})
+    assert r.json()['estado'] == 'rechazada'
+    assert creditos(socio) == 8 and db.correos() == []
+    cobra.pagos['pag_1']['estado'] = 'aprobado'
+    assert cliente.post('/webhooks/pagos', json={'pago_id': 'pag_1'}).json()['estado'] == 'rechazada'
+    assert creditos(socio) == 8
+
+
+def test_webhook_errores(cliente, socio, cobra):
+    assert cliente.post('/webhooks/pagos', json={}).status_code == 422
+    assert cliente.post('/webhooks/pagos', json={'pago_id': 'nada'}).status_code == 404
+    cobra.agregar(100, 'otra-cosa')
+    cobra.agregar(100, 'pulso-compra-999')
+    assert cliente.post('/webhooks/pagos', json={'pago_id': 'pag_1'}).status_code == 404
+    assert cliente.post('/webhooks/pagos', json={'pago_id': 'pag_2'}).status_code == 404
+    cobra.caido = True
+    assert cliente.post('/webhooks/pagos', json={'pago_id': 'pag_1'}).status_code == 503
+
+
+def test_webhook_guarda_pago_de_compra_sin_pago(cliente, socio, cobra):
+    cobra.caido = True
+    comprar(cliente, socio)
+    cobra.caido = False
+    cobra.agregar(1200, 'pulso-compra-1', 'aprobado')
+    r = cliente.post('/webhooks/pagos', json={'pago_id': 'pag_1'})
+    assert r.json() == {'compra_id': 1, 'estado': 'aprobada'}
+    assert db.compra(1)['pago_id'] == 'pag_1'
+    assert db.compra(1)['url_pago'] == 'https://pagar.cobra.uy/pag_1'
+
+
+def test_webhook_cobra_falla_no_cambia_nada(cliente, socio, cobra):
+    comprar(cliente, socio)
+    cobra.caido = True
+    assert cliente.post('/webhooks/pagos', json={'pago_id': 'pag_1'}).status_code == 503
+    assert db.compra(1)['estado'] == 'pendiente'
+
+
+def test_conciliar_requiere_admin(cliente, cobra):
+    assert cliente.post('/admin/conciliar-pagos').status_code == 401
+
+
+def test_conciliar_cuenta_solo_pendientes(cliente, socio, cobra):
+    otro = db.crear_socio('Otro', 'o@example.com')
+    comprar(cliente, socio)  # 1: aprobada
+    comprar(cliente, otro)   # 2: rechazada
+    comprar(cliente, socio)  # 3: pendiente
+    comprar(cliente, socio)  # 4: ya aprobada antes
+    db.resolver_compra(4, 'aprobada')
+    cobra.pagos['pag_1']['estado'] = 'aprobado'
+    cobra.pagos['pag_2']['estado'] = 'rechazado'
+    r = cliente.post('/admin/conciliar-pagos', headers=ADMIN)
+    assert r.json() == {'aprobadas': 1, 'rechazadas': 1, 'pendientes': 1}
+    assert creditos(socio) == 8 + 4 + 4
+    assert cliente.post('/admin/conciliar-pagos', headers=ADMIN).json() == {'aprobadas': 0, 'rechazadas': 0, 'pendientes': 1}
+    assert len(db.correos()) == 1
+
+
+def test_conciliar_busca_por_referencia(cliente, socio, cobra):
+    cobra.caido = True
+    comprar(cliente, socio)
+    cobra.caido = False
+    cobra.agregar(1200, 'pulso-compra-1', 'aprobado')
+    r = cliente.post('/admin/conciliar-pagos', headers=ADMIN)
+    assert r.json() == {'aprobadas': 1, 'rechazadas': 0, 'pendientes': 0}
+    assert db.compra(1)['pago_id'] == 'pag_1'
+
+
+def test_conciliar_sin_pago_segun_antiguedad(cliente, socio, cobra):
+    cobra.caido = True
+    comprar(cliente, socio)
+    cobra.caido = False
+    reloj.fijar(AHORA + timedelta(minutes=29, seconds=59))
+    assert cliente.post('/admin/conciliar-pagos', headers=ADMIN).json()['pendientes'] == 1
+    reloj.fijar(AHORA + timedelta(minutes=30))
+    assert cliente.post('/admin/conciliar-pagos', headers=ADMIN).json() == {'aprobadas': 0, 'rechazadas': 1, 'pendientes': 0}
+
+
+def test_conciliar_falla_de_cobra_no_rechaza_y_sigue(cliente, socio, cobra, monkeypatch):
+    cobra.caido = True
+    comprar(cliente, socio)  # 1 sin pago
+    cobra.caido = False
+    comprar(cliente, socio)  # 2
+    cobra.pagos['pag_1']['estado'] = 'aprobado'  # es la compra 2
+    cobra.agregar(1200, 'pulso-compra-1')
+    reloj.fijar(AHORA + timedelta(hours=1))
+    original = cobra.__call__
+    def a_veces(metodo, url, **kw):
+        if 'referencia' in (kw.get('params') or {}):
+            raise httpx.ReadTimeout('lento')
+        return original(metodo, url, **kw)
+    monkeypatch.setattr(httpx, 'request', a_veces)
+    r = cliente.post('/admin/conciliar-pagos', headers=ADMIN)
+    assert r.json() == {'aprobadas': 1, 'rechazadas': 0, 'pendientes': 1}
+    assert db.compra(1)['estado'] == 'pendiente'
