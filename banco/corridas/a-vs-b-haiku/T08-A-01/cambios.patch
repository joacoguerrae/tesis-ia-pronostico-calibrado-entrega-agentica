+def test_revalidar(cliente, servicio):
+    a = db.crear_socio('A', 'a@example.com', creditos=5)
+    b = db.crear_socio('B', 'b@example.com', creditos=5)
+    c = db.crear_socio('C', 'c@example.com', creditos=5)
+    d = db.crear_socio('D', 'd@example.com', creditos=5)
+    for s in (a, b, c, d):
+        assert activar(cliente, s).status_code == 200
+    servicio.respuestas['b%40example.com'] = (200, {'activo': False})
+    servicio.respuestas['c%40example.com'] = (404, {'error': 'empresa_desconocida'})
+    servicio.respuestas['d%40example.com'] = (500, 'x')
+    db.crear_socio('E', 'e@example.com')
+    r = cliente.post('/admin/revalidar-convenios', headers=ADMIN)
+    assert r.status_code == 200
+    assert r.json() == {'siguen': 1, 'bajaron': 2, 'sin_revisar': 1}
+    assert [db.socio(s['id'])['plan'] for s in (a, b, c, d)] == ['corporativo', 'basico', 'basico', 'corporativo']
+    assert db.socio(b['id'])['creditos'] == 12
+    asuntos = [(x['para'], x['asunto']) for x in db.correos() if x['asunto'].startswith('Se terminó')]
+    assert asuntos == [('b@example.com', 'Se terminó tu plan corporativo'),
+                       ('c@example.com', 'Se terminó tu plan corporativo')]
+    # puede reactivar
+    servicio.respuestas.clear()
+    assert activar(cliente, b).status_code == 200
+
