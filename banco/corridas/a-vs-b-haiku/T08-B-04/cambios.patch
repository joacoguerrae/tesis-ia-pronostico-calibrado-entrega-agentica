+    baja = socio_corporativo('b@example.com', 'acme', creditos=12)
+    sigue = socio_corporativo('c@example.com', 'acme', creditos=12)
+    empleados(servicio, {
+        ('acme', 'a@example.com'): (500, {'error': 'interno'}),
