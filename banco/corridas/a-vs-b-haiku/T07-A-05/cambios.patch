@@ -0,0 +1,58 @@
+"""Cliente de Cobrá, la pasarela de pagos."""
+import os
+from urllib.parse import quote
+
+import httpx
+
+TIMEOUT = 5
+ESTADOS = ('pendiente', 'aprobado', 'rechazado')
+
+
+class CobraFalla(Exception):
+    pass
+
+
+def _pedir(metodo, ruta, esperados, **kwargs):
+    url = os.environ.get('PULSO_PAGOS_URL', '') + ruta
+    headers = dict(kwargs.pop('headers', {}), **{'X-Cobra-Clave': os.environ.get('PULSO_PAGOS_CLAVE', '')})
+    try:
+        r = httpx.request(metodo, url, headers=headers, timeout=TIMEOUT, **kwargs)
+    except httpx.HTTPError as e:
+        raise CobraFalla(str(e)) from e
+    if r.status_code not in esperados:
+        raise CobraFalla(f'Cobrá respondió {r.status_code}')
+    if r.status_code == 404:
+        return None
+    try:
+        return r.json()
+    except ValueError as e:
+        raise CobraFalla('Respuesta inválida') from e
+
+
+def _pago(datos):
+    if (not isinstance(datos, dict) or not isinstance(datos.get('id'), str)
+            or datos.get('estado') not in ESTADOS):
+        raise CobraFalla('Pago inválido')
+    return datos
+
+
+def crear_pago(monto, referencia):
+    datos = _pedir('POST', '/pagos', (200, 201), headers={'Idempotency-Key': referencia},
+                   json={'monto': monto, 'moneda': 'UYU', 'referencia': referencia})
+    return _pago(datos)
+
+
+def obtener_pago(pago_id):
+    """El pago, o None si Cobrá no lo conoce."""
+    datos = _pedir('GET', '/pagos/' + quote(pago_id, safe=''), (200, 404))
+    return None if datos is None else _pago(datos)
+
+
+def buscar_por_referencia(referencia):
+    """El pago con esa referencia, o None si no hay."""
+    datos = _pedir('GET', '/pagos', (200,), params={'referencia': referencia})
+    pagos = datos.get('pagos') if isinstance(datos, dict) else None
+    if not isinstance(pagos, list):
+        raise CobraFalla('Respuesta inválida')
+    pagos = [_pago(p) for p in pagos if isinstance(p, dict) and p.get('referencia') == referencia]
+    return pagos[0] if pagos else None
