+@router.post('/admin/series', status_code=201, dependencies=[Depends(admin)])
+def crear_serie(datos: NuevaSerie):
+    ahora = reloj.ahora()
+    indice = DIAS.index(datos.dia)
+    inicios = []
+    dia = datos.desde
+    while dia <= datos.hasta:
+        if dia.weekday() == indice and dia not in CIERRES:
+            inicio = inicio_local(dia, datos.hora)
+            if inicio > ahora:
+                inicios.append(inicio)
+        dia += timedelta(days=1)
+    serie_id = db.crear_serie(datos.model_dump(mode='json'), inicios)
+    return ver_serie(db.serie(serie_id))
