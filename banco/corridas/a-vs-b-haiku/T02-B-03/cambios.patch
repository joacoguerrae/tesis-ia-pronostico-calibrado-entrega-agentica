--- a/pulso/db.py
+++ b/pulso/db.py
@@ -3,7 +3,9 @@ import os
 import secrets
 import sqlite3
 from contextlib import contextmanager
-from datetime import datetime, timezone
+from datetime import datetime, timedelta, timezone
+
+from pulso import reloj
 
 ESQUEMA = """
 CREATE TABLE IF NOT EXISTS socios (
@@ -48,6 +50,8 @@ def conexion():
     con = sqlite3.connect(ruta())
     con.row_factory = sqlite3.Row
     con.execute('PRAGMA foreign_keys = ON')
+    # SQLite solo pasa a minúsculas ASCII; casefold también resuelve tildes y ñ.
+    con.create_function('pulso_casefold', 1, lambda s: s.casefold() if s is not None else None)
     try:
         yield con
         con.commit()
@@ -109,6 +113,34 @@ def clases():
     return _varias('SELECT * FROM clases ORDER BY inicio, id')
 
 
+def clases_filtradas(ahora, desde=None, hasta=None, instructor=None, con_lugar=False, pagina=1, por_pagina=20):
+    """Clases que no empezaron y cumplen los filtros, de a una página.
+
+    `desde` y `hasta` son fechas (date) que se incluyen y se miran en hora de Montevideo.
+    Devuelve (clases de la página, total de clases que cumplen los filtros).
+    """
+    condiciones = ['c.inicio > ?']
+    parametros = [a_texto(ahora)]
+    if desde is not None:
+        condiciones.append('c.inicio >= ?')
+        parametros.append(a_texto(reloj.inicio_del_dia(desde)))
+    if hasta is not None:
+        condiciones.append('c.inicio < ?')
+        parametros.append(a_texto(reloj.inicio_del_dia(hasta + timedelta(days=1))))
+    if instructor is not None:
+        condiciones.append('pulso_casefold(c.instructor) = pulso_casefold(?)')
+        parametros.append(instructor)
+    if con_lugar:
+        condiciones.append('c.cupo > (SELECT COUNT(*) FROM reservas r WHERE r.clase_id = c.id AND r.estado = ?)')
+        parametros.append('confirmada')
+    where = ' AND '.join(condiciones)
+    with conexion() as con:
+        total = con.execute(f'SELECT COUNT(*) FROM clases c WHERE {where}', parametros).fetchone()[0]
+        filas = con.execute(f'SELECT c.* FROM clases c WHERE {where} ORDER BY c.inicio, c.id LIMIT ? OFFSET ?',
+                            [*parametros, por_pagina, (pagina - 1) * por_pagina]).fetchall()
+    return [dict(f) for f in filas], total
+
+
 def confirmadas(clase_id):
     return _una("SELECT COUNT(*) AS n FROM reservas WHERE clase_id = ? AND estado = 'confirmada'", (clase_id,))['n']
 
