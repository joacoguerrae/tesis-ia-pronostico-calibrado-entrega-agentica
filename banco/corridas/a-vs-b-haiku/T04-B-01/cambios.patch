diff --git a/pulso/main.py b/pulso/main.py
index 039212d..f1efd55 100644
--- a/pulso/main.py
+++ b/pulso/main.py
@@ -1,12 +1,16 @@
 import os
+import sqlite3
+from typing import Annotated, Literal
 
 from fastapi import APIRouter, Depends, FastAPI, Header, HTTPException
-from pydantic import AwareDatetime, BaseModel, Field
+from pydantic import AwareDatetime, BaseModel, Field, StringConstraints, field_validator
 
 from pulso import correo, db, reloj
 
 router = APIRouter()
 
+CREDITOS_INICIALES = {'basico': 8, 'premium': 20}
+
 
 def socio_actual(authorization: str | None = Header(default=None)):
     if not authorization or not authorization.startswith('Bearer '):
@@ -30,6 +34,45 @@ def ver_reserva(reserva):
     return {k: reserva[k] for k in ('id', 'clase_id', 'estado', 'creada')}
 
 
+def email_valido(email):
+    """Sin espacios, una sola @, algo antes de la @ y un dominio con al menos un punto que no esté en los extremos."""
+    if any(c.isspace() for c in email) or email.count('@') != 1:
+        return False
+    local, dominio = email.split('@')
+    return bool(local) and '.' in dominio and not dominio.startswith('.') and not dominio.endswith('.')
+
+
+class NuevoSocio(BaseModel):
+    nombre: Annotated[str, StringConstraints(strip_whitespace=True, min_length=2, max_length=80)]
+    email: str
+    plan: Literal['basico', 'premium']
+
+    @field_validator('email', mode='before')
+    @classmethod
+    def normalizar_email(cls, valor):
+        return valor.strip().lower() if isinstance(valor, str) else valor
+
+    @field_validator('email')
+    @classmethod
+    def validar_email(cls, valor):
+        if not email_valido(valor):
+            raise ValueError('El email no es válido')
+        return valor
+
+
+@router.post('/socios', status_code=201)
+def registrarse(datos: NuevoSocio):
+    if db.socio_por_email(datos.email) is not None:
+        raise HTTPException(409, 'Ya existe un socio con ese email')
+    try:
+        socio = db.crear_socio(datos.nombre, datos.email, datos.plan, CREDITOS_INICIALES[datos.plan])
+    except sqlite3.IntegrityError:
+        raise HTTPException(409, 'Ya existe un socio con ese email')
+    correo.enviar(socio['email'], 'Te damos la bienvenida a Pulso',
+                  f"Hola {socio['nombre']}, ya podés reservar clases con tus {socio['creditos']} créditos.")
+    return {k: socio[k] for k in ('id', 'nombre', 'email', 'plan', 'creditos', 'token')}
+
+
 @router.get('/clases')
 def listar_clases():
     ahora = reloj.ahora()
