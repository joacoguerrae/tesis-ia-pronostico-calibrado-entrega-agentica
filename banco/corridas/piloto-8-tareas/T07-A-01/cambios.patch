+PACKS = {'pack-4': {'creditos': 4, 'precio': 1200}, 'pack-8': {'creditos': 8, 'precio': 2200}}
+PREFIJO_REFERENCIA = 'pulso-compra-'
+ESPERA_SIN_PAGO = timedelta(minutes=30)
+
+
+def ver_compra(compra):
+    datos = {k: compra[k] for k in ('id', 'pack', 'creditos', 'monto', 'estado', 'creada', 'url_pago')}
+    datos['estado'] = compra['estado']
+    return datos
+
+
+class NuevaCompra(BaseModel):
+    pack: str
+
+
+def aplicar_estado(compra, pago):
+    """Aplica el estado de un pago de Cobrá a una compra. Devuelve el estado final de la compra."""
+    nuevo = {'aprobado': 'aprobada', 'rechazado': 'rechazada'}.get(pago['estado'])
+    if nuevo is None:
+        return db.compra(compra['id'])['estado']
+    if db.resolver_compra(compra['id'], nuevo) and nuevo == 'aprobada':
+        socio = db.socio(compra['socio_id'])
+        correo.enviar(socio['email'], 'Compra de créditos aprobada',
+                      f"Hola {socio['nombre']}, tu compra de {compra['creditos']} créditos fue aprobada.")
+    return db.compra(compra['id'])['estado']
+
+
+@router.post('/compras', status_code=201)
+def comprar(datos: NuevaCompra, socio=Depends(socio_actual)):
+    pack = PACKS.get(datos.pack)
+    if pack is None:
+        raise HTTPException(422, 'Pack inválido')
+    compra = db.crear_compra(socio['id'], datos.pack, pack['creditos'], pack['precio'], reloj.ahora())
+    try:
+        pago = cobra.crear_pago(pack['precio'], f"{PREFIJO_REFERENCIA}{compra['id']}")
+    except cobra.CobraError:
+        raise HTTPException(502, 'No se pudo crear el pago')
+    db.guardar_pago(compra['id'], pago['id'], pago.get('url_pago'))
+    return ver_compra(db.compra(compra['id']))
+
+
+@router.get('/compras')
+def mis_compras(socio=Depends(socio_actual)):
+    return [ver_compra(c) for c in db.compras_de(socio['id'])]
+
+
+def compra_de_referencia(referencia):
+    if not isinstance(referencia, str) or not referencia.startswith(PREFIJO_REFERENCIA):
+        return None
+    numero = referencia.removeprefix(PREFIJO_REFERENCIA)
+    if not (numero.isascii() and numero.isdigit()):
+        return None
+    return db.compra(int(numero))
+
+
+class AvisoPago(BaseModel):
+    pago_id: str = Field(min_length=1)
+
+
+@router.post('/webhooks/pagos')
+def webhook_pagos(datos: AvisoPago):
+    try:
+        pago = cobra.obtener_pago(datos.pago_id)
+    except cobra.CobraError:
+        raise HTTPException(503, 'Cobrá no responde')
+    if pago is None:
+        raise HTTPException(404, 'Pago desconocido')
+    compra = compra_de_referencia(pago.get('referencia'))
+    if compra is None:
+        raise HTTPException(404, 'El pago no es de ninguna compra')
+    db.guardar_pago(compra['id'], pago['id'], pago.get('url_pago'))
+    return {'compra_id': compra['id'], 'estado': aplicar_estado(compra, pago)}
+
+
+@router.post('/admin/conciliar-pagos', dependencies=[Depends(admin)])
+def conciliar_pagos():
+    resultado = {'aprobadas': 0, 'rechazadas': 0, 'pendientes': 0}
+    for compra in db.compras_pendientes():
+        estado = 'pendiente'
+        try:
+            if compra['pago_id']:
+                pago = cobra.obtener_pago(compra['pago_id'])
+            else:
+                pago = cobra.buscar_por_referencia(f"{PREFIJO_REFERENCIA}{compra['id']}")
+                if pago is not None:
+                    db.guardar_pago(compra['id'], pago['id'], pago.get('url_pago'))
+            if pago is not None:
+                estado = aplicar_estado(compra, pago)
+            elif not compra['pago_id'] and reloj.ahora() - db.a_fecha(compra['creada']) >= ESPERA_SIN_PAGO:
+                db.resolver_compra(compra['id'], 'rechazada')
+                estado = db.compra(compra['id'])['estado']
+        except cobra.CobraError:
+            estado = db.compra(compra['id'])['estado']
+        clave = {'aprobada': 'aprobadas', 'rechazada': 'rechazadas'}.get(estado, 'pendientes')
+        resultado[clave] += 1
+    return resultado
