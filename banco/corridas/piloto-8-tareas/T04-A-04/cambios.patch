diff --git a/tests/test_socios.py b/tests/test_socios.py
new file mode 100644
index 0000000..50cdbeb
--- /dev/null
+++ b/tests/test_socios.py
@@ -0,0 +1,66 @@
+import pytest
+
+from pulso import db
+
+OK = {'nombre': 'Ana Pérez', 'email': 'Ana.Perez@Example.com', 'plan': 'premium'}
+
+
+def test_registro_normaliza_y_devuelve_token(cliente):
+    r = cliente.post('/socios', json={**OK, 'nombre': '  Ana Pérez  ', 'email': '  Ana.Perez@Example.com '})
+    assert r.status_code == 201
+    d = r.json()
+    assert d['nombre'] == 'Ana Pérez'
+    assert d['email'] == 'ana.perez@example.com'
+    assert d['plan'] == 'premium' and d['creditos'] == 20
+    assert len(d['token']) >= 32
+    yo = cliente.get('/yo', headers={'Authorization': f"Bearer {d['token']}"})
+    assert yo.status_code == 200 and yo.json()['id'] == d['id']
+
+
+def test_creditos_basico(cliente):
+    d = cliente.post('/socios', json={**OK, 'plan': 'basico'}).json()
+    assert d['creditos'] == 8
+
+
+def test_tokens_distintos(cliente):
+    a = cliente.post('/socios', json=OK).json()
+    b = cliente.post('/socios', json={**OK, 'email': 'otro@example.com'}).json()
+    assert a['token'] != b['token']
+
+
+def test_correo_de_bienvenida(cliente):
+    cliente.post('/socios', json=OK)
+    correos = db.correos()
+    assert len(correos) == 1
+    assert correos[0]['para'] == 'ana.perez@example.com'
+    assert correos[0]['asunto'] == 'Te damos la bienvenida a Pulso'
+
+
+def test_email_duplicado_409(cliente):
+    assert cliente.post('/socios', json=OK).status_code == 201
+    r = cliente.post('/socios', json={**OK, 'email': 'ANA.PEREZ@example.com'})
+    assert r.status_code == 409
+    assert len(db.correos()) == 1
+
+
+@pytest.mark.parametrize('cambio', [
+    {'nombre': ' a '}, {'nombre': '   '}, {'nombre': 'x' * 81},
+    {'email': 'sin-arroba'}, {'email': 'a@@b.com'}, {'email': 'a@b@c.com'}, {'email': '@example.com'},
+    {'email': 'a@example'}, {'email': 'a@.example'}, {'email': 'a@example.'}, {'email': 'a b@example.com'},
+    {'email': 'a@exa mple.com'}, {'email': ''},
+    {'plan': 'oro'}, {'plan': 'Premium'}, {'nombre': 5}, {'email': None},
+])
+def test_datos_invalidos_422(cliente, cambio):
+    assert cliente.post('/socios', json={**OK, **cambio}).status_code == 422
