{"host.arch": "amd64", "os.type": "linux", "os.version": "6.18.33.2-microsoft-standard-WSL2", "service.name": "claude-code", "service.version": "2.1.312", "wsl.version": "2", "user.id": "0f72bbf305cc3cfe4c49efd7a27949e16f5ce38c2de862b736399de5c3c79b13", "session.id": "dd48a519-9567-43fa-b0e6-dc65d4e6b449", "terminal.type": "wsl-Ubuntu-24.04", "gen_ai.provider.name": "anthropic", "span.type": "tool.blocked_on_user", "gen_ai.conversation.id": "dd48a519-9567-43fa-b0e6-dc65d4e6b449", "duration_ms": 6, "decision": "reject", "source": "config", "_nombre": "claude_code.tool.blocked_on_user", "_traza": "e26298b5f80f7b07bd93b6fde3994fae", "_tramo": "9ee80536f32968be", "_padre": "696754c629fd530d", "_inicio_ns": 1794690187541000000, "_fin_ns": 1794690187546558053, "_estado": 0}
{"host.arch": "amd64", "os.type": "linux", "os.version": "6.18.33.2-microsoft-standard-WSL2", "service.name": "claude-code", "service.version": "2.1.312", "wsl.version": "2", "user.id": "0f72bbf305cc3cfe4c49efd7a27949e16f5ce38c2de862b736399de5c3c79b13", "session.id": "dd48a519-9567-43fa-b0e6-dc65d4e6b449", "terminal.type": "wsl-Ubuntu-24.04", "gen_ai.provider.name": "anthropic", "span.type": "tool", "tool_name": "Bash", "tool_name_safe": "Bash", "gen_ai.operation.name": "execute_tool", "gen_ai.tool.name": "Bash", "gen_ai.conversation.id": "dd48a519-9567-43fa-b0e6-dc65d4e6b449", "full_command": "cat > tests/test_ocupacion.py <<'E'\nfrom datetime import datetime, timezone\n\nfrom conftest import ADMIN\nfrom pulso import db\n\nURL = '/admin/ocupacion.csv'\nCAB = 'fecha,hora,clase,instructor,cupo,confirmadas,ocupacion_pct'\n\n\ndef utc(*a):\n    return datetime(*a, tzinfo=timezone.utc)\n\n\ndef pedir(cliente, desde, hasta, headers=ADMIN):\n    return cliente.get(URL, params={'desde': desde, 'hasta': hasta}, headers=headers)\n\n\ndef test_requiere_admin(cliente):\n    assert cliente.get(URL).status_code == 401\n    assert pedir(cliente, '2026-11-01', '2026-11-30', {'X-Admin-Key': 'x'}).status_code == 401\n    assert pedir(cliente, 'mal', '2026-11-30', {}).status_code == 401\n\n\ndef test_validaciones(cliente):\n    assert cliente.get(URL, params={'desde': '2026-11-01'}, headers=ADMIN).status_code == 422\n    assert cliente.get(URL, headers=ADMIN).status_code == 422\n    assert pedir(cliente, '01/11/2026', '2026-11-30').status_code == 422\n    assert pedir(cliente, '2026-11-30', '2026-11-01').status_code == 422\n    assert pedir(cliente, '2026-10-01', '2026-11-01').status_code == 422\n    assert pedir(cliente, '2026-10-01', '2026-10-31').status_code == 200\n\n\ndef test_vacio_solo_encabezado(cliente):\n    r = pedir(cliente, '2026-11-01', '2026-11-30')\n    assert r.headers['content-type'] == 'text/csv; charset=utf-8'\n    assert r.text.strip() == CAB\n\n\ndef test_filas_formato_y_conteo(cliente):\n    s = [db.crear_socio(f'S{i}', f's{i}@x.com') for i in range(8)]\n    # 03/11 22:30 UTC = 03/11 19:30 Montevideo\n    y = db.crear_clase('Yoga, \"nivel\" 1', 'Sofía', utc(2026, 11, 3, 22, 30), cupo=8)\n    sp = db.crear_clase('Spinning', 'Leo', utc(2026, 11, 3, 10, 0), cupo=8)\n    for x in s[:1]:\n        db.crear_reserva(x['id'], y['id'], utc(2026, 11, 1))\n    db.crear_reserva(s[1]['id'], y['id'], utc(2026, 11, 1), estado='cancelada')\n    r = pedir(cliente, '2026-11-03', '2026-11-03')\n    assert r.text.splitlines() == [\n        CAB,\n        '2026-11-03,07:00,Spinning,Leo,8,0,0',\n        '2026-11-03,19:30,\"Yoga, \"\"nivel\"\" 1\",Sofía,8,1,13',\n    ]\n    assert sp['id']\n\n\ndef test_extremos_en_hora_montevideo(cliente):\n    db.crear_clase('A', 'x', utc(2026, 11, 1, 2, 59))   # 31/10 23:59 local: fuera\n    db.crear_clase('B', 'x', utc(2026, 11, 1, 3, 0))    # 01/11 00:00 local\n    db.crear_clase('C', 'x', utc(2026, 12, 1, 2, 59))   # 30/11 23:59 local\n    db.crear_clase('D', 'x', utc(2026, 12, 1, 3, 0))    # 01/12: fuera\n    lineas = pedir(cliente, '2026-11-01', '2026-11-30').text.splitlines()\n    assert [l.split(',')[2] for l in lineas[1:]] == ['B', 'C']\n\n\ndef test_redondeo_mitad_arriba(cliente):\n    c = db.crear_clase('R', 'x', utc(2026, 11, 5, 12), cupo=8)\n    db.crear_reserva(db.crear_socio('a', 'a@x.com')['id'], c['id'], utc(2026, 11, 1))\n    assert pedir(cliente, '2026-11-05', '2026-11-05').text.splitlines()[1].endswith(',8,1,13')\nE\npython -m pytest -q 2>&1 | tail -8", "bash_command_class": "file_read", "bash_argv0": "cat", "tool_use_id": "toolu_01BVACSR1NW1kaUa165sRrKY", "gen_ai.tool.call.id": "toolu_01BVACSR1NW1kaUa165sRrKY", "duration_ms": 6, "_nombre": "claude_code.tool", "_traza": "e26298b5f80f7b07bd93b6fde3994fae", "_tramo": "696754c629fd530d", "_padre": "946675a45b2313c2", "_inicio_ns": 1794690187541000000, "_fin_ns": 1794690187546695390, "_estado": 0}
