diff --git a/tests/test_conciliacion.py b/tests/test_conciliacion.py
new file mode 100644
index 0000000..3fce841
--- /dev/null
+++ b/tests/test_conciliacion.py
@@ -0,0 +1,157 @@
+from datetime import timedelta
+
+from conftest import ADMIN, AHORA, auth
+from pulso import db, reloj
+
+
+def comprar(cliente, socio, pack='pack-4'):
+    r = cliente.post('/compras', json={'pack': pack}, headers=auth(socio))
+    assert r.status_code == 201
+    return r.json()
+
+
+def conciliar(cliente):
+    r = cliente.post('/admin/conciliar-pagos', headers=ADMIN)
+    assert r.status_code == 200
+    return r.json()
+
+
+def creditos(cliente, socio):
+    return cliente.get('/yo', headers=auth(socio)).json()['creditos']
+
+
+def test_conciliar_requiere_clave_de_admin(cliente, cobra):
+    assert cliente.post('/admin/conciliar-pagos').status_code == 401
+    assert cliente.post('/admin/conciliar-pagos', headers={'X-Admin-Key': 'otra'}).status_code == 401
+    assert cobra.llamadas == []
+
+
+def test_sin_compras_pendientes_todo_en_cero(cliente, cobra):
+    assert conciliar(cliente) == {'aprobadas': 0, 'rechazadas': 0, 'pendientes': 0}
+
+
+def test_pago_pendiente_queda_pendiente(cliente, socio, cobra):
+    comprar(cliente, socio)
+    assert conciliar(cliente) == {'aprobadas': 0, 'rechazadas': 0, 'pendientes': 1}
+    assert cliente.get('/compras', headers=auth(socio)).json()[0]['estado'] == 'pendiente'
+
+
+def test_pago_aprobado_se_aplica_aunque_el_webhook_se_haya_perdido(cliente, socio, cobra):
+    comprar(cliente, socio, pack='pack-8')
+    cobra.cambiar_estado('pag_1', 'aprobado')
+    assert conciliar(cliente) == {'aprobadas': 1, 'rechazadas': 0, 'pendientes': 0}
+    assert creditos(cliente, socio) == 16
+    assert [c['asunto'] for c in db.correos()] == ['Compra de créditos aprobada']
+
+
+def test_pago_rechazado_rechaza_la_compra(cliente, socio, cobra):
+    comprar(cliente, socio)
+    cobra.cambiar_estado('pag_1', 'rechazado')
+    assert conciliar(cliente) == {'aprobadas': 0, 'rechazadas': 1, 'pendientes': 0}
+    assert creditos(cliente, socio) == 8
+    assert db.correos() == []
+
+
+def test_compra_sin_pago_encuentra_el_pago_por_referencia(cliente, socio, cobra):
+    cobra.fallar['/pagos'] = 500
+    cliente.post('/compras', json={'pack': 'pack-4'}, headers=auth(socio))
+    del cobra.fallar['/pagos']
+    cobra.crear_pago_externo('pulso-compra-1', estado='aprobado')
+    assert conciliar(cliente) == {'aprobadas': 1, 'rechazadas': 0, 'pendientes': 0}
+    [compra] = cliente.get('/compras', headers=auth(socio)).json()
+    assert compra['estado'] == 'aprobada'
+    assert compra['url_pago'] == 'https://pagar.cobra.test/pag_1'
+    assert creditos(cliente, socio) == 12
+
+
+def test_compra_sin_pago_reciente_queda_pendiente(cliente, socio, cobra):
+    cobra.fallar['/pagos'] = 500
+    cliente.post('/compras', json={'pack': 'pack-4'}, headers=auth(socio))
+    del cobra.fallar['/pagos']
+    reloj.fijar(AHORA + timedelta(minutes=29, seconds=59))
+    assert conciliar(cliente) == {'aprobadas': 0, 'rechazadas': 0, 'pendientes': 1}
+    assert cliente.get('/compras', headers=auth(socio)).json()[0]['estado'] == 'pendiente'
+
+
+def test_compra_sin_pago_de_30_minutos_se_rechaza(cliente, socio, cobra):
+    cobra.fallar['/pagos'] = 500
+    cliente.post('/compras', json={'pack': 'pack-4'}, headers=auth(socio))
+    del cobra.fallar['/pagos']
+    reloj.fijar(AHORA + timedelta(minutes=30))
+    assert conciliar(cliente) == {'aprobadas': 0, 'rechazadas': 1, 'pendientes': 0}
+    [compra] = cliente.get('/compras', headers=auth(socio)).json()
+    assert compra['estado'] == 'rechazada'
+    assert compra['url_pago'] is None
+    assert creditos(cliente, socio) == 8
+
+
+def test_cobra_falla_al_buscar_por_referencia_no_rechaza(cliente, socio, cobra):
+    cobra.fallar['/pagos'] = 500
+    cliente.post('/compras', json={'pack': 'pack-4'}, headers=auth(socio))
+    reloj.fijar(AHORA + timedelta(hours=3))
+    cobra.fallar['pulso-compra-1'] = 500
+    assert conciliar(cliente) == {'aprobadas': 0, 'rechazadas': 0, 'pendientes': 1}
+    assert cliente.get('/compras', headers=auth(socio)).json()[0]['estado'] == 'pendiente'
+
+
+def test_cobra_falla_con_una_compra_sigue_con_las_demas(cliente, socio, cobra):
+    comprar(cliente, socio)          # pag_1, Cobrá dará error
+    comprar(cliente, socio, 'pack-8')  # pag_2, aprobado
+    cobra.cambiar_estado('pag_2', 'aprobado')
+    cobra.fallar['pag_1'] = 500
+    assert conciliar(cliente) == {'aprobadas': 1, 'rechazadas': 0, 'pendientes': 1}
+    estados = [c['estado'] for c in cliente.get('/compras', headers=auth(socio)).json()]
+    assert estados == ['aprobada', 'pendiente']
+    assert creditos(cliente, socio) == 16
+
+
+def test_cobra_sin_respuesta_no_rechaza_compra_vieja_con_pago(cliente, socio, cobra):
+    comprar(cliente, socio)
+    reloj.fijar(AHORA + timedelta(hours=5))
+    cobra.fallar['pag_1'] = 'timeout'
+    assert conciliar(cliente) == {'aprobadas': 0, 'rechazadas': 0, 'pendientes': 1}
+
+
+def test_compras_ya_cerradas_no_se_cuentan(cliente, socio, cobra):
+    comprar(cliente, socio)
+    comprar(cliente, socio)
+    cobra.cambiar_estado('pag_1', 'aprobado')
+    cobra.cambiar_estado('pag_2', 'rechazado')
+    assert conciliar(cliente) == {'aprobadas': 1, 'rechazadas': 1, 'pendientes': 0}
+    assert conciliar(cliente) == {'aprobadas': 0, 'rechazadas': 0, 'pendientes': 0}
+
+
+def test_conciliar_dos_veces_no_suma_creditos_ni_manda_otro_correo(cliente, socio, cobra):
+    comprar(cliente, socio)
+    cobra.cambiar_estado('pag_1', 'aprobado')
+    conciliar(cliente)
+    conciliar(cliente)
+    assert creditos(cliente, socio) == 12
+    assert len(db.correos()) == 1
+
+
+def test_webhook_y_conciliacion_no_suman_dos_veces(cliente, socio, cobra):
+    comprar(cliente, socio)
+    cobra.cambiar_estado('pag_1', 'aprobado')
+    cliente.post('/webhooks/pagos', json={'pago_id': 'pag_1'})
+    assert conciliar(cliente) == {'aprobadas': 0, 'rechazadas': 0, 'pendientes': 0}
+    assert creditos(cliente, socio) == 12
+    assert len(db.correos()) == 1
+
+
+def test_conciliacion_consulta_por_id_si_la_compra_ya_tiene_pago(cliente, socio, cobra):
+    comprar(cliente, socio)
+    cobra.cambiar_estado('pag_1', 'aprobado')
+    conciliar(cliente)
+    rutas = [x['ruta'] for x in cobra.llamadas if x['metodo'] == 'GET']
+    assert rutas == ['/pagos/pag_1']
+
+
+def test_conciliacion_revisa_compras_de_todos_los_socios(cliente, socio, cobra):
+    otro = db.crear_socio('Juan Gómez', 'juan@example.com')
+    comprar(cliente, socio)
+    comprar(cliente, otro)
+    cobra.cambiar_estado('pag_2', 'aprobado')
+    assert conciliar(cliente) == {'aprobadas': 1, 'rechazadas': 0, 'pendientes': 1}
+    assert creditos(cliente, otro) == 12
+    assert creditos(cliente, socio) == 8
diff --git a/tests/test_webhook.py b/tests/test_webhook.py
new file mode 100644
index 0000000..5e30f99
--- /dev/null
+++ b/tests/test_webhook.py
@@ -0,0 +1,116 @@
+from conftest import auth
+from pulso import db
+
+
+def comprar(cliente, socio, pack='pack-4'):
+    r = cliente.post('/compras', json={'pack': pack}, headers=auth(socio))
+    assert r.status_code == 201
+    return r.json()
+
+
+def avisar(cliente, pago_id, estado='aprobado'):
+    return cliente.post('/webhooks/pagos', json={'pago_id': pago_id, 'estado': estado})
+
+
+def test_pago_aprobado_suma_creditos_y_manda_correo(cliente, socio, cobra):
+    comprar(cliente, socio)
+    cobra.cambiar_estado('pag_1', 'aprobado')
+    r = avisar(cliente, 'pag_1')
+    assert r.status_code == 200
+    assert r.json() == {'compra_id': 1, 'estado': 'aprobada'}
+    assert cliente.get('/yo', headers=auth(socio)).json()['creditos'] == 12
+    [correo] = db.correos()
+    assert correo['para'] == 'ana@example.com'
+    assert correo['asunto'] == 'Compra de créditos aprobada'
+
+
+def test_pago_rechazado_no_suma_ni_manda_correo(cliente, socio, cobra):
+    comprar(cliente, socio)
+    cobra.cambiar_estado('pag_1', 'rechazado')
+    r = avisar(cliente, 'pag_1', estado='rechazado')
+    assert r.json() == {'compra_id': 1, 'estado': 'rechazada'}
+    assert cliente.get('/yo', headers=auth(socio)).json()['creditos'] == 8
+    assert db.correos() == []
+
+
+def test_pago_pendiente_no_cambia_nada(cliente, socio, cobra):
+    comprar(cliente, socio)
+    r = avisar(cliente, 'pag_1', estado='pendiente')
+    assert r.json() == {'compra_id': 1, 'estado': 'pendiente'}
+    assert cliente.get('/compras', headers=auth(socio)).json()[0]['estado'] == 'pendiente'
+    assert db.correos() == []
+
+
+def test_aviso_repetido_suma_una_sola_vez(cliente, socio, cobra):
+    comprar(cliente, socio)
+    cobra.cambiar_estado('pag_1', 'aprobado')
+    for _ in range(3):
+        assert avisar(cliente, 'pag_1').json()['estado'] == 'aprobada'
+    assert cliente.get('/yo', headers=auth(socio)).json()['creditos'] == 12
+    assert len(db.correos()) == 1
+
+
+def test_compra_aprobada_no_vuelve_a_cambiar(cliente, socio, cobra):
+    comprar(cliente, socio)
+    cobra.cambiar_estado('pag_1', 'aprobado')
+    avisar(cliente, 'pag_1')
+    cobra.cambiar_estado('pag_1', 'rechazado')
+    assert avisar(cliente, 'pag_1', estado='rechazado').json()['estado'] == 'aprobada'
+    assert cliente.get('/yo', headers=auth(socio)).json()['creditos'] == 12
+
+
+def test_el_estado_del_cuerpo_se_ignora(cliente, socio, cobra):
+    comprar(cliente, socio)
+    # Cobrá dice pendiente; el cuerpo dice aprobado y no debe importar.
+    r = avisar(cliente, 'pag_1', estado='aprobado')
+    assert r.json()['estado'] == 'pendiente'
+    assert cliente.get('/yo', headers=auth(socio)).json()['creditos'] == 8
+
+
+def test_pago_que_cobra_no_conoce_da_404(cliente, socio, cobra):
+    assert avisar(cliente, 'pag_999').status_code == 404
+
+
+def test_pago_de_otra_referencia_da_404(cliente, socio, cobra):
+    cobra.crear_pago_externo('otra-cosa', estado='aprobado')
+    cobra.crear_pago_externo('pulso-compra-999', estado='aprobado')
+    assert avisar(cliente, 'pag_1').status_code == 404
+    assert avisar(cliente, 'pag_2').status_code == 404
+    assert db.correos() == []
+
+
+def test_cobra_caido_da_503_y_no_cambia_nada(cliente, socio, cobra):
+    comprar(cliente, socio)
+    cobra.cambiar_estado('pag_1', 'aprobado')
+    for falla in (500, 401, 'conexion', 'timeout'):
+        cobra.fallar['pag_1'] = falla
+        assert avisar(cliente, 'pag_1').status_code == 503
+    assert cliente.get('/compras', headers=auth(socio)).json()[0]['estado'] == 'pendiente'
+    assert cliente.get('/yo', headers=auth(socio)).json()['creditos'] == 8
+    assert db.correos() == []
+
+
+def test_sin_pago_id_da_422(cliente, cobra):
+    assert cliente.post('/webhooks/pagos', json={'estado': 'aprobado'}).status_code == 422
+    assert cliente.post('/webhooks/pagos', json={'pago_id': ''}).status_code == 422
+    assert cliente.post('/webhooks/pagos').status_code == 422
+    assert cobra.llamadas == []
+
+
+def test_pago_id_se_escapa_en_la_consulta(cliente, cobra):
+    assert avisar(cliente, 'x/../pagos').status_code == 404
+    assert cobra.llamadas[-1]['ruta'] == '/pagos/x%2F..%2Fpagos'
+
+
+def test_aviso_guarda_el_pago_de_una_compra_que_quedo_sin_pago(cliente, socio, cobra):
+    cobra.fallar['/pagos'] = 500
+    assert cliente.post('/compras', json={'pack': 'pack-4'}, headers=auth(socio)).status_code == 502
+    del cobra.fallar['/pagos']
+    # Cobrá creó el pago igual, aunque Pulso no recibió la respuesta.
+    pago = cobra.crear_pago_externo('pulso-compra-1', estado='aprobado')
+    r = avisar(cliente, pago['id'])
+    assert r.json() == {'compra_id': 1, 'estado': 'aprobada'}
+    [compra] = cliente.get('/compras', headers=auth(socio)).json()
+    assert compra['estado'] == 'aprobada'
+    assert compra['url_pago'] == pago['url_pago']
+    assert cliente.get('/yo', headers=auth(socio)).json()['creditos'] == 12
