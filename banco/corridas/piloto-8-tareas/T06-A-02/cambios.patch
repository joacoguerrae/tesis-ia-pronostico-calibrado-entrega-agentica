diff --git a/tests/test_espera.py b/tests/test_espera.py
new file mode 100644
index 0000000..ea194a2
--- /dev/null
+++ b/tests/test_espera.py
@@ -0,0 +1,143 @@
+from datetime import timedelta
+
+from conftest import ADMIN, AHORA, auth
+from pulso import db, reloj
+
+
+def llena(cupo=1, horas=6):
+    clase = db.crear_clase('Spinning', 'Leo', AHORA + timedelta(hours=horas), cupo=cupo)
+    dueños = []
+    for i in range(cupo):
+        s = db.crear_socio(f'D{i}', f"d{i}-{clase['id']}@example.com")
+        dueños.append((s, db.crear_reserva(s['id'], clase['id'], AHORA)))
+    return clase, dueños
+
+
+def anotar(cliente, socio, clase):
+    return cliente.post(f"/clases/{clase['id']}/espera", headers=auth(socio))
+
+
+def cancelar(cliente, reserva):
+    return cliente.post(f"/admin/reservas/{reserva['id']}/cancelar", headers=ADMIN)
+
+
+def test_anotarse_posicion_y_bajarse(cliente):
+    clase, _ = llena()
+    a, b, c = (db.crear_socio(n, f'{n}@x.com') for n in 'abc')
+    assert anotar(cliente, a, clase).json() == {'clase_id': clase['id'], 'posicion': 1}
+    assert anotar(cliente, b, clase).json()['posicion'] == 2
+    assert anotar(cliente, c, clase).json()['posicion'] == 3
+    assert cliente.delete(f"/clases/{clase['id']}/espera", headers=auth(a)).status_code == 204
+    assert cliente.get(f"/clases/{clase['id']}/espera", headers=auth(c)).json()['posicion'] == 2
+    assert cliente.get(f"/clases/{clase['id']}/espera", headers=auth(a)).status_code == 404
+    assert cliente.delete(f"/clases/{clase['id']}/espera", headers=auth(a)).status_code == 404
+    assert anotar(cliente, a, clase).json()['posicion'] == 3
+    assert db.socio(a['id'])['creditos'] == 8
+
+
+def test_auth_y_404(cliente, socio):
+    clase, _ = llena()
+    url = f"/clases/{clase['id']}/espera"
+    for m in (cliente.post, cliente.get, cliente.delete):
