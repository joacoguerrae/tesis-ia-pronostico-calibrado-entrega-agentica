+class FakeCobra:
+    """Cobrá falso: guarda los pagos y responde según el contrato. `caida` hace fallar todo lo que llega."""
+
+    def __init__(self):
+        self.pagos = {}
+        self.por_clave = {}
+        self.pedidos = []
+        self.caida = None  # int (código HTTP) o excepción de httpx
+        self.responder_500_al_crear = False  # crea el pago pero contesta 500
+        self.fallar_pagos = set()  # ids de pago cuya consulta por id responde 500
+        self._n = 0
+
+    def transporte(self):
+        return httpx.MockTransport(self._responder)
+
+    def _responder(self, request):
+        self.pedidos.append(request)
+        if request.headers.get('X-Cobra-Clave') != CLAVE_COBRA:
+            return httpx.Response(401, json={'error': 'clave inválida'})
+        if isinstance(self.caida, Exception):
+            raise self.caida
+        if self.caida is not None:
+            return httpx.Response(self.caida, json={'error': 'caída'})
+        ruta = request.url.path
+        if request.method == 'POST' and ruta == '/v1/pagos':
+            return self._crear(request)
+        if request.method == 'GET' and ruta == '/v1/pagos':
+            ref = request.url.params.get('referencia')
+            return httpx.Response(200, json={'pagos': [p for p in self.pagos.values() if p['referencia'] == ref]})
+        if request.method == 'GET' and ruta.startswith('/v1/pagos/'):
+            pago_id = ruta.removeprefix('/v1/pagos/')
+            if pago_id in self.fallar_pagos:
+                return httpx.Response(500, json={'error': 'falla puntual'})
+            pago = self.pagos.get(pago_id)
+            return httpx.Response(200, json=pago) if pago else httpx.Response(404, json={'error': 'no existe'})
+        return httpx.Response(404, json={'error': 'ruta'})
+
+    def _crear(self, request):
+        clave = request.headers.get('Idempotency-Key')
+        datos = json.loads(request.content)
+        if not clave or not all(k in datos for k in ('monto', 'moneda', 'referencia')):
+            return httpx.Response(422, json={'error': 'faltan datos'})
+        if clave in self.por_clave:
+            return httpx.Response(200, json=self.pagos[self.por_clave[clave]])
+        self._n += 1
+        pago_id = f'pag_{self._n}'
+        self.pagos[pago_id] = {'id': pago_id, 'estado': 'pendiente', 'monto': datos['monto'], 'moneda': datos['moneda'],
+                               'referencia': datos['referencia'], 'url_pago': f'https://pagar.cobra.test/{pago_id}'}
+        self.por_clave[clave] = pago_id
+        if self.responder_500_al_crear:
+            return httpx.Response(500, json={'error': 'se perdió la respuesta'})
+        return httpx.Response(201, json=self.pagos[pago_id])
+
+    # Ayudas para los tests
+    def pago_de(self, compra_id):
+        return next(p for p in self.pagos.values() if p['referencia'] == f'pulso-compra-{compra_id}')
+
+    def cambiar(self, pago_id, estado):
+        self.pagos[pago_id]['estado'] = estado
+
+
+@pytest.fixture
+def cobra_falsa(monkeypatch):
+    fake = FakeCobra()
+    monkeypatch.setenv('PULSO_PAGOS_URL', URL_COBRA)
+    monkeypatch.setenv('PULSO_PAGOS_CLAVE', CLAVE_COBRA)
+    transporte = fake.transporte()
+    monkeypatch.setattr(cobra, '_cliente', lambda: httpx.Client(transport=transporte, timeout=5.0))
+    return fake
diff --git a/tests/test_compras.py b/tests/test_compras.py
new file mode 100644
index 0000000..ac144e2
--- /dev/null
+++ b/tests/test_compras.py
@@ -0,0 +1,292 @@
+from datetime import timedelta
+
+import httpx
+import pytest
+
+from conftest import ADMIN, AHORA, auth
+from pulso import db, reloj
+
+
+def comprar(cliente, socio, pack='pack-4'):
+    return cliente.post('/compras', json={'pack': pack}, headers=auth(socio))
+
+
+def webhook(cliente, pago_id, estado='aprobado'):
+    return cliente.post('/webhooks/pagos', json={'pago_id': pago_id, 'estado': estado})
+
+
+def conciliar(cliente):
+    return cliente.post('/admin/conciliar-pagos', headers=ADMIN)
+
+
+def compra_con_pago(cliente, socio, cobra_falsa, pack='pack-4'):
+    """Compra creada con pago en Cobrá. Devuelve el id de la compra."""
+    r = comprar(cliente, socio, pack)
+    assert r.status_code == 201
+    return r.json()['id']
+
+
+# --- Compra ---
+
+def test_compra_crea_pago_en_cobra(cliente, socio, cobra_falsa):
+    r = comprar(cliente, socio)
+    assert r.status_code == 201
+    datos = r.json()
+    assert datos['estado'] == 'pendiente'
+    assert (datos['pack'], datos['creditos'], datos['monto']) == ('pack-4', 4, 1200)
+    assert datos['url_pago'] == cobra_falsa.pago_de(datos['id'])['url_pago']
+    pago = cobra_falsa.pago_de(datos['id'])
+    assert (pago['monto'], pago['moneda']) == (1200, 'UYU')
+    creado = [p for p in cobra_falsa.pedidos if p.method == 'POST']
+    assert creado[0].headers['Idempotency-Key'] == f"pulso-compra-{datos['id']}"
+    assert creado[0].headers['X-Cobra-Clave'] == 'clave-cobra'
+    assert cliente.get('/yo', headers=auth(socio)).json()['creditos'] == 8
+
+
+def test_compra_pack_8(cliente, socio, cobra_falsa):
+    r = comprar(cliente, socio, 'pack-8')
+    assert r.json()['monto'] == 2200 and r.json()['creditos'] == 8
+    assert cobra_falsa.pago_de(r.json()['id'])['monto'] == 2200
+
+
+@pytest.mark.parametrize('cuerpo', [{'pack': 'pack-99'}, {'pack': ''}, {}])
+def test_pack_invalido_422_no_crea_nada(cliente, socio, cobra_falsa, cuerpo):
+    r = cliente.post('/compras', json=cuerpo, headers=auth(socio))
+    assert r.status_code == 422
+    assert db.compras_de(socio['id']) == []
+    assert cobra_falsa.pagos == {}
+
+
+def test_compra_sin_token(cliente, cobra_falsa):
+    assert cliente.post('/compras', json={'pack': 'pack-4'}).status_code == 401
+
+
+def test_cobra_falla_al_crear_502_y_queda_pendiente(cliente, socio, cobra_falsa):
+    cobra_falsa.caida = 500
+    r = comprar(cliente, socio)
+    assert r.status_code == 502
+    [compra] = db.compras_de(socio['id'])
+    assert compra['estado'] == 'pendiente' and compra['pago_id'] is None
+    assert cobra_falsa.pagos == {}
+
+
+def test_cobra_no_conecta_502(cliente, socio, cobra_falsa):
+    cobra_falsa.caida = httpx.ConnectError('conexión rechazada')
+    assert comprar(cliente, socio).status_code == 502
+
+
+def test_cobra_crea_pero_no_responde_no_duplica_el_pago(cliente, socio, cobra_falsa):
+    cobra_falsa.responder_500_al_crear = True
+    assert comprar(cliente, socio).status_code == 502
+    [compra] = db.compras_de(socio['id'])
+    assert compra['estado'] == 'pendiente' and compra['pago_id'] is None
+    assert len(cobra_falsa.pagos) == 1
+
+
+# --- Webhook ---
+
+def test_webhook_aprobado_suma_creditos_y_manda_correo(cliente, socio, cobra_falsa):
