diff --git a/pulso/main.py b/pulso/main.py
index 039212d..0f112e9 100644
--- a/pulso/main.py
+++ b/pulso/main.py
@@ -1,6 +1,8 @@
 import os
+import re
+from datetime import date
 
-from fastapi import APIRouter, Depends, FastAPI, Header, HTTPException
+from fastapi import APIRouter, Depends, FastAPI, Header, HTTPException, Response
 from pydantic import AwareDatetime, BaseModel, Field
 
 from pulso import correo, db, reloj
@@ -30,10 +32,49 @@ def ver_reserva(reserva):
     return {k: reserva[k] for k in ('id', 'clase_id', 'estado', 'creada')}
 
 
+def parsear_dia(texto, nombre):
+    if texto is None:
+        return None
+    if not re.fullmatch(r'\d{4}-\d{2}-\d{2}', texto):
+        raise HTTPException(422, f'{nombre} debe tener el formato YYYY-MM-DD')
+    try:
+        return date.fromisoformat(texto)
+    except ValueError:
+        raise HTTPException(422, f'{nombre} no es una fecha válida')
+
+
 @router.get('/clases')
-def listar_clases():
+def listar_clases(response: Response, desde: str | None = None, hasta: str | None = None,
+                  instructor: str | None = None, con_lugar: bool = False,
+                  pagina: int = 1, por_pagina: int = 20):
+    if pagina < 1:
+        raise HTTPException(422, 'pagina debe ser al menos 1')
+    if not 1 <= por_pagina <= 50:
+        raise HTTPException(422, 'por_pagina debe estar entre 1 y 50')
+    dia_desde = parsear_dia(desde, 'desde')
+    dia_hasta = parsear_dia(hasta, 'hasta')
+    if dia_desde and dia_hasta and dia_desde > dia_hasta:
+        raise HTTPException(422, 'desde no puede ser posterior a hasta')
     ahora = reloj.ahora()
-    return [ver_clase(c) for c in db.clases() if db.a_fecha(c['inicio']) > ahora]
+    nombre = instructor.casefold() if instructor is not None else None
+    resultado = []
+    for c in db.clases():
+        inicio = db.a_fecha(c['inicio'])
+        if inicio <= ahora:
+            continue
+        dia = inicio.astimezone(reloj.MONTEVIDEO).date()
+        if (dia_desde and dia < dia_desde) or (dia_hasta and dia > dia_hasta):
+            continue
+        if nombre is not None and c['instructor'].casefold() != nombre:
+            continue
+        if con_lugar:
+            c = ver_clase(c)
+            if c['lugares_libres'] <= 0:
+                continue
+        resultado.append(c)
+    response.headers['X-Total'] = str(len(resultado))
+    base = (pagina - 1) * por_pagina
+    return [c if 'lugares_libres' in c else ver_clase(c) for c in resultado[base:base + por_pagina]]
 
 
 @router.get('/clases/{clase_id}')
