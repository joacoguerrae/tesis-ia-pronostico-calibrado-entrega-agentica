@@ -0,0 +1,140 @@
+from datetime import timedelta
+
+from conftest import ADMIN, AHORA, auth
+from pulso import db, reloj
+
+
+def llena(cupo=1, horas=6):
+    clase = db.crear_clase('Spinning', 'Leo', AHORA + timedelta(hours=horas), cupo=cupo)
+    ocupantes = []
+    for i in range(cupo):
+        s = db.crear_socio(f'Ocupante {i}', f'o{i}-{clase["id"]}@example.com')
+        ocupantes.append((s, db.crear_reserva(s['id'], clase['id'], AHORA)))
+    return clase, ocupantes
+
+
+def espera(cliente, clase, socio):
+    return cliente.post(f"/clases/{clase['id']}/espera", headers=auth(socio))
+
+
+def cancelar(cliente, reserva):
+    return cliente.post(f"/admin/reservas/{reserva['id']}/cancelar", headers=ADMIN)
+
+
+def test_anotarse_posicion_y_bajarse(cliente, socio):
+    clase, _ = llena()
+    otro = db.crear_socio('Beto', 'beto@example.com')
+    assert espera(cliente, clase, socio).json() == {'clase_id': clase['id'], 'posicion': 1}
+    assert espera(cliente, clase, otro).json()['posicion'] == 2
+    assert db.socio(socio['id'])['creditos'] == 8
+    assert cliente.delete(f"/clases/{clase['id']}/espera", headers=auth(socio)).status_code == 204
+    assert cliente.get(f"/clases/{clase['id']}/espera", headers=auth(otro)).json()['posicion'] == 1
+    assert cliente.get(f"/clases/{clase['id']}/espera", headers=auth(socio)).status_code == 404
+    assert cliente.delete(f"/clases/{clase['id']}/espera", headers=auth(socio)).status_code == 404
+    assert espera(cliente, clase, socio).json()['posicion'] == 2
+
+
+def test_espera_auth_y_404(cliente, socio):
+    clase, _ = llena()
+    assert cliente.post(f"/clases/{clase['id']}/espera").status_code == 401
+    assert cliente.get(f"/clases/{clase['id']}/espera").status_code == 401
+    assert cliente.delete(f"/clases/{clase['id']}/espera").status_code == 401
+    assert cliente.post('/clases/99/espera', headers=auth(socio)).status_code == 404
+
+
+def test_no_se_puede_anotar(cliente, socio):
+    libre = db.crear_clase('Yoga', 'Sofía', AHORA + timedelta(hours=3))
+    assert espera(cliente, libre, socio).status_code == 409
+    clase, ocupantes = llena()
+    assert espera(cliente, clase, ocupantes[0][0]).status_code == 409
+    assert espera(cliente, clase, socio).status_code == 201
+    assert espera(cliente, clase, socio).status_code == 409
+    sin = db.crear_socio('Sin', 'sin@example.com', creditos=0)
+    assert espera(cliente, clase, sin).status_code == 409
+    empezada, _ = llena(horas=-1)
+    assert espera(cliente, empezada, socio).status_code == 409
+    reloj.fijar(db.a_fecha(clase['inicio']))
+    assert espera(cliente, clase, db.crear_socio('X', 'x@example.com')).status_code == 409
+
+
+def test_cancelar_asigna_al_primero(cliente, socio):
+    clase, [(_, res)] = llena()
+    otro = db.crear_socio('Beto', 'beto@example.com')
+    espera(cliente, clase, socio)
+    espera(cliente, clase, otro)
+    r = cancelar(cliente, res)
+    assert r.status_code == 200 and r.json()['estado'] == 'cancelada'
+    assert cliente.get('/yo', headers=auth(socio)).json()['creditos'] == 7
+    reservas = cliente.get('/reservas', headers=auth(socio)).json()
+    assert [x['estado'] for x in reservas] == ['confirmada']
+    assert cliente.get(f"/clases/{clase['id']}/espera", headers=auth(socio)).status_code == 404
+    assert cliente.get(f"/clases/{clase['id']}/espera", headers=auth(otro)).json()['posicion'] == 1
+    asuntos = [c['asunto'] for c in db.correos() if c['para'] == socio['email']]
+    assert asuntos == ['Se liberó un lugar: Spinning el 10/11 a las 18:00']
+    assert db.confirmadas(clase['id']) == 1
+    # ocupante recupera crédito; segunda cancelación es 409 sin más efectos
+    assert cancelar(cliente, res).status_code == 409
+    assert db.socio(res['socio_id'])['creditos'] == 9
+
+
+def test_salta_sin_creditos_y_con_reserva(cliente, socio):
+    clase, _ = llena()
+    sin = db.crear_socio('Sin', 'sin@example.com', creditos=1)
+    espera(cliente, clase, sin)
+    db.sumar_creditos(sin['id'], -1)
+    ya = db.crear_socio('Ya', 'ya@example.com')
+    espera(cliente, clase, ya)
+    db.crear_reserva(ya['id'], clase['id'], AHORA)  # reservó por otro lado: 2 de cupo 1
+    espera(cliente, clase, socio)
+    r = cliente.patch(f"/admin/clases/{clase['id']}", json={'cupo': 3}, headers=ADMIN)
+    assert r.json()['lugares_libres'] == 0
+    asuntos = [(c['para'], c['asunto']) for c in db.correos()]
+    assert ('sin@example.com', 'No pudimos darte el lugar: Spinning el 10/11 a las 18:00') in asuntos
+    assert not any(p == 'ya@example.com' for p, _ in asuntos)
+    assert db.socio(ya['id'])['creditos'] == 8
+    assert [x['estado'] for x in cliente.get('/reservas', headers=auth(socio)).json()] == ['confirmada']
+    assert db.socio(sin['id'])['creditos'] == 0
+
+
+def test_cambiar_cupo_libera_varios(cliente, socio):
+    clase, _ = llena()
+    otro = db.crear_socio('Beto', 'beto@example.com')
+    tercero = db.crear_socio('Caro', 'caro@example.com')
+    for s in (socio, otro, tercero):
+        espera(cliente, clase, s)
+    r = cliente.patch(f"/admin/clases/{clase['id']}", json={'cupo': 3}, headers=ADMIN)
+    assert r.status_code == 200
+    assert r.json()['cupo'] == 3 and r.json()['lugares_libres'] == 0
+    assert cliente.get(f"/clases/{clase['id']}/espera", headers=auth(socio)).status_code == 404
+    assert cliente.get(f"/clases/{clase['id']}/espera", headers=auth(otro)).status_code == 404
+    assert cliente.get(f"/clases/{clase['id']}/espera", headers=auth(tercero)).json()['posicion'] == 1
+
+
+def test_cambiar_cupo_validaciones(cliente):
+    clase, _ = llena(cupo=2)
+    url = f"/admin/clases/{clase['id']}"
+    assert cliente.patch(url, json={'cupo': 5}).status_code == 401
+    assert cliente.patch(url, json={}, headers=ADMIN).status_code == 422
+    assert cliente.patch(url, json={'cupo': 0}, headers=ADMIN).status_code == 422
+    assert cliente.patch(url, json={'cupo': 'x'}, headers=ADMIN).status_code == 422
+    assert cliente.patch(url, json={'cupo': 1}, headers=ADMIN).status_code == 409
+    assert db.clase(clase['id'])['cupo'] == 2
+    assert cliente.patch(url, json={'cupo': 2}, headers=ADMIN).status_code == 200
+    assert cliente.patch('/admin/clases/99', json={'cupo': 2}, headers=ADMIN).status_code == 404
+
+
+def test_clase_empezada_no_asigna_pero_devuelve_credito(cliente, socio):
+    clase, [(oc, res)] = llena()
+    espera(cliente, clase, socio)
+    reloj.fijar(db.a_fecha(clase['inicio']))
+    assert cancelar(cliente, res).status_code == 200
+    assert db.socio(oc['id'])['creditos'] == 9
+    assert db.confirmadas(clase['id']) == 0
+    assert db.socio(socio['id'])['creditos'] == 8
+    r = cliente.patch(f"/admin/clases/{clase['id']}", json={'cupo': 4}, headers=ADMIN)
+    assert r.json()['lugares_libres'] == 4
+
+
+def test_cancelar_auth_y_404(cliente):
+    assert cliente.post('/admin/reservas/1/cancelar').status_code == 401
+    assert cliente.post('/admin/reservas/99/cancelar', headers=ADMIN).status_code == 404
