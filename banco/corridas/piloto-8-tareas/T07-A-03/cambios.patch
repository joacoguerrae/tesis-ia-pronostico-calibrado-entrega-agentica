@@ -0,0 +1,62 @@
+"""Cliente de Cobrá, la pasarela de pagos. Cualquier falla se informa con CobraError."""
+import os
+
+import httpx
+
+TIMEOUT = 5
+ESTADOS = ('pendiente', 'aprobado', 'rechazado')
+
+
+class CobraError(Exception):
+    pass
+
+
+class _NoEncontrado(CobraError):
+    pass
+
+
+def _pedir(metodo, ruta, esperados, **kwargs):
+    url = os.environ.get('PULSO_PAGOS_URL', '') + ruta
+    headers = dict(kwargs.pop('headers', {}), **{'X-Cobra-Clave': os.environ.get('PULSO_PAGOS_CLAVE', '')})
+    try:
+        r = httpx.request(metodo, url, headers=headers, timeout=TIMEOUT, **kwargs)
+    except httpx.HTTPError as e:
+        raise CobraError(str(e)) from e
+    if r.status_code == 404 and 404 in esperados:
+        raise _NoEncontrado()
+    if r.status_code not in esperados:
+        raise CobraError(f'Cobrá respondió {r.status_code}')
+    try:
+        return r.json()
+    except ValueError as e:
+        raise CobraError('Respuesta inválida') from e
+
+
+def _pago(datos):
+    if (not isinstance(datos, dict) or datos.get('estado') not in ESTADOS
+            or not isinstance(datos.get('id'), str) or not isinstance(datos.get('referencia'), str)):
+        raise CobraError('Pago inválido')
+    return datos
+
+
+def crear_pago(monto, referencia):
+    datos = _pedir('POST', '/pagos', (200, 201), headers={'Idempotency-Key': referencia},
+                   json={'monto': monto, 'moneda': 'UYU', 'referencia': referencia})
+    return _pago(datos)
+
+
+def obtener_pago(pago_id):
+    """El pago, o None si Cobrá no lo conoce."""
+    try:
+        datos = _pedir('GET', f'/pagos/{pago_id}', (200, 404))
+    except _NoEncontrado:
+        return None
+    return _pago(datos)
+
+
+def buscar_por_referencia(referencia):
+    """Lista de pagos con esa referencia (puede ser vacía)."""
+    datos = _pedir('GET', '/pagos', (200,), params={'referencia': referencia})
+    if not isinstance(datos, dict) or not isinstance(datos.get('pagos'), list):
+        raise CobraError('Respuesta inválida')
+    return [_pago(p) for p in datos['pagos']]
