+import httpx
+import pytest
+
+from conftest import ADMIN, auth
+from pulso import db
+
+BASE = 'https://beneficios.example.com'
+CLAVE = 'clave-beneficios'
+
+
+class ServicioFalso:
+    """Reemplaza httpx.get: anota cada consulta y responde lo que el test haya configurado."""
+
+    def __init__(self, monkeypatch):
+        self.llamadas = []
+        self.respuesta = None
+        monkeypatch.setattr(httpx, 'get', self._get)
+
+    def _get(self, url, headers=None, timeout=None):
+        self.llamadas.append({'url': url, 'headers': headers, 'timeout': timeout})
+        if isinstance(self.respuesta, Exception):
+            raise self.respuesta
+        if callable(self.respuesta):
+            return self.respuesta(url)
+        status, cuerpo = self.respuesta
+        if isinstance(cuerpo, (dict, list)):
+            return httpx.Response(status, json=cuerpo, request=httpx.Request('GET', url))
+        return httpx.Response(status, content=cuerpo, request=httpx.Request('GET', url))
+
+    def contesta(self, status, cuerpo=None):
+        self.respuesta = (status, cuerpo)
+
+    def por_empleado(self, activos=(), inactivos=(), empresa_desconocida=(), desconocidos=()):
+        """Responde según empresa y email (el email en minúsculas, decodificado del path)."""
+        def responder(url):
+            ruta = httpx.URL(url).path
+            partes = ruta.split('/')  # ['', 'empresas', empresa, 'empleados', email]
+            empresa, email = partes[2], partes[4]
+            if empresa in empresa_desconocida:
+                return httpx.Response(404, json={'error': 'empresa_desconocida'}, request=httpx.Request('GET', url))
+            if email in activos:
+                return httpx.Response(200, json={'activo': True}, request=httpx.Request('GET', url))
+            if email in inactivos:
+                return httpx.Response(200, json={'activo': False}, request=httpx.Request('GET', url))
+            if email in desconocidos:
+                return httpx.Response(404, json={'error': 'empleado_desconocido'}, request=httpx.Request('GET', url))
+            raise httpx.ConnectError('caída', request=httpx.Request('GET', url))
+        self.respuesta = responder
+
+
+@pytest.fixture(autouse=True)
+def beneficios_env(monkeypatch):
+    monkeypatch.setenv('PULSO_BENEFICIOS_URL', BASE)
+    monkeypatch.setenv('PULSO_BENEFICIOS_CLAVE', CLAVE)
+
+
+@pytest.fixture
+def servicio(monkeypatch):
+    return ServicioFalso(monkeypatch)
+
+
+def activar(cliente, socio, empresa='acme'):
+    return cliente.post('/convenio', json={'empresa': empresa}, headers=auth(socio))
+
+
+def revalidar(cliente):
+    return cliente.post('/admin/revalidar-convenios', headers=ADMIN)
+
+
+# --- POST /convenio ---
+
+def test_convenio_sin_token(cliente, servicio):
+    r = cliente.post('/convenio', json={'empresa': 'acme'})
+    assert r.status_code == 401
+    assert servicio.llamadas == []
+
+
+def test_convenio_sin_empresa_o_vacia(cliente, socio, servicio):
+    assert cliente.post('/convenio', json={}, headers=auth(socio)).status_code == 422
+    assert activar(cliente, socio, empresa='').status_code == 422
+    assert activar(cliente, socio, empresa='   ').status_code == 422
+    assert servicio.llamadas == []
+
+
+def test_activa_plan_con_piso_de_12_y_manda_correo(cliente, socio, servicio):
+    servicio.por_empleado(activos=['ana@example.com'])
+    r = activar(cliente, socio)
+    assert r.status_code == 200
+    assert r.json() == {'plan': 'corporativo', 'empresa': 'acme', 'creditos': 12}
+    assert cliente.get('/yo', headers=auth(socio)).json()['plan'] == 'corporativo'
+    [correo] = db.correos()
+    assert correo['para'] == 'ana@example.com'
+    assert correo['asunto'] == 'Ya tenés el plan corporativo'
+
+
+def test_piso_no_suma_y_no_baja_creditos(cliente, servicio):
+    servicio.por_empleado(activos=['ana@example.com', 'juan@example.com'])
+    pocos = db.crear_socio('Ana', 'ana@example.com', creditos=3)
+    justo = db.crear_socio('Juan', 'juan@example.com', creditos=12)
+    assert activar(cliente, pocos).json()['creditos'] == 12
+    assert activar(cliente, justo).json()['creditos'] == 12
+    mas = db.crear_socio('Luis', 'luis@example.com', creditos=20)
+    servicio.por_empleado(activos=['luis@example.com'])
+    assert activar(cliente, mas).json()['creditos'] == 20
+
+
+def test_consulta_con_email_en_minusculas_y_codificado(cliente, servicio):
+    socio = db.crear_socio('Ana', 'Ana.Perez+Gym@Example.com')
+    servicio.por_empleado(activos=['ana.perez+gym@example.com'])
+    assert activar(cliente, socio, empresa='acme').status_code == 200
+    [llamada] = servicio.llamadas
+    assert llamada['url'] == f'{BASE}/empresas/acme/empleados/ana.perez%2Bgym%40example.com'
+    assert llamada['headers'] == {'X-Api-Key': CLAVE}
+    # El path que viaja por la red tiene que conservar el %2B (si no, el servicio lo lee como espacio).
+    assert httpx.URL(llamada['url']).raw_path == b'/empresas/acme/empleados/ana.perez%2Bgym%40example.com'
+
+
+def test_clave_y_url_se_leen_del_entorno_en_cada_consulta(cliente, socio, servicio, monkeypatch):
+    servicio.por_empleado(inactivos=['ana@example.com'])
+    activar(cliente, socio)
+    monkeypatch.setenv('PULSO_BENEFICIOS_CLAVE', 'otra-clave')
+    monkeypatch.setenv('PULSO_BENEFICIOS_URL', 'https://otro.example.com/')
+    activar(cliente, socio)
+    assert servicio.llamadas[0]['headers'] == {'X-Api-Key': CLAVE}
+    assert servicio.llamadas[1]['headers'] == {'X-Api-Key': 'otra-clave'}
+    assert servicio.llamadas[1]['url'].startswith('https://otro.example.com/empresas/')
+
+
+def test_inactivo_o_desconocido_es_409_sin_cambios(cliente, servicio):
+    inactivo = db.crear_socio('Ana', 'ana@example.com', creditos=5)
+    desconocido = db.crear_socio('Juan', 'juan@example.com', creditos=5)
+    servicio.por_empleado(inactivos=['ana@example.com'], desconocidos=['juan@example.com'])
+    assert activar(cliente, inactivo).status_code == 409
+    assert activar(cliente, desconocido).status_code == 409
+    for socio in (inactivo, desconocido):
+        assert db.socio(socio['id'])['plan'] == 'basico'
+        assert db.socio(socio['id'])['creditos'] == 5
+    assert db.correos() == []
+
+
+def test_empresa_desconocida_es_404(cliente, socio, servicio):
+    servicio.por_empleado(empresa_desconocida=['nope'])
+    assert activar(cliente, socio, empresa='nope').status_code == 404
+    assert db.socio(socio['id'])['plan'] == 'basico'
+    assert db.correos() == []
+
+
+@pytest.mark.parametrize('respuesta', [
+    httpx.ConnectError('sin conexión'),
+    httpx.ReadTimeout('tarde'),
+    (500, {'error': 'boom'}),
+    (500, b'<html>Internal error</html>'),
+    (502, b''),
+    (401, {'error': 'clave_invalida'}),
+    (200, b'no es json'),
+    (200, {'otra_cosa': 1}),
+    (200, {'activo': 'si'}),
+    (200, ['activo']),
+    (404, {'error': 'otra_cosa'}),
+    (404, b'not found'),
+])
+def test_falla_del_servicio_es_503_sin_cambios(cliente, socio, servicio, respuesta):
+    servicio.respuesta = respuesta
+    r = activar(cliente, socio)
+    assert r.status_code == 503
+    assert db.socio(socio['id'])['plan'] == 'basico'
+    assert db.socio(socio['id'])['creditos'] == socio['creditos']
+    assert db.correos() == []
+
+
+def test_timeout_de_tres_segundos(cliente, socio, servicio):
+    servicio.por_empleado(activos=['ana@example.com'])
+    activar(cliente, socio)
+    assert servicio.llamadas[0]['timeout'] == 3.0
+
+
+def test_ya_corporativo_es_409_sin_consultar_ni_cambiar(cliente, socio, servicio):
+    servicio.por_empleado(activos=['ana@example.com'])
+    assert activar(cliente, socio, empresa='acme').status_code == 200
+    creditos = db.socio(socio['id'])['creditos']
+    llamadas = len(servicio.llamadas)
+    assert activar(cliente, socio, empresa='acme').status_code == 409
+    assert activar(cliente, socio, empresa='otra').status_code == 409
+    assert len(servicio.llamadas) == llamadas
+    assert db.socio(socio['id'])['creditos'] == creditos
+    assert db.socio(socio['id'])['empresa'] == 'acme'
+    assert len(db.correos()) == 1
+
+
+def test_activar_de_nuevo_despues_de_la_baja(cliente, socio, servicio):
+    servicio.por_empleado(activos=['ana@example.com'])
+    activar(cliente, socio, empresa='acme')
+    db.sumar_creditos(socio['id'], 30)
+    servicio.por_empleado(inactivos=['ana@example.com'])
+    assert revalidar(cliente).json()['bajaron'] == 1
+    servicio.por_empleado(activos=['ana@example.com'])
+    r = activar(cliente, socio, empresa='beta')
+    assert r.json() == {'plan': 'corporativo', 'empresa': 'beta', 'creditos': 42}
+    asuntos = [c['asunto'] for c in db.correos()]
+    assert asuntos == ['Ya tenés el plan corporativo', 'Se terminó tu plan corporativo', 'Ya tenés el plan corporativo']
+
+
+# --- POST /admin/revalidar-convenios ---
+
+def test_revalidar_exige_clave_de_admin(cliente, servicio):
+    assert cliente.post('/admin/revalidar-convenios').status_code == 401
+    assert cliente.post('/admin/revalidar-convenios', headers={'X-Admin-Key': 'otra'}).status_code == 401
+    assert servicio.llamadas == []
+
+
+def test_revalidar_sin_socios_corporativos(cliente, socio, servicio):
+    assert revalidar(cliente).json() == {'siguen': 0, 'bajaron': 0, 'sin_revisar': 0}
+    assert servicio.llamadas == []
+
+
+def test_revalidar_mantiene_a_los_activos_sin_tocar_creditos(cliente, servicio):
+    ana = db.crear_socio('Ana', 'ana@example.com')
+    activar_directo(ana, 'acme')
+    db.sumar_creditos(ana['id'], 20)
+    servicio.por_empleado(activos=['ana@example.com'])
+    assert revalidar(cliente).json() == {'siguen': 1, 'bajaron': 0, 'sin_revisar': 0}
+    socio = db.socio(ana['id'])
+    assert socio['plan'] == 'corporativo'
+    assert socio['creditos'] == 32
+    assert db.correos() == []
+
+
+@pytest.mark.parametrize('estado', ['inactivo', 'desconocido', 'empresa_desconocida'])
+def test_revalidar_baja_a_basico_conservando_creditos(cliente, servicio, estado):
+    ana = db.crear_socio('Ana', 'ana@example.com')
+    activar_directo(ana, 'acme')
+    db.sumar_creditos(ana['id'], 10)
+    if estado == 'inactivo':
+        servicio.por_empleado(inactivos=['ana@example.com'])
+    elif estado == 'desconocido':
+        servicio.por_empleado(desconocidos=['ana@example.com'])
+    else:
+        servicio.por_empleado(empresa_desconocida=['acme'])
+    assert revalidar(cliente).json() == {'siguen': 0, 'bajaron': 1, 'sin_revisar': 0}
+    socio = db.socio(ana['id'])
+    assert socio['plan'] == 'basico'
+    assert socio['creditos'] == 22
+    [correo] = db.correos()
+    assert correo['para'] == 'ana@example.com'
+    assert correo['asunto'] == 'Se terminó tu plan corporativo'
+
+
+def test_revalidar_usa_la_empresa_con_la_que_activo(cliente, servicio):
+    ana = db.crear_socio('Ana', 'ana@example.com')
+    juan = db.crear_socio('Juan', 'juan@example.com')
+    activar_directo(ana, 'acme')
+    activar_directo(juan, 'beta')
+    servicio.por_empleado(activos=['ana@example.com', 'juan@example.com'])
+    revalidar(cliente)
+    urls = sorted(c['url'] for c in servicio.llamadas)
+    assert urls == [
+        f'{BASE}/empresas/acme/empleados/ana%40example.com',
+        f'{BASE}/empresas/beta/empleados/juan%40example.com',
+    ]
+
+
+def test_revalidar_cuenta_fallas_y_sigue_con_los_demas(cliente, servicio):
+    ana = db.crear_socio('Ana', 'ana@example.com')
+    juan = db.crear_socio('Juan', 'juan@example.com')
+    luis = db.crear_socio('Luis', 'luis@example.com')
+    for socio in (ana, juan, luis):
+        activar_directo(socio, 'acme')
+
+    def responder(url):
+        if 'juan' in url:
+            raise httpx.ReadTimeout('tarde', request=httpx.Request('GET', url))
+        if 'luis' in url:
+            return httpx.Response(500, content=b'roto', request=httpx.Request('GET', url))
+        return httpx.Response(404, json={'error': 'empleado_desconocido'}, request=httpx.Request('GET', url))
+
+    servicio.respuesta = responder
+    assert revalidar(cliente).json() == {'siguen': 0, 'bajaron': 1, 'sin_revisar': 2}
+    assert db.socio(ana['id'])['plan'] == 'basico'
+    assert db.socio(juan['id'])['plan'] == 'corporativo'
+    assert db.socio(luis['id'])['plan'] == 'corporativo'
+
+
+def test_revalidar_con_servicio_caido_responde_200(cliente, servicio):
+    socios = [db.crear_socio(f'Socio {i}', f'socio{i}@example.com') for i in range(3)]
+    for socio in socios:
+        activar_directo(socio, 'acme')
+    servicio.respuesta = httpx.ConnectError('caído')
+    r = revalidar(cliente)
+    assert r.status_code == 200
+    assert r.json() == {'siguen': 0, 'bajaron': 0, 'sin_revisar': 3}
+    assert all(db.socio(s['id'])['plan'] == 'corporativo' for s in socios)
+    assert db.correos() == []
+
+
+def test_revalidar_no_consulta_a_los_basicos(cliente, socio, servicio):
+    servicio.por_empleado(activos=[])
+    revalidar(cliente)
+    assert servicio.llamadas == []
+
+
+# --- migración y helpers ---
+
+def activar_directo(socio, empresa):
+    """Deja al socio con plan corporativo sin pasar por el servicio (para armar el escenario)."""
+    assert db.activar_convenio(socio['id'], empresa)
+
+
+def test_inicializar_agrega_columna_empresa_a_una_base_vieja(tmp_path, monkeypatch):
+    import sqlite3
+    ruta = tmp_path / 'vieja.db'
+    monkeypatch.setenv('PULSO_DB', str(ruta))
+    con = sqlite3.connect(ruta)
+    con.executescript("CREATE TABLE socios (id INTEGER PRIMARY KEY, nombre TEXT NOT NULL, email TEXT NOT NULL UNIQUE, "
+                      "plan TEXT NOT NULL, creditos INTEGER NOT NULL, token TEXT NOT NULL UNIQUE);")
+    con.execute("INSERT INTO socios (nombre, email, plan, creditos, token) VALUES ('Ana', 'ana@example.com', 'basico', 8, 't')")
+    con.commit()
+    con.close()
+    db.inicializar()
+    db.inicializar()  # idempotente
+    socio = db.socio_por_token('t')
+    assert socio['empresa'] is None
+    assert socio['creditos'] == 8
