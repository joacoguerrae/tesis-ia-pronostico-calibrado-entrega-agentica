{"host.arch": "arm64", "os.type": "darwin", "os.version": "23.4.0", "service.name": "claude-code", "service.version": "2.1.312", "user.id": "", "session.id": "ee23bf71-e7ae-4e9f-83df-eec671d50613", "terminal.type": "claude-desktop", "gen_ai.provider.name": "anthropic", "span.type": "tool", "tool_name": "Bash", "tool_name_safe": "Bash", "gen_ai.operation.name": "execute_tool", "gen_ai.tool.name": "Bash", "gen_ai.conversation.id": "ee23bf71-e7ae-4e9f-83df-eec671d50613", "full_command": "cat > tests/test_recordatorios.py <<'EOF'\nfrom datetime import timedelta\n\nfrom pulso import db\nfrom tests.conftest import ADMIN, AHORA\n\n\ndef clase_en(horas, nombre='Yoga'):\n    return db.crear_clase(nombre, 'Marta', AHORA + timedelta(hours=horas))\n\n\ndef llamar(cliente):\n    return cliente.post('/admin/recordatorios', headers=ADMIN)\n\n\ndef test_requiere_clave(cliente):\n    assert cliente.post('/admin/recordatorios').status_code == 401\n    assert cliente.post('/admin/recordatorios', headers={'X-Admin-Key': 'mala'}).status_code == 401\n\n\ndef test_envia_una_vez(cliente, socio):\n    c = clase_en(6)\n    db.crear_reserva(socio['id'], c['id'], AHORA)\n    assert llamar(cliente).json() == {'enviados': 1}\n    assert llamar(cliente).json() == {'enviados': 0}\n    mails = db.correos()\n    assert len(mails) == 1\n    assert mails[0]['para'] == 'ana@example.com'\n    assert mails[0]['asunto'] == 'Recordatorio: Yoga el 10/11 a las 18:00'\n    assert 'Marta' in mails[0]['cuerpo']\n\n\ndef test_ventana(cliente, socio):\n    for h in (-1, 0, 24, 24.5, 48):\n        db.crear_reserva(socio['id'], clase_en(h)['id'], AHORA)\n    assert llamar(cliente).json() == {'enviados': 1}  # solo la de 24 h exacta\n\n\ndef test_no_confirmadas(cliente, socio):\n    db.crear_reserva(socio['id'], clase_en(5)['id'], AHORA, estado='cancelada')\n    assert llamar(cliente).json() == {'enviados': 0}\n    assert db.correos() == []\nEOF\npython -m pytest -q 2>&1 | tail -15", "bash_command_class": "file_read", "bash_argv0": "cat", "tool_use_id": "toolu_01QnLKPMrC1zsV495aWeqhWH", "gen_ai.tool.call.id": "toolu_01QnLKPMrC1zsV495aWeqhWH", "duration_ms": 8, "_nombre": "claude_code.tool", "_traza": "fd71b3de9b527b30282edd006183c7b1", "_tramo": "2f516daedd58455d", "_padre": "dd2fa9f9a871acc6", "_inicio_ns": 1794570738181000000, "_fin_ns": 1794570738189062334, "_estado": 0}
