+from datetime import date, datetime, time, timedelta, timezone
 
 # Montevideo está en UTC-3 todo el año (no hay horario de verano).
 MONTEVIDEO = timezone(timedelta(hours=-3), 'America/Montevideo')
@@ -11,6 +11,11 @@ def ahora():
