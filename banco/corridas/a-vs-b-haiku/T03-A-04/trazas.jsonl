{"host.arch": "amd64", "os.type": "linux", "os.version": "6.18.33.2-microsoft-standard-WSL2", "service.name": "claude-code", "service.version": "2.1.312", "wsl.version": "2", "user.id": "0f72bbf305cc3cfe4c49efd7a27949e16f5ce38c2de862b736399de5c3c79b13", "session.id": "16c171e8-4f4a-496a-8b0d-a6155e1b08c7", "terminal.type": "wsl-Ubuntu-24.04", "gen_ai.provider.name": "anthropic", "span.type": "tool", "tool_name": "Bash", "tool_name_safe": "Bash", "gen_ai.operation.name": "execute_tool", "gen_ai.tool.name": "Bash", "gen_ai.conversation.id": "16c171e8-4f4a-496a-8b0d-a6155e1b08c7", "full_command": "python - <<'E'\np='pulso/main.py'\ns=open(p).read()\ns=s.replace(\"import os\\n\",\"import csv\\nimport io\\nimport os\\nimport re\\nfrom datetime import date, timedelta\\n\",1)\ns=s.replace(\"from fastapi import\",\"from fastapi.responses import Response\\nfrom fastapi import\",1)\ns=s.replace('''class NuevaReserva''','''def _fecha(texto, nombre):\n    if not texto or not re.fullmatch(r'\\\\d{4}-\\\\d{2}-\\\\d{2}', texto):\n        raise HTTPException(422, f'{nombre} es obligatoria y debe tener formato YYYY-MM-DD')\n    try:\n        return date.fromisoformat(texto)\n    except ValueError:\n        raise HTTPException(422, f'{nombre} no es una fecha válida')\n\n\n@router.get('/admin/ocupacion.csv', dependencies=[Depends(admin)])\ndef ocupacion_csv(desde: str | None = None, hasta: str | None = None):\n    d, h = _fecha(desde, 'desde'), _fecha(hasta, 'hasta')\n    if d > h:\n        raise HTTPException(422, 'desde no puede ser posterior a hasta')\n    if h - d > timedelta(days=30):\n        raise HTTPException(422, 'El período no puede superar los 31 días')\n    salida = io.StringIO()\n    escritor = csv.writer(salida, lineterminator='\\\\r\\\\n')\n    escritor.writerow(['fecha', 'hora', 'clase', 'instructor', 'cupo', 'confirmadas', 'ocupacion_pct'])\n    for c in db.clases():\n        inicio = db.a_fecha(c['inicio']).astimezone(reloj.MONTEVIDEO)\n        if not d <= inicio.date() <= h:\n            continue\n        conf = db.confirmadas(c['id'])\n        # Redondeo half-up con enteros, sin errores de punto flotante.\n        pct = (conf * 200 + c['cupo']) // (2 * c['cupo']) if c['cupo'] > 0 else 0\n        escritor.writerow([inicio.strftime('%Y-%m-%d'), inicio.strftime('%H:%M'), c['nombre'],\n                           c['instructor'], c['cupo'], conf, pct])\n    return Response(salida.getvalue(), media_type='text/csv; charset=utf-8')\n\n\nclass NuevaReserva''',1)\nopen(p,'w').write(s)\nE\ncat > tests/test_ocupacion.py <<'E'\nfrom datetime import datetime, timezone\n\nfrom conftest import ADMIN\nfrom pulso import db\n\nURL = '/admin/ocupacion.csv'\nENC = 'fecha,hora,clase,instructor,cupo,confirmadas,ocupacion_pct'\n\n\ndef utc(*a):\n    return datetime(*a, tzinfo=timezone.utc)\n\n\ndef pedir(cliente, desde='2026-11-01', hasta='2026-11-30'):\n    return cliente.get(URL, params={'desde': desde, 'hasta': hasta}, headers=ADMIN)\n\n\ndef lineas(r):\n    return r.text.splitlines()\n\n\ndef test_requiere_admin(cliente):\n    assert cliente.get(URL, params={'desde': '2026-11-01', 'hasta': '2026-11-02'}).status_code == 401\n    assert cliente.get(URL, headers={'X-Admin-Key': 'x'}).status_code == 401\n\n\ndef test_validaciones(cliente):\n    for d, h in [('2026-11-01', None), (None, '2026-11-01'), ('1/11/2026', '2026-11-05'),\n                 ('2026-11-05', '2026-11-01'), ('2026-10-01', '2026-11-01'), ('2026-02-30', '2026-03-01')]:\n        params = {k: v for k, v in (('desde', d), ('hasta', h)) if v}\n        assert cliente.get(URL, params=params, headers=ADMIN).status_code == 422\n    assert pedir(cliente, '2026-10-01', '2026-10-31').status_code == 200\n\n\ndef test_vacio_solo_encabezado(cliente):\n    r = pedir(cliente)\n    assert r.headers['content-type'] == 'text/csv; charset=utf-8'\n    assert lineas(r) == [ENC]\n\n\ndef test_filas_orden_zona_y_conteo(cliente, socio):\n    # 02:00 UTC del 1/12 = 23:00 del 30/11 en Montevideo (entra); 02:59 UTC del 1/11 = 23:59 del 31/10 (no entra)\n    a = db.crear_clase('Yoga, \"nivel\" 1', 'Sofía', utc(2026, 11, 4, 22, 30), cupo=8)\n    b = db.crear_clase('Spinning', 'Leo', utc(2026, 11, 4, 10, 0), cupo=16)\n    db.crear_clase('Fuera', 'X', utc(2026, 11, 1, 2, 59))\n    c = db.crear_clase('Noche', 'Y', utc(2026, 12, 1, 2, 0), cupo=3)\n    db.crear_clase('Pasada fuera', 'X', utc(2026, 12, 1, 3, 0))\n    for _ in range(1):\n        db.crear_reserva(socio['id'], a['id'], utc(2026, 11, 1))\n    db.crear_reserva(socio['id'], a['id'], utc(2026, 11, 1), estado='cancelada')\n    for _ in range(2):\n        db.crear_reserva(socio['id'], b['id'], utc(2026, 11, 1))\n    db.crear_reserva(socio['id'], c['id'], utc(2026, 11, 1))\n    assert lineas(pedir(cliente)) == [\n        ENC,\n        '2026-11-04,07:00,Spinning,Leo,16,2,13',\n        '2026-11-04,19:30,\"Yoga, \"\"nivel\"\" 1\",Sofía,8,1,13',\n        '2026-11-30,23:00,Noche,Y,3,1,33',\n    ]\nE\npython -m pytest -q 2>&1 | tail -8", "bash_command_class": "lang_runtime", "bash_argv0": "python", "tool_use_id": "toolu_01L3djnkZ4BKL5DJWWndhXZA", "gen_ai.tool.call.id": "toolu_01L3djnkZ4BKL5DJWWndhXZA", "duration_ms": 6, "_nombre": "claude_code.tool", "_traza": "f2009fd31534c0324fdbf84c6d9f57d3", "_tramo": "e17a39e4665a75fa", "_padre": "5011bc38f35f9ff9", "_inicio_ns": 1794689045050000000, "_fin_ns": 1794689045056305275, "_estado": 0}
