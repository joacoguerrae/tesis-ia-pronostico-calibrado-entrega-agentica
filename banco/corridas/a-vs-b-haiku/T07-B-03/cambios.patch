diff --git a/tests/conftest.py b/tests/conftest.py
index 26f0689..52f6b27 100644
--- a/tests/conftest.py
+++ b/tests/conftest.py
@@ -1,14 +1,92 @@
+import json
 from datetime import datetime, timezone
+from urllib.parse import unquote
 
+import httpx
 import pytest
 from fastapi.testclient import TestClient
 
+from pulso import cobra as modulo_cobra
 from pulso import db, reloj
 from pulso.main import crear_app
 
 # Martes 10/11/2026, 12:00 en Montevideo.
 AHORA = datetime(2026, 11, 10, 15, 0, tzinfo=timezone.utc)
 ADMIN = {'X-Admin-Key': 'clave-admin'}
+COBRA_URL = 'https://api.cobra.test/v1'
+COBRA_CLAVE = 'clave-cobra'
+
+
+class FakeCobra:
+    """Cobrá falso, con el comportamiento del contrato: clave, idempotencia y 404 para pagos desconocidos."""
+
+    def __init__(self):
+        self.pagos = {}
+        self.por_clave = {}
+        self.claves_usadas = []
+        self.llamadas = []
+        self.falla = None            # código HTTP, o excepción, para todos los pedidos
+        self.fallan_consulta = set()  # ids de pago cuya consulta falla con 500
+        self.contador = 0
+
+    def handler(self, request):
+        self.llamadas.append((request.method, request.url.path))
+        if isinstance(self.falla, Exception):
+            raise self.falla
+        if self.falla is not None:
+            return httpx.Response(self.falla)
+        if request.headers.get('X-Cobra-Clave') != COBRA_CLAVE:
+            return httpx.Response(401)
+        ruta = request.url.path.removeprefix('/v1')
+        if request.method == 'POST' and ruta == '/pagos':
+            return self._crear(request)
+        if request.method == 'GET' and ruta == '/pagos':
+            referencia = request.url.params.get('referencia')
+            pagos = [p for p in self.pagos.values() if p['referencia'] == referencia]
+            return httpx.Response(200, json={'pagos': pagos})
+        if request.method == 'GET' and ruta.startswith('/pagos/'):
+            pago_id = unquote(ruta.removeprefix('/pagos/'))
+            if pago_id in self.fallan_consulta:
+                return httpx.Response(500)
+            if pago_id not in self.pagos:
+                return httpx.Response(404)
+            return httpx.Response(200, json=self.pagos[pago_id])
+        return httpx.Response(404)
+
+    def _crear(self, request):
+        clave = request.headers.get('Idempotency-Key')
+        if clave is None:
+            return httpx.Response(422)
+        self.claves_usadas.append(clave)
+        if clave in self.por_clave:
+            return httpx.Response(200, json=self.pagos[self.por_clave[clave]])
+        datos = json.loads(request.content)
+        if not {'monto', 'moneda', 'referencia'} <= datos.keys():
+            return httpx.Response(422)
+        pago = self.agregar(datos['referencia'], monto=datos['monto'])
+        self.por_clave[clave] = pago['id']
+        return httpx.Response(201, json=pago)
+
+    def agregar(self, referencia, estado='pendiente', monto=1200):
+        """Crea un pago directo en Cobrá, como si ya existiera (por ejemplo, si se perdió la respuesta)."""
+        self.contador += 1
+        pago_id = f'pag_{self.contador}'
+        self.pagos[pago_id] = {'id': pago_id, 'estado': estado, 'monto': monto, 'moneda': 'UYU',
+                               'referencia': referencia, 'url_pago': f'https://pagar.cobra.test/{pago_id}'}
+        return self.pagos[pago_id]
+
+    def cambiar(self, pago_id, estado):
+        self.pagos[pago_id]['estado'] = estado
+
+
+@pytest.fixture
+def cobra(monkeypatch):
+    monkeypatch.setenv('PULSO_PAGOS_URL', COBRA_URL)
+    monkeypatch.setenv('PULSO_PAGOS_CLAVE', COBRA_CLAVE)
+    fake = FakeCobra()
+    monkeypatch.setattr(modulo_cobra, '_cliente',
+                        lambda: httpx.Client(transport=httpx.MockTransport(fake.handler), timeout=5))
+    return fake
 
 
 @pytest.fixture
diff --git a/tests/test_compras.py b/tests/test_compras.py
new file mode 100644
index 0000000..3da4f4a
--- /dev/null
+++ b/tests/test_compras.py
@@ -0,0 +1,262 @@
+from datetime import timedelta
+
+import httpx
+
+from conftest import ADMIN, AHORA, auth
+from pulso import db, reloj
+
+
+def comprar(cliente, socio, pack='pack-4'):
+    return cliente.post('/compras', json={'pack': pack}, headers=auth(socio))
+
+
+def avisar(cliente, pago_id, estado='aprobado'):
+    return cliente.post('/webhooks/pagos', json={'pago_id': pago_id, 'estado': estado})
+
+
+def conciliar(cliente):
+    return cliente.post('/admin/conciliar-pagos', headers=ADMIN)
+
+
+def creditos(cliente, socio):
+    return cliente.get('/yo', headers=auth(socio)).json()['creditos']
+
+
+# Compra
+
+def test_compra_crea_pago_en_cobra_y_queda_pendiente(cliente, socio, cobra):
+    r = comprar(cliente, socio)
+    assert r.status_code == 201
+    assert r.json() == {'id': 1, 'pack': 'pack-4', 'creditos': 4, 'monto': 1200, 'estado': 'pendiente',
+                        'creada': '2026-11-10T15:00:00+00:00', 'url_pago': 'https://pagar.cobra.test/pag_1'}
+    [pago] = cobra.pagos.values()
+    assert pago['referencia'] == 'pulso-compra-1'
+    assert pago['monto'] == 1200
+    assert pago['moneda'] == 'UYU'
+    assert cobra.claves_usadas == ['pulso-compra-1']
+    assert creditos(cliente, socio) == 8
+
+
+def test_pack_invalido_no_crea_nada(cliente, socio, cobra):
+    for cuerpo in ({'pack': 'pack-99'}, {}):
+        assert cliente.post('/compras', json=cuerpo, headers=auth(socio)).status_code == 422
+    assert db.compras_de(socio['id']) == []
+    assert cobra.pagos == {}
+    assert cobra.llamadas == []
+
+
+def test_compra_sin_token(cliente, cobra):
+    assert cliente.post('/compras', json={'pack': 'pack-4'}).status_code == 401
+
+
+def test_cobra_falla_al_crear_deja_compra_pendiente_sin_pago(cliente, socio, cobra):
+    cobra.falla = 500
+    assert comprar(cliente, socio).status_code == 502
+    [compra] = db.compras_de(socio['id'])
+    assert compra['estado'] == 'pendiente'
+    assert compra['pago_id'] is None
+    assert compra['url_pago'] is None
+
+
+def test_cobra_no_responde_al_crear(cliente, socio, cobra):
+    cobra.falla = httpx.ReadTimeout('sin respuesta')
+    assert comprar(cliente, socio).status_code == 502
+    assert db.compras_de(socio['id'])[0]['estado'] == 'pendiente'
+
+
+def test_cobra_con_clave_invalida_es_falla(cliente, socio, cobra):
+    cobra.falla = 401
+    assert comprar(cliente, socio).status_code == 502
+
+
+def test_listado_del_socio_mas_nuevo_primero(cliente, socio, cobra):
+    otro = db.crear_socio('Juan Gómez', 'juan@example.com')
+    comprar(cliente, socio, 'pack-4')
+    reloj.fijar(AHORA + timedelta(hours=1))
+    comprar(cliente, socio, 'pack-8')
+    comprar(cliente, otro, 'pack-4')
+    r = cliente.get('/compras', headers=auth(socio))
+    assert r.status_code == 200
+    assert [c['pack'] for c in r.json()] == ['pack-8', 'pack-4']
+    assert all(c['url_pago'] for c in r.json())
+
+
+def test_listado_muestra_url_nula_sin_pago(cliente, socio, cobra):
+    cobra.falla = 500
+    comprar(cliente, socio)
+    [compra] = cliente.get('/compras', headers=auth(socio)).json()
+    assert compra['estado'] == 'pendiente'
+    assert compra['url_pago'] is None
+
+
+def test_listado_no_consulta_a_cobra(cliente, socio, cobra):
+    comprar(cliente, socio)
+    cobra.llamadas.clear()
+    cliente.get('/compras', headers=auth(socio))
+    assert cobra.llamadas == []
+
+
+# Webhook
+
+def test_webhook_aprobado_suma_creditos_y_manda_correo(cliente, socio, cobra):
+    comprar(cliente, socio, 'pack-4')
+    cobra.cambiar('pag_1', 'aprobado')
+    r = avisar(cliente, 'pag_1')
+    assert r.status_code == 200
+    assert r.json() == {'compra_id': 1, 'estado': 'aprobada'}
+    assert creditos(cliente, socio) == 12
+    [correo] = db.correos()
+    assert correo['para'] == 'ana@example.com'
+    assert correo['asunto'] == 'Compra de créditos aprobada'
+
+
+def test_webhook_repetido_no_suma_ni_manda_otra_vez(cliente, socio, cobra):
+    comprar(cliente, socio, 'pack-4')
+    cobra.cambiar('pag_1', 'aprobado')
+    avisar(cliente, 'pag_1')
+    assert avisar(cliente, 'pag_1').json() == {'compra_id': 1, 'estado': 'aprobada'}
+    conciliar(cliente)
+    assert creditos(cliente, socio) == 12
+    assert len(db.correos()) == 1
+
+
+def test_webhook_rechazado_no_suma_ni_manda_correo(cliente, socio, cobra):
+    comprar(cliente, socio)
+    cobra.cambiar('pag_1', 'rechazado')
+    assert avisar(cliente, 'pag_1').json() == {'compra_id': 1, 'estado': 'rechazada'}
+    assert creditos(cliente, socio) == 8
+    assert db.correos() == []
+
+
+def test_webhook_pendiente_no_cambia_nada(cliente, socio, cobra):
+    comprar(cliente, socio)
+    assert avisar(cliente, 'pag_1').json() == {'compra_id': 1, 'estado': 'pendiente'}
+    assert creditos(cliente, socio) == 8
+
+
+def test_webhook_ignora_el_estado_del_cuerpo(cliente, socio, cobra):
+    comprar(cliente, socio)
+    assert avisar(cliente, 'pag_1', estado='aprobado').json()['estado'] == 'pendiente'
+    assert creditos(cliente, socio) == 8
+
+
+def test_webhook_pago_desconocido_es_404(cliente, socio, cobra):
+    assert avisar(cliente, 'pag_999').status_code == 404
+
+
+def test_webhook_pago_de_otra_referencia_es_404(cliente, socio, cobra):
+    cobra.agregar('otra-cosa', estado='aprobado')
+    cobra.agregar('pulso-compra-99', estado='aprobado')
+    cobra.agregar('pulso-compra-01', estado='aprobado')
+    assert avisar(cliente, 'pag_1').status_code == 404
+    assert avisar(cliente, 'pag_2').status_code == 404
+    assert avisar(cliente, 'pag_3').status_code == 404
+
+
+def test_webhook_sin_pago_id_es_422(cliente):
+    assert cliente.post('/webhooks/pagos', json={'estado': 'aprobado'}).status_code == 422
+
+
+def test_webhook_cobra_caido_es_503_y_no_cambia_nada(cliente, socio, cobra):
+    comprar(cliente, socio)
+    cobra.cambiar('pag_1', 'aprobado')
+    cobra.falla = 500
+    assert avisar(cliente, 'pag_1').status_code == 503
+    assert db.compras_de(socio['id'])[0]['estado'] == 'pendiente'
+    assert creditos(cliente, socio) == 8
+
+
+def test_webhook_guarda_el_pago_de_una_compra_sin_pago(cliente, socio, cobra):
+    cobra.falla = 500
+    comprar(cliente, socio, 'pack-4')
+    cobra.falla = None
+    cobra.agregar('pulso-compra-1', estado='aprobado')
+    assert avisar(cliente, 'pag_1').json() == {'compra_id': 1, 'estado': 'aprobada'}
+    [compra] = db.compras_de(socio['id'])
+    assert compra['pago_id'] == 'pag_1'
+    assert compra['url_pago'] == 'https://pagar.cobra.test/pag_1'
+    assert creditos(cliente, socio) == 12
+
+
+# Conciliación
+
+def test_conciliar_requiere_clave_de_administracion(cliente):
+    assert cliente.post('/admin/conciliar-pagos').status_code == 401
+    assert cliente.post('/admin/conciliar-pagos', headers={'X-Admin-Key': 'otra'}).status_code == 401
+
+
+def test_conciliar_consulta_por_id_y_aplica_estados(cliente, socio, cobra):
+    comprar(cliente, socio, 'pack-4')
+    comprar(cliente, socio, 'pack-8')
+    cobra.cambiar('pag_1', 'aprobado')
+    cobra.cambiar('pag_2', 'rechazado')
+    assert conciliar(cliente).json() == {'aprobadas': 1, 'rechazadas': 1, 'pendientes': 0}
+    assert creditos(cliente, socio) == 12
+    assert len(db.correos()) == 1
+
+
+def test_conciliar_busca_por_referencia_si_no_hay_pago(cliente, socio, cobra):
+    cobra.falla = 500
+    comprar(cliente, socio, 'pack-4')
+    cobra.falla = None
+    cobra.agregar('pulso-compra-1', estado='aprobado')
+    assert conciliar(cliente).json() == {'aprobadas': 1, 'rechazadas': 0, 'pendientes': 0}
+    [compra] = db.compras_de(socio['id'])
+    assert compra['pago_id'] == 'pag_1'
+    assert compra['url_pago'] == 'https://pagar.cobra.test/pag_1'
+    assert creditos(cliente, socio) == 12
+
+
+def test_conciliar_sin_pago_reciente_queda_pendiente(cliente, socio, cobra):
+    cobra.falla = 500
+    comprar(cliente, socio)
+    cobra.falla = None
+    reloj.fijar(AHORA + timedelta(minutes=29))
+    assert conciliar(cliente).json() == {'aprobadas': 0, 'rechazadas': 0, 'pendientes': 1}
+    assert db.compras_de(socio['id'])[0]['estado'] == 'pendiente'
+
+
+def test_conciliar_sin_pago_de_30_minutos_se_rechaza(cliente, socio, cobra):
+    cobra.falla = 500
+    comprar(cliente, socio)
+    cobra.falla = None
+    reloj.fijar(AHORA + timedelta(minutes=30))
+    assert conciliar(cliente).json() == {'aprobadas': 0, 'rechazadas': 1, 'pendientes': 0}
+    assert db.compras_de(socio['id'])[0]['estado'] == 'rechazada'
+    assert creditos(cliente, socio) == 8
+    assert db.correos() == []
+
+
+def test_falla_de_cobra_no_rechaza_compra_vieja(cliente, socio, cobra):
+    cobra.falla = 500
+    comprar(cliente, socio)
+    reloj.fijar(AHORA + timedelta(hours=2))
+    assert conciliar(cliente).json() == {'aprobadas': 0, 'rechazadas': 0, 'pendientes': 1}
+    assert db.compras_de(socio['id'])[0]['estado'] == 'pendiente'
+
+
+def test_falla_con_una_compra_no_frena_las_demas(cliente, socio, cobra):
+    comprar(cliente, socio, 'pack-4')
+    comprar(cliente, socio, 'pack-8')
+    cobra.fallan_consulta.add('pag_1')
+    cobra.cambiar('pag_2', 'aprobado')
+    assert conciliar(cliente).json() == {'aprobadas': 1, 'rechazadas': 0, 'pendientes': 1}
+    assert db.compra(1)['estado'] == 'pendiente'
+    assert db.compra(2)['estado'] == 'aprobada'
+
+
+def test_conciliar_no_cuenta_las_compras_ya_resueltas(cliente, socio, cobra):
+    comprar(cliente, socio, 'pack-4')
+    cobra.cambiar('pag_1', 'aprobado')
+    avisar(cliente, 'pag_1')
+    comprar(cliente, socio, 'pack-8')
+    assert conciliar(cliente).json() == {'aprobadas': 0, 'rechazadas': 0, 'pendientes': 1}
+
+
+def test_conciliar_dos_veces_no_suma_creditos_dos_veces(cliente, socio, cobra):
+    comprar(cliente, socio, 'pack-4')
+    cobra.cambiar('pag_1', 'aprobado')
+    conciliar(cliente)
+    conciliar(cliente)
+    assert creditos(cliente, socio) == 12
+    assert len(db.correos()) == 1
