+"""Lista de espera: pasa los lugares libres de una clase al primero de la lista.
+
+Todas las funciones reciben la conexión de una transacción de db.transaccion(),
+así que la cancelación o el cambio de cupo y la asignación se aplican juntos.
+"""
+from pulso import correo, db
+
+
+def asignar_libres(con, clase, ahora):
+    """Asigna cada lugar libre al primero de la lista, hasta que no queden lugares o la lista se vacíe."""
+    if db.a_fecha(clase['inicio']) <= ahora:
+        return  # la clase ya empezó: los lugares quedan libres y la lista no cambia
+    asunto_fecha = correo.fecha_y_hora(db.a_fecha(clase['inicio']))
+    while db.confirmadas_en(con, clase['id']) < clase['cupo']:
+        primero = db.primero_en_espera(con, clase['id'])
+        if primero is None:
+            return
+        db.quitar_de_espera(con, primero['id'])
+        socio = db.socio_en(con, primero['socio_id'])
+        if db.tiene_confirmada_en(con, socio['id'], clase['id']):
+            # Ya tiene lugar: se lo saca sin reserva ni correo, y el lugar pasa al siguiente.
+            continue
+        if socio['creditos'] < 1:
+            correo.enviar(socio['email'], f"No pudimos darte el lugar: {clase['nombre']} el {asunto_fecha}",
+                          f"Hola {socio['nombre']}, se liberó un lugar en {clase['nombre']} pero no te quedan "
+                          'créditos, así que pasó al siguiente de la lista.', con=con)
+            continue
+        db.crear_reserva_en(con, socio['id'], clase['id'], ahora)
+        db.sumar_creditos_en(con, socio['id'], -1)
+        correo.enviar(socio['email'], f"Se liberó un lugar: {clase['nombre']} el {asunto_fecha}",
+                      f"Hola {socio['nombre']}, se liberó un lugar en {clase['nombre']} con {clase['instructor']} "
+                      'y ya te lo asignamos. Te descontamos un crédito.', con=con)
