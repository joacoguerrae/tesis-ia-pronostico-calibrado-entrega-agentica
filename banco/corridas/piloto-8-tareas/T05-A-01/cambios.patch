diff --git a/tests/test_recordatorios.py b/tests/test_recordatorios.py
new file mode 100644
index 0000000..bfda8ef
--- /dev/null
+++ b/tests/test_recordatorios.py
@@ -0,0 +1,41 @@
+from datetime import timedelta
+
+from pulso import db
+from tests.conftest import ADMIN, AHORA
+
+
+def clase_en(horas, nombre='Yoga'):
+    return db.crear_clase(nombre, 'Marta', AHORA + timedelta(hours=horas))
+
+
+def llamar(cliente):
+    return cliente.post('/admin/recordatorios', headers=ADMIN)
+
+
+def test_requiere_clave(cliente):
+    assert cliente.post('/admin/recordatorios').status_code == 401
+    assert cliente.post('/admin/recordatorios', headers={'X-Admin-Key': 'mala'}).status_code == 401
+
+
+def test_envia_una_vez(cliente, socio):
+    c = clase_en(6)
+    db.crear_reserva(socio['id'], c['id'], AHORA)
+    assert llamar(cliente).json() == {'enviados': 1}
+    assert llamar(cliente).json() == {'enviados': 0}
+    mails = db.correos()
+    assert len(mails) == 1
+    assert mails[0]['para'] == 'ana@example.com'
+    assert mails[0]['asunto'] == 'Recordatorio: Yoga el 10/11 a las 18:00'
+    assert 'Marta' in mails[0]['cuerpo']
+
+
+def test_ventana(cliente, socio):
+    for h in (-1, 0, 24, 24.5, 48):
+        db.crear_reserva(socio['id'], clase_en(h)['id'], AHORA)
+    assert llamar(cliente).json() == {'enviados': 1}  # solo la de 24 h exacta
+
+
+def test_no_confirmadas(cliente, socio):
+    db.crear_reserva(socio['id'], clase_en(5)['id'], AHORA, estado='cancelada')
+    assert llamar(cliente).json() == {'enviados': 0}
+    assert db.correos() == []
