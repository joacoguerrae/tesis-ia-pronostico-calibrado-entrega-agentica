diff --git a/tests/test_ocupacion.py b/tests/test_ocupacion.py
new file mode 100644
index 0000000..e4b6ab2
--- /dev/null
+++ b/tests/test_ocupacion.py
@@ -0,0 +1,73 @@
+from datetime import datetime, timezone
+
+from pulso import db
+from tests.conftest import ADMIN
+
+URL = '/admin/ocupacion.csv'
+ENC = 'fecha,hora,clase,instructor,cupo,confirmadas,ocupacion_pct'
+
+
+def utc(*a):
+    return datetime(*a, tzinfo=timezone.utc)
+
+
+def pedir(cliente, desde='2026-11-01', hasta='2026-11-30'):
+    return cliente.get(URL, params={'desde': desde, 'hasta': hasta}, headers=ADMIN)
+
+
+def lineas(r):
+    return r.text.splitlines()
+
+
+def test_sin_clave_401(cliente):
+    assert cliente.get(URL, params={'desde': '2026-11-01', 'hasta': '2026-11-02'}).status_code == 401
+
+
+def test_vacio_solo_encabezado(cliente):
+    r = pedir(cliente)
+    assert r.status_code == 200
+    assert r.headers['content-type'] == 'text/csv; charset=utf-8'
+    assert lineas(r) == [ENC]
+
+
+def test_filas_conteo_y_comillas(cliente):
+    a = db.crear_clase('Yoga, nivel 1', 'Sofía', utc(2026, 11, 3, 22, 30), cupo=12)
+    b = db.crear_clase('Spinning', 'Leo', utc(2026, 11, 3, 10, 0), cupo=8)
+    db.crear_clase('Say "hi"', 'X', utc(2026, 11, 3, 10, 0), cupo=8)
+    for i in range(3):
+        s = db.crear_socio('s', f's{i}@x.com')
+        db.crear_reserva(s['id'], b['id'], utc(2026, 11, 1))
+    s = db.crear_socio('t', 't@x.com')
+    db.crear_reserva(s['id'], b['id'], utc(2026, 11, 1), estado='cancelada')
+    db.crear_reserva(s['id'], a['id'], utc(2026, 11, 1))
+    assert lineas(pedir(cliente)) == [
+        ENC,
+        '2026-11-03,07:00,Spinning,Leo,8,3,38',
+        '2026-11-03,07:00,"Say ""hi""",X,8,0,0',
+        '2026-11-03,19:30,"Yoga, nivel 1",Sofía,12,1,8']
+
+
+def test_redondeo_medio_arriba(cliente):
+    k = db.crear_clase('A', 'B', utc(2026, 11, 3, 12), cupo=8)
+    s = db.crear_socio('s', 's@x.com')
+    db.crear_reserva(s['id'], k['id'], utc(2026, 11, 1))
+    assert lineas(pedir(cliente))[1].endswith(',8,1,13')
+
+
+def test_extremos_en_hora_montevideo(cliente):
+    db.crear_clase('Dentro', 'B', utc(2026, 12, 1, 2, 59))   # 30/11 23:59 MVD
+    db.crear_clase('Fuera', 'B', utc(2026, 12, 1, 3, 0))     # 1/12 00:00 MVD
+    db.crear_clase('Antes', 'B', utc(2026, 11, 1, 2, 59))    # 31/10 23:59 MVD
+    ls = lineas(pedir(cliente))
+    assert len(ls) == 2 and ',Dentro,' in ls[1]
+
+
+def test_validaciones_422(cliente):
+    assert cliente.get(URL, headers=ADMIN).status_code == 422
+    assert cliente.get(URL, params={'desde': '2026-11-01'}, headers=ADMIN).status_code == 422
+    assert pedir(cliente, '01/11/2026', '2026-11-30').status_code == 422
+    assert pedir(cliente, '2026-13-01', '2026-11-30').status_code == 422
+    assert pedir(cliente, '2026-11-05', '2026-11-04').status_code == 422
+    assert pedir(cliente, '2026-10-01', '2026-11-01').status_code == 422
+    assert pedir(cliente, '2026-10-01', '2026-10-31').status_code == 200
+    assert pedir(cliente, '2026-11-05', '2026-11-05').status_code == 200
