{"host.arch": "amd64", "os.type": "linux", "os.version": "6.18.33.2-microsoft-standard-WSL2", "service.name": "claude-code", "service.version": "2.1.312", "wsl.version": "2", "user.id": "0f72bbf305cc3cfe4c49efd7a27949e16f5ce38c2de862b736399de5c3c79b13", "session.id": "b250c31d-f5df-404c-80ea-9ddae8d54818", "terminal.type": "wsl-Ubuntu-24.04", "gen_ai.provider.name": "anthropic", "span.type": "tool", "tool_name": "Bash", "tool_name_safe": "Bash", "gen_ai.operation.name": "execute_tool", "gen_ai.tool.name": "Bash", "gen_ai.conversation.id": "b250c31d-f5df-404c-80ea-9ddae8d54818", "full_command": "cat > tests/test_socios.py <<'EOF'\nimport pytest\n\nfrom pulso import db\nfrom tests.conftest import auth\n\nOK = {'nombre': '  Ana Pérez ', 'email': ' Ana.Perez@Example.com ', 'plan': 'premium'}\n\n\ndef test_alta_normaliza_y_da_token(cliente):\n    r = cliente.post('/socios', json=OK)\n    assert r.status_code == 201\n    d = r.json()\n    assert d['nombre'] == 'Ana Pérez' and d['email'] == 'ana.perez@example.com'\n    assert d['plan'] == 'premium' and d['creditos'] == 20 and len(d['token']) >= 32\n    assert cliente.get('/yo', headers={'Authorization': f\"Bearer {d['token']}\"}).json()['id'] == d['id']\n\n\ndef test_basico_8_creditos(cliente):\n    assert cliente.post('/socios', json=dict(OK, plan='basico')).json()['creditos'] == 8\n\n\ndef test_tokens_distintos(cliente):\n    a = cliente.post('/socios', json=OK).json()['token']\n    b = cliente.post('/socios', json=dict(OK, email='otra@example.com')).json()['token']\n    assert a != b\n\n\ndef test_correo_bienvenida(cliente):\n    cliente.post('/socios', json=OK)\n    c = db.correos()\n    assert len(c) == 1 and c[0]['para'] == 'ana.perez@example.com'\n    assert c[0]['asunto'] == 'Te damos la bienvenida a Pulso'\n\n\ndef test_email_duplicado_409(cliente):\n    cliente.post('/socios', json=OK)\n    r = cliente.post('/socios', json=dict(OK, email='ANA.PEREZ@example.com'))\n    assert r.status_code == 409\n    assert len(db.correos()) == 1\n\n\n@pytest.mark.parametrize('cambio', [\n    {'nombre': ' a '}, {'nombre': 'x' * 81}, {'nombre': '   '}, {'nombre': 5},\n    {'email': 'sin-arroba'}, {'email': 'a@@b.com'}, {'email': 'a@b@c.com'}, {'email': '@b.com'},\n    {'email': 'a@b'}, {'email': 'a@.b.com'}, {'email': 'a@b.com.'}, {'email': 'a b@c.com'},\n    {'email': 'a@b .com'}, {'plan': 'oro'}, {'plan': 'Premium'}, {'plan': None},\n])\ndef test_invalidos_422(cliente, cambio):\n    assert cliente.post('/socios', json=dict(OK, **cambio)).status_code == 422\n\n\n@pytest.mark.parametrize('falta', ['nombre', 'email', 'plan'])\ndef test_falta_dato_422(cliente, falta):\n    datos = {k: v for k, v in OK.items() if k != falta}\n    assert cliente.post('/socios', json=datos).status_code == 422\nEOF\npython -m pytest -q 2>&1 | tail -8", "bash_command_class": "file_read", "bash_argv0": "cat", "tool_use_id": "toolu_01DtQ4v9G3FADiag11NRyjbc", "gen_ai.tool.call.id": "toolu_01DtQ4v9G3FADiag11NRyjbc", "duration_ms": 7, "_nombre": "claude_code.tool", "_traza": "23de2bfddb720966530bd7d548af031f", "_tramo": "b82a9bbfb0f0480e", "_padre": "60b4ed7c4408dbb0", "_inicio_ns": 1794690566248000000, "_fin_ns": 1794690566254730795, "_estado": 0}
