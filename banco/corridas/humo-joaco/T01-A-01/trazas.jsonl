{"host.arch": "amd64", "os.type": "linux", "os.version": "6.18.33.2-microsoft-standard-WSL2", "service.name": "claude-code", "service.version": "2.1.312", "wsl.version": "2", "user.id": "0f72bbf305cc3cfe4c49efd7a27949e16f5ce38c2de862b736399de5c3c79b13", "session.id": "2809bef4-bcd9-4a7a-8e81-5d85c86aa390", "terminal.type": "wsl-Ubuntu-24.04", "gen_ai.provider.name": "anthropic", "span.type": "tool", "tool_name": "Bash", "tool_name_safe": "Bash", "gen_ai.operation.name": "execute_tool", "gen_ai.tool.name": "Bash", "gen_ai.conversation.id": "2809bef4-bcd9-4a7a-8e81-5d85c86aa390", "full_command": "cat > tests/test_cancelar.py <<'EOF'\nfrom datetime import timedelta\n\nfrom conftest import AHORA, auth\nfrom pulso import db, reloj\n\n\ndef reservar(cliente, socio, horas):\n    clase = db.crear_clase('Yoga', 'Sofía', AHORA + timedelta(hours=horas), cupo=1)\n    r = cliente.post('/reservas', json={'clase_id': clase['id']}, headers=auth(socio))\n    return clase, r.json()\n\n\ndef cancelar(cliente, socio, reserva_id):\n    return cliente.post(f'/reservas/{reserva_id}/cancelar', headers=auth(socio))\n\n\ndef creditos(cliente, socio):\n    return cliente.get('/yo', headers=auth(socio)).json()['creditos']\n\n\ndef test_cancela_con_anticipacion_devuelve_credito(cliente, socio):\n    clase, res = reservar(cliente, socio, 2)\n    r = cancelar(cliente, socio, res['id'])\n    assert r.status_code == 200\n    assert r.json() == {'id': res['id'], 'clase_id': clase['id'], 'estado': 'cancelada',\n                        'creada': res['creada'], 'credito_devuelto': True}\n    assert creditos(cliente, socio) == 8\n\n\ndef test_cancela_tarde_no_devuelve_credito(cliente, socio):\n    _, res = reservar(cliente, socio, 2)\n    reloj.fijar(AHORA + timedelta(minutes=1))\n    r = cancelar(cliente, socio, res['id'])\n    assert r.status_code == 200\n    assert r.json()['credito_devuelto'] is False\n    assert creditos(cliente, socio) == 7\n\n\ndef test_no_se_cancela_dos_veces(cliente, socio):\n    _, res = reservar(cliente, socio, 5)\n    cancelar(cliente, socio, res['id'])\n    assert cancelar(cliente, socio, res['id']).status_code == 409\n    assert creditos(cliente, socio) == 8\n\n\ndef test_clase_empezada(cliente, socio):\n    _, res = reservar(cliente, socio, 3)\n    reloj.fijar(AHORA + timedelta(hours=3))\n    assert cancelar(cliente, socio, res['id']).status_code == 409\n    assert creditos(cliente, socio) == 7\n\n\ndef test_ajena_o_inexistente(cliente, socio):\n    otro = db.crear_socio('Beto', 'beto@example.com')\n    _, res = reservar(cliente, socio, 5)\n    assert cancelar(cliente, otro, res['id']).status_code == 404\n    assert cancelar(cliente, socio, 999).status_code == 404\n    assert cliente.post(f\"/reservas/{res['id']}/cancelar\").status_code == 401\n\n\ndef test_sigue_en_listado_y_libera_lugar(cliente, socio):\n    clase, res = reservar(cliente, socio, 5)\n    assert cliente.get(f\"/clases/{clase['id']}\").json()['lugares_libres'] == 0\n    cancelar(cliente, socio, res['id'])\n    assert cliente.get(f\"/clases/{clase['id']}\").json()['lugares_libres'] == 1\n    estados = [r['estado'] for r in cliente.get('/reservas', headers=auth(socio)).json()]\n    assert estados == ['cancelada']\n    otro = db.crear_socio('Beto', 'beto@example.com')\n    assert cliente.post('/reservas', json={'clase_id': clase['id']}, headers=auth(otro)).status_code == 201\n\n\ndef test_mismo_socio_puede_reservar_de_nuevo(cliente, socio):\n    clase, res = reservar(cliente, socio, 5)\n    cancelar(cliente, socio, res['id'])\n    assert cliente.post('/reservas', json={'clase_id': clase['id']}, headers=auth(socio)).status_code == 201\nEOF\npython -m pytest -q 2>&1 | tail -5", "bash_command_class": "file_read", "bash_argv0": "cat", "tool_use_id": "toolu_017YRaYw6YSp7o2wBFtV2xW8", "gen_ai.tool.call.id": "toolu_017YRaYw6YSp7o2wBFtV2xW8", "duration_ms": 5, "_nombre": "claude_code.tool", "_traza": "d41ae382de6af652e63c406b2704fccc", "_tramo": "4116ca6485b96a2e", "_padre": "1587b0b541314d1a", "_inicio_ns": 1794684415310000000, "_fin_ns": 1794684415315359034, "_estado": 0}
