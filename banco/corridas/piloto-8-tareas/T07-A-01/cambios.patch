@@ -0,0 +1,54 @@
+"""Cliente de Cobrá, la pasarela de pagos. Cualquier falla se informa con CobraError."""
+import os
+
+import httpx
+
+
+class CobraError(Exception):
+    """Cobrá no contestó o contestó algo fuera de contrato."""
+
+
+def _pedir(metodo, ruta, ok, **kwargs):
+    base = os.environ.get('PULSO_PAGOS_URL', '').rstrip('/')
+    headers = dict(kwargs.pop('headers', {}), **{'X-Cobra-Clave': os.environ.get('PULSO_PAGOS_CLAVE', '')})
+    try:
+        r = httpx.request(metodo, base + ruta, headers=headers, timeout=5, **kwargs)
+    except httpx.HTTPError as e:
+        raise CobraError(str(e)) from e
+    if r.status_code not in ok:
+        raise CobraError(f'Cobrá respondió {r.status_code}')
+    if r.status_code == 404:
+        return None
+    try:
+        return r.json()
+    except ValueError as e:
+        raise CobraError('Respuesta inválida') from e
+
+
+def _pago_valido(pago):
+    if not isinstance(pago, dict) or pago.get('estado') not in ('pendiente', 'aprobado', 'rechazado') \
+            or not isinstance(pago.get('id'), str):
+        raise CobraError('Pago inválido')
+    return pago
+
+
+def crear_pago(monto, referencia):
+    pago = _pedir('POST', '/pagos', (200, 201), headers={'Idempotency-Key': referencia},
+                  json={'monto': monto, 'moneda': 'UYU', 'referencia': referencia})
+    return _pago_valido(pago)
+
+
+def obtener_pago(pago_id):
+    """El pago, o None si Cobrá no lo conoce."""
+    pago = _pedir('GET', f'/pagos/{pago_id}', (200, 404))
+    return None if pago is None else _pago_valido(pago)
+
+
+def buscar_por_referencia(referencia):
+    """El pago con esa referencia, o None si no hay ninguno."""
+    datos = _pedir('GET', '/pagos', (200,), params={'referencia': referencia})
+    pagos = datos.get('pagos') if isinstance(datos, dict) else None
+    if not isinstance(pagos, list):
+        raise CobraError('Respuesta inválida')
+    pagos = [p for p in pagos if isinstance(p, dict) and p.get('referencia') == referencia]
+    return _pago_valido(pagos[0]) if pagos else None
