{"host.arch": "arm64", "os.type": "darwin", "os.version": "23.4.0", "service.name": "claude-code", "service.version": "2.1.312", "user.id": "", "session.id": "f81f63c8-fe04-4e50-a5b1-0db5fa6716e3", "terminal.type": "claude-desktop", "gen_ai.provider.name": "anthropic", "span.type": "tool", "tool_name": "Bash", "tool_name_safe": "Bash", "gen_ai.operation.name": "execute_tool", "gen_ai.tool.name": "Bash", "gen_ai.conversation.id": "f81f63c8-fe04-4e50-a5b1-0db5fa6716e3", "full_command": "python - <<'E'\nimport re\np='pulso/db.py'\ns=open(p).read()\ns=s.replace(\"\"\"    creada TEXT NOT NULL\n);\"\"\",\"\"\"    creada TEXT NOT NULL,\n    recordatorio TEXT\n);\"\"\")\ns=s.replace(\"\"\"        con.executescript(ESQUEMA)\n\"\"\",\"\"\"        con.executescript(ESQUEMA)\n        columnas = [f['name'] for f in con.execute('PRAGMA table_info(reservas)')]\n        if 'recordatorio' not in columnas:\n            con.execute('ALTER TABLE reservas ADD COLUMN recordatorio TEXT')\n\"\"\")\ns+='''\n\ndef reservas_a_recordar(desde, hasta):\n    \"\"\"Reservas confirmadas sin recordatorio cuya clase empieza en (desde, hasta].\"\"\"\n    candidatas = _varias(\"SELECT r.id, r.socio_id, r.clase_id FROM reservas r \"\n                         \"WHERE r.estado = 'confirmada' AND r.recordatorio IS NULL ORDER BY r.id\")\n    resultado = []\n    for r in candidatas:\n        if desde < a_fecha(clase(r['clase_id'])['inicio']) <= hasta:\n            resultado.append(r)\n    return resultado\n\n\ndef marcar_recordatorio(reserva_id, momento):\n    \"\"\"Marca la reserva como recordada. Devuelve False si otro proceso ya lo hizo.\"\"\"\n    with conexion() as con:\n        cur = con.execute(\"UPDATE reservas SET recordatorio = ? WHERE id = ? AND recordatorio IS NULL \"\n                          \"AND estado = 'confirmada'\", (a_texto(momento), reserva_id))\n    return cur.rowcount == 1\n'''\nopen(p,'w').write(s)\np='pulso/main.py'\ns=open(p).read()\ns=s.replace(\"from pydantic\",\"from datetime import timedelta\\n\\nfrom pydantic\",1) if False else s\ns=s.replace(\"import os\\n\",\"import os\\nfrom datetime import timedelta\\n\",1)\ns=s.replace(\"def crear_app\",\"\"\"@router.post('/admin/recordatorios', dependencies=[Depends(admin)])\ndef enviar_recordatorios():\n    ahora = reloj.ahora()\n    enviados = 0\n    for r in db.reservas_a_recordar(ahora, ahora + timedelta(hours=24)):\n        if not db.marcar_recordatorio(r['id'], ahora):\n            continue\n        socio = db.socio(r['socio_id'])\n        clase = db.clase(r['clase_id'])\n        cuando = correo.fecha_y_hora(db.a_fecha(clase['inicio']))\n        correo.enviar(socio['email'], f\"Recordatorio: {clase['nombre']} el {cuando}\",\n                      f\"Hola {socio['nombre']}, te recordamos que mañana tenés {clase['nombre']} \"\n                      f\"({cuando}) con {clase['instructor']}.\")\n        enviados += 1\n    return {'enviados': enviados}\n\n\ndef crear_app\"\"\")\nopen(p,'w').write(s)\nE\ncat >> tests/test_recordatorios.py <<'E'\nfrom datetime import timedelta\n\nfrom conftest import ADMIN, AHORA\nfrom pulso import db\n\n\ndef reservar(socio, horas, estado='confirmada', nombre='Yoga'):\n    clase = db.crear_clase(nombre, 'Sofía', AHORA + horas)\n    return db.crear_reserva(socio['id'], clase['id'], AHORA, estado)\n\n\ndef test_requiere_admin(cliente):\n    assert cliente.post('/admin/recordatorios').status_code == 401\n    assert cliente.post('/admin/recordatorios', headers={'X-Admin-Key': 'x'}).status_code == 401\n\n\ndef test_envia_y_no_repite(cliente, socio):\n    reservar(socio, timedelta(hours=6, minutes=30))\n    r = cliente.post('/admin/recordatorios', headers=ADMIN)\n    assert r.json() == {'enviados': 1}\n    [c] = db.correos()\n    assert c['para'] == 'ana@example.com'\n    assert c['asunto'] == 'Recordatorio: Yoga el 10/11 a las 18:30'\n    assert 'Sofía' in c['cuerpo']\n    assert cliente.post('/admin/recordatorios', headers=ADMIN).json() == {'enviados': 0}\n    assert len(db.correos()) == 1\n\n\ndef test_ventana_y_estado(cliente, socio):\n    reservar(socio, timedelta(hours=24))  # borde inclusive\n    reservar(socio, timedelta(hours=24, seconds=1))\n    reservar(socio, timedelta(0))\n    reservar(socio, timedelta(hours=-1))\n    reservar(socio, timedelta(hours=3), estado='cancelada')\n    assert cliente.post('/admin/recordatorios', headers=ADMIN).json() == {'enviados': 1}\nE\npython -m pytest -q 2>&1 | tail -5", "bash_command_class": "lang_runtime", "bash_argv0": "python", "tool_use_id": "toolu_015vKJ9B4Ni8EAPqce8iTRbp", "gen_ai.tool.call.id": "toolu_015vKJ9B4Ni8EAPqce8iTRbp", "duration_ms": 7, "_nombre": "claude_code.tool", "_traza": "6cff4404ef6b0cb840dd30bd3c81e54e", "_tramo": "0afb0ceac785f99e", "_padre": "46b9354fc8378bb8", "_inicio_ns": 1794572162645000000, "_fin_ns": 1794572162651869500, "_estado": 0}
