diff --git a/tests/test_series.py b/tests/test_series.py
new file mode 100644
index 0000000..953b2d5
--- /dev/null
+++ b/tests/test_series.py
@@ -0,0 +1,130 @@
+from datetime import timedelta
+
+from conftest import ADMIN, AHORA, auth
+from pulso import db
+
+SERIE = {'nombre': 'Yoga', 'instructor': 'Sofía', 'dia': 'martes', 'hora': '19:00', 'duracion_min': 60,
+         'cupo': 15, 'desde': '2026-11-10', 'hasta': '2026-12-31'}
+
+
+def crear(cliente, **cambios):
+    return cliente.post('/admin/series', json={**SERIE, **cambios}, headers=ADMIN)
+
+
+def test_crea_serie_semanal(cliente):
+    r = crear(cliente)
+    assert r.status_code == 201
+    clases = r.json()['clases']
+    assert [c['inicio'] for c in clases][:2] == ['2026-11-10T22:00:00+00:00', '2026-11-17T22:00:00+00:00']
+    assert len(clases) == 8
+    assert clases[0]['serie_id'] == r.json()['id'] and clases[0]['estado'] == 'programada'
+
+
+def test_omite_cierres_y_pasado(cliente):
+    r = crear(cliente, dia='viernes', desde='2026-11-10', hasta='2027-01-02')
+    fechas = [c['inicio'][:10] for c in r.json()['clases']]
+    assert '2026-12-25' not in fechas and '2027-01-01' not in fechas
+    r = crear(cliente, hora='12:00')  # hoy 12:00 Montevideo: ya empezó
+    assert r.json()['clases'][0]['inicio'].startswith('2026-11-17')
+    assert crear(cliente, hora='12:01').json()['clases'][0]['inicio'].startswith('2026-11-10')
+
+
+def test_serie_vacia_valida(cliente):
+    r = crear(cliente, desde='2026-11-11', hasta='2026-11-12')
+    assert r.status_code == 201 and r.json()['clases'] == []
+
+
+def test_validaciones(cliente):
+    for malo in [{'dia': 'Martes'}, {'dia': 'miercoles'}, {'hora': '24:00'}, {'hora': '9:00'}, {'nombre': ''},
+                 {'instructor': ''}, {'cupo': 0}, {'duracion_min': 0}, {'hasta': '2026-11-09'},
+                 {'hasta': '2027-11-12'}]:
+        assert crear(cliente, **malo).status_code == 422, malo
+    assert crear(cliente, hasta='2027-11-11').status_code == 201
+    datos = dict(SERIE)
+    del datos['cupo']
+    assert cliente.post('/admin/series', json=datos, headers=ADMIN).status_code == 422
+    assert cliente.post('/admin/series', json=SERIE).status_code == 401
+
+
+def test_get_serie(cliente):
+    sid = crear(cliente).json()['id']
+    assert cliente.get(f'/admin/series/{sid}', headers=ADMIN).json()['id'] == sid
+    assert cliente.get('/admin/series/99', headers=ADMIN).status_code == 404
+
+
+def test_patch_hora_desde_clase(cliente, socio):
+    serie = crear(cliente).json()
+    c = serie['clases']
+    db.crear_reserva(socio['id'], c[2]['id'], AHORA)
+    db.crear_reserva(socio['id'], c[0]['id'], AHORA)
+    cliente.post(f"/admin/clases/{c[3]['id']}/cancelar", headers=ADMIN)
+    r = cliente.patch(f"/admin/series/{serie['id']}", headers=ADMIN,
+                      json={'desde_clase_id': c[2]['id'], 'hora': '20:00', 'instructor': 'Leo'})
+    assert r.status_code == 200
+    n = r.json()['clases']
+    assert n[1]['inicio'] == '2026-11-17T22:00:00+00:00' and n[1]['instructor'] == 'Sofía'
+    assert n[2]['inicio'] == '2026-11-24T23:00:00+00:00' and n[2]['instructor'] == 'Leo'
+    assert n[3]['inicio'] == c[3]['inicio'] and n[3]['estado'] == 'cancelada'
+    assert n[4]['inicio'] == '2026-12-08T23:00:00+00:00'
+    assert r.json()['hora'] == '20:00'
+    asuntos = [m['asunto'] for m in db.correos()]
+    assert asuntos == ['Cambio de horario: Yoga el 24/11 a las 20:00']
+
+
+def test_patch_cupo_sin_correo(cliente, socio):
+    serie = crear(cliente).json()
+    c = serie['clases']
+    db.crear_reserva(socio['id'], c[1]['id'], AHORA)
+    r = cliente.patch(f"/admin/series/{serie['id']}", headers=ADMIN, json={'desde_clase_id': c[0]['id'], 'cupo': 5})
+    assert r.status_code == 200 and r.json()['clases'][1]['lugares_libres'] == 4
+    assert db.correos() == []
+
+
+def test_patch_rechazos(cliente, socio):
+    serie = crear(cliente).json()
+    c = serie['clases']
+    url = f"/admin/series/{serie['id']}"
+    otra = crear(cliente).json()['clases'][0]['id']
+    assert cliente.patch(url, headers=ADMIN, json={'desde_clase_id': otra, 'cupo': 5}).status_code == 404
+    assert cliente.patch('/admin/series/99', headers=ADMIN, json={'desde_clase_id': 1, 'cupo': 5}).status_code == 404
+    assert cliente.patch(url, headers=ADMIN, json={'desde_clase_id': c[1]['id']}).status_code == 422
+    assert cliente.patch(url, headers=ADMIN, json={'desde_clase_id': c[1]['id'], 'hora': '25:00'}).status_code == 422
+    assert cliente.patch(url, headers=ADMIN, json={'desde_clase_id': c[1]['id'], 'cupo': 0}).status_code == 422
+    assert cliente.patch(url, json={'desde_clase_id': c[1]['id'], 'cupo': 3}).status_code == 401
+    # hoy 19:00 todavía no empezó, pero 11:00 quedaría en el pasado
+    assert cliente.patch(url, headers=ADMIN, json={'desde_clase_id': c[0]['id'], 'hora': '11:00'}).status_code == 409
+    # cupo menor a las reservas de una clase posterior
+    otro = db.crear_socio('Juan', 'juan@example.com')
+    for s in (socio, otro):
+        db.crear_reserva(s['id'], c[3]['id'], AHORA)
+    assert cliente.patch(url, headers=ADMIN, json={'desde_clase_id': c[0]['id'], 'cupo': 1,
+                                                  'instructor': 'X'}).status_code == 409
+    assert cliente.get(url, headers=ADMIN).json()['clases'][0]['instructor'] == 'Sofía'
+    # clase que ya empezó
+    from datetime import timedelta
+    from pulso import reloj
+    reloj.fijar(AHORA + timedelta(days=8))
+    assert cliente.patch(url, headers=ADMIN, json={'desde_clase_id': c[0]['id'], 'cupo': 5}).status_code == 409
+
+
+def test_cancelar_clase(cliente, socio):
+    clase = db.crear_clase('Yoga', 'Sofía', AHORA + timedelta(days=7, hours=7))
+    db.crear_reserva(socio['id'], clase['id'], AHORA)
+    db.sumar_creditos(socio['id'], -1)
+    r = cliente.post(f"/admin/clases/{clase['id']}/cancelar", headers=ADMIN)
+    assert r.status_code == 200 and r.json()['estado'] == 'cancelada' and r.json()['lugares_libres'] == 20
+    assert db.socio(socio['id'])['creditos'] == 8
+    assert db.reserva(1)['estado'] == 'cancelada'
+    assert db.correos()[0]['asunto'] == 'Clase cancelada: Yoga el 17/11 a las 19:00'
+    assert cliente.get('/clases').json() == []
+    assert cliente.get(f"/clases/{clase['id']}").json()['estado'] == 'cancelada'
+    r = cliente.post('/reservas', json={'clase_id': clase['id']}, headers=auth(socio))
+    assert r.status_code == 409 and r.json()['detail'] == 'La clase está cancelada'
+    assert cliente.post(f"/admin/clases/{clase['id']}/cancelar", headers=ADMIN).status_code == 409
+    assert cliente.post('/admin/clases/99/cancelar', headers=ADMIN).status_code == 404
+    assert cliente.post(f"/admin/clases/{clase['id']}/cancelar").status_code == 401
+
+
+def test_cancelar_clase_empezada(cliente):
+    clase = db.crear_clase('Yoga', 'Sofía', AHORA)
+    assert cliente.post(f"/admin/clases/{clase['id']}/cancelar", headers=ADMIN).status_code == 409
