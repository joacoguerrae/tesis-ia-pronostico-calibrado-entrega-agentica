{"host.arch": "arm64", "os.type": "darwin", "os.version": "23.4.0", "service.name": "claude-code", "service.version": "2.1.312", "user.id": "", "session.id": "71c86383-3f16-4223-a1d5-d8581a04ea80", "terminal.type": "claude-desktop", "gen_ai.provider.name": "anthropic", "span.type": "tool", "tool_name": "Bash", "tool_name_safe": "Bash", "gen_ai.operation.name": "execute_tool", "gen_ai.tool.name": "Bash", "gen_ai.conversation.id": "71c86383-3f16-4223-a1d5-d8581a04ea80", "full_command": "cat > tests/test_cancelar.py <<'E'\nfrom datetime import timedelta\n\nfrom pulso import db, reloj\nfrom tests.conftest import AHORA, auth\n\n\ndef reservar(cliente, socio, horas):\n    clase = db.crear_clase('Yoga', 'Lu', AHORA + timedelta(hours=horas))\n    r = cliente.post('/reservas', json={'clase_id': clase['id']}, headers=auth(socio))\n    assert r.status_code == 201\n    return clase, r.json()\n\n\ndef cancelar(cliente, socio, rid):\n    return cliente.post(f'/reservas/{rid}/cancelar', headers=auth(socio))\n\n\ndef test_con_anticipacion_devuelve_credito(cliente, socio):\n    clase, res = reservar(cliente, socio, 5)\n    r = cancelar(cliente, socio, res['id'])\n    assert r.status_code == 200\n    assert r.json() == {**res, 'estado': 'cancelada', 'credito_devuelto': True}\n    assert db.socio(socio['id'])['creditos'] == 8\n    assert cliente.get(f\"/clases/{clase['id']}\").json()['lugares_libres'] == 20\n    lista = cliente.get('/reservas', headers=auth(socio)).json()\n    assert [x['estado'] for x in lista] == ['cancelada']\n\n\ndef test_justo_dos_horas_devuelve(cliente, socio):\n    _, res = reservar(cliente, socio, 2)\n    assert cancelar(cliente, socio, res['id']).json()['credito_devuelto'] is True\n\n\ndef test_menos_de_dos_horas_no_devuelve(cliente, socio):\n    clase, res = reservar(cliente, socio, 1.5)\n    r = cancelar(cliente, socio, res['id'])\n    assert r.status_code == 200\n    assert r.json()['credito_devuelto'] is False\n    assert db.socio(socio['id'])['creditos'] == 7\n    assert cliente.get(f\"/clases/{clase['id']}\").json()['lugares_libres'] == 20\n\n\ndef test_ya_cancelada(cliente, socio):\n    _, res = reservar(cliente, socio, 5)\n    cancelar(cliente, socio, res['id'])\n    assert cancelar(cliente, socio, res['id']).status_code == 409\n    assert db.socio(socio['id'])['creditos'] == 8\n\n\ndef test_clase_empezada(cliente, socio):\n    _, res = reservar(cliente, socio, 1)\n    reloj.fijar(AHORA + timedelta(hours=1))\n    assert cancelar(cliente, socio, res['id']).status_code == 409\n\n\ndef test_ajena_o_inexistente(cliente, socio):\n    otro = db.crear_socio('Beto', 'beto@example.com')\n    _, res = reservar(cliente, socio, 5)\n    assert cancelar(cliente, otro, res['id']).status_code == 404\n    assert cancelar(cliente, socio, 999).status_code == 404\n    assert cliente.post(f\"/reservas/{res['id']}/cancelar\").status_code == 401\n\n\ndef test_se_puede_volver_a_reservar(cliente, socio):\n    clase, res = reservar(cliente, socio, 5)\n    cancelar(cliente, socio, res['id'])\n    r = cliente.post('/reservas', json={'clase_id': clase['id']}, headers=auth(socio))\n    assert r.status_code == 201\n    otro = db.crear_socio('Beto', 'beto@example.com')\n    assert cliente.post('/reservas', json={'clase_id': clase['id']}, headers=auth(otro)).status_code == 201\nE\npython -m pytest -q 2>&1 | tail -8", "bash_command_class": "file_read", "bash_argv0": "cat", "tool_use_id": "toolu_01BswvJVX1EXhNDXYksLPhTu", "gen_ai.tool.call.id": "toolu_01BswvJVX1EXhNDXYksLPhTu", "duration_ms": 6, "_nombre": "claude_code.tool", "_traza": "bc1bebd3064e97bb3e5dd63d632b2d06", "_tramo": "b09a29fc9b862431", "_padre": "0ef3dfab70527aa9", "_inicio_ns": 1794571602510000000, "_fin_ns": 1794571602516111708, "_estado": 0}
