diff --git a/pulso/db.py b/pulso/db.py
index 59841ac..1d6a02c 100644
--- a/pulso/db.py
+++ b/pulso/db.py
@@ -27,7 +27,8 @@ CREATE TABLE IF NOT EXISTS reservas (
     socio_id INTEGER NOT NULL REFERENCES socios(id),
     clase_id INTEGER NOT NULL REFERENCES clases(id),
     estado TEXT NOT NULL,
-    creada TEXT NOT NULL
+    creada TEXT NOT NULL,
+    recordatorio TEXT
 );
 CREATE TABLE IF NOT EXISTS correos (
     id INTEGER PRIMARY KEY,
@@ -58,6 +59,9 @@ def conexion():
 def inicializar():
     with conexion() as con:
         con.executescript(ESQUEMA)
+        columnas = [f['name'] for f in con.execute('PRAGMA table_info(reservas)')]
+        if 'recordatorio' not in columnas:
+            con.execute('ALTER TABLE reservas ADD COLUMN recordatorio TEXT')
 
 
 def a_texto(momento):
@@ -134,5 +138,20 @@ def sumar_creditos(socio_id, cantidad):
         con.execute('UPDATE socios SET creditos = creditos + ? WHERE id = ?', (cantidad, socio_id))
 
 
+def reservas_a_recordar(desde, hasta):
+    """Reservas confirmadas sin recordatorio cuya clase empieza en (desde, hasta]."""
+    candidatas = _varias("SELECT id, socio_id, clase_id FROM reservas "
+                         "WHERE estado = 'confirmada' AND recordatorio IS NULL ORDER BY id")
+    return [r for r in candidatas if desde < a_fecha(clase(r['clase_id'])['inicio']) <= hasta]
+
+
+def marcar_recordatorio(reserva_id, momento):
+    """Marca la reserva como recordada. Devuelve False si otro proceso ya lo hizo."""
+    with conexion() as con:
+        cur = con.execute("UPDATE reservas SET recordatorio = ? WHERE id = ? AND recordatorio IS NULL "
+                          "AND estado = 'confirmada'", (a_texto(momento), reserva_id))
+    return cur.rowcount == 1
+
+
 def correos():
     return _varias('SELECT * FROM correos ORDER BY id')
diff --git a/pulso/main.py b/pulso/main.py
index 039212d..69d5a12 100644
--- a/pulso/main.py
+++ b/pulso/main.py
@@ -1,4 +1,5 @@
 import os
+from datetime import timedelta
 
 from fastapi import APIRouter, Depends, FastAPI, Header, HTTPException
 from pydantic import AwareDatetime, BaseModel, Field
@@ -92,6 +93,23 @@ def yo(socio=Depends(socio_actual)):
     return {k: socio[k] for k in ('id', 'nombre', 'email', 'plan', 'creditos')}
 
 
+@router.post('/admin/recordatorios', dependencies=[Depends(admin)])
+def enviar_recordatorios():
+    ahora = reloj.ahora()
+    enviados = 0
+    for r in db.reservas_a_recordar(ahora, ahora + timedelta(hours=24)):
+        if not db.marcar_recordatorio(r['id'], ahora):
+            continue
+        socio = db.socio(r['socio_id'])
+        clase = db.clase(r['clase_id'])
+        cuando = correo.fecha_y_hora(db.a_fecha(clase['inicio']))
+        correo.enviar(socio['email'], f"Recordatorio: {clase['nombre']} el {cuando}",
+                      f"Hola {socio['nombre']}, te recordamos que tenés {clase['nombre']} "
+                      f"({cuando}) con {clase['instructor']}.")
+        enviados += 1
+    return {'enviados': enviados}
+
+
 def crear_app():
     db.inicializar()
     app = FastAPI(title='Pulso')
