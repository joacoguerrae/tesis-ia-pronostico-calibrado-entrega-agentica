diff --git a/pulso/cobra.py b/pulso/cobra.py
new file mode 100644
index 0000000..0c15728
--- /dev/null
+++ b/pulso/cobra.py
@@ -0,0 +1,78 @@
+"""Cliente de Cobrá, la pasarela de pagos. Cobrá es la fuente de verdad sobre el estado de los pagos.
+
+Cualquier falla (no contesta, tarda más de 5 segundos, responde un código que el contrato no prevé
+para esa ruta o responde algo mal formado) se reporta como CobraError.
+"""
+import os
+from urllib.parse import quote
+
+import httpx
+
+ESTADOS = ('pendiente', 'aprobado', 'rechazado')
+CAMPOS = ('id', 'estado', 'monto', 'moneda', 'referencia', 'url_pago')
+
+
+class CobraError(Exception):
+    pass
+
+
+def _configuracion():
+    url = os.environ.get('PULSO_PAGOS_URL')
+    clave = os.environ.get('PULSO_PAGOS_CLAVE')
+    if not url or not clave:
+        raise CobraError('Falta la configuración de Cobrá')
+    return url.rstrip('/'), clave
+
+
+def _cliente():
+    return httpx.Client(timeout=5.0)
+
+
+def _pedir(metodo, ruta, esperados, headers=None, **kwargs):
+    url, clave = _configuracion()
+    headers = {**(headers or {}), 'X-Cobra-Clave': clave}
+    try:
+        with _cliente() as cliente:
+            r = cliente.request(metodo, url + ruta, headers=headers, **kwargs)
+    except httpx.HTTPError as error:
+        raise CobraError(f'Cobrá no respondió: {error}') from error
+    if r.status_code not in esperados:
+        raise CobraError(f'Cobrá respondió {r.status_code} a {metodo} {ruta}')
+    return r
+
+
+def _json(r):
+    try:
+        return r.json()
+    except ValueError as error:
+        raise CobraError('Cobrá respondió algo que no es JSON') from error
+
+
+def _pago(datos):
+    if not isinstance(datos, dict) or any(c not in datos for c in CAMPOS) or datos['estado'] not in ESTADOS:
+        raise CobraError('Cobrá respondió un pago mal formado')
+    return datos
+
+
+def crear_pago(referencia, monto):
+    """Crea el pago. Con la misma referencia como Idempotency-Key, Cobrá no crea dos pagos."""
+    r = _pedir('POST', '/pagos', (200, 201), json={'monto': monto, 'moneda': 'UYU', 'referencia': referencia},
+               headers={'Idempotency-Key': referencia})
+    return _pago(_json(r))
+
+
+def obtener_pago(pago_id):
+    """Devuelve el pago, o None si Cobrá no lo conoce."""
+    r = _pedir('GET', f'/pagos/{quote(pago_id, safe="")}', (200, 404))
+    if r.status_code == 404:
+        return None
+    return _pago(_json(r))
+
+
+def buscar_pagos(referencia):
+    """Devuelve los pagos con esa referencia (lista vacía si no hay ninguno)."""
+    r = _pedir('GET', '/pagos', (200,), params={'referencia': referencia})
+    datos = _json(r)
+    if not isinstance(datos, dict) or not isinstance(datos.get('pagos'), list):
+        raise CobraError('Cobrá respondió una lista de pagos mal formada')
+    return [_pago(p) for p in datos['pagos']]
diff --git a/pulso/compras.py b/pulso/compras.py
new file mode 100644
index 0000000..fa2cf28
--- /dev/null
+++ b/pulso/compras.py
@@ -0,0 +1,103 @@
+"""Compra de packs de créditos con Cobrá.
+
+Cobrá es la fuente de verdad: cada vez que Pulso averigua el estado de un pago (por el webhook o por la
+conciliación) lo aplica a la compra con `aplicar_estado`, que hace los cambios una sola vez por compra.
+"""
+import re
+from datetime import timedelta
+
+from pulso import cobra, correo, db, reloj
+
+# Catálogo fijo: pack -> (créditos, precio en pesos uruguayos).
+PACKS = {'pack-4': (4, 1200), 'pack-8': (8, 2200)}
+
+# Una compra sin pago de más de este tiempo nunca tuvo pago: se rechaza.
+PLAZO_SIN_PAGO = timedelta(minutes=30)
+
+ASUNTO_APROBADA = 'Compra de créditos aprobada'
+_ESTADO_COMPRA = {'aprobado': 'aprobada', 'rechazado': 'rechazada'}
+
+
+class NoExiste(Exception):
+    """Cobrá no conoce el pago, o no es de ninguna compra de Pulso."""
+
+
+def referencia(compra_id):
+    return f'pulso-compra-{compra_id}'
+
+
+def compra_id_de(ref):
+    coincide = re.fullmatch(r'pulso-compra-([0-9]+)', ref)
+    return int(coincide.group(1)) if coincide else None
+
+
+def aplicar_estado(compra, estado_cobra):
+    """Aplica el estado de Cobrá a la compra. Solo cambia una compra pendiente, así que los créditos
+    y el correo se dan una sola vez aunque el mismo pago llegue varias veces."""
+    nuevo = _ESTADO_COMPRA.get(estado_cobra)
+    if nuevo is None or compra['estado'] != 'pendiente':
+        return
+    socio = db.socio(compra['socio_id'])
+    # El cambio de estado, los créditos y el correo van en una sola transacción.
+    with db.conexion() as con:
+        if not db.marcar_compra(con, compra['id'], nuevo):
+            return
+        if nuevo == 'aprobada':
+            db.acreditar(con, socio['id'], compra['creditos'])
+            correo.enviar(socio['email'], ASUNTO_APROBADA,
+                          f"Hola {socio['nombre']}, se acreditaron {compra['creditos']} créditos "
+                          f"por tu compra del {compra['pack']}. ¡Buen entrenamiento!", con=con)
+
+
+def _registrar(compra, pago):
+    db.guardar_pago(compra['id'], pago['id'], pago['url_pago'])
+    aplicar_estado(compra, pago['estado'])
+    return db.compra(compra['id'])
+
+
+def procesar_aviso(pago_id):
+    """Procesa un aviso del webhook. El estado del aviso se ignora: se consulta el pago en Cobrá."""
+    pago = cobra.obtener_pago(pago_id)
+    if pago is None:
+        raise NoExiste
+    compra_id = compra_id_de(pago['referencia'])
+    compra = db.compra(compra_id) if compra_id is not None else None
+    if compra is None:
+        raise NoExiste
+    return _registrar(compra, pago)
+
+
+def _conciliar_una(compra):
+    if compra['pago_id'] is not None:
+        pago = cobra.obtener_pago(compra['pago_id'])
+        if pago is None:
+            return  # Cobrá no conoce el pago que tenemos: queda pendiente.
+    else:
+        pagos = cobra.buscar_pagos(referencia(compra['id']))
+        if not pagos:
+            # Sin pago: puede que todavía se esté creando, salvo que haya pasado el plazo.
+            if reloj.ahora() - db.a_fecha(compra['creada']) >= PLAZO_SIN_PAGO:
+                aplicar_estado(compra, 'rechazado')
+            return
+        pago = pagos[0]
+    _registrar(compra, pago)
+
+
+def conciliar():
+    """Revisa las compras pendientes de todos los socios y cuenta cómo quedaron."""
+    cuentas = {'aprobadas': 0, 'rechazadas': 0, 'pendientes': 0}
+    for pendiente in db.compras_pendientes():
+        compra = db.compra(pendiente['id'])
+        if compra['estado'] == 'pendiente':
+            try:
+                _conciliar_una(compra)
+            except cobra.CobraError:
+                pass  # Una falla de Cobrá deja la compra pendiente y sigue con las demás.
+        estado = db.compra(pendiente['id'])['estado']
+        if estado == 'aprobada':
+            cuentas['aprobadas'] += 1
+        elif estado == 'rechazada':
+            cuentas['rechazadas'] += 1
+        else:
+            cuentas['pendientes'] += 1
+    return cuentas
