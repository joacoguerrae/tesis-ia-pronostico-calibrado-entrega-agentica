+        return None if valor is None else sin_vacio(valor)
+
+    @model_validator(mode='after')
+    def hay_cambios(self):
+        if self.hora is None and self.instructor is None and self.cupo is None:
+            raise ValueError('no hay ningún cambio')
+        return self
+
+
+def inicio_nuevo(clase, hora):
+    """Mismo día de la clase, a la hora nueva (si hay hora nueva)."""
+    inicio = db.a_fecha(clase['inicio'])
+    if hora is None:
+        return inicio
+    return hora_en_dia(inicio.astimezone(reloj.MONTEVIDEO).date(), hora)
+
+
+@router.patch('/admin/series/{serie_id}', dependencies=[Depends(admin)])
+def cambiar_serie(serie_id: int, datos: CambioSerie):
+    serie = db.serie(serie_id)
+    if serie is None:
+        raise HTTPException(404, 'No existe la serie')
+    clases = db.clases_de_serie(serie_id)
+    desde = next((c for c in clases if c['id'] == datos.desde_clase_id), None)
+    if desde is None:
+        raise HTTPException(404, 'La clase no es de esta serie')
+    ahora = reloj.ahora()
+    inicio_desde = db.a_fecha(desde['inicio'])
+    if inicio_desde <= ahora:
+        raise HTTPException(409, 'La clase ya empezó')
+
+    # Las canceladas no cambian; el resto desde la clase indicada en adelante.
+    afectadas = [c for c in clases if c['estado'] == 'programada' and db.a_fecha(c['inicio']) >= inicio_desde]
+    nuevos = {c['id']: inicio_nuevo(c, datos.hora) for c in afectadas}
+    if any(inicio <= ahora for inicio in nuevos.values()):
+        raise HTTPException(409, 'Con la hora nueva, una clase empezaría en este momento o antes')
+    if datos.cupo is not None and any(db.confirmadas(c['id']) > datos.cupo for c in afectadas):
+        raise HTTPException(409, 'Con el cupo nuevo, una clase quedaría con más reservas que lugares')
+
+    avisos = []
+    campos_clases = {}
+    for c in afectadas:
+        campos = {}
+        if nuevos[c['id']] != db.a_fecha(c['inicio']):
+            campos['inicio'] = nuevos[c['id']]
+            avisos.append((c, nuevos[c['id']], db.socios_con_reserva_confirmada(c['id'])))
+        if datos.instructor is not None:
+            campos['instructor'] = datos.instructor
+        if datos.cupo is not None:
+            campos['cupo'] = datos.cupo
+        if campos:
+            campos_clases[c['id']] = campos
+
+    campos_serie = {k: v for k, v in (('hora', datos.hora), ('instructor', datos.instructor), ('cupo', datos.cupo))
+                    if v is not None}
+    db.aplicar_cambio_serie(serie_id, campos_serie, campos_clases)
+
+    for clase, nuevo, socios in avisos:
+        for socio in socios:
+            fecha = correo.fecha_y_hora(nuevo)
+            correo.enviar(socio['email'], f"Cambio de horario: {clase['nombre']} el {fecha}",
+                          f"Hola {socio['nombre']}, {clase['nombre']} pasa a ser el {fecha}. "
+                          f"Tu reserva se mantiene.")
+    return ver_serie(db.serie(serie_id))
+
