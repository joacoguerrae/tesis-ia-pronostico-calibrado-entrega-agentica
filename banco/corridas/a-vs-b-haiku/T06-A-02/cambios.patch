@@ -0,0 +1,167 @@
+from datetime import timedelta
+
+from conftest import ADMIN, AHORA, auth
+from pulso import db, reloj
+
+
+def llena(cupo=1, horas=30, ocupantes=None):
+    clase = db.crear_clase('Spinning', 'Leo', AHORA + timedelta(hours=horas), cupo=cupo)
+    reservas = []
+    for i in range(cupo):
+        s = db.crear_socio(f'Ocupante {i}', f'o{i}-{clase["id"]}@example.com')
+        reservas.append(db.crear_reserva(s['id'], clase['id'], AHORA))
+    return clase, reservas
+
+
+def anotar(cliente, clase, socio):
+    return cliente.post(f"/clases/{clase['id']}/espera", headers=auth(socio))
+
+
+def cancelar(cliente, reserva):
+    return cliente.post(f"/admin/reservas/{reserva['id']}/cancelar", headers=ADMIN)
+
+
+def test_anotarse_ver_y_bajarse(cliente, socio):
+    clase, _ = llena()
+    otro = db.crear_socio('Beto', 'beto@example.com')
+    assert anotar(cliente, clase, otro).json() == {'clase_id': clase['id'], 'posicion': 1}
+    r = anotar(cliente, clase, socio)
+    assert r.status_code == 201 and r.json()['posicion'] == 2
+    assert db.socio(socio['id'])['creditos'] == 8
+    assert cliente.delete(f"/clases/{clase['id']}/espera", headers=auth(otro)).status_code == 204
+    assert cliente.get(f"/clases/{clase['id']}/espera", headers=auth(socio)).json()['posicion'] == 1
+    assert cliente.get(f"/clases/{clase['id']}/espera", headers=auth(otro)).status_code == 404
+    assert cliente.delete(f"/clases/{clase['id']}/espera", headers=auth(otro)).status_code == 404
+    anotar(cliente, clase, otro)
+    assert cliente.get(f"/clases/{clase['id']}/espera", headers=auth(otro)).json()['posicion'] == 2
+
+
+def test_espera_requiere_token_y_clase(cliente, socio):
+    clase, _ = llena()
+    for m in (cliente.post, cliente.get, cliente.delete):
+        assert m(f"/clases/{clase['id']}/espera").status_code == 401
+        assert m('/clases/99/espera', headers=auth(socio)).status_code == 404
+
+
+def test_anotarse_rechazos(cliente, socio):
+    clase, _ = llena()
+    libre = db.crear_clase('Yoga', 'Sofía', AHORA + timedelta(hours=3))
+    assert anotar(cliente, libre, socio).status_code == 409
+    anotar(cliente, clase, socio)
+    assert anotar(cliente, clase, socio).status_code == 409
+    sin = db.crear_socio('Sin', 'sin@example.com', creditos=0)
+    assert anotar(cliente, clase, sin).status_code == 409
+    assert cliente.get(f"/clases/{clase['id']}/espera", headers=auth(sin)).status_code == 404
+    con_reserva = db.crear_socio('Res', 'res@example.com')
+    chica = db.crear_clase('Box', 'Leo', AHORA + timedelta(hours=3), cupo=1)
+    db.crear_reserva(con_reserva['id'], chica['id'], AHORA)
+    assert anotar(cliente, chica, con_reserva).status_code == 409
+    empezada, _ = llena(horas=-1)
+    assert anotar(cliente, empezada, socio).status_code == 409
+    reloj.fijar(AHORA + timedelta(hours=30))
+    assert anotar(cliente, clase, db.crear_socio('Tarde', 't@example.com')).status_code == 409
+
+
+def test_cancelar_asigna_al_primero(cliente, socio):
+    clase, (res,) = llena()
+    otro = db.crear_socio('Beto', 'beto@example.com')
+    anotar(cliente, clase, socio)
+    anotar(cliente, clase, otro)
+    r = cancelar(cliente, res)
+    assert r.status_code == 200
+    assert r.json()['estado'] == 'cancelada'
+    assert db.socio(res['socio_id'])['creditos'] == 9
+    assert db.socio(socio['id'])['creditos'] == 7
+    mis = cliente.get('/reservas', headers=auth(socio)).json()
+    assert [x['estado'] for x in mis] == ['confirmada']
+    assert cliente.get(f"/clases/{clase['id']}/espera", headers=auth(socio)).status_code == 404
+    assert cliente.get(f"/clases/{clase['id']}/espera", headers=auth(otro)).json()['posicion'] == 1
+    correos = [c for c in db.correos() if c['para'] == socio['email']]
+    assert [c['asunto'] for c in correos] == ['Se liberó un lugar: Spinning el 11/11 a las 18:00']
+    assert db.confirmadas(clase['id']) == 1
+    # Segunda cancelación: 409 sin otro crédito ni lugar.
+    assert cancelar(cliente, res).status_code == 409
+    assert db.socio(res['socio_id'])['creditos'] == 9
+    assert db.confirmadas(clase['id']) == 1
+
+
+def test_cancelar_inexistente_y_sin_clave(cliente):
+    assert cliente.post('/admin/reservas/99/cancelar', headers=ADMIN).status_code == 404
+    clase, (res,) = llena()
+    assert cliente.post(f"/admin/reservas/{res['id']}/cancelar").status_code == 401
+    assert db.reserva(res['id'])['estado'] == 'confirmada'
+
+
+def test_sin_creditos_o_ya_reservado_pasa_al_siguiente(cliente, socio):
+    clase, (res,) = llena()
+    a = db.crear_socio('A', 'a@example.com')
+    b = db.crear_socio('B', 'b@example.com')
+    anotar(cliente, clase, a)
+    anotar(cliente, clase, b)
+    anotar(cliente, clase, socio)
+    db.sumar_creditos(a['id'], -8)
+    db.crear_reserva(b['id'], clase['id'], AHORA, estado='cancelada')
+    cancelar(cliente, res)
+    asuntos = {c['para']: c['asunto'] for c in db.correos()}
+    assert asuntos['a@example.com'] == 'No pudimos darte el lugar: Spinning el 11/11 a las 18:00'
+    assert asuntos['b@example.com'].startswith('Se liberó')
+    assert 'ana@example.com' not in asuntos
+    assert db.socio(a['id'])['creditos'] == 0
+    assert cliente.get(f"/clases/{clase['id']}/espera", headers=auth(socio)).json()['posicion'] == 1
+
+
+def test_ya_reservado_se_saca_sin_correo(cliente, socio):
+    clase, (res,) = llena()
+    otro = db.crear_socio('Beto', 'beto@example.com')
+    anotar(cliente, clase, socio)
+    anotar(cliente, clase, otro)
+    db.crear_reserva(socio['id'], clase['id'], AHORA)  # reserva por fuera (cupo ya excedido a propósito)
+    db.crear_reserva(socio['id'], clase['id'], AHORA, estado='cancelada')
+    with db.conexion() as con:
+        con.execute('UPDATE clases SET cupo = 2 WHERE id = ?', (clase['id'],))
+    cancelar(cliente, res)
+    assert db.confirmadas(clase['id']) == 2
+    assert [c['para'] for c in db.correos()] == ['beto@example.com']
+
+
+def test_clase_empezada_no_asigna(cliente, socio):
+    clase, (res,) = llena(horas=2)
+    anotar(cliente, clase, socio)
+    reloj.fijar(AHORA + timedelta(hours=2))
+    r = cancelar(cliente, res)
+    assert r.status_code == 200
+    assert db.socio(res['socio_id'])['creditos'] == 9
+    assert db.confirmadas(clase['id']) == 0
+    assert db.posicion_espera(clase['id'], socio['id']) == 1
+    r = cliente.patch(f"/admin/clases/{clase['id']}", json={'cupo': 5}, headers=ADMIN)
+    assert r.json()['lugares_libres'] == 5
+    assert db.posicion_espera(clase['id'], socio['id']) == 1
+
+
+def test_ampliar_cupo_asigna_k_lugares(cliente):
+    clase, _ = llena()
+    socios = [db.crear_socio(f'S{i}', f's{i}@example.com') for i in range(3)]
+    for s in socios:
+        anotar(cliente, clase, s)
+    r = cliente.patch(f"/admin/clases/{clase['id']}", json={'cupo': 3}, headers=ADMIN)
+    assert r.status_code == 200
+    assert r.json() == {'id': clase['id'], 'nombre': 'Spinning', 'instructor': 'Leo',
+                        'inicio': '2026-11-11T21:00:00+00:00', 'duracion_min': 60, 'cupo': 3, 'lugares_libres': 0}
+    assert db.posicion_espera(clase['id'], socios[0]['id']) is None
+    assert db.posicion_espera(clase['id'], socios[1]['id']) is None
+    assert db.posicion_espera(clase['id'], socios[2]['id']) == 1
+    assert db.socio(socios[0]['id'])['creditos'] == 7
+
+
+def test_cupo_validaciones(cliente):
+    clase, _ = llena(cupo=2)
+    url = f"/admin/clases/{clase['id']}"
+    assert cliente.patch(url, json={'cupo': 1}, headers=ADMIN).status_code == 409
+    assert db.clase(clase['id'])['cupo'] == 2
+    assert cliente.patch(url, json={'cupo': 2}, headers=ADMIN).status_code == 200
+    for malo in ({}, {'cupo': 0}, {'cupo': -1}, {'cupo': 'x'}, {'cupo': 2.5}, {'cupo': None}):
+        assert cliente.patch(url, json=malo, headers=ADMIN).status_code == 422
+    assert cliente.patch(url, json={'cupo': 3}).status_code == 401
+    assert cliente.patch(url, json={}).status_code == 401
+    assert db.clase(clase['id'])['cupo'] == 2
+    assert cliente.patch('/admin/clases/99', json={'cupo': 3}, headers=ADMIN).status_code == 404
