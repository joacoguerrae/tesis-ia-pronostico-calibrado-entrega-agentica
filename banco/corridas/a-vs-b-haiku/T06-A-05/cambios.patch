diff --git a/tests/test_espera.py b/tests/test_espera.py
new file mode 100644
index 0000000..ad7a13e
--- /dev/null
+++ b/tests/test_espera.py
@@ -0,0 +1,135 @@
+from datetime import timedelta
+
+from conftest import ADMIN, AHORA, auth
+from pulso import db, reloj
+
+
+def llena(cupo=1, horas=6, **kw):
+    clase = db.crear_clase('Spinning', 'Leo', AHORA + timedelta(hours=horas), cupo=cupo)
+    dueños = []
+    for i in range(cupo):
+        s = db.crear_socio(f'D{i}', f'd{i}-{horas}-{len(db.clases())}@x.com')
+        dueños.append((s, db.crear_reserva(s['id'], clase['id'], AHORA)))
+    return clase, dueños
+
+
+def anotar(cliente, clase, socio):
+    return cliente.post(f"/clases/{clase['id']}/espera", headers=auth(socio))
+
+
+def test_anotarse_y_posicion_y_baja(cliente):
+    clase, _ = llena()
+    a, b = db.crear_socio('A', 'a@x.com'), db.crear_socio('B', 'b@x.com')
+    assert anotar(cliente, clase, a).json() == {'clase_id': clase['id'], 'posicion': 1}
+    assert anotar(cliente, clase, b).json()['posicion'] == 2
+    assert db.socio(a['id'])['creditos'] == 8
+    assert cliente.delete(f"/clases/{clase['id']}/espera", headers=auth(a)).status_code == 204
+    assert cliente.get(f"/clases/{clase['id']}/espera", headers=auth(b)).json()['posicion'] == 1
+    assert cliente.get(f"/clases/{clase['id']}/espera", headers=auth(a)).status_code == 404
+    assert cliente.delete(f"/clases/{clase['id']}/espera", headers=auth(a)).status_code == 404
+    assert anotar(cliente, clase, a).json()['posicion'] == 2
+
+
+def test_auth_y_404(cliente, socio):
+    clase, _ = llena()
+    assert cliente.post(f"/clases/{clase['id']}/espera").status_code == 401
+    assert cliente.get(f"/clases/{clase['id']}/espera").status_code == 401
+    assert cliente.delete(f"/clases/{clase['id']}/espera").status_code == 401
+    assert cliente.post('/clases/99/espera', headers=auth(socio)).status_code == 404
+
+
+def test_rechazos_409(cliente, socio):
+    libre = db.crear_clase('Yoga', 'S', AHORA + timedelta(hours=3))
+    assert anotar(cliente, libre, socio).status_code == 409
+    clase, dueños = llena()
+    assert anotar(cliente, clase, dueños[0][0]).status_code == 409
+    anotar(cliente, clase, socio)
+    assert anotar(cliente, clase, socio).status_code == 409
+    sin = db.crear_socio('S', 's@x.com', creditos=0)
+    assert anotar(cliente, clase, sin).status_code == 409
+    empezada, _ = llena(horas=-1)
+    assert anotar(cliente, empezada, socio).status_code == 409
+    assert db.en_espera(socio['id'], empezada['id']) is None
+
+
+def test_cancelar_asigna_al_primero(cliente):
+    clase, dueños = llena()
+    a, b = db.crear_socio('A', 'a@x.com'), db.crear_socio('B', 'b@x.com')
+    anotar(cliente, clase, a)
+    anotar(cliente, clase, b)
+    r = cliente.post(f"/admin/reservas/{dueños[0][1]['id']}/cancelar", headers=ADMIN)
+    assert r.status_code == 200 and r.json()['estado'] == 'cancelada'
+    assert db.socio(dueños[0][0]['id'])['creditos'] == 9
+    assert db.socio(a['id'])['creditos'] == 7
+    assert [x['estado'] for x in cliente.get('/reservas', headers=auth(a)).json()] == ['confirmada']
+    assert cliente.get(f"/clases/{clase['id']}/espera", headers=auth(b)).json()['posicion'] == 1
+    asuntos = [c['asunto'] for c in db.correos()]
+    assert asuntos == ['Se liberó un lugar: Spinning el 10/11 a las 18:00']
+    assert db.confirmadas(clase['id']) == 1
+    assert cliente.post(f"/admin/reservas/{dueños[0][1]['id']}/cancelar", headers=ADMIN).status_code == 409
+    assert db.socio(dueños[0][0]['id'])['creditos'] == 9
+    assert db.confirmadas(clase['id']) == 1
+
+
+def test_cancelar_admin_errores(cliente):
+    clase, dueños = llena()
+    assert cliente.post('/admin/reservas/99/cancelar', headers=ADMIN).status_code == 404
+    assert cliente.post(f"/admin/reservas/{dueños[0][1]['id']}/cancelar").status_code == 401
+    assert db.reserva(dueños[0][1]['id'])['estado'] == 'confirmada'
+
+
+def test_salteos_sin_creditos_y_ya_reservado(cliente):
+    clase, dueños = llena()
+    a, b, c = (db.crear_socio(n, f'{n}@x.com') for n in 'ABC')
+    for s in (a, b, c):
+        anotar(cliente, clase, s)
+    db.sumar_creditos(a['id'], -8)
+    db.crear_reserva(b['id'], clase['id'], AHORA, estado='cancelada')
+    with db.conexion() as con:
+        con.execute("UPDATE reservas SET estado='confirmada' WHERE socio_id=?", (b['id'],))
+        con.execute('UPDATE clases SET cupo = 3 WHERE id=?', (clase['id'],))
+    cliente.post(f"/admin/reservas/{dueños[0][1]['id']}/cancelar", headers=ADMIN)
+    asuntos = [x['asunto'] for x in db.correos()]
+    assert asuntos == ['No pudimos darte el lugar: Spinning el 10/11 a las 18:00',
+                       'Se liberó un lugar: Spinning el 10/11 a las 18:00']
+    assert db.en_espera(a['id'], clase['id']) is None and db.en_espera(b['id'], clase['id']) is None
+    assert db.confirmadas(clase['id']) == 2  # b (ya tenía) y c
+    assert db.socio(a['id'])['creditos'] == 0 and db.socio(b['id'])['creditos'] == 8
+
+
+def test_ampliar_cupo(cliente):
+    clase, _ = llena()
+    socios = [db.crear_socio(f'S{i}', f's{i}@x.com') for i in range(3)]
+    for s in socios:
+        anotar(cliente, clase, s)
+    r = cliente.patch(f"/admin/clases/{clase['id']}", json={'cupo': 3}, headers=ADMIN)
+    assert r.status_code == 200
+    assert r.json()['cupo'] == 3 and r.json()['lugares_libres'] == 0
+    assert db.en_espera(socios[2]['id'], clase['id']) == 1
+    assert len(db.correos()) == 2
+
+
+def test_cupo_validaciones(cliente):
+    clase, _ = llena(cupo=2)
+    url = f"/admin/clases/{clase['id']}"
+    assert cliente.patch(url, json={'cupo': 5}).status_code == 401
+    for malo in ({}, {'cupo': 0}, {'cupo': -1}, {'cupo': 'x'}, {'cupo': 2.5}, {'cupo': True}):
+        assert cliente.patch(url, json=malo, headers=ADMIN).status_code == 422
+    assert cliente.patch(url, json={'cupo': 1}, headers=ADMIN).status_code == 409
+    assert db.clase(clase['id'])['cupo'] == 2
+    assert cliente.patch(url, json={'cupo': 2}, headers=ADMIN).status_code == 200
+    assert cliente.patch('/admin/clases/99', json={'cupo': 2}, headers=ADMIN).status_code == 404
+
+
+def test_clase_empezada_no_asigna(cliente):
+    clase, dueños = llena(horas=1)
+    a = db.crear_socio('A', 'a@x.com')
+    anotar(cliente, clase, a)
+    reloj.fijar(AHORA + timedelta(hours=1))
+    r = cliente.post(f"/admin/reservas/{dueños[0][1]['id']}/cancelar", headers=ADMIN)
+    assert r.status_code == 200
+    assert db.socio(dueños[0][0]['id'])['creditos'] == 9
+    assert db.en_espera(a['id'], clase['id']) == 1
+    r = cliente.patch(f"/admin/clases/{clase['id']}", json={'cupo': 4}, headers=ADMIN)
+    assert r.json()['lugares_libres'] == 4
+    assert db.en_espera(a['id'], clase['id']) == 1 and db.correos() == []
