+def test_cambia_hora_desde_una_clase_en_adelante(cliente, socio):
+    serie = crear_serie(cliente, desde='2026-11-10', hasta='2026-11-24')
+    primera, segunda, tercera = serie['clases']
+    reserva = cliente.post('/reservas', json={'clase_id': segunda['id']}, headers=auth(socio))
