diff --git a/tests/test_recordatorios.py b/tests/test_recordatorios.py
new file mode 100644
index 0000000..234ec6d
--- /dev/null
+++ b/tests/test_recordatorios.py
@@ -0,0 +1,45 @@
+from datetime import timedelta
+
+from pulso import db, reloj
+from tests.conftest import ADMIN, AHORA
+
+
+def llamar(cliente):
+    return cliente.post('/admin/recordatorios', headers=ADMIN)
+
+
+def test_requiere_clave(cliente):
+    assert cliente.post('/admin/recordatorios').status_code == 401
+    assert cliente.post('/admin/recordatorios', headers={'X-Admin-Key': 'mala'}).status_code == 401
+
+
+def test_envia_una_vez(cliente, socio):
+    clase = db.crear_clase('Yoga', 'Lucía', AHORA + timedelta(hours=3, minutes=30))
+    db.crear_reserva(socio['id'], clase['id'], AHORA)
+    r = llamar(cliente)
+    assert r.status_code == 200 and r.json() == {'enviados': 1}
+    assert llamar(cliente).json() == {'enviados': 0}
+    [c] = db.correos()
+    assert c['para'] == 'ana@example.com'
+    assert c['asunto'] == 'Recordatorio: Yoga el 10/11 a las 15:30'
+    assert 'Lucía' in c['cuerpo']
+
+
+def test_limites_y_estado(cliente, socio):
+    for nombre, delta, estado in [('Justo', timedelta(hours=24), 'confirmada'),
+                                  ('Pasada', timedelta(0), 'confirmada'),
+                                  ('Lejos', timedelta(hours=24, seconds=1), 'confirmada'),
+                                  ('Cancelada', timedelta(hours=2), 'cancelada')]:
+        clase = db.crear_clase(nombre, 'X', AHORA + delta)
+        db.crear_reserva(socio['id'], clase['id'], AHORA, estado)
+    assert llamar(cliente).json() == {'enviados': 1}
+    assert db.correos()[0]['asunto'].startswith('Recordatorio: Justo')
+
+
+def test_clase_que_entra_en_ventana_despues(cliente, socio):
+    clase = db.crear_clase('Spinning', 'Tomás', AHORA + timedelta(hours=30))
+    db.crear_reserva(socio['id'], clase['id'], AHORA)
+    assert llamar(cliente).json() == {'enviados': 0}
+    reloj.fijar(AHORA + timedelta(hours=7))
+    assert llamar(cliente).json() == {'enviados': 1}
+    assert llamar(cliente).json() == {'enviados': 0}
