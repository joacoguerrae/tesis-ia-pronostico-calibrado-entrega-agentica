+++ b/pulso/main.py
@@ -1,4 +1,5 @@
 import os
+from datetime import timedelta
 
 from fastapi import APIRouter, Depends, FastAPI, Header, HTTPException
 from pydantic import AwareDatetime, BaseModel, Field
@@ -92,6 +93,21 @@ def yo(socio=Depends(socio_actual)):
     return {k: socio[k] for k in ('id', 'nombre', 'email', 'plan', 'creditos')}
 
 
+@router.post('/admin/recordatorios', dependencies=[Depends(admin)])
+def mandar_recordatorios():
+    ahora = reloj.ahora()
+    enviados = 0
+    for r in db.reservas_a_recordar(ahora, ahora + timedelta(hours=24)):
+        if not db.marcar_recordatorio(r['reserva_id'], ahora):
+            continue
+        cuando = correo.fecha_y_hora(db.a_fecha(r['inicio']))
+        correo.enviar(r['email'], f"Recordatorio: {r['clase']} el {cuando}",
+                      f"Hola {r['socio']}, te recordamos tu clase de {r['clase']} el {cuando} "
+                      f"con {r['instructor']}.")
+        enviados += 1
+    return {'enviados': enviados}
+
+
 def crear_app():
     db.inicializar()
     app = FastAPI(title='Pulso')
