diff --git a/tests/test_cancelar.py b/tests/test_cancelar.py
new file mode 100644
index 0000000..3b7452a
--- /dev/null
+++ b/tests/test_cancelar.py
@@ -0,0 +1,78 @@
+from datetime import timedelta
+
+from pulso import db, reloj
+from tests.conftest import AHORA, auth
+
+
+def reservar(cliente, socio, horas):
+    clase = db.crear_clase('Yoga', 'Lu', AHORA + timedelta(hours=horas))
+    r = cliente.post('/reservas', json={'clase_id': clase['id']}, headers=auth(socio))
+    assert r.status_code == 201
+    return clase, r.json()
+
+
+def creditos(socio):
+    return db.socio(socio['id'])['creditos']
+
+
+def test_cancela_con_anticipacion_devuelve_credito(cliente, socio):
+    clase, res = reservar(cliente, socio, 2)
+    r = cliente.post(f"/reservas/{res['id']}/cancelar", headers=auth(socio))
+    assert r.status_code == 200
+    assert r.json() == {**res, 'estado': 'cancelada', 'credito_devuelto': True}
+    assert creditos(socio) == 8
+    assert cliente.get(f"/clases/{clase['id']}").json()['lugares_libres'] == clase['cupo']
+    lista = cliente.get('/reservas', headers=auth(socio)).json()
+    assert lista[0]['estado'] == 'cancelada'
+
+
+def test_cancela_tarde_no_devuelve_credito(cliente, socio):
+    _, res = reservar(cliente, socio, 1.9)
+    r = cliente.post(f"/reservas/{res['id']}/cancelar", headers=auth(socio))
+    assert r.status_code == 200
+    assert r.json()['credito_devuelto'] is False
+    assert creditos(socio) == 7
+
+
+def test_no_se_cancela_dos_veces(cliente, socio):
+    _, res = reservar(cliente, socio, 5)
+    cliente.post(f"/reservas/{res['id']}/cancelar", headers=auth(socio))
+    r = cliente.post(f"/reservas/{res['id']}/cancelar", headers=auth(socio))
+    assert r.status_code == 409
+    assert creditos(socio) == 8
+
+
+def test_clase_empezada(cliente, socio):
+    _, res = reservar(cliente, socio, 5)
+    reloj.fijar(AHORA + timedelta(hours=5))
+    r = cliente.post(f"/reservas/{res['id']}/cancelar", headers=auth(socio))
+    assert r.status_code == 409
+    assert creditos(socio) == 7
+
+
+def test_ajena_o_inexistente_404(cliente, socio):
+    otro = db.crear_socio('Beto', 'beto@example.com')
+    _, res = reservar(cliente, socio, 5)
+    assert cliente.post(f"/reservas/{res['id']}/cancelar", headers=auth(otro)).status_code == 404
+    assert cliente.post('/reservas/999/cancelar', headers=auth(socio)).status_code == 404
+    assert db.reserva(res['id'])['estado'] == 'confirmada'
+
+
+def test_sin_token_401(cliente):
+    assert cliente.post('/reservas/1/cancelar').status_code == 401
+
+
+def test_puede_volver_a_reservar(cliente, socio):
+    clase, res = reservar(cliente, socio, 5)
+    cliente.post(f"/reservas/{res['id']}/cancelar", headers=auth(socio))
+    r = cliente.post('/reservas', json={'clase_id': clase['id']}, headers=auth(socio))
+    assert r.status_code == 201
+
+
+def test_libera_lugar_para_otro(cliente, socio):
+    otro = db.crear_socio('Beto', 'beto@example.com')
+    clase = db.crear_clase('Yoga', 'Lu', AHORA + timedelta(hours=5), cupo=1)
+    res = cliente.post('/reservas', json={'clase_id': clase['id']}, headers=auth(socio)).json()
+    assert cliente.post('/reservas', json={'clase_id': clase['id']}, headers=auth(otro)).status_code == 409
+    cliente.post(f"/reservas/{res['id']}/cancelar", headers=auth(socio))
+    assert cliente.post('/reservas', json={'clase_id': clase['id']}, headers=auth(otro)).status_code == 201
