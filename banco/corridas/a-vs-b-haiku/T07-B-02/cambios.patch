+    except compras.NoExiste:
+        raise HTTPException(404, 'No existe la compra para ese pago')
+    except cobra.CobraError:
+        raise HTTPException(503, 'Cobrá no respondió')
+    return {'compra_id': compra['id'], 'estado': compra['estado']}
+
+
+@router.post('/admin/conciliar-pagos', dependencies=[Depends(admin)])
+def conciliar_pagos():
