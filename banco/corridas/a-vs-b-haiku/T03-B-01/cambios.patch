diff --git a/pulso/main.py b/pulso/main.py
index 039212d..c85cedf 100644
--- a/pulso/main.py
+++ b/pulso/main.py
@@ -1,12 +1,21 @@
+import csv
+import io
 import os
+import re
+from datetime import date
 
 from fastapi import APIRouter, Depends, FastAPI, Header, HTTPException
+from fastapi.responses import Response
 from pydantic import AwareDatetime, BaseModel, Field
 
 from pulso import correo, db, reloj
 
 router = APIRouter()
 
+FECHA_RE = re.compile(r'[0-9]{4}-[0-9]{2}-[0-9]{2}')
+MAX_DIAS_OCUPACION = 31
+COLUMNAS_OCUPACION = ('fecha', 'hora', 'clase', 'instructor', 'cupo', 'confirmadas', 'ocupacion_pct')
+
 
 def socio_actual(authorization: str | None = Header(default=None)):
     if not authorization or not authorization.startswith('Bearer '):
@@ -57,6 +66,44 @@ def crear_clase(datos: NuevaClase):
     return ver_clase(db.crear_clase(**datos.model_dump()))
 
 
+def _fecha_del_periodo(valor, nombre):
+    if valor is None or not FECHA_RE.fullmatch(valor):
+        raise HTTPException(422, f'{nombre} es obligatorio y tiene que tener formato YYYY-MM-DD')
+    try:
+        return date.fromisoformat(valor)
+    except ValueError:
+        raise HTTPException(422, f'{nombre} no es una fecha válida')
+
+
+def _fila_ocupacion(clase):
+    inicio = db.a_fecha(clase['inicio']).astimezone(reloj.MONTEVIDEO)
+    confirmadas = db.confirmadas(clase['id'])
+    # confirmadas / cupo * 100 redondeado al entero más cercano, con los ,5 para arriba.
+    pct = (200 * confirmadas + clase['cupo']) // (2 * clase['cupo'])
+    return [f'{inicio:%Y-%m-%d}', f'{inicio:%H:%M}', clase['nombre'], clase['instructor'],
+            clase['cupo'], confirmadas, pct]
+
+
+@router.get('/admin/ocupacion.csv', dependencies=[Depends(admin)])
+def ocupacion_csv(desde: str | None = None, hasta: str | None = None):
+    primero = _fecha_del_periodo(desde, 'desde')
+    ultimo = _fecha_del_periodo(hasta, 'hasta')
+    if primero > ultimo:
+        raise HTTPException(422, 'desde es posterior a hasta')
+    if (ultimo - primero).days + 1 > MAX_DIAS_OCUPACION:
+        raise HTTPException(422, f'el período no puede tener más de {MAX_DIAS_OCUPACION} días')
+
+    clases = sorted(db.clases(), key=lambda c: (db.a_fecha(c['inicio']), c['id']))
+    en_periodo = [c for c in clases
+                  if primero <= db.a_fecha(c['inicio']).astimezone(reloj.MONTEVIDEO).date() <= ultimo]
+
+    salida = io.StringIO()
+    escritor = csv.writer(salida)
+    escritor.writerow(COLUMNAS_OCUPACION)
+    escritor.writerows(_fila_ocupacion(c) for c in en_periodo)
+    return Response(salida.getvalue(), media_type='text/csv; charset=utf-8')
+
+
 class NuevaReserva(BaseModel):
     clase_id: int
 
