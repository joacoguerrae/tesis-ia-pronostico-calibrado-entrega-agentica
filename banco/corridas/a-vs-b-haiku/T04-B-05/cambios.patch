--- a/pulso/db.py
+++ b/pulso/db.py
@@ -94,6 +94,11 @@ def socio_por_token(token):
     return _una('SELECT * FROM socios WHERE token = ?', (token,))
 
 
+def socio_por_email(email):
+    # Compara sin importar mayúsculas: hay socios cargados a mano con el email tal cual lo escribieron.
+    return _una('SELECT * FROM socios WHERE lower(email) = lower(?)', (email,))
+
+
 def crear_clase(nombre, instructor, inicio, duracion_min=60, cupo=20):
