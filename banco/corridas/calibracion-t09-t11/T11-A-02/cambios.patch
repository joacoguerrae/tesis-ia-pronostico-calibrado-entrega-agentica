+def socios_con_reserva_confirmada(clase_id):
+    return _varias("SELECT DISTINCT s.* FROM reservas r JOIN socios s ON s.id = r.socio_id "
+                   "WHERE r.clase_id = ? AND r.estado = 'confirmada' ORDER BY s.id", (clase_id,))
