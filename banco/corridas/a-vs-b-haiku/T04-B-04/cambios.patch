diff --git a/tests/test_socios.py b/tests/test_socios.py
new file mode 100644
index 0000000..c4df070
--- /dev/null
+++ b/tests/test_socios.py
@@ -0,0 +1,115 @@
+from pulso import db
+
+
+def registrar(cliente, **cambios):
+    datos = {'nombre': 'Ana Pérez', 'email': 'Ana.Perez@Example.com', 'plan': 'premium'}
+    datos.update(cambios)
+    return cliente.post('/socios', json=datos)
+
+
+def test_registra_socio_con_datos_normalizados(cliente):
+    r = registrar(cliente)
+    assert r.status_code == 201
+    cuerpo = r.json()
+    assert cuerpo['id'] > 0
+    assert cuerpo['nombre'] == 'Ana Pérez'
+    assert cuerpo['email'] == 'ana.perez@example.com'
+    assert cuerpo['plan'] == 'premium'
+    assert cuerpo['creditos'] == 20
+    assert len(cuerpo['token']) >= 32
+
+
+def test_creditos_segun_plan(cliente):
+    assert registrar(cliente, plan='basico', email='a@example.com').json()['creditos'] == 8
+    assert registrar(cliente, plan='premium', email='b@example.com').json()['creditos'] == 20
+
+
+def test_token_distinto_para_cada_socio(cliente):
+    tokens = {registrar(cliente, email=f'socio{i}@example.com').json()['token'] for i in range(5)}
+    assert len(tokens) == 5
+
+
+def test_token_sirve_para_autenticarse(cliente):
+    token = registrar(cliente).json()['token']
+    r = cliente.get('/yo', headers={'Authorization': f'Bearer {token}'})
+    assert r.status_code == 200
+    assert r.json()['email'] == 'ana.perez@example.com'
+    assert r.json()['creditos'] == 20
+
+
+def test_guarda_el_socio_en_la_base(cliente):
+    registrar(cliente)
+    socio = db.socio_por_email('ana.perez@example.com')
+    assert socio['nombre'] == 'Ana Pérez'
+    assert socio['plan'] == 'premium'
+
+
+def test_manda_correo_de_bienvenida(cliente):
+    token = registrar(cliente).json()['token']
+    [enviado] = db.correos()
+    assert enviado['para'] == 'ana.perez@example.com'
+    assert enviado['asunto'] == 'Te damos la bienvenida a Pulso'
+    assert token not in enviado['cuerpo']
+
+
+def test_email_repetido_da_409(cliente):
+    assert registrar(cliente).status_code == 201
+    assert registrar(cliente, email='  ANA.PEREZ@example.com ').status_code == 409
+    assert len(db.correos()) == 1
+
+
+def test_nombre_se_recorta(cliente):
+    r = registrar(cliente, nombre='   Ana   ')
+    assert r.status_code == 201
+    assert r.json()['nombre'] == 'Ana'
+
+
+def test_nombre_de_2_a_80_caracteres(cliente):
+    assert registrar(cliente, nombre='A', email='a1@example.com').status_code == 422
+    assert registrar(cliente, nombre=' A ', email='a2@example.com').status_code == 422
+    assert registrar(cliente, nombre='   ', email='a3@example.com').status_code == 422
+    assert registrar(cliente, nombre='Ab', email='a4@example.com').status_code == 201
+    assert registrar(cliente, nombre='x' * 80, email='a5@example.com').status_code == 201
+    assert registrar(cliente, nombre='x' * 81, email='a6@example.com').status_code == 422
+
+
+def test_email_invalido_da_422(cliente):
+    invalidos = [
+        'sin-arroba.com',
+        'dos@@example.com',
+        'a@b@example.com',
+        '@example.com',
+        'ana@',
+        'ana@localhost',
+        'ana@.example.com',
+        'ana@example.com.',
+        'ana perez@example.com',
+        'ana@exa mple.com',
+        '',
+        '   ',
+    ]
+    for email in invalidos:
+        assert registrar(cliente, email=email).status_code == 422, email
+    assert db.correos() == []
+
+
+def test_email_se_recorta_y_pasa_a_minusculas(cliente):
+    r = registrar(cliente, email='  Ana@Example.COM  ')
+    assert r.status_code == 201
+    assert r.json()['email'] == 'ana@example.com'
+
+
+def test_plan_invalido_da_422(cliente):
+    assert registrar(cliente, plan='gold').status_code == 422
+    assert registrar(cliente, plan='Premium').status_code == 422
+
+
+def test_faltan_datos_da_422(cliente):
+    assert cliente.post('/socios', json={'email': 'ana@example.com', 'plan': 'basico'}).status_code == 422
+    assert cliente.post('/socios', json={'nombre': 'Ana Pérez', 'plan': 'basico'}).status_code == 422
+    assert cliente.post('/socios', json={'nombre': 'Ana Pérez', 'email': 'ana@example.com'}).status_code == 422
+    assert cliente.post('/socios', json={'nombre': None, 'email': 'ana@example.com', 'plan': 'basico'}).status_code == 422
+
+
+def test_no_pide_autenticacion(cliente):
+    assert registrar(cliente).status_code == 201
