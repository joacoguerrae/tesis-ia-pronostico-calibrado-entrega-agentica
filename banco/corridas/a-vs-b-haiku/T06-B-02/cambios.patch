+"""Lista de espera: los lugares libres de una clase pasan solos al primero de la lista.
+
+Todas las funciones que escriben reciben la conexión de db.transaccion(). Los correos se
+devuelven en vez de enviarse, para mandarlos recién cuando la operación quedó confirmada.
+"""
+from pulso import correo, db, reloj
+
+
+def posicion(con, clase_id, socio_id):
+    for i, fila in enumerate(db.espera_de_en(con, clase_id), start=1):
+        if fila['socio_id'] == socio_id:
+            return i
+    return None
+
+
+def asignar_lugares(con, clase_id):
+    """Llena los lugares libres de la clase con la lista de espera. Devuelve los correos a enviar."""
+    ahora = reloj.ahora()
+    clase = db.clase_en(con, clase_id)
+    inicio = db.a_fecha(clase['inicio'])
+    if inicio <= ahora:
+        return []
+    asunto = f"{clase['nombre']} el {correo.fecha_y_hora(inicio)}"
+    pendientes = []
+    while db.confirmadas_en(con, clase_id) < clase['cupo']:
+        espera = db.espera_de_en(con, clase_id)
+        if not espera:
+            break
+        socio = db.socio_en(con, espera[0]['socio_id'])
+        db.quitar_de_espera_en(con, socio['id'], clase_id)
+        if db.tiene_confirmada_en(con, socio['id'], clase_id):
+            continue
+        if socio['creditos'] < 1:
+            pendientes.append((socio['email'], f'No pudimos darte el lugar: {asunto}',
+                               f"Hola {socio['nombre']}, se liberó un lugar en {clase['nombre']} "
+                               f"pero no te quedan créditos para reservarlo."))
+            continue
+        db.insertar_reserva_en(con, socio['id'], clase_id, ahora)
+        db.ajustar_creditos_en(con, socio['id'], -1)
+        pendientes.append((socio['email'], f'Se liberó un lugar: {asunto}',
+                           f"Hola {socio['nombre']}, se liberó un lugar en {clase['nombre']} con "
+                           f"{clase['instructor']} y ya lo tenés reservado."))
+    return pendientes
+
+
+def enviar(pendientes):
+    for para, asunto, cuerpo in pendientes:
+        correo.enviar(para, asunto, cuerpo)
