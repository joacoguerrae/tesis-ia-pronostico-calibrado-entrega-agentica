@@ -0,0 +1,112 @@
+import sqlite3
+from datetime import timedelta
+
+from conftest import ADMIN, AHORA, auth
+from pulso import db, main, reloj
+
+SERIE = {'nombre': 'Yoga', 'instructor': 'Sofía', 'dia': 'martes', 'hora': '19:00', 'duracion_min': 60,
+         'cupo': 15, 'desde': '2026-11-10', 'hasta': '2026-11-24'}
+
+
+def crear_serie(cliente):
+    r = cliente.post('/admin/series', json=SERIE, headers=ADMIN)
+    assert r.status_code == 201, r.text
+    return r.json()
+
+
+def cancelar(cliente, clase_id):
+    return cliente.post(f'/admin/clases/{clase_id}/cancelar', headers=ADMIN)
+
