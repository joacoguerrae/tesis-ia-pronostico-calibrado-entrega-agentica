diff --git a/pulso/db.py b/pulso/db.py
index 59841ac..c3612a4 100644
--- a/pulso/db.py
+++ b/pulso/db.py
@@ -124,6 +124,19 @@ def reserva(reserva_id):
     return _una('SELECT * FROM reservas WHERE id = ?', (reserva_id,))
 
 
+def cancelar_reserva(reserva_id, socio_id, devolver_credito):
+    """Marca la reserva como cancelada y, si corresponde, devuelve el crédito, todo en una transacción.
+    Devuelve False si la reserva ya no estaba confirmada (no hace nada en ese caso)."""
+    with conexion() as con:
+        cur = con.execute("UPDATE reservas SET estado = 'cancelada' WHERE id = ? AND estado = 'confirmada'",
+                          (reserva_id,))
+        if cur.rowcount != 1:
+            return False
+        if devolver_credito:
+            con.execute('UPDATE socios SET creditos = creditos + 1 WHERE id = ?', (socio_id,))
+    return True
+
+
 def reservas_de(socio_id):
     return _varias('SELECT r.* FROM reservas r JOIN clases c ON c.id = r.clase_id '
                    'WHERE r.socio_id = ? ORDER BY c.inicio, r.id', (socio_id,))
diff --git a/pulso/main.py b/pulso/main.py
index 039212d..efbda87 100644
--- a/pulso/main.py
+++ b/pulso/main.py
@@ -1,4 +1,5 @@
 import os
+from datetime import timedelta
 
 from fastapi import APIRouter, Depends, FastAPI, Header, HTTPException
 from pydantic import AwareDatetime, BaseModel, Field
@@ -82,6 +83,23 @@ def reservar(datos: NuevaReserva, socio=Depends(socio_actual)):
     return ver_reserva(reserva)
 
 
+@router.post('/reservas/{reserva_id}/cancelar')
+def cancelar(reserva_id: int, socio=Depends(socio_actual)):
+    reserva = db.reserva(reserva_id)
+    if reserva is None or reserva['socio_id'] != socio['id']:
+        raise HTTPException(404, 'No existe la reserva')
+    if reserva['estado'] == 'cancelada':
+        raise HTTPException(409, 'La reserva ya está cancelada')
+    inicio = db.a_fecha(db.clase(reserva['clase_id'])['inicio'])
+    ahora = reloj.ahora()
+    if inicio <= ahora:
+        raise HTTPException(409, 'La clase ya empezó')
+    devolver = inicio - ahora >= timedelta(hours=2)
+    if not db.cancelar_reserva(reserva_id, socio['id'], devolver):
+        raise HTTPException(409, 'La reserva ya está cancelada')
+    return dict(ver_reserva(db.reserva(reserva_id)), credito_devuelto=devolver)
+
+
 @router.get('/reservas')
 def mis_reservas(socio=Depends(socio_actual)):
     return [ver_reserva(r) for r in db.reservas_de(socio['id'])]
