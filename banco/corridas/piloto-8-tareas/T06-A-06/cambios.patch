+def _clase_o_404(clase_id):
+    clase = db.clase(clase_id)
+    if clase is None:
+        raise HTTPException(404, 'No existe la clase')
+    return clase
+
+
+@router.post('/clases/{clase_id}/espera', status_code=201)
+def anotarse_en_espera(clase_id: int, socio=Depends(socio_actual)):
+    _clase_o_404(clase_id)
+    posicion, motivo = db.anotar_espera(clase_id, socio['id'], reloj.ahora())
+    if motivo:
+        raise HTTPException(409, motivo)
+    return {'clase_id': clase_id, 'posicion': posicion}
+
+
+@router.get('/clases/{clase_id}/espera')
+def ver_espera(clase_id: int, socio=Depends(socio_actual)):
+    _clase_o_404(clase_id)
+    posicion = db.posicion_espera(clase_id, socio['id'])
+    if posicion is None:
+        raise HTTPException(404, 'No estás en la lista de espera')
+    return {'clase_id': clase_id, 'posicion': posicion}
+
+
+@router.delete('/clases/{clase_id}/espera', status_code=204)
+def bajarse_de_espera(clase_id: int, socio=Depends(socio_actual)):
+    _clase_o_404(clase_id)
+    if not db.bajar_espera(clase_id, socio['id']):
+        raise HTTPException(404, 'No estás en la lista de espera')
+
+
+@router.post('/admin/reservas/{reserva_id}/cancelar', dependencies=[Depends(admin)])
+def cancelar_reserva(reserva_id: int):
+    reserva, error = db.cancelar_reserva(reserva_id, reloj.ahora(), correo.fecha_y_hora)
+    if error == 'no existe':
+        raise HTTPException(404, 'No existe la reserva')
+    if error:
+        raise HTTPException(409, 'La reserva ya estaba cancelada')
+    return ver_reserva(reserva)
+
+
+class CambioClase(BaseModel):
+    cupo: StrictInt = Field(gt=0)
+
+
+@router.patch('/admin/clases/{clase_id}', dependencies=[Depends(admin)])
+def cambiar_clase(clase_id: int, datos: CambioClase):
+    clase, error = db.cambiar_cupo(clase_id, datos.cupo, reloj.ahora(), correo.fecha_y_hora)
+    if error == 'no existe':
+        raise HTTPException(404, 'No existe la clase')
+    if error:
+        raise HTTPException(409, 'El cupo no puede quedar por debajo de las reservas confirmadas')
+    return ver_clase(clase)
+
+
 @router.get('/reservas')
 def mis_reservas(socio=Depends(socio_actual)):
     return [ver_reserva(r) for r in db.reservas_de(socio['id'])]
